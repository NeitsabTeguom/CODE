namespace Amalgame.Compiler

import Amalgame.Collections
import Amalgame.String

// ═══════════════════════════════════════════════════════
//  typechecker.am  —  Type inference & validation pass
//
//  Runs after the Resolver. Walks the AST, infers a type
//  for every expression, and validates compatibility at
//  assignments, calls, returns, operators, and conditions.
//
//  Limitations (deferred to a future Hindley-Milner pass):
//    - Full generic type unification
//    - Variance / covariance checks
//    - Flow-sensitive smart casts
// ═══════════════════════════════════════════════════════

// ── Type error ────────────────────────────────────────
public class TypeError {
    public Message:  string
    public Filename: string
    public Line:     int
    public Column:   int
    public Snippet:  string   // Source line text — empty if no SourceMap available

    public TypeError(string msg, string file, int line, int col) {
        this.Message  = msg
        this.Filename = file
        this.Line     = line
        this.Column   = col
        this.Snippet  = ""
    }

    public string ToString() {
        let ln    = String_FromInt(this.Line)
        let col   = String_FromInt(this.Column)
        let head  = "\nerror[typechecker]: " + this.Message + "\n  --> " + this.Filename + ":" + ln + ":" + col + "\n"
        let snip  = SourceSnippet.Format(this.Snippet, this.Line, this.Column)
        return head + snip
    }
}

// ── Type check result ─────────────────────────────────
public class TypeCheckResult {
    public Success: bool
    public Errors:  List<TypeError>

    public TypeCheckResult() {
        this.Success = true
        this.Errors  = new List<TypeError>()
    }
}

// ── TypeNode kind constants (mirrored from Vala) ──────
// We use string TypeKeys throughout, e.g. "int", "string",
// "Player", "List<int>", "?" (unknown).

// ── TypeChecker ───────────────────────────────────────
public class TypeChecker {
    // Parallel map: AstNode pointer (as string key) → TypeKey
    // We use AstNode.Line + AstNode.Column + AstNode.Name as a
    // lightweight identity key (good enough for a single-file pass).
    private ExprTypeKeys:  List<string>   // keys  (node identity)
    private ExprTypeVals:  List<string>   // values (TypeKey)

    // Current method return type
    private CurrentReturn: string
    // Current class name
    private CurrentClass:  string
    // Errors collected
    private Errors:        List<TypeError>
    // Filename for error messages
    private Filename:      string
    // Symbol table (from Resolver)
    private Symbols:       FullResolver
    // Local symbol stack — owned by the TypeChecker (Resolver scopes are popped after resolution)
    private LocalNames:    List<string>
    private LocalTypes:    List<string>
    private ScopeStarts:   List<int>
    // Generic substitution context for CheckImplementsContract — holds the
    // current interface's type-param names and the concrete args bound at
    // the `implements` site. Cleared between interfaces; treated as a tiny
    // single-frame stack (no nesting needed). Stored as fields rather than
    // passed as parameters because the codegen erases List<string> across
    // call boundaries to void*, breaking string equality on Get(i).
    private SubstParams:   List<string>
    private SubstArgs:     List<string>
    // Source map for snippet rendering in error messages — optional, set by main
    public  Sources:       SourceMap

    public TypeChecker(FullResolver symbols, string filename) {
        this.ExprTypeKeys  = new List<string>()
        this.ExprTypeVals  = new List<string>()
        this.CurrentReturn = "void"
        this.CurrentClass  = ""
        this.Errors        = new List<TypeError>()
        this.Filename      = filename
        this.Symbols       = symbols
        this.LocalNames    = new List<string>()
        this.LocalTypes    = new List<string>()
        this.ScopeStarts   = new List<int>()
        this.SubstParams   = new List<string>()
        this.SubstArgs     = new List<string>()
        this.Sources       = new SourceMap()
    }

    // ── Local scope stack (mirrors Resolver) ──────────

    private void PushScope() {
        this.ScopeStarts.Add(this.LocalNames.Count())
    }

    private void PopScope() {
        let depth = this.ScopeStarts.Count()
        if (depth == 0) { return }
        let mark = this.ScopeStarts.Get(depth - 1)
        this.ScopeStarts.RemoveAt(depth - 1)
        while (this.LocalNames.Count() > mark) {
            let last = this.LocalNames.Count() - 1
            this.LocalNames.RemoveAt(last)
            this.LocalTypes.RemoveAt(last)
        }
    }

    private void DeclareLocal(string name, string typeName) {
        this.LocalNames.Add(name)
        this.LocalTypes.Add(typeName)
    }

    private string LookupLocal(string name) {
        var i = this.LocalNames.Count() - 1
        while (i >= 0) {
            if (this.LocalNames.Get(i) == name) { return this.LocalTypes.Get(i) }
            i = i - 1
        }
        return ""
    }

    // ── Public entry point ────────────────────────────

    public TypeCheckResult Check(AstNode program) {
        this.CheckProgram(program)
        let result = new TypeCheckResult()
        let ec = this.Errors.Count()
        result.Success = ec == 0
        for i in 0..ec {
            result.Errors.Add(this.Errors.Get(i))
        }
        return result
    }

    // ── Type map helpers ──────────────────────────────

    private string NodeKey(AstNode node) {
        let ln  = String_FromInt(node.Line)
        let col = String_FromInt(node.Column)
        let knd = String_FromInt(node.Kind)
        return knd + ":" + ln + ":" + col + ":" + node.Name + ":" + node.Str
    }

    private void SetType(AstNode node, string typeKey) {
        let key = this.NodeKey(node)
        let count = this.ExprTypeKeys.Count()
        for i in 0..count {
            if (this.ExprTypeKeys.Get(i) == key) {
                // Update existing
                // (List doesn't support Set, so we rebuild — use a marker)
                this.ExprTypeVals.Add(typeKey)   // last one wins in GetType
                return
            }
        }
        this.ExprTypeKeys.Add(key)
        this.ExprTypeVals.Add(typeKey)
    }

    private string GetType(AstNode node) {
        let key = this.NodeKey(node)
        let count = this.ExprTypeKeys.Count()
        // Walk backwards — last write wins
        var result = "?"
        for i in 0..count {
            if (this.ExprTypeKeys.Get(i) == key) {
                result = this.ExprTypeVals.Get(i)
            }
        }
        return result
    }

    // Public wrapper for LSP hover. Same lookup as GetType but
    // accessible from outside the typechecker. Returns "?" for
    // nodes the typechecker never recorded a type for (most
    // statements / declarations).
    public string LookupNodeType(AstNode node) {
        return this.GetType(node)
    }

    // ── Compatibility helpers ─────────────────────────

    private bool IsAssignable(string expected, string actual) {
        if (expected == "?" || actual == "?") { return true }
        if (expected == actual)               { return true }
        if (expected == "object")             { return true }
        // Strip nullable "?"
        var eBase = expected
        var aBase = actual
        if (String_EndsWith(expected, "?")) {
            eBase = String_Substring(expected, 0, String_Length(expected) - 1)
        }
        if (String_EndsWith(actual, "?")) {
            aBase = String_Substring(actual, 0, String_Length(actual) - 1)
        }
        if (eBase == aBase) { return true }
        // Generic erasure — `List<int>` and `List` are interchangeable
        // at this stage of the typechecker (it doesn't track type args
        // on locals yet; cgen handles concrete elem types via its own
        // ListElem table). Same for `Map<K,V>` ↔ `Map`, `Set<T>` ↔ `Set`.
        if (this.GenericBase(eBase) == this.GenericBase(aBase)) { return true }
        // null → any nullable
        if (actual == "null" && String_EndsWith(expected, "?")) { return true }
        // null → any class/string/collection type (everything that
        // lowers to a pointer at the C level — its sentinel is NULL).
        // Reject only when the target is a primitive value type
        // where null has no representation.
        if (actual == "null" && !this.IsPrimitiveValue(eBase)) { return true }
        // numeric widening
        if (this.IsNumericWiden(eBase, aBase)) { return true }
        return false
    }

    // Value-type primitives where `null` is not assignable (no NULL
    // sentinel at the C level). Everything else (string, classes,
    // List<T>, Map<K,V>, Set<T>, custom enums via boxed pointers)
    // accepts null as the legitimate "no value" marker.
    private bool IsPrimitiveValue(string t) {
        if (t == "int")    { return true }
        if (t == "i64")    { return true }
        if (t == "i32")    { return true }
        if (t == "i16")    { return true }
        if (t == "i8")     { return true }
        if (t == "u64")    { return true }
        if (t == "u32")    { return true }
        if (t == "u16")    { return true }
        if (t == "u8")     { return true }
        if (t == "float")  { return true }
        if (t == "double") { return true }
        if (t == "f32")    { return true }
        if (t == "f64")    { return true }
        if (t == "bool")   { return true }
        if (t == "char")   { return true }
        if (t == "void")   { return true }
        return false
    }

    private string GenericBase(string t) {
        let lt = String_IndexOf(t, "<")
        if (lt > 0) {
            return String_Substring(t, 0, lt)
        }
        return t
    }

    private bool IsNumericWiden(string to, string from) {
        if (to == "double") {
            if (from == "float" || from == "int" || from == "i64" || from == "i32" || from == "f32") {
                return true
            }
        }
        if (to == "float") {
            if (from == "int" || from == "i32" || from == "f32") {
                return true
            }
        }
        return false
    }

    private bool IsBool(string t) {
        return t == "bool" || t == "?"
    }

    private bool IsNumeric(string t) {
        if (t == "int")    { return true }
        if (t == "float")  { return true }
        if (t == "double") { return true }
        if (t == "i8")     { return true }
        if (t == "i16")    { return true }
        if (t == "i32")    { return true }
        if (t == "i64")    { return true }
        if (t == "u8")     { return true }
        if (t == "u16")    { return true }
        if (t == "u32")    { return true }
        if (t == "u64")    { return true }
        if (t == "f32")    { return true }
        if (t == "f64")    { return true }
        return false
    }

    private bool IsNullable(string t) {
        return String_EndsWith(t, "?")
    }

    private string BinaryResultType(string op, string left, string right) {
        // Comparison → bool
        if (op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=") {
            return "bool"
        }
        // Logical → bool
        if (op == "&&" || op == "||") { return "bool" }
        // Null coalescing → base type of left
        if (op == "??") {
            if (String_EndsWith(left, "?")) {
                return String_Substring(left, 0, String_Length(left) - 1)
            }
            return left
        }
        // Range
        if (op == ".." || op == "...") { return "range" }
        // Pipeline
        if (op == "|>") { return right }
        // Arithmetic
        if (op == "+" || op == "-" || op == "*" || op == "/" || op == "%" || op == "^") {
            if (left == "double" || right == "double") { return "double" }
            if (left == "float"  || right == "float")  { return "float" }
            if (left == "string" || right == "string")  { return "string" }
            return left
        }
        return "?"
    }

    private string CollectionElementType(string typeKey) {
        if (typeKey == "?" || typeKey == "") { return "?" }
        // List<T>
        if (String_StartsWith(typeKey, "List<") && String_EndsWith(typeKey, ">")) {
            let inner = String_Substring(typeKey, 5, String_Length(typeKey) - 6)
            return inner
        }
        // Set<T>
        if (String_StartsWith(typeKey, "Set<") && String_EndsWith(typeKey, ">")) {
            let inner = String_Substring(typeKey, 4, String_Length(typeKey) - 5)
            return inner
        }
        // Map<K,V> → V
        if (String_StartsWith(typeKey, "Map<") && String_EndsWith(typeKey, ">")) {
            let inner  = String_Substring(typeKey, 4, String_Length(typeKey) - 5)
            let comma  = String_IndexOf(inner, ",")
            if (comma >= 0) {
                let vt = String_Substring(inner, comma + 1, String_Length(inner) - comma - 1)
                return String_Trim(vt)
            }
        }
        // T[]
        if (String_EndsWith(typeKey, "[]")) {
            return String_Substring(typeKey, 0, String_Length(typeKey) - 2)
        }
        return "?"
    }

    // ── Symbol access helpers ────────────────────────
    // These wrappers prevent the CGen from having to dereference
    // a void* Symbol pointer — Lookup() return type is not tracked
    // across compilation units by the current Resolver.

    private bool SymbolFound(string name) {
        return this.Symbols.HasSymbol(name)
    }

    private string SymbolTypeName(string name) {
        return this.Symbols.GetTypeName(name)
    }

    // ── Error reporting ───────────────────────────────

    private void Error(string msg, AstNode node) {
        var file = this.Filename
        var line = 0
        var col  = 0
        if (node != null) {
            line = node.Line
            col  = node.Column
        }
        let err = new TypeError(msg, file, line, col)
        err.Snippet = this.Sources.GetLine(file, line)
        this.Errors.Add(err)
    }

    private void CheckBool(AstNode node, string context) {
        let t = this.GetType(node)
        if (!this.IsBool(t)) {
            this.Error("'" + context + "' must be bool, got '" + t + "'", node)
        }
    }

    // ── Symbol lookup helpers ─────────────────────────

    private string SymbolType(string name) {
        return this.SymbolTypeName(name)
    }

    // Look up member type in a class's Children list
    private string MemberTypeOf(AstNode classDecl, string memberName) {
        if (classDecl == null) { return "?" }
        let k = classDecl.Kind
        // Enum: member access → type is the enum name itself
        if (k == NodeKind.ENUM_DECL) {
            let members = classDecl.Children.Count()
            for i in 0..members {
                let m = classDecl.Children.Get(i)
                if (m.Name == memberName) { return classDecl.Name }
            }
            return classDecl.Name  // enum method or unknown → enum name
        }
        // Class / data class
        if (k == NodeKind.CLASS_DECL) {
            let members = classDecl.Children.Count()
            for i in 0..members {
                let m  = classDecl.Children.Get(i)
                let mk = m.Kind
                if (m.Name == memberName) {
                    if (mk == NodeKind.VAR_DECL)    { return m.Str }
                    if (mk == NodeKind.METHOD_DECL) { return m.Str }
                }
            }
        }
        return "?"
    }

    // ── Program & top-level ───────────────────────────

    private void CheckProgram(AstNode prog) {
        // Pick up the per-program filename so errors are reported with
        // the right path. `this.Filename` was set once at construction
        // (to the first input file), so multi-file invocations were
        // mis-attributing every error to that first path.
        if (String_Length(prog.Str2) > 0) {
            this.Filename = prog.Str2
        }
        // Reset all per-program mutable state so that compiling
        // multiple files in one `amc` invocation (`build_amc.sh`,
        // `tests/run_multifile_test`, …) doesn't leak types from the
        // previous program. NodeKey is `(Kind, Line, Col, Name, Str)`
        // and is not file-qualified, so distinct files can collide on
        // ExprType. Local scopes can also leak when a method body
        // exits via `return` / `throw` without a balancing `PopScope`.
        this.ExprTypeKeys = new List<string>()
        this.ExprTypeVals = new List<string>()
        this.LocalNames   = new List<string>()
        this.LocalTypes   = new List<string>()
        this.ScopeStarts  = new List<int>()
        let count = prog.Children.Count()
        for i in 0..count {
            this.CheckDecl(prog.Children.Get(i))
        }
    }

    private void CheckDecl(AstNode decl) {
        let k = decl.Kind
        if (k == NodeKind.CLASS_DECL) {
            this.CheckClass(decl)
        }
        if (k == NodeKind.ENUM_DECL) {
            // Enums: check any methods inside
            let methods = decl.Children.Count()
            for i in 0..methods {
                let m = decl.Children.Get(i)
                if (m.Kind == NodeKind.METHOD_DECL) {
                    this.CheckMethod(m)
                }
            }
        }
    }

    // ── Class ─────────────────────────────────────────

    private void CheckClass(AstNode cls) {
        let prevClass      = this.CurrentClass
        this.CurrentClass  = cls.Name
        let members        = cls.Children.Count()
        // Check field initialisers and methods
        for i in 0..members {
            let m  = cls.Children.Get(i)
            let mk = m.Kind
            if (mk == NodeKind.VAR_DECL) {
                this.CheckFieldDecl(m)
            }
            if (mk == NodeKind.METHOD_DECL) {
                this.CheckMethod(m)
            }
        }
        // Verify `implements` contract: every method declared on each
        // implemented interface must exist on the class with a matching
        // signature (after substituting the interface's generic params).
        if (!cls.Flag2 && String_Length(cls.Str4) > 0) {
            this.CheckImplementsContract(cls)
        }
        this.CurrentClass = prevClass
    }

    // ── Interface contract verification ───────────────

    private void CheckImplementsContract(AstNode cls) {
        let entries = this.SplitTopLevelCommas(cls.Str4)
        let nEntries = entries.Count()
        for ie in 0..nEntries {
            let iref = entries.Get(ie)
            this.CheckOneInterface(cls, iref)
        }
    }

    private void CheckOneInterface(AstNode cls, string iref) {
        var ibase = iref
        // Reset substitution context for this interface frame
        this.SubstParams = new List<string>()
        this.SubstArgs   = new List<string>()
        let lt = String_IndexOf(iref, "<")
        if (lt > 0) {
            ibase = String_Substring(iref, 0, lt)
            let inner = String_Substring(iref, lt + 1, String_Length(iref) - lt - 2)
            let parts = this.SplitTopLevelCommas(inner)
            let np = parts.Count()
            for ia in 0..np { this.SubstArgs.Add(parts.Get(ia)) }
        }
        let iface = this.FindInterface(ibase)
        if (iface == null) {
            this.Error("class '" + cls.Name + "' implements unknown interface '" + ibase + "'", cls)
            return
        }
        if (String_Length(iface.Str3) > 0) {
            let pp = this.SplitTopLevelCommas(iface.Str3)
            let pn = pp.Count()
            for ip in 0..pn { this.SubstParams.Add(pp.Get(ip)) }
        }
        if (this.SubstParams.Count() != this.SubstArgs.Count()) {
            this.Error("interface '" + ibase + "' expects " + String_FromInt(this.SubstParams.Count()) + " type argument(s), got " + String_FromInt(this.SubstArgs.Count()), cls)
            return
        }
        let imethods = iface.Children.Count()
        for im in 0..imethods {
            let imethod = iface.Children.Get(im)
            if (imethod.Kind == NodeKind.METHOD_DECL) {
                this.CheckOneInterfaceMethod(cls, iref, imethod)
            }
        }
    }

    private void CheckOneInterfaceMethod(AstNode cls, string ifaceLabel, AstNode imethod) {
        let cmems = cls.Children.Count()
        var found: AstNode? = null
        for ic in 0..cmems {
            let m = cls.Children.Get(ic)
            if (m.Kind == NodeKind.METHOD_DECL && m.Name == imethod.Name) {
                found = m
            }
        }
        if (found == null) {
            this.Error("class '" + cls.Name + "' does not implement interface '" + ifaceLabel + "': missing method '" + imethod.Name + "'", cls)
            return
        }
        let cmethod = found
        let expectedRet = this.SubstType(imethod.Str)
        if (cmethod.Str != expectedRet) {
            this.Error("class '" + cls.Name + "' method '" + imethod.Name + "': expected return type '" + expectedRet + "' (from interface '" + ifaceLabel + "'), got '" + cmethod.Str + "'", cmethod)
            return
        }
        let iN = imethod.Params.Count()
        let cN = cmethod.Params.Count()
        if (iN != cN) {
            this.Error("class '" + cls.Name + "' method '" + imethod.Name + "': expected " + String_FromInt(iN) + " param(s), got " + String_FromInt(cN), cmethod)
            return
        }
        for ip in 0..iN {
            let ipar = imethod.Params.Get(ip)
            let cpar = cmethod.Params.Get(ip)
            let expectedType = this.SubstType(ipar.Str)
            if (cpar.Str != expectedType) {
                this.Error("class '" + cls.Name + "' method '" + imethod.Name + "' param '" + cpar.Name + "': expected type '" + expectedType + "' (from interface '" + ifaceLabel + "'), got '" + cpar.Str + "'", cpar)
                return
            }
        }
    }

    private AstNode? FindInterface(string name) {
        // Explicit `: int` annotation: ProgramCount() returns int but the
        // self-host codegen erases through the call boundary, leaving `pn`
        // typed as `void*` in the emitted C unless we pin it down here.
        // GitHub CI compiles with -Wint-conversion as an error.
        let pn: int = this.Symbols.ProgramCount()
        for ip in 0..pn {
            let prog = this.Symbols.ProgramAt(ip)
            let hit  = this.FindInterfaceInProgram(prog, name)
            if (hit != null) { return hit }
        }
        return null
    }

    private AstNode? FindInterfaceInProgram(AstNode prog, string name) {
        let cn = prog.Children.Count()
        for ic in 0..cn {
            let d = prog.Children.Get(ic)
            if (d.Kind == NodeKind.CLASS_DECL && d.Flag2 && d.Name == name) {
                return d
            }
        }
        return null
    }

    // Split a CSV at top level only — commas inside <...> stay grouped.
    // Used for both implements lists and generic type arg lists.
    private List<string> SplitTopLevelCommas(string s) {
        let result = new List<string>()
        let len = String_Length(s)
        if (len == 0) { return result }
        var depth = 0
        var start = 0
        for i in 0..len {
            let c = String_CharAt1(s, i)
            if (c == "<") {
                depth = depth + 1
            } else if (c == ">") {
                depth = depth - 1
            } else if (c == "," && depth == 0) {
                let part = String_Trim(String_Substring(s, start, i - start))
                if (String_Length(part) > 0) { result.Add(part) }
                start = i + 1
            }
        }
        let last = String_Trim(String_Substring(s, start, len - start))
        if (String_Length(last) > 0) { result.Add(last) }
        return result
    }

    // Substitute interface generic params by concrete args in a type string.
    // Reads from this.SubstParams / this.SubstArgs (set by CheckOneInterface).
    // Recurses into nested generics: "List<T>" + (T → int) → "List<int>".
    // Preserves trailing "?" nullability marker.
    private string SubstType(string t) {
        if (String_Length(t) == 0) { return t }
        var nullable = false
        var core = t
        if (String_EndsWith(t, "?")) {
            nullable = true
            core = String_Substring(t, 0, String_Length(t) - 1)
        }
        let lt = String_IndexOf(core, "<")
        if (lt < 0) {
            let resolved = this.LookupParam(core)
            if (nullable) { return resolved + "?" }
            return resolved
        }
        let base = String_Substring(core, 0, lt)
        let inner = String_Substring(core, lt + 1, String_Length(core) - lt - 2)
        let parts = this.SplitTopLevelCommas(inner)
        var newInner = ""
        let n = parts.Count()
        for i in 0..n {
            if (i > 0) { newInner = newInner + "," }
            newInner = newInner + this.SubstType(parts.Get(i))
        }
        let result = base + "<" + newInner + ">"
        if (nullable) { return result + "?" }
        return result
    }

    private string LookupParam(string t) {
        let n = this.SubstParams.Count()
        for i in 0..n {
            if (this.SubstParams.Get(i) == t) { return this.SubstArgs.Get(i) }
        }
        return t
    }

    private void CheckFieldDecl(AstNode field) {
        let fieldType = field.Str
        if (field.Left != null) {
            this.CheckExpr(field.Left)
            let initType = this.GetType(field.Left)
            if (!this.IsAssignable(fieldType, initType)) {
                this.Error("Field '" + field.Name + "' declared as '" + fieldType + "' but initialised with '" + initType + "'", field.Left)
            }
        }
    }

    // ── Method ───────────────────────────────────────

    private void CheckMethod(AstNode method) {
        let retType        = method.Str   // return type stored in Str by parser
        let prevReturn     = this.CurrentReturn
        this.CurrentReturn = retType

        this.PushScope()

        // Check params (default values) and register them in the local scope
        let params = method.Params.Count()
        for i in 0..params {
            let p = method.Params.Get(i)
            if (p.Left != null) {
                this.CheckExpr(p.Left)
                let defType = this.GetType(p.Left)
                if (!this.IsAssignable(p.Str, defType)) {
                    this.Error("Parameter '" + p.Name + "' is '" + p.Str + "' but default is '" + defType + "'", p.Left)
                }
            }
            this.DeclareLocal(p.Name, p.Str)
        }

        // Check body
        if (method.Body != null) {
            this.CheckBlock(method.Body)
        }

        this.PopScope()
        this.CurrentReturn = prevReturn
    }

    // ── Statements ───────────────────────────────────

    private void CheckBlock(AstNode block) {
        let stmts = block.Children.Count()
        for i in 0..stmts {
            this.CheckStmt(block.Children.Get(i))
        }
    }

    private void CheckStmt(AstNode stmt) {
        let k = stmt.Kind
        if (k == NodeKind.VAR_DECL) {
            this.CheckVarDecl(stmt)
            return
        }
        if (k == NodeKind.RETURN_STMT) {
            this.CheckReturn(stmt)
            return
        }
        if (k == NodeKind.IF_STMT) {
            this.CheckIf(stmt)
            return
        }
        if (k == NodeKind.WHILE_STMT) {
            if (stmt.Cond != null) {
                this.CheckExpr(stmt.Cond)
                this.CheckBool(stmt.Cond, "while condition")
            }
            if (stmt.Body != null) { this.CheckBlock(stmt.Body) }
            return
        }
        if (k == NodeKind.FOR_IN_STMT) {
            this.CheckForIn(stmt)
            return
        }
        if (k == NodeKind.BREAK_STMT || k == NodeKind.CONTINUE_STMT) { return }
        if (k == NodeKind.INLINE_C) {
            // Inline-C is unchecked by design — body is raw C.
            return
        }
        if (k == NodeKind.TRY_STMT) {
            if (stmt.Body != null) { this.CheckBlock(stmt.Body) }
            if (stmt.Else != null) {
                this.PushScope()
                if (String_Length(stmt.Name) > 0) {
                    this.DeclareLocal(stmt.Name, "void*")
                }
                this.CheckBlock(stmt.Else)
                this.PopScope()
            }
            if (stmt.Cond != null) { this.CheckBlock(stmt.Cond) }
            return
        }
        if (k == NodeKind.THROW_STMT) {
            if (stmt.Left != null) { this.CheckExpr(stmt.Left) }
            return
        }
        // Expression statement (call, assign, binary, etc.)
        if (k == NodeKind.ASSIGN) {
            this.CheckAssign(stmt)
            return
        }
        // Match
        if (stmt.Name == "__match__") {
            this.CheckMatch(stmt)
            return
        }
        // Fallback: treat as expression
        this.CheckExpr(stmt)
    }

    private void CheckVarDecl(AstNode stmt) {
        let declaredType = stmt.Str    // "" if inferred
        var inferredType = "?"
        if (stmt.Left != null) {
            this.CheckExpr(stmt.Left)
            inferredType = this.GetType(stmt.Left)
        }
        // Tuple destructuring (`let (a, b) = expr`): the parser stores
        // "__tuple_destructure__" as the type marker. Skip the assignability
        // check — the RHS is a tuple call whose type doesn't match the
        // marker and the codegen handles unpacking via __auto_type.
        if (declaredType == "__tuple_destructure__") {
            return
        }
        let finalType = if (String_Length(declaredType) > 0) { declaredType } else { inferredType }
        if (String_Length(declaredType) > 0 && inferredType != "?") {
            if (!this.IsAssignable(declaredType, inferredType)) {
                this.Error("Cannot assign '" + inferredType + "' to '" + stmt.Name + "' of type '" + declaredType + "'", stmt)
            }
        }
        // Register in local scope
        this.DeclareLocal(stmt.Name, finalType)
    }

    private void CheckReturn(AstNode stmt) {
        // ParseReturn synthesises an `_unknown_` IDENTIFIER for a bare
        // `return` (so EmitReturn can detect it without a nullable Left).
        // Treat it the same as `stmt.Left == null` here.
        var isBare = stmt.Left == null
        if (!isBare && stmt.Left != null) {
            if (stmt.Left.Kind == NodeKind.IDENTIFIER && stmt.Left.Name == "_unknown_") {
                isBare = true
            }
        }
        if (isBare) {
            // void return
            if (this.CurrentReturn != "void" && this.CurrentReturn != "?") {
                this.Error("Empty return in method expecting '" + this.CurrentReturn + "'", stmt)
            }
            return
        }
        this.CheckExpr(stmt.Left)
        let valType = this.GetType(stmt.Left)
        if (this.CurrentReturn == "void") {
            this.Error("Cannot return a value from a void method", stmt)
        } else if (!this.IsAssignable(this.CurrentReturn, valType)) {
            this.Error("Return type mismatch: expected '" + this.CurrentReturn + "', got '" + valType + "'", stmt)
        }
    }

    private void CheckIf(AstNode stmt) {
        if (stmt.Cond != null) {
            this.CheckExpr(stmt.Cond)
            this.CheckBool(stmt.Cond, "if condition")
        }
        if (stmt.Body != null) { this.CheckBlock(stmt.Body) }
        if (stmt.Else != null) {
            this.CheckElseBranch(stmt.Else)
        }
    }

    private void CheckElseBranch(AstNode branch) {
        if (branch == null) { return }
        let bk = branch.Kind
        if (bk == NodeKind.IF_STMT) {
            this.CheckIf(branch)
        } else {
            this.CheckBlock(branch)
        }
    }

    private void CheckForIn(AstNode stmt) {
        // stmt.Left = iterator expression (range or collection)
        // stmt.Name = loop variable name
        this.PushScope()
        if (stmt.Left != null) {
            this.CheckExpr(stmt.Left)
            let colType  = this.GetType(stmt.Left)
            let elemType = this.CollectionElementType(colType)
            this.DeclareLocal(stmt.Name, elemType)
        }
        if (stmt.Body != null) { this.CheckBlock(stmt.Body) }
        this.PopScope()
    }

    private void CheckAssign(AstNode stmt) {
        if (stmt.Left != null)  { this.CheckExpr(stmt.Left) }
        if (stmt.Right != null) { this.CheckExpr(stmt.Right) }
        if (stmt.Left != null && stmt.Right != null) {
            let targetType = this.GetType(stmt.Left)
            let valueType  = this.GetType(stmt.Right)
            if (!this.IsAssignable(targetType, valueType)) {
                this.Error("Cannot assign '" + valueType + "' to '" + targetType + "'", stmt)
            }
        }
    }

    private void CheckMatch(AstNode stmt) {
        // stmt.Left = subject expression, stmt.Children = arms
        if (stmt.Left != null) {
            this.CheckExpr(stmt.Left)
        }
        let armCount = stmt.Children.Count()
        for i in 0..armCount {
            this.CheckMatchArm(stmt.Children.Get(i))
        }
    }

    // ── Expressions ──────────────────────────────────

    private void CheckMatchArm(AstNode arm) {
        if (arm == null) { return }
        let body = arm.Right
        if (body == null) { return }
        let bk = body.Kind
        if (bk == NodeKind.BLOCK) {
            this.CheckBlock(body)
        } else {
            this.CheckStmt(body)
        }
    }

    private void CheckExpr(AstNode expr) {
        if (expr == null) { return }
        let k = expr.Kind

        if (k == NodeKind.LITERAL_INT) {
            this.SetType(expr, "int")
            return
        }
        if (k == NodeKind.LITERAL_FLOAT) {
            this.SetType(expr, "float")
            return
        }
        if (k == NodeKind.LITERAL_STRING) {
            this.SetType(expr, "string")
            return
        }
        if (k == NodeKind.LITERAL_BOOL) {
            this.SetType(expr, "bool")
            return
        }
        if (k == NodeKind.LITERAL_NULL) {
            this.SetType(expr, "null")
            return
        }
        if (k == NodeKind.THIS_EXPR) {
            this.SetType(expr, this.CurrentClass)
            return
        }
        if (k == NodeKind.IDENTIFIER) {
            // Local scope first (params + let/var bindings), then resolver globals
            var t = this.LookupLocal(expr.Name)
            if (String_Length(t) == 0) {
                t = this.SymbolTypeName(expr.Name)
            }
            this.SetType(expr, t)
            return
        }
        if (k == NodeKind.BINARY) {
            this.CheckBinaryExpr(expr)
            return
        }
        if (k == NodeKind.UNARY) {
            this.CheckUnaryExpr(expr)
            return
        }
        if (k == NodeKind.MEMBER) {
            this.CheckMemberExpr(expr)
            return
        }
        if (k == NodeKind.CALL) {
            this.CheckCallExpr(expr)
            return
        }
        if (k == NodeKind.NEW_EXPR) {
            this.CheckNewExpr(expr)
            return
        }
        if (k == NodeKind.INDEX_EXPR) {
            this.CheckIndexExpr(expr)
            return
        }
        if (k == NodeKind.ASSIGN) {
            this.CheckAssign(expr)
            return
        }
        if (k == NodeKind.IF_STMT) {
            // if-expression — use helper to avoid chained-access type inference bug
            if (expr.Cond != null) {
                this.CheckExpr(expr.Cond)
                this.CheckBool(expr.Cond, "if condition")
            }
            let thenType = this.CheckIfBranch(expr.Body)
            let elseType = this.CheckIfBranch(expr.Else)
            let ifType   = if (thenType != "?") { thenType } else { elseType }
            this.SetType(expr, ifType)
            return
        }
        // Unknown/unhandled — mark as ?
        this.SetType(expr, "?")
    }

    // Extract and check a single expression from an if-expr branch block.
    // Uses explicit AstNode parameter so the Resolver can track types correctly.
    private string CheckIfBranch(AstNode block) {
        if (block == null) { return "?" }
        if (block.Kind == NodeKind.BLOCK) {
            let kids = block.Children
            if (kids.Count() > 0) {
                let first = kids.Get(0)
                this.CheckExpr(first)
                return this.GetType(first)
            }
            return "?"
        }
        this.CheckExpr(block)
        return this.GetType(block)
    }

    private void CheckBinaryExpr(AstNode expr) {
        let op = expr.Str
        if (expr.Left  != null) { this.CheckExpr(expr.Left) }
        if (expr.Right != null) { this.CheckExpr(expr.Right) }
        let lt = if (expr.Left  != null) { this.GetType(expr.Left)  } else { "?" }
        let rt = if (expr.Right != null) { this.GetType(expr.Right) } else { "?" }

        // Logical operators require bool operands
        if (op == "&&" || op == "||") {
            if (!this.IsBool(lt)) {
                this.Error("Left operand of '" + op + "' must be bool, got '" + lt + "'", expr.Left)
            }
            if (!this.IsBool(rt)) {
                this.Error("Right operand of '" + op + "' must be bool, got '" + rt + "'", expr.Right)
            }
        }
        // Arithmetic (non-string) requires numeric operands
        if (op == "-" || op == "*" || op == "/" || op == "%" || op == "^") {
            if (!this.IsNumeric(lt) && lt != "?") {
                this.Error("Operator '" + op + "' requires numeric operands, got '" + lt + "'", expr.Left)
            }
            if (!this.IsNumeric(rt) && rt != "?") {
                this.Error("Operator '" + op + "' requires numeric operands, got '" + rt + "'", expr.Right)
            }
        }
        // Null coalescing: left must be nullable
        if (op == "??") {
            if (!this.IsNullable(lt) && lt != "?") {
                let qqOp = "?"
                let qqOp2 = "?"
                this.Error("Left operand of '" + qqOp + qqOp2 + "' must be nullable, got '" + lt + "'", expr.Left)
            }
        }
        let result = this.BinaryResultType(op, lt, rt)
        this.SetType(expr, result)
    }

    private void CheckUnaryExpr(AstNode expr) {
        let op = expr.Str
        if (expr.Left != null) { this.CheckExpr(expr.Left) }
        let ot = if (expr.Left != null) { this.GetType(expr.Left) } else { "?" }
        if (op == "!") {
            if (!this.IsBool(ot)) {
                this.Error("Operator '!' requires bool, got '" + ot + "'", expr.Left)
            }
            this.SetType(expr, "bool")
            return
        }
        if (op == "-") {
            if (!this.IsNumeric(ot) && ot != "?") {
                this.Error("Unary '-' requires numeric, got '" + ot + "'", expr.Left)
            }
            this.SetType(expr, ot)
            return
        }
        this.SetType(expr, ot)
    }

    private void CheckMemberExpr(AstNode expr) {
        // expr.Left = target, expr.Name = member name
        if (expr.Left != null) { this.CheckExpr(expr.Left) }
        let targetType = if (expr.Left != null) { this.GetType(expr.Left) } else { "?" }
        var baseType = targetType
        // Strip trailing nullable '?'
        if (String_EndsWith(baseType, "?")) {
            baseType = String_Substring(baseType, 0, String_Length(baseType) - 1)
        }
        // Strip trailing pointer '*' (MemberTable keys are bare class names)
        if (String_EndsWith(baseType, "*")) {
            baseType = String_Substring(baseType, 0, String_Length(baseType) - 1)
        }
        var memberType = "?"
        if (String_Length(baseType) > 0 && baseType != "?") {
            memberType = this.Symbols.GetMemberType(baseType, expr.Name)
        }
        this.SetType(expr, memberType)
    }

    private void CheckCallExpr(AstNode expr) {
        // expr.Left = callee, expr.Args = arguments
        if (expr.Left != null) { this.CheckExpr(expr.Left) }
        let argc = expr.Args.Count()
        for i in 0..argc {
            this.CheckExpr(expr.Args.Get(i))
        }
        // Return type: look up callee symbol if it's a simple identifier
        var calleeType = "?"
        let callee = expr.Left
        if (callee != null) {
            let calleeKind = callee.Kind
            if (calleeKind == NodeKind.IDENTIFIER) {
                calleeType = this.SymbolTypeName(callee.Name)
            } else if (calleeKind == NodeKind.MEMBER) {
                calleeType = this.GetType(callee)
            }
        }
        // First-class function support (v0.8.30+): when the callee
        // is a value of type `Closure` (a stored function reference),
        // the call expression's type is the closure's return value,
        // not the closure itself. Since closures are currently
        // untyped at the AM level (args/result erased to i64/void*),
        // surface the call result as `?` so it round-trips through
        // IsAssignable cleanly. A future typed-Closure proposal
        // will replace this with the closure's declared return type.
        if (calleeType == "Closure" || calleeType == "AmalgameClosure*") {
            calleeType = "?"
        }
        this.SetType(expr, calleeType)
    }

    private void CheckNewExpr(AstNode expr) {
        // expr.Name = type name, expr.Args = constructor args
        let argc = expr.Args.Count()
        for i in 0..argc {
            this.CheckExpr(expr.Args.Get(i))
        }
        this.SetType(expr, expr.Name)
    }

    private void CheckIndexExpr(AstNode expr) {
        if (expr.Left  != null) { this.CheckExpr(expr.Left) }
        if (expr.Right != null) { this.CheckExpr(expr.Right) }
        let targetType = if (expr.Left != null) { this.GetType(expr.Left) } else { "?" }
        let elemType   = this.CollectionElementType(targetType)
        this.SetType(expr, elemType)
    }

    // ── Summary ───────────────────────────────────────

    public bool HasErrors() {
        return this.Errors.Count() > 0
    }

    public string FormatErrors() {
        var result = ""
        let count = this.Errors.Count()
        for i in 0..count {
            let e = this.Errors.Get(i)
            result = result + e.ToString()
        }
        return result
    }
}
