namespace Amalgame.Compiler

import Amalgame.Collections
import Amalgame.IO
import Amalgame.Process
import Amalgame.String

// `@c { … }` blocks below need execvp / fork / pipe2 / poll /
// perror / malloc visible. _runtime.h already brings in <stdio.h>,
// <stdlib.h>, <string.h>; we only need <unistd.h> for execvp/fork/
// pipe2 and <poll.h> for poll(2) (used by the bridge — Phase 2+).
@c_include "<unistd.h>"
@c_include "<poll.h>"
@c_include "<sys/wait.h>"
@c_include "<fcntl.h>"
@c_include "<errno.h>"
@c_include "<signal.h>"

// ═══════════════════════════════════════════════════════
//  dap.am  —  amc dap: Debug Adapter Protocol
// ═══════════════════════════════════════════════════════
//
// Two operating modes:
//
// 1. **Raw / proxy** (Approche C, shipped v0.8.0; `amc dap --raw` or
//    the macOS default while the bridge is gdb-only):
//    `execvp()` the host's DAP-native backend — `lldb-dap` (Linux
//    /macOS via LLVM) or `gdb --dap` (Linux/Windows MSYS2 with
//    gdb ≥ 14). The kernel replaces our process image; stdin/stdout
//    flow directly between the DAP client and the backend with no
//    in-amc copy. cgen-emitted `#line N "foo.am"` directives let the
//    backend resolve .am source paths natively via DWARF.
//
// 2. **Bridge** (Approche A, design in `docs/proposals/dap-strategy.md`;
//    gradual rollout):
//    `fork + pipe2 + poll(2)` to spawn `gdb --interpreter=mi3`. Every
//    DAP request and gdb MI response passes through amc, which
//    rewrites the relevant ones:
//      - pretty-print AmalgameList* / Map* / Set* / Closure* / code_string
//      - filter `^_runtime_` / `^Amalgame_` frames from stackTrace
//      - decode `LamEnv_N` closure captures
//    Falls back to RunRaw on hosts without gdb, so the bridge stays
//    optional.
//
// Phase 1 of the bridge migration (the present revision) ships the
// flag plumbing (`--raw`, `--show-runtime`, `--bridge`) and an
// internal dispatch boundary. `RunBridge()` currently no-ops back to
// `RunRaw()` — Phase 2 replaces it with the actual fork+pipe2+poll
// loop.

public class DapServer {

    // Opt-out of the bridge; force the v0.8.0 execvp proxy. Useful
    // when the bridge has a regression or the user wants the macOS
    // lldb-dap codepath even on a host that also has gdb installed.
    public Raw: bool

    // When the bridge is filtering frames, expose `^Amalgame_` and
    // `^_runtime_` frames in the call stack anyway. Lets users debug
    // runtime-level issues without having to drop into `--raw`.
    public ShowRuntime: bool

    // Bridge state — populated by SpawnGdb, drained by PollLoop and
    // closed during cleanup. Field types match the C pid_t (signed
    // 32-bit on every platform amc targets) and the int FDs returned
    // by pipe2/dup2.
    public GdbInFd:       int
    public GdbOutFd:      int
    public GdbPid:        int
    public StopRequested: bool
    public StdinOpen:     bool

    // Per-direction byte accumulators for the framing-aware I/O
    // pumps. DAP input is `Content-Length: N\r\n\r\n<json>`;
    // gdb output is line-oriented MI3 with `(gdb)` prompts.
    // Partial frames live here between poll iterations.
    public DapInputBuf: string
    public GdbInputBuf: string

    // Token counter for MI commands. Each `Pos-MI-cmd` sent to gdb
    // gets a fresh `<token>-…` prefix so responses can be correlated
    // back to the DAP request id. Map MiToken→DapRequestId+kind.
    public NextMiToken:   int
    public MiTokens:      List<int>     // outstanding command tokens
    public MiTokensReq:   List<int>     // parallel: dap request id
    public MiTokensKind:  List<string>  // parallel: dap method that issued it

    // DAP spec requires every outbound message (request/response/
    // event) to carry a monotonically increasing `seq` independent
    // of request_seq. Bumped by NextOutSeq().
    public _outSeqCounter: int

    // In-flight setBreakpoints request state. VS Code sends these
    // serially per source so a single-slot tracker suffices for the
    // MVP. Once Phase 7 flips the bridge default + multi-source
    // breakpoint editors come into scope, generalise to a per-source
    // queue.
    public BkptInFlight:        bool
    public BkptInFlightSeq:     int
    public BkptInFlightSource:  string
    public BkptInFlightPending: int
    public BkptInFlightDapShape: List<string>  // accumulating DAP Breakpoint JSON snippets
    public BkptKnownNumbers:    List<int>      // gdb breakpoint numbers currently set

    // Step-until-visible state (Phase 5A). After `stepIn` lands on
    // a frame whose `func` matches the hidden-frame patterns
    // (Amalgame_*, _runtime_*, GC_*), the bridge auto-issues
    // additional `-exec-step`s up to this budget before surfacing
    // the resulting *stopped event. Prevents users from getting
    // stuck inside generated runtime helpers. 8 hops is enough for
    // any reasonable getter/setter chain; deeper rabbit holes get
    // surfaced so the user doesn't loop forever.
    public StepBudget: int

    // Pretty-printer follow-up state (Phase 5B+5C). Each variables
    // request — both for the Locals scope (variablesReference=1) AND
    // for drill-down into containers (variablesReference > 1) —
    // populates these parallel lists and runs serial follow-ups.
    // Generic across both shapes:
    //   - Queries[i]   : MI eval expression to enrich Values[i]; "" =
    //                    no follow-up (Values is final as-is)
    //   - Names/Types/Values : final DAP `Variable` fields
    //   - Refs[i]      : variablesReference for drill-down; 0 = leaf
    //   - Idx          : cursor through Queries during follow-up walk
    public PendingVars_Seq:     int
    public PendingVars_Names:   List<string>
    public PendingVars_Types:   List<string>
    public PendingVars_Values:  List<string>
    public PendingVars_Queries: List<string>
    public PendingVars_Refs:    List<int>
    public PendingVars_Idx:     int

    // Drill-down registry (Phase 5C). When a Locals follow-up
    // returns the size of an AmalgameList*/Map*/Set*, the bridge
    // allocates a fresh variablesReference id and stores the parent
    // type + pointer expression + size here. A subsequent
    // `variables(variablesReference=N)` from the client looks up the
    // entry to synthesize child eval queries.
    public ChildRef_Refs:  List<int>
    public ChildRef_Types: List<string>   // "AmalgameList" / "AmalgameMap" / "AmalgameSet"
    public ChildRef_Addrs: List<string>   // pointer addr as gdb-eval-ready string
    public ChildRef_Sizes: List<int>
    public NextChildRef:   int            // varRef id pool, starts at 1000

    public DapServer() {
        this.Raw           = false
        this.ShowRuntime   = false
        this.GdbInFd       = -1
        this.GdbOutFd      = -1
        this.GdbPid        = -1
        this.StopRequested = false
        this.StdinOpen     = true
        this.DapInputBuf   = ""
        this.GdbInputBuf   = ""
        this.NextMiToken   = 100
        this.MiTokens      = new List<int>()
        this.MiTokensReq   = new List<int>()
        this.MiTokensKind  = new List<string>()
        this._outSeqCounter = 0
        this.BkptInFlight         = false
        this.BkptInFlightSeq      = -1
        this.BkptInFlightSource   = ""
        this.BkptInFlightPending  = 0
        this.BkptInFlightDapShape = new List<string>()
        this.BkptKnownNumbers     = new List<int>()
        this.StepBudget           = 0
        this.PendingVars_Seq      = -1
        this.PendingVars_Names    = new List<string>()
        this.PendingVars_Types    = new List<string>()
        this.PendingVars_Values   = new List<string>()
        this.PendingVars_Queries  = new List<string>()
        this.PendingVars_Refs     = new List<int>()
        this.PendingVars_Idx      = 0
        this.ChildRef_Refs        = new List<int>()
        this.ChildRef_Types       = new List<string>()
        this.ChildRef_Addrs       = new List<string>()
        this.ChildRef_Sizes       = new List<int>()
        this.NextChildRef         = 1000
    }

    public int Run() {
        // Strip our own flags from the argv tail before dispatch so
        // RunRaw / RunBridge don't have to know about them.
        this.ParseFlags()
        // Hidden self-test flag: exercise the MI parser against
        // canned inputs from the gdb manual without needing gdb
        // itself. Returns 0 on PASS, 1 on FAIL. Wired into
        // run_tests.sh's "amc dap" section.
        if (this.HasFlag("--self-test-mi")) {
            return DapServer.RunSelfTestMi()
        }
        if (this.Raw) {
            return this.RunRaw()
        }
        return this.RunBridge()
    }

    // Check whether a particular flag was passed on argv[2..]. Used
    // by hidden test flags so they don't have to be threaded through
    // ParseFlags' bit-set table.
    private bool HasFlag(string needle) {
        var found: bool = false
        @c {
            for (int i = 2; i < code_argc; i++) {
                if (code_argv[i] == NULL) continue;
                if (strcmp(code_argv[i], (const char*) needle) == 0) {
                    found = 1;
                    break;
                }
            }
        }
        return found
    }

    // Exercise MiParser against a representative slice of gdb MI3
    // output. Returns 0 on all PASS, 1 on first FAIL. Emits PASS/FAIL
    // lines on stdout so run_tests.sh can grep for them.
    //
    // Coverage: result records (with + without token), exec-async
    // *stopped events, stack-list-frames lists of `frame=…` pairs,
    // nested tuples, console-stream records with escape sequences,
    // and the bare `(gdb)` prompt.
    private static int RunSelfTestMi() {
        var failures: int = 0
        // ── Case 1 — simple result with one tuple field ─────
        let in1: string = "1^done,bkpt={number=\"1\",file=\"hello.c\",line=\"5\"}"
        let p1 = new MiParser(in1)
        let r1: MiRecord = p1.ParseRecord()
        if (r1.Token == 1 && r1.RecordKind == 0 && r1.Class == "done") {
            let bkpt: MiValue = r1.ResultOrNull("bkpt")
            if (bkpt != null && bkpt.Kind == 1
                && bkpt.FieldString("number") == "1"
                && bkpt.FieldString("file")   == "hello.c"
                && bkpt.FieldString("line")   == "5") {
                Console.WriteLine("[PASS] mi: result with tuple field")
            } else {
                Console.WriteLine("[FAIL] mi: result tuple fields")
                failures = failures + 1
            }
        } else {
            Console.WriteLine("[FAIL] mi: result envelope (token/kind/class)")
            failures = failures + 1
        }
        // ── Case 2 — *stopped event with nested frame ──────
        let in2: string = "*stopped,reason=\"breakpoint-hit\",frame={addr=\"0x4007a0\",func=\"main\",file=\"hello.c\",line=\"5\"},thread-id=\"1\""
        let p2 = new MiParser(in2)
        let r2: MiRecord = p2.ParseRecord()
        if (r2.RecordKind == 1 && r2.Class == "stopped"
            && r2.Token == -1) {
            let reason: string = ""
            let nResults: int = r2.Results.Count()
            var seenReason: bool = false
            var seenTid:    bool = false
            for i in 0..nResults {
                let v: MiValue = r2.Values.Get(i)
                if (r2.Results.Get(i) == "reason"    && v.Str == "breakpoint-hit") { seenReason = true }
                if (r2.Results.Get(i) == "thread-id" && v.Str == "1")              { seenTid    = true }
            }
            let frame: MiValue = r2.ResultOrNull("frame")
            if (seenReason && seenTid && frame != null && frame.FieldString("func") == "main") {
                Console.WriteLine("[PASS] mi: stopped event w/ nested frame")
            } else {
                Console.WriteLine("[FAIL] mi: stopped event fields")
                failures = failures + 1
            }
        } else {
            Console.WriteLine("[FAIL] mi: stopped event envelope")
            failures = failures + 1
        }
        // ── Case 3 — list of keyed `frame=` items ──────────
        let in3: string = "^done,stack=[frame={level=\"0\",func=\"f0\"},frame={level=\"1\",func=\"f1\"}]"
        let p3 = new MiParser(in3)
        let r3: MiRecord = p3.ParseRecord()
        let stack: MiValue = r3.ResultOrNull("stack")
        if (stack != null && stack.Kind == 2 && stack.ListItems.Count() == 2
            && stack.ListKeys.Get(0) == "frame" && stack.ListKeys.Get(1) == "frame"
            && stack.ListItems.Get(0).FieldString("func") == "f0"
            && stack.ListItems.Get(1).FieldString("func") == "f1") {
            Console.WriteLine("[PASS] mi: stack=[frame=…,frame=…]")
        } else {
            Console.WriteLine("[FAIL] mi: keyed-list parsing")
            failures = failures + 1
        }
        // ── Case 4 — list of bare-value tuples ─────────────
        let in4: string = "^done,locals=[{name=\"A\",value=\"1\"},{name=\"B\",value=\"2\"}]"
        let p4 = new MiParser(in4)
        let r4: MiRecord = p4.ParseRecord()
        let locs: MiValue = r4.ResultOrNull("locals")
        if (locs != null && locs.Kind == 2 && locs.ListItems.Count() == 2
            && locs.ListKeys.Get(0) == "" && locs.ListKeys.Get(1) == ""
            && locs.ListItems.Get(0).FieldString("name") == "A"
            && locs.ListItems.Get(1).FieldString("value") == "2") {
            Console.WriteLine("[PASS] mi: locals=[{…},{…}]")
        } else {
            Console.WriteLine("[FAIL] mi: bare-tuple-list parsing")
            failures = failures + 1
        }
        // ── Case 5 — console-stream w/ escapes ─────────────
        let in5: string = "~\"Breakpoint 1 at 0x4007a0: file hello.c, line 5.\\n\""
        let p5 = new MiParser(in5)
        let r5: MiRecord = p5.ParseRecord()
        if (r5.RecordKind == 4 && String_IndexOf(r5.StreamText, "Breakpoint 1") == 0
            && String_IndexOf(r5.StreamText, "\n") >= 0) {
            Console.WriteLine("[PASS] mi: console-stream w/ \\n escape")
        } else {
            Console.WriteLine("[FAIL] mi: stream unescape")
            failures = failures + 1
        }
        // ── Case 6 — (gdb) prompt ──────────────────────────
        let in6: string = "(gdb)"
        let p6 = new MiParser(in6)
        let r6: MiRecord = p6.ParseRecord()
        if (r6.RecordKind == 7) {
            Console.WriteLine("[PASS] mi: (gdb) prompt")
        } else {
            Console.WriteLine("[FAIL] mi: (gdb) prompt detection")
            failures = failures + 1
        }
        // ── Case 7 — empty list / empty tuple ──────────────
        let in7: string = "^done,foo={},bar=[]"
        let p7 = new MiParser(in7)
        let r7: MiRecord = p7.ParseRecord()
        let foo: MiValue = r7.ResultOrNull("foo")
        let bar: MiValue = r7.ResultOrNull("bar")
        if (foo != null && foo.Kind == 1 && foo.TupleKeys.Count() == 0
            && bar != null && bar.Kind == 2 && bar.ListItems.Count() == 0) {
            Console.WriteLine("[PASS] mi: empty {} and []")
        } else {
            Console.WriteLine("[FAIL] mi: empty containers")
            failures = failures + 1
        }
        // ── Case 8 — escaped quote inside string ───────────
        let in8: string = "^done,msg=\"he said \\\"hi\\\"\""
        let p8 = new MiParser(in8)
        let r8: MiRecord = p8.ParseRecord()
        let msgVal: MiValue = r8.ResultOrNull("msg")
        var msg: string = ""
        if (msgVal != null) { msg = msgVal.Str }
        if (msg == "he said \"hi\"") {
            Console.WriteLine("[PASS] mi: escaped \\\" inside string")
        } else {
            Console.WriteLine("[FAIL] mi: escape inside string (got '" + msg + "')")
            failures = failures + 1
        }
        // ── Case 9 — octal escape for UTF-8 byte (\303\251 = é) ─
        // Regression for the "Développement → D303251veloppement"
        // bug shipped before 2026-05-22. gdb MI encodes every
        // non-ASCII byte as an octal triple; without this branch
        // the digits leaked into the un-escaped string as literals.
        let in9: string = "^done,path=\"/tmp/D\\303\\251v\""
        let p9 = new MiParser(in9)
        let r9: MiRecord = p9.ParseRecord()
        let pathVal: MiValue = r9.ResultOrNull("path")
        var path: string = ""
        if (pathVal != null) { path = pathVal.Str }
        // The two octal escapes encode the two UTF-8 bytes of `é`
        // (0xC3 0xA9). String_FromByte builds a 1-byte string for
        // each; concat yields a valid UTF-8 `é` followed by `v`.
        let expected: string = "/tmp/D" + String_FromByte(195) + String_FromByte(169) + "v"
        if (path == expected) {
            Console.WriteLine("[PASS] mi: octal \\NNN escape (UTF-8 byte)")
        } else {
            Console.WriteLine("[FAIL] mi: octal escape (got '" + path + "')")
            failures = failures + 1
        }
        if (failures > 0) {
            Console.WriteError("amc dap --self-test-mi: " + String_FromInt(failures) + " case(s) failed")
            return 1
        }
        return 0
    }

    // Set this.Raw / this.ShowRuntime from argv. ExecBackend's argv
    // builder re-scans argv to skip the same flags when building the
    // backend's argv vector — we don't mutate code_argv here so the
    // builder can stay simple.
    private void ParseFlags() {
        @c {
            for (int i = 2; i < code_argc; i++) {
                if (code_argv[i] == NULL) continue;
                const char* a = code_argv[i];
                if (strcmp(a, "--raw") == 0) {
                    self->Raw = 1;
                } else if (strcmp(a, "--show-runtime") == 0) {
                    self->ShowRuntime = 1;
                }
                // `--bridge` is recognised in the argv scan below
                // (so it's stripped from the backend's view) — it's
                // a no-op flag while Phase 1 ships, kept for forward
                // compat with scripts.
            }
            return;
        }
    }

    // Bridge entry point. Spawns `gdb --interpreter=mi3`, enters a
    // poll-driven I/O loop that pipes DAP traffic between the client
    // (stdin/stdout) and gdb (pipe FDs).
    //
    // During the migration the bridge is opt-in via `--bridge`. The
    // default codepath stays on `RunRaw()` so users get the
    // (well-trodden) v0.8.0 execvp proxy until Phase 7 flips the
    // default. When gdb isn't on PATH, we transparently fall back
    // to the proxy — the user gets a working session either way.
    //
    // Phase 2a (this commit) ships **passthrough**: bytes from the
    // client go straight to gdb's stdin, bytes from gdb come straight
    // out on stdout. No DAP framing, no MI parsing, no translation —
    // that's Phase 2b+. The current shape is testable end-to-end with
    // `echo '-gdb-version' | amc dap --bridge` against gdb directly.
    public int RunBridge() {
        if (!this.HasFlag("--bridge")) {
            return this.RunRaw()
        }
        let gdbPath: string = DapServer.Probe("gdb")
        if (String_Length(gdbPath) == 0) {
            Console.WriteError("amc dap --bridge: gdb not on PATH; falling back to --raw")
            return this.RunRaw()
        }
        let spawnRc: int = this.SpawnGdb(gdbPath)
        if (spawnRc != 0) {
            return spawnRc
        }
        return this.PollLoop()
    }

    // fork + pipe2 + dup2 + execlp the gdb child. Returns 0 on
    // success with this.GdbInFd / GdbOutFd / GdbPid populated; 1
    // on any setup failure (a perror is printed inside the @c block).
    //
    // `--nx` skips ~/.gdbinit so user configuration doesn't surprise
    // the bridge; `--quiet` drops the GDB version banner stream
    // records (still emitted on `=thread-group-added` for free).
    private int SpawnGdb(string gdbPath) {
        @c {
            int parentToChild[2];  // parent writes, child reads → gdb stdin
            int childToParent[2];  // child writes, parent reads → gdb stdout
            if (pipe2(parentToChild, O_CLOEXEC) < 0) {
                perror("amc dap --bridge: pipe2 in");
                return 1;
            }
            if (pipe2(childToParent, O_CLOEXEC) < 0) {
                perror("amc dap --bridge: pipe2 out");
                close(parentToChild[0]); close(parentToChild[1]);
                return 1;
            }
            pid_t pid = fork();
            if (pid < 0) {
                perror("amc dap --bridge: fork");
                close(parentToChild[0]); close(parentToChild[1]);
                close(childToParent[0]); close(childToParent[1]);
                return 1;
            }
            if (pid == 0) {
                // Child — wire pipes to stdin/stdout, exec gdb.
                // dup2 clears O_CLOEXEC on the target FDs (0, 1) so
                // they survive the exec. The original pipe FDs still
                // have O_CLOEXEC set so they auto-close. We also
                // close them explicitly for clarity.
                if (dup2(parentToChild[0], 0) < 0) { perror("dup2 stdin");  _exit(127); }
                if (dup2(childToParent[1], 1) < 0) { perror("dup2 stdout"); _exit(127); }
                close(parentToChild[0]); close(parentToChild[1]);
                close(childToParent[0]); close(childToParent[1]);
                execlp((const char*) gdbPath,
                       "gdb", "--interpreter=mi3", "--nx", "--quiet",
                       (char*) NULL);
                perror("amc dap --bridge: execlp gdb");
                _exit(127);
            }
            // Parent — close the child-side FDs, stash the rest.
            close(parentToChild[0]);
            close(childToParent[1]);
            self->GdbInFd  = parentToChild[1];
            self->GdbOutFd = childToParent[0];
            self->GdbPid   = (i64) pid;
            // SIGPIPE on a closed stdout (client disconnected) would
            // kill us silently; turn it into a regular EPIPE that
            // PollLoop catches via POLLHUP/read==-1.
            signal(SIGPIPE, SIG_IGN);
            return 0;
        }
    }

    // Main bridge I/O loop. Structured as AM code calling thin @c
    // primitives so DAP/MI parsing + per-verb dispatch can live in
    // Amalgame. The C side handles only the poll/read/write syscalls
    // and the gdb child cleanup.
    private int PollLoop() {
        while (!this.StopRequested) {
            let what: int = this.PollOnce()
            if (what == 0) {
                // stdin readable — pull bytes, accumulate, parse
                // out any complete DAP frames, dispatch each.
                let chunk: string = this.ReadFromFd(0)
                if (String_Length(chunk) == 0) {
                    this.StdinOpen = false
                    this.CloseGdbStdin()
                } else {
                    this.OnDapInput(chunk)
                }
            } else if (what == 1) {
                // gdb readable — pull bytes, accumulate, split on
                // newlines, parse each line as an MiRecord, dispatch.
                let chunk: string = this.ReadFromFd(1)
                if (String_Length(chunk) == 0) { break }
                this.OnGdbOutput(chunk)
            } else if (what == 2) {
                // stdin POLLHUP — client closed, drain gdb until it
                // exits too.
                this.StdinOpen = false
                this.CloseGdbStdin()
            } else if (what == 3) {
                // gdb POLLHUP — exit the loop, fall through to cleanup.
                break
            } else {
                break
            }
        }
        this.Cleanup()
        return 0
    }

    // poll(2) on stdin (when open) and gdb-stdout. Returns:
    //   0 = stdin readable     1 = gdb readable
    //   2 = stdin POLLHUP/ERR  3 = gdb POLLHUP/ERR
    //   4 = poll failure
    private int PollOnce() {
        @c {
            struct pollfd fds[2];
            fds[0].fd = self->StdinOpen ? 0 : -1;
            fds[0].events = POLLIN;
            fds[1].fd = (int) self->GdbOutFd;
            fds[1].events = POLLIN;
            for (;;) {
                fds[0].revents = 0;
                fds[1].revents = 0;
                int pr = poll(fds, 2, -1);
                if (pr < 0) {
                    if (errno == EINTR) continue;
                    perror("amc dap --bridge: poll");
                    return 4;
                }
                // Prioritise gdb POLLHUP over POLLIN so we exit cleanly
                // when gdb crashes mid-response.
                if (fds[1].revents & (POLLHUP | POLLERR)) return 3;
                if (fds[0].revents & (POLLHUP | POLLERR) && !(fds[0].revents & POLLIN)) return 2;
                if (fds[1].revents & POLLIN) return 1;
                if (fds[0].revents & POLLIN) return 0;
                // Spurious wake — loop.
            }
        }
    }

    // Read up to 16 KB from either fd: 0 = client stdin, 1 = gdb
    // stdout. Returns the chunk as a GC-allocated string, or "" on
    // EOF/error. NUL terminator is appended so the result is a valid
    // `code_string`; embedded NULs would be lost (DAP/MI never use
    // them in practice).
    private string ReadFromFd(int which) {
        @c {
            int fd = (which == 0) ? 0 : (int) self->GdbOutFd;
            char buf[16384];
            ssize_t n;
            for (;;) {
                n = read(fd, buf, sizeof(buf));
                if (n < 0 && errno == EINTR) continue;
                break;
            }
            if (n <= 0) {
                return (code_string) "";
            }
            char* r = (char*) GC_MALLOC((size_t) n + 1);
            if (r == NULL) {
                return (code_string) "";
            }
            memcpy(r, buf, (size_t) n);
            r[n] = '\0';
            return (code_string) r;
        }
    }

    // Write a buffer either to gdb's stdin (which=1) or to the
    // client's stdout (which=2). Retries on EINTR, surfaces EPIPE/
    // ENOSPC by marking StopRequested. strlen-bounded — embedded
    // NULs in the payload are truncated, same caveat as ReadFromFd.
    public void WriteToFd(int which, string s) {
        @c {
            int fd = (which == 1) ? (int) self->GdbInFd : 1;
            if (fd < 0) { return; }
            const char* p = (const char*) s;
            size_t len = strlen(p);
            size_t off = 0;
            while (off < len) {
                ssize_t w = write(fd, p + off, len - off);
                if (w < 0) {
                    if (errno == EINTR) continue;
                    self->StopRequested = 1;
                    break;
                }
                off += (size_t) w;
            }
        }
    }

    // Close the write-end of gdb-stdin. Tells gdb no more commands
    // are coming so it can shut down cleanly. Idempotent.
    public void CloseGdbStdin() {
        @c {
            if (self->GdbInFd >= 0) {
                close((int) self->GdbInFd);
                self->GdbInFd = -1;
            }
        }
    }

    // Handle a chunk of bytes received from the DAP client.
    // Accumulates into DapInputBuf, peels off complete frames
    // (`Content-Length: N\r\n\r\n<N bytes>`), dispatches each frame's
    // JSON body through HandleDapMessage. Partial frames stay
    // buffered for the next chunk.
    private void OnDapInput(string chunk) {
        this.DapInputBuf = this.DapInputBuf + chunk
        while (true) {
            let body: string = this.TryExtractDapFrame()
            if (String_Length(body) == 0) { break }
            this.HandleDapMessage(body)
        }
    }

    // Try to peel one complete DAP frame off DapInputBuf. Returns the
    // JSON body (header consumed) on success, "" if more bytes are
    // needed. Mutates DapInputBuf to drop the consumed prefix.
    //
    // Malformed headers (no Content-Length) drop everything up to and
    // including the next `\r\n\r\n` and return "". The bridge doesn't
    // hard-fail on the input pipe — a buggy client shouldn't take
    // down gdb.
    // CRLF used by DAP framing. The bootstrap amc lexer mis-handles
    // `"\r"` (and `"\x0d"`) literals — same trap lsp.am hit, see
    // `LspServer.Cr()` for the original workaround. We pre-build the
    // CRLFCRLF separator once per process.
    private static string Crlf() { return String_FromByte(13) + "\n" }
    private static string CrlfCrlf() { return DapServer.Crlf() + DapServer.Crlf() }

    private string TryExtractDapFrame() {
        let buf: string = this.DapInputBuf
        let headEnd: int = String_IndexOf(buf, DapServer.CrlfCrlf())
        if (headEnd < 0) { return "" }
        let header: string = String_Substring(buf, 0, headEnd)
        let needle: string = "Content-Length:"
        let lpi: int = String_IndexOf(header, needle)
        if (lpi < 0) {
            // No length — drop the header and resync.
            this.DapInputBuf = String_Substring(buf, headEnd + 4, String_Length(buf) - headEnd - 4)
            return ""
        }
        let valueStart: int = lpi + String_Length(needle)
        var lenN: int = 0
        var i: int = valueStart
        // Skip whitespace, then collect digits.
        while (i < String_Length(header)) {
            let c: string = String_Substring(header, i, 1)
            if (c == " " || c == "\t") { i = i + 1 } else { break }
        }
        while (i < String_Length(header)) {
            let c: string = String_Substring(header, i, 1)
            if (MiParser.IsDigit(c)) {
                lenN = lenN * 10 + String_ToInt(c)
                i = i + 1
            } else { break }
        }
        let bodyStart: int = headEnd + 4
        let bufLen: int = String_Length(buf)
        if (bufLen - bodyStart < lenN) { return "" }
        let body: string = String_Substring(buf, bodyStart, lenN)
        this.DapInputBuf = String_Substring(buf, bodyStart + lenN, bufLen - bodyStart - lenN)
        return body
    }

    // Emit a DAP frame to the client: prepend the Content-Length
    // header and write everything to stdout. Caller ensures `body`
    // is valid JSON; we don't validate.
    public void SendDapFrame(string body) {
        let frame: string = "Content-Length: " + String_FromInt(String_Length(body)) + DapServer.CrlfCrlf() + body
        this.WriteToFd(2, frame)
    }

    // Handle a chunk of bytes received from gdb. Accumulates,
    // splits on \n, parses each non-empty line through MiParser,
    // dispatches by record kind via HandleMiRecord. Carries over
    // any trailing partial line in GdbInputBuf for the next chunk.
    private void OnGdbOutput(string chunk) {
        this.GdbInputBuf = this.GdbInputBuf + chunk
        let buf: string = this.GdbInputBuf
        let bufLen: int = String_Length(buf)
        var pos: int = 0
        while (pos < bufLen) {
            let rest: string = String_Substring(buf, pos, bufLen - pos)
            let nl: int = String_IndexOf(rest, "\n")
            if (nl < 0) { break }
            let raw: string = String_Substring(buf, pos, nl)
            let line: string = String_Trim(raw)
            if (String_Length(line) > 0) {
                this.HandleMiLine(line)
            }
            pos = pos + nl + 1
        }
        this.GdbInputBuf = String_Substring(buf, pos, bufLen - pos)
    }

    // Parse one MI3 line and dispatch by record kind. Routes:
    //   0 (result)        → HandleMiResult (token correlation)
    //   1 (exec-async)    → HandleMiExecAsync (*stopped/*running)
    //   3 (notify-async)  → HandleMiNotifyAsync (=thread-group-exited)
    //   4/5/6 (streams)   → dropped (logs only, no DAP equivalent)
    //   7 (gdb prompt)    → ignored
    private void HandleMiLine(string line) {
        let parser = new MiParser(line)
        let rec: MiRecord = parser.ParseRecord()
        if      (rec.RecordKind == 0) { this.HandleMiResult(rec) }
        else if (rec.RecordKind == 1) { this.HandleMiExecAsync(rec) }
        else if (rec.RecordKind == 3) { this.HandleMiNotifyAsync(rec) }
        // else: stream/status/prompt — silent.
    }

    // Token correlation for MI result records. Each MI command we
    // issue carries a numeric token (`<tok>-foo …`); gdb echoes the
    // same token in the response, so we can route `^done` payloads
    // back to the right DAP response builder.
    private void HandleMiResult(MiRecord rec) {
        if (rec.Token < 0) { return }
        let idx: int = this.FindMiTokenIndex(rec.Token)
        if (idx < 0) { return }
        let dapSeq: int = this.MiTokensReq.Get(idx)
        let kind: string = this.MiTokensKind.Get(idx)
        this.ReleaseMiTokenAt(idx)
        if      (kind == "launch")            { this.RespondLaunch(dapSeq, rec) }
        else if (kind == "setBreakpoints")    { this.RespondSetBreakpoints(dapSeq, rec) }
        else if (kind == "configurationDone") { this.RespondConfigurationDone(dapSeq, rec) }
        else if (kind == "stackTrace")        { this.RespondStackTrace(dapSeq, rec) }
        else if (kind == "variables")         { this.RespondVariables(dapSeq, rec) }
        else if (kind == "varFollowup")       { this.HandleVarFollowupResponse(rec) }
        else if (kind == "evaluate")          { this.RespondEvaluate(dapSeq, rec) }
        // The fire-and-forget verbs (continue/next/step/pause) don't
        // register a token — their DAP response was sent up-front and
        // their MI `^running` ack is ignored.
    }

    // Async exec event from gdb: `*stopped`, `*running`. Translates
    // to DAP `stopped` events. `*running` we drop — VS Code doesn't
    // require an explicit continued event for single-threaded
    // programs, the silent state transition is fine.
    private void HandleMiExecAsync(MiRecord rec) {
        if (rec.Class == "stopped") {
            this.EmitStoppedEvent(rec)
        }
        // *running, *connected, *exited, *signal-received: skipped
        // for the MVP. *exited could optionally fire DAP `terminated`
        // but `=thread-group-exited` already does that.
    }

    // Async notify event from gdb: `=thread-group-exited`,
    // `=breakpoint-modified`, library load/unload, etc. We translate
    // only the ones DAP clients act on.
    private void HandleMiNotifyAsync(MiRecord rec) {
        if (rec.Class == "thread-group-exited") {
            // Program ended. Tell the client.
            let evt: string = "{\"seq\":" + String_FromInt(this.NextOutSeq()) +
                ",\"type\":\"event\"" +
                ",\"event\":\"terminated\"" +
                ",\"body\":{}}"
            this.SendDapFrame(evt)
        }
        // Other notify-async records: silent.
    }

    // Build + send a DAP `stopped` event. Per spec the body needs
    // `reason`, `threadId`, plus optional `description`,
    // `hitBreakpointIds`. We map gdb reasons to DAP strings:
    //   breakpoint-hit → "breakpoint"
    //   end-stepping-range → "step"
    //   signal-received → "exception"
    //   exited-normally → drop (handled by =thread-group-exited)
    //   anything else → "pause"
    // True when a frame's `func` name matches the hidden-frame
    // patterns. Used by EmitStoppedEvent (step-until-visible) and
    // RespondStackTrace (frame filter). Pure function so both call
    // sites use the same rules.
    private bool IsHiddenFrameFunc(string funcS) {
        if (this.ShowRuntime) { return false }
        if (String_StartsWith(funcS, "Amalgame_")) { return true }
        if (String_StartsWith(funcS, "_runtime_")) { return true }
        if (String_StartsWith(funcS, "GC_"))       { return true }
        return false
    }

    private void EmitStoppedEvent(MiRecord rec) {
        // Step-until-visible: if we're stepping and the current frame
        // is hidden, fire another -exec-step and suppress the DAP
        // event. Budget caps the auto-step depth so a pure-runtime
        // loop doesn't lock the user out.
        if (this.StepBudget > 0) {
            let frameV: MiValue = rec.ResultOrNull("frame")
            var funcS: string = ""
            if (frameV != null) { funcS = frameV.FieldString("func") }
            if (this.IsHiddenFrameFunc(funcS)) {
                this.StepBudget = this.StepBudget - 1
                this.WriteToFd(1, "-exec-step\n")
                return
            }
            // Landed somewhere visible — clear the budget so the next
            // stepIn re-arms freshly.
            this.StepBudget = 0
        }
        var reason: string = "pause"
        var bkptList: string = ""
        var isExit: bool = false
        let resN: int = rec.Results.Count()
        for i in 0..resN {
            let key: string = rec.Results.Get(i)
            let val: MiValue = rec.Values.Get(i)
            if (key == "reason" && val.Kind == 0) {
                let r: string = val.Str
                if      (r == "breakpoint-hit")      { reason = "breakpoint" }
                else if (r == "end-stepping-range") { reason = "step" }
                else if (r == "signal-received")    { reason = "exception" }
                else if (r == "function-finished")  { reason = "step" }
                else if (r == "exited-normally")    { isExit = true }
                else if (r == "exited")             { isExit = true }
                else if (r == "exited-signalled")   { isExit = true }
                else                                 { reason = r }
            }
            if (key == "bkptno" && val.Kind == 0) {
                bkptList = ",\"hitBreakpointIds\":[" + val.Str + "]"
            }
        }
        // Program-end *stopped is redundant — `=thread-group-exited`
        // already drives the DAP `terminated` event. Suppressing here
        // avoids the client seeing a phantom stopped-then-terminated
        // sequence.
        if (isExit) { return }
        let evt: string = "{\"seq\":" + String_FromInt(this.NextOutSeq()) +
            ",\"type\":\"event\"" +
            ",\"event\":\"stopped\"" +
            ",\"body\":{" +
                "\"reason\":\"" + Json.EscapeString(reason) + "\"" +
                ",\"threadId\":1" +
                ",\"allThreadsStopped\":true" +
                bkptList +
            "}}"
        this.SendDapFrame(evt)
    }

    // ── Token correlation helpers ───────────────────────

    // Issue an MI command to gdb, registering token→DAP correlation
    // so the eventual `^done` lands in the right response builder.
    // `mi` should NOT include the leading token — we prepend it.
    // Returns the token assigned.
    private int IssueMiCommand(int dapSeq, string command, string mi) {
        let tok: int = this.NextMiToken
        this.NextMiToken = this.NextMiToken + 1
        this.MiTokens.Add(tok)
        this.MiTokensReq.Add(dapSeq)
        this.MiTokensKind.Add(command)
        this.WriteToFd(1, String_FromInt(tok) + mi + "\n")
        return tok
    }

    private int FindMiTokenIndex(int tok) {
        let n: int = this.MiTokens.Count()
        var found: int = -1
        for i in 0..n {
            if (this.MiTokens.Get(i) == tok) { found = i }
        }
        return found
    }

    private void ReleaseMiTokenAt(int idx) {
        if (idx < 0) { return }
        this.MiTokens.RemoveAt(idx)
        this.MiTokensReq.RemoveAt(idx)
        this.MiTokensKind.RemoveAt(idx)
    }

    // Dispatch a complete DAP request body. Body is the raw JSON
    // string; we parse it with Amalgame.Json.Parse, peel off
    // `seq` / `command` / `arguments`, and route to the per-verb
    // handlers. Unknown commands get a non-success response so the
    // client doesn't hang waiting.
    private void HandleDapMessage(string body) {
        let parsed: JsonResult = Json.Parse(body)
        if (!parsed.Ok) {
            // Malformed DAP — silently drop. A buggy client shouldn't
            // tear down the bridge.
            return
        }
        let root: JsonValue = parsed.Value
        if (root.IsNull()) { return }
        let typeStr: string = root.Get("type").AsString()
        if (typeStr != "request") {
            // Only requests are translatable; responses/events from
            // the client side never happen in a normal DAP session.
            return
        }
        let seq: int = root.Get("seq").AsInt()
        let command: string = root.Get("command").AsString()
        let args: JsonValue = root.Get("arguments")
        if      (command == "initialize")        { this.HandleInitialize(seq, args) }
        else if (command == "disconnect")        { this.HandleDisconnect(seq, args) }
        else if (command == "threads")           { this.HandleThreads(seq) }
        else if (command == "continue")          { this.HandleContinue(seq, args) }
        else if (command == "next")              { this.HandleStep(seq, "next",    "-exec-next") }
        else if (command == "stepIn")            { this.HandleStep(seq, "stepIn",  "-exec-step") }
        else if (command == "stepOut")           { this.HandleStep(seq, "stepOut", "-exec-finish") }
        else if (command == "pause")             { this.HandlePause(seq, args) }
        else if (command == "launch")            { this.HandleLaunch(seq, args) }
        else if (command == "setBreakpoints")    { this.HandleSetBreakpoints(seq, args) }
        else if (command == "configurationDone") { this.HandleConfigurationDone(seq, args) }
        else if (command == "stackTrace")        { this.HandleStackTrace(seq, args) }
        else if (command == "scopes")            { this.HandleScopes(seq, args) }
        else if (command == "variables")         { this.HandleVariables(seq, args) }
        else if (command == "evaluate")          { this.HandleEvaluate(seq, args) }
        else                                     { this.SendDapErrorResponse(seq, command, "not implemented in --bridge yet") }
    }

    // ── Immediate-response handlers ─────────────────────
    //
    // These fire and forget — the DAP response is sent up front and
    // any subsequent state change is communicated via async events
    // (`stopped` for next/stepIn/stepOut/pause; `terminated` for
    // disconnect; nothing for continue when single-threaded).

    private void HandleThreads(int seq) {
        // Single synthetic thread. Multi-thread support is deferred
        // until the runtime has real threads (see ROADMAP "Open
        // design questions: Single-threaded").
        let body: string = "{\"seq\":" + String_FromInt(this.NextOutSeq()) +
            ",\"type\":\"response\"" +
            ",\"request_seq\":" + String_FromInt(seq) +
            ",\"success\":true" +
            ",\"command\":\"threads\"" +
            ",\"body\":{\"threads\":[{\"id\":1,\"name\":\"main\"}]}}"
        this.SendDapFrame(body)
    }

    private void HandleContinue(int seq, JsonValue args) {
        this.WriteToFd(1, "-exec-continue\n")
        let body: string = "{\"seq\":" + String_FromInt(this.NextOutSeq()) +
            ",\"type\":\"response\"" +
            ",\"request_seq\":" + String_FromInt(seq) +
            ",\"success\":true" +
            ",\"command\":\"continue\"" +
            ",\"body\":{\"allThreadsContinued\":true}}"
        this.SendDapFrame(body)
    }

    private void HandleStep(int seq, string dapCmd, string miCmd) {
        // stepIn into runtime helpers (collection ops, GC, exception
        // glue) is a poor UX — the user almost always wants to land
        // back in their own .am source. Arm step-until-visible so
        // the *stopped handler auto-steps through hidden frames.
        if (dapCmd == "stepIn" && !this.ShowRuntime) {
            this.StepBudget = 8
        }
        this.WriteToFd(1, miCmd + "\n")
        let body: string = "{\"seq\":" + String_FromInt(this.NextOutSeq()) +
            ",\"type\":\"response\"" +
            ",\"request_seq\":" + String_FromInt(seq) +
            ",\"success\":true" +
            ",\"command\":\"" + dapCmd + "\"}"
        this.SendDapFrame(body)
    }

    private void HandlePause(int seq, JsonValue args) {
        this.WriteToFd(1, "-exec-interrupt\n")
        let body: string = "{\"seq\":" + String_FromInt(this.NextOutSeq()) +
            ",\"type\":\"response\"" +
            ",\"request_seq\":" + String_FromInt(seq) +
            ",\"success\":true" +
            ",\"command\":\"pause\"}"
        this.SendDapFrame(body)
    }

    // ── Token-correlated handlers (stubs for Phase 4b+) ─

    private void HandleLaunch(int seq, JsonValue args) {
        let program: string = args.Get("program").AsString()
        if (String_Length(program) == 0) {
            this.SendDapErrorResponse(seq, "launch", "missing 'program' field")
            return
        }
        // Load the program. Response sent when ^done arrives.
        let mi: string = "-file-exec-and-symbols \"" + program + "\""
        let _tok: int = this.IssueMiCommand(seq, "launch", mi)
    }

    private void HandleSetBreakpoints(int seq, JsonValue args) {
        if (this.BkptInFlight) {
            this.SendDapErrorResponse(seq, "setBreakpoints",
                "previous setBreakpoints still in flight")
            return
        }
        let src: JsonValue = args.Get("source")
        let srcPath: string = src.Get("path").AsString()
        if (String_Length(srcPath) == 0) {
            this.SendDapErrorResponse(seq, "setBreakpoints", "missing 'source.path'")
            return
        }
        let bpsVal: JsonValue = args.Get("breakpoints")
        let bps: List<JsonValue> = bpsVal.AsArray()
        let nNew: int = bps.Count()
        // Clear every previously-set breakpoint. Fire-and-forget —
        // we don't bother registering a token; gdb's ^done is silent
        // when the number is unknown (^error is logged but harmless).
        let nKnown: int = this.BkptKnownNumbers.Count()
        for i in 0..nKnown {
            let num: int = this.BkptKnownNumbers.Get(i)
            this.WriteToFd(1, "-break-delete " + String_FromInt(num) + "\n")
        }
        this.BkptKnownNumbers = new List<int>()
        // Empty breakpoints list → reply immediately. No state to track.
        if (nNew == 0) {
            this.SendBkptResponse(seq, new List<string>())
            return
        }
        // Set up in-flight tracking.
        this.BkptInFlight        = true
        this.BkptInFlightSeq     = seq
        this.BkptInFlightSource  = srcPath
        this.BkptInFlightPending = nNew
        this.BkptInFlightDapShape = new List<string>()
        // Issue an MI insert per requested breakpoint. The dapSeq
        // we register on the token isn't strictly needed (we have
        // BkptInFlightSeq already) but keeps the registry uniform.
        for i in 0..nNew {
            let bp: JsonValue = bps.Get(i)
            let line: int = bp.Get("line").AsInt()
            let mi: string = "-break-insert " + srcPath + ":" + String_FromInt(line)
            let _tok: int = this.IssueMiCommand(seq, "setBreakpoints", mi)
        }
    }

    private void RespondSetBreakpoints(int dapSeq, MiRecord rec) {
        if (!this.BkptInFlight || this.BkptInFlightSeq != dapSeq) {
            // Late response from an aborted request — discard.
            return
        }
        // Pull bkpt={...} from the response. On ^error we still
        // accumulate a "verified:false" entry so the DAP array
        // aligns with the request's input.
        var dapEntry: string = ""
        let bkpt: MiValue = rec.ResultOrNull("bkpt")
        if (rec.Class == "done" && bkpt != null && bkpt.Kind == 1) {
            let numS:  string = bkpt.FieldString("number")
            let fileS: string = bkpt.FieldString("file")
            let lineS: string = bkpt.FieldString("line")
            // Track the breakpoint number for the next clearance round.
            if (String_Length(numS) > 0) {
                this.BkptKnownNumbers.Add(String_ToInt(numS))
            }
            dapEntry = "{\"id\":" + numS +
                ",\"verified\":true" +
                ",\"line\":" + lineS +
                ",\"source\":{\"path\":\"" + Json.EscapeString(fileS) + "\"}}"
        } else {
            // Insert failed (e.g. bad line). Emit a verified:false
            // marker so the client knows which one didn't bind.
            dapEntry = "{\"verified\":false,\"message\":\"-break-insert failed\"}"
        }
        this.BkptInFlightDapShape.Add(dapEntry)
        this.BkptInFlightPending = this.BkptInFlightPending - 1
        if (this.BkptInFlightPending <= 0) {
            this.SendBkptResponse(this.BkptInFlightSeq, this.BkptInFlightDapShape)
            this.BkptInFlight        = false
            this.BkptInFlightSeq     = -1
            this.BkptInFlightSource  = ""
        }
    }

    // Assemble + send the DAP setBreakpoints response from the
    // accumulated per-breakpoint snippets. Separated out so the
    // empty-list shortcut can call it directly.
    private void SendBkptResponse(int seq, List<string> entries) {
        var arr: string = "["
        let n: int = entries.Count()
        for i in 0..n {
            if (i > 0) { arr = arr + "," }
            arr = arr + entries.Get(i)
        }
        arr = arr + "]"
        let body: string = "{\"seq\":" + String_FromInt(this.NextOutSeq()) +
            ",\"type\":\"response\"" +
            ",\"request_seq\":" + String_FromInt(seq) +
            ",\"success\":true" +
            ",\"command\":\"setBreakpoints\"" +
            ",\"body\":{\"breakpoints\":" + arr + "}}"
        this.SendDapFrame(body)
    }

    private void HandleConfigurationDone(int seq, JsonValue args) {
        // Start the program. Reply when ^running comes back.
        let _tok: int = this.IssueMiCommand(seq, "configurationDone", "-exec-run")
    }

    private void HandleStackTrace(int seq, JsonValue args) {
        // DAP optionally restricts the level range with `startFrame`
        // + `levels`. gdb's -stack-list-frames supports the same.
        // We pass through when present; default to "all frames" (gdb
        // returns up to its internal max otherwise).
        let startF: int = args.Get("startFrame").AsInt()
        let levels: int = args.Get("levels").AsInt()
        var miArgs: string = ""
        if (levels > 0) {
            let endF: int = startF + levels - 1
            miArgs = " " + String_FromInt(startF) + " " + String_FromInt(endF)
        }
        let _tok: int = this.IssueMiCommand(seq, "stackTrace", "-stack-list-frames" + miArgs)
    }

    private void HandleScopes(int seq, JsonValue args) {
        // Synthetic single Locals scope keyed by frameId. variablesReference
        // = frameId * 100 + 1 (Locals); frameId * 100 + 2 (Arguments) etc.
        // Phase 4d shipped uses 1 for now.
        let body: string = "{\"seq\":" + String_FromInt(this.NextOutSeq()) +
            ",\"type\":\"response\"" +
            ",\"request_seq\":" + String_FromInt(seq) +
            ",\"success\":true" +
            ",\"command\":\"scopes\"" +
            ",\"body\":{\"scopes\":[{\"name\":\"Locals\",\"variablesReference\":1,\"expensive\":false}]}}"
        this.SendDapFrame(body)
    }

    private void HandleVariables(int seq, JsonValue args) {
        let vref: int = args.Get("variablesReference").AsInt()
        if (vref == 1) {
            // Locals scope — query gdb for the current frame's vars,
            // pretty-print arrives in RespondVariables.
            let _tok: int = this.IssueMiCommand(seq, "variables",
                "-stack-list-variables --simple-values")
            return
        }
        if (vref > 1) {
            // Drill-down into a container we previously summarised.
            this.HandleChildVariables(seq, vref)
            return
        }
        this.SendDapErrorResponse(seq, "variables", "invalid variablesReference")
    }

    // Synthesize a child variables list for a container drilled into
    // via `variables(variablesReference=N)`. Reuses the PendingVars_*
    // staging shape — each child gets a query like
    // `((AmalgameList*)<addr>)->data[<i>]`; the Locals follow-up
    // walker is generic over Queries so it runs unchanged.
    private void HandleChildVariables(int seq, int vref) {
        let cidx: int = this.FindChildRefIndex(vref)
        if (cidx < 0) {
            this.SendDapErrorResponse(seq, "variables", "stale variablesReference")
            return
        }
        let typeS: string = this.ChildRef_Types.Get(cidx)
        let addr:  string = this.ChildRef_Addrs.Get(cidx)
        let size:  int    = this.ChildRef_Sizes.Get(cidx)
        this.PendingVars_Seq     = seq
        this.PendingVars_Names   = new List<string>()
        this.PendingVars_Types   = new List<string>()
        this.PendingVars_Values  = new List<string>()
        this.PendingVars_Queries = new List<string>()
        this.PendingVars_Refs    = new List<int>()
        this.PendingVars_Idx     = 0
        // AmalgameList* drill-down: data[0..size-1]. AmalgameMap/Set
        // children are deferred (their internal layout walks a hash
        // table with tombstones — different shape).
        if (typeS == "AmalgameList") {
            for i in 0..size {
                this.PendingVars_Names.Add("[" + String_FromInt(i) + "]")
                this.PendingVars_Types.Add("void*")
                this.PendingVars_Values.Add("?")
                this.PendingVars_Queries.Add("(void*)((AmalgameList*)" + addr + ")->data[" + String_FromInt(i) + "]")
                this.PendingVars_Refs.Add(0)
            }
        }
        this.ProcessNextVarFollowup()
    }

    private int FindChildRefIndex(int vref) {
        let n: int = this.ChildRef_Refs.Count()
        var found: int = -1
        for i in 0..n {
            if (this.ChildRef_Refs.Get(i) == vref) { found = i }
        }
        return found
    }

    // Allocate a fresh variablesReference id, storing the metadata
    // needed to expand it on a subsequent variables request.
    // `addr` is the gdb-eval string that yields the pointer
    // (typically just the var's name once gdb has its type info).
    private int AllocChildRef(string typeS, string addr, int size) {
        let r: int = this.NextChildRef
        this.NextChildRef = this.NextChildRef + 1
        this.ChildRef_Refs.Add(r)
        this.ChildRef_Types.Add(typeS)
        this.ChildRef_Addrs.Add(addr)
        this.ChildRef_Sizes.Add(size)
        return r
    }

    private void HandleEvaluate(int seq, JsonValue args) {
        let expr: string = args.Get("expression").AsString()
        if (String_Length(expr) == 0) {
            this.SendDapErrorResponse(seq, "evaluate", "missing expression")
            return
        }
        // gdb's MI expects the expression as a single double-quoted
        // arg with escapes. JSON-escape covers most of what we need.
        let mi: string = "-data-evaluate-expression \"" +
            Json.EscapeString(expr) + "\""
        let _tok: int = this.IssueMiCommand(seq, "evaluate", mi)
    }

    // ── Response builders (fired from HandleMiResult) ───
    //
    // Each builder reads a captured `^done,…` MiRecord, extracts the
    // relevant fields, and assembles the DAP response keyed by the
    // originating request's seq.

    private void RespondLaunch(int dapSeq, MiRecord rec) {
        let ok: bool = (rec.Class == "done")
        if (!ok) {
            this.SendDapErrorResponse(dapSeq, "launch", "-file-exec-and-symbols failed")
            return
        }
        let body: string = "{\"seq\":" + String_FromInt(this.NextOutSeq()) +
            ",\"type\":\"response\"" +
            ",\"request_seq\":" + String_FromInt(dapSeq) +
            ",\"success\":true" +
            ",\"command\":\"launch\"}"
        this.SendDapFrame(body)
    }

    private void RespondConfigurationDone(int dapSeq, MiRecord rec) {
        // -exec-run answers with ^running or ^error. Either way reply
        // immediately — the *stopped event will fire later when the
        // program hits a breakpoint or signals.
        let ok: bool = (rec.Class == "running" || rec.Class == "done")
        if (!ok) {
            this.SendDapErrorResponse(dapSeq, "configurationDone", "-exec-run failed")
            return
        }
        let body: string = "{\"seq\":" + String_FromInt(this.NextOutSeq()) +
            ",\"type\":\"response\"" +
            ",\"request_seq\":" + String_FromInt(dapSeq) +
            ",\"success\":true" +
            ",\"command\":\"configurationDone\"}"
        this.SendDapFrame(body)
    }

    private void RespondStackTrace(int dapSeq, MiRecord rec) {
        if (rec.Class != "done") {
            this.SendDapErrorResponse(dapSeq, "stackTrace", "-stack-list-frames failed")
            return
        }
        let stack: MiValue = rec.ResultOrNull("stack")
        var frames: string = "["
        var count: int = 0
        if (stack != null && stack.Kind == 2) {
            let n: int = stack.ListItems.Count()
            for i in 0..n {
                let f: MiValue = stack.ListItems.Get(i)
                if (f.Kind != 1) { continue }
                let lvlS:  string = f.FieldString("level")
                let funcS: string = f.FieldString("func")
                let fileS: string = f.FieldString("fullname")
                var lineS: string = f.FieldString("line")
                if (String_Length(lineS) == 0) { lineS = "0" }
                // Frame filter — see IsHiddenFrameFunc. Shared with
                // EmitStoppedEvent's step-until-visible check so both
                // sites apply the same rule.
                if (this.IsHiddenFrameFunc(funcS)) { continue }
                if (count > 0) { frames = frames + "," }
                frames = frames + "{\"id\":" + lvlS +
                    ",\"name\":\"" + Json.EscapeString(funcS) + "\"" +
                    ",\"line\":" + lineS +
                    ",\"column\":1"
                if (String_Length(fileS) > 0) {
                    frames = frames + ",\"source\":{\"path\":\"" + Json.EscapeString(fileS) + "\"}"
                }
                frames = frames + "}"
                count = count + 1
            }
        }
        frames = frames + "]"
        let body: string = "{\"seq\":" + String_FromInt(this.NextOutSeq()) +
            ",\"type\":\"response\"" +
            ",\"request_seq\":" + String_FromInt(dapSeq) +
            ",\"success\":true" +
            ",\"command\":\"stackTrace\"" +
            ",\"body\":{\"stackFrames\":" + frames +
            ",\"totalFrames\":" + String_FromInt(count) + "}}"
        this.SendDapFrame(body)
    }

    private void RespondVariables(int dapSeq, MiRecord rec) {
        if (rec.Class != "done") {
            this.SendDapErrorResponse(dapSeq, "variables", "-stack-list-variables failed")
            return
        }
        // Snapshot the variables into the pretty-printer staging.
        // For each var we pre-compute the follow-up query (or "" if
        // none) so ProcessNextVarFollowup can drive the walk
        // uniformly across Locals + Children paths.
        let vars: MiValue = rec.ResultOrNull("variables")
        this.PendingVars_Seq     = dapSeq
        this.PendingVars_Names   = new List<string>()
        this.PendingVars_Types   = new List<string>()
        this.PendingVars_Values  = new List<string>()
        this.PendingVars_Queries = new List<string>()
        this.PendingVars_Refs    = new List<int>()
        this.PendingVars_Idx     = 0
        if (vars != null && vars.Kind == 2) {
            let n: int = vars.ListItems.Count()
            for i in 0..n {
                let v: MiValue = vars.ListItems.Get(i)
                if (v.Kind != 1) { continue }
                let nameS: string = v.FieldString("name")
                let typeS: string = v.FieldString("type")
                this.PendingVars_Names.Add(nameS)
                this.PendingVars_Types.Add(typeS)
                this.PendingVars_Values.Add(v.FieldString("value"))
                this.PendingVars_Queries.Add(DapServer.PrettyPrintQuery(nameS, typeS))
                this.PendingVars_Refs.Add(0)
            }
        }
        this.ProcessNextVarFollowup()
    }

    // Walk staged variables looking for the next one that has a
    // non-empty query. If found, issue the eval; response lands in
    // HandleVarFollowupResponse which calls back here. When all
    // entries are processed, SendVariablesResponse fires.
    private void ProcessNextVarFollowup() {
        let n: int = this.PendingVars_Names.Count()
        while (this.PendingVars_Idx < n) {
            let q: string = this.PendingVars_Queries.Get(this.PendingVars_Idx)
            if (String_Length(q) > 0) {
                let _tok: int = this.IssueMiCommand(this.PendingVars_Seq, "varFollowup",
                    "-data-evaluate-expression \"" + Json.EscapeString(q) + "\"")
                return
            }
            this.PendingVars_Idx = this.PendingVars_Idx + 1
        }
        this.SendVariablesResponse()
    }

    // Map (varName, typeStr) → the MI eval expression that yields
    // the pretty-print summary. Returns "" when the type isn't
    // registered, signalling ProcessNextVarFollowup to leave the
    // value alone. Types covered:
    //   - AmalgameList* / AmalgameMap* / AmalgameSet*: length probe
    //   - AmalgameClosure*: env pointer probe
    // code_string is intentionally absent — gdb already inlines the
    // quoted string in its `value` field, no enrichment needed.
    private static string PrettyPrintQuery(string name, string typeS) {
        // Field names mirror runtime/_runtime.h + runtime/Amalgame_
        // Collections.h: AmalgameList/Map both use `size`, AmalgameSet
        // wraps an inner Map so the live count goes through `map->size`,
        // AmalgameClosure exposes `env` as the captured-locals pointer.
        if (typeS == "AmalgameList *")    { return "(int)((AmalgameList*)"    + name + ")->size" }
        if (typeS == "AmalgameMap *")     { return "(int)((AmalgameMap*)"     + name + ")->size" }
        if (typeS == "AmalgameSet *")     { return "(int)((AmalgameSet*)"     + name + ")->map->size" }
        if (typeS == "AmalgameClosure *") { return "(void*)((AmalgameClosure*)" + name + ")->env" }
        return ""
    }

    // Map (typeStr, evalResult) → the prettified value string. Mirror
    // of PrettyPrintQuery — same type taxonomy.
    private static string PrettyPrintFormat(string typeS, string evalResult) {
        if (typeS == "AmalgameList *")    { return "List["    + evalResult + "]" }
        if (typeS == "AmalgameMap *")     { return "Map["     + evalResult + "]" }
        if (typeS == "AmalgameSet *")     { return "Set["     + evalResult + "]" }
        if (typeS == "AmalgameClosure *") { return "λ env=" + evalResult }
        return evalResult
    }

    // Receive the eval response for the current PendingVars_Idx
    // variable. Replace its staged value with the prettified form,
    // advance the cursor, and chain to the next follow-up.
    private void HandleVarFollowupResponse(MiRecord rec) {
        let idx: int = this.PendingVars_Idx
        if (idx < this.PendingVars_Names.Count()) {
            if (rec.Class == "done") {
                let valWrap: MiValue = rec.ResultOrNull("value")
                if (valWrap != null) {
                    let typeS: string = this.PendingVars_Types.Get(idx)
                    let nameS: string = this.PendingVars_Names.Get(idx)
                    let evalRes: string = valWrap.Str
                    let pretty: string = DapServer.PrettyPrintFormat(typeS, evalRes)
                    this.RewriteValueAt(idx, pretty)
                    // For container types, the eval result IS the
                    // size — allocate a varRef so the client can
                    // expand. AmalgameClosure has no children today
                    // (env is opaque void*), skip its varRef.
                    let ctype: string = DapServer.ContainerKind(typeS)
                    if (String_Length(ctype) > 0) {
                        let size: int = String_ToInt(evalRes)
                        if (size > 0) {
                            let vref: int = this.AllocChildRef(ctype, nameS, size)
                            this.RewriteRefAt(idx, vref)
                        }
                    }
                }
            }
            // ^error or missing value: leave the raw value in place.
            this.PendingVars_Idx = idx + 1
        }
        this.ProcessNextVarFollowup()
    }

    // Container-type discriminator: returns the bare struct name
    // ("AmalgameList" / "AmalgameMap" / "AmalgameSet") that's
    // expandable into children, or "" for non-expandable types like
    // AmalgameClosure (where the env is just a raw void*).
    private static string ContainerKind(string typeS) {
        if (typeS == "AmalgameList *") { return "AmalgameList" }
        if (typeS == "AmalgameMap *")  { return "AmalgameMap"  }
        if (typeS == "AmalgameSet *")  { return "AmalgameSet"  }
        return ""
    }

    private void RewriteRefAt(int idx, int newRef) {
        let n: int = this.PendingVars_Refs.Count()
        let fresh: List<int> = new List<int>()
        for i in 0..n {
            if (i == idx) { fresh.Add(newRef) }
            else          { fresh.Add(this.PendingVars_Refs.Get(i)) }
        }
        this.PendingVars_Refs = fresh
    }

    // List<string> in current stdlib has no Set(i, v) primitive, so
    // rebuild the list with the substitution applied. Order survives.
    private void RewriteValueAt(int idx, string newValue) {
        let n: int = this.PendingVars_Values.Count()
        let fresh: List<string> = new List<string>()
        for i in 0..n {
            if (i == idx) { fresh.Add(newValue) }
            else          { fresh.Add(this.PendingVars_Values.Get(i)) }
        }
        this.PendingVars_Values = fresh
    }

    // Assemble + send the DAP variables response from the staging
    // lists. Called once ProcessNextVarFollowup has walked every
    // entry. Resets the staging state so the next variables
    // request starts clean.
    private void SendVariablesResponse() {
        var arr: string = "["
        let n: int = this.PendingVars_Names.Count()
        for i in 0..n {
            let name:  string = this.PendingVars_Names.Get(i)
            let typeS: string = this.PendingVars_Types.Get(i)
            let value: string = this.PendingVars_Values.Get(i)
            let vref:  int    = this.PendingVars_Refs.Get(i)
            if (i > 0) { arr = arr + "," }
            arr = arr + "{\"name\":\""  + Json.EscapeString(name)  + "\"" +
                ",\"value\":\"" + Json.EscapeString(value) + "\"" +
                ",\"type\":\""  + Json.EscapeString(typeS) + "\"" +
                ",\"variablesReference\":" + String_FromInt(vref) + "}"
        }
        arr = arr + "]"
        let body: string = "{\"seq\":" + String_FromInt(this.NextOutSeq()) +
            ",\"type\":\"response\"" +
            ",\"request_seq\":" + String_FromInt(this.PendingVars_Seq) +
            ",\"success\":true" +
            ",\"command\":\"variables\"" +
            ",\"body\":{\"variables\":" + arr + "}}"
        this.SendDapFrame(body)
        // Clear staging — but keep allocated lists so the next
        // request reuses them after the fresh assignment.
        this.PendingVars_Seq = -1
        this.PendingVars_Idx = 0
    }

    private void RespondEvaluate(int dapSeq, MiRecord rec) {
        if (rec.Class != "done") {
            this.SendDapErrorResponse(dapSeq, "evaluate", "-data-evaluate-expression failed")
            return
        }
        let valWrap: MiValue = rec.ResultOrNull("value")
        var valStr: string = ""
        if (valWrap != null) { valStr = valWrap.Str }
        let body: string = "{\"seq\":" + String_FromInt(this.NextOutSeq()) +
            ",\"type\":\"response\"" +
            ",\"request_seq\":" + String_FromInt(dapSeq) +
            ",\"success\":true" +
            ",\"command\":\"evaluate\"" +
            ",\"body\":{\"result\":\"" + Json.EscapeString(valStr) +
            "\",\"variablesReference\":0}}"
        this.SendDapFrame(body)
    }

    // Reply with our capabilities. Phase 2b advertises only the
    // basics; Phase 4 will flip on supportsConfigurationDoneRequest
    // / supportsEvaluateForHovers etc. as their handlers land.
    private void HandleInitialize(int seq, JsonValue args) {
        let body: string = "{\"seq\":" + String_FromInt(this.NextOutSeq()) +
            ",\"type\":\"response\"" +
            ",\"request_seq\":" + String_FromInt(seq) +
            ",\"success\":true" +
            ",\"command\":\"initialize\"" +
            ",\"body\":{" +
                "\"supportsConfigurationDoneRequest\":true," +
                "\"supportsTerminateRequest\":true," +
                "\"supportTerminateDebuggee\":true" +
            "}}"
        this.SendDapFrame(body)
        // Spec says a server emits `initialized` event right after
        // a successful initialize response. Phase 2b emits it so
        // VS Code knows to send any setup requests next (even though
        // we'll error those for now).
        let evt: string = "{\"seq\":" + String_FromInt(this.NextOutSeq()) +
            ",\"type\":\"event\"" +
            ",\"event\":\"initialized\"}"
        this.SendDapFrame(evt)
    }

    // Tear down the gdb side and let the loop drain. We respond
    // BEFORE closing GdbInFd so the client gets confirmation before
    // the bridge exits.
    private void HandleDisconnect(int seq, JsonValue args) {
        let body: string = "{\"seq\":" + String_FromInt(this.NextOutSeq()) +
            ",\"type\":\"response\"" +
            ",\"request_seq\":" + String_FromInt(seq) +
            ",\"success\":true" +
            ",\"command\":\"disconnect\"}"
        this.SendDapFrame(body)
        // Tell gdb to exit cleanly so it reaps its child too.
        this.WriteToFd(1, "-gdb-exit\n")
        this.CloseGdbStdin()
        this.StopRequested = true
    }

    // Stock error reply for unimplemented commands during the
    // Phase 2b → Phase 4 migration. Once Phase 4 lands every verb
    // will have its own success path and this is the bare fallback.
    private void SendDapErrorResponse(int seq, string command, string reason) {
        let body: string = "{\"seq\":" + String_FromInt(this.NextOutSeq()) +
            ",\"type\":\"response\"" +
            ",\"request_seq\":" + String_FromInt(seq) +
            ",\"success\":false" +
            ",\"command\":\"" + Json.EscapeString(command) + "\"" +
            ",\"message\":\"" + Json.EscapeString(reason) + "\"}"
        this.SendDapFrame(body)
    }

    // Monotonic seq counter for our side of the conversation.
    // DAP requires every message (request/response/event) to carry
    // a strictly increasing `seq` field, separate from the
    // request_seq correlation. Start at 1.
    private int NextOutSeq() {
        @c {
            self->_outSeqCounter += 1;
            return self->_outSeqCounter;
        }
    }

    // Final cleanup — close both pipe FDs and reap the gdb child.
    private void Cleanup() {
        @c {
            if (self->GdbInFd  >= 0) { close((int) self->GdbInFd);  self->GdbInFd  = -1; }
            if (self->GdbOutFd >= 0) { close((int) self->GdbOutFd); self->GdbOutFd = -1; }
            int status = 0;
            if (self->GdbPid > 0) { waitpid((pid_t) self->GdbPid, &status, 0); }
        }
    }

    // Raw / proxy entry point: detect a DAP-native backend on PATH
    // and execvp() it. Same behaviour shipped in v0.8.0.
    public int RunRaw() {
        let exe: string = this.DetectBackend()
        if (String_Length(exe) == 0) {
            Console.WriteError("amc dap: no DAP backend found in PATH.")
            Console.WriteError("")
            Console.WriteError("Install one of the following debug adapters:")
            Console.WriteError("  Linux:    apt install lldb-18  (from https://apt.llvm.org/)")
            Console.WriteError("            → /usr/lib/llvm-18/bin/lldb-dap")
            Console.WriteError("            — or — apt install gdb  (any distro's recent gdb is fine)")
            Console.WriteError("  macOS:    xcode-select --install  (lldb-dap ships with Xcode CLT 14+)")
            Console.WriteError("  Windows:  pacman -S mingw-w64-x86_64-gdb  (gdb 14+ has --dap, MSYS2)")
            Console.WriteError("")
            Console.WriteError("Then re-run `amc dap`. Use `amc build -g entry.am` first to embed")
            Console.WriteError("DWARF debug info so breakpoints can target .am source lines.")
            return 127
        }
        // The exec replaces our process image. If it succeeds, the
        // function below never returns. If it fails (binary present
        // but unrunnable, perms, etc.), it returns 127 with a perror
        // message on stderr.
        return this.ExecBackend(exe)
    }

    // Probe a list of likely binary names + paths. The first hit
    // wins. `command -v` is POSIX; macOS/Linux/MSYS2 all have it.
    // Versioned suffixes (`lldb-dap-18`, `-19`, …) are how the
    // Debian/Ubuntu LLVM packages name the binary — apt-installed
    // LLVM 18 lives at /usr/bin/lldb-dap-18 and there's no
    // unsuffixed alias unless the user installs `lldb` from the
    // distro's own package.
    private string DetectBackend() {
        let cands: List<string> = new List<string>()
        cands.Add("lldb-dap")
        cands.Add("lldb-dap-20")
        cands.Add("lldb-dap-19")
        cands.Add("lldb-dap-18")
        cands.Add("/usr/lib/llvm-20/bin/lldb-dap")
        cands.Add("/usr/lib/llvm-19/bin/lldb-dap")
        cands.Add("/usr/lib/llvm-18/bin/lldb-dap")
        let n: int = cands.Count()
        for i in 0..n {
            let c: string = cands.Get(i)
            let hit: string = DapServer.Probe(c)
            if (String_Length(hit) > 0) {
                return hit
            }
        }
        // gdb fallback for hosts without LLVM. gdb gained --dap in
        // v14 (2023-11); most Debian/Ubuntu 24.04+, Fedora 39+, Arch,
        // and MSYS2 mingw64 ship a recent enough gdb. Older systems
        // will fail at exec time with a clean error on stderr — the
        // DAP client surfaces it as a launch failure. Returned with a
        // `gdb:` sentinel so ExecBackend knows to inject `--dap` as
        // the first argv element.
        let gdbCands: List<string> = new List<string>()
        gdbCands.Add("gdb")
        gdbCands.Add("/usr/bin/gdb")
        gdbCands.Add("/opt/homebrew/bin/gdb")
        let m: int = gdbCands.Count()
        for i in 0..m {
            let c: string = gdbCands.Get(i)
            let hit: string = DapServer.Probe(c)
            if (String_Length(hit) > 0) {
                return "gdb:" + hit
            }
        }
        return ""
    }

    // Run `command -v` for a candidate binary; on hit return the
    // resolved absolute path with the trailing newline stripped, else
    // the empty string.
    private static string Probe(string candidate) {
        let probe = Process.RunCapture("command -v '" + candidate + "' 2>/dev/null")
        if (probe.Exit != 0 || String_Length(probe.Stdout) == 0) {
            return ""
        }
        var s: string = probe.Stdout
        let last: int = String_Length(s) - 1
        if (last >= 0) {
            let tail: string = String_Substring(s, last, 1)
            if (tail == "\n") {
                s = String_Substring(s, 0, last)
            }
        }
        return s
    }

    // Replace this process with the backend. argv[0] is the resolved
    // backend path; argv[1..] forwards `amc dap`'s own argv from
    // index 2 onward — except `--raw` / `--show-runtime` / `--bridge`
    // which are amc-internal flags. On success this never returns;
    // on execvp failure it prints and returns 127.
    private int ExecBackend(string exe) {
        @c {
            // Strip the `gdb:` sentinel DetectBackend added for the
            // gdb fallback path and remember it so we can inject the
            // `--dap` arg lldb-dap doesn't need.
            const char* exeStr = (const char*) exe;
            int isGdb = 0;
            if (strncmp(exeStr, "gdb:", 4) == 0) {
                isGdb = 1;
                exeStr += 4;
            }
            int parentArgc = code_argc;
            char** parentArgv = code_argv;
            int fwd = parentArgc - 2;
            if (fwd < 0) { fwd = 0; }
            // Pre-count surviving args after filtering our own flags.
            int filteredFwd = 0;
            for (int i = 0; i < fwd; i++) {
                const char* a = parentArgv[2 + i];
                if (a == NULL) continue;
                if (strcmp(a, "--raw") == 0) continue;
                if (strcmp(a, "--show-runtime") == 0) continue;
                if (strcmp(a, "--bridge") == 0) continue;
                if (strcmp(a, "--self-test-mi") == 0) continue;
                filteredFwd++;
            }
            int extra = isGdb ? 1 : 0;
            int n = 1 + extra + filteredFwd + 1;
            char** argv = (char**) malloc(sizeof(char*) * (size_t) n);
            if (argv == NULL) {
                fprintf(stderr, "amc dap: out of memory building argv\n");
                return 127;
            }
            int pos = 0;
            argv[pos++] = (char*) exeStr;
            if (isGdb) {
                argv[pos++] = (char*) "--dap";
            }
            for (int i = 0; i < fwd; i++) {
                const char* a = parentArgv[2 + i];
                if (a == NULL) continue;
                if (strcmp(a, "--raw") == 0) continue;
                if (strcmp(a, "--show-runtime") == 0) continue;
                if (strcmp(a, "--bridge") == 0) continue;
                if (strcmp(a, "--self-test-mi") == 0) continue;
                argv[pos++] = (char*) a;
            }
            argv[pos] = (char*) 0;
            execvp(exeStr, argv);
            // execvp returns only on error.
            perror("amc dap: execvp");
            free(argv);
            return 127;
        }
    }
}
