namespace Amalgame.Math.Vec

// ═══════════════════════════════════════════════════════
//  math_vec.am  —  Vec3, Vec4, Mat4 for game/graphics math
// ═══════════════════════════════════════════════════════
//
// These are *thin* facades over the C structs defined in
// `runtime/Amalgame_Math_Vec.h`. Each method is recognised by
// the cgen short-circuit as a runtime helper (Vec3, Vec4, Mat4
// are in the isCoreStdlib dispatch list), so the method call
// site lowers straight to `Vec3_Length(v)` rather than
// `Amalgame_Math_Vec_Vec3_Length(v)`.
//
// Stored as pointer-to-struct on the Amalgame side (`Vec3*`,
// `Mat4*`); GC-allocated by each helper so chained ops don't
// alias their inputs.
//
// Conventions:
//   - Matrices are 4×4 column-major (OpenGL convention).
//   - `Vec4.W` is the homogeneous coordinate (1 = position,
//     0 = direction).
//   - Rotations are in radians (use `Math.Pi() / 4` etc.).
//
// File is documentation-only; the runtime header is the source
// of truth for behaviour. Tests in `tests/samples/stdlib_math_vec.am`.

public class Vec3 {
    public Vec3(x: float, y: float, z: float) {}
    public float GetX()                  { return 0.0 }
    public float GetY()                  { return 0.0 }
    public float GetZ()                  { return 0.0 }
    public Vec3 Add(other: Vec3)         { return this }
    public Vec3 Sub(other: Vec3)         { return this }
    public Vec3 Scale(k: float)          { return this }
    public float Dot(other: Vec3)        { return 0.0 }
    public Vec3 Cross(other: Vec3)       { return this }
    public float Length()                { return 0.0 }
    public Vec3 Normalize()              { return this }
    public bool Equals(other: Vec3)      { return false }
}

public class Vec4 {
    public Vec4(x: float, y: float, z: float, w: float) {}
    public float GetX()                  { return 0.0 }
    public float GetY()                  { return 0.0 }
    public float GetZ()                  { return 0.0 }
    public float GetW()                  { return 0.0 }
    public Vec4 Add(other: Vec4)         { return this }
    public Vec4 Sub(other: Vec4)         { return this }
    public Vec4 Scale(k: float)          { return this }
    public float Dot(other: Vec4)        { return 0.0 }
}

public class Mat4 {
    public Mat4() {}
    public static Mat4 Identity()         { return new Mat4() }
    public static Mat4 Translate(tx: float, ty: float, tz: float) { return new Mat4() }
    public static Mat4 Scale(sx: float, sy: float, sz: float)     { return new Mat4() }
    public static Mat4 RotateX(angleRad: float)                   { return new Mat4() }
    public static Mat4 RotateY(angleRad: float)                   { return new Mat4() }
    public static Mat4 RotateZ(angleRad: float)                   { return new Mat4() }
    public float Get(col: int, row: int)                          { return 0.0 }
    public void  Set(col: int, row: int, v: float)                {}
    public Mat4  Multiply(other: Mat4)                            { return this }
    public Vec4  TransformVec4(v: Vec4)                           { return v }
}
