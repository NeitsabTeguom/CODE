namespace Amalgame.Formats.Yaml

import Amalgame.Collections
import Amalgame.String

// ═══════════════════════════════════════════════════════
//  yaml.am  —  YAML 1.2 subset reader
// ═══════════════════════════════════════════════════════
//
// Coverage:
//   - Top-level + nested block mappings (`key: value`)
//   - Block sequences (`- item`, indented)
//   - Scalars: bool (true/false), int, float, plain string,
//     single- and double-quoted strings
//   - Comments (`#` to end of line)
//   - Blank lines
//
// Out of scope (raise an error or fall back to plain string):
//   - Anchors / aliases (`&anchor`, `*ref`)
//   - Multi-doc separators (`---` / `...`)
//   - Flow style (`[1, 2]`, `{a: b}`)
//   - Multiline scalars (folded `>`, literal `|`)
//   - Tags (`!!str`, `!!int`)
//
// Same `YamlValue` tree shape as `TomlValue` in toml.am — caller
// walks Kind / Get(key) / At(idx) / AsString() / AsInt() / AsBool().

public enum YamlKind {
    Null
    Bool
    Int
    Float
    String
    Array
    Map
}

public class YamlValue {
    public  Kind:    YamlKind
    private B:       bool
    private I:       int
    private F:       float
    private S:       string
    private Items:   List<YamlValue>      // Array
    private MapKeys: List<string>          // Map keys (insertion order)
    private MapVals: List<YamlValue>       // Map values, parallel to MapKeys

    public YamlValue() {
        this.Kind    = YamlKind.Null
        this.B       = false
        this.I       = 0
        this.F       = 0.0
        this.S       = ""
        this.Items   = new List<YamlValue>()
        this.MapKeys = new List<string>()
        this.MapVals = new List<YamlValue>()
    }

    // ── Kind guards ───────────────────────────────────
    public bool IsNull()   { return this.Kind == YamlKind.Null }
    public bool IsBool()   { return this.Kind == YamlKind.Bool }
    public bool IsInt()    { return this.Kind == YamlKind.Int }
    public bool IsFloat()  { return this.Kind == YamlKind.Float }
    public bool IsString() { return this.Kind == YamlKind.String }
    public bool IsArray()  { return this.Kind == YamlKind.Array }
    public bool IsMap()    { return this.Kind == YamlKind.Map }

    // ── Scalar accessors ──────────────────────────────
    public bool AsBool() {
        if (this.Kind == YamlKind.Bool) { return this.B }
        return false
    }
    public int AsInt() {
        if (this.Kind == YamlKind.Int) { return this.I }
        return 0
    }
    public float AsFloat() {
        if (this.Kind == YamlKind.Float) { return this.F }
        if (this.Kind == YamlKind.Int)   { return this.I }
        return 0.0
    }
    public string AsString() {
        if (this.Kind == YamlKind.String) { return this.S }
        return ""
    }

    // ── Sizes + array access ──────────────────────────
    public int Count() {
        if (this.Kind == YamlKind.Array) { return this.Items.Count() }
        if (this.Kind == YamlKind.Map)   { return this.MapKeys.Count() }
        return 0
    }
    public YamlValue At(int idx) {
        if (this.Kind != YamlKind.Array)        { return new YamlValue() }
        if (idx < 0 || idx >= this.Items.Count()) { return new YamlValue() }
        return this.Items.Get(idx)
    }

    // ── Map access ────────────────────────────────────
    //
    // Returns Null-kind YamlValue for missing keys so chains like
    //   doc.Get("env").Get("DATABASE_URL").AsString()
    // stay readable. Use Has() if you need to distinguish "key
    // exists with empty value" from "key not present".
    public YamlValue Get(string key) {
        if (this.Kind != YamlKind.Map) { return new YamlValue() }
        let n: int = this.MapKeys.Count()
        var result: YamlValue = new YamlValue()
        for i in 0..n {
            if (this.MapKeys.Get(i) == key) {
                result = this.MapVals.Get(i)
            }
        }
        return result
    }
    public bool Has(string key) {
        if (this.Kind != YamlKind.Map) { return false }
        let n: int = this.MapKeys.Count()
        for i in 0..n {
            if (this.MapKeys.Get(i) == key) { return true }
        }
        return false
    }
    public List<string> Keys() {
        return this.MapKeys
    }

    // ── Builders (used by parser) ─────────────────────
    public void SetBool(bool v)     { this.Kind = YamlKind.Bool;   this.B = v }
    public void SetInt(int v)       { this.Kind = YamlKind.Int;    this.I = v }
    public void SetFloat(float v)   { this.Kind = YamlKind.Float;  this.F = v }
    public void SetString(string v) { this.Kind = YamlKind.String; this.S = v }
    public void MakeArray()         { this.Kind = YamlKind.Array }
    public void MakeMap()           { this.Kind = YamlKind.Map }
    public void ArrayAdd(YamlValue v) { this.Items.Add(v) }
    public void MapPut(string k, YamlValue v) {
        this.MapKeys.Add(k)
        this.MapVals.Add(v)
    }
}

// ── Parser ────────────────────────────────────────────
//
// Indent-driven, line-based. Walks the source one line at a
// time, peeks the indent of the next line to decide whether to
// recurse (deeper indent = nested) or pop back up. Indent
// must be spaces only (tabs forbidden per the YAML spec).

public class YamlParser {
    private Lines: List<string>
    private Pos:   int

    public YamlParser(src: string) {
        this.Lines = YamlParser.SplitLines(src)
        this.Pos   = 0
    }

    public static List<string> SplitLines(string src) {
        let out: List<string> = new List<string>()
        var cur: string = ""
        let n: int = String_Length(src)
        var i: int = 0
        while (i < n) {
            let c: string = String_Substring(src, i, 1)
            if (c == "\n") {
                out.Add(cur)
                cur = ""
            } else if (c != "\r") {
                cur = cur + c
            }
            i = i + 1
        }
        if (String_Length(cur) > 0) { out.Add(cur) }
        return out
    }

    // Count leading spaces on a line. -1 for "blank or comment" so
    // the indent walker skips them. YAML forbids tabs for
    // indentation; we silently treat them as 1 space, errors are
    // not the goal of a config-reader subset.
    public static int LineIndent(string line) {
        let n: int = String_Length(line)
        if (n == 0) { return -1 }
        var i: int = 0
        while (i < n) {
            let c: string = String_Substring(line, i, 1)
            if (c != " " && c != "\t") { break }
            i = i + 1
        }
        if (i == n) { return -1 }
        // Comment-only line.
        if (String_Substring(line, i, 1) == "#") { return -1 }
        return i
    }

    // Trim trailing comment from a content line: drop everything
    // after a ` #` (space + hash) that isn't inside quotes.
    public static string StripTrailingComment(string line) {
        let n: int = String_Length(line)
        var inSingle: bool = false
        var inDouble: bool = false
        var i: int = 0
        while (i < n) {
            let c: string = String_Substring(line, i, 1)
            if (!inDouble && c == "'") { inSingle = !inSingle }
            else if (!inSingle && c == "\"") { inDouble = !inDouble }
            else if (!inSingle && !inDouble) {
                if (c == "#" && i > 0) {
                    let prev: string = String_Substring(line, i - 1, 1)
                    if (prev == " " || prev == "\t") {
                        return String_TrimEnd(String_Substring(line, 0, i - 1))
                    }
                }
            }
            i = i + 1
        }
        return line
    }

    // ── Scalar literal → typed YamlValue. ─────────────
    public static YamlValue ParseScalar(string raw) {
        let v: YamlValue = new YamlValue()
        let t: string = String_Trim(raw)
        let n: int = String_Length(t)
        if (n == 0) { v.SetString(""); return v }
        // Quoted strings.
        let first: string = String_Substring(t, 0, 1)
        let last:  string = String_Substring(t, n - 1, 1)
        if (n >= 2 && first == "\"" && last == "\"") {
            // Double-quoted: minimal escape handling — \", \\, \n, \t.
            let inner: string = String_Substring(t, 1, n - 2)
            var unesc: string = ""
            let m: int = String_Length(inner)
            var i: int = 0
            while (i < m) {
                let c: string = String_Substring(inner, i, 1)
                if (c == "\\" && i + 1 < m) {
                    let e: string = String_Substring(inner, i + 1, 1)
                    if (e == "n")  { unesc = unesc + "\n" }
                    else if (e == "t")  { unesc = unesc + "\t" }
                    else if (e == "\\") { unesc = unesc + "\\" }
                    else if (e == "\"") { unesc = unesc + "\"" }
                    else                { unesc = unesc + e }
                    i = i + 2
                } else {
                    unesc = unesc + c
                    i = i + 1
                }
            }
            v.SetString(unesc)
            return v
        }
        if (n >= 2 && first == "'" && last == "'") {
            // Single-quoted: no escapes, '' becomes a single '.
            let inner: string = String_Substring(t, 1, n - 2)
            v.SetString(String_Replace(inner, "''", "'"))
            return v
        }
        // Bare scalars: bool / int / float / string.
        if (t == "true" || t == "True")   { v.SetBool(true); return v }
        if (t == "false" || t == "False") { v.SetBool(false); return v }
        if (t == "null" || t == "~")      { return v }
        // Float: contains a `.` and parses as float. (Doesn't try
        // exponential notation in v1 — the TOML reader doesn't
        // either, and CI configs don't need scientific.)
        if (String_Contains(t, ".")) {
            // Hand-roll: split on `.` and verify both halves are
            // digits. Negative sign tolerated.
            var rest: string = t
            var neg: bool = false
            if (String_StartsWith(rest, "-")) { neg = true; rest = String_Substring(rest, 1, String_Length(rest) - 1) }
            else if (String_StartsWith(rest, "+")) { rest = String_Substring(rest, 1, String_Length(rest) - 1) }
            let dotIdx: int = String_IndexOf(rest, ".")
            if (dotIdx > 0) {
                let head: string = String_Substring(rest, 0, dotIdx)
                let tail: string = String_Substring(rest, dotIdx + 1, String_Length(rest) - dotIdx - 1)
                if (YamlParser.IsDigits(head) && YamlParser.IsDigits(tail)) {
                    let combined: int = String_ToInt(head + tail)
                    let scale: int = YamlParser.Pow10(String_Length(tail))
                    var f: float = (combined * 1.0) / (scale * 1.0)
                    if (neg) { f = 0.0 - f }
                    v.SetFloat(f)
                    return v
                }
            }
        }
        // Integer (negative ok).
        if (YamlParser.IsIntLiteral(t)) {
            v.SetInt(String_ToInt(t))
            return v
        }
        v.SetString(t)
        return v
    }

    public static bool IsDigits(string s) {
        let n: int = String_Length(s)
        if (n == 0) { return false }
        let digits: string = "0123456789"
        var i: int = 0
        while (i < n) {
            let c: string = String_Substring(s, i, 1)
            // Amalgame doesn't implement `<` on `string` as a lex
            // compare (it falls back to pointer compare), so check
            // via membership lookup in a literal digit set.
            if (String_IndexOf(digits, c) < 0) { return false }
            i = i + 1
        }
        return true
    }

    public static bool IsIntLiteral(string s) {
        let n: int = String_Length(s)
        if (n == 0) { return false }
        var start: int = 0
        let first: string = String_Substring(s, 0, 1)
        if (first == "-" || first == "+") { start = 1 }
        if (start == n) { return false }
        return YamlParser.IsDigits(String_Substring(s, start, n - start))
    }

    public static int Pow10(int n) {
        var r: int = 1
        var i: int = 0
        while (i < n) { r = r * 10; i = i + 1 }
        return r
    }

    // Advance past blank / comment-only lines. Returns true while
    // there's still content to consume.
    private bool SkipBlank() {
        let n: int = this.Lines.Count()
        while (this.Pos < n) {
            let line: string = this.Lines.Get(this.Pos)
            if (YamlParser.LineIndent(line) >= 0) { return true }
            this.Pos = this.Pos + 1
        }
        return false
    }

    // Parse a block at `baseIndent` — either a mapping or a
    // sequence, decided by the first content line at that indent.
    public YamlValue ParseBlock(int baseIndent) {
        if (!this.SkipBlank()) { return new YamlValue() }
        let firstLine: string = this.Lines.Get(this.Pos)
        let firstIndent: int = YamlParser.LineIndent(firstLine)
        if (firstIndent < baseIndent) { return new YamlValue() }
        let trimmed: string = String_TrimStart(YamlParser.StripTrailingComment(firstLine))
        if (String_StartsWith(trimmed, "- ") || trimmed == "-") {
            return this.ParseSequence(firstIndent)
        }
        return this.ParseMapping(firstIndent)
    }

    private YamlValue ParseSequence(int indent) {
        let arr: YamlValue = new YamlValue()
        arr.MakeArray()
        let n: int = this.Lines.Count()
        while (this.Pos < n) {
            if (!this.SkipBlank()) { return arr }
            let line: string = this.Lines.Get(this.Pos)
            let li: int = YamlParser.LineIndent(line)
            if (li < indent) { return arr }
            if (li > indent) {
                // Continuation of the previous item — skip; should
                // have been consumed by the recursive ParseBlock.
                return arr
            }
            let trimmed: string = String_TrimStart(YamlParser.StripTrailingComment(line))
            if (!String_StartsWith(trimmed, "-")) { return arr }
            // Strip leading "- " and parse the value. If the rest
            // is empty, the value is a nested block on the next
            // line at a deeper indent.
            let after: string = String_Substring(trimmed, 1, String_Length(trimmed) - 1)
            let rest: string = String_TrimStart(after)
            this.Pos = this.Pos + 1
            if (String_Length(rest) == 0) {
                let nested: YamlValue = this.ParseBlock(indent + 1)
                arr.ArrayAdd(nested)
                continue
            }
            // Inline scalar after the `-`. Could also be a
            // `- key: value` short-hand mapping; check for `:`.
            if (this.LooksLikeMappingLine(rest)) {
                // Rewind one position-pseudo: re-parse this line
                // as the first key of a one-key map by faking the
                // indent. Simpler: build the map here directly.
                let m: YamlValue = new YamlValue()
                m.MakeMap()
                this.AddMappingPair(m, indent + 2, rest)
                // Continue adding pairs at deeper indent.
                while (this.Pos < n) {
                    if (!this.SkipBlank()) { break }
                    let li2: int = YamlParser.LineIndent(this.Lines.Get(this.Pos))
                    if (li2 <= indent) { break }
                    let l2: string = String_TrimStart(YamlParser.StripTrailingComment(this.Lines.Get(this.Pos)))
                    if (!this.LooksLikeMappingLine(l2)) { break }
                    this.Pos = this.Pos + 1
                    this.AddMappingPair(m, li2, l2)
                }
                arr.ArrayAdd(m)
            } else {
                arr.ArrayAdd(YamlParser.ParseScalar(rest))
            }
        }
        return arr
    }

    private YamlValue ParseMapping(int indent) {
        let m: YamlValue = new YamlValue()
        m.MakeMap()
        let n: int = this.Lines.Count()
        while (this.Pos < n) {
            if (!this.SkipBlank()) { return m }
            let line: string = this.Lines.Get(this.Pos)
            let li: int = YamlParser.LineIndent(line)
            if (li < indent) { return m }
            if (li > indent) { return m } // shouldn't happen at this entry point
            let trimmed: string = String_TrimStart(YamlParser.StripTrailingComment(line))
            if (!this.LooksLikeMappingLine(trimmed)) { return m }
            this.Pos = this.Pos + 1
            this.AddMappingPair(m, indent, trimmed)
        }
        return m
    }

    // Heuristic: a mapping line has a `:` followed by space or
    // end-of-line, with a non-empty key on the left. False
    // positive for `https://example.com` is avoided because the
    // colon would be followed by `/`, not space/EOL.
    private bool LooksLikeMappingLine(string line) {
        let n: int = String_Length(line)
        var inSingle: bool = false
        var inDouble: bool = false
        var i: int = 0
        while (i < n) {
            let c: string = String_Substring(line, i, 1)
            if (!inDouble && c == "'") { inSingle = !inSingle }
            else if (!inSingle && c == "\"") { inDouble = !inDouble }
            else if (!inSingle && !inDouble && c == ":") {
                if (i + 1 == n) { return true }
                let next: string = String_Substring(line, i + 1, 1)
                if (next == " " || next == "\t") { return true }
            }
            i = i + 1
        }
        return false
    }

    // Append a single `key: value` pair to `m`. If the value is
    // empty (`key:` alone), recurse into ParseBlock at the next
    // indent step.
    private void AddMappingPair(YamlValue m, int curIndent, string line) {
        let colonIdx: int = this.FindMappingColon(line)
        if (colonIdx < 0) { return }
        let rawKey: string = String_Trim(String_Substring(line, 0, colonIdx))
        let key: string = this.UnquoteKey(rawKey)
        let rest: string = String_Trim(String_Substring(line, colonIdx + 1, String_Length(line) - colonIdx - 1))
        if (String_Length(rest) == 0) {
            let nested: YamlValue = this.ParseBlock(curIndent + 1)
            m.MapPut(key, nested)
        } else {
            m.MapPut(key, YamlParser.ParseScalar(rest))
        }
    }

    private string UnquoteKey(string raw) {
        let n: int = String_Length(raw)
        if (n < 2) { return raw }
        let first: string = String_Substring(raw, 0, 1)
        let last:  string = String_Substring(raw, n - 1, 1)
        if ((first == "\"" && last == "\"") || (first == "'" && last == "'")) {
            return String_Substring(raw, 1, n - 2)
        }
        return raw
    }

    private int FindMappingColon(string line) {
        let n: int = String_Length(line)
        var inSingle: bool = false
        var inDouble: bool = false
        var i: int = 0
        while (i < n) {
            let c: string = String_Substring(line, i, 1)
            if (!inDouble && c == "'") { inSingle = !inSingle }
            else if (!inSingle && c == "\"") { inDouble = !inDouble }
            else if (!inSingle && !inDouble && c == ":") {
                if (i + 1 == n) { return i }
                let next: string = String_Substring(line, i + 1, 1)
                if (next == " " || next == "\t") { return i }
            }
            i = i + 1
        }
        return -1
    }
}

// ── Public entry point ─────────────────────────────────

public class Yaml {
    public Yaml() {}

    // Parse a YAML 1.2 subset document. Returns a Null-kind
    // YamlValue if `src` is empty or contains only blanks /
    // comments. Errors are best-effort: malformed lines become
    // plain-string scalars rather than aborting the parse.
    public static YamlValue Parse(string src) {
        let p: YamlParser = new YamlParser(src)
        return p.ParseBlock(0)
    }
}
