namespace Amalgame.Compiler

import Amalgame.Collections
import Amalgame.IO
import Amalgame.String

public class Program {
    public static void Main(string[] args) {
        // --- Single-file generation ---
        let singles = new List<string>()
        singles.Add("./src/amalgame/lexer/token.am")
        singles.Add("./src/amalgame/parser/ast.am")
        let sc = singles.Count()
        for i in 0..sc {
            let path = singles.Get(i)
            let src  = File.ReadAll(path)
            let lex  = new Lexer(src, path)
            let toks = lex.Tokenize()
            let par  = new Parser(toks)
            let prog = par.Parse()
            let gen  = new CGen()
            let code = gen.Generate(prog)
            let outName = path + "_bootstrap.c"
            File.WriteAll(outName, code)
            let clen = String_Length(code)
            Console.WriteLine("{path}: {clen} chars → {outName}")
        }

        // --- Parse all files once ---
        let tokPath = "./src/amalgame/lexer/token.am"
        let tokSrc  = File.ReadAll(tokPath)
        let tokLex  = new Lexer(tokSrc, tokPath)
        let tokToks = tokLex.Tokenize()
        let tokPar  = new Parser(tokToks)
        let tokProg = tokPar.Parse()

        let astPath = "./src/amalgame/parser/ast.am"
        let astSrc  = File.ReadAll(astPath)
        let astLex  = new Lexer(astSrc, astPath)
        let astToks = astLex.Tokenize()
        let astPar  = new Parser(astToks)
        let astProg = astPar.Parse()

        let lexPath = "./src/amalgame/lexer/lexer.am"
        let lexSrc  = File.ReadAll(lexPath)
        let lexLex  = new Lexer(lexSrc, lexPath)
        let lexToks = lexLex.Tokenize()
        let lexPar  = new Parser(lexToks)
        let lexProg = lexPar.Parse()

        let parPath = "./src/amalgame/parser/parser.am"
        let parSrc  = File.ReadAll(parPath)
        let parLex  = new Lexer(parSrc, parPath)
        let parToks = parLex.Tokenize()
        let parPar  = new Parser(parToks)
        let parProg = parPar.Parse()

        let cgenPath = "./src/amalgame/generator/c_gen.am"
        let cgenSrc  = File.ReadAll(cgenPath)
        let cgenLex  = new Lexer(cgenSrc, cgenPath)
        let cgenToks = cgenLex.Tokenize()
        let cgenPar  = new Parser(cgenToks)
        let cgenProg = cgenPar.Parse()

        // --- Bundles: use a helper that avoids large string accumulation ---
        // We generate to a CGen, get lines count, write line by line

        // Lexer bundle
        let gen2 = new CGen()
        gen2.BeginMulti("Amalgame.Compiler")
        gen2.AddFilePass1(tokProg)
        gen2.AddFilePass1(lexProg)
        gen2.EmitSeparator()
        gen2.AddFilePass2(tokProg)
        gen2.AddFilePass2(lexProg)
        let lines2 = gen2.GetLines()
        let lc2    = lines2.Count()
        let out2   = "./src/amalgame/lexer/lexer_bundle_bootstrap.c"
        File.WriteAll(out2, "")
        for wi in 0..lc2 {
            let wline = lines2.Get(wi)
            File.AppendAll(out2, wline + "\n")
        }
        Console.WriteLine("lexer bundle: {lc2} lines → {out2}")

        // Parser bundle
        let gen3 = new CGen()
        gen3.BeginMulti("Amalgame.Compiler")
        gen3.AddFilePass1(tokProg)
        gen3.AddFilePass1(astProg)
        gen3.AddFilePass1(lexProg)
        gen3.AddFilePass1(parProg)
        gen3.EmitSeparator()
        gen3.AddFilePass2(tokProg)
        gen3.AddFilePass2(astProg)
        gen3.AddFilePass2(lexProg)
        gen3.AddFilePass2(parProg)
        let lines3 = gen3.GetLines()
        let lc3    = lines3.Count()
        let out3   = "./src/amalgame/parser/parser_bundle_bootstrap.c"
        File.WriteAll(out3, "")
        for wi in 0..lc3 {
            let wline = lines3.Get(wi)
            File.AppendAll(out3, wline + "\n")
        }
        Console.WriteLine("parser bundle: {lc3} lines → {out3}")

        // CGen bundle
        let gen4 = new CGen()
        gen4.BeginMulti("Amalgame.Compiler")
        gen4.AddFilePass1(tokProg)
        gen4.AddFilePass1(astProg)
        gen4.AddFilePass1(lexProg)
        gen4.AddFilePass1(parProg)
        gen4.AddFilePass1(cgenProg)
        gen4.EmitSeparator()
        gen4.AddFilePass2(tokProg)
        gen4.AddFilePass2(astProg)
        gen4.AddFilePass2(lexProg)
        gen4.AddFilePass2(parProg)
        gen4.AddFilePass2(cgenProg)
        let lines4 = gen4.GetLines()
        let lc4    = lines4.Count()
        let out4   = "./src/amalgame/generator/cgen_bundle_bootstrap.c"
        File.WriteAll(out4, "")
        for wi in 0..lc4 {
            let wline = lines4.Get(wi)
            File.AppendAll(out4, wline + "\n")
        }
        Console.WriteLine("cgen bundle: {lc4} lines → {out4}")

        // Full lib bundle
        let gen5 = new CGen()
        gen5.BeginMulti("Amalgame.Compiler")
        gen5.AddFilePass1(tokProg)
        gen5.AddFilePass1(astProg)
        gen5.AddFilePass1(lexProg)
        gen5.AddFilePass1(parProg)
        gen5.AddFilePass1(cgenProg)
        gen5.EmitSeparator()
        gen5.AddFilePass2(tokProg)
        gen5.AddFilePass2(astProg)
        gen5.AddFilePass2(lexProg)
        gen5.AddFilePass2(parProg)
        gen5.AddFilePass2(cgenProg)
        let lines5 = gen5.GetLines()
        let lc5    = lines5.Count()
        let out5   = "./src/amalgame/amc_bootstrap_lib.c"
        File.WriteAll(out5, "")
        for wi in 0..lc5 {
            let wline = lines5.Get(wi)
            File.AppendAll(out5, wline + "\n")
        }
        Console.WriteLine("amc_bootstrap_lib: {lc5} lines → {out5}")
        Console.WriteLine("Done!")
    }
}
