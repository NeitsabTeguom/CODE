namespace Amalgame.Compiler

import Amalgame.Collections
import Amalgame.IO
import Amalgame.String

public class Program {
    public static void Main(string[] args) {
        // --- Single-file generation ---
        let singles = new List<string>()
        singles.Add("./src/amalgame/lexer/token.am")
        singles.Add("./src/amalgame/parser/ast.am")
        let sc = singles.Count()
        for i in 0..sc {
            let path = singles.Get(i)
            let src  = File.ReadAll(path)
            let lex  = new Lexer(src, path)
            let toks = lex.Tokenize()
            let par  = new Parser(toks)
            let prog = par.Parse()
            let gen  = new CGen()
            let code = gen.Generate(prog)
            let outName = path + "_bootstrap.c"
            File.WriteAll(outName, code)
            let clen = String_Length(code)
            Console.WriteLine("{path}: {clen} chars → {outName}")
        }

        // --- Parse all files once ---
        let tokPath = "./src/amalgame/lexer/token.am"
        let tokSrc  = File.ReadAll(tokPath)
        let tokLex  = new Lexer(tokSrc, tokPath)
        let tokToks = tokLex.Tokenize()
        let tokPar  = new Parser(tokToks)
        let tokProg = tokPar.Parse()

        let astPath = "./src/amalgame/parser/ast.am"
        let astSrc  = File.ReadAll(astPath)
        let astLex  = new Lexer(astSrc, astPath)
        let astToks = astLex.Tokenize()
        let astPar  = new Parser(astToks)
        let astProg = astPar.Parse()

        let lexPath = "./src/amalgame/lexer/lexer.am"
        let lexSrc  = File.ReadAll(lexPath)
        let lexLex  = new Lexer(lexSrc, lexPath)
        let lexToks = lexLex.Tokenize()
        let lexPar  = new Parser(lexToks)
        let lexProg = lexPar.Parse()

        let parPath = "./src/amalgame/parser/parser.am"
        let parSrc  = File.ReadAll(parPath)
        let parLex  = new Lexer(parSrc, parPath)
        let parToks = parLex.Tokenize()
        let parPar  = new Parser(parToks)
        let parProg = parPar.Parse()

        let cgenPath = "./src/amalgame/generator/c_gen.am"
        let cgenSrc  = File.ReadAll(cgenPath)
        let cgenLex  = new Lexer(cgenSrc, cgenPath)
        let cgenToks = cgenLex.Tokenize()
        let cgenPar  = new Parser(cgenToks)
        let cgenProg = cgenPar.Parse()

        // --- Bundles: use a helper that avoids large string accumulation ---
        // We generate to a CGen, get lines count, write line by line

        // Lexer bundle — streaming
        let out2 = "./src/amalgame/lexer/lexer_bundle_bootstrap.c"
        File.OpenWrite(out2)
        let gen2 = new CGen()
        gen2.SetStreaming(true)
        gen2.BeginMulti("Amalgame.Compiler")
        gen2.AddFilePass1(tokProg)
        gen2.AddFilePass1(lexProg)
        gen2.EmitSeparator()
        gen2.AddFilePass2(tokProg)
        gen2.AddFilePass2(lexProg)
        File.CloseWrite()
        Console.WriteLine("lexer bundle: → {out2}")

        // Parser bundle — streaming
        let out3 = "./src/amalgame/parser/parser_bundle_bootstrap.c"
        File.OpenWrite(out3)
        let gen3 = new CGen()
        gen3.SetStreaming(true)
        gen3.BeginMulti("Amalgame.Compiler")
        gen3.AddFilePass1(tokProg)
        gen3.AddFilePass1(astProg)
        gen3.AddFilePass1(lexProg)
        gen3.AddFilePass1(parProg)
        gen3.EmitSeparator()
        gen3.AddFilePass2(tokProg)
        gen3.AddFilePass2(astProg)
        gen3.AddFilePass2(lexProg)
        gen3.AddFilePass2(parProg)
        File.CloseWrite()
        Console.WriteLine("parser bundle: → {out3}")

        // CGen bundle — streaming
        let out4 = "./src/amalgame/generator/cgen_bundle_bootstrap.c"
        File.OpenWrite(out4)
        let gen4 = new CGen()
        gen4.SetStreaming(true)
        gen4.BeginMulti("Amalgame.Compiler")
        gen4.AddFilePass1(tokProg)
        gen4.AddFilePass1(astProg)
        gen4.AddFilePass1(lexProg)
        gen4.AddFilePass1(parProg)
        gen4.AddFilePass1(cgenProg)
        gen4.EmitSeparator()
        gen4.AddFilePass2(tokProg)
        gen4.AddFilePass2(astProg)
        gen4.AddFilePass2(lexProg)
        gen4.AddFilePass2(parProg)
        gen4.AddFilePass2(cgenProg)
        File.CloseWrite()
        Console.WriteLine("cgen bundle: → {out4}")

        // Full lib bundle — streaming
        let out5 = "./src/amalgame/amc_bootstrap_lib.c"
        File.OpenWrite(out5)
        let gen5 = new CGen()
        gen5.SetStreaming(true)
        gen5.BeginMulti("Amalgame.Compiler")
        gen5.AddFilePass1(tokProg)
        gen5.AddFilePass1(astProg)
        gen5.AddFilePass1(lexProg)
        gen5.AddFilePass1(parProg)
        gen5.AddFilePass1(cgenProg)
        gen5.EmitSeparator()
        gen5.AddFilePass2(tokProg)
        gen5.AddFilePass2(astProg)
        gen5.AddFilePass2(lexProg)
        gen5.AddFilePass2(parProg)
        gen5.AddFilePass2(cgenProg)
        File.CloseWrite()
        Console.WriteLine("amc_bootstrap_lib: → {out5}")

        // --- Full amc lib (streaming) ---
        Console.WriteError("parsing extra files...")
        let symPath  = "./src/amalgame/resolver/symbol.am"
        let symSrc   = File.ReadAll(symPath)
        let symLex   = new Lexer(symSrc, symPath)
        let symToks  = symLex.Tokenize()
        let symPar   = new Parser(symToks)
        let symProg  = symPar.Parse()
        Console.WriteError("parsed: symbol.am")

        let rvrPath  = "./src/amalgame/resolver/resolver.am"
        let rvrSrc   = File.ReadAll(rvrPath)
        let rvrLex   = new Lexer(rvrSrc, rvrPath)
        let rvrToks  = rvrLex.Tokenize()
        let rvrPar   = new Parser(rvrToks)
        let rvrProg  = rvrPar.Parse()
        Console.WriteError("parsed: resolver.am")

        let diagPath = "./src/amalgame/diagnostics.am"
        let diagSrc  = File.ReadAll(diagPath)
        let diagLex  = new Lexer(diagSrc, diagPath)
        let diagToks = diagLex.Tokenize()
        let diagPar  = new Parser(diagToks)
        let diagProg = diagPar.Parse()
        Console.WriteError("parsed: diagnostics.am")

        let tckPath  = "./src/amalgame/typechecker.am"
        let tckSrc   = File.ReadAll(tckPath)
        let tckLex   = new Lexer(tckSrc, tckPath)
        let tckToks  = tckLex.Tokenize()
        let tckPar   = new Parser(tckToks)
        let tckProg  = tckPar.Parse()
        Console.WriteError("parsed: typechecker.am")

        let mainPath = "./src/amalgame/main.am"
        let mainSrc  = File.ReadAll(mainPath)
        let mainLex  = new Lexer(mainSrc, mainPath)
        let mainToks = mainLex.Tokenize()
        let mainPar  = new Parser(mainToks)
        let mainProg = mainPar.Parse()
        Console.WriteError("parsed: main.am")

        Console.WriteError("gen6: starting")
        Console.WriteError("parsing done, generating...")
        let out6 = "./src/amalgame/amc_lib.c"
        File.OpenWrite(out6)
        let gen6 = new CGen()
        gen6.SetStreaming(true)
        gen6.BeginMulti("Amalgame.Compiler")
        // diagnostics.am defines SourceMap/SourceSnippet, used by resolver+typechecker.
        // The bootstrap CGen only emits struct typedefs in Pass 1; method forward
        // decls and bodies are emitted file-by-file in Pass 2, so dependents must
        // come AFTER diagnostics in this list.
        gen6.AddFilePass1(tokProg)
        gen6.AddFilePass1(astProg)
        gen6.AddFilePass1(lexProg)
        gen6.AddFilePass1(parProg)
        gen6.AddFilePass1(cgenProg)
        gen6.AddFilePass1(diagProg)
        gen6.AddFilePass1(symProg)
        gen6.AddFilePass1(rvrProg)
        gen6.AddFilePass1(tckProg)
        gen6.AddFilePass1(mainProg)
        gen6.EmitSeparator()
        Console.WriteError("gen6: pass1 done, starting pass2")
        gen6.AddFilePass2(tokProg)
        gen6.AddFilePass2(astProg)
        gen6.AddFilePass2(lexProg)
        gen6.AddFilePass2(parProg)
        gen6.AddFilePass2(cgenProg)
        gen6.AddFilePass2(diagProg)
        gen6.AddFilePass2(symProg)
        gen6.AddFilePass2(rvrProg)
        gen6.AddFilePass2(tckProg)
        gen6.AddFilePass2(mainProg)
        Console.WriteError("gen6: pass2 done")
        File.CloseWrite()
        Console.WriteLine("amc_lib: → {out6}")

        Console.WriteLine("Done!")
    }
}
