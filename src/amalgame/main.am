namespace Amalgame.Compiler

import Amalgame.Collections
import Amalgame.IO
import Amalgame.String

// Bootstrap compiler entry point
public class AmalgameCompiler {
    private Diag:    DiagnosticFormatter
    private IsLib:   bool
    private CheckOnly: bool
    private Verbose: bool
    private ExitCode: int

    public AmalgameCompiler() {
        this.Diag      = new DiagnosticFormatter()
        this.IsLib     = false
        this.CheckOnly = false
        this.Verbose   = false
        this.ExitCode  = 0
    }

    public void SetLib(bool v)       { this.IsLib     = v }
    public void SetCheckOnly(bool v) { this.CheckOnly = v }
    public void SetVerbose(bool v)   { this.Verbose   = v }
    public void SetColor(bool v)     { this.Diag.EnableColor(v) }
    public int  GetExitCode()        { return this.ExitCode }

    // ── Main compile pipeline ─────────────────────────

    public void Run(List<string> inputFiles, string outputName) {
        let inputCount = inputFiles.Count()
        if (inputCount == 0) {
            Console.WriteError("amc: no input .am files")
            this.ExitCode = 1
            return
        }

        if (this.Verbose) {
            Console.WriteLine("Compiling: " + String_FromInt(inputCount) + " file(s)")
        }

        // ── Detect namespace from first file ──────────
        let firstPath = inputFiles.Get(0)
        let firstSrc  = File.ReadAll(firstPath)
        var nsPrefix  = "App"
        let nlIdx = String_IndexOf(firstSrc, "namespace ")
        if (nlIdx >= 0) {
            let nlRest = String_Substring(firstSrc, nlIdx + 10, 200)
            let nlEnd  = String_IndexOf(nlRest, "\n")
            if (nlEnd > 0) {
                let rawNs = String_Substring(nlRest, 0, nlEnd)
                nsPrefix  = String_Replace(String_Trim(rawNs), ".", "_")
            }
        }

        // ── CGen init ─────────────────────────────────
        let gen = new CGen()
        gen.BeginMulti(nsPrefix)

        // ── Parse all files & Pass 1 ──────────────────
        let progs = new List<AstNode>()
        var parseOk = true
        for i in 0..inputCount {
            let path = inputFiles.Get(i)
            let src  = File.ReadAll(path)
            this.Diag.LoadSource(path, src)
            let lex  = new Lexer(src, path)
            let toks = lex.Tokenize()
            let par  = new Parser(toks)
            let prog = par.Parse()
            progs.Add(prog)
            gen.AddFilePass1(prog)
        }

        // ── Resolver pass ─────────────────────────────
        let resolver   = new FullResolver()
        let progCount  = progs.Count()
        for ri in 0..progCount {
            resolver.Programs.Add(progs.Get(ri))
        }
        resolver.ResolvePrograms()
        if (resolver.HasErrors()) {
            Console.WriteError(resolver.GetErrors())
            this.ExitCode = 1
            if (!this.CheckOnly) {
                // Non-fatal: continue to catch more errors
            }
        }

        // ── TypeChecker pass ──────────────────────────
        let tc     = new TypeChecker(resolver, firstPath)
        let tcProg = progs.Get(0)
        tc.Check(tcProg)
        if (tc.HasErrors()) {
            Console.WriteError(tc.FormatErrors())
            this.ExitCode = 1
        }

        // ── Check-only mode: stop here ────────────────
        if (this.CheckOnly) {
            if (this.ExitCode == 0) {
                this.Diag.PrintPhaseOk("Check")
            }
            return
        }

        // ── Codegen pass ──────────────────────────────
        gen.EmitSeparator()
        for j in 0..inputCount {
            gen.AddFilePass2(progs.Get(j))
        }

        // ── Write output .c ───────────────────────────
        let lines     = gen.GetLines()
        let lineCount = lines.Count()
        let outC      = outputName + ".c"
        File.WriteAll(outC, "")
        for k in 0..lineCount {
            File.AppendAll(outC, lines.Get(k) + "\n")
        }

        // ── Emit C main() unless --lib ─────────────────
        let mainFunc = nsPrefix + "_Program_Main"
        let genSrc   = File.ReadAll(outC)
        if (!this.IsLib && String_Contains(genSrc, mainFunc)) {
            File.AppendAll(outC, "\nint main(int argc, char** argv) {\n")
            File.AppendAll(outC, "    GC_INIT();\n")
            File.AppendAll(outC, "    " + mainFunc + "((code_string*)argv);\n")
            File.AppendAll(outC, "    return 0;\n")
            File.AppendAll(outC, "}\n")
        }

        Console.WriteLine("Generated: " + outC + " (" + String_FromInt(lineCount) + " lines)")
        this.Diag.PrintCompileOk("Build")
    }
}

public class AmcEntry {
    public static void AmcStart() {
        Console.WriteError("Use amc binary directly")
    }
}
