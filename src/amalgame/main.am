namespace Amalgame.Compiler

import Amalgame.Collections
import Amalgame.IO
import Amalgame.String

// Bootstrap compiler entry point
public class AmalgameCompiler {
    private Diag: DiagnosticFormatter

    public AmalgameCompiler() {
        this.Diag = new DiagnosticFormatter()
    }

    public void Run(List<string> inputFiles, string outputName) {
        let inputCount = inputFiles.Count()
        if (inputCount == 0) {
            Console.WriteError("amc: no input files")
            return
        }

        Console.WriteLine("Compiling: " + String_FromInt(inputCount) + " files")

        let gen = new CGen()
        gen.BeginMulti("Amalgame.Compiler")

        for i in 0..inputCount {
            let path = inputFiles.Get(i)
            let src  = File.ReadAll(path)
            let lex  = new Lexer(src, path)
            let toks = lex.Tokenize()
            let par  = new Parser(toks)
            let prog = par.Parse()
            gen.AddFilePass1(prog)
        }

        gen.EmitSeparator()

        for j in 0..inputCount {
            let path2 = inputFiles.Get(j)
            let src2  = File.ReadAll(path2)
            let lex2  = new Lexer(src2, path2)
            let toks2 = lex2.Tokenize()
            let par2  = new Parser(toks2)
            let prog2 = par2.Parse()
            gen.AddFilePass2(prog2)
        }

        let code = gen.FinishMulti()
        let outC  = outputName + ".c"
        File.WriteAll(outC, code)
        Console.WriteLine("Generated: " + outC)
        this.Diag.PrintCompileOk("Build")
    }
}

public class Program {
    public static void Main(string[] args) {
        let files = new List<string>()
        let compiler = new AmalgameCompiler()
        compiler.Run(files, "a.out")
    }
}
