namespace Amalgame.Compiler

import Amalgame.Collections
import Amalgame.String

// ═══════════════════════════════════════════════════════
//  resolver.am  —  Name resolution pass
//
//  Two sequential passes over the AST:
//
//  Pass 1 — CollectDecl
//    Register every top-level type name (class, enum)
//    into the global scope so forward references work.
//    Also build the member table: className → field/method → typeName.
//
//  Pass 2 — ResolveDecl
//    Walk the entire AST. Open/close scopes around each
//    declaration and block. Validate every identifier and
//    type reference. Register local variables.
//
//  The MemberTable built in Pass 1 is used by the
//  TypeChecker to resolve member access types.
// ═══════════════════════════════════════════════════════

// ── MemberTable ───────────────────────────────────────
// Flat parallel lists: className + "." + memberName → typeName
public class MemberTable {
    private Keys:   List<string>
    private Values: List<string>

    public MemberTable() {
        this.Keys   = new List<string>()
        this.Values = new List<string>()
    }

    public void Set(string className, string memberName, string typeName) {
        let key   = className + "." + memberName
        let count = this.Keys.Count()
        for i in 0..count {
            if (this.Keys.Get(i) == key) {
                this.Values.Add(typeName)   // last write wins
                return
            }
        }
        this.Keys.Add(key)
        this.Values.Add(typeName)
    }

    public string Get(string className, string memberName) {
        let key   = className + "." + memberName
        let count = this.Keys.Count()
        var result = "?"
        for i in 0..count {
            if (this.Keys.Get(i) == key) {
                result = this.Values.Get(i)
            }
        }
        return result
    }

    public bool Has(string className, string memberName) {
        let key   = className + "." + memberName
        let count = this.Keys.Count()
        for i in 0..count {
            if (this.Keys.Get(i) == key) { return true }
        }
        return false
    }
}

// ── FullResolver ──────────────────────────────────────
public class FullResolver {
    // Flat scope: global names + local (method-level) names
    // Using parallel lists to avoid void* dereference on List.Get()
    private GlobalNames:   List<string>
    private GlobalTypes:   List<string>
    private LocalNames:    List<string>
    private LocalTypes:    List<string>
    private LocalIsLets:   List<bool>
    // Stack of scope start indices into LocalNames/Types/IsLets
    private ScopeStarts:   List<int>
    // Member table: class → member → type
    public  Members:       MemberTable
    // Errors collected
    private Errors:        List<string>
    // Multiple programs to resolve together
    public  Programs:      List<AstNode>
    // Current class being visited
    private CurrentClass:  string
    // Current method return type
    private CurrentReturn: string
    // Loop nesting depth
    private LoopDepth:     int
    // Current file being resolved — used by error formatters to render source snippets.
    private CurrentFile:   string
    // Source map (path → text) — set by main; defaults to an empty SourceMap so
    // standalone uses (resolver tests) keep working without configuration.
    public  Sources:       SourceMap

    public FullResolver() {
        this.GlobalNames   = new List<string>()
        this.GlobalTypes   = new List<string>()
        this.LocalNames    = new List<string>()
        this.LocalTypes    = new List<string>()
        this.LocalIsLets   = new List<bool>()
        this.ScopeStarts   = new List<int>()
        this.Members       = new MemberTable()
        this.Errors        = new List<string>()
        this.Programs      = new List<AstNode>()
        this.CurrentClass  = ""
        this.CurrentReturn = "void"
        this.LoopDepth     = 0
        this.CurrentFile   = ""
        this.Sources       = new SourceMap()
        this.RegisterBuiltins()
    }

    // ── Builtin registration ──────────────────────────

    private void RegisterBuiltins() {
        this.DeclareGlobal("int",    "type", false)
        this.DeclareGlobal("float",  "type", false)
        this.DeclareGlobal("double", "type", false)
        this.DeclareGlobal("bool",   "type", false)
        this.DeclareGlobal("string", "type", false)
        this.DeclareGlobal("void",   "type", false)
        this.DeclareGlobal("null",   "null", false)
        this.DeclareGlobal("true",   "bool", false)
        this.DeclareGlobal("false",  "bool", false)
        this.DeclareGlobal("this",   "?",    false)
        this.DeclareGlobal("args",   "string[]", false)
        // Stdlib namespaces / static classes — declared as types so calls like
        // String.Method(s) or List.<Util>(...) don't raise "Unknown symbol".
        // The CGen maps `Foo.Method(...)` to `Foo_Method(...)` via the isStdlib
        // path; the builtin function names are declared individually below.
        this.DeclareGlobal("String",         "type", false)
        this.DeclareGlobal("List",           "type", false)
        this.DeclareGlobal("Map",            "type", false)
        this.DeclareGlobal("Set",            "type", false)
        this.DeclareGlobal("Path",           "type", false)
        this.DeclareGlobal("Env",            "type", false)
