namespace Amalgame.Compiler

import Amalgame.String

// ── Diagnostic Formatter ──────────────────────────────
// Produit des messages d'erreur lisibles style Rust/Swift
//
// error[resolver]: unknown identifier 'Foo'
//   --> file.am:12:5
//    |
// 12 |     let x = Foo
//    |             ^^^
//    |

public class DiagnosticFormatter {
    private UseColor: bool

    public DiagnosticFormatter() {
        this.UseColor = false
    }

    public void EnableColor(bool v) {
        this.UseColor = v
    }

    private string Red(string s) {
        if (!this.UseColor) { return s }
        return "\x1b[1;31m" + s + "\x1b[0m"
    }

    private string Yellow(string s) {
        if (!this.UseColor) { return s }
        return "\x1b[1;33m" + s + "\x1b[0m"
    }

    private string Cyan(string s) {
        if (!this.UseColor) { return s }
        return "\x1b[1;36m" + s + "\x1b[0m"
    }

    private string Bold(string s) {
        if (!this.UseColor) { return s }
        return "\x1b[1m" + s + "\x1b[0m"
    }

    private string Grey(string s) {
        if (!this.UseColor) { return s }
        return "\x1b[2;37m" + s + "\x1b[0m"
    }

    public string FormatError(string kind, string message,
                              string filename, int line, int col) {
        let lineStr = String_FromInt(line)
        let colStr  = String_FromInt(col)
        var result  = ""
        result = result + this.Red("error") + "[" + kind + "]: " + message + "\n"
        result = result + "  --> " + filename + ":" + lineStr + ":" + colStr + "\n"
        result = result + " |\n"
        return result
    }

    public string FormatWarning(string kind, string message,
                                string filename, int line, int col) {
        let lineStr = String_FromInt(line)
        let colStr  = String_FromInt(col)
        var result  = ""
        result = result + this.Yellow("warning") + "[" + kind + "]: " + message + "\n"
        result = result + "  --> " + filename + ":" + lineStr + ":" + colStr + "\n"
        result = result + " |\n"
        return result
    }

    public void PrintError(string kind, string message,
                           string filename, int line, int col) {
        let msg = this.FormatError(kind, message, filename, line, col)
        Console.WriteError(msg)
    }

    public void PrintWarning(string kind, string message,
                             string filename, int line, int col) {
        let msg = this.FormatWarning(kind, message, filename, line, col)
        Console.WriteError(msg)
    }

    public void PrintCompileOk(string phase) {
        let label = String_PadRight(phase, 12)
        Console.WriteLine(this.Bold(label) + ": " + this.Cyan("OK"))
    }

    public void PrintCompileError(string phase, string detail) {
        let label = String_PadRight(phase, 12)
        Console.WriteError(this.Bold(label) + ": " + this.Red("ERROR"))
        Console.WriteError(detail)
    }
}
