namespace Amalgame.Compiler

import Amalgame.String

// Diagnostic formatter — produces readable error messages
public class DiagnosticFormatter {
    private UseColor: bool

    public DiagnosticFormatter() {
        this.UseColor = false
    }

    public void EnableColor(bool v) {
        this.UseColor = v
    }

    private string Colored(string code, string s) {
        if (!this.UseColor) { return s }
        return "\x1b[" + code + "m" + s + "\x1b[0m"
    }

    public string FormatError(string kind, string message, string filename, int line, int col) {
        let lineStr = String_FromInt(line)
        let colStr  = String_FromInt(col)
        var result  = "error[" + kind + "]: " + message + "\n"
        result = result + "  --> " + filename + ":" + lineStr + ":" + colStr + "\n"
        result = result + " |\n"
        return result
    }

    public string FormatWarning(string kind, string message, string filename, int line, int col) {
        let lineStr = String_FromInt(line)
        let colStr  = String_FromInt(col)
        var result  = "warning[" + kind + "]: " + message + "\n"
        result = result + "  --> " + filename + ":" + lineStr + ":" + colStr + "\n"
        result = result + " |\n"
        return result
    }

    public void PrintCompileOk(string phase) {
        Console.WriteLine(phase + " OK")
    }

    public void PrintCompileError(string phase, string detail) {
        Console.WriteError(phase + " ERROR")
        Console.WriteError(detail)
    }
}
