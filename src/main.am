    // ── test subcommand ────────────────────────────────
    // Discovers *_test.am under <dir> (default `.`), compiles each
    // with the running amc binary + gcc, runs the result, and parses
    // its stdout for `[PASS] <name>`, `[FAIL] <name>: <msg>`, and
    // `[SKIP] <name>` lines. The runner expects to be invoked from
    // a directory with a sibling `runtime/` so gcc can find the
    // headers — true for the Amalgame repo itself; downstream users
    // will need a richer install story (--runtime, AMC_RUNTIME env
    // var) which is left for a follow-up.
    public static int RunTest(int argc) {
        var dir = "."
        var i = 2
        while (i < argc) {
            let a = Args_Get(i)
            if (String_StartsWith(a, "-")) {
                Console.WriteError("amc test: unknown option '" + a + "'")
                return 1
            }
            dir = a
            i = i + 1
        }

        // v0.5.1: auto-install missing deps before running tests.
        // amalgame.lock-declared packages that aren't in the cache
        // get re-cloned here, so `git clone <repo> && amc test`
        // works in one step. No-op when there's no lock file or
        // every dep is already present.
        let installed: int = AddCommand.EnsureInstalled()
        if (installed < 0) {
            Console.WriteError("amc test: package install failed; aborting")
            return 1
        }
        if (installed > 0) {
            Console.WriteLine("amc test: installed " + String_FromInt(installed) + " missing dep(s)")
        }

        // v0.5.2: resolve amc's runtime/ once + pre-compile each
        // installed package's vendored .c sources to .o files
        // cached in /tmp. The .o files get linked into every test
        // binary so SQLite (and any future vendoring backend)
        // links cleanly without the user doing gcc by hand.
        // Resolve amc's canonical path via /proc/self/exe (Linux) /
        // GetModuleFileNameA (Windows) so runtime/ discovery works
        // when amc is invoked via PATH — argv[0] is then just "amc"
        // and the dirname() fallback collapses. Same fix as BuildEntry.
        var amcPathForRt: string = Program.ResolveSelfPath()
        if (String_Length(amcPathForRt) == 0) {
            amcPathForRt = Args_Get(0)
        }
        let amcRuntime: string = Program.ResolveRuntimeDir(amcPathForRt)
        let registry = PackageRegistry.Load()
        let pkgObjs: List<string> = Program.PreCompilePackageSources(registry, amcRuntime)
        let hasCxx: bool = registry.HasCxxSources()
        let pkgLibs: List<string> = registry.CollectLibs()
        // Project F follow-up: per-package facade archives
        // (libamalgame-pkg-<class>.a) live alongside the precompiled
        // .o files at <pkgDir>/build/<platform>/. Auto-link each one
        // so user tests resolve the AM facade symbols without
        // bundling the facade source on every compile.
        let facadeArs: List<string> = registry.CollectFacadeArchives()

        // Discovery: shell out to `find`. Works on POSIX and on
        // Windows MSYS2 (the only Windows path the repo CI exercises).
        let findCmd = "find " + dir + " -name '*_test.am' -type f"
        let discovered = Process.RunCapture(findCmd)
        if (discovered.Exit != 0) {
            Console.WriteError("amc test: failed to enumerate tests in " + dir)
            Console.WriteError(discovered.Stdout)
            return 1
        }
        let lines: List<string> = String_Split(String_Trim(discovered.Stdout), "\n")
        let nLines = lines.Count()
        if (nLines == 0) {
            Console.WriteLine("No *_test.am files found under " + dir)
            return 0
        }
        // String_Split on "" returns a single empty entry; treat
        // that as "no files" too.
        if (nLines == 1) {
            let only = String_Trim(lines.Get(0))
            if (String_Length(only) == 0) {
                Console.WriteLine("No *_test.am files found under " + dir)
                return 0
            }
        }

        var amcPath: string = Program.ResolveSelfPath()
        if (String_Length(amcPath) == 0) {
            amcPath = Args_Get(0)
        }
        var pass        = 0
        var fail        = 0
        var skip        = 0
        var compileFail = 0

        for li in 0..nLines {
            let path = String_Trim(lines.Get(li))
            if (String_Length(path) == 0) { continue }
            Console.WriteLine("── " + path)

            // Step 1 — amc <test>.am -o <tmp>  → produces <tmp>.c
            let outBin = "/tmp/amc_test_" + String_FromInt(li)
            let outC   = outBin + ".c"
            let amcCmd = amcPath + " " + path + " -o " + outBin + " --quiet"
            let cr = Process.RunCapture(amcCmd)
            if (cr.Exit != 0) {
                Console.WriteLine("  [COMPILE-FAIL]")
                Console.Write(cr.Stdout)
                compileFail = compileFail + 1
                continue
            }
            // Step 2 — compile + link the emitted .c. Locate amc's
            // runtime/ headers so this works in any cwd (not just
            // the Amalgame source tree). amcRuntime resolved once
            // before the test loop (see above).
            //
            // Two-stage when any installed package ships C++:
            //  (a) gcc -c <test>.c -o <test>.o  — compile as C, since
            //      amc emits C-style void* conversions and string-
            //      literal-to-char* casts that g++ rejects.
            //  (b) g++ <test>.o pkg_objs... — link as C++ so libstdc++
            //      + C++ static-init order resolve correctly. A plain
            //      `gcc -lstdc++` link skips C++ init that some
            //      amalgamations (DuckDB) need.
            // Otherwise a single-step gcc link is the v0.5.2 path.
            var gccCmd: string = ""
            if (hasCxx) {
                // Stage (a): gcc -c to .o
                var compileCmd: string = "gcc -O2 -Wno-unused-variable -Wno-unused-parameter -Wno-unused-but-set-variable -Iruntime"
                if (String_Length(amcRuntime) > 0) {
                    compileCmd = compileCmd + " -I'" + amcRuntime + "'"
                }
                let objOut: string = outBin + ".o"
                compileCmd = compileCmd + " -c " + outC + " -o " + objOut + " 2>&1"
                let stageA = Process.RunCapture(compileCmd)
                if (stageA.Exit != 0) {
                    Console.WriteLine("  [LINK-FAIL]")
                    Console.Write(stageA.Stdout)
                    compileFail = compileFail + 1
                    continue
                }
                // Stage (b): g++ link
                gccCmd = "g++ -O2 " + objOut
            } else {
                gccCmd = "gcc -O2 -Wno-unused-variable -Wno-unused-parameter -Wno-unused-but-set-variable -Iruntime"
                if (String_Length(amcRuntime) > 0) {
                    gccCmd = gccCmd + " -I'" + amcRuntime + "'"
                }
                gccCmd = gccCmd + " " + outC
            }
            let nObjs: int = pkgObjs.Count()
            for poi in 0..nObjs {
                gccCmd = gccCmd + " '" + pkgObjs.Get(poi) + "'"
            }
            // Splice per-package facade archives. Each ar archive
            // contributes one .o whose symbols satisfy the forward
            // decls the cgen emitted (because the facade was
            // auto-registered as `--external` — see
            // AmalgameCompiler.Run).
            let nFAr: int = facadeArs.Count()
            for fai in 0..nFAr {
                gccCmd = gccCmd + " '" + facadeArs.Get(fai) + "'"
            }
            gccCmd = gccCmd + " -lgc -lm -lcurl -lz -ldl -lpthread"
            // Splice per-package libs (-l<name>). Each loaded
            // package contributes zero or more bare names via
            // its manifest's [stdlib].libs array.
            let nLibs: int = pkgLibs.Count()
            for plj in 0..nLibs {
                gccCmd = gccCmd + " -l" + pkgLibs.Get(plj)
            }
            gccCmd = gccCmd + " -o " + outBin + " 2>&1"
            let gcc = Process.RunCapture(gccCmd)
            if (gcc.Exit != 0) {
                Console.WriteLine("  [LINK-FAIL]")
                Console.Write(gcc.Stdout)
                compileFail = compileFail + 1
                continue
            }
            // Step 3 — run and parse stdout for tag lines. Anything
            // not matching a tag is preserved as test stdout (for
            // debugging), printed indented under the tag lines.
            let rr = Process.RunCapture(outBin)
            let outLines: List<string> = String_Split(rr.Stdout, "\n")
            let on = outLines.Count()
            for ln in 0..on {
                let lineStr = outLines.Get(ln)
                if (String_StartsWith(lineStr, "[PASS]")) {
                    Console.WriteLine("  " + lineStr)
                    pass = pass + 1
                } else if (String_StartsWith(lineStr, "[FAIL]")) {
                    Console.WriteLine("  " + lineStr)
                    fail = fail + 1
                } else if (String_StartsWith(lineStr, "[SKIP]")) {
                    Console.WriteLine("  " + lineStr)
                    skip = skip + 1
                }
            }
            // Surface a non-zero exit even if no tag lines were
            // emitted — covers tests that crash before printing.
            if (rr.Exit != 0 && pass == 0 && fail == 0 && skip == 0) {
                Console.WriteLine("  [FAIL] <crash> exit=" + String_FromInt(rr.Exit))
                fail = fail + 1
            }
        }

        Console.WriteLine("")
        Console.WriteLine("──────────────────────────────────")
        Console.WriteLine("PASS: " + String_FromInt(pass) + "  FAIL: " + String_FromInt(fail) + "  SKIP: " + String_FromInt(skip))
        if (compileFail > 0) {
            Console.WriteLine("COMPILE-FAIL: " + String_FromInt(compileFail))
            return 1
        }
        if (fail > 0) { return 1 }
        return 0
    }

    // Pre-compile every installed package's vendored source(s)
    // to .o files. Each test binary then links the resulting .o
    // list, so packages with vendored deps (SQLite C, DuckDB C++)
    // compile cleanly via `amc test`.
    //
    // Cache lookup order (since v0.5.4):
    //   1. `<pkg-dir>/build/<platform>/<class>-<basename>.o`
    //      — persistent, written by `amc package add` when the
    //      manifest declares `[stdlib].precompile = true`. Survives
    //      reboots, shared across all `amc test` invocations.
    //   2. `/tmp/amc-pkg-<class>-<basename>.o`
    //      — volatile, written here on the lazy path when (1) misses.
    //      Wiped on reboot but cheap to rebuild.
    //   3. Compile fresh.
    //
    // Compiler dispatch: gcc for .c (+ p.CFlags), g++ for
    // .cpp/.cc/.cxx (+ p.CxxFlags). Same dispatch as
    // AddCommand.PrecompilePackage so the two paths stay coherent.
    public static List<string> PreCompilePackageSources(PackageRegistry reg, string amcRuntime) {
        let out: List<string> = new List<string>()
        let n: int = reg.Packages.Count()
        for i in 0..n {
            let p: LoadedPackage = reg.Packages.Get(i)
            // Both the facade (single AM file) and [stdlib].sources
            // (a list) need to land in the package's combined .o.
            // Splitting them here so the AM pipeline below sees one
            // unified list — the precompile output is per-package,
            // not per-source.
            let sources: List<string> = new List<string>()
            if (String_Length(p.Facade) > 0) {
                sources.Add(p.Facade)
            }
            let extraSrc: int = p.Sources.Count()
            for esi in 0..extraSrc {
                sources.Add(p.Sources.Get(esi))
            }
            let sn: int = sources.Count()
            if (sn == 0) { continue }
            // Compute the persistent precompile cache dir for this
            // package (only used if .o is present there; not
            // created here).
            let persistentDir: string = PackageRegistry.PrecompileCacheDir(p.PkgDir)

            // Split sources into AM vs C/C++.  AM sources all compile
            // together via a single `amc --lib` invocation (cross-file
            // refs like Cookie ↔ HttpResponse need their siblings in
            // scope).  Native sources still compile one-per-file since
            // each is independent.
            let amSources: List<string> = new List<string>()
            let nativeSources: List<string> = new List<string>()
            for j in 0..sn {
                let sp: string = sources.Get(j)
                if (String_Length(sp) == 0) { continue }
                if (String_EndsWith(sp, ".am")) {
                    amSources.Add(sp)
                } else {
                    nativeSources.Add(sp)
                }
            }

            // ── AM path: single combined .o per package ───
            if (amSources.Count() > 0) {
                let amObj: string = "/tmp/amc-pkg-" + p.ClassName + ".o"
                let amCacheObj: string = persistentDir + "/" + p.ClassName + ".o"
                var skipAm: bool = false
                if (File.Exists(amCacheObj)) {
                    out.Add(amCacheObj); skipAm = true
                } else if (File.Exists(amObj)) {
                    out.Add(amObj); skipAm = true
                }
                if (!skipAm) {
                    let amCsrc: string = amObj + ".c"
                    let amcSelf: string = Program.ResolveSelfPath()
                    var amcCmd: string = "'" + amcSelf + "' --lib --quiet -o '" + amObj + "'"
                    let amCount: int = amSources.Count()
                    for ai in 0..amCount {
                        amcCmd = amcCmd + " '" + amSources.Get(ai) + "'"
                    }
                    let amcRes = Process.RunCapture(amcCmd)
                    if (amcRes.Exit != 0) {
                        Console.WriteError("amc precompile: amc --lib failed for " + p.ClassName)
                        Console.WriteError(amcRes.Stdout)
                    } else {
                        var cmd: string = "gcc -O2"
                        if (String_Length(amcRuntime) > 0) {
                            cmd = cmd + " -I'" + amcRuntime + "'"
                        }
                        // The package's own runtime/ dir hosts the C
                        // header named in [stdlib].header — every
                        // include line in the generated .c references
                        // it by basename, so missing the -I produces
                        // the classic "Amalgame_X.h not found" fatal
                        // error at the precompile gcc step.
                        let pkgRuntime: string = p.PkgDir + "/runtime"
                        cmd = cmd + " -I'" + pkgRuntime + "' -I'" + p.PkgDir + "'"
                        if (String_Length(p.CFlags) > 0) {
                            cmd = cmd + " " + p.CFlags
                        }
                        cmd = cmd + " -w -c '" + amCsrc + "' -o '" + amObj + "'"
                        let gccRes = Process.RunCapture(cmd)
                        if (gccRes.Exit != 0) {
                            Console.WriteError("amc precompile: gcc failed for " + p.ClassName)
                            Console.WriteError(gccRes.Stdout)
                        } else {
                            Console.WriteLine("Pre-compiled " + p.ClassName + " (" + String_FromInt(amCount) + " AM sources)")
                            out.Add(amObj)
                        }
                    }
                }
            }

            // ── Native path: one .o per .c/.cpp source ─────
            let nn: int = nativeSources.Count()
            for j in 0..nn {
                let srcPath: string = nativeSources.Get(j)
                let lastSlash: int = String_LastIndexOf(srcPath, "/")
                var srcLeaf: string = srcPath
                if (lastSlash >= 0) {
                    srcLeaf = String_Substring(srcPath, lastSlash + 1, String_Length(srcPath) - lastSlash - 1)
                }
                let persistentObj: string = persistentDir + "/" + p.ClassName + "-" + srcLeaf + ".o"
                if (File.Exists(persistentObj)) {
                    out.Add(persistentObj)
                    continue
                }
                let objPath: string = "/tmp/amc-pkg-" + p.ClassName + "-" + srcLeaf + ".o"
                if (File.Exists(objPath)) {
                    out.Add(objPath)
                    continue
                }
                let isCxx: bool = PackageRegistry.IsCxxSource(srcPath)
                var cmd: string = ""
                if (isCxx) {
                    cmd = "g++ -O2"
                } else {
                    cmd = "gcc -O2"
                }
                if (String_Length(amcRuntime) > 0) {
                    cmd = cmd + " -I'" + amcRuntime + "'"
                }
                if (isCxx && String_Length(p.CxxFlags) > 0) {
                    cmd = cmd + " " + p.CxxFlags
                }
                if (!isCxx && String_Length(p.CFlags) > 0) {
                    cmd = cmd + " " + p.CFlags
                }
                cmd = cmd + " -w -c '" + srcPath + "' -o '" + objPath + "'"
                let res = Process.RunCapture(cmd)
                if (res.Exit != 0) {
                    Console.WriteError("amc test: failed to pre-compile " + srcPath)
                    Console.WriteError(res.Stdout)
                    continue
                }
                Console.WriteLine("Pre-compiled " + p.ClassName + " source: " + srcLeaf)
                out.Add(objPath)
            }
        }
        return out
    }


    // ── build / run / watch (v0.7.9+) ───────────────────
    //
    // `amc build <entry.am>` is the first-class compile verb.
    // Under the hood it shares the gcc-link logic that `amc test`
    // already uses, plus an explicit link against `lib/libamalgame.a`
    // when it's shipped alongside amc — so packages that reference
    // bundled-stdlib classes (Json / Toml) resolve at link time
    // without the user knowing the magic.
    //
    // The bare-args form `amc -o out file.am` still works (no
    // gcc step, .c emission only) — keeping the surface for the
    // edge cases where users want to splice their own gcc command
    // (CI cross-compile, custom flags).
    //
    // Returns 0 on success, non-zero on amc-compile / gcc-link
    // failure. Errors are printed to stderr inline.

    // Scan a failed-amc stdout for `Unknown symbol 'X'` diagnostics
    // and shell out to `amc package suggest --json X` to print a
    // friendly hint section below the raw error dump. Mirrors the
    // LSP-side `CollectPackageInstallSuggestions` codepath — same
    // schema, same safety stance (display-only, never auto-install).
    //
    // Silent (no extra output) when the index isn't reachable or
    // no symbol matches a known package.
    public static void PrintPackageSuggestionsForOutput(string output, string amcPath) {
        let lines: List<string> = String_Split(output, "\n")
        let n: int = lines.Count()
        let prefix: string = "Unknown symbol '"
        let prefLen: int = String_Length(prefix)
        let seen: List<string> = new List<string>()
        var headerPrinted: bool = false
        var cmd: string = "amc"
        if (String_Length(amcPath) > 0) { cmd = amcPath }
        for li in 0..n {
            let line: string = lines.Get(li)
            let idx: int = String_IndexOf(line, prefix)
            if (idx < 0) { continue }
            let restLen: int = String_Length(line) - idx - prefLen
            if (restLen <= 0) { continue }
            let rest: string = String_Substring(line, idx + prefLen, restLen)
            let endQuote: int = String_IndexOf(rest, "'")
            if (endQuote <= 0) { continue }
            let symName: string = String_Substring(rest, 0, endQuote)
            if (symName == "_" || symName == "_unknown_") { continue }
            // Dedupe — same symbol can fire multiple errors.
            let ns: int = seen.Count()
            var dup: bool = false
            for si in 0..ns {
                if (seen.Get(si) == symName) { dup = true }
            }
            if (dup) { continue }
            seen.Add(symName)
            let result = Process.RunCapture(cmd + " package suggest --json " + symName)
            if (result.Exit != 0) { continue }
            let trimmed: string = String_Trim(result.Stdout)
            if (String_Length(trimmed) == 0 || trimmed == "[]") { continue }
            let parsed: JsonResult = Json.Parse(trimmed)
            if (!parsed.Ok) { continue }
            let doc: JsonValue = parsed.Value
            if (doc.IsNull() || !doc.IsArray()) { continue }
            let arr: List<JsonValue> = doc.AsArray()
            let nr: int = arr.Count()
            if (nr == 0) { continue }
            if (!headerPrinted) {
                Console.WriteLine("")
                Console.WriteLine("hint: unresolved symbols match curated packages — install via:")
                headerPrinted = true
            }
            Console.WriteLine("  '" + symName + "':")
            for ri in 0..nr {
                let entry: JsonValue = arr.Get(ri)
                let pn: string = entry.Get("name").AsString()
                let pt: string = entry.Get("latest_compatible_tag").AsString()
                var hintLine: string = "    amc package add " + pn
                if (String_Length(pt) > 0) { hintLine = hintLine + "@" + pt }
                Console.WriteLine(hintLine)
            }
        }
    }

    public static int BuildOneBinary(
        string amcPath,
        string entryAm,
        string outBin,
        string amcRuntime,
        string libamalgameA,
        List<string> pkgObjs,
        List<string> facadeArs,
        List<string> pkgLibs,
        bool hasCxx,
        bool verbose,
        bool debug
    ) {
        let outC: string = outBin + ".c"
        var quietFlag: string = " --quiet"
        if (verbose) { quietFlag = " --verbose" }
        let amcCmd: string = amcPath + " " + entryAm + " -o " + outBin + quietFlag
        let cr = Process.RunCapture(amcCmd)
        if (cr.Exit != 0) {
            Console.WriteError("  [COMPILE-FAIL] amc exited " + String_FromInt(cr.Exit))
            Console.Write(cr.Stdout)
            Program.PrintPackageSuggestionsForOutput(cr.Stdout, amcPath)
            return 1
        }
        if (verbose) {
            Console.WriteLine("  amc → " + outC)
        }

        // v0.8.0+: --debug swaps -O2 for -O0 -g so gcc emits DWARF
        // line tables + frame info; the `amc dap` adapter needs that
        // to map breakpoints on .am files (via the #line directives
        // amc already emits in the .c) to runtime addresses.
        var optFlag: string = "-O2"
        if (debug) { optFlag = "-O0 -g" }
        var gccCmd: string = ""
        if (hasCxx) {
            // C++ package present (DuckDB etc.) — two-stage link.
            // Stage A: gcc -c on the cgen-emitted .c. amc emits C-style
            // void* casts and string-literal-to-char* coercions that
            // g++ rejects with -fpermissive warnings as errors, so
            // we compile as C first.
            var compileCmd: string = "gcc " + optFlag + " -Wno-unused-variable -Wno-unused-parameter -Wno-unused-but-set-variable -Iruntime"
            if (String_Length(amcRuntime) > 0) {
                compileCmd = compileCmd + " -I'" + amcRuntime + "'"
            }
            let objOut: string = outBin + ".o"
            compileCmd = compileCmd + " -c " + outC + " -o " + objOut + " 2>&1"
            let stageA = Process.RunCapture(compileCmd)
            if (stageA.Exit != 0) {
                Console.WriteError("  [LINK-FAIL] gcc -c exited " + String_FromInt(stageA.Exit))
                Console.Write(stageA.Stdout)
                return 1
            }
            gccCmd = "g++ " + optFlag + " " + objOut
        } else {
            gccCmd = "gcc " + optFlag + " -Wno-unused-variable -Wno-unused-parameter -Wno-unused-but-set-variable -Iruntime"
            if (String_Length(amcRuntime) > 0) {
                gccCmd = gccCmd + " -I'" + amcRuntime + "'"
            }
            gccCmd = gccCmd + " " + outC
        }
        // Per-package vendored .o (SQLite, DuckDB).
        let nObjs: int = pkgObjs.Count()
        for poi in 0..nObjs {
            gccCmd = gccCmd + " '" + pkgObjs.Get(poi) + "'"
        }
        // Per-package facade archives (libamalgame-pkg-<class>.a).
        let nFAr: int = facadeArs.Count()
        for fai in 0..nFAr {
            gccCmd = gccCmd + " '" + facadeArs.Get(fai) + "'"
        }
        // Bundled stdlib archive — only link when it's actually
        // shipped alongside amc (source-tree build OR installed
        // release). Skip silently when missing so the build path
        // stays usable in minimal /usr/local/bin-only setups, but
        // future packages that reference Json / Toml symbols may
        // fail to link without it.
        if (String_Length(libamalgameA) > 0) {
            gccCmd = gccCmd + " '" + libamalgameA + "'"
        }
        gccCmd = gccCmd + " -lgc -lm -lcurl -lz -ldl -lpthread"
        let nLibs: int = pkgLibs.Count()
        for plj in 0..nLibs {
            gccCmd = gccCmd + " -l" + pkgLibs.Get(plj)
        }
        gccCmd = gccCmd + " -o " + outBin + " 2>&1"
        if (verbose) {
            Console.WriteLine("  gcc: " + gccCmd)
        }
        let gcc = Process.RunCapture(gccCmd)
        if (gcc.Exit != 0) {
            Console.WriteError("  [LINK-FAIL] gcc exited " + String_FromInt(gcc.Exit))
            Console.Write(gcc.Stdout)
            return 1
        }
        return 0
    }

    // BuildEntry — full pipeline for a single entry .am. Resolves
    // amc's runtime/ dir, loads the package registry, pre-compiles
    // vendored package sources, then delegates to BuildOneBinary.
    // Returns the exit code from BuildOneBinary; the caller decides
    // whether to chain a subsequent `Process.Run` (amc run).
    public static int BuildEntry(string entryAm, string outBin, bool verbose, bool debug) {
        if (!File.Exists(entryAm)) {
            Console.WriteError("amc build: entry file not found: " + entryAm)
            return 2
        }

        // v0.5.1: auto-install lock-listed packages missing from the
        // cache. Same behaviour as `amc test`.
        let installed: int = AddCommand.EnsureInstalled()
        if (installed < 0) {
            Console.WriteError("amc build: package install failed; aborting")
            return 1
        }
        if (installed > 0 && verbose) {
            Console.WriteLine("amc build: installed " + String_FromInt(installed) + " missing dep(s)")
        }

        // Resolve amc's own absolute path. Args_Get(0) carries whatever
        // the shell put in argv[0] — when amc is launched via PATH that's
        // the bare name "amc", which makes the dirname() lookup below
        // collapse to nothing. /proc/self/exe is the kernel-resolved
        // canonical path on Linux and (some) BSDs; macOS/Windows fall
        // through to Args_Get(0) until the equivalent is wired.
        var amcPath: string = Program.ResolveSelfPath()
        if (String_Length(amcPath) == 0) {
            amcPath = Args_Get(0)
        }
        let amcRuntime: string = Program.ResolveRuntimeDir(amcPath)
        let libamalgameA: string = Program.ResolveLibAmalgameA(amcPath)

        let registry = PackageRegistry.Load()
        let pkgObjs: List<string> = Program.PreCompilePackageSources(registry, amcRuntime)
        let hasCxx: bool = registry.HasCxxSources()
        let pkgLibs: List<string> = registry.CollectLibs()
        let facadeArs: List<string> = registry.CollectFacadeArchives()

        let rc: int = Program.BuildOneBinary(
            amcPath, entryAm, outBin, amcRuntime, libamalgameA,
            pkgObjs, facadeArs, pkgLibs, hasCxx, verbose, debug
        )
        return rc
    }

    // ── build subcommand (v0.7.9+) ──────────────────────
    //
    // `amc build [-o <out>] [--verbose] <entry.am>` — Cargo-style
    // compile verb. Default output is the entry file's stem
    // (`foo.am` → `./foo`). Builds against the full package +
    // bundled-stdlib link chain, so the resulting binary runs
    // standalone without an external gcc invocation.
    public static int RunBuild(int argc) {
        var entryAm: string = ""
        var outBin: string = ""
        var verbose: bool = false
        var debug: bool = false
        var i: int = 2
        while (i < argc) {
            let a: string = Args_Get(i)
            if (a == "-h" || a == "--help") {
                Console.WriteError("Usage: amc build [-o <out>] [-g|--debug] [--verbose] <entry.am>")
                Console.WriteError("")
                Console.WriteError("Compile + link a runnable binary in one step.")
                Console.WriteError("Equivalent to `amc -o out entry.am` plus the gcc invocation")
                Console.WriteError("(runtime headers, libamalgame.a, installed packages, libs).")
                Console.WriteError("")
                Console.WriteError("  -g, --debug    swap -O2 for -O0 -g (DWARF for amc dap)")
                return 0
            }
            if (a == "-o" && i + 1 < argc) {
                outBin = Args_Get(i + 1)
                i = i + 2
            } else if (a == "-v" || a == "--verbose") {
                verbose = true
                i = i + 1
            } else if (a == "-g" || a == "--debug") {
                debug = true
                i = i + 1
            } else if (String_StartsWith(a, "-")) {
                Console.WriteError("amc build: unknown option '" + a + "'")
                return 1
            } else {
                if (String_Length(entryAm) > 0) {
                    Console.WriteError("amc build: only one entry .am file is supported; got '" + entryAm + "' and '" + a + "'")
                    return 1
                }
                entryAm = a
                i = i + 1
            }
        }
        if (String_Length(entryAm) == 0) {
            Console.WriteError("amc build: missing entry .am argument")
            Console.WriteError("Usage: amc build [-o <out>] [-g|--debug] [--verbose] <entry.am>")
            return 2
        }
        // Default output: strip directory + ".am" suffix from entry.
        if (String_Length(outBin) == 0) {
            outBin = entryAm
            let lastSlash: int = String_LastIndexOf(outBin, "/")
            if (lastSlash >= 0) {
                outBin = String_Substring(outBin, lastSlash + 1, String_Length(outBin) - lastSlash - 1)
            }
            if (String_EndsWith(outBin, ".am")) {
                outBin = String_Substring(outBin, 0, String_Length(outBin) - 3)
            }
            outBin = "./" + outBin
        }
        let rc: int = Program.BuildEntry(entryAm, outBin, verbose, debug)
        if (rc == 0) {
            Console.WriteLine("✓ Built " + outBin)
        }
        return rc
    }

    // ── run subcommand (v0.7.9+) ────────────────────────
    //
    // `amc run [-o <out>] [--verbose] <entry.am> [-- args...]` —
    // build the binary, then exec it. Args after the `--` sentinel
    // are forwarded to the user binary's argv; everything before
    // configures the build itself.
    public static int RunRun(int argc) {
        var entryAm: string = ""
        var outBin: string = ""
        var verbose: bool = false
        var debug: bool = false
        let userArgs: List<string> = new List<string>()
        var sawSep: bool = false
        var i: int = 2
        while (i < argc) {
            let a: string = Args_Get(i)
            if (sawSep) {
                userArgs.Add(a)
                i = i + 1
                continue
            }
            if (a == "-h" || a == "--help") {
                Console.WriteError("Usage: amc run [-o <out>] [-g|--debug] [--verbose] <entry.am> [-- args...]")
                Console.WriteError("")
                Console.WriteError("Build the binary, then run it. Args after the `--` sentinel")
                Console.WriteError("are forwarded to the resulting program's argv.")
                return 0
            }
            if (a == "--") {
                sawSep = true
                i = i + 1
            } else if (a == "-o" && i + 1 < argc) {
                outBin = Args_Get(i + 1)
                i = i + 2
            } else if (a == "-v" || a == "--verbose") {
                verbose = true
                i = i + 1
            } else if (a == "-g" || a == "--debug") {
                debug = true
                i = i + 1
            } else if (String_StartsWith(a, "-")) {
                Console.WriteError("amc run: unknown option '" + a + "'")
                return 1
            } else {
                if (String_Length(entryAm) > 0) {
                    Console.WriteError("amc run: only one entry .am file is supported; got '" + entryAm + "' and '" + a + "'")
                    return 1
                }
                entryAm = a
                i = i + 1
            }
        }
        if (String_Length(entryAm) == 0) {
            Console.WriteError("amc run: missing entry .am argument")
            Console.WriteError("Usage: amc run [-o <out>] [--verbose] <entry.am> [-- args...]")
            return 2
        }
        if (String_Length(outBin) == 0) {
            outBin = entryAm
            let lastSlash: int = String_LastIndexOf(outBin, "/")
            if (lastSlash >= 0) {
                outBin = String_Substring(outBin, lastSlash + 1, String_Length(outBin) - lastSlash - 1)
            }
            if (String_EndsWith(outBin, ".am")) {
                outBin = String_Substring(outBin, 0, String_Length(outBin) - 3)
            }
            outBin = "./" + outBin
        }
        let buildRc: int = Program.BuildEntry(entryAm, outBin, verbose, debug)
        if (buildRc != 0) {
            return buildRc
        }
        // Assemble the run command. User args are passed through.
        var runCmd: string = outBin
        let na: int = userArgs.Count()
        for ai in 0..na {
            let ua: string = userArgs.Get(ai)
            // Naive single-quote escape: every arg gets its own
            // pair of single quotes. Doesn't handle embedded
            // single quotes; consumers needing that should script
            // around amc run directly.
            runCmd = runCmd + " '" + ua + "'"
        }
        return Process.Run(runCmd)
    }

    // ── watch subcommand (v0.7.9+) ──────────────────────
    //
    // `amc watch [-o <out>] [--run] [--verbose] <entry.am>` —
    // build the binary now, then poll every 500 ms for mtime
    // changes on the entry file (v1 only watches the single file
    // explicitly named; transitive imports are deferred to
    // FileWatcher v2). When the file changes, rebuild and
    // (optionally) re-run. Ctrl-C to exit.
    public static int RunWatch(int argc) {
        var entryAm: string = ""
        var outBin: string = ""
        var verbose: bool = false
        var runAfter: bool = false
        var i: int = 2
        while (i < argc) {
            let a: string = Args_Get(i)
            if (a == "-h" || a == "--help") {
                Console.WriteError("Usage: amc watch [-o <out>] [--run] [--verbose] <entry.am>")
                Console.WriteError("")
                Console.WriteError("Build now, then poll <entry.am>'s mtime every 500 ms.")
                Console.WriteError("On change: rebuild (and re-run with --run). Ctrl-C to exit.")
                Console.WriteError("v1 watches only the explicit entry file; transitive imports")
                Console.WriteError("come post-D when the FileWatcher event-loop lands.")
                return 0
            }
            if (a == "-o" && i + 1 < argc) {
                outBin = Args_Get(i + 1)
                i = i + 2
            } else if (a == "-v" || a == "--verbose") {
                verbose = true
                i = i + 1
            } else if (a == "--run") {
                runAfter = true
                i = i + 1
            } else if (String_StartsWith(a, "-")) {
                Console.WriteError("amc watch: unknown option '" + a + "'")
                return 1
            } else {
                if (String_Length(entryAm) > 0) {
                    Console.WriteError("amc watch: only one entry .am file is supported")
                    return 1
                }
                entryAm = a
                i = i + 1
            }
        }
        if (String_Length(entryAm) == 0) {
            Console.WriteError("amc watch: missing entry .am argument")
            return 2
        }
        if (String_Length(outBin) == 0) {
            outBin = entryAm
            let lastSlash: int = String_LastIndexOf(outBin, "/")
            if (lastSlash >= 0) {
                outBin = String_Substring(outBin, lastSlash + 1, String_Length(outBin) - lastSlash - 1)
            }
            if (String_EndsWith(outBin, ".am")) {
                outBin = String_Substring(outBin, 0, String_Length(outBin) - 3)
            }
            outBin = "./" + outBin
        }

        Console.WriteLine("amc watch: " + entryAm + " → " + outBin)
        let _rc1: int = Program.BuildAndMaybeRun(entryAm, outBin, verbose, runAfter)
        var lastMtime: int = Program.FileMtimeNs(entryAm)
        Console.WriteLine("  (watching for changes, Ctrl-C to exit)")
        while (true) {
            Program.SleepMs(500)
            let cur: int = Program.FileMtimeNs(entryAm)
            if (cur != lastMtime && cur > 0) {
                lastMtime = cur
                Console.WriteLine("")
                Console.WriteLine("── change detected, rebuilding")
                let _rc2: int = Program.BuildAndMaybeRun(entryAm, outBin, verbose, runAfter)
            }
        }
        return 0
    }

    private static int BuildAndMaybeRun(string entryAm, string outBin, bool verbose, bool runAfter) {
        let rc: int = Program.BuildEntry(entryAm, outBin, verbose, false)
        if (rc != 0) { return rc }
        Console.WriteLine("✓ Built " + outBin)
        if (runAfter) {
            Console.WriteLine("── running")
            return Process.Run(outBin)
        }
        return 0
    }

    // mtime in nanoseconds, 0 on stat failure (missing file). Used
    // by watch to detect changes without dragging in the full
    // FileWatcher facade (which is now an external package).
    private static int FileMtimeNs(string path) {
        @c {
        #ifdef _WIN32
            struct _stat64 st;
            if (_stat64(path, &st) != 0) return 0;
            return (i64)((int64_t) st.st_mtime * 1000000000LL);
        #else
            struct stat st;
            if (stat(path, &st) != 0) return 0;
            #ifdef __APPLE__
                return (i64)((int64_t) st.st_mtimespec.tv_sec * 1000000000LL + (int64_t) st.st_mtimespec.tv_nsec);
            #else
                return (i64)((int64_t) st.st_mtim.tv_sec * 1000000000LL + (int64_t) st.st_mtim.tv_nsec);
            #endif
        #endif
        }
    }

    private static void SleepMs(int ms) {
        @c {
        #ifdef _WIN32
            Sleep((DWORD) ms);
        #else
            struct timespec ts;
            ts.tv_sec  = (time_t)(ms / 1000);
            ts.tv_nsec = (long)((ms % 1000) * 1000000L);
            nanosleep(&ts, NULL);
        #endif
        }
    }

    // ── fmt subcommand ─────────────────────────────────
    public static int RunFmt(int argc) {
        let ap = new ArgParser()
        ap.Flag("-w").Flag("--write").Flag("-h").Flag("--help").Parse(argc, 2)
        if (ap.HelpRequested()) {
            Console.WriteError("Usage: amc fmt [-w|--write] <file.am>...")
            Console.WriteError("")
            Console.WriteError("Re-emit canonical formatting of Amalgame source files.")
            Console.WriteError("Default: print to stdout. With -w, rewrite each file in place.")
            return 0
        }
        if (String_Length(ap.GetUnknown()) > 0) {
            Console.WriteError("amc fmt: unknown argument '" + ap.GetUnknown() + "'")
            return 1
        }
        let write: bool = ap.HasFlag("-w") || ap.HasFlag("--write")
        let files = ap.GetPositionals()
        let fn: int = files.Count()
        for j in 0..fn {
            let f: string = files.Get(j)
            if (!String_EndsWith(f, ".am")) {
                Console.WriteError("amc fmt: unknown argument '" + f + "'")
                return 1
            }
        }
        if (files.Count() == 0) {
            Console.WriteError("amc fmt: no input .am files")
            return 1
        }
        let n = files.Count()
        for j in 0..n {
            let path = files.Get(j)
            let src  = File.ReadAll(path)
            let lex  = new Lexer(src, path)
            let toks = lex.Tokenize()
            let par  = new Parser(toks)
            let prog = par.Parse()
            if (par.HasErrors()) {
                Console.WriteError("amc fmt: parse errors in " + path)
                Console.WriteError(par.GetErrors())
                return 1
            }
            let fmt = new Formatter(par.Comments)
            let out = fmt.Format(prog)
            if (write) {
                File.WriteAll(path, out)
            } else {
                Console.Write(out)
            }
        }
        return 0
    }

    public static void Main(string[] args) {
        let argc = Args_Count()
        if (argc < 2) {
            Program.PrintUsage()
            Exit_Set(1)
            return
        }
        if (Args_Get(1) == "build") {
            Exit_Set(Program.RunBuild(argc))
            return
        }
        if (Args_Get(1) == "run") {
            Exit_Set(Program.RunRun(argc))
            return
        }
        if (Args_Get(1) == "watch") {
            Exit_Set(Program.RunWatch(argc))
            return
        }
        if (Args_Get(1) == "fmt") {
            Exit_Set(Program.RunFmt(argc))
            return
        }
        if (Args_Get(1) == "test") {
            Exit_Set(Program.RunTest(argc))
            return
        }
        if (Args_Get(1) == "lsp") {
            let server = new LspServer()
            Exit_Set(server.Run())
            return
        }
        if (Args_Get(1) == "dap") {
            let dap = new DapServer()
            Exit_Set(dap.Run())
            return
        }
        if (Args_Get(1) == "migrate") {
            Exit_Set(MigrateCommand.Run(argc))
            return
        }
        if (Args_Get(1) == "generate") {
            Exit_Set(GenerateCommand.Run(argc))
            return
        }
        if (Args_Get(1) == "explain") {
            Exit_Set(ExplainCommand.Run(argc))
            return
        }
        if (Args_Get(1) == "new") {
            Exit_Set(NewCommand.Run(argc))
            return
        }
        // Package-manager commands live under `amc package <X>`
        // (also accepts the short alias `amc pkg <X>`). Centralising
        // every PM verb under one umbrella keeps the top-level
        // command space clear for language ops (compile / fmt /
        // test / lsp / migrate / generate / explain / new) and
        // matches dotnet's / go-mod's grouping convention.
        let v1: string = Args_Get(1)
        if (v1 == "package" || v1 == "pkg") {
            Exit_Set(AddCommand.RunPackage(argc))
            return
        }

        let inputFiles    = new List<string>()
        let externalFiles = new List<string>()
        var outputName    = "a.out"
        var isLib         = false
        var checkOnly     = false
        var lintMode      = false
        var useColor      = false
        var verbose       = true

        var i = 1
        while (i < argc) {
            let a = Args_Get(i)
            if (a == "-o" && i + 1 < argc) {
                i = i + 1
                outputName = Args_Get(i)
            } else if (a == "--external" && i + 1 < argc) {
                // Project F (v0.7.5+): the file is parsed for resolver
                // visibility but its class definitions are NOT emitted in
                // the output .c — they're expected to land at link time
                // from libamalgame.a. Call sites in primary files lower
                // through the file's own namespace mangling rather than
                // the bundle's NsPrefix.
                i = i + 1
                externalFiles.Add(Args_Get(i))
            } else if (a == "--lib") {
                isLib = true
            } else if (a == "--check") {
                checkOnly = true
            } else if (a == "--lint") {
                lintMode = true
            } else if (a == "--color") {
                useColor = true
            } else if (a == "--no-color") {
                useColor = false
            } else if (a == "--quiet") {
                verbose = false
            } else if (a == "--verbose") {
                verbose = true
            } else if (a == "--version") {
                // Build provenance: rev + date are baked at link time
                // by build_amc.sh via -DAMC_GIT_REV / -DAMC_BUILD_DATE.
                // When the defines are missing (someone gcc'd the C
                // snapshot directly), the helpers return "" and we
                // skip the line — never emit a half-rendered banner.
                let rev:  string = BuildInfo.GitRev()
                let date: string = BuildInfo.BuildDate()
                var head:  string = "amc " + PackageRegistry.AmcVersion()
                var prov:  string = ""
                if (String_Length(rev) > 0 && String_Length(date) > 0) {
                    prov = " (commit " + rev + ", built " + date + ")"
                } else if (String_Length(rev) > 0) {
                    prov = " (commit " + rev + ")"
                } else if (String_Length(date) > 0) {
                    prov = " (built " + date + ")"
                }
                Console.WriteLine(head + prov)
                Console.WriteLine("Self-hosted Amalgame compiler.")
                Console.WriteLine("Copyright (c) 2026 Bastien Mouget. License: Apache-2.0.")
                Console.WriteLine("Website:    https://amalgame.me")
                Console.WriteLine("Repository: https://github.com/amalgame-lang/Amalgame")
                Console.WriteLine("Issues:     https://github.com/amalgame-lang/Amalgame/issues")
                Exit_Set(0)
                return
            } else if (a == "--help" || a == "-h") {
                Program.PrintUsage()
                Exit_Set(0)
                return
            } else if (String_EndsWith(a, ".am")) {
                inputFiles.Add(a)
            } else {
                Console.WriteError("amc: unknown option '" + a + "'")
                Program.PrintUsage()
                Exit_Set(1)
                return
            }
            i = i + 1
        }

        if (inputFiles.Count() == 0) {
            Console.WriteError("amc: no input .am files")
            Exit_Set(1)
            return
        }

        let compiler = new AmalgameCompiler()
        compiler.SetLib(isLib)
        compiler.SetCheckOnly(checkOnly)
        compiler.SetLintMode(lintMode)
        compiler.SetColor(useColor)
        compiler.SetVerbose(verbose)
        compiler.SetExternalFiles(externalFiles)
        compiler.Run(inputFiles, outputName)
        Exit_Set(compiler.GetExitCode())
    }
}
