namespace Amalgame.Compiler

import Amalgame.Collections
import Amalgame.IO
import Amalgame.String

// Minimal monotonic-clock timer kept in amc itself. The full
// `Stopwatch` class moved out of the bundled stdlib into the
// `amalgame-datetime` package in v0.7.7; amc still needs a
// stopwatch for its `--verbose` phase timing, so we vendor the
// smallest possible variant here.
@c {
    #include <time.h>
    #include <sys/stat.h>
    #ifndef _WIN32
        #include <unistd.h>
    #endif
    #ifdef _WIN32
        #include <windows.h>
    #endif
    #ifdef __APPLE__
        // macOS-specific: dyld for _NSGetExecutablePath (ResolveSelfPath),
        // stdlib for realpath(). MUST live at file scope — including
        // mach-o/dyld.h inside a function body pulls in OSByteOrder.h
        // whose inline definitions trip clang ("function definition is
        // not allowed here"). gcc is more permissive but the file-scope
        // include is the portable place anyway.
        #include <mach-o/dyld.h>
        #include <stdlib.h>
    #endif
}

public class MonoTimer {
    private startNs: int

    public MonoTimer() {
        this.startNs = MonoTimer.NowNs()
    }

    // Returns a formatted "Xms" / "X.Ys" string for the time
    // since the previous Reset() (or construction). Resets the
    // start so successive calls measure inter-phase deltas.
    public string Reset() {
        let now: int = MonoTimer.NowNs()
        let diff: int = now - this.startNs
        this.startNs = now
        return MonoTimer.Format(diff)
    }

    private static int NowNs() {
        @c {
        #ifdef _WIN32
            LARGE_INTEGER counter, freq;
            QueryPerformanceFrequency(&freq);
            QueryPerformanceCounter(&counter);
            return (i64)((counter.QuadPart * 1000000000LL) / freq.QuadPart);
        #else
            struct timespec ts;
            if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
            return (i64)((int64_t) ts.tv_sec * 1000000000LL + (int64_t) ts.tv_nsec);
        #endif
        }
    }

    private static string Format(nanos: int) {
        if (nanos < 1000) {
            return String_FromInt(nanos) + "ns"
        }
        if (nanos < 1000000) {
            return String_FromInt(nanos / 1000) + "us"
        }
        if (nanos < 1000000000) {
            return String_FromInt(nanos / 1000000) + "ms"
        }
        let s:  int = nanos / 1000000000
        let ms: int = (nanos % 1000000000) / 1000000
        return String_FromInt(s) + "." + MonoTimer.Pad3(ms) + "s"
    }

    private static string Pad3(n: int) {
        if (n < 10)  { return "00" + String_FromInt(n) }
        if (n < 100) { return "0" + String_FromInt(n) }
        return String_FromInt(n)
    }
}

// Bootstrap compiler entry point
public class AmalgameCompiler {
    private Diag:    DiagnosticFormatter
    private IsLib:   bool
    private CheckOnly: bool
    private LintMode: bool
    private Verbose: bool
    private ExitCode: int
    private ExternalFiles: List<string>

    public AmalgameCompiler() {
        this.Diag          = new DiagnosticFormatter()
        this.IsLib         = false
        this.CheckOnly     = false
        this.LintMode      = false
        this.Verbose       = false
        this.ExitCode      = 0
        this.ExternalFiles = new List<string>()
    }

    public void SetLib(bool v)       { this.IsLib     = v }
    public void SetCheckOnly(bool v) { this.CheckOnly = v }
    public void SetLintMode(bool v)  { this.LintMode  = v }
    public void SetVerbose(bool v)   { this.Verbose   = v }
    public void SetColor(bool v)     { this.Diag.EnableColor(v) }
    public void SetExternalFiles(List<string> files) { this.ExternalFiles = files }
    public int  GetExitCode()        { return this.ExitCode }

    // ── Main compile pipeline ─────────────────────────

    public void Run(List<string> inputFiles, string outputName) {
        let inputCount = inputFiles.Count()
        if (inputCount == 0) {
            Console.WriteError("amc: no input .am files")
            this.ExitCode = 1
            return
        }

        if (this.Verbose) {
            Console.WriteLine("Compiling: " + String_FromInt(inputCount) + " file(s)")
        }
        // Phase stopwatch — surfaced via `--verbose` so users
        // building large projects can see where the time goes
        // (parse vs resolve vs typecheck vs cgen). No-op cost
        // when verbose is off — the Reset()/Elapsed() calls
        // amortize to a couple of syscalls.
        let phaseSw = new MonoTimer()

        // ── Detect namespace from first file ──────────
        //
        // We need the namespace prefix before parsing so the
        // self-package-skip loop below and `gen.BeginMulti` can
        // both see it. We walk the source line by line and skip
        // `//` line comments — a previous `String_IndexOf` on the
        // raw source got fooled by comments like
        // `// schema namespace foo bar` and consumed `foo bar` as
        // the namespace name. Block comments `/* … */` aren't
        // skipped here (rare in practice; if they ever cause
        // trouble add a second scan pass).
        let firstPath = inputFiles.Get(0)
        let firstSrc  = File.ReadAll(firstPath)
        var nsPrefix  = "App"
        let nsLines: List<string> = String_Split(firstSrc, "\n")
        let nsLineCount: int = nsLines.Count()
        var nsi = 0
        while (nsi < nsLineCount) {
            let nsLine: string = nsLines.Get(nsi)
            let nsTrim = String_TrimStart(nsLine)
            if (!String_StartsWith(nsTrim, "//")) {
                if (String_StartsWith(nsTrim, "namespace ")) {
                    let nsAfter = String_From(nsTrim, 10)
                    nsPrefix = String_Replace(String_Trim(nsAfter), ".", "_")
                    nsi = nsLineCount
                }
            }
            nsi = nsi + 1
        }

        // ── Load v0.5 package registry ───────────────
        // amalgame.lock in cwd (if present) lists installed
        // external packages. Resolver + CGen each consume the
        // registry to seed globals / isStdlib / return-types /
        // #include emission. Empty lock → no-op everywhere.
        let pkgReg = PackageRegistry.Load()

        // Project F follow-up: any LoadedPackage that declares a
        // `[stdlib].facade = "facade.am"` ships a pure-AM facade
        // that we auto-promote to `--external` so the cgen emits
        // forward decls only — the definitions land at link time
        // from the per-package `libamalgame-pkg-<class>.a` archive
        // (built by `amc package add`, spliced by `amc test`).
        //
        // In `--lib` mode the package whose facade we're compiling
        // would loop forever if added as its own external (forward
        // decls instead of definitions). Pre-v0.8.7 we worked
        // around that by skipping the whole loop under `--lib`,
        // which left cross-package AM deps unresolvable — a facade
        // importing another package's facade got `Unknown symbol`
        // from the resolver. Now we skip ONLY the self-package,
        // identified by matching its registered namespace against
        // the one detected on line 128.
        let pkgCount: int = pkgReg.Packages.Count()
        for pi in 0..pkgCount {
            let lp: LoadedPackage = pkgReg.Packages.Get(pi)
            var isSelf: bool = false
            if (this.IsLib) {
                let lpPrefix: string = String_Replace(lp.Ns, ".", "_")
                if (lpPrefix == nsPrefix) {
                    isSelf = true
                }
            }
            if (isSelf) { continue }
            // v0.8.39: attach both the facade AND every `[stdlib].sources`
            // entry of the package so consumers don't have to enumerate
            // each split file via --external.  Pre-split packages (one
            // file in facade.am, no sources) keep working since the
            // sources loop just runs zero times.
            if (String_Length(lp.Facade) > 0) {
                this.ExternalFiles.Add(lp.Facade)
            }
            let lpSrcCount: int = lp.Sources.Count()
            for si in 0..lpSrcCount {
                let srcPath: string = lp.Sources.Get(si)
                if (String_EndsWith(srcPath, ".am")) {
                    this.ExternalFiles.Add(srcPath)
                }
            }
        }

        // Bug 6 — auto-external the bundled stdlib facades.
        //
        // User code that does `import Amalgame.Formats.Json` and
        // declares a field `Definition: JsonValue` would otherwise see
        // `JsonValue` lowered to `<UserNs>_JsonValue*` because the
        // resolver + cgen have no idea the bundled stdlib lives under
        // `Amalgame.Formats.Json`. Treating json.am / toml.am / etc.
        // as `--external` is exactly what's needed: the resolver
        // registers their public symbols (`Json`, `JsonValue`, …) and
        // RegisterExternalProg seeds ExternalClasses with the file's
        // own namespace mangling — so TypeToC, InferTypeFromExpr and
        // EmitCalleeStr all dispatch to `Amalgame_Formats_Json_JsonValue`
        // automatically.
        //
        // Skip namespaces the user is *defining* (matches the self-skip
        // rule above for installed-package facades) and any file already
        // queued as an input or external (avoids duplicate typedef).
        let amcPathForStdlib: string = Program.ResolveSelfPath()
        let stdlibDir: string = Program.ResolveStdlibSrcDir(amcPathForStdlib)
        if (String_Length(stdlibDir) > 0) {
            // Each entry: "<namespace>|<filename>" — kept as a flat list
            // because the bootstrap lacks Map<string,string>.
            //
            // Both the canonical 4-part `Amalgame.Formats.X` namespace
            // AND the legacy 3-part `Amalgame.X` shorthand are listed
            // — `import` in Amalgame is informational (the resolver
            // doesn't actually use it for name resolution), so users
            // and older facades freely use either form. The auto-attach
            // scanner accepts both; either spelling resolves to the
            // same on-disk .am facade.
            let stdlibEntries: List<string> = new List<string>()
            stdlibEntries.Add("Amalgame.Path|path.am")
            stdlibEntries.Add("Amalgame.Formats.Json|json.am")
            stdlibEntries.Add("Amalgame.Json|json.am")
            stdlibEntries.Add("Amalgame.Formats.Toml|toml.am")
            stdlibEntries.Add("Amalgame.Toml|toml.am")
            stdlibEntries.Add("Amalgame.Formats.MsgPack|msgpack.am")
            stdlibEntries.Add("Amalgame.MsgPack|msgpack.am")
            stdlibEntries.Add("Amalgame.Compiler|amc_buildinfo.am")
            let sec: int = stdlibEntries.Count()
            // First pass over the user input files: collect imports AND
            // each file's own `namespace` declaration. We compare both
            // against the bundled-stdlib catalog so that:
            //   - imports decide which facades to auto-attach
            //   - inputs' own namespaces filter out facades the user is
            //     already compiling from source (e.g. the bootstrap
            //     itself feeds src/stdlib/json.am as an input, which
            //     must NOT also be auto-attached as external)
            // Also record each input file's basename for a second-line
            // dedup that survives relative-vs-absolute path drift.
            let importedNs: List<string> = new List<string>()
            let inputNs:    List<string> = new List<string>()
            let inputLeafs: List<string> = new List<string>()

            // Build the list of files whose imports we want to scan:
            // the user's CLI inputs PLUS each registered package's
            // facade and sources. The package side is what unblocks
            // patterns like amalgame-tls's acme.am that `import
            // Amalgame.Formats.Json` — without it, the json.am facade
            // is never auto-attached and acme.am fails to resolve
            // Json.Parse at the consumer build (since v0.8.39).
            let scanFiles: List<string> = new List<string>()
            for ifs in 0..inputCount {
                scanFiles.Add(inputFiles.Get(ifs))
            }
            let pkgScanStart: int = scanFiles.Count()
            for psi in 0..pkgCount {
                let plp: LoadedPackage = pkgReg.Packages.Get(psi)
                if (String_Length(plp.Facade) > 0) {
                    scanFiles.Add(plp.Facade)
                }
                let pln: int = plp.Sources.Count()
                for psj in 0..pln {
                    scanFiles.Add(plp.Sources.Get(psj))
                }
            }
            let scanCount: int = scanFiles.Count()
            for ifn in 0..scanCount {
                let ipath: string = scanFiles.Get(ifn)
                let isUserInput: bool = (ifn < pkgScanStart)
                // inputLeafs feeds the dedup-by-basename guard further
                // down; only user inputs participate (a package source
                // happening to be named "json.am" should NOT shadow
                // the bundled stdlib's json.am).
                if (isUserInput) {
                    let lastSlash: int = String_LastIndexOf(ipath, "/")
                    if (lastSlash >= 0) {
                        inputLeafs.Add(String_Substring(ipath, lastSlash + 1, String_Length(ipath) - lastSlash - 1))
                    } else {
                        inputLeafs.Add(ipath)
                    }
                }
                let isrc: string = File.ReadAll(ipath)
                let ilines: List<string> = String_Split(isrc, "\n")
                let iln: int = ilines.Count()
                var idx: int = 0
                while (idx < iln) {
                    let raw: string = ilines.Get(idx)
                    let trimmed: string = String_TrimStart(raw)
                    if (String_StartsWith(trimmed, "//")) {
                        idx = idx + 1
                        continue
                    }
                    if (String_StartsWith(trimmed, "import ")) {
                        let after: string = String_From(trimmed, 7)
                        // Strip trailing line comment so `import
                        // Amalgame.Json    // foo` captures just
                        // "Amalgame.Json" (the package sources we
                        // now scan tend to use inline comments).
                        var body: string = after
                        let cmt: int = String_IndexOf(after, "//")
                        if (cmt >= 0) {
                            body = String_Substring(after, 0, cmt)
                        }
                        let imp: string = String_Trim(body)
                        if (String_Length(imp) > 0) {
                            importedNs.Add(imp)
                        }
                    }
                    if (String_StartsWith(trimmed, "namespace ")) {
                        let nsAfter: string = String_From(trimmed, 10)
                        var nsBody: string = nsAfter
                        let nsCmt: int = String_IndexOf(nsAfter, "//")
                        if (nsCmt >= 0) {
                            nsBody = String_Substring(nsAfter, 0, nsCmt)
                        }
                        let nsName: string = String_Trim(nsBody)
                        // Only user inputs contribute to the self-skip
                        // list — a package source declaring its own
                        // namespace shouldn't prevent the bundled facade
                        // from being attached.
                        if (isUserInput && String_Length(nsName) > 0) {
                            inputNs.Add(nsName)
                        }
                    }
                    idx = idx + 1
                }
            }
            // Iterate the bundled-stdlib catalog. For each entry,
            // attach the facade if:
            //   - the user imports the matching namespace
            //   - no input file declares that namespace (avoid
            //     auto-attaching a facade of a file we're compiling)
            //   - the file isn't already an input / explicit external
            for ei in 0..sec {
                let entry: string = stdlibEntries.Get(ei)
                let sepIdx: int = String_IndexOf(entry, "|")
                if (sepIdx <= 0) { continue }
                let ns: string = String_Substring(entry, 0, sepIdx)
                let leaf: string = String_Substring(entry, sepIdx + 1, String_Length(entry) - sepIdx - 1)
                let nsPrefixCand: string = String_Replace(ns, ".", "_")
                if (nsPrefixCand == nsPrefix) { continue }
                var declaredByInput: bool = false
                let nic: int = inputNs.Count()
                for nii in 0..nic {
                    if (inputNs.Get(nii) == ns) { declaredByInput = true }
                }
                if (declaredByInput) { continue }
                var requested: bool = false
                let ni: int = importedNs.Count()
                for ii in 0..ni {
                    if (importedNs.Get(ii) == ns) { requested = true }
                }
                if (!requested) { continue }
                let candidate: string = stdlibDir + "/" + leaf
                if (!File.Exists(candidate)) { continue }
                // De-duplicate against inputs (by leaf basename — the
                // path strings may differ between relative and absolute
                // forms) and against explicit externals (full path
                // expected to match).
                var dup: bool = false
                let ilc: int = inputLeafs.Count()
                for ilf in 0..ilc {
                    if (inputLeafs.Get(ilf) == leaf) { dup = true }
                }
                let ecc: int = this.ExternalFiles.Count()
                for ec in 0..ecc {
                    let extPath: string = this.ExternalFiles.Get(ec)
                    if (extPath == candidate) { dup = true }
                    let extSlash: int = String_LastIndexOf(extPath, "/")
                    if (extSlash >= 0) {
                        let extLeaf: string = String_Substring(extPath, extSlash + 1, String_Length(extPath) - extSlash - 1)
                        if (extLeaf == leaf) { dup = true }
                    }
                }
                if (!dup) {
                    this.ExternalFiles.Add(candidate)
                }
            }
        }

        // ── CGen init ─────────────────────────────────
        let gen = new CGen()
        gen.RegisterPackages(pkgReg)
        gen.BeginMulti(nsPrefix)

        // ── Parse all files & Pass 1 ──────────────────
        let progs = new List<AstNode>()
        var parseOk = true
        for i in 0..inputCount {
            let path = inputFiles.Get(i)
            let src  = File.ReadAll(path)
            this.Diag.LoadSource(path, src)
            let lex  = new Lexer(src, path)
            let toks = lex.Tokenize()
            let par  = new Parser(toks)
            let prog = par.Parse()
            progs.Add(prog)
            if (par.HasErrors()) {
                Console.WriteError("amc: parse errors in " + path)
                Console.WriteError(par.GetErrors())
                this.ExitCode = 1
                parseOk = false
            }
            gen.AddFilePass1(prog)
        }
        // Project F (v0.7.5+): external files (passed via `--external
        // <file.am>`) are parsed for resolver + typechecker visibility,
        // but the cgen emits forward declarations only — definitions
        // land at link time from libamalgame.a. The cgen tracks each
        // file's namespace so call sites in the primary files lower
        // through the file's own mangled prefix rather than the
        // bundle's global NsPrefix.
        let externalProgs  = new List<AstNode>()
        let externalCount  = this.ExternalFiles.Count()
        for ei in 0..externalCount {
            let epath = this.ExternalFiles.Get(ei)
            let esrc  = File.ReadAll(epath)
            this.Diag.LoadSource(epath, esrc)
            let elex  = new Lexer(esrc, epath)
            let etoks = elex.Tokenize()
            let epar  = new Parser(etoks)
            let eprog = epar.Parse()
            externalProgs.Add(eprog)
            if (epar.HasErrors()) {
                Console.WriteError("amc: parse errors in external " + epath)
                Console.WriteError(epar.GetErrors())
                this.ExitCode = 1
                parseOk = false
            }
        }
        // RegisterExternalProg is split into two passes (v0.8.36):
        //   - Pass 1 across every external first — populates
        //     ExternalClasses / ExternalEnums + emits the matching
        //     typedef forward decls.
        //   - Pass 2 across every external next — emits the struct
        //     body, registers field C-types, emits method forward
        //     decls. Type lookups (TypeToC ↦ ExternalClassMangled)
        //     now resolve cross-external regardless of declaration
        //     order. Pre-fix, package A referencing package B in a
        //     typed-Closure field (e.g. amalgame-web's
        //     `Closure<WebContext, HttpResponse>` where HttpResponse
        //     is in amalgame-net-http) only worked if B preceded A
        //     in `amalgame.lock`.
        for ei3 in 0..externalCount {
            gen.RegisterExternalProgPass1(externalProgs.Get(ei3))
        }
        for ei4 in 0..externalCount {
            gen.RegisterExternalProgPass2(externalProgs.Get(ei4))
        }
        // Don't continue past resolve/typecheck/cgen if the parser
        // refused part of the input — the AST is incomplete and
        // downstream phases would just chain spurious errors off
        // the resulting holes.
        if (!parseOk) {
            return
        }
        if (this.Verbose) {
            Console.WriteError("  parse:     " + phaseSw.Reset())
        }

        // ── Resolver pass ─────────────────────────────
        let resolver = new FullResolver()
        resolver.Sources = this.Diag.Sources
        // Reuse the registry loaded above for CGen — keeps the two
        // in lock-step on what packages exist.
        resolver.RegisterPackages(pkgReg)
        let progCount = progs.Count()
        for ri in 0..progCount {
            resolver.Programs.Add(progs.Get(ri))
        }
        // External programs participate in resolution exactly like
        // primary ones — the resolver needs to see their classes so
        // call sites can be checked.
        let extCount = externalProgs.Count()
        for ei2 in 0..extCount {
            resolver.Programs.Add(externalProgs.Get(ei2))
        }
        resolver.CollectAll()
        if (this.Verbose) {
            Console.WriteError("  collect:   " + phaseSw.Reset())
        }
        resolver.ResolveAll()
        if (resolver.HasErrors()) {
            Console.WriteError(resolver.GetErrors())
            this.ExitCode = 1
            if (!this.CheckOnly) {
                // Non-fatal: continue to catch more errors
            }
        }
        if (this.Verbose) {
            Console.WriteError("  resolve:   " + phaseSw.Reset())
        }

        // ── TypeChecker pass ──────────────────────────
        // Walk every parsed program so cross-file uses (e.g. a class in
        // utils.am referenced from main.am) are checked too. The
        // TypeChecker keeps its own state across calls and accumulates
        // errors in `this.Errors`, so a single `tc` instance is fine.
        let tc     = new TypeChecker(resolver, firstPath)
        tc.Sources = this.Diag.Sources
        for ti in 0..progCount {
            tc.Check(progs.Get(ti))
        }
        // External programs are type-checked too so referenced
        // signatures stay consistent; cgen will still skip their
        // emission in pass 2.
        for ti2 in 0..extCount {
            tc.Check(externalProgs.Get(ti2))
        }
        if (tc.HasErrors()) {
            Console.WriteError(tc.FormatErrors())
            this.ExitCode = 1
        }
        if (this.Verbose) {
            Console.WriteError("  typecheck: " + phaseSw.Reset())
        }

        // ── Linter pass (optional) ────────────────────
        // Static analysis layered on top of the AST. Warnings are
        // non-fatal — they don't bump ExitCode — so the build still
        // produces output even with lint complaints.
        if (this.LintMode) {
            let linter = new Linter()
            for li in 0..progCount {
                linter.Lint(progs.Get(li))
            }
            if (linter.HasWarnings()) {
                Console.WriteError(linter.FormatWarnings())
            }
        }

        // ── Check-only mode: stop here ────────────────
        if (this.CheckOnly) {
            if (this.ExitCode == 0) {
                this.Diag.PrintPhaseOk("Check")
            }
            return
        }

        // Skip cgen entirely when a previous phase (resolver /
        // typechecker) flagged errors. Pre-fix the cgen ran
        // unconditionally on the partially-resolved AST: any
        // identifier the resolver rejected lowered as itself
        // (no symbol mangling, no implicit-declaration guard),
        // so gcc emitted a second wave of confusing errors
        // ("'_unknown_' undeclared", "implicit declaration of
        // foo") that masked the real amc diagnostic. Failing
        // clean here keeps the amc message the only thing the
        // user sees.
        if (this.ExitCode != 0) {
            return
        }

        // ── Codegen pass ──────────────────────────────
        gen.EmitSeparator()
        // Bug 1 (v0.8.23): every file's forwards must land before any
        // file's bodies, otherwise a call from file A to a method in
        // file B fires gcc's implicit-declaration warning + a follow-up
        // conflicting-types error. Pre-fix workaround was forcing the
        // user to pass `amc utils.am main.am` (common files first).
        for jf in 0..inputCount {
            gen.AddFilePass2Forwards(progs.Get(jf))
        }
        for j in 0..inputCount {
            // Pass the source path so the cgen emits `#line N "foo.am"`
            // directives at each statement — DWARF then carries .am
            // filenames + line numbers, and `amc dap` can forward
            // breakpoints natively without rewriting source paths.
            gen.AddFilePass2Bodies(progs.Get(j), inputFiles.Get(j))
        }

        // ── Write output .c ───────────────────────────
        let lines     = gen.GetLines()
        let lineCount = lines.Count()
        let outC      = outputName + ".c"
        File.WriteAll(outC, "")
        for k in 0..lineCount {
            File.AppendAll(outC, lines.Get(k) + "\n")
        }

        // ── Emit C main() unless --lib ─────────────────
        let mainFunc = nsPrefix + "_Program_Main"
        let genSrc   = File.ReadAll(outC)
        let hasMain  = String_Contains(genSrc, mainFunc)
        let isLibrary = this.IsLib || !hasMain
        if (!isLibrary) {
            // Pick the argv-conversion expression matching Main's
            // declared parameter type. The generated signature is the
            // grep cue: `Main(AmalgameList*` for `List<string> args`,
            // `Main(code_string*` for the legacy `string[] args`, no
            // arg at all when the user wrote `Main()`. Without this
            // detection the cast `(code_string*)argv` silently aliased
            // argv as an AmalgameList* and Main saw raw stack pointers
            // via args.size/args.data — debugger showed it as hex,
            // any access crashed (see fix/main-args-list-type).
            var argsExpr: string = ""
            if (String_Contains(genSrc, mainFunc + "(AmalgameList*")) {
                argsExpr = "code_runtime_args_list()"
            } else if (String_Contains(genSrc, mainFunc + "(code_string*")) {
                argsExpr = "(code_string*)argv"
            }
            File.AppendAll(outC, "\nint main(int argc, char** argv) {\n")
            File.AppendAll(outC, "    GC_INIT();\n")
            File.AppendAll(outC, "    code_runtime_init_args(argc, argv);\n")
            File.AppendAll(outC, "    " + mainFunc + "(" + argsExpr + ");\n")
            File.AppendAll(outC, "    return code_exit_code;\n")
            File.AppendAll(outC, "}\n")
        } else {
            File.AppendAll(outC, "\n/* Library — no entry point */\n")
        }

        let mode = if (isLibrary) { "Library" } else { "Executable" }
        Console.WriteLine("Generated: " + outC + " (" + String_FromInt(lineCount) + " lines) [" + mode + "]")
        if (this.Verbose) {
            Console.WriteError("  cgen:      " + phaseSw.Reset())
        }
        this.Diag.PrintCompileOk("Build")
    }
}

// ── CLI entry point — replaces the old amc_main.c ──────────
public class Program {
    // Resolve amc's own executable path through the kernel so commands
    // that need a sibling runtime/ or lib/ directory (`amc build`,
    // `amc run`) keep working when the binary is invoked through PATH
    // with no leading `/` in argv[0]. Linux exposes the canonical path
    // via `/proc/self/exe`; Windows via GetModuleFileNameA; macOS via
    // _NSGetExecutablePath (with a realpath() pass so symlinked
    // Homebrew shims resolve to the actual cellar binary).
    public static string ResolveSelfPath() {
        @c {
            #ifdef _WIN32
                char buf[4096];
                DWORD n = GetModuleFileNameA(NULL, buf, sizeof(buf));
                if (n == 0 || n >= sizeof(buf)) { return (code_string) ""; }
                /* Normalise backslashes so dirname / Substring split work. */
                for (DWORD i = 0; i < n; i++) { if (buf[i] == '\\') buf[i] = '/'; }
                char* out = (char*) GC_MALLOC((size_t)(n + 1));
                memcpy(out, buf, (size_t)(n + 1));
                return (code_string) out;
            #elif defined(__APPLE__)
                /* `#include <mach-o/dyld.h>` + `<stdlib.h>` moved to the
                 * file-scope @c block at the top of main.am — clang
                 * rejects the byte_order.h inline functions when those
                 * headers are pulled in inside a function body. */
                char raw[4096];
                uint32_t size = sizeof(raw);
                if (_NSGetExecutablePath(raw, &size) != 0) { return (code_string) ""; }
                /* realpath collapses any /./, /../, or symlink in the path
                 * — Homebrew installs amc as a symlink in /usr/local/bin
                 * pointing at the versioned cellar; we want the cellar
                 * path so the runtime/ sibling search succeeds. */
                char resolved[4096];
                char* p = realpath(raw, resolved);
                const char* src = p ? (const char*)resolved : (const char*)raw;
                size_t n = strlen(src);
                char* out = (char*) GC_MALLOC(n + 1);
                memcpy(out, src, n + 1);
                return (code_string) out;
            #else
                char buf[4096];
                ssize_t n = readlink("/proc/self/exe", buf, sizeof(buf) - 1);
                if (n <= 0) { return (code_string) ""; }
                buf[n] = '\0';
                char* out = (char*) GC_MALLOC((size_t)(n + 1));
                memcpy(out, buf, (size_t)(n + 1));
                return (code_string) out;
            #endif
        }
    }

    // Resolve the runtime/ directory amc should use to find _runtime.h
    // and the Amalgame_*.h shims. Checked in priority order:
    //   1. $AMC_RUNTIME env override (explicit, wins outright)
    //   2. <bin>/../share/amalgame/runtime   (XDG/UNIX install layout —
    //      ~/.local/share/amalgame, /usr/local/share/amalgame,
    //      /opt/homebrew/share/amalgame, /mingw64/share/amalgame, …)
    //   3. <bin>/runtime                     (legacy + dev source tree)
    // Returns "" if none of the candidates contain `_runtime.h`.
    public static string ResolveRuntimeDir(string amcPath) {
        let envDir: string = Env_Get("AMC_RUNTIME")
        if (String_Length(envDir) > 0 && File.Exists(envDir + "/_runtime.h")) {
            return envDir
        }
        let slashIdx: int = String_LastIndexOf(amcPath, "/")
        if (slashIdx < 0) { return "" }
        let binDir: string = String_Substring(amcPath, 0, slashIdx)
        let xdg: string = binDir + "/../share/amalgame/runtime"
        if (File.Exists(xdg + "/_runtime.h")) { return xdg }
        let legacy: string = binDir + "/runtime"
        if (File.Exists(legacy + "/_runtime.h")) { return legacy }
        return ""
    }

    // Resolve libamalgame.a — companion archive to runtime/, holds the
    // user-facing stdlib (Json/Toml/MsgPack/Path) so package authors
    // don't have to bundle those .am sources. Same probe order as
    // ResolveRuntimeDir; returns "" if missing (link still succeeds
    // for projects that don't import the bundled stdlib classes).
    public static string ResolveLibAmalgameA(string amcPath) {
        let envDir: string = Env_Get("AMC_LIB")
        if (String_Length(envDir) > 0 && File.Exists(envDir + "/libamalgame.a")) {
            return envDir + "/libamalgame.a"
        }
        let slashIdx: int = String_LastIndexOf(amcPath, "/")
        if (slashIdx < 0) { return "" }
        let binDir: string = String_Substring(amcPath, 0, slashIdx)
        let xdg: string = binDir + "/../share/amalgame/lib/libamalgame.a"
        if (File.Exists(xdg)) { return xdg }
        let legacy: string = binDir + "/lib/libamalgame.a"
        if (File.Exists(legacy)) { return legacy }
        return ""
    }

    // Resolve the directory holding the bundled-stdlib .am sources
    // (Json/Toml/MsgPack/Path/Compiler). Bug 6 fix: when user code does
    // `import Amalgame.Formats.Json` and references `JsonValue` in a
    // field type, the cgen needs to lower that type to its bundled
    // namespace (Amalgame_Formats_Json_JsonValue) instead of the
    // consumer's NsPrefix. The cheapest way to teach the cgen the right
    // mangling is to parse the relevant .am facade as `--external`, so
    // RegisterExternalProg seeds the ExternalClasses registry exactly
    // like a third-party package facade does.
    //
    // Probe order:
    //   1. $AMC_STDLIB_SRC env override
    //   2. <bin>/../share/amalgame/stdlib   (XDG install layout)
    //   3. <bin>/src/stdlib                 (source-tree dev layout)
    // Returns "" if no candidate contains json.am (the marker file).
    public static string ResolveStdlibSrcDir(string amcPath) {
        let envDir: string = Env_Get("AMC_STDLIB_SRC")
        if (String_Length(envDir) > 0 && File.Exists(envDir + "/json.am")) {
            return envDir
        }
        let slashIdx: int = String_LastIndexOf(amcPath, "/")
        if (slashIdx < 0) { return "" }
        let binDir: string = String_Substring(amcPath, 0, slashIdx)
        let xdg: string = binDir + "/../share/amalgame/stdlib"
        if (File.Exists(xdg + "/json.am")) { return xdg }
        let dev: string = binDir + "/src/stdlib"
        if (File.Exists(dev + "/json.am")) { return dev }
        return ""
    }

