namespace Amalgame.Compiler

import Amalgame.Collections
import Amalgame.IO
import Amalgame.String

// Bootstrap compiler entry point
public class AmalgameCompiler {
    private Diag:    DiagnosticFormatter
    private IsLib:   bool
    private CheckOnly: bool
    private LintMode: bool
    private Verbose: bool
    private ExitCode: int

    public AmalgameCompiler() {
        this.Diag      = new DiagnosticFormatter()
        this.IsLib     = false
        this.CheckOnly = false
        this.LintMode  = false
        this.Verbose   = false
        this.ExitCode  = 0
    }

    public void SetLib(bool v)       { this.IsLib     = v }
    public void SetCheckOnly(bool v) { this.CheckOnly = v }
    public void SetLintMode(bool v)  { this.LintMode  = v }
    public void SetVerbose(bool v)   { this.Verbose   = v }
    public void SetColor(bool v)     { this.Diag.EnableColor(v) }
    public int  GetExitCode()        { return this.ExitCode }

    // ── Main compile pipeline ─────────────────────────

    public void Run(List<string> inputFiles, string outputName) {
        let inputCount = inputFiles.Count()
        if (inputCount == 0) {
            Console.WriteError("amc: no input .am files")
            this.ExitCode = 1
            return
        }

        if (this.Verbose) {
            Console.WriteLine("Compiling: " + String_FromInt(inputCount) + " file(s)")
        }

        // ── Detect namespace from first file ──────────
        let firstPath = inputFiles.Get(0)
        let firstSrc  = File.ReadAll(firstPath)
        var nsPrefix  = "App"
        let nlIdx = String_IndexOf(firstSrc, "namespace ")
        if (nlIdx >= 0) {
            let nlRest = String_Substring(firstSrc, nlIdx + 10, 200)
            let nlEnd  = String_IndexOf(nlRest, "\n")
            if (nlEnd > 0) {
                let rawNs = String_Substring(nlRest, 0, nlEnd)
                nsPrefix  = String_Replace(String_Trim(rawNs), ".", "_")
            }
        }

        // ── Load v0.5 package registry ───────────────
        // amalgame.lock in cwd (if present) lists installed
        // external packages. Resolver + CGen each consume the
        // registry to seed globals / isStdlib / return-types /
        // #include emission. Empty lock → no-op everywhere.
        let pkgReg = PackageRegistry.Load()

        // ── CGen init ─────────────────────────────────
        let gen = new CGen()
        gen.RegisterPackages(pkgReg)
        gen.BeginMulti(nsPrefix)

        // ── Parse all files & Pass 1 ──────────────────
        let progs = new List<AstNode>()
        var parseOk = true
        for i in 0..inputCount {
            let path = inputFiles.Get(i)
            let src  = File.ReadAll(path)
            this.Diag.LoadSource(path, src)
            let lex  = new Lexer(src, path)
            let toks = lex.Tokenize()
            let par  = new Parser(toks)
            let prog = par.Parse()
            progs.Add(prog)
            if (par.HasErrors()) {
                Console.WriteError("amc: parse errors in " + path)
                Console.WriteError(par.GetErrors())
                this.ExitCode = 1
                parseOk = false
            }
            gen.AddFilePass1(prog)
        }
        // Don't continue past resolve/typecheck/cgen if the parser
        // refused part of the input — the AST is incomplete and
        // downstream phases would just chain spurious errors off
        // the resulting holes.
        if (!parseOk) {
            return
        }

        // ── Resolver pass ─────────────────────────────
        let resolver = new FullResolver()
        resolver.Sources = this.Diag.Sources
        // Reuse the registry loaded above for CGen — keeps the two
        // in lock-step on what packages exist.
        resolver.RegisterPackages(pkgReg)
        let progCount = progs.Count()
        for ri in 0..progCount {
            resolver.Programs.Add(progs.Get(ri))
        }
        resolver.ResolvePrograms()
        if (resolver.HasErrors()) {
            Console.WriteError(resolver.GetErrors())
            this.ExitCode = 1
            if (!this.CheckOnly) {
                // Non-fatal: continue to catch more errors
            }
        }

        // ── TypeChecker pass ──────────────────────────
        // Walk every parsed program so cross-file uses (e.g. a class in
        // utils.am referenced from main.am) are checked too. The
        // TypeChecker keeps its own state across calls and accumulates
        // errors in `this.Errors`, so a single `tc` instance is fine.
        let tc     = new TypeChecker(resolver, firstPath)
        tc.Sources = this.Diag.Sources
        for ti in 0..progCount {
            tc.Check(progs.Get(ti))
        }
        if (tc.HasErrors()) {
            Console.WriteError(tc.FormatErrors())
            this.ExitCode = 1
        }

        // ── Linter pass (optional) ────────────────────
        // Static analysis layered on top of the AST. Warnings are
        // non-fatal — they don't bump ExitCode — so the build still
        // produces output even with lint complaints.
        if (this.LintMode) {
            let linter = new Linter()
            for li in 0..progCount {
                linter.Lint(progs.Get(li))
            }
            if (linter.HasWarnings()) {
                Console.WriteError(linter.FormatWarnings())
            }
        }

        // ── Check-only mode: stop here ────────────────
        if (this.CheckOnly) {
            if (this.ExitCode == 0) {
                this.Diag.PrintPhaseOk("Check")
            }
            return
        }

        // ── Codegen pass ──────────────────────────────
        gen.EmitSeparator()
        for j in 0..inputCount {
            gen.AddFilePass2(progs.Get(j))
        }

        // ── Write output .c ───────────────────────────
        let lines     = gen.GetLines()
        let lineCount = lines.Count()
        let outC      = outputName + ".c"
        File.WriteAll(outC, "")
        for k in 0..lineCount {
            File.AppendAll(outC, lines.Get(k) + "\n")
        }

        // ── Emit C main() unless --lib ─────────────────
        let mainFunc = nsPrefix + "_Program_Main"
        let genSrc   = File.ReadAll(outC)
        let hasMain  = String_Contains(genSrc, mainFunc)
        let isLibrary = this.IsLib || !hasMain
        if (!isLibrary) {
            File.AppendAll(outC, "\nint main(int argc, char** argv) {\n")
            File.AppendAll(outC, "    GC_INIT();\n")
            File.AppendAll(outC, "    code_runtime_init_args(argc, argv);\n")
            File.AppendAll(outC, "    " + mainFunc + "((code_string*)argv);\n")
            File.AppendAll(outC, "    return code_exit_code;\n")
            File.AppendAll(outC, "}\n")
        } else {
            File.AppendAll(outC, "\n/* Library — no entry point */\n")
        }

        let mode = if (isLibrary) { "Library" } else { "Executable" }
        Console.WriteLine("Generated: " + outC + " (" + String_FromInt(lineCount) + " lines) [" + mode + "]")
        this.Diag.PrintCompileOk("Build")
    }
}

// ── CLI entry point — replaces the old amc_main.c ──────────
public class Program {
    public static void PrintUsage() {
        Console.WriteError("Usage: amc [options] file1.am [file2.am ...] -o <output>")
        Console.WriteError("       amc fmt [-w] file.am [file.am ...]")
        Console.WriteError("")
        Console.WriteError("Options:")
        Console.WriteError("  -o <output>   Output file (default: a.out)")
        Console.WriteError("  --lib         Compile as library (no main() emitted)")
        Console.WriteError("  --check       Type-check only, no code generation")
        Console.WriteError("  --lint        Run static-analysis warnings (in addition to compile)")
        Console.WriteError("  --color       Force ANSI color output")
        Console.WriteError("  --no-color    Disable ANSI color output")
        Console.WriteError("  --quiet       Suppress progress messages")
        Console.WriteError("  --verbose     Print extra build info")
        Console.WriteError("  --version     Print version and exit")
        Console.WriteError("  --help        Print this help")
        Console.WriteError("")
        Console.WriteError("Subcommands:")
        Console.WriteError("  fmt           Format Amalgame source. Default: print to stdout.")
        Console.WriteError("                With -w, rewrite files in place.")
        Console.WriteError("  test [<dir>]  Discover *_test.am, compile + run each, aggregate")
        Console.WriteError("                [PASS]/[FAIL]/[SKIP] lines from their stdout.")
        Console.WriteError("  lsp           Run a minimal LSP server (stdio JSON-RPC).")
        Console.WriteError("                v1 publishes diagnostics on didOpen/didChange.")
        Console.WriteError("  migrate <f>   Migrate a source file or directory to Amalgame via LLM.")
        Console.WriteError("                Auto-uses claude-api when ANTHROPIC_API_KEY is set, else")
        Console.WriteError("                shells out to the local `claude` CLI. See `amc migrate --help`.")
        Console.WriteError("  generate <p>  Generate an Amalgame program from a natural-language prompt.")
        Console.WriteError("                Same provider auto-selection as migrate. See `amc generate --help`.")
        Console.WriteError("  explain <f>   Read an Amalgame file and emit a natural-language explanation.")
        Console.WriteError("                See `amc explain --help`.")
        Console.WriteError("  new <name>    Scaffold a new Amalgame project (exe / lib / test templates).")
        Console.WriteError("                See `amc new --help`.")
        Console.WriteError("  package <X>   Package manager (alias `pkg`). Verbs: add / remove / list /")
        Console.WriteError("                search / versions / info / outdated / notice / check /")
        Console.WriteError("                update / cache. See `amc package --help`.")
    }

    // ── test subcommand ────────────────────────────────
    // Discovers *_test.am under <dir> (default `.`), compiles each
    // with the running amc binary + gcc, runs the result, and parses
    // its stdout for `[PASS] <name>`, `[FAIL] <name>: <msg>`, and
    // `[SKIP] <name>` lines. The runner expects to be invoked from
    // a directory with a sibling `runtime/` so gcc can find the
    // headers — true for the Amalgame repo itself; downstream users
    // will need a richer install story (--runtime, AMC_RUNTIME env
    // var) which is left for a follow-up.
    public static int RunTest(int argc) {
        var dir = "."
        var i = 2
        while (i < argc) {
            let a = Args_Get(i)
            if (String_StartsWith(a, "-")) {
                Console.WriteError("amc test: unknown option '" + a + "'")
                return 1
            }
            dir = a
            i = i + 1
        }

        // v0.5.1: auto-install missing deps before running tests.
        // amalgame.lock-declared packages that aren't in the cache
        // get re-cloned here, so `git clone <repo> && amc test`
        // works in one step. No-op when there's no lock file or
        // every dep is already present.
        let installed: int = AddCommand.EnsureInstalled()
        if (installed < 0) {
            Console.WriteError("amc test: package install failed; aborting")
            return 1
        }
        if (installed > 0) {
            Console.WriteLine("amc test: installed " + String_FromInt(installed) + " missing dep(s)")
        }

        // v0.5.2: resolve amc's runtime/ once + pre-compile each
        // installed package's vendored .c sources to .o files
        // cached in /tmp. The .o files get linked into every test
        // binary so SQLite (and any future vendoring backend)
        // links cleanly without the user doing gcc by hand.
        let amcPathForRt: string = Args_Get(0)
        var amcRuntime: string = Env_Get("AMC_RUNTIME")
        if (String_Length(amcRuntime) == 0) {
            let slashIdx: int = String_LastIndexOf(amcPathForRt, "/")
            if (slashIdx >= 0) {
                amcRuntime = String_Substring(amcPathForRt, 0, slashIdx) + "/runtime"
            }
        }
        let registry = PackageRegistry.Load()
        let pkgObjs: List<string> = Program.PreCompilePackageSources(registry, amcRuntime)
        let hasCxx: bool = registry.HasCxxSources()
        let pkgLibs: List<string> = registry.CollectLibs()

        // Discovery: shell out to `find`. Works on POSIX and on
        // Windows MSYS2 (the only Windows path the repo CI exercises).
        let findCmd = "find " + dir + " -name '*_test.am' -type f"
        let discovered = Process.RunCapture(findCmd)
        if (discovered.Exit != 0) {
            Console.WriteError("amc test: failed to enumerate tests in " + dir)
            Console.WriteError(discovered.Stdout)
            return 1
        }
        let lines: List<string> = String_Split(String_Trim(discovered.Stdout), "\n")
        let nLines = lines.Count()
        if (nLines == 0) {
            Console.WriteLine("No *_test.am files found under " + dir)
            return 0
        }
        // String_Split on "" returns a single empty entry; treat
        // that as "no files" too.
        if (nLines == 1) {
            let only = String_Trim(lines.Get(0))
            if (String_Length(only) == 0) {
                Console.WriteLine("No *_test.am files found under " + dir)
                return 0
            }
        }

        let amcPath = Args_Get(0)
        var pass        = 0
        var fail        = 0
        var skip        = 0
        var compileFail = 0

        for li in 0..nLines {
            let path = String_Trim(lines.Get(li))
            if (String_Length(path) == 0) { continue }
            Console.WriteLine("── " + path)

            // Step 1 — amc <test>.am -o <tmp>  → produces <tmp>.c
            let outBin = "/tmp/amc_test_" + String_FromInt(li)
            let outC   = outBin + ".c"
            let amcCmd = amcPath + " " + path + " -o " + outBin + " --quiet"
            let cr = Process.RunCapture(amcCmd)
            if (cr.Exit != 0) {
                Console.WriteLine("  [COMPILE-FAIL]")
                Console.Write(cr.Stdout)
                compileFail = compileFail + 1
                continue
            }
            // Step 2 — compile + link the emitted .c. Locate amc's
            // runtime/ headers so this works in any cwd (not just
            // the Amalgame source tree). amcRuntime resolved once
            // before the test loop (see above).
            //
            // Two-stage when any installed package ships C++:
            //  (a) gcc -c <test>.c -o <test>.o  — compile as C, since
            //      amc emits C-style void* conversions and string-
            //      literal-to-char* casts that g++ rejects.
            //  (b) g++ <test>.o pkg_objs... — link as C++ so libstdc++
            //      + C++ static-init order resolve correctly. A plain
            //      `gcc -lstdc++` link skips C++ init that some
            //      amalgamations (DuckDB) need.
            // Otherwise a single-step gcc link is the v0.5.2 path.
            var gccCmd: string = ""
            if (hasCxx) {
                // Stage (a): gcc -c to .o
                var compileCmd: string = "gcc -O2 -Iruntime"
                if (String_Length(amcRuntime) > 0) {
                    compileCmd = compileCmd + " -I'" + amcRuntime + "'"
                }
                let objOut: string = outBin + ".o"
                compileCmd = compileCmd + " -c " + outC + " -o " + objOut + " 2>&1"
                let stageA = Process.RunCapture(compileCmd)
                if (stageA.Exit != 0) {
                    Console.WriteLine("  [LINK-FAIL]")
                    Console.Write(stageA.Stdout)
                    compileFail = compileFail + 1
                    continue
                }
                // Stage (b): g++ link
                gccCmd = "g++ -O2 " + objOut
            } else {
                gccCmd = "gcc -O2 -Iruntime"
                if (String_Length(amcRuntime) > 0) {
                    gccCmd = gccCmd + " -I'" + amcRuntime + "'"
                }
                gccCmd = gccCmd + " " + outC
            }
            let nObjs: int = pkgObjs.Count()
            for poi in 0..nObjs {
                gccCmd = gccCmd + " '" + pkgObjs.Get(poi) + "'"
            }
            gccCmd = gccCmd + " -lgc -lm -lcurl -ldl -lpthread"
            // Splice per-package libs (-l<name>). Each loaded
            // package contributes zero or more bare names via
            // its manifest's [stdlib].libs array.
            let nLibs: int = pkgLibs.Count()
            for plj in 0..nLibs {
                gccCmd = gccCmd + " -l" + pkgLibs.Get(plj)
            }
            gccCmd = gccCmd + " -o " + outBin + " 2>&1"
            let gcc = Process.RunCapture(gccCmd)
            if (gcc.Exit != 0) {
                Console.WriteLine("  [LINK-FAIL]")
                Console.Write(gcc.Stdout)
                compileFail = compileFail + 1
                continue
            }
            // Step 3 — run and parse stdout for tag lines. Anything
            // not matching a tag is preserved as test stdout (for
            // debugging), printed indented under the tag lines.
            let rr = Process.RunCapture(outBin)
            let outLines: List<string> = String_Split(rr.Stdout, "\n")
            let on = outLines.Count()
            for ln in 0..on {
                let lineStr = outLines.Get(ln)
                if (String_StartsWith(lineStr, "[PASS]")) {
                    Console.WriteLine("  " + lineStr)
                    pass = pass + 1
                } else if (String_StartsWith(lineStr, "[FAIL]")) {
                    Console.WriteLine("  " + lineStr)
                    fail = fail + 1
                } else if (String_StartsWith(lineStr, "[SKIP]")) {
                    Console.WriteLine("  " + lineStr)
                    skip = skip + 1
                }
            }
            // Surface a non-zero exit even if no tag lines were
            // emitted — covers tests that crash before printing.
            if (rr.Exit != 0 && pass == 0 && fail == 0 && skip == 0) {
                Console.WriteLine("  [FAIL] <crash> exit=" + String_FromInt(rr.Exit))
                fail = fail + 1
            }
        }

        Console.WriteLine("")
        Console.WriteLine("──────────────────────────────────")
        Console.WriteLine("PASS: " + String_FromInt(pass) + "  FAIL: " + String_FromInt(fail) + "  SKIP: " + String_FromInt(skip))
        if (compileFail > 0) {
            Console.WriteLine("COMPILE-FAIL: " + String_FromInt(compileFail))
            return 1
        }
        if (fail > 0) { return 1 }
        return 0
    }

    // Pre-compile every installed package's vendored source(s)
    // to .o files. Each test binary then links the resulting .o
    // list, so packages with vendored deps (SQLite C, DuckDB C++)
    // compile cleanly via `amc test`.
    //
    // Cache lookup order (since v0.5.4):
    //   1. `<pkg-dir>/build/<platform>/<class>-<basename>.o`
    //      — persistent, written by `amc package add` when the
    //      manifest declares `[stdlib].precompile = true`. Survives
    //      reboots, shared across all `amc test` invocations.
    //   2. `/tmp/amc-pkg-<class>-<basename>.o`
    //      — volatile, written here on the lazy path when (1) misses.
    //      Wiped on reboot but cheap to rebuild.
    //   3. Compile fresh.
    //
    // Compiler dispatch: gcc for .c (+ p.CFlags), g++ for
    // .cpp/.cc/.cxx (+ p.CxxFlags). Same dispatch as
    // AddCommand.PrecompilePackage so the two paths stay coherent.
    public static List<string> PreCompilePackageSources(PackageRegistry reg, string amcRuntime) {
        let out: List<string> = new List<string>()
        let n: int = reg.Packages.Count()
        for i in 0..n {
            let p: LoadedPackage = reg.Packages.Get(i)
            let sources: List<string> = p.Sources
            let sn: int = sources.Count()
            // Compute the persistent precompile cache dir for this
            // package (only used if .o is present there; not
            // created here).
            let persistentDir: string = PackageRegistry.PrecompileCacheDir(p.PkgDir)
            for j in 0..sn {
                let srcPath: string = sources.Get(j)
                if (String_Length(srcPath) == 0) { continue }
                // Derive an .o filename from the basename so two
                // packages shipping a `foo.c` don't collide.
                let lastSlash: int = String_LastIndexOf(srcPath, "/")
                var srcLeaf: string = srcPath
                if (lastSlash >= 0) {
                    srcLeaf = String_Substring(srcPath, lastSlash + 1, String_Length(srcPath) - lastSlash - 1)
                }
                // Persistent cache lookup first.
                let persistentObj: string = persistentDir + "/" + p.ClassName + "-" + srcLeaf + ".o"
                if (File.Exists(persistentObj)) {
                    out.Add(persistentObj)
                    continue
                }
                let objPath: string = "/tmp/amc-pkg-" + p.ClassName + "-" + srcLeaf + ".o"
                if (File.Exists(objPath)) {
                    out.Add(objPath)
                    continue
                }
                let isCxx: bool = PackageRegistry.IsCxxSource(srcPath)
                var cmd: string = ""
                if (isCxx) {
                    cmd = "g++ -O2"
                } else {
                    cmd = "gcc -O2"
                }
                if (String_Length(amcRuntime) > 0) {
                    cmd = cmd + " -I'" + amcRuntime + "'"
                }
                // Per-package flags. CFlags for C, CxxFlags for C++.
                if (isCxx && String_Length(p.CxxFlags) > 0) {
                    cmd = cmd + " " + p.CxxFlags
                }
                if (!isCxx && String_Length(p.CFlags) > 0) {
                    cmd = cmd + " " + p.CFlags
                }
                // -w to silence the upstream code's own warnings;
                // we don't want amalgamation warnings cluttering
                // `amc test` output.
                cmd = cmd + " -w -c '" + srcPath + "' -o '" + objPath + "'"
                let res = Process.RunCapture(cmd)
                if (res.Exit != 0) {
                    Console.WriteError("amc test: failed to pre-compile " + srcPath)
                    Console.WriteError(res.Stdout)
                    continue
                }
                Console.WriteLine("Pre-compiled " + p.ClassName + " source: " + srcLeaf)
                out.Add(objPath)
            }
        }
        return out
    }


    // ── fmt subcommand ─────────────────────────────────
    public static int RunFmt(int argc) {
        var write = false
        let files = new List<string>()
        var i = 2
        while (i < argc) {
            let a = Args_Get(i)
            if (a == "-w" || a == "--write") {
                write = true
            } else if (String_EndsWith(a, ".am")) {
                files.Add(a)
            } else {
                Console.WriteError("amc fmt: unknown argument '" + a + "'")
                return 1
            }
            i = i + 1
        }
        if (files.Count() == 0) {
            Console.WriteError("amc fmt: no input .am files")
            return 1
        }
        let n = files.Count()
        for j in 0..n {
            let path = files.Get(j)
            let src  = File.ReadAll(path)
            let lex  = new Lexer(src, path)
            let toks = lex.Tokenize()
            let par  = new Parser(toks)
            let prog = par.Parse()
            if (par.HasErrors()) {
                Console.WriteError("amc fmt: parse errors in " + path)
                Console.WriteError(par.GetErrors())
                return 1
            }
            let fmt = new Formatter(par.Comments)
            let out = fmt.Format(prog)
            if (write) {
                File.WriteAll(path, out)
            } else {
                Console.Write(out)
            }
        }
        return 0
    }

    public static void Main(string[] args) {
        let argc = Args_Count()
        if (argc < 2) {
            Program.PrintUsage()
            Exit_Set(1)
            return
        }
        if (Args_Get(1) == "fmt") {
            Exit_Set(Program.RunFmt(argc))
            return
        }
        if (Args_Get(1) == "test") {
            Exit_Set(Program.RunTest(argc))
            return
        }
        if (Args_Get(1) == "lsp") {
            let server = new LspServer()
            Exit_Set(server.Run())
            return
        }
        if (Args_Get(1) == "migrate") {
            Exit_Set(MigrateCommand.Run(argc))
            return
        }
        if (Args_Get(1) == "generate") {
            Exit_Set(GenerateCommand.Run(argc))
            return
        }
        if (Args_Get(1) == "explain") {
            Exit_Set(ExplainCommand.Run(argc))
            return
        }
        if (Args_Get(1) == "new") {
            Exit_Set(NewCommand.Run(argc))
            return
        }
        // Package-manager commands live under `amc package <X>`
        // (also accepts the short alias `amc pkg <X>`). Centralising
        // every PM verb under one umbrella keeps the top-level
        // command space clear for language ops (compile / fmt /
        // test / lsp / migrate / generate / explain / new) and
        // matches dotnet's / go-mod's grouping convention.
        let v1: string = Args_Get(1)
        if (v1 == "package" || v1 == "pkg") {
            Exit_Set(AddCommand.RunPackage(argc))
            return
        }

        let inputFiles = new List<string>()
        var outputName = "a.out"
        var isLib      = false
        var checkOnly  = false
        var lintMode   = false
        var useColor   = false
        var verbose    = true

        var i = 1
        while (i < argc) {
            let a = Args_Get(i)
            if (a == "-o" && i + 1 < argc) {
                i = i + 1
                outputName = Args_Get(i)
            } else if (a == "--lib") {
                isLib = true
            } else if (a == "--check") {
                checkOnly = true
            } else if (a == "--lint") {
                lintMode = true
            } else if (a == "--color") {
                useColor = true
            } else if (a == "--no-color") {
                useColor = false
            } else if (a == "--quiet") {
                verbose = false
            } else if (a == "--verbose") {
                verbose = true
            } else if (a == "--version") {
                // Build provenance: rev + date are baked at link time
                // by build_amc.sh via -DAMC_GIT_REV / -DAMC_BUILD_DATE.
                // When the defines are missing (someone gcc'd the C
                // snapshot directly), the helpers return "" and we
                // skip the line — never emit a half-rendered banner.
                let rev:  string = BuildInfo.GitRev()
                let date: string = BuildInfo.BuildDate()
                var head:  string = "amc " + PackageRegistry.AmcVersion()
                var prov:  string = ""
                if (String_Length(rev) > 0 && String_Length(date) > 0) {
                    prov = " (commit " + rev + ", built " + date + ")"
                } else if (String_Length(rev) > 0) {
                    prov = " (commit " + rev + ")"
                } else if (String_Length(date) > 0) {
                    prov = " (built " + date + ")"
                }
                Console.WriteLine(head + prov)
                Console.WriteLine("Self-hosted Amalgame compiler.")
                Console.WriteLine("Copyright (c) 2026 Bastien Mouget. License: Apache-2.0.")
                Console.WriteLine("Website:    https://amalgame.me")
                Console.WriteLine("Repository: https://github.com/amalgame-lang/Amalgame")
                Console.WriteLine("Issues:     https://github.com/amalgame-lang/Amalgame/issues")
                Exit_Set(0)
                return
            } else if (a == "--help" || a == "-h") {
                Program.PrintUsage()
                Exit_Set(0)
                return
            } else if (String_EndsWith(a, ".am")) {
                inputFiles.Add(a)
            } else {
                Console.WriteError("amc: unknown option '" + a + "'")
                Program.PrintUsage()
                Exit_Set(1)
                return
            }
            i = i + 1
        }

        if (inputFiles.Count() == 0) {
            Console.WriteError("amc: no input .am files")
            Exit_Set(1)
            return
        }

        let compiler = new AmalgameCompiler()
        compiler.SetLib(isLib)
        compiler.SetCheckOnly(checkOnly)
        compiler.SetLintMode(lintMode)
        compiler.SetColor(useColor)
        compiler.SetVerbose(verbose)
        compiler.Run(inputFiles, outputName)
        Exit_Set(compiler.GetExitCode())
    }
}
