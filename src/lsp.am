namespace Amalgame.Compiler

import Amalgame.Collections
import Amalgame.IO
import Amalgame.Process
import Amalgame.String

// ═══════════════════════════════════════════════════════
//  lsp.am  —  amc lsp: minimal LSP server (diagnostics-only)
// ═══════════════════════════════════════════════════════
//
// Speaks JSON-RPC 2.0 over stdio with the standard
// `Content-Length: N\r\n\r\n<N bytes>` framing. v1 implements:
//
//   - initialize / shutdown / exit       (lifecycle)
//   - textDocument/didOpen / didChange   (document state, full sync)
//   - textDocument/didClose
//   - textDocument/publishDiagnostics    (push, on every did{Open,Change})
//
// `textDocumentSync` is advertised as Full (1), so each didChange
// carries the entire updated text — no incremental edits to apply.
// Hover / completion / goto-definition are out of scope for v1
// and will land in a follow-up.
//
// JSON handling is ad-hoc: extractors look up `"key"` substrings.
// LSP messages don't have ambiguous key names at the depth we
// extract (method, id, uri, text), so a real parser would be
// over-engineering for this PR. Promotion to a proper Json
// stdlib module can come later if hover/completion need it.

public class LspServer {
    // Parallel arrays: DocUris[i] is the URI of the open document
    // whose latest text is in Docs[i]. Small N expected (one or
    // two open files in an editor session).
    private DocUris: List<string>
    private Docs:    List<string>

    // Workspace cache. The full set of `.am` files reachable from
    // the project root is parsed once on first use and reused for
    // every subsequent BuildWorkspaceResolver call. Per-request the
    // open file's freshly-parsed AST overrides the cached entry, so
    // editor-fresh text always wins on the active document; sibling
    // files use the on-disk version (good enough for the typical
    // single-file-edit workflow). Cache is keyed on the resolved
    // workspace root — switching projects rebuilds it once.
    private CachedRoot:         string
    private CachedSiblingPaths: List<string>
    private CachedSiblingProgs: List<AstNode>

    public LspServer() {
        this.DocUris             = new List<string>()
        this.Docs                = new List<string>()
        this.CachedRoot          = ""
        this.CachedSiblingPaths  = new List<string>()
        this.CachedSiblingProgs  = new List<AstNode>()
    }

    // ── Main loop ─────────────────────────────────────
    //
    // Each LSP message is one JSON document. Parse it once with
    // Amalgame.Json, then walk into the structured params via
    // Get(...) chains rather than the old key-substring extractors.
    //
    public int Run() {
        while (true) {
            let body = this.ReadMessage()
            if (String_Length(body) == 0) { return 0 }
            let parsed = Json.Parse(body)
            if (!parsed.Ok) { continue }
            let root: JsonValue   = parsed.Value
            let method: string    = root.Get("method").AsString()
            let id: int           = root.Get("id").AsInt()
            let params: JsonValue = root.Get("params")
            let td: JsonValue     = params.Get("textDocument")
            let pos: JsonValue    = params.Get("position")

            if (method == "initialize") {
                this.SendInit(id)
            } else if (method == "shutdown") {
                this.SendShutdown(id)
            } else if (method == "exit") {
                return 0
            } else if (method == "textDocument/didOpen") {
                let uri: string = td.Get("uri").AsString()
                let txt: string = td.Get("text").AsString()
                this.UpsertDoc(uri, txt)
                this.PublishDiagnostics(uri, txt)
            } else if (method == "textDocument/didChange") {
                // Full sync: client re-sends the whole document text
                // under contentChanges[0].text.
                let uri: string        = td.Get("uri").AsString()
                let changes: JsonValue = params.Get("contentChanges")
                let txt: string        = changes.At(0).Get("text").AsString()
                this.UpsertDoc(uri, txt)
                this.PublishDiagnostics(uri, txt)
            } else if (method == "textDocument/didClose") {
                let uri: string = td.Get("uri").AsString()
                this.RemoveDoc(uri)
            } else if (method == "textDocument/hover") {
                let uri: string  = td.Get("uri").AsString()
                let line: int    = pos.Get("line").AsInt()
                let chr: int     = pos.Get("character").AsInt()
                this.HandleHover(id, uri, line, chr)
            } else if (method == "textDocument/completion") {
                let uri: string  = td.Get("uri").AsString()
                let line: int    = pos.Get("line").AsInt()
                let chr: int     = pos.Get("character").AsInt()
                this.HandleCompletion(id, uri, line, chr)
            } else if (method == "textDocument/definition" || method == "textDocument/declaration" || method == "textDocument/typeDefinition") {
                // declaration / typeDefinition both alias definition
                // until we differentiate (declaration: same as
                // definition since Amalgame has no forward-decl split;
                // typeDefinition: identical for now, refinement once
                // the typechecker exposes inferred types per node).
                let uri: string  = td.Get("uri").AsString()
                let line: int    = pos.Get("line").AsInt()
                let chr: int     = pos.Get("character").AsInt()
                this.HandleDefinition(id, uri, line, chr)
            } else if (method == "textDocument/documentSymbol") {
                let uri: string = td.Get("uri").AsString()
                this.HandleDocumentSymbol(id, uri)
            } else if (method == "workspace/symbol") {
                let q: string = params.Get("query").AsString()
                this.HandleWorkspaceSymbol(id, q)
            } else if (method == "textDocument/references") {
                let uri: string = td.Get("uri").AsString()
                let line: int   = pos.Get("line").AsInt()
                let chr: int    = pos.Get("character").AsInt()
                this.HandleReferences(id, uri, line, chr)
            } else if (method == "textDocument/rename") {
                let uri: string     = td.Get("uri").AsString()
                let line: int       = pos.Get("line").AsInt()
                let chr: int        = pos.Get("character").AsInt()
                let newName: string = params.Get("newName").AsString()
                this.HandleRename(id, uri, line, chr, newName)
            } else if (method == "textDocument/prepareRename") {
                let uri: string = td.Get("uri").AsString()
                let line: int   = pos.Get("line").AsInt()
                let chr: int    = pos.Get("character").AsInt()
                this.HandlePrepareRename(id, uri, line, chr)
            } else if (method == "textDocument/prepareCallHierarchy") {
                let uri: string = td.Get("uri").AsString()
                let line: int   = pos.Get("line").AsInt()
                let chr: int    = pos.Get("character").AsInt()
                this.HandlePrepareCallHierarchy(id, uri, line, chr)
            } else if (method == "callHierarchy/incomingCalls") {
                let item: JsonValue = params.Get("item")
                this.HandleIncomingCalls(id, item)
            } else if (method == "callHierarchy/outgoingCalls") {
                let item: JsonValue = params.Get("item")
                this.HandleOutgoingCalls(id, item)
            } else if (method == "textDocument/inlayHint") {
                let uri: string = td.Get("uri").AsString()
                this.HandleInlayHint(id, uri)
            } else if (method == "textDocument/codeAction") {
                let uri: string  = td.Get("uri").AsString()
                let range        = params.Get("range")
                let rs           = range.Get("start")
                let re           = range.Get("end")
                let sl: int      = rs.Get("line").AsInt()
                let sc: int      = rs.Get("character").AsInt()
                let el: int      = re.Get("line").AsInt()
                let ec: int      = re.Get("character").AsInt()
                this.HandleCodeAction(id, uri, sl, sc, el, ec)
            }
            // Unknown method: ignore. LSP allows the server to skip
            // unhandled notifications, and we don't want to crash on
            // optional capability negotiation messages.
        }
        return 0
    }

    // ── Document storage ──────────────────────────────
    // Replace-or-insert. List<T> has no Set(idx, val) op, so we
    // remove + append on update. N is small (open file count) so
    // the linear scan is fine.
    private void UpsertDoc(string uri, string text) {
        let n = this.DocUris.Count()
        for i in 0..n {
            let u = this.DocUris.Get(i)
            if (u == uri) {
                this.DocUris.RemoveAt(i)
                this.Docs.RemoveAt(i)
                this.DocUris.Add(uri)
                this.Docs.Add(text)
                return
            }
        }
        this.DocUris.Add(uri)
        this.Docs.Add(text)
    }

    private void RemoveDoc(string uri) {
        let n = this.DocUris.Count()
        for i in 0..n {
            let u = this.DocUris.Get(i)
            if (u == uri) {
                this.DocUris.RemoveAt(i)
                this.Docs.RemoveAt(i)
                return
            }
        }
    }

    // Return the latest text for a tracked URI. Empty string if unknown
    // (the client should have sent didOpen first; we don't error here
    // because LSP allows hover/completion on closed buffers in theory).
    private string LookupDoc(string uri) {
        let n = this.DocUris.Count()
        for i in 0..n {
            let u = this.DocUris.Get(i)
            if (u == uri) { return this.Docs.Get(i) }
        }
        return ""
    }

    // ── Framing ───────────────────────────────────────
    // Read headers line-by-line until blank line, then read
    // exactly Content-Length bytes from stdin. Returns "" on EOF.
    private string ReadMessage() {
        var contentLen = 0
        var sawAnyHeader = false
        while (true) {
            let raw  = Console_ReadLine()
            let line = String_TrimEnd(raw)
            if (String_Length(line) == 0) {
                // EOF *before* any header: stdin closed.
                if (String_Length(raw) == 0 && !sawAnyHeader) {
                    return ""
                }
                // Blank line ends the header block.
                break
            }
            sawAnyHeader = true
            if (String_StartsWith(line, "Content-Length:")) {
                let lineLen: int = String_Length(line)
                let rest         = String_Substring(line, 15, lineLen - 15)
                contentLen       = String_ToInt(String_Trim(rest))
            }
        }
        if (contentLen <= 0) { return "" }
        return Console_ReadBytes(contentLen)
    }

    // Build a single CR byte (0x0d). `"\r"` and `"\x0d"` are both
    // mis-lexed by the bootstrapping amc, so we route through
    // String_FromByte which is just an int→byte builtin and has
    // no escape-table dependency.
    public static string Cr() { return String_FromByte(13) }

    // Write a framed JSON-RPC message. fflush so the client
    // doesn't block waiting for buffered output. CRLF is built
    // explicitly from bytes — see Cr() above.
    private void Send(string body) {
        let n: int  = String_Length(body)
        let crlf    = LspServer.Cr() + "\n"
        Console.Write("Content-Length: " + String_FromInt(n) + crlf + crlf)
        Console.Write(body)
        Console_Flush()
    }

    // ── Responses ─────────────────────────────────────
    private void SendInit(int id) {
        // textDocumentSync = 1 (Full): client sends the whole text
        // on every didChange. Simpler than incremental, fine for v1.
        // hoverProvider:  true  → client may send textDocument/hover
        // completionProvider: { triggerCharacters: ["."] } → client
        // requests completion lists on demand or when typing a dot.
        // definitionProvider / declarationProvider: true → client
        // may send textDocument/definition (Cmd+Click in VS Code).
        // declaration aliases definition since Amalgame has no
        // separate declaration/definition split.
        // documentSymbolProvider: true → outline view (Ctrl+Shift+O,
        // left-pane Outline panel) shows top-level + member decls.
        // typeDefinitionProvider: true → "Go to Type Definition"
        // (Cmd+K F12 in VS Code). Identical to definition for now;
        // diverges once the typechecker exposes per-node inferred
        // types so we can route on the receiver's TYPE rather than
        // the receiver's class.
        // workspaceSymbolProvider: true → Ctrl+T (project-wide
        // fuzzy symbol search across every cached `.am` file).
        // referencesProvider: true → Find All References / Shift+F12
        // (walks every program for IDENTIFIER/MEMBER name matches).
        // renameProvider with prepareProvider: F2 / right-click
        // "Rename Symbol" — VS Code calls prepareRename first to
        // confirm the symbol is renameable and to scope the input
        // box to the actual identifier span.
        // callHierarchyProvider: true → Shift+Alt+H "Show Call
        // Hierarchy", supports both incoming and outgoing calls.
        let body = "{\"jsonrpc\":\"2.0\",\"id\":" + String_FromInt(id) + ",\"result\":{\"capabilities\":{\"textDocumentSync\":1,\"hoverProvider\":true,\"definitionProvider\":true,\"declarationProvider\":true,\"typeDefinitionProvider\":true,\"documentSymbolProvider\":true,\"workspaceSymbolProvider\":true,\"referencesProvider\":true,\"renameProvider\":{\"prepareProvider\":true},\"callHierarchyProvider\":true,\"inlayHintProvider\":true,\"codeActionProvider\":true,\"completionProvider\":{\"triggerCharacters\":[\".\"]}}}}"
        this.Send(body)
    }

    private void SendShutdown(int id) {
        let body = "{\"jsonrpc\":\"2.0\",\"id\":" + String_FromInt(id) + ",\"result\":null}"
        this.Send(body)
    }

    private void PublishDiagnostics(string uri, string source) {
        let diags = this.Compile(uri, source)
        let body  = "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":\"" + Json.EscapeString(uri) + "\",\"diagnostics\":" + diags + "}}"
        this.Send(body)
    }

    // Build a FullResolver populated with ALL *.am files reachable
    // from the workspace root (detected by walking up from `path`
    // until a marker dir/file like .git or build_amc.sh is found).
    // The open document is the first program added; sibling files
    // follow. Two passes run as in main.am — CollectDecl across all
    // programs (so cross-file types like NodeKind from
    // src/parser/ast.am are visible everywhere), then ResolveDecl.
    //
    // This is what un-breaks the IDE: before this, opening any file
    // that referenced a type defined in another file produced a
    // forest of red "Unknown symbol" squiggles even though the build
    // was green. Diagnostics for sibling files are filtered out by
    // the caller (see Compile) so the editor only sees errors for
    // the document it's actually showing.
    private FullResolver BuildWorkspaceResolver(string path, AstNode prog) {
        let resolver = new FullResolver()
        resolver.Programs.Add(prog)
        this.EnsureWorkspaceCache(path)
        // Add cached siblings, skipping any whose path matches the
        // current open file (prog already covers it with editor-
        // fresh text). The path-equality check guards against the
        // workspace scan having picked the open file up too — find
        // returns it under its real disk path, currentPath comes
        // from UriToPath; both sides are decoded post-PR #227 so
        // string equality holds.
        let n: int = this.CachedSiblingPaths.Count()
        for i in 0..n {
            let cachedPath: string = this.CachedSiblingPaths.Get(i)
            if (cachedPath == path) { continue }
            resolver.Programs.Add(this.CachedSiblingProgs.Get(i))
        }
        resolver.ResolvePrograms()
        return resolver
    }

    // Populate the workspace cache on first use, or after the user
    // navigates to a different project root. Once populated, the
    // cache lives for the LSP server's lifetime — siblings change
    // rarely in practice (the active file's edits override the
    // cached entry per request, see BuildWorkspaceResolver). The
    // explicit invalidation hooks for didCreate / didDelete /
    // out-of-band edits land in slice 2.
    private void EnsureWorkspaceCache(string currentPath) {
        let root: string = LspServer.FindWorkspaceRoot(currentPath)
        if (String_Length(root) == 0) { return }
        if (root == this.CachedRoot && this.CachedSiblingPaths.Count() > 0) { return }
        this.CachedRoot         = root
        this.CachedSiblingPaths = new List<string>()
        this.CachedSiblingProgs = new List<AstNode>()
        // 2>/dev/null swallows "permission denied" noise from any
        // unrelated subtrees; on MSYS2 / POSIX `find` is universally
        // available (already used by `amc test` discovery).
        let findCmd: string = "find " + root + " -name '*.am' -type f 2>/dev/null"
        let result = Process.RunCapture(findCmd)
        if (result.Exit != 0) { return }
        let lines: List<string> = String_Split(String_Trim(result.Stdout), "\n")
        let n: int = lines.Count()
        for i in 0..n {
            let path: string = String_Trim(lines.Get(i))
            if (String_Length(path) == 0) { continue }
            if (!File.Exists(path)) { continue }
            let src: string = File.ReadAll(path)
            let lex  = new Lexer(src, path)
            let toks = lex.Tokenize()
            let par  = new Parser(toks)
            let p    = par.Parse()
            p.Str2   = path
            this.CachedSiblingPaths.Add(path)
            this.CachedSiblingProgs.Add(p)
        }
    }

    // Walk up from `startPath`'s directory until we find a marker
    // file (`.git`, `build_amc.sh`, or `package.json`) or run out
    // of parents. Returns the marker's parent directory, or the
    // start directory as a fallback. 8 levels is enough for sane
    // project layouts; anything deeper falls back to the file's
    // own directory and works file-locally.
    public static string FindWorkspaceRoot(string startPath) {
        var dir: string = LspServer.Dirname(startPath)
        let initialDir: string = dir
        for i in 0..8 {
            if (String_Length(dir) == 0) { return initialDir }
            if (File.Exists(dir + "/.git")) { return dir }
            if (File.Exists(dir + "/build_amc.sh")) { return dir }
            if (File.Exists(dir + "/package.json")) { return dir }
            let parent: string = LspServer.Dirname(dir)
            if (parent == dir) { return initialDir }
            dir = parent
        }
        return initialDir
    }

    public static string Dirname(string path) {
        let last: int = String_LastIndexOf(path, "/")
        if (last <= 0) { return "" }
        return String_Substring(path, 0, last)
    }

    // Run the same lex+parse+resolve+typecheck pipeline `main.am`
    // does for one file, then turn the collected errors into a
    // JSON array of LSP Diagnostic objects. Sibling files are loaded
    // by BuildWorkspaceResolver so cross-file type references resolve;
    // diagnostics are filtered to the open document so the editor
    // only sees errors for the file it's showing.
    private string Compile(string uri, string source) {
        let path = LspServer.UriToPath(uri)
        let lex  = new Lexer(source, path)
        let toks = lex.Tokenize()
        let par  = new Parser(toks)
        let prog = par.Parse()
        prog.Str2 = path

        let resolver = this.BuildWorkspaceResolver(path, prog)

        let tc = new TypeChecker(resolver, path)
        tc.Check(prog)

        var arr   = "["
        var first = true
        let rn = resolver.RawErrors.Count()
        for ri in 0..rn {
            let e: ResolverError = resolver.RawErrors.Get(ri)
            if (e.Filename != path) { continue }
            if (!first) { arr = arr + "," }
            arr = arr + LspServer.DiagnosticFromResolver(source, e)
            first = false
        }
        let tn = tc.Errors.Count()
        for ti in 0..tn {
            let te: TypeError = tc.Errors.Get(ti)
            if (te.Filename != path) { continue }
            if (!first) { arr = arr + "," }
            arr = arr + LspServer.DiagnosticFromTc(source, te)
            first = false
        }
        arr = arr + "]"
        return arr
    }

    // ── Hover ─────────────────────────────────────────

    private void HandleHover(int id, string uri, int line, int character) {
        let source = this.LookupDoc(uri)
        if (String_Length(source) == 0) {
            this.SendNullResult(id)
            return
        }
        let path = LspServer.UriToPath(uri)
        let lex  = new Lexer(source, path)
        let toks = lex.Tokenize()
        let par  = new Parser(toks)
        let prog = par.Parse()
        prog.Str2 = path
        let resolver = this.BuildWorkspaceResolver(path, prog)
        let tc = new TypeChecker(resolver, path)
        tc.Check(prog)

        // LSP positions are 0-based; AST is 1-based.
        let targetLine: int = line + 1
        let targetCol:  int = character + 1
        let node = LspServer.FindNodeAtPosition(prog, targetLine, targetCol)
        if (node == null) {
            this.SendNullResult(id)
            return
        }
        let typeStr = tc.LookupNodeType(node)
        if (typeStr == "?" || String_Length(typeStr) == 0) {
            // No inferred type for this node — common for declarations,
            // statements, keywords, etc. Return null so the editor
            // shows "no info" instead of an empty popup.
            this.SendNullResult(id)
            return
        }
        let content = "**" + node.Name + "**: `" + typeStr + "`"
        let body = "{\"jsonrpc\":\"2.0\",\"id\":" + String_FromInt(id) + ",\"result\":{\"contents\":{\"kind\":\"markdown\",\"value\":\"" + Json.EscapeString(content) + "\"}}}"
        this.Send(body)
    }

    private void SendNullResult(int id) {
        let body = "{\"jsonrpc\":\"2.0\",\"id\":" + String_FromInt(id) + ",\"result\":null}"
        this.Send(body)
    }

    // ── Definition ────────────────────────────────────
    //
    // Slice 1: walk the workspace's top-level decls, return the
    // first match by name. Covers classes, enums, interfaces,
    // standalone (well, on-class-static) functions — every name
    // that appears at file scope across the workspace.
    //
    // Out of scope here: member methods, fields, locals, parameters,
    // imports. They land in slice 2 once we extend the resolver to
    // expose declaration AstNodes for non-top-level symbols. The
    // common Cmd+Click case (jump to a class or enum used somewhere)
    // already works against this v1.
    private void HandleDefinition(int id, string uri, int line, int character) {
        let source = this.LookupDoc(uri)
        if (String_Length(source) == 0) {
            this.SendNullResult(id)
            return
        }
        let path = LspServer.UriToPath(uri)
        let lex  = new Lexer(source, path)
        let toks = lex.Tokenize()
        let par  = new Parser(toks)
        let prog = par.Parse()
        prog.Str2 = path
        let resolver = this.BuildWorkspaceResolver(path, prog)

        let targetLine: int = line + 1
        let targetCol:  int = character + 1
        let node = LspServer.FindNodeAtPosition(prog, targetLine, targetCol)
        if (node == null) {
            this.SendNullResult(id)
            return
        }

        let enclosing: AstNode? = LspServer.FindEnclosingMethod(prog, targetLine)

        // Member-def first: when the click lands on the right side
        // of a MEMBER expression (e.g. `obj.method` / `obj.field`),
        // jump into the receiver's class declaration. Try this
        // before the local-by-name search so `obj.x` doesn't get
        // misrouted to a same-named local in the same method.
        // Walk the receiver type's class in the workspace, return
        // the first METHOD_DECL or VAR_DECL whose Name matches the
        // member token. Falls through to the regular search if the
        // receiver type can't be resolved or the member isn't found.
        if (node.Kind == NodeKind.MEMBER && enclosing != null) {
            if (node.Left != null && node.Left.Kind == NodeKind.IDENTIFIER) {
                let recv: AstNode? = LspServer.LookupLocalInMethod(enclosing, node.Left.Name)
                if (recv != null) {
                    let recvType: string = LspServer.BareTypeName(recv.Str)
                    if (String_Length(recvType) > 0) {
                        let nProgs2: int = resolver.Programs.Count()
                        for i in 0..nProgs2 {
                            let p2: AstNode = resolver.Programs.Get(i)
                            let dc2: int = p2.Children.Count()
                            for j in 0..dc2 {
                                let cls: AstNode = p2.Children.Get(j)
                                if (cls.Kind != NodeKind.CLASS_DECL) { continue }
                                if (cls.Name != recvType) { continue }
                                let mc: int = cls.Children.Count()
                                for k2 in 0..mc {
                                    let m: AstNode = cls.Children.Get(k2)
                                    let mk = m.Kind
                                    if (mk != NodeKind.METHOD_DECL && mk != NodeKind.VAR_DECL) { continue }
                                    if (m.Name != node.Name) { continue }
                                    var memPath: string = p2.Str2
                                    if (String_Length(memPath) == 0) { memPath = path }
                                    this.SendDefinitionLocation(id, memPath, m.Line, m.Column, m.Name)
                                    return
                                }
                            }
                        }
                    }
                }
            }
        }

        // For MEMBER nodes (e.g. `NodeKind.METHOD_DECL`), the left
        // child carries the type name the user most likely wants
        // — VS Code separately offers `typeDefinition` for that
        // case. Falling back to `node.Name` covers IDENTIFIER too.
        var lookup: string = node.Name
        if (node.Kind == NodeKind.MEMBER) {
            if (node.Left != null && node.Left.Kind == NodeKind.IDENTIFIER) {
                lookup = node.Left.Name
            }
        }
        if (String_Length(lookup) == 0) {
            this.SendNullResult(id)
            return
        }

        // Search the enclosing method's params + locals in the OPEN
        // file. Common case (clicking on a parameter or a `let`
        // binding) — top-level search would miss those.
        if (enclosing != null) {
            let local: AstNode? = LspServer.LookupLocalInMethod(enclosing, lookup)
            if (local != null) {
                this.SendDefinitionLocation(id, path, local.Line, local.Column, lookup)
                return
            }
        }

        // Second pass: search every workspace program's top-level
        // children (classes, enums, interfaces).
        let nProgs: int = resolver.Programs.Count()
        for i in 0..nProgs {
            let p: AstNode = resolver.Programs.Get(i)
            let nDecls: int = p.Children.Count()
            for j in 0..nDecls {
                let decl: AstNode = p.Children.Get(j)
                if (decl.Name == lookup) {
                    var declPath: string = p.Str2
                    if (String_Length(declPath) == 0) { declPath = path }
                    this.SendDefinitionLocation(id, declPath, decl.Line, decl.Column, lookup)
                    return
                }
            }
        }

        this.SendNullResult(id)
    }

    // Strip type annotations down to the bare class name for the
    // member-def lookup. `MigrateResult?` → `MigrateResult`,
    // `List<int>` → `List`, `Outer*` → `Outer`. Works for the simple
    // shape user code carries on let / param annotations; generic
    // unwrapping for nested `List<MigrateResult>` lookups is slice 3.
    private static string BareTypeName(string raw) {
        var t: string = raw
        if (String_Length(t) == 0) { return "" }
        if (String_EndsWith(t, "?")) {
            t = String_Substring(t, 0, String_Length(t) - 1)
        }
        if (String_EndsWith(t, "*")) {
            t = String_Substring(t, 0, String_Length(t) - 1)
        }
        let lt: int = String_IndexOf(t, "<")
        if (lt >= 0) {
            t = String_Substring(t, 0, lt)
        }
        return t
    }

    // Find the METHOD_DECL whose body contains `targetLine`. Walks
    // every class top-level + its method children and picks the
    // method with the largest start Line <= targetLine. Approximate
    // (we don't track each method's end line on the AstNode) but
    // works for the common-case clicks inside one method body — if
    // the user clicks on a class field declared between two
    // methods, the "enclosing" method is the one above; that field
    // isn't in any method's Params/Body, so the lookup falls
    // through to the workspace top-level pass.
    private static AstNode? FindEnclosingMethod(AstNode prog, int targetLine) {
        var best: AstNode? = null
        var bestLine: int = -1
        let dc: int = prog.Children.Count()
        for i in 0..dc {
            let decl: AstNode = prog.Children.Get(i)
            if (decl.Kind != NodeKind.CLASS_DECL) { continue }
            let mc: int = decl.Children.Count()
            for j in 0..mc {
                let m: AstNode = decl.Children.Get(j)
                if (m.Kind != NodeKind.METHOD_DECL) { continue }
                if (m.Line > targetLine) { continue }
                if (m.Line > bestLine) {
                    bestLine = m.Line
                    best     = m
                }
            }
        }
        return best
    }

    // Search a method's parameters + local var-decls for a name
    // match. Params are direct PARAM children; locals are VAR_DECL
    // nodes encountered while walking the body. Returns the first
    // match, or null. Used by HandleDefinition's first pass before
    // it falls through to the workspace top-level walk.
    private static AstNode? LookupLocalInMethod(AstNode method, string name) {
        let pc: int = method.Params.Count()
        for i in 0..pc {
            let p: AstNode = method.Params.Get(i)
            if (p.Name == name) { return p }
        }
        return LspServer.FindLocalVarDecl(method.Body, name)
    }

    // Recursive walker for the method body — collects the first
    // VAR_DECL whose Name matches. Stops at nested method/class
    // bodies so an inner closure's locals don't leak out (closures
    // are just lambda METHOD_DECLs in our AST).
    private static AstNode? FindLocalVarDecl(AstNode node, string name) {
        if (node == null) { return null }
        let k = node.Kind
        if (k == NodeKind.METHOD_DECL || k == NodeKind.CLASS_DECL) { return null }
        if (k == NodeKind.VAR_DECL && node.Name == name) { return node }
        // Descend through every child slot the parser might
        // populate. AstNode child fields parallel what the cgen's
        // lambda hoister walks.
        if (node.Left != null) {
            let r1: AstNode? = LspServer.FindLocalVarDecl(node.Left, name)
            if (r1 != null) { return r1 }
        }
        if (node.Right != null) {
            let r2: AstNode? = LspServer.FindLocalVarDecl(node.Right, name)
            if (r2 != null) { return r2 }
        }
        if (node.Cond != null) {
            let r3: AstNode? = LspServer.FindLocalVarDecl(node.Cond, name)
            if (r3 != null) { return r3 }
        }
        if (node.Body != null) {
            let r4: AstNode? = LspServer.FindLocalVarDecl(node.Body, name)
            if (r4 != null) { return r4 }
        }
        if (node.Else != null) {
            let r5: AstNode? = LspServer.FindLocalVarDecl(node.Else, name)
            if (r5 != null) { return r5 }
        }
        let cn: int = node.Children.Count()
        for i in 0..cn {
            let r6: AstNode? = LspServer.FindLocalVarDecl(node.Children.Get(i), name)
            if (r6 != null) { return r6 }
        }
        return null
    }

    // ── Document symbol (outline) ─────────────────────
    //
    // Walk the open file's AST and emit a `DocumentSymbol[]` tree.
    // VS Code shows it in the Outline panel + breadcrumbs +
    // Ctrl+Shift+O fuzzy-find. The shape per LSP spec:
    //
    //   { name, kind, range, selectionRange, children }
    //
    // - `range` covers the whole declaration body (not strictly
    //   required to be tight; we approximate with the decl line
    //   to keep this slice 2 small).
    // - `selectionRange` is the symbol name itself — the AST
    //   stores the keyword's column rather than the name's, so
    //   we widen by `name.length` for now.
    // - `children` recurses into class members for the nested
    //   tree the Outline panel renders.
    //
    // SymbolKind values per LSP spec:
    //   5  Class    6  Method     7  Property   8  Field
    //  10  Enum    11  Interface 22  EnumMember
    private void HandleDocumentSymbol(int id, string uri) {
        let source = this.LookupDoc(uri)
        if (String_Length(source) == 0) {
            this.Send("{\"jsonrpc\":\"2.0\",\"id\":" + String_FromInt(id) + ",\"result\":[]}")
            return
        }
        let path = LspServer.UriToPath(uri)
        let lex  = new Lexer(source, path)
        let toks = lex.Tokenize()
        let par  = new Parser(toks)
        let prog = par.Parse()
        var json: string = "["
        let n: int = prog.Children.Count()
        var first: bool = true
        for i in 0..n {
            let decl: AstNode = prog.Children.Get(i)
            let entry: string = LspServer.SymbolForDecl(decl)
            if (String_Length(entry) > 0) {
                if (!first) { json = json + "," }
                json = json + entry
                first = false
            }
        }
        json = json + "]"
        let body = "{\"jsonrpc\":\"2.0\",\"id\":" + String_FromInt(id) + ",\"result\":" + json + "}"
        this.Send(body)
    }

    // Map an AstNode top-level decl to a DocumentSymbol JSON, or
    // empty string if the node isn't a decl we surface. Recurses
    // into class/enum members to populate `children`.
    private static string SymbolForDecl(AstNode decl) {
        let k = decl.Kind
        var kind: int = 0
        if (k == NodeKind.CLASS_DECL)     { kind = 5 }
        else if (k == NodeKind.ENUM_DECL) { kind = 10 }
        else { return "" }
        let name: string = decl.Name
        if (String_Length(name) == 0) { return "" }
        var children: string = "["
        var firstChild: bool = true
        let mc: int = decl.Children.Count()
        for i in 0..mc {
            let m: AstNode = decl.Children.Get(i)
            let mk = m.Kind
            var ckind: int = 0
            // Class/interface members
            if (mk == NodeKind.METHOD_DECL) { ckind = 6 }
            if (mk == NodeKind.VAR_DECL)    { ckind = 8 }
            // Enum variants are stored as bare IDENTIFIER nodes —
            // one per `EnumName.Variant` declaration line.
            if (k == NodeKind.ENUM_DECL && mk == NodeKind.IDENTIFIER) { ckind = 22 }
            if (ckind == 0) { continue }
            if (String_Length(m.Name) == 0) { continue }
            if (!firstChild) { children = children + "," }
            children = children + LspServer.SymbolEntry(m.Name, ckind, m.Line, m.Column, "[]")
            firstChild = false
        }
        children = children + "]"
        return LspServer.SymbolEntry(name, kind, decl.Line, decl.Column, children)
    }

    // Build a single DocumentSymbol JSON object. Both `range` and
    // `selectionRange` cover the same span — start of the decl
    // line, length of the symbol name. VS Code accepts a coarser
    // range; tight ranges are slice 3.
    private static string SymbolEntry(string name, int kind, int line, int col, string childrenJson) {
        let lineLsp: int = line - 1
        let colLsp:  int = col - 1
        let nameLen: int = String_Length(name)
        let endCol:  int = colLsp + nameLen
        let range: string = "{\"start\":{\"line\":" + String_FromInt(lineLsp) + ",\"character\":" + String_FromInt(colLsp) + "},\"end\":{\"line\":" + String_FromInt(lineLsp) + ",\"character\":" + String_FromInt(endCol) + "}}"
        return "{\"name\":\"" + Json.EscapeString(name) + "\",\"kind\":" + String_FromInt(kind) + ",\"range\":" + range + ",\"selectionRange\":" + range + ",\"children\":" + childrenJson + "}"
    }

    // ── References (Find All References / Shift+F12) ──
    //
    // Walks every program in the workspace (cached siblings +
    // current open file's freshly-parsed AST) and collects every
    // IDENTIFIER / MEMBER node whose `Name` matches the symbol
    // under the cursor. Returns a `Location[]` per LSP spec.
    //
    // Scope-unaware on this pass — two different locals with the
    // same name will both surface. Acceptable starting point: the
    // primary use case (rename / refactor visibility) is for
    // class/enum/method names which are workspace-unique anyway.
    // Scope-aware filtering is a slice-3 follow-up.
    private void HandleReferences(int id, string uri, int line, int character) {
        let source = this.LookupDoc(uri)
        if (String_Length(source) == 0) {
            this.Send("{\"jsonrpc\":\"2.0\",\"id\":" + String_FromInt(id) + ",\"result\":[]}")
            return
        }
        let path = LspServer.UriToPath(uri)
        let lex  = new Lexer(source, path)
        let toks = lex.Tokenize()
        let par  = new Parser(toks)
        let prog = par.Parse()
        prog.Str2 = path
        let resolver = this.BuildWorkspaceResolver(path, prog)

        let targetLine: int = line + 1
        let targetCol:  int = character + 1
        let node = LspServer.FindNodeAtPosition(prog, targetLine, targetCol)
        if (node == null) {
            this.Send("{\"jsonrpc\":\"2.0\",\"id\":" + String_FromInt(id) + ",\"result\":[]}")
            return
        }
        let target: string = node.Name
        if (String_Length(target) == 0) {
            this.Send("{\"jsonrpc\":\"2.0\",\"id\":" + String_FromInt(id) + ",\"result\":[]}")
            return
        }

        var json: string = "["
        var first: bool = true
        let nProgs: int = resolver.Programs.Count()
        for i in 0..nProgs {
            let p: AstNode  = resolver.Programs.Get(i)
            var filePath: string = p.Str2
            if (String_Length(filePath) == 0) { filePath = path }
            let entries: List<string> = new List<string>()
            LspServer.CollectReferences(p, target, filePath, entries)
            let ec: int = entries.Count()
            for j in 0..ec {
                if (!first) { json = json + "," }
                json = json + entries.Get(j)
                first = false
            }
        }
        json = json + "]"
        let body = "{\"jsonrpc\":\"2.0\",\"id\":" + String_FromInt(id) + ",\"result\":" + json + "}"
        this.Send(body)
    }

    // Recursive AST walker that appends one Location-shaped JSON
    // string per IDENTIFIER / MEMBER whose Name == target. The
    // AstNode child fields walked here mirror what the cgen lambda
    // hoister walks (Left/Right/Cond/Body/Else/Children/Params/
    // Args) so any new positional child added to the AST surfaces
    // in references automatically.
    private static void CollectReferences(AstNode node, string target, string filePath, List<string> out) {
        if (node == null) { return }
        let k = node.Kind
        if (k == NodeKind.IDENTIFIER || k == NodeKind.MEMBER) {
            if (node.Name == target) {
                out.Add(LspServer.LocationJson(filePath, node.Line, node.Column, target))
            }
        }
        if (node.Left  != null) { LspServer.CollectReferences(node.Left,  target, filePath, out) }
        if (node.Right != null) { LspServer.CollectReferences(node.Right, target, filePath, out) }
        if (node.Cond  != null) { LspServer.CollectReferences(node.Cond,  target, filePath, out) }
        if (node.Body  != null) { LspServer.CollectReferences(node.Body,  target, filePath, out) }
        if (node.Else  != null) { LspServer.CollectReferences(node.Else,  target, filePath, out) }
        let cn: int = node.Children.Count()
        for i in 0..cn {
            LspServer.CollectReferences(node.Children.Get(i), target, filePath, out)
        }
        let pn: int = node.Params.Count()
        for j in 0..pn {
            LspServer.CollectReferences(node.Params.Get(j), target, filePath, out)
        }
        let an: int = node.Args.Count()
        for k2 in 0..an {
            LspServer.CollectReferences(node.Args.Get(k2), target, filePath, out)
        }
    }

    // Build a Location JSON object string. Same shape as the
    // definition reply, factored out so HandleReferences can emit
    // many of these in one array without reaching for SendDefinitionLocation.
    private static string LocationJson(string filePath, int line, int col, string name) {
        let lineLsp: int = line - 1
        let colLsp:  int = col - 1
        let nameLen: int = String_Length(name)
        let endCol:  int = colLsp + nameLen
        let uri:     string = "file://" + LspServer.PercentEncodePath(filePath)
        let range: string = "{\"start\":{\"line\":" + String_FromInt(lineLsp) + ",\"character\":" + String_FromInt(colLsp) + "},\"end\":{\"line\":" + String_FromInt(lineLsp) + ",\"character\":" + String_FromInt(endCol) + "}}"
        return "{\"uri\":\"" + Json.EscapeString(uri) + "\",\"range\":" + range + "}"
    }

    // ── Rename (F2) ───────────────────────────────────
    //
    // Find every IDENTIFIER / MEMBER whose Name matches the symbol
    // under the cursor (same walker `references` uses) and emit a
    // WorkspaceEdit:
    //
    //   { "changes": { "<uri1>": [TextEdit, ...], "<uri2>": [...] } }
    //
    // Each TextEdit is `{ range, newText }` where range covers the
    // old name span and newText is the user's chosen replacement.
    // The receiver's class field/method declarations themselves are
    // captured because the walker visits every CLASS_DECL /
    // METHOD_DECL / VAR_DECL Name string via their AST nodes —
    // those are stored as `.Name` strings, not separate IDENTIFIER
    // children, so they're effectively renamed by the same
    // operation when the user-facing Name matches.
    //
    // Scope-unaware: same caveat as references — two unrelated
    // locals named the same will both get renamed. Acceptable for
    // workspace-unique names (classes, enums, top-level methods),
    // which is the typical rename target.
    private void HandleRename(int id, string uri, int line, int character, string newName) {
        let source = this.LookupDoc(uri)
        if (String_Length(source) == 0) {
            this.Send("{\"jsonrpc\":\"2.0\",\"id\":" + String_FromInt(id) + ",\"result\":{\"changes\":{}}}")
            return
        }
        if (String_Length(newName) == 0) {
            this.Send("{\"jsonrpc\":\"2.0\",\"id\":" + String_FromInt(id) + ",\"result\":{\"changes\":{}}}")
            return
        }
        let path = LspServer.UriToPath(uri)
        let lex  = new Lexer(source, path)
        let toks = lex.Tokenize()
        let par  = new Parser(toks)
        let prog = par.Parse()
        prog.Str2 = path
        let resolver = this.BuildWorkspaceResolver(path, prog)

        let targetLine: int = line + 1
        let targetCol:  int = character + 1
        let node = LspServer.FindNodeAtPosition(prog, targetLine, targetCol)
        if (node == null) {
            this.Send("{\"jsonrpc\":\"2.0\",\"id\":" + String_FromInt(id) + ",\"result\":{\"changes\":{}}}")
            return
        }
        let target: string = node.Name
        if (String_Length(target) == 0) {
            this.Send("{\"jsonrpc\":\"2.0\",\"id\":" + String_FromInt(id) + ",\"result\":{\"changes\":{}}}")
            return
        }

        // Walk every program; build the WorkspaceEdit `changes` map
        // directly. Parallel lists rather than Map<K,V> here because
        // the bundled cgen we ship for cold-start clones predates
        // the Map.Keys() dispatcher and would link-fail. Each file
        // appears at most once per request anyway, so the linear
        // scan is fine.
        var changes: string = "{"
        var firstFile: bool = true
        let nProgs: int = resolver.Programs.Count()
        for i in 0..nProgs {
            let p: AstNode = resolver.Programs.Get(i)
            var filePath: string = p.Str2
            if (String_Length(filePath) == 0) { filePath = path }
            let fileUri: string = "file://" + LspServer.PercentEncodePath(filePath)
            let edits: List<string> = new List<string>()
            LspServer.CollectRenameEdits(p, target, newName, edits)
            let ec: int = edits.Count()
            if (ec == 0) { continue }
            if (!firstFile) { changes = changes + "," }
            changes = changes + "\"" + Json.EscapeString(fileUri) + "\":["
            for j in 0..ec {
                if (j > 0) { changes = changes + "," }
                changes = changes + edits.Get(j)
            }
            changes = changes + "]"
            firstFile = false
        }
        changes = changes + "}"
        let body = "{\"jsonrpc\":\"2.0\",\"id\":" + String_FromInt(id) + ",\"result\":{\"changes\":" + changes + "}}"
        this.Send(body)
    }

    // Recursive walker that emits a TextEdit JSON for every
    // IDENTIFIER / MEMBER / decl-bearing node whose Name matches
    // `target`. Same shape as CollectReferences, but produces
    // `{ range, newText }` entries directly.
    private static void CollectRenameEdits(AstNode node, string target, string newName, List<string> out) {
        if (node == null) { return }
        let k = node.Kind
        // Split the kind-then-name check across two if's so the
        // cgen can't drop our parentheses and re-associate `(A || B)
        // && C` as `A || (B && C)` (which would emit an edit for
        // every identifier in the file regardless of name match —
        // that's a real cgen-precedence bug we hit while writing
        // this).
        var matches: bool = false
        if (k == NodeKind.IDENTIFIER || k == NodeKind.MEMBER) { matches = true }
        if (k == NodeKind.CLASS_DECL || k == NodeKind.ENUM_DECL) { matches = true }
        if (k == NodeKind.METHOD_DECL || k == NodeKind.VAR_DECL) { matches = true }
        if (k == NodeKind.PARAM)                                  { matches = true }
        if (matches && node.Name == target) {
            out.Add(LspServer.TextEditJson(node.Line, node.Column, target, newName))
        }
        if (node.Left  != null) { LspServer.CollectRenameEdits(node.Left,  target, newName, out) }
        if (node.Right != null) { LspServer.CollectRenameEdits(node.Right, target, newName, out) }
        if (node.Cond  != null) { LspServer.CollectRenameEdits(node.Cond,  target, newName, out) }
        if (node.Body  != null) { LspServer.CollectRenameEdits(node.Body,  target, newName, out) }
        if (node.Else  != null) { LspServer.CollectRenameEdits(node.Else,  target, newName, out) }
        let cn: int = node.Children.Count()
        for i in 0..cn {
            LspServer.CollectRenameEdits(node.Children.Get(i), target, newName, out)
        }
        let pn: int = node.Params.Count()
        for j in 0..pn {
            LspServer.CollectRenameEdits(node.Params.Get(j), target, newName, out)
        }
        let an: int = node.Args.Count()
        for k2 in 0..an {
            LspServer.CollectRenameEdits(node.Args.Get(k2), target, newName, out)
        }
    }

    // Build a TextEdit JSON for a single occurrence. Range covers
    // the old name's span; newText is the replacement.
    private static string TextEditJson(int line, int col, string oldName, string newName) {
        let lineLsp: int = line - 1
        let colLsp:  int = col - 1
        let oldLen:  int = String_Length(oldName)
        let endCol:  int = colLsp + oldLen
        let range: string = "{\"start\":{\"line\":" + String_FromInt(lineLsp) + ",\"character\":" + String_FromInt(colLsp) + "},\"end\":{\"line\":" + String_FromInt(lineLsp) + ",\"character\":" + String_FromInt(endCol) + "}}"
        return "{\"range\":" + range + ",\"newText\":\"" + Json.EscapeString(newName) + "\"}"
    }

    // ── Prepare rename (F2 pre-flight) ────────────────
    //
    // VS Code calls textDocument/prepareRename before issuing the
    // actual rename — if we return null the F2 popup says "you cannot
    // rename this element". We accept any node carrying a Name on a
    // declaration- or reference-shape kind. The reply gives the
    // editor the exact span of the old name (so its inline rename UI
    // pre-fills the right text) plus a `placeholder` it shows in the
    // input box.
    private void HandlePrepareRename(int id, string uri, int line, int character) {
        let source = this.LookupDoc(uri)
        if (String_Length(source) == 0) {
            this.SendNullResult(id)
            return
        }
        let path = LspServer.UriToPath(uri)
        let lex  = new Lexer(source, path)
        let toks = lex.Tokenize()
        let par  = new Parser(toks)
        let prog = par.Parse()

        let targetLine: int = line + 1
        let targetCol:  int = character + 1
        let node = LspServer.FindNodeAtPosition(prog, targetLine, targetCol)
        if (node == null) {
            this.SendNullResult(id)
            return
        }
        let k = node.Kind
        // Same renameable-kind set CollectRenameEdits accepts. Split
        // across multiple if's for the same cgen-precedence reason.
        var renameable: bool = false
        if (k == NodeKind.IDENTIFIER || k == NodeKind.MEMBER) { renameable = true }
        if (k == NodeKind.CLASS_DECL || k == NodeKind.ENUM_DECL) { renameable = true }
        if (k == NodeKind.METHOD_DECL || k == NodeKind.VAR_DECL) { renameable = true }
        if (k == NodeKind.PARAM)                                  { renameable = true }
        if (!renameable) {
            this.SendNullResult(id)
            return
        }
        let name: string = node.Name
        if (String_Length(name) == 0) {
            this.SendNullResult(id)
            return
        }
        let lineLsp: int = node.Line - 1
        let colLsp:  int = node.Column - 1
        let nameLen: int = String_Length(name)
        let endCol:  int = colLsp + nameLen
        let range: string = "{\"start\":{\"line\":" + String_FromInt(lineLsp) + ",\"character\":" + String_FromInt(colLsp) + "},\"end\":{\"line\":" + String_FromInt(lineLsp) + ",\"character\":" + String_FromInt(endCol) + "}}"
        let body = "{\"jsonrpc\":\"2.0\",\"id\":" + String_FromInt(id) + ",\"result\":{\"range\":" + range + ",\"placeholder\":\"" + Json.EscapeString(name) + "\"}}"
        this.Send(body)
    }

    // ── Call hierarchy (Shift+Alt+H) ──────────────────
    //
    // Three-step protocol per LSP spec:
    //
    //   prepareCallHierarchy → returns the CallHierarchyItem[] the
    //   user picks from. We return at most one item: the method
    //   enclosing the cursor (Amalgame methods are not overloaded so
    //   one position → one method).
    //
    //   incomingCalls(item) → who calls this method? Walk every
    //   program; for every CALL whose callee Name matches `item.name`,
    //   group the call site by the enclosing METHOD_DECL.
    //
    //   outgoingCalls(item) → who does this method call? Find the
    //   method by name+uri+line, walk its body, collect CALL nodes,
    //   group by callee Name (resolving the called method back to a
    //   CallHierarchyItem when we can find a workspace decl).
    //
    // Item `data` field roundtrip: `{ name, uri, line, character }`
    // — the editor passes the item back verbatim, so we plant the
    // original cursor coordinates here to re-locate the method on
    // each follow-up request.
    private void HandlePrepareCallHierarchy(int id, string uri, int line, int character) {
        let source = this.LookupDoc(uri)
        if (String_Length(source) == 0) {
            this.SendNullResult(id)
            return
        }
        let path = LspServer.UriToPath(uri)
        let lex  = new Lexer(source, path)
        let toks = lex.Tokenize()
        let par  = new Parser(toks)
        let prog = par.Parse()
        let targetLine: int = line + 1
        let enclosing: AstNode? = LspServer.FindEnclosingMethod(prog, targetLine)
        if (enclosing == null) {
            this.SendNullResult(id)
            return
        }
        let item: string = LspServer.CallHierarchyItemJson(enclosing, path)
        let body = "{\"jsonrpc\":\"2.0\",\"id\":" + String_FromInt(id) + ",\"result\":[" + item + "]}"
        this.Send(body)
    }

    private void HandleIncomingCalls(int id, JsonValue item) {
        let target: string = item.Get("name").AsString()
        if (String_Length(target) == 0) {
            this.Send("{\"jsonrpc\":\"2.0\",\"id\":" + String_FromInt(id) + ",\"result\":[]}")
            return
        }
        // Anchor the workspace cache off the item's URI so we resolve
        // siblings even if the user hasn't opened any file yet.
        let itemUri: string = item.Get("uri").AsString()
        let anchor:  string = LspServer.UriToPath(itemUri)

        // Reparse the open file (if tracked) so its AST is fresh;
        // otherwise feed BuildWorkspaceResolver an empty program so
        // it still wires up the cached siblings.
        let openSrc: string = this.LookupDoc(itemUri)
        let lex2  = new Lexer(openSrc, anchor)
        let toks2 = lex2.Tokenize()
        let par2  = new Parser(toks2)
        let openProg: AstNode = par2.Parse()
        openProg.Str2 = anchor
        let resolver = this.BuildWorkspaceResolver(anchor, openProg)

        var json: string = "["
        var first: bool = true
        let nProgs: int = resolver.Programs.Count()
        for i in 0..nProgs {
            let p: AstNode = resolver.Programs.Get(i)
            var filePath: string = p.Str2
            if (String_Length(filePath) == 0) { filePath = anchor }
            let dc: int = p.Children.Count()
            for j in 0..dc {
                let cls: AstNode = p.Children.Get(j)
                if (cls.Kind != NodeKind.CLASS_DECL) { continue }
                let mc: int = cls.Children.Count()
                for k2 in 0..mc {
                    let m: AstNode = cls.Children.Get(k2)
                    if (m.Kind != NodeKind.METHOD_DECL) { continue }
                    let ranges: List<string> = new List<string>()
                    LspServer.CollectCallSitesForName(m.Body, target, ranges)
                    let rc: int = ranges.Count()
                    if (rc == 0) { continue }
                    var rangesJson: string = "["
                    for ri in 0..rc {
                        if (ri > 0) { rangesJson = rangesJson + "," }
                        rangesJson = rangesJson + ranges.Get(ri)
                    }
                    rangesJson = rangesJson + "]"
                    let fromItem: string = LspServer.CallHierarchyItemJson(m, filePath)
                    if (!first) { json = json + "," }
                    json = json + "{\"from\":" + fromItem + ",\"fromRanges\":" + rangesJson + "}"
                    first = false
                }
            }
        }
        json = json + "]"
        let body = "{\"jsonrpc\":\"2.0\",\"id\":" + String_FromInt(id) + ",\"result\":" + json + "}"
        this.Send(body)
    }

    private void HandleOutgoingCalls(int id, JsonValue item) {
        let itemName: string = item.Get("name").AsString()
        let itemUri:  string = item.Get("uri").AsString()
        if (String_Length(itemName) == 0 || String_Length(itemUri) == 0) {
            this.Send("{\"jsonrpc\":\"2.0\",\"id\":" + String_FromInt(id) + ",\"result\":[]}")
            return
        }
        // selectionRange.start.line gives us the original method's
        // declaration line — re-locate by name+line on the file the
        // item came from.
        let selRange: JsonValue = item.Get("selectionRange")
        let selStart: JsonValue = selRange.Get("start")
        let methodLine: int = selStart.Get("line").AsInt() + 1

        let anchor: string = LspServer.UriToPath(itemUri)
        let openSrc: string = this.LookupDoc(itemUri)
        let lex2  = new Lexer(openSrc, anchor)
        let toks2 = lex2.Tokenize()
        let par2  = new Parser(toks2)
        let prog: AstNode = par2.Parse()
        prog.Str2 = anchor
        let resolver = this.BuildWorkspaceResolver(anchor, prog)

        // Locate the method AST node in the URI's file by name+line.
        var method: AstNode? = null
        let nProgs: int = resolver.Programs.Count()
        for i in 0..nProgs {
            let p: AstNode = resolver.Programs.Get(i)
            let pPath: string = p.Str2
            if (pPath != anchor) { continue }
            let dc: int = p.Children.Count()
            for j in 0..dc {
                let cls: AstNode = p.Children.Get(j)
                if (cls.Kind != NodeKind.CLASS_DECL) { continue }
                let mc: int = cls.Children.Count()
                for k2 in 0..mc {
                    let m: AstNode = cls.Children.Get(k2)
                    if (m.Kind != NodeKind.METHOD_DECL) { continue }
                    if (m.Name != itemName) { continue }
                    if (m.Line != methodLine) { continue }
                    method = m
                }
            }
        }
        if (method == null) {
            this.Send("{\"jsonrpc\":\"2.0\",\"id\":" + String_FromInt(id) + ",\"result\":[]}")
            return
        }

        // Collect every CALL node in the method body. Group by callee
        // name. For each unique callee, find a workspace decl (if any)
        // and emit one outgoing entry with all call-site ranges.
        let calleeNames: List<string> = new List<string>()
        let calleeSites: List<string> = new List<string>()  // parallel: each entry is a "ranges" JSON-array string
        LspServer.CollectOutgoingCalls(method.Body, calleeNames, calleeSites)

        var json: string = "["
        var first: bool = true
        let cn: int = calleeNames.Count()
        for i in 0..cn {
            let name: string = calleeNames.Get(i)
            let ranges: string = calleeSites.Get(i)
            // Look up the called method's decl somewhere in the
            // workspace — first match wins. If we can't find one,
            // fall back to a synthetic item pointing at the call
            // site so the editor still renders the row.
            var toItem: string = ""
            for pi in 0..nProgs {
                if (String_Length(toItem) > 0) { break }
                let p: AstNode = resolver.Programs.Get(pi)
                var pPath: string = p.Str2
                if (String_Length(pPath) == 0) { pPath = anchor }
                let dc: int = p.Children.Count()
                for dj in 0..dc {
                    if (String_Length(toItem) > 0) { break }
                    let cls: AstNode = p.Children.Get(dj)
                    if (cls.Kind != NodeKind.CLASS_DECL) { continue }
                    let mc: int = cls.Children.Count()
                    for mk in 0..mc {
                        let m: AstNode = cls.Children.Get(mk)
                        if (m.Kind != NodeKind.METHOD_DECL) { continue }
                        if (m.Name != name) { continue }
                        toItem = LspServer.CallHierarchyItemJson(m, pPath)
                    }
                }
            }
            if (String_Length(toItem) == 0) { continue }
            if (!first) { json = json + "," }
            json = json + "{\"to\":" + toItem + ",\"fromRanges\":" + ranges + "}"
            first = false
        }
        json = json + "]"
        let body = "{\"jsonrpc\":\"2.0\",\"id\":" + String_FromInt(id) + ",\"result\":" + json + "}"
        this.Send(body)
    }

    // Walk a method body collecting Range JSONs for every CALL whose
    // callee Name matches `target`. The "name" of a CALL is the right
    // edge of its callee: callee = IDENTIFIER → callee.Name; callee =
    // MEMBER → callee.Name (the member token, e.g. `obj.foo` ⇒ "foo").
    private static void CollectCallSitesForName(AstNode? node, string target, List<string> out) {
        if (node == null) { return }
        let n: AstNode = node
        if (n.Kind == NodeKind.CALL && n.Left != null) {
            let callee: AstNode = n.Left
            var calleeName: string = ""
            if (callee.Kind == NodeKind.IDENTIFIER) { calleeName = callee.Name }
            if (callee.Kind == NodeKind.MEMBER)     { calleeName = callee.Name }
            if (calleeName == target) {
                out.Add(LspServer.RangeJsonForName(callee.Line, callee.Column, calleeName))
            }
        }
        // Don't recurse into nested METHOD_DECLs (lambdas) — their
        // calls belong to a different caller in the hierarchy.
        if (n.Kind == NodeKind.METHOD_DECL) { return }
        if (n.Left  != null) { LspServer.CollectCallSitesForName(n.Left,  target, out) }
        if (n.Right != null) { LspServer.CollectCallSitesForName(n.Right, target, out) }
        if (n.Cond  != null) { LspServer.CollectCallSitesForName(n.Cond,  target, out) }
        if (n.Body  != null) { LspServer.CollectCallSitesForName(n.Body,  target, out) }
        if (n.Else  != null) { LspServer.CollectCallSitesForName(n.Else,  target, out) }
        let cn: int = n.Children.Count()
        for i in 0..cn {
            LspServer.CollectCallSitesForName(n.Children.Get(i), target, out)
        }
        let pn: int = n.Params.Count()
        for j in 0..pn {
            LspServer.CollectCallSitesForName(n.Params.Get(j), target, out)
        }
        let an: int = n.Args.Count()
        for k in 0..an {
            LspServer.CollectCallSitesForName(n.Args.Get(k), target, out)
        }
    }

    // Walk a method body collecting (calleeName, ranges-JSON-array)
    // pairs in two parallel lists. Same kind of walker as
    // CollectCallSitesForName but groups every CALL it sees, not
    // only ones matching a specific name.
    private static void CollectOutgoingCalls(AstNode? node, List<string> names, List<string> rangesOut) {
        if (node == null) { return }
        let n: AstNode = node
        if (n.Kind == NodeKind.CALL && n.Left != null) {
            let callee: AstNode = n.Left
            var calleeName: string = ""
            if (callee.Kind == NodeKind.IDENTIFIER) { calleeName = callee.Name }
            if (callee.Kind == NodeKind.MEMBER)     { calleeName = callee.Name }
            if (String_Length(calleeName) > 0) {
                let r: string = LspServer.RangeJsonForName(callee.Line, callee.Column, calleeName)
                let nc: int = names.Count()
                var found: bool = false
                for i in 0..nc {
                    if (names.Get(i) == calleeName) {
                        let prev: string = rangesOut.Get(i)
                        // prev is "[r1,r2,...]" — splice the new range
                        // before the closing bracket.
                        let prevLen: int = String_Length(prev)
                        let head: string = String_Substring(prev, 0, prevLen - 1)
                        var sep: string = ","
                        if (prev == "[]") { sep = "" }
                        let updated: string = head + sep + r + "]"
                        rangesOut.RemoveAt(i)
                        rangesOut.Add(updated)
                        // Keep parallel arrays in sync: pop and re-push
                        // the name too so its index matches.
                        names.RemoveAt(i)
                        names.Add(calleeName)
                        found = true
                    }
                }
                if (!found) {
                    names.Add(calleeName)
                    rangesOut.Add("[" + r + "]")
                }
            }
        }
        if (n.Kind == NodeKind.METHOD_DECL) { return }
        if (n.Left  != null) { LspServer.CollectOutgoingCalls(n.Left,  names, rangesOut) }
        if (n.Right != null) { LspServer.CollectOutgoingCalls(n.Right, names, rangesOut) }
        if (n.Cond  != null) { LspServer.CollectOutgoingCalls(n.Cond,  names, rangesOut) }
        if (n.Body  != null) { LspServer.CollectOutgoingCalls(n.Body,  names, rangesOut) }
        if (n.Else  != null) { LspServer.CollectOutgoingCalls(n.Else,  names, rangesOut) }
        let cn: int = n.Children.Count()
        for i in 0..cn {
            LspServer.CollectOutgoingCalls(n.Children.Get(i), names, rangesOut)
        }
        let pn: int = n.Params.Count()
        for j in 0..pn {
            LspServer.CollectOutgoingCalls(n.Params.Get(j), names, rangesOut)
        }
        let an: int = n.Args.Count()
        for k in 0..an {
            LspServer.CollectOutgoingCalls(n.Args.Get(k), names, rangesOut)
        }
    }

    // Build a CallHierarchyItem JSON for a METHOD_DECL.
    //   - kind 6 = Method per LSP spec.
    //   - range / selectionRange both cover the method's name span on
    //     its declaration line. A tighter `range` covering the whole
    //     method body is a nice-to-have but our AstNode doesn't carry
    //     end positions yet.
    //   - data field ferries name+uri+line+character so incoming /
    //     outgoing handlers can re-locate the method on the next req.
    private static string CallHierarchyItemJson(AstNode method, string filePath) {
        let name: string = method.Name
        let lineLsp: int = method.Line - 1
        let colLsp:  int = method.Column - 1
        let nameLen: int = String_Length(name)
        let endCol:  int = colLsp + nameLen
        let uri: string = "file://" + LspServer.PercentEncodePath(filePath)
        let range: string = "{\"start\":{\"line\":" + String_FromInt(lineLsp) + ",\"character\":" + String_FromInt(colLsp) + "},\"end\":{\"line\":" + String_FromInt(lineLsp) + ",\"character\":" + String_FromInt(endCol) + "}}"
        let data: string  = "{\"name\":\"" + Json.EscapeString(name) + "\",\"uri\":\"" + Json.EscapeString(uri) + "\",\"line\":" + String_FromInt(lineLsp) + ",\"character\":" + String_FromInt(colLsp) + "}"
        return "{\"name\":\"" + Json.EscapeString(name) + "\",\"kind\":6,\"uri\":\"" + Json.EscapeString(uri) + "\",\"range\":" + range + ",\"selectionRange\":" + range + ",\"data\":" + data + "}"
    }

    // Build a single Range JSON for a 1-based (line, col) pair plus a
    // length derived from the name. Used by both incoming and outgoing
    // call site rendering. Same conversion as TextEditJson but emits
    // the bare range, not a TextEdit object.
    private static string RangeJsonForName(int line, int col, string name) {
        let lineLsp: int = line - 1
        let colLsp:  int = col - 1
        let nameLen: int = String_Length(name)
        let endCol:  int = colLsp + nameLen
        return "{\"start\":{\"line\":" + String_FromInt(lineLsp) + ",\"character\":" + String_FromInt(colLsp) + "},\"end\":{\"line\":" + String_FromInt(lineLsp) + ",\"character\":" + String_FromInt(endCol) + "}}"
    }

    // ── Inlay hints (inferred types) ──────────────────
    //
    // Walk the open file's AST and emit one InlayHint per VAR_DECL
    // that has an RHS but no type annotation (`let x = …`). The hint
    // shows the typechecker's inferred type rendered as `: <type>`,
    // pinned to the column right after the variable name. VS Code
    // greys it out so it reads like editor decoration, not real text.
    //
    // Skips:
    //   - decls with an explicit annotation (Str non-empty) — user
    //     already wrote the type, no need to repeat it.
    //   - tuple destructuring (`let (a, b) = …`) — the synthetic
    //     `__tuple__` decl carries no useful type, and per-binder
    //     hints would need a parser hook to track each name's column.
    //   - decls whose inferred type is "?" — typechecker has no
    //     answer, hinting the literal "?" is just noise.
    //
    // The `range` filter from the request params is currently ignored
    // — we return every hint in the file. VS Code clamps display to
    // the viewport itself, and the document AST walk is fast enough
    // (sub-50ms even on the largest compiler source).
    private void HandleInlayHint(int id, string uri) {
        let source = this.LookupDoc(uri)
        if (String_Length(source) == 0) {
            this.Send("{\"jsonrpc\":\"2.0\",\"id\":" + String_FromInt(id) + ",\"result\":[]}")
            return
        }
        let path = LspServer.UriToPath(uri)
        let lex  = new Lexer(source, path)
        let toks = lex.Tokenize()
        let par  = new Parser(toks)
        let prog = par.Parse()
        prog.Str2 = path
        let resolver = this.BuildWorkspaceResolver(path, prog)
        let tc = new TypeChecker(resolver, path)
        tc.Check(prog)

        let hints: List<string> = new List<string>()
        LspServer.CollectInlayHints(prog, tc, hints)

        var json: string = "["
        let n: int = hints.Count()
        for i in 0..n {
            if (i > 0) { json = json + "," }
            json = json + hints.Get(i)
        }
        json = json + "]"
        let body = "{\"jsonrpc\":\"2.0\",\"id\":" + String_FromInt(id) + ",\"result\":" + json + "}"
        this.Send(body)
    }

    // Recursive walker — emits an InlayHint per qualifying VAR_DECL.
    // Walks the same AstNode child slots as the rename / references
    // collectors so any new positional child added to the AST is
    // covered automatically.
    private static void CollectInlayHints(AstNode node, TypeChecker tc, List<string> out) {
        if (node == null) { return }
        if (node.Kind == NodeKind.VAR_DECL) {
            // Skip annotated decls + the tuple-destructure synthetic.
            // `__tuple_destructure__` is the marker the parser plants
            // on the synthesized "__tuple__" VarDecl for `let (a,b) = …`.
            if (String_Length(node.Str) == 0 || node.Str == "__tuple_destructure__") {
                if (node.Str != "__tuple_destructure__" && node.Left != null) {
                    let inferred: string = tc.LookupNodeType(node.Left)
                    if (String_Length(inferred) > 0 && inferred != "?") {
                        out.Add(LspServer.InlayHintJson(node.Line, node.Column, node.Name, inferred))
                    }
                }
            }
        }
        if (node.Left  != null) { LspServer.CollectInlayHints(node.Left,  tc, out) }
        if (node.Right != null) { LspServer.CollectInlayHints(node.Right, tc, out) }
        if (node.Cond  != null) { LspServer.CollectInlayHints(node.Cond,  tc, out) }
        if (node.Body  != null) { LspServer.CollectInlayHints(node.Body,  tc, out) }
        if (node.Else  != null) { LspServer.CollectInlayHints(node.Else,  tc, out) }
        let cn: int = node.Children.Count()
        for i in 0..cn {
            LspServer.CollectInlayHints(node.Children.Get(i), tc, out)
        }
        let pn: int = node.Params.Count()
        for j in 0..pn {
            LspServer.CollectInlayHints(node.Params.Get(j), tc, out)
        }
        let an: int = node.Args.Count()
        for k in 0..an {
            LspServer.CollectInlayHints(node.Args.Get(k), tc, out)
        }
    }

    // Build a single InlayHint JSON. Position pins the hint right
    // after the variable name (col + nameLen, 0-based for LSP).
    // kind = 1 (Type) so the editor styles it like a type annotation;
    // paddingLeft = true so VS Code inserts a space between the name
    // and the leading colon.
    private static string InlayHintJson(int line, int col, string name, string typeStr) {
        let lineLsp: int = line - 1
        let colLsp:  int = col - 1
        let nameLen: int = String_Length(name)
        let endCol:  int = colLsp + nameLen
        let pos: string = "{\"line\":" + String_FromInt(lineLsp) + ",\"character\":" + String_FromInt(endCol) + "}"
        let label: string = ": " + typeStr
        return "{\"position\":" + pos + ",\"label\":\"" + Json.EscapeString(label) + "\",\"kind\":1,\"paddingLeft\":true}"
    }

    // ── Code actions (quick fixes) ────────────────────
    //
    // v1 fix: "Add explicit type annotation". When the cursor (or
    // selection start) lies on a `let x = …` whose annotation is
    // empty and the typechecker can infer a concrete type, offer
    // a CodeAction whose WorkspaceEdit inserts `: <type>` right after
    // the variable name. Same inference data the inlay hint walker
    // already uses, just packaged as an applicable edit instead of
    // editor decoration.
    //
    // Range matching: we accept any VAR_DECL whose declaration line
    // falls within the request's range (inclusive on both ends). VS
    // Code's Quick Fix UI sends the cursor as a zero-width range
    // pinned to the line; multi-line selections widen the match.
    private void HandleCodeAction(int id, string uri, int startLine, int startChr, int endLine, int endChr) {
        let source = this.LookupDoc(uri)
        if (String_Length(source) == 0) {
            this.Send("{\"jsonrpc\":\"2.0\",\"id\":" + String_FromInt(id) + ",\"result\":[]}")
            return
        }
        let path = LspServer.UriToPath(uri)
        let lex  = new Lexer(source, path)
        let toks = lex.Tokenize()
        let par  = new Parser(toks)
        let prog = par.Parse()
        prog.Str2 = path
        let resolver = this.BuildWorkspaceResolver(path, prog)
        let tc = new TypeChecker(resolver, path)
        tc.Check(prog)

        // Convert LSP 0-based to AST 1-based.
        let sLine: int = startLine + 1
        let eLine: int = endLine + 1
        let actions: List<string> = new List<string>()
        LspServer.CollectAnnotationFixes(prog, tc, uri, sLine, eLine, actions)

        var json: string = "["
        let n: int = actions.Count()
        for i in 0..n {
            if (i > 0) { json = json + "," }
            json = json + actions.Get(i)
        }
        json = json + "]"
        let body = "{\"jsonrpc\":\"2.0\",\"id\":" + String_FromInt(id) + ",\"result\":" + json + "}"
        this.Send(body)
    }

    // Walk the AST collecting CodeAction JSONs for every annotation-
    // less VAR_DECL whose declaration line is inside [sLine, eLine].
    // Skips the same shapes the inlay hint walker skips (annotated
    // decls, tuple destructuring, "?" inferred type).
    private static void CollectAnnotationFixes(AstNode node, TypeChecker tc, string uri, int sLine, int eLine, List<string> out) {
        if (node == null) { return }
        if (node.Kind == NodeKind.VAR_DECL) {
            // Match same gating as inlay hints, plus the line-range filter.
            let inRange: bool = node.Line >= sLine && node.Line <= eLine
            if (inRange && String_Length(node.Str) == 0 && node.Str != "__tuple_destructure__" && node.Left != null) {
                let inferred: string = tc.LookupNodeType(node.Left)
                if (String_Length(inferred) > 0 && inferred != "?") {
                    out.Add(LspServer.AnnotationFixJson(uri, node.Line, node.Column, node.Name, inferred))
                }
            }
        }
        if (node.Left  != null) { LspServer.CollectAnnotationFixes(node.Left,  tc, uri, sLine, eLine, out) }
        if (node.Right != null) { LspServer.CollectAnnotationFixes(node.Right, tc, uri, sLine, eLine, out) }
        if (node.Cond  != null) { LspServer.CollectAnnotationFixes(node.Cond,  tc, uri, sLine, eLine, out) }
        if (node.Body  != null) { LspServer.CollectAnnotationFixes(node.Body,  tc, uri, sLine, eLine, out) }
        if (node.Else  != null) { LspServer.CollectAnnotationFixes(node.Else,  tc, uri, sLine, eLine, out) }
        let cn: int = node.Children.Count()
        for i in 0..cn {
            LspServer.CollectAnnotationFixes(node.Children.Get(i), tc, uri, sLine, eLine, out)
        }
        let pn: int = node.Params.Count()
        for j in 0..pn {
            LspServer.CollectAnnotationFixes(node.Params.Get(j), tc, uri, sLine, eLine, out)
        }
        let an: int = node.Args.Count()
        for k in 0..an {
            LspServer.CollectAnnotationFixes(node.Args.Get(k), tc, uri, sLine, eLine, out)
        }
    }

    // Build a CodeAction JSON for the "add type annotation" quick fix.
    // The TextEdit inserts `: <type>` at column = (var name end). LSP
    // treats a zero-width range as an insertion point, so start ==
    // end here.
    //
    // kind = "quickfix" — VS Code groups these under the lightbulb;
    // isPreferred = true so Quick Fix... defaults to this action when
    // the user hits Ctrl+. on the line.
    private static string AnnotationFixJson(string uri, int line, int col, string name, string typeStr) {
        let lineLsp: int = line - 1
        let colLsp:  int = col - 1
        let nameLen: int = String_Length(name)
        let endCol:  int = colLsp + nameLen
        let insertPoint: string = "{\"line\":" + String_FromInt(lineLsp) + ",\"character\":" + String_FromInt(endCol) + "}"
        let range: string = "{\"start\":" + insertPoint + ",\"end\":" + insertPoint + "}"
        let newText: string = ": " + typeStr
        let edit: string = "{\"range\":" + range + ",\"newText\":\"" + Json.EscapeString(newText) + "\"}"
        let changes: string = "{\"" + Json.EscapeString(uri) + "\":[" + edit + "]}"
        let title: string = "Add type annotation: " + typeStr
        return "{\"title\":\"" + Json.EscapeString(title) + "\",\"kind\":\"quickfix\",\"isPreferred\":true,\"edit\":{\"changes\":" + changes + "}}"
    }

    // ── Workspace symbol (Ctrl+T) ─────────────────────
    //
    // Fuzzy-search every top-level decl across every cached
    // workspace file. The query is a plain substring filter
    // (case-insensitive); LSP clients do their own fuzzy ranking
    // on top, so we don't bother with a scoring algorithm. Empty
    // query returns every symbol — VS Code's default behaviour
    // when the user opens Ctrl+T without typing anything.
    //
    // Response shape per LSP spec is `SymbolInformation[]`, not
    // the nested `WorkspaceSymbol[]`. SymbolInformation is older
    // but universally supported; switching to WorkspaceSymbol +
    // resolve() is a slice-3 follow-up if lazy resolution becomes
    // worth it.
    private void HandleWorkspaceSymbol(int id, string query) {
        // Reuse the workspace cache built for diagnostics/hover.
        // Pick any open document to resolve the workspace root —
        // if none is open yet, fall back to a dummy path that
        // resolves to current directory; FindWorkspaceRoot walks
        // up looking for `.git` etc.
        var anchor: string = ""
        if (this.DocUris.Count() > 0) {
            anchor = LspServer.UriToPath(this.DocUris.Get(0))
        } else {
            anchor = "./_.am"
        }
        this.EnsureWorkspaceCache(anchor)

        let q: string = String_ToLower(query)
        var json: string = "["
        var first: bool = true
        let n: int = this.CachedSiblingProgs.Count()
        for i in 0..n {
            let prog: AstNode = this.CachedSiblingProgs.Get(i)
            let path: string  = this.CachedSiblingPaths.Get(i)
            let dc: int = prog.Children.Count()
            for j in 0..dc {
                let decl: AstNode = prog.Children.Get(j)
                let entry: string = LspServer.WorkspaceSymbolEntry(decl, path, q)
                if (String_Length(entry) > 0) {
                    if (!first) { json = json + "," }
                    json = json + entry
                    first = false
                }
            }
        }
        json = json + "]"
        let body = "{\"jsonrpc\":\"2.0\",\"id\":" + String_FromInt(id) + ",\"result\":" + json + "}"
        this.Send(body)
    }

    // SymbolInformation entry for a single top-level decl, or
    // empty string if the decl doesn't match the filter or isn't
    // a kind we surface. Class members aren't surfaced by
    // workspace/symbol on this pass — VS Code's Ctrl+T usually
    // wants the high-level "where is class X" answer; member
    // search is what `documentSymbol` covers per file.
    private static string WorkspaceSymbolEntry(AstNode decl, string path, string lowerQuery) {
        let k = decl.Kind
        var kind: int = 0
        if (k == NodeKind.CLASS_DECL)     { kind = 5 }
        else if (k == NodeKind.ENUM_DECL) { kind = 10 }
        else { return "" }
        let name: string = decl.Name
        if (String_Length(name) == 0) { return "" }
        if (String_Length(lowerQuery) > 0) {
            let lname: string = String_ToLower(name)
            if (String_IndexOf(lname, lowerQuery) < 0) { return "" }
        }
        let lineLsp: int = decl.Line - 1
        let colLsp:  int = decl.Column - 1
        let nameLen: int = String_Length(name)
        let endCol:  int = colLsp + nameLen
        let uri:     string = "file://" + LspServer.PercentEncodePath(path)
        let range: string = "{\"start\":{\"line\":" + String_FromInt(lineLsp) + ",\"character\":" + String_FromInt(colLsp) + "},\"end\":{\"line\":" + String_FromInt(lineLsp) + ",\"character\":" + String_FromInt(endCol) + "}}"
        let location: string = "{\"uri\":\"" + Json.EscapeString(uri) + "\",\"range\":" + range + "}"
        return "{\"name\":\"" + Json.EscapeString(name) + "\",\"kind\":" + String_FromInt(kind) + ",\"location\":" + location + "}"
    }

    // Build and send a `Location` JSON. Range covers the symbol's
    // name token (1-char start col → start + name length end col),
    // converted from the AST's 1-based to LSP's 0-based positions.
    //
    // The URI is percent-encoded — RFC 3986 requires it for any
    // non-ASCII byte, and VS Code silently ignores Location replies
    // whose `uri` doesn't round-trip through its DocumentURI parser.
    // (Symptom: Cmd+Click "spins forever" because the client never
    // accepts our well-formed-but-decoded reply.)
    private void SendDefinitionLocation(int id, string path, int line, int col, string name) {
        let encPath: string = LspServer.PercentEncodePath(path)
        let declUri: string = "file://" + encPath
        let declLine: int   = line - 1
        let declCol:  int   = col - 1
        // String_Length isn't seen as i64-returning by the cgen here
        // — the binary `+` mistypes as code_string_concat. Pinning the
        // length through a typed local sidesteps that until the cgen
        // gets a follow-on fix.
        let nameLen: int = String_Length(name)
        let endCol:  int = declCol + nameLen
        let body = "{\"jsonrpc\":\"2.0\",\"id\":" + String_FromInt(id) + ",\"result\":{\"uri\":\"" + Json.EscapeString(declUri) + "\",\"range\":{\"start\":{\"line\":" + String_FromInt(declLine) + ",\"character\":" + String_FromInt(declCol) + "},\"end\":{\"line\":" + String_FromInt(declLine) + ",\"character\":" + String_FromInt(endCol) + "}}}}"
        this.Send(body)
    }

    // Encode every byte of `path` that's outside the URI-unreserved
    // set to %XX. Reverse of PercentDecode. We only escape what RFC
    // 3986 considers a `pchar` violation (anything not alpha/digit/
    // -/./_/~//) — `/` itself stays so path separators are preserved.
    private static string PercentEncodePath(string path) {
        var out: string = ""
        let n: int = String_Length(path)
        let upper: string = "0123456789ABCDEF"
        for i in 0..n {
            let c: string = String_CharAt1(path, i)
            let code: int = String_ToInt(String_FromInt(0)) // dummy init
            // Direct char→int via a single-char string compare ladder
            // would be enormous; use String_CharCode if available, else
            // fall through to "preserve ASCII, escape everything else".
            // Pragmatic shortcut: single-byte ASCII alnum + safe punct
            // pass through, anything else is encoded byte-by-byte from
            // the underlying UTF-8 string slice.
            let isSafeAlnum: bool = LspServer.IsUriSafeChar(c)
            if (isSafeAlnum) {
                out = out + c
            } else {
                // Re-encode this single char (one or more UTF-8 bytes
                // from the source) into %XX form. String_CharAt1 here
                // returns one Unicode codepoint as a UTF-8 string; we
                // walk its bytes and emit each as %XX.
                let cn: int = String_Length(c)
                for bi in 0..cn {
                    let b: string = String_CharAt1(c, bi)
                    let bcode: int = LspServer.AsciiCodeOf(b)
                    let hi: int = bcode / 16
                    let lo: int = bcode - hi * 16
                    let hiCh: string = String_CharAt1(upper, hi)
                    let loCh: string = String_CharAt1(upper, lo)
                    out = out + "%" + hiCh + loCh
                }
            }
        }
        return out
    }

    // Single-char check for the "safe" set we don't %-encode: ASCII
    // letters, digits, `-`, `.`, `_`, `~`, `/`. Anything else (incl.
    // multi-byte UTF-8 chars) gets re-encoded per byte.
    private static bool IsUriSafeChar(string c) {
        if (String_Length(c) != 1) { return false }
        let code: int = LspServer.AsciiCodeOf(c)
        if (code >= 65 && code <= 90)  { return true }   // A-Z
        if (code >= 97 && code <= 122) { return true }   // a-z
        if (code >= 48 && code <= 57)  { return true }   // 0-9
        if (code == 45 || code == 46 || code == 95 || code == 126) { return true } // - . _ ~
        if (code == 47) { return true }                  // /
        return false
    }

    // Codepoint of the FIRST byte of `c` (one-char UTF-8 string).
    // Brute-force linear lookup against an ASCII codepoint table —
    // slow but only called on path edge bytes, where N is tiny.
    private static int AsciiCodeOf(string c) {
        let n: int = String_Length(c)
        if (n == 0) { return 0 }
        for code in 0..256 {
            if (String_FromByte(code) == c) { return code }
        }
        return 0
    }

    // ── Completion ────────────────────────────────────
    //
    // Two flavours, picked by the character immediately to the left
    // of the cursor:
    //
    //   `obj.<cursor>` → member completion. Look back for the
    //   identifier preceding the dot, resolve its type via the
    //   resolver's local + global tables, and emit the methods/
    //   fields of that type from MemberTable.
    //
    //   anything else → global completion (the original v0.3.5
    //   behaviour: every name the resolver knows about, useful as
    //   a generic fallback).

    private void HandleCompletion(int id, string uri, int line, int chr) {
        let source = this.LookupDoc(uri)
        if (String_Length(source) == 0) {
            this.SendEmptyCompletion(id)
            return
        }
        let path = LspServer.UriToPath(uri)
        let lex  = new Lexer(source, path)
        let toks = lex.Tokenize()
        let par  = new Parser(toks)
        let prog = par.Parse()
        prog.Str2 = path
        let resolver = this.BuildWorkspaceResolver(path, prog)

        // Inspect the cursor context: if the character right before
        // the cursor is a dot, attempt member completion. LSP line/
        // character are 0-based.
        let receiverType: string = LspServer.ReceiverTypeAt(source, line, chr, resolver)
        if (String_Length(receiverType) > 0 && receiverType != "?") {
            this.SendMemberCompletion(id, resolver, receiverType)
            return
        }

        // Fallback: list every global the resolver knows. Editor
        // filters by prefix on its side.
        this.SendGlobalCompletion(id, resolver)
    }

    private void SendGlobalCompletion(int id, FullResolver resolver) {
        var items = ""
        var first = true
        let gn: int = resolver.GlobalCount()
        for gi in 0..gn {
            let name  = resolver.GlobalNameAt(gi)
            if (String_Length(name) == 0) { continue }
            let typeS = resolver.GlobalTypeAt(gi)
            // CompletionItemKind: 7 = Class, 6 = Variable, 3 = Function.
            //   "type" → Class      (e.g. List, Map, Math, user classes)
            //   "void" → Function   (e.g. Console_WriteLine, File_WriteAll)
            //   else   → Variable   (typed values: int, string, etc.)
            var kind = 6
            if (typeS == "type") { kind = 7 }
            else if (typeS == "void") { kind = 3 }
            if (!first) { items = items + "," }
            items = items + "{\"label\":\"" + Json.EscapeString(name) + "\",\"kind\":" + String_FromInt(kind) + ",\"detail\":\"" + Json.EscapeString(typeS) + "\"}"
            first = false
        }
        let body = "{\"jsonrpc\":\"2.0\",\"id\":" + String_FromInt(id) + ",\"result\":{\"isIncomplete\":false,\"items\":[" + items + "]}}"
        this.Send(body)
    }

    private void SendMemberCompletion(int id, FullResolver resolver, string typeName) {
        // Strip nullable "?" and pointer "*" so the MemberTable lookup
        // (keyed by bare class names) hits. Same normalisation as the
        // typechecker's CheckMemberExpr.
        var bare: string = typeName
        if (String_EndsWith(bare, "?")) {
            bare = String_Substring(bare, 0, String_Length(bare) - 1)
        }
        if (String_EndsWith(bare, "*")) {
            bare = String_Substring(bare, 0, String_Length(bare) - 1)
        }
        // Extract Members in a local first — a `resolver.Members.X(...)`
        // chain on the same line gets mashed by the cgen into
        // `resolver->Members_X(...)` (Field+Method on the same
        // expression doesn't lower yet). Same workaround pattern as
        // the migrate / Json test suite.
        let members: MemberTable = resolver.Members
        let mc: int = members.MemberCountFor(bare)
        if (mc == 0) {
            // No known members → fall back to empty rather than
            // surprising the user with a global dump for an unknown
            // type.
            this.SendEmptyCompletion(id)
            return
        }
        var items = ""
        var first = true
        for i in 0..mc {
            let name: string = members.MemberNameForAt(bare, i)
            if (String_Length(name) == 0) { continue }
            let mtype: string = members.Get(bare, name)
            // Heuristic: a bare type marker like "void" / "int" /
            // "string" on a member is a method's return type, so use
            // CompletionItemKind 2 = Method. Anything else is a field.
            // (We can't tell for sure without re-walking the AST; the
            // "?" returned for unknown stays Field.)
            var kind = 5
            if (mtype == "void" || mtype == "int" || mtype == "string" || mtype == "bool" || mtype == "float") {
                kind = 2
            } else if (String_Length(mtype) > 0 && mtype != "?") {
                kind = 2
            }
            if (!first) { items = items + "," }
            items = items + "{\"label\":\"" + Json.EscapeString(name) + "\",\"kind\":" + String_FromInt(kind) + ",\"detail\":\"" + Json.EscapeString(mtype) + "\"}"
            first = false
        }
        let body = "{\"jsonrpc\":\"2.0\",\"id\":" + String_FromInt(id) + ",\"result\":{\"isIncomplete\":false,\"items\":[" + items + "]}}"
        this.Send(body)
    }

    // Walk the source text at (line, chr) (LSP 0-based) and decide
    // whether the position is a member-completion site. Returns the
    // type name of the receiver, or "" if the context isn't `ident.`
    // / the receiver type can't be resolved.
    public static string ReceiverTypeAt(string source, int line, int chr, FullResolver resolver) {
        // Locate the start of the target line.
        let n: int = String_Length(source)
        var lineStart: int = 0
        var curLine: int = 0
        for i in 0..n {
            if (curLine == line) {
                lineStart = i
                break
            }
            let c: string = String_CharAt1(source, i)
            if (c == "\n") { curLine = curLine + 1 }
        }
        if (curLine != line) { return "" }
        // The cursor is at `lineStart + chr`. The character to its
        // left should be a dot for member completion.
        let cursorAbs: int = lineStart + chr
        if (cursorAbs <= 0 || cursorAbs > n) { return "" }
        // Before-cursor char check.
        let dotPos: int = cursorAbs - 1
        if (dotPos < 0) { return "" }
        let dotCh: string = String_CharAt1(source, dotPos)
        if (dotCh != ".") { return "" }
        // Walk back over the receiver identifier.
        var ident: string = ""
        var p: int = dotPos - 1
        while (p >= lineStart) {
            let c: string = String_CharAt1(source, p)
            if (LspServer.IsIdentChar(c)) {
                ident = c + ident
                p = p - 1
            } else { break }
        }
        if (String_Length(ident) == 0) { return "" }
        // Resolve the identifier's type:
        //   1. a global symbol (class / enum name) → the type IS the
        //      identifier (Class.StaticMember pattern).
        //   2. a local variable → look up its declared type.
        //   3. a `this` access — short circuit to the surrounding
        //      class. We don't track "current class at offset" yet,
        //      so we punt on this case in v1 and return "".
        if (ident == "this") { return "" }
        if (resolver.HasSymbol(ident)) {
            let t: string = resolver.GetTypeName(ident)
            // A class name has its own name as the type marker
            // (DeclareGlobal(name, name, false) for ENUM_DECL and
            // CLASS_DECL). That's the right thing to return for
            // member completion.
            if (String_Length(t) > 0 && t != "?") { return t }
        }
        // Local-variable text scan: walk the file looking for the
        // most recent `let <ident> = new <Type>(...)` or
        // `let <ident>: <Type> = ...` decl above the cursor. This is
        // a v1 heuristic — it doesn't follow control flow or shadow
        // semantics, but it covers the common pattern users hit
        // (`let g = new Greeter(...); g.<cursor>`).
        let lt: string = LspServer.ScanLocalDeclType(source, cursorAbs, ident)
        if (String_Length(lt) > 0) { return lt }
        return ""
    }

    // Scan `source` from the start to `before` for the latest
    // `let <ident>` or `var <ident>` declaration and pull its type
    // out of the right-hand side. Returns "" if nothing matches.
    private static string ScanLocalDeclType(string source, int before, string ident) {
        let n: int = String_Length(source)
        if (before > n) { before = n }
        // Two patterns we recognise:
        //   1. `let <ident>: <Type> = ...`
        //   2. `let <ident> = new <Type>(...)`
        // Same for `var`. Walk forwards keeping the most recent hit.
        var bestType: string = ""
        let needles = new List<string>()
        needles.Add("let " + ident)
        needles.Add("var " + ident)
        let nn: int = needles.Count()
        for ni in 0..nn {
            let needle: string = needles.Get(ni)
            let nlen: int = String_Length(needle)
            var pos: int = 0
            while (pos < before) {
                let idx: int = String_IndexOf(String_Substring(source, pos, before - pos), needle)
                if (idx < 0) { break }
                let absIdx: int = pos + idx
                // Confirm the match boundary: the char before must be
                // start-of-line / whitespace and the char after must be
                // a non-ident char (so `let g` doesn't match `let gen`).
                let okStart: bool = absIdx == 0 || !LspServer.IsIdentChar(String_CharAt1(source, absIdx - 1))
                let after: int   = absIdx + nlen
                let okEnd: bool  = after >= n || !LspServer.IsIdentChar(String_CharAt1(source, after))
                if (okStart && okEnd) {
                    let t: string = LspServer.ExtractTypeAfterDecl(source, after, n)
                    if (String_Length(t) > 0) { bestType = t }
                }
                pos = absIdx + nlen
            }
        }
        return bestType
    }

    // Starting just past `let <ident>`, parse forward to find either
    // `: <Type>` (annotation) or `= new <Type>(`. Returns the bare
    // type name or "" if neither shape is found.
    private static string ExtractTypeAfterDecl(string source, int start, int n) {
        var i: int = start
        // Skip whitespace.
        while (i < n) {
            let c: string = String_CharAt1(source, i)
            if (c == " " || c == "\t") { i = i + 1 } else { break }
        }
        if (i >= n) { return "" }
        let head: string = String_CharAt1(source, i)
        if (head == ":") {
            i = i + 1
            // Skip whitespace.
            while (i < n) {
                let c: string = String_CharAt1(source, i)
                if (c == " " || c == "\t") { i = i + 1 } else { break }
            }
            // Read identifier (possibly generic — we strip `<...>`).
            var t: string = ""
            while (i < n) {
                let c: string = String_CharAt1(source, i)
                if (LspServer.IsIdentChar(c)) {
                    t = t + c
                    i = i + 1
                } else { break }
            }
            return t
        }
        if (head == "=") {
            i = i + 1
            // Skip whitespace.
            while (i < n) {
                let c: string = String_CharAt1(source, i)
                if (c == " " || c == "\t") { i = i + 1 } else { break }
            }
            // Look for `new <Type>(`.
            let newKw: string = "new "
            if (i + 4 <= n) {
                let head4: string = String_Substring(source, i, 4)
                if (head4 == newKw) {
                    i = i + 4
                    var t: string = ""
                    while (i < n) {
                        let c: string = String_CharAt1(source, i)
                        if (LspServer.IsIdentChar(c)) {
                            t = t + c
                            i = i + 1
                        } else { break }
                    }
                    return t
                }
            }
        }
        return ""
    }

    private static bool IsIdentChar(string c) {
        if (String_Length(c) == 0) { return false }
        let alnum: string = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"
        return String_IndexOf(alnum, c) >= 0
    }

    private void SendEmptyCompletion(int id) {
        let body = "{\"jsonrpc\":\"2.0\",\"id\":" + String_FromInt(id) + ",\"result\":{\"isIncomplete\":false,\"items\":[]}}"
        this.Send(body)
    }

    // ── Helpers ───────────────────────────────────────
    // LSP positions are 0-based; our errors carry 1-based
    // (line, column) from the lexer. Underline a single character
    // at the error column — good enough for v1; richer ranges
    // (token width) can come later.
    // Two adapters: the resolver and the typechecker carry the same
    // info but in different classes (ResolverError vs TypeError) so
    // the source-file dependency graph stays one-way.
    public static string DiagnosticFromResolver(string source, ResolverError e) {
        return LspServer.DiagnosticBody(source, e.Line, e.Column, e.Message)
    }

    public static string DiagnosticFromTc(string source, TypeError e) {
        return LspServer.DiagnosticBody(source, e.Line, e.Column, e.Message)
    }

    // Build one LSP Diagnostic. The range underlines the token at
    // (line, col) — scanning forward in `source` for word chars
    // (letters/digits/underscore). Single-char fallback when the
    // char at the error column isn't word-y (operators, brackets, …).
    private static string DiagnosticBody(string source, int line, int col, string msg) {
        var l = line - 1
        var cStart = col - 1
        if (l < 0) { l = 0 }
        if (cStart < 0) { cStart = 0 }
        let endCol: int = LspServer.TokenEndCol(source, line, col)
        var cEnd: int = endCol - 1
        if (cEnd <= cStart) { cEnd = cStart + 1 }
        let lStr = String_FromInt(l)
        let cStartStr = String_FromInt(cStart)
        let cEndStr = String_FromInt(cEnd)
        return "{\"severity\":1,\"range\":{\"start\":{\"line\":" + lStr + ",\"character\":" + cStartStr + "},\"end\":{\"line\":" + lStr + ",\"character\":" + cEndStr + "}},\"message\":\"" + Json.EscapeString(msg) + "\"}"
    }

    // Find the 1-indexed column where the token starting at
    // (line, col) ends. "Token" here is a maximal run of word
    // chars; if (line, col) doesn't point at a word char, returns
    // col (the caller widens to col+1 to avoid empty ranges).
    private static int TokenEndCol(string source, int line, int col) {
        let n: int = String_Length(source)
        var off: int = 0
        var ln:  int = 1
        while (ln < line && off < n) {
            let ch = String_CharAt1(source, off)
            if (ch == "\n") { ln = ln + 1 }
            off = off + 1
        }
        var colIdx: int = 0
        while (colIdx < col - 1 && off < n) {
            let ch = String_CharAt1(source, off)
            if (ch == "\n") { break }
            off = off + 1
            colIdx = colIdx + 1
        }
        var endCol: int = col
        while (off < n) {
            let ch = String_CharAt1(source, off)
            if (LspServer.IsWordChar(ch)) {
                off = off + 1
                endCol = endCol + 1
            } else { break }
        }
        return endCol
    }

    private static bool IsWordChar(string ch) {
        if (String_Length(ch) == 0) { return false }
        if (ch == "_") { return true }
        if (String_IndexOf("0123456789", ch) >= 0) { return true }
        if (String_IndexOf("abcdefghijklmnopqrstuvwxyz", ch) >= 0) { return true }
        if (String_IndexOf("ABCDEFGHIJKLMNOPQRSTUVWXYZ", ch) >= 0) { return true }
        return false
    }

    // file:///abs/path → /abs/path. Decodes %XX percent-encoding —
    // VS Code sends UTF-8 bytes encoded that way for any non-ASCII
    // char in the path (e.g. `Développement` → `D%C3%A9veloppement`).
    // Without decoding, the workspace scan walks an inexistent path
    // and silently degrades to single-file resolve, which surfaces as
    // spurious "Unknown symbol" diagnostics for cross-file types.
    public static string UriToPath(string uri) {
        var raw: string = uri
        if (String_StartsWith(uri, "file://")) {
            let n: int = String_Length(uri)
            raw = String_Substring(uri, 7, n - 7)
        }
        return LspServer.PercentDecode(raw)
    }

    // %XX → byte. Anything else (literal, truncated escape, bad hex)
    // is passed through unchanged so a malformed URI still produces
    // a usable path rather than an empty string.
    private static string PercentDecode(string s) {
        var out: string = ""
        let n: int = String_Length(s)
        var i: int = 0
        while (i < n) {
            let c: string = String_CharAt1(s, i)
            if (c == "%" && i + 2 < n) {
                let h0: string = String_CharAt1(s, i + 1)
                let h1: string = String_CharAt1(s, i + 2)
                let v0: int = LspServer.HexDigit(h0)
                let v1: int = LspServer.HexDigit(h1)
                if (v0 >= 0 && v1 >= 0) {
                    let b: int = (v0 * 16) + v1
                    out = out + String_FromByte(b)
                    i = i + 3
                } else {
                    out = out + c
                    i = i + 1
                }
            } else {
                out = out + c
                i = i + 1
            }
        }
        return out
    }

    private static int HexDigit(string c) {
        if (c == "0") { return 0 }
        if (c == "1") { return 1 }
        if (c == "2") { return 2 }
        if (c == "3") { return 3 }
        if (c == "4") { return 4 }
        if (c == "5") { return 5 }
        if (c == "6") { return 6 }
        if (c == "7") { return 7 }
        if (c == "8") { return 8 }
        if (c == "9") { return 9 }
        if (c == "a" || c == "A") { return 10 }
        if (c == "b" || c == "B") { return 11 }
        if (c == "c" || c == "C") { return 12 }
        if (c == "d" || c == "D") { return 13 }
        if (c == "e" || c == "E") { return 14 }
        if (c == "f" || c == "F") { return 15 }
        return -1
    }

    // ── AST positional lookup ─────────────────────────

    // Find the deepest AST node whose token covers the 1-based
    // (line, col). Returns null if no node has a Name field
    // matching the cursor word range. Walks Children/Params/Args
    // plus the four single-child slots (Left, Right, Cond, Body, Else).
    //
    // Coverage rule: the node "covers" (l, c) when its Line == l
    // and node.Column ≤ c ≤ node.Column + len(node.Name). The
    // open upper bound matches what an editor sees as "the cursor
    // is on this identifier" (the column past the last char still
    // counts).
    public static AstNode? FindNodeAtPosition(AstNode root, int line, int col) {
        if (root == null) { return null }
        var best: AstNode? = null
        best = LspServer.FindNodeWalk(root, line, col, best)
        return best
    }

    private static AstNode? FindNodeWalk(AstNode node, int line, int col, AstNode? best) {
        var current = best
        if (LspServer.NodeCovers(node, line, col)) {
            // Prefer the more deeply-nested match (which we'll
            // discover later in the walk), but also prefer named
            // nodes over unnamed structural nodes at the same depth.
            if (String_Length(node.Name) > 0) {
                current = node
            } else if (current == null) {
                current = node
            }
        }
        // Recurse into single-child slots
        if (node.Left  != null) { current = LspServer.FindNodeWalk(node.Left,  line, col, current) }
        if (node.Right != null) { current = LspServer.FindNodeWalk(node.Right, line, col, current) }
        if (node.Cond  != null) { current = LspServer.FindNodeWalk(node.Cond,  line, col, current) }
        if (node.Body  != null) { current = LspServer.FindNodeWalk(node.Body,  line, col, current) }
        if (node.Else  != null) { current = LspServer.FindNodeWalk(node.Else,  line, col, current) }
        // Recurse into child lists
        let cn: int = node.Children.Count()
        for ci in 0..cn {
            let c = node.Children.Get(ci)
            current = LspServer.FindNodeWalk(c, line, col, current)
        }
        let pn: int = node.Params.Count()
        for pi in 0..pn {
            let p = node.Params.Get(pi)
            current = LspServer.FindNodeWalk(p, line, col, current)
        }
        let an: int = node.Args.Count()
        for ai in 0..an {
            let a = node.Args.Get(ai)
            current = LspServer.FindNodeWalk(a, line, col, current)
        }
        return current
    }

    private static bool NodeCovers(AstNode node, int line, int col) {
        if (node.Line != line)  { return false }
        let nameLen: int = String_Length(node.Name)
        if (nameLen == 0)       { return false }
        let endCol: int = node.Column + nameLen
        if (col < node.Column)  { return false }
        if (col > endCol)       { return false }
        return true
    }

}
