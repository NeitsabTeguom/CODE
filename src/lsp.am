namespace Amalgame.Compiler

import Amalgame.Collections
import Amalgame.IO
import Amalgame.Process
import Amalgame.String

// ═══════════════════════════════════════════════════════
//  lsp.am  —  amc lsp: minimal LSP server (diagnostics-only)
// ═══════════════════════════════════════════════════════
//
// Speaks JSON-RPC 2.0 over stdio with the standard
// `Content-Length: N\r\n\r\n<N bytes>` framing. v1 implements:
//
//   - initialize / shutdown / exit       (lifecycle)
//   - textDocument/didOpen / didChange   (document state, full sync)
//   - textDocument/didClose
//   - textDocument/publishDiagnostics    (push, on every did{Open,Change})
//
// `textDocumentSync` is advertised as Full (1), so each didChange
// carries the entire updated text — no incremental edits to apply.
// Hover / completion / goto-definition are out of scope for v1
// and will land in a follow-up.
//
// JSON handling is ad-hoc: extractors look up `"key"` substrings.
// LSP messages don't have ambiguous key names at the depth we
// extract (method, id, uri, text), so a real parser would be
// over-engineering for this PR. Promotion to a proper Json
// stdlib module can come later if hover/completion need it.

public class LspServer {
    // Parallel arrays: DocUris[i] is the URI of the open document
    // whose latest text is in Docs[i]. Small N expected (one or
    // two open files in an editor session).
    private DocUris: List<string>
    private Docs:    List<string>

    public LspServer() {
        this.DocUris = new List<string>()
        this.Docs    = new List<string>()
    }

    // ── Main loop ─────────────────────────────────────
    //
    // We deliberately *don't* use Amalgame.Json on the LSP request
    // path: didOpen / didChange bodies routinely contain the entire
    // editor document inlined as the `text` field, and the pure-
    // Amalgame parser walks the body byte-by-byte with O(N) string
    // concatenation. On a 16 KB body that's seconds, not
    // milliseconds — unacceptable for an editor where typing fires
    // a didChange every keystroke.
    //
    // The ad-hoc JsonStr / JsonInt extractors are O(N) substring
    // matches and finish in microseconds. We pay for the lack of
    // depth by using deliberately-unique key names — every key the
    // LSP cares about (method, id, uri, text, line, character)
    // appears exactly once in the relevant frame, so the
    // first-occurrence trick is correct in practice.
    //
    // Phase 2 keeps the extractors here. Json.EscapeString is fine
    // (small inputs, single pass) and is used for outgoing
    // responses. Json.Parse migrates the migrate.am LLM responses
    // where bodies are similarly sized but only parsed once per
    // command invocation.
    public int Run() {
        while (true) {
            let body = this.ReadMessage()
            if (String_Length(body) == 0) { return 0 }
            let method = LspServer.JsonStr(body, "method")
            if (method == "initialize") {
                let id = LspServer.JsonInt(body, "id")
                this.SendInit(id)
            } else if (method == "shutdown") {
                let id = LspServer.JsonInt(body, "id")
                this.SendShutdown(id)
            } else if (method == "exit") {
                return 0
            } else if (method == "textDocument/didOpen") {
                let uri = LspServer.JsonStr(body, "uri")
                let txt = LspServer.JsonStr(body, "text")
                this.UpsertDoc(uri, txt)
                this.PublishDiagnostics(uri, txt)
            } else if (method == "textDocument/didChange") {
                let uri = LspServer.JsonStr(body, "uri")
                let txt = LspServer.JsonStr(body, "text")
                this.UpsertDoc(uri, txt)
                this.PublishDiagnostics(uri, txt)
            } else if (method == "textDocument/didClose") {
                let uri = LspServer.JsonStr(body, "uri")
                this.RemoveDoc(uri)
            } else if (method == "textDocument/hover") {
                let id   = LspServer.JsonInt(body, "id")
                let uri  = LspServer.JsonStr(body, "uri")
                let line = LspServer.JsonInt(body, "line")
                let chr  = LspServer.JsonInt(body, "character")
                this.HandleHover(id, uri, line, chr)
            } else if (method == "textDocument/completion") {
                let id   = LspServer.JsonInt(body, "id")
                let uri  = LspServer.JsonStr(body, "uri")
                let line = LspServer.JsonInt(body, "line")
                let chr  = LspServer.JsonInt(body, "character")
                this.HandleCompletion(id, uri, line, chr)
            }
            // Unknown method: ignore. LSP allows the server to skip
            // unhandled notifications, and we don't want to crash on
            // optional capability negotiation messages.
        }
        return 0
    }

    // ── Document storage ──────────────────────────────
    // Replace-or-insert. List<T> has no Set(idx, val) op, so we
    // remove + append on update. N is small (open file count) so
    // the linear scan is fine.
    private void UpsertDoc(string uri, string text) {
        let n = this.DocUris.Count()
        for i in 0..n {
            let u = this.DocUris.Get(i)
            if (u == uri) {
                this.DocUris.RemoveAt(i)
                this.Docs.RemoveAt(i)
                this.DocUris.Add(uri)
                this.Docs.Add(text)
                return
            }
        }
        this.DocUris.Add(uri)
        this.Docs.Add(text)
    }

    private void RemoveDoc(string uri) {
        let n = this.DocUris.Count()
        for i in 0..n {
            let u = this.DocUris.Get(i)
            if (u == uri) {
                this.DocUris.RemoveAt(i)
                this.Docs.RemoveAt(i)
                return
            }
        }
    }

    // Return the latest text for a tracked URI. Empty string if unknown
    // (the client should have sent didOpen first; we don't error here
    // because LSP allows hover/completion on closed buffers in theory).
    private string LookupDoc(string uri) {
        let n = this.DocUris.Count()
        for i in 0..n {
            let u = this.DocUris.Get(i)
            if (u == uri) { return this.Docs.Get(i) }
        }
        return ""
    }

    // ── Framing ───────────────────────────────────────
    // Read headers line-by-line until blank line, then read
    // exactly Content-Length bytes from stdin. Returns "" on EOF.
    private string ReadMessage() {
        var contentLen = 0
        var sawAnyHeader = false
        while (true) {
            let raw  = Console_ReadLine()
            let line = String_TrimEnd(raw)
            if (String_Length(line) == 0) {
                // EOF *before* any header: stdin closed.
                if (String_Length(raw) == 0 && !sawAnyHeader) {
                    return ""
                }
                // Blank line ends the header block.
                break
            }
            sawAnyHeader = true
            if (String_StartsWith(line, "Content-Length:")) {
                let lineLen: int = String_Length(line)
                let rest         = String_Substring(line, 15, lineLen - 15)
                contentLen       = String_ToInt(String_Trim(rest))
            }
        }
        if (contentLen <= 0) { return "" }
        return Console_ReadBytes(contentLen)
    }

    // Build a single CR byte (0x0d). `"\r"` and `"\x0d"` are both
    // mis-lexed by the bootstrapping amc, so we route through
    // String_FromByte which is just an int→byte builtin and has
    // no escape-table dependency.
    public static string Cr() { return String_FromByte(13) }

    // Write a framed JSON-RPC message. fflush so the client
    // doesn't block waiting for buffered output. CRLF is built
    // explicitly from bytes — see Cr() above.
    private void Send(string body) {
        let n: int  = String_Length(body)
        let crlf    = LspServer.Cr() + "\n"
        Console.Write("Content-Length: " + String_FromInt(n) + crlf + crlf)
        Console.Write(body)
        Console_Flush()
    }

    // ── Responses ─────────────────────────────────────
    private void SendInit(int id) {
        // textDocumentSync = 1 (Full): client sends the whole text
        // on every didChange. Simpler than incremental, fine for v1.
        // hoverProvider:  true  → client may send textDocument/hover
        // completionProvider: { triggerCharacters: ["."] } → client
        // requests completion lists on demand or when typing a dot.
        let body = "{\"jsonrpc\":\"2.0\",\"id\":" + String_FromInt(id) + ",\"result\":{\"capabilities\":{\"textDocumentSync\":1,\"hoverProvider\":true,\"completionProvider\":{\"triggerCharacters\":[\".\"]}}}}"
        this.Send(body)
    }

    private void SendShutdown(int id) {
        let body = "{\"jsonrpc\":\"2.0\",\"id\":" + String_FromInt(id) + ",\"result\":null}"
        this.Send(body)
    }

    private void PublishDiagnostics(string uri, string source) {
        let diags = this.Compile(uri, source)
        let body  = "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":\"" + Json.EscapeString(uri) + "\",\"diagnostics\":" + diags + "}}"
        this.Send(body)
    }

    // Build a FullResolver populated with ALL *.am files reachable
    // from the workspace root (detected by walking up from `path`
    // until a marker dir/file like .git or build_amc.sh is found).
    // The open document is the first program added; sibling files
    // follow. Two passes run as in main.am — CollectDecl across all
    // programs (so cross-file types like NodeKind from
    // src/parser/ast.am are visible everywhere), then ResolveDecl.
    //
    // This is what un-breaks the IDE: before this, opening any file
    // that referenced a type defined in another file produced a
    // forest of red "Unknown symbol" squiggles even though the build
    // was green. Diagnostics for sibling files are filtered out by
    // the caller (see Compile) so the editor only sees errors for
    // the document it's actually showing.
    private FullResolver BuildWorkspaceResolver(string path, AstNode prog) {
        let resolver = new FullResolver()
        resolver.Programs.Add(prog)
        this.LoadWorkspaceFiles(resolver, path)
        resolver.ResolvePrograms()
        return resolver
    }

    // Scan the workspace for sibling *.am files (any path other than
    // `currentPath`), parse each, and add the resulting AstNode to
    // `resolver.Programs`. Skips silently on read or scan failure —
    // the LSP can degrade to single-file mode rather than refuse to
    // serve diagnostics.
    private void LoadWorkspaceFiles(FullResolver resolver, string currentPath) {
        let root: string = LspServer.FindWorkspaceRoot(currentPath)
        if (String_Length(root) == 0) { return }
        // 2>/dev/null swallows "permission denied" noise from any
        // unrelated subtrees; on MSYS2 / POSIX `find` is universally
        // available (already used by `amc test` discovery).
        let findCmd: string = "find " + root + " -name '*.am' -type f 2>/dev/null"
        let result = Process.RunCapture(findCmd)
        if (result.Exit != 0) { return }
        let lines: List<string> = String_Split(String_Trim(result.Stdout), "\n")
        let n: int = lines.Count()
        for i in 0..n {
            let path: string = String_Trim(lines.Get(i))
            if (String_Length(path) == 0) { continue }
            if (path == currentPath) { continue }
            if (!File.Exists(path)) { continue }
            let src: string = File.ReadAll(path)
            let lex  = new Lexer(src, path)
            let toks = lex.Tokenize()
            let par  = new Parser(toks)
            let p    = par.Parse()
            p.Str2   = path
            resolver.Programs.Add(p)
        }
    }

    // Walk up from `startPath`'s directory until we find a marker
    // file (`.git`, `build_amc.sh`, or `package.json`) or run out
    // of parents. Returns the marker's parent directory, or the
    // start directory as a fallback. 8 levels is enough for sane
    // project layouts; anything deeper falls back to the file's
    // own directory and works file-locally.
    public static string FindWorkspaceRoot(string startPath) {
        var dir: string = LspServer.Dirname(startPath)
        let initialDir: string = dir
        for i in 0..8 {
            if (String_Length(dir) == 0) { return initialDir }
            if (File.Exists(dir + "/.git")) { return dir }
            if (File.Exists(dir + "/build_amc.sh")) { return dir }
            if (File.Exists(dir + "/package.json")) { return dir }
            let parent: string = LspServer.Dirname(dir)
            if (parent == dir) { return initialDir }
            dir = parent
        }
        return initialDir
    }

    public static string Dirname(string path) {
        let last: int = String_LastIndexOf(path, "/")
        if (last <= 0) { return "" }
        return String_Substring(path, 0, last)
    }

    // Run the same lex+parse+resolve+typecheck pipeline `main.am`
    // does for one file, then turn the collected errors into a
    // JSON array of LSP Diagnostic objects. Sibling files are loaded
    // by BuildWorkspaceResolver so cross-file type references resolve;
    // diagnostics are filtered to the open document so the editor
    // only sees errors for the file it's showing.
    private string Compile(string uri, string source) {
        let path = LspServer.UriToPath(uri)
        let lex  = new Lexer(source, path)
        let toks = lex.Tokenize()
        let par  = new Parser(toks)
        let prog = par.Parse()
        prog.Str2 = path

        let resolver = this.BuildWorkspaceResolver(path, prog)

        let tc = new TypeChecker(resolver, path)
        tc.Check(prog)

        var arr   = "["
        var first = true
        let rn = resolver.RawErrors.Count()
        for ri in 0..rn {
            let e: ResolverError = resolver.RawErrors.Get(ri)
            if (e.Filename != path) { continue }
            if (!first) { arr = arr + "," }
            arr = arr + LspServer.DiagnosticFromResolver(source, e)
            first = false
        }
        let tn = tc.Errors.Count()
        for ti in 0..tn {
            let te: TypeError = tc.Errors.Get(ti)
            if (te.Filename != path) { continue }
            if (!first) { arr = arr + "," }
            arr = arr + LspServer.DiagnosticFromTc(source, te)
            first = false
        }
        arr = arr + "]"
        return arr
    }

    // ── Hover ─────────────────────────────────────────

    private void HandleHover(int id, string uri, int line, int character) {
        let source = this.LookupDoc(uri)
        if (String_Length(source) == 0) {
            this.SendNullResult(id)
            return
        }
        let path = LspServer.UriToPath(uri)
        let lex  = new Lexer(source, path)
        let toks = lex.Tokenize()
        let par  = new Parser(toks)
        let prog = par.Parse()
        prog.Str2 = path
        let resolver = this.BuildWorkspaceResolver(path, prog)
        let tc = new TypeChecker(resolver, path)
        tc.Check(prog)

        // LSP positions are 0-based; AST is 1-based.
        let targetLine: int = line + 1
        let targetCol:  int = character + 1
        let node = LspServer.FindNodeAtPosition(prog, targetLine, targetCol)
        if (node == null) {
            this.SendNullResult(id)
            return
        }
        let typeStr = tc.LookupNodeType(node)
        if (typeStr == "?" || String_Length(typeStr) == 0) {
            // No inferred type for this node — common for declarations,
            // statements, keywords, etc. Return null so the editor
            // shows "no info" instead of an empty popup.
            this.SendNullResult(id)
            return
        }
        let content = "**" + node.Name + "**: `" + typeStr + "`"
        let body = "{\"jsonrpc\":\"2.0\",\"id\":" + String_FromInt(id) + ",\"result\":{\"contents\":{\"kind\":\"markdown\",\"value\":\"" + Json.EscapeString(content) + "\"}}}"
        this.Send(body)
    }

    private void SendNullResult(int id) {
        let body = "{\"jsonrpc\":\"2.0\",\"id\":" + String_FromInt(id) + ",\"result\":null}"
        this.Send(body)
    }

    // ── Completion ────────────────────────────────────
    //
    // Two flavours, picked by the character immediately to the left
    // of the cursor:
    //
    //   `obj.<cursor>` → member completion. Look back for the
    //   identifier preceding the dot, resolve its type via the
    //   resolver's local + global tables, and emit the methods/
    //   fields of that type from MemberTable.
    //
    //   anything else → global completion (the original v0.3.5
    //   behaviour: every name the resolver knows about, useful as
    //   a generic fallback).

    private void HandleCompletion(int id, string uri, int line, int chr) {
        let source = this.LookupDoc(uri)
        if (String_Length(source) == 0) {
            this.SendEmptyCompletion(id)
            return
        }
        let path = LspServer.UriToPath(uri)
        let lex  = new Lexer(source, path)
        let toks = lex.Tokenize()
        let par  = new Parser(toks)
        let prog = par.Parse()
        prog.Str2 = path
        let resolver = this.BuildWorkspaceResolver(path, prog)

        // Inspect the cursor context: if the character right before
        // the cursor is a dot, attempt member completion. LSP line/
        // character are 0-based.
        let receiverType: string = LspServer.ReceiverTypeAt(source, line, chr, resolver)
        if (String_Length(receiverType) > 0 && receiverType != "?") {
            this.SendMemberCompletion(id, resolver, receiverType)
            return
        }

        // Fallback: list every global the resolver knows. Editor
        // filters by prefix on its side.
        this.SendGlobalCompletion(id, resolver)
    }

    private void SendGlobalCompletion(int id, FullResolver resolver) {
        var items = ""
        var first = true
        let gn: int = resolver.GlobalCount()
        for gi in 0..gn {
            let name  = resolver.GlobalNameAt(gi)
            if (String_Length(name) == 0) { continue }
            let typeS = resolver.GlobalTypeAt(gi)
            // CompletionItemKind: 7 = Class, 6 = Variable, 3 = Function.
            //   "type" → Class      (e.g. List, Map, Math, user classes)
            //   "void" → Function   (e.g. Console_WriteLine, File_WriteAll)
            //   else   → Variable   (typed values: int, string, etc.)
            var kind = 6
            if (typeS == "type") { kind = 7 }
            else if (typeS == "void") { kind = 3 }
            if (!first) { items = items + "," }
            items = items + "{\"label\":\"" + Json.EscapeString(name) + "\",\"kind\":" + String_FromInt(kind) + ",\"detail\":\"" + Json.EscapeString(typeS) + "\"}"
            first = false
        }
        let body = "{\"jsonrpc\":\"2.0\",\"id\":" + String_FromInt(id) + ",\"result\":{\"isIncomplete\":false,\"items\":[" + items + "]}}"
        this.Send(body)
    }

    private void SendMemberCompletion(int id, FullResolver resolver, string typeName) {
        // Strip nullable "?" and pointer "*" so the MemberTable lookup
        // (keyed by bare class names) hits. Same normalisation as the
        // typechecker's CheckMemberExpr.
        var bare: string = typeName
        if (String_EndsWith(bare, "?")) {
            bare = String_Substring(bare, 0, String_Length(bare) - 1)
        }
        if (String_EndsWith(bare, "*")) {
            bare = String_Substring(bare, 0, String_Length(bare) - 1)
        }
        // Extract Members in a local first — a `resolver.Members.X(...)`
        // chain on the same line gets mashed by the cgen into
        // `resolver->Members_X(...)` (Field+Method on the same
        // expression doesn't lower yet). Same workaround pattern as
        // the migrate / Json test suite.
        let members: MemberTable = resolver.Members
        let mc: int = members.MemberCountFor(bare)
        if (mc == 0) {
            // No known members → fall back to empty rather than
            // surprising the user with a global dump for an unknown
            // type.
            this.SendEmptyCompletion(id)
            return
        }
        var items = ""
        var first = true
        for i in 0..mc {
            let name: string = members.MemberNameForAt(bare, i)
            if (String_Length(name) == 0) { continue }
            let mtype: string = members.Get(bare, name)
            // Heuristic: a bare type marker like "void" / "int" /
            // "string" on a member is a method's return type, so use
            // CompletionItemKind 2 = Method. Anything else is a field.
            // (We can't tell for sure without re-walking the AST; the
            // "?" returned for unknown stays Field.)
            var kind = 5
            if (mtype == "void" || mtype == "int" || mtype == "string" || mtype == "bool" || mtype == "float") {
                kind = 2
            } else if (String_Length(mtype) > 0 && mtype != "?") {
                kind = 2
            }
            if (!first) { items = items + "," }
            items = items + "{\"label\":\"" + Json.EscapeString(name) + "\",\"kind\":" + String_FromInt(kind) + ",\"detail\":\"" + Json.EscapeString(mtype) + "\"}"
            first = false
        }
        let body = "{\"jsonrpc\":\"2.0\",\"id\":" + String_FromInt(id) + ",\"result\":{\"isIncomplete\":false,\"items\":[" + items + "]}}"
        this.Send(body)
    }

    // Walk the source text at (line, chr) (LSP 0-based) and decide
    // whether the position is a member-completion site. Returns the
    // type name of the receiver, or "" if the context isn't `ident.`
    // / the receiver type can't be resolved.
    public static string ReceiverTypeAt(string source, int line, int chr, FullResolver resolver) {
        // Locate the start of the target line.
        let n: int = String_Length(source)
        var lineStart: int = 0
        var curLine: int = 0
        for i in 0..n {
            if (curLine == line) {
                lineStart = i
                break
            }
            let c: string = String_CharAt1(source, i)
            if (c == "\n") { curLine = curLine + 1 }
        }
        if (curLine != line) { return "" }
        // The cursor is at `lineStart + chr`. The character to its
        // left should be a dot for member completion.
        let cursorAbs: int = lineStart + chr
        if (cursorAbs <= 0 || cursorAbs > n) { return "" }
        // Before-cursor char check.
        let dotPos: int = cursorAbs - 1
        if (dotPos < 0) { return "" }
        let dotCh: string = String_CharAt1(source, dotPos)
        if (dotCh != ".") { return "" }
        // Walk back over the receiver identifier.
        var ident: string = ""
        var p: int = dotPos - 1
        while (p >= lineStart) {
            let c: string = String_CharAt1(source, p)
            if (LspServer.IsIdentChar(c)) {
                ident = c + ident
                p = p - 1
            } else { break }
        }
        if (String_Length(ident) == 0) { return "" }
        // Resolve the identifier's type:
        //   1. a global symbol (class / enum name) → the type IS the
        //      identifier (Class.StaticMember pattern).
        //   2. a local variable → look up its declared type.
        //   3. a `this` access — short circuit to the surrounding
        //      class. We don't track "current class at offset" yet,
        //      so we punt on this case in v1 and return "".
        if (ident == "this") { return "" }
        if (resolver.HasSymbol(ident)) {
            let t: string = resolver.GetTypeName(ident)
            // A class name has its own name as the type marker
            // (DeclareGlobal(name, name, false) for ENUM_DECL and
            // CLASS_DECL). That's the right thing to return for
            // member completion.
            if (String_Length(t) > 0 && t != "?") { return t }
        }
        // Local-variable text scan: walk the file looking for the
        // most recent `let <ident> = new <Type>(...)` or
        // `let <ident>: <Type> = ...` decl above the cursor. This is
        // a v1 heuristic — it doesn't follow control flow or shadow
        // semantics, but it covers the common pattern users hit
        // (`let g = new Greeter(...); g.<cursor>`).
        let lt: string = LspServer.ScanLocalDeclType(source, cursorAbs, ident)
        if (String_Length(lt) > 0) { return lt }
        return ""
    }

    // Scan `source` from the start to `before` for the latest
    // `let <ident>` or `var <ident>` declaration and pull its type
    // out of the right-hand side. Returns "" if nothing matches.
    private static string ScanLocalDeclType(string source, int before, string ident) {
        let n: int = String_Length(source)
        if (before > n) { before = n }
        // Two patterns we recognise:
        //   1. `let <ident>: <Type> = ...`
        //   2. `let <ident> = new <Type>(...)`
        // Same for `var`. Walk forwards keeping the most recent hit.
        var bestType: string = ""
        let needles = new List<string>()
        needles.Add("let " + ident)
        needles.Add("var " + ident)
        let nn: int = needles.Count()
        for ni in 0..nn {
            let needle: string = needles.Get(ni)
            let nlen: int = String_Length(needle)
            var pos: int = 0
            while (pos < before) {
                let idx: int = String_IndexOf(String_Substring(source, pos, before - pos), needle)
                if (idx < 0) { break }
                let absIdx: int = pos + idx
                // Confirm the match boundary: the char before must be
                // start-of-line / whitespace and the char after must be
                // a non-ident char (so `let g` doesn't match `let gen`).
                let okStart: bool = absIdx == 0 || !LspServer.IsIdentChar(String_CharAt1(source, absIdx - 1))
                let after: int   = absIdx + nlen
                let okEnd: bool  = after >= n || !LspServer.IsIdentChar(String_CharAt1(source, after))
                if (okStart && okEnd) {
                    let t: string = LspServer.ExtractTypeAfterDecl(source, after, n)
                    if (String_Length(t) > 0) { bestType = t }
                }
                pos = absIdx + nlen
            }
        }
        return bestType
    }

    // Starting just past `let <ident>`, parse forward to find either
    // `: <Type>` (annotation) or `= new <Type>(`. Returns the bare
    // type name or "" if neither shape is found.
    private static string ExtractTypeAfterDecl(string source, int start, int n) {
        var i: int = start
        // Skip whitespace.
        while (i < n) {
            let c: string = String_CharAt1(source, i)
            if (c == " " || c == "\t") { i = i + 1 } else { break }
        }
        if (i >= n) { return "" }
        let head: string = String_CharAt1(source, i)
        if (head == ":") {
            i = i + 1
            // Skip whitespace.
            while (i < n) {
                let c: string = String_CharAt1(source, i)
                if (c == " " || c == "\t") { i = i + 1 } else { break }
            }
            // Read identifier (possibly generic — we strip `<...>`).
            var t: string = ""
            while (i < n) {
                let c: string = String_CharAt1(source, i)
                if (LspServer.IsIdentChar(c)) {
                    t = t + c
                    i = i + 1
                } else { break }
            }
            return t
        }
        if (head == "=") {
            i = i + 1
            // Skip whitespace.
            while (i < n) {
                let c: string = String_CharAt1(source, i)
                if (c == " " || c == "\t") { i = i + 1 } else { break }
            }
            // Look for `new <Type>(`.
            let newKw: string = "new "
            if (i + 4 <= n) {
                let head4: string = String_Substring(source, i, 4)
                if (head4 == newKw) {
                    i = i + 4
                    var t: string = ""
                    while (i < n) {
                        let c: string = String_CharAt1(source, i)
                        if (LspServer.IsIdentChar(c)) {
                            t = t + c
                            i = i + 1
                        } else { break }
                    }
                    return t
                }
            }
        }
        return ""
    }

    private static bool IsIdentChar(string c) {
        if (String_Length(c) == 0) { return false }
        let alnum: string = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"
        return String_IndexOf(alnum, c) >= 0
    }

    private void SendEmptyCompletion(int id) {
        let body = "{\"jsonrpc\":\"2.0\",\"id\":" + String_FromInt(id) + ",\"result\":{\"isIncomplete\":false,\"items\":[]}}"
        this.Send(body)
    }

    // ── Helpers ───────────────────────────────────────
    // LSP positions are 0-based; our errors carry 1-based
    // (line, column) from the lexer. Underline a single character
    // at the error column — good enough for v1; richer ranges
    // (token width) can come later.
    // Two adapters: the resolver and the typechecker carry the same
    // info but in different classes (ResolverError vs TypeError) so
    // the source-file dependency graph stays one-way.
    public static string DiagnosticFromResolver(string source, ResolverError e) {
        return LspServer.DiagnosticBody(source, e.Line, e.Column, e.Message)
    }

    public static string DiagnosticFromTc(string source, TypeError e) {
        return LspServer.DiagnosticBody(source, e.Line, e.Column, e.Message)
    }

    // Build one LSP Diagnostic. The range underlines the token at
    // (line, col) — scanning forward in `source` for word chars
    // (letters/digits/underscore). Single-char fallback when the
    // char at the error column isn't word-y (operators, brackets, …).
    private static string DiagnosticBody(string source, int line, int col, string msg) {
        var l = line - 1
        var cStart = col - 1
        if (l < 0) { l = 0 }
        if (cStart < 0) { cStart = 0 }
        let endCol: int = LspServer.TokenEndCol(source, line, col)
        var cEnd: int = endCol - 1
        if (cEnd <= cStart) { cEnd = cStart + 1 }
        let lStr = String_FromInt(l)
        let cStartStr = String_FromInt(cStart)
        let cEndStr = String_FromInt(cEnd)
        return "{\"severity\":1,\"range\":{\"start\":{\"line\":" + lStr + ",\"character\":" + cStartStr + "},\"end\":{\"line\":" + lStr + ",\"character\":" + cEndStr + "}},\"message\":\"" + Json.EscapeString(msg) + "\"}"
    }

    // Find the 1-indexed column where the token starting at
    // (line, col) ends. "Token" here is a maximal run of word
    // chars; if (line, col) doesn't point at a word char, returns
    // col (the caller widens to col+1 to avoid empty ranges).
    private static int TokenEndCol(string source, int line, int col) {
        let n: int = String_Length(source)
        var off: int = 0
        var ln:  int = 1
        while (ln < line && off < n) {
            let ch = String_CharAt1(source, off)
            if (ch == "\n") { ln = ln + 1 }
            off = off + 1
        }
        var colIdx: int = 0
        while (colIdx < col - 1 && off < n) {
            let ch = String_CharAt1(source, off)
            if (ch == "\n") { break }
            off = off + 1
            colIdx = colIdx + 1
        }
        var endCol: int = col
        while (off < n) {
            let ch = String_CharAt1(source, off)
            if (LspServer.IsWordChar(ch)) {
                off = off + 1
                endCol = endCol + 1
            } else { break }
        }
        return endCol
    }

    private static bool IsWordChar(string ch) {
        if (String_Length(ch) == 0) { return false }
        if (ch == "_") { return true }
        if (String_IndexOf("0123456789", ch) >= 0) { return true }
        if (String_IndexOf("abcdefghijklmnopqrstuvwxyz", ch) >= 0) { return true }
        if (String_IndexOf("ABCDEFGHIJKLMNOPQRSTUVWXYZ", ch) >= 0) { return true }
        return false
    }

    // Minimal JSON string escape — covers what error messages
    // contain in practice (quotes, backslashes, newlines).
    // CR uses Cr() not "\r" (see Send() comment about lexer bootstrap).
    public static string EscapeJsonStr(string s) {
        let n: int = String_Length(s)
        let cr     = LspServer.Cr()
        var r = ""
        for i in 0..n {
            let ch = String_CharAt1(s, i)
            if (ch == "\"")      { r = r + "\\\"" }
            else if (ch == "\\") { r = r + "\\\\" }
            else if (ch == "\n") { r = r + "\\n" }
            else if (ch == cr)   { r = r + "\\r" }
            else if (ch == "\t") { r = r + "\\t" }
            else                  { r = r + ch }
        }
        return r
    }

    // file:///abs/path → /abs/path. Doesn't decode percent-encoding;
    // editors don't send it for plain ASCII paths in practice.
    public static string UriToPath(string uri) {
        if (String_StartsWith(uri, "file://")) {
            let n: int = String_Length(uri)
            return String_Substring(uri, 7, n - 7)
        }
        return uri
    }

    // ── AST positional lookup ─────────────────────────

    // Find the deepest AST node whose token covers the 1-based
    // (line, col). Returns null if no node has a Name field
    // matching the cursor word range. Walks Children/Params/Args
    // plus the four single-child slots (Left, Right, Cond, Body, Else).
    //
    // Coverage rule: the node "covers" (l, c) when its Line == l
    // and node.Column ≤ c ≤ node.Column + len(node.Name). The
    // open upper bound matches what an editor sees as "the cursor
    // is on this identifier" (the column past the last char still
    // counts).
    public static AstNode? FindNodeAtPosition(AstNode root, int line, int col) {
        if (root == null) { return null }
        var best: AstNode? = null
        best = LspServer.FindNodeWalk(root, line, col, best)
        return best
    }

    private static AstNode? FindNodeWalk(AstNode node, int line, int col, AstNode? best) {
        var current = best
        if (LspServer.NodeCovers(node, line, col)) {
            // Prefer the more deeply-nested match (which we'll
            // discover later in the walk), but also prefer named
            // nodes over unnamed structural nodes at the same depth.
            if (String_Length(node.Name) > 0) {
                current = node
            } else if (current == null) {
                current = node
            }
        }
        // Recurse into single-child slots
        if (node.Left  != null) { current = LspServer.FindNodeWalk(node.Left,  line, col, current) }
        if (node.Right != null) { current = LspServer.FindNodeWalk(node.Right, line, col, current) }
        if (node.Cond  != null) { current = LspServer.FindNodeWalk(node.Cond,  line, col, current) }
        if (node.Body  != null) { current = LspServer.FindNodeWalk(node.Body,  line, col, current) }
        if (node.Else  != null) { current = LspServer.FindNodeWalk(node.Else,  line, col, current) }
        // Recurse into child lists
        let cn: int = node.Children.Count()
        for ci in 0..cn {
            let c = node.Children.Get(ci)
            current = LspServer.FindNodeWalk(c, line, col, current)
        }
        let pn: int = node.Params.Count()
        for pi in 0..pn {
            let p = node.Params.Get(pi)
            current = LspServer.FindNodeWalk(p, line, col, current)
        }
        let an: int = node.Args.Count()
        for ai in 0..an {
            let a = node.Args.Get(ai)
            current = LspServer.FindNodeWalk(a, line, col, current)
        }
        return current
    }

    private static bool NodeCovers(AstNode node, int line, int col) {
        if (node.Line != line)  { return false }
        let nameLen: int = String_Length(node.Name)
        if (nameLen == 0)       { return false }
        let endCol: int = node.Column + nameLen
        if (col < node.Column)  { return false }
        if (col > endCol)       { return false }
        return true
    }

    // ── JSON ad-hoc extractors ────────────────────────
    // Find `"<key>"`, skip to the next `"`, then read until the
    // closing `"` — handling backslash escapes. Returns "" if
    // the key isn't found.
    public static string JsonStr(string body, string key) {
        let needle = "\"" + key + "\""
        let kIdx: int = String_IndexOf(body, needle)
        if (kIdx < 0) { return "" }
        let bn: int = String_Length(body)
        let needleLen: int = String_Length(needle)
        var i: int = kIdx + needleLen
        // Skip whitespace and `:` to the opening quote.
        while (i < bn) {
            let ch = String_CharAt1(body, i)
            if (ch == "\"") { i = i + 1; break }
            i = i + 1
        }
        var result = ""
        while (i < bn) {
            let ch = String_CharAt1(body, i)
            if (ch == "\"") { break }
            if (ch == "\\") {
                if (i + 1 >= bn) { break }
                let nx = String_CharAt1(body, i + 1)
                if (nx == "n")       { result = result + "\n" }
                else if (nx == "r")  { result = result + "\r" }
                else if (nx == "t")  { result = result + "\t" }
                else if (nx == "\"") { result = result + "\"" }
                else if (nx == "\\") { result = result + "\\" }
                else if (nx == "/")  { result = result + "/" }
                else                  { result = result + nx }
                i = i + 2
            } else {
                result = result + ch
                i = i + 1
            }
        }
        return result
    }

    // Find `"<key>"`, skip to the first digit (or `-`), and parse.
    public static int JsonInt(string body, string key) {
        let needle = "\"" + key + "\""
        let kIdx: int = String_IndexOf(body, needle)
        if (kIdx < 0) { return 0 }
        let bn: int   = String_Length(body)
        let dig       = "0123456789"
        let needleLen: int = String_Length(needle)
        var i: int    = kIdx + needleLen
        while (i < bn) {
            let ch = String_CharAt1(body, i)
            if (ch == "-") { break }
            if (String_IndexOf(dig, ch) >= 0) { break }
            i = i + 1
        }
        var numStr = ""
        while (i < bn) {
            let ch = String_CharAt1(body, i)
            if (ch == "-" || String_IndexOf(dig, ch) >= 0) {
                numStr = numStr + ch
                i = i + 1
            } else { break }
        }
        return String_ToInt(numStr)
    }
}
