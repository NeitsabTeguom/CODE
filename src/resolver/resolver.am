    // ── Scope management (nested stack) ───────────────
    // LocalNames/Types/IsLets is a flat array of all live entries across nested scopes.
    // ScopeStarts is a stack of start indices: the current scope owns indices [top..count).
    // Lookups walk LocalNames backwards so inner scopes shadow outer ones.

    private void PushScope(string label) {
        this.ScopeStarts.Add(this.LocalNames.Count())
    }

    private void PopScope() {
        let depth = this.ScopeStarts.Count()
        if (depth == 0) { return }
        let mark = this.ScopeStarts.Get(depth - 1)
        this.ScopeStarts.RemoveAt(depth - 1)
        // Truncate LocalNames/Types/IsLets back to mark (drop entries declared in this scope)
        while (this.LocalNames.Count() > mark) {
            let last = this.LocalNames.Count() - 1
            this.LocalNames.RemoveAt(last)
            this.LocalTypes.RemoveAt(last)
            this.LocalIsLets.RemoveAt(last)
        }
    }

    private int CurrentScopeStart() {
        let depth = this.ScopeStarts.Count()
        if (depth == 0) { return 0 }
        return this.ScopeStarts.Get(depth - 1)
    }

    private void DeclareGlobal(string name, string typeName, bool isLet) {
        let count = this.GlobalNames.Count()
        for i in 0..count {
            if (this.GlobalNames.Get(i) == name) { return }
        }
        this.GlobalNames.Add(name)
        this.GlobalTypes.Add(typeName)
    }

    // Helper exists separately so the self-host codegen sees the
    // PARAM AstNode through a typed parameter — chained `.Get(i).Name`
    // erases to void* across the call boundary and breaks the
    // declaration. Used by the lambda resolver branch.
    //
    // v2.5: respect the param's annotated type when it has been
    // pre-patched by PatchLambdaParamTypes from a higher-order method
    // callsite. Falls back to "?" (capture by-value as int) otherwise.
    private void DeclareLambdaParam(AstNode p) {
        var t: string = p.Str
        if (String_Length(t) == 0) { t = "?" }
        this.DeclareCurrent(p.Name, t, true)
    }

    private bool DeclareCurrent(string name, string typeName, bool isLet) {
        // Duplicate check: only within the current scope (allow shadowing outer scopes)
        let start = this.CurrentScopeStart()
        let count = this.LocalNames.Count()
        for i in start..count {
            if (this.LocalNames.Get(i) == name) { return false }
        }
        this.LocalNames.Add(name)
        this.LocalTypes.Add(typeName)
        this.LocalIsLets.Add(isLet)
        return true
    }

    private bool LookupInScopes(string name) {
        // Walk LocalNames backwards so inner (most recently pushed) scopes shadow outer ones
        var i = this.LocalNames.Count() - 1
        while (i >= 0) {
            if (this.LocalNames.Get(i) == name) { return true }
            i = i - 1
        }
        let gc = this.GlobalNames.Count()
        for j in 0..gc {
            if (this.GlobalNames.Get(j) == name) { return true }
        }
        return false
    }

    private string LookupType(string name) {
        var i = this.LocalNames.Count() - 1
        while (i >= 0) {
            if (this.LocalNames.Get(i) == name) { return this.LocalTypes.Get(i) }
            i = i - 1
        }
        let gc = this.GlobalNames.Count()
        for j in 0..gc {
            if (this.GlobalNames.Get(j) == name) { return this.GlobalTypes.Get(j) }
        }
        return "?"
    }

    private bool LookupIsLet(string name) {
        var i = this.LocalNames.Count() - 1
        while (i >= 0) {
            if (this.LocalNames.Get(i) == name) { return this.LocalIsLets.Get(i) }
            i = i - 1
        }
        return false
    }

    // Local-only lookup: return the LocalNames index, or -1 if not local.
    // Used by capture analysis to decide whether an identifier lives in
    // an enclosing scope (idx < LambdaBoundary) or in the lambda itself.
    private int IndexOfLocal(string name) {
        var i = this.LocalNames.Count() - 1
        while (i >= 0) {
            if (this.LocalNames.Get(i) == name) { return i }
            i = i - 1
        }
        return -1
    }

    // Record a captured local on the lambda node (in `Args`, deduped).
    // Each capture is stored as an IDENTIFIER node carrying the captured
    // name (Name) and its Amalgame type (Str), which CGen later turns
    // into the env struct field type.
    private void AddCapture(AstNode lam, string name, string typeName, int line, int col) {
        let n = lam.Args.Count()
        for i in 0..n {
            let arg = lam.Args.Get(i)
            if (arg.Name == name) { return }
        }
        let id = new AstNode(NodeKind.IDENTIFIER, line, col)
        id.Name = name
        id.Str  = typeName
        lam.Args.Add(id)
    }

    // ── Error reporting ───────────────────────────────

    private void Error(string msg, AstNode node) {
        this.EmitError(msg, node.Line, node.Column)
    }

    private void ErrorMsg(string msg) {
        this.EmitError(msg, 0, 0)
    }

    private void EmitError(string msg, int line, int col) {
        let file = this.CurrentFile
        let ln   = String_FromInt(line)
        let cl   = String_FromInt(col)
        var head = "\nerror[resolver]: " + msg + "\n"
        if (String_Length(file) > 0 && line > 0) {
            head = head + "  --> " + file + ":" + ln + ":" + cl + "\n"
            let snip = this.Sources.GetLine(file, line)
            head = head + SourceSnippet.Format(snip, line, col)
        }
        this.Errors.Add(head)
        // Structured copy for downstream consumers (LSP). The
        // formatted string in `Errors` stays untouched so existing
        // CLI output paths are unaffected.
        let raw = new ResolverError(msg, file, line, col)
        this.RawErrors.Add(raw)
    }

    public bool HasErrors() {
        return this.Errors.Count() > 0
    }

    public string GetErrors() {
        var result = ""
        let count  = this.Errors.Count()
        for i in 0..count {
            result = result + this.Errors.Get(i)
        }
        return result
    }

    // ── Public entry points ───────────────────────────

    // Typed accessors over Programs for callers (TypeChecker) — chained
    // access like `this.Symbols.Programs.Get(i)` confuses the self-host
    // codegen, which emits `Programs_Get` instead of `Programs->Get`.
    public int ProgramCount() {
        return this.Programs.Count()
    }

    public AstNode ProgramAt(int i) {
        return this.Programs.Get(i)
    }

    // Read-only enumeration of declared global names. Used by the LSP
    // server to populate completion lists. Names + types are kept in
    // lockstep, so the indices match.
    public int GlobalCount() {
        return this.GlobalNames.Count()
    }

    public string GlobalNameAt(int i) {
        return this.GlobalNames.Get(i)
    }

    public string GlobalTypeAt(int i) {
        return this.GlobalTypes.Get(i)
    }

    public void ResolvePrograms() {
        let progCount = this.Programs.Count()
        // Pass 1: collect all top-level declarations from all files
        for p in 0..progCount {
            let prog = this.Programs.Get(p)
            this.CollectProgram(prog)
        }
        // Pass 2: resolve bodies in all files
        for p2 in 0..progCount {
            let prog2 = this.Programs.Get(p2)
            this.ResolveProgram(prog2)
        }
    }

    // ── Pass 1: Collect ───────────────────────────────

    private void CollectProgram(AstNode prog) {
        let count = prog.Children.Count()
        for i in 0..count {
            this.CollectDecl(prog.Children.Get(i))
        }
    }

    private void CollectDecl(AstNode decl) {
        let k = decl.Kind
        if (k == NodeKind.CLASS_DECL) {
            this.DeclareGlobal(decl.Name, decl.Name, false)
            this.CollectClassMembers(decl)
        }
        if (k == NodeKind.ENUM_DECL) {
            this.DeclareGlobal(decl.Name, decl.Name, false)
            this.CollectEnumMembers(decl)
        }
    }

    private void CollectClassMembers(AstNode cls) {
        let name    = cls.Name
        let kids    = cls.Children
        let members = kids.Count()
        for i in 0..members {
            this.CollectClassMember(name, kids.Get(i))
        }
    }

    private void CollectClassMember(string className, AstNode m) {
        let mk = m.Kind
        if (mk == NodeKind.VAR_DECL) {
            this.Members.Set(className, m.Name, m.Str)
        }
        if (mk == NodeKind.METHOD_DECL) {
            this.Members.Set(className, m.Name, m.Str)
        }
    }

    private void CollectEnumMembers(AstNode en) {
        let name = en.Name
        let kids = en.Children
        let count = kids.Count()
        for i in 0..count {
            this.CollectEnumMember(name, kids.Get(i))
        }
    }

    private void CollectEnumMember(string enumName, AstNode m) {
        this.Members.Set(enumName, m.Name, enumName)
        let qualName = enumName + "_" + m.Name
        this.DeclareGlobal(qualName, enumName, false)
    }

    // ── Pass 2: Resolve ───────────────────────────────

    private void ResolveEnumChild(AstNode m) {
        if (m.Kind == NodeKind.METHOD_DECL) {
            this.ResolveMethod(m)
        }
    }

    private void ResolveProgram(AstNode prog) {
        // Filename is stashed by the parser in Str2 so error messages can
        // resolve to the right source for snippet rendering.
        this.CurrentFile = prog.Str2
        let count = prog.Children.Count()
        for i in 0..count {
            this.ResolveDecl(prog.Children.Get(i))
        }
    }

    private void ResolveDecl(AstNode decl) {
        let k = decl.Kind
        if (k == NodeKind.CLASS_DECL) {
            this.ResolveClass(decl)
        }
        if (k == NodeKind.ENUM_DECL) {
            let enumKids = decl.Children
            let methods  = enumKids.Count()
            for i in 0..methods {
                this.ResolveEnumChild(enumKids.Get(i))
            }
        }
    }

    private void ResolveClass(AstNode cls) {
        let prevClass     = this.CurrentClass
        this.CurrentClass = cls.Name
        this.PushScope("class:" + cls.Name)

        // Register "this" in class scope
        this.DeclareCurrent("this", cls.Name, false)

        // Pre-register all fields and methods in class scope
        let classKids = cls.Children
        let members   = classKids.Count()
        for i in 0..members {
            this.PreRegisterMember(classKids.Get(i))
        }

        // Resolve method bodies
        for j in 0..members {
            this.ResolveMember(classKids.Get(j))
        }

        this.PopScope()
        this.CurrentClass = prevClass
    }

    private void PreRegisterMember(AstNode m) {
        let mk = m.Kind
        if (mk == NodeKind.VAR_DECL) {
            this.DeclareCurrent(m.Name, m.Str, false)
        }
        if (mk == NodeKind.METHOD_DECL) {
            this.DeclareCurrent(m.Name, m.Str, false)
        }
    }

    private void ResolveMember(AstNode m) {
        let mk = m.Kind
        if (mk == NodeKind.METHOD_DECL) {
            this.ResolveMethod(m)
        }
        if (mk == NodeKind.VAR_DECL) {
            if (m.Left != null) { this.ResolveExpr(m.Left) }
        }
    }

    private void ResolveMethod(AstNode method) {
        let prevReturn     = this.CurrentReturn
        this.CurrentReturn = method.Str
        this.PushScope("method:" + method.Name)

        // Register params
        let params = method.Params.Count()
        for i in 0..params {
            let p = method.Params.Get(i)
            this.DeclareCurrent(p.Name, p.Str, true)
        }

        // Resolve body
        if (method.Body != null) {
            this.ResolveBlock(method.Body)
        }

        this.PopScope()
        this.CurrentReturn = prevReturn
    }

    private void ResolveBlock(AstNode block) {
        this.PushScope("block")
        let stmts = block.Children.Count()
        for i in 0..stmts {
            this.ResolveStmt(block.Children.Get(i))
        }
        this.PopScope()
    }

    private void ResolveStmt(AstNode stmt) {
        if (stmt == null) { return }
        let k = stmt.Kind

        if (k == NodeKind.VAR_DECL) {
            // Resolve RHS first (can't see variable being declared)
            if (stmt.Left != null) { this.ResolveExpr(stmt.Left) }
            let isLet = stmt.Flag == false   // Flag = isMut; let = not mutable
            // v2.5: when no annotation is given, infer the variable's
            // type from the RHS so PatchLambdaParamTypes can later see
            // it as `List<User>` (rather than ""). Falls back to the
            // explicit annotation otherwise.
            var declType: string = stmt.Str
            if (String_Length(declType) == 0 && stmt.Left != null) {
                declType = this.InferExprType(stmt.Left)
            }
            this.DeclareCurrent(stmt.Name, declType, isLet)
            return
        }
        if (k == NodeKind.RETURN_STMT) {
            if (stmt.Left != null) { this.ResolveExpr(stmt.Left) }
            return
        }
        if (k == NodeKind.IF_STMT) {
            this.ResolveIf(stmt)
            return
        }
        if (k == NodeKind.WHILE_STMT) {
            if (stmt.Cond != null) { this.ResolveExpr(stmt.Cond) }
            this.LoopDepth = this.LoopDepth + 1
            if (stmt.Body != null) { this.ResolveBlock(stmt.Body) }
            this.LoopDepth = this.LoopDepth - 1
            return
        }
        if (k == NodeKind.FOR_IN_STMT) {
            this.ResolveForIn(stmt)
            return
        }
        if (k == NodeKind.BREAK_STMT) {
            if (this.LoopDepth == 0) { this.Error("'break' outside loop", stmt) }
            return
        }
        if (k == NodeKind.CONTINUE_STMT) {
            if (this.LoopDepth == 0) { this.Error("'continue' outside loop", stmt) }
            return
        }
        if (k == NodeKind.TRY_STMT) {
            if (stmt.Body != null) { this.ResolveBlock(stmt.Body) }
            if (stmt.Else != null) {
                this.PushScope("catch")
                if (String_Length(stmt.Name) > 0) {
                    this.DeclareCurrent(stmt.Name, "void*", true)
                }
                this.ResolveBlock(stmt.Else)
                this.PopScope()
            }
            if (stmt.Cond != null) { this.ResolveBlock(stmt.Cond) }
            return
        }
        if (k == NodeKind.THROW_STMT) {
            if (stmt.Left != null) { this.ResolveExpr(stmt.Left) }
            return
        }
        if (k == NodeKind.ASSIGN) {
            this.ResolveAssign(stmt)
            return
        }
        // Match
        if (stmt.Name == "__match__") {
            this.ResolveMatch(stmt)
            return
        }
        // Block (e.g. try/catch emitted as nested block)
        if (k == NodeKind.BLOCK) {
            this.ResolveBlock(stmt)
            return
        }
        // Expression statement
        this.ResolveExpr(stmt)
    }

    private void ResolveIf(AstNode stmt) {
        if (stmt.Cond != null) { this.ResolveExpr(stmt.Cond) }
        if (stmt.Body != null) { this.ResolveBlock(stmt.Body) }
        if (stmt.Else != null) {
            this.ResolveElseBranch(stmt.Else)
        }
    }

    private void ResolveElseBranch(AstNode branch) {
        if (branch == null) { return }
        let bk = branch.Kind
        if (bk == NodeKind.IF_STMT) {
            this.ResolveIf(branch)
        } else {
            this.ResolveBlock(branch)
        }
    }

    private void ResolveForIn(AstNode stmt) {
        // stmt.Left = iterable, stmt.Name = loop var
        if (stmt.Left != null) { this.ResolveExpr(stmt.Left) }
        this.PushScope("for-in")
        // Infer element type from iterable
        var elemType = "?"
        if (stmt.Left != null) {
            let colType = this.InferExprType(stmt.Left)
            elemType    = this.CollectionElemType(colType)
        }
        this.DeclareCurrent(stmt.Name, elemType, true)
        this.LoopDepth = this.LoopDepth + 1
        if (stmt.Body != null) { this.ResolveBlock(stmt.Body) }
        this.LoopDepth = this.LoopDepth - 1
        this.PopScope()
    }

    private void ResolveAssign(AstNode stmt) {
        if (stmt.Left  != null) { this.ResolveExpr(stmt.Left) }
        if (stmt.Right != null) { this.ResolveExpr(stmt.Right) }
        // Immutability check
        if (stmt.Left != null && stmt.Left.Kind == NodeKind.IDENTIFIER) {
            let varName = stmt.Left.Name
            if (this.LookupIsLet(varName)) {
                this.Error("Cannot assign to immutable binding '" + varName + "'", stmt.Left)
            }
        }
    }

    private void ResolveMatch(AstNode stmt) {
        if (stmt.Left != null) { this.ResolveExpr(stmt.Left) }
        let armCount = stmt.Children.Count()
        for i in 0..armCount {
            this.ResolveMatchArm(stmt.Children.Get(i))
        }
    }

    private void ResolveMatchArm(AstNode arm) {
        if (arm == null) { return }
        this.PushScope("match-arm")
        // arm.Left = pattern, arm.Right = body
        if (arm.Left  != null) { this.ResolveExpr(arm.Left) }
        let armBody = arm.Right
        if (armBody != null) {
            this.ResolveArmBody(armBody)
        }
        this.PopScope()
    }

    private void ResolveArmBody(AstNode body) {
        let bk = body.Kind
        if (bk == NodeKind.BLOCK) {
            let kids  = body.Children
            let count = kids.Count()
            for i in 0..count {
                this.ResolveStmt(kids.Get(i))
            }
        } else {
            this.ResolveStmt(body)
        }
    }

    // ── Lambda param-type inference (v2.5) ────────────
    //
    // When the call is a higher-order list method like
    // xs.Map(x => x.Name), the lambda's PARAM is created with type "?"
    // by the parser. The CGen emits the lambda top-level BEFORE seeing
    // the callsite, so without this patch the body would resolve `x` as
    // an untyped local and `x.Name` would fail. We mutate p.Str on the
    // PARAM AstNode here, before descending into the lambda body, so
    // that DeclareLambdaParam (and later the typechecker / cgen) see
    // the inferred element type.
    //
    // Single-T methods (Map, Filter, ForEach, Any, All, CountIf) take a
    // (T) → ? lambda where T is the element type of the receiver.
    // Reduce takes (Acc, T) → Acc and is deferred to a follow-up
    // because the Acc type depends on the init argument, not the
    // receiver alone.
    private void PatchLambdaParamTypes(AstNode call) {
        if (call.Left == null) { return }
        if (call.Left.Kind != NodeKind.MEMBER) { return }
        let methodName = call.Left.Name
        var isSingleT = false
        if (methodName == "Map") { isSingleT = true }
        else if (methodName == "Filter") { isSingleT = true }
        else if (methodName == "ForEach") { isSingleT = true }
        else if (methodName == "Any") { isSingleT = true }
        else if (methodName == "All") { isSingleT = true }
        else if (methodName == "CountIf") { isSingleT = true }
        if (!isSingleT) { return }
        if (call.Left.Left == null) { return }
        let recvType = this.InferExprType(call.Left.Left)
        let elem: string = this.CollectionElemType(recvType)
        if (String_Length(elem) == 0) { return }
        if (elem == "?") { return }
        let argc: int = call.Args.Count()
        for i in 0..argc {
            let arg = call.Args.Get(i)
            if (arg.Kind == NodeKind.METHOD_DECL && arg.Name == "__lambda__") {
                let pn: int = arg.Params.Count()
                if (pn >= 1) {
                    let p = arg.Params.Get(0)
                    if (String_Length(p.Str) == 0 || p.Str == "?") {
                        p.Str = elem
                    }
                }
            }
        }
    }

    // ── Expression resolver ───────────────────────────

    private void ResolveExpr(AstNode expr) {
        if (expr == null) { return }
        let k = expr.Kind

        if (k == NodeKind.IDENTIFIER) {
            // Skip parser error-recovery placeholders — they already represent a parse error
            if (expr.Name == "_unknown_") { return }
            // Wildcard placeholder used in match patterns. Treated as "matches
            // anything" by the codegen; the resolver shouldn't insist on a
            // declared binding for it.
            if (expr.Name == "_") { return }
            if (!this.LookupInScopes(expr.Name)) {
                this.Error("Unknown symbol '" + expr.Name + "'", expr)
                return
            }
            // Capture analysis: while inside a lambda body, any local
            // resolved at an index below LambdaBoundary lives in an
            // enclosing scope and must be captured by value. Fall back
            // to "int" when the local was declared without an
            // annotation and the resolver doesn't have a richer type
            // — matches v1 closures' (i64) -> i64 boxing convention.
            if (this.LambdaInProgress != null) {
                let idx = this.IndexOfLocal(expr.Name)
                if (idx != -1 && idx < this.LambdaBoundary) {
                    var typeName = this.LocalTypes.Get(idx)
                    if (String_Length(typeName) == 0 || typeName == "?") {
                        typeName = "int"
                    }
                    this.AddCapture(this.LambdaInProgress, expr.Name, typeName, expr.Line, expr.Column)
                }
            }
            return
        }
        if (k == NodeKind.BINARY) {
            if (expr.Left  != null) { this.ResolveExpr(expr.Left) }
            if (expr.Right != null) { this.ResolveExpr(expr.Right) }
            return
        }
        if (k == NodeKind.UNARY) {
            if (expr.Left != null) { this.ResolveExpr(expr.Left) }
            return
        }
        if (k == NodeKind.MEMBER) {
            // Only resolve the target; member name validated by TypeChecker
            if (expr.Left != null) { this.ResolveExpr(expr.Left) }
            return
        }
        if (k == NodeKind.CALL) {
            if (expr.Left != null) { this.ResolveExpr(expr.Left) }
            // v2.5: when the call is a higher-order list method
            // (xs.Map/Filter/...), patch the lambda arg's PARAM types
            // from the receiver's element type so the body can resolve
            // member access like `x.Name` instead of failing on `?`.
            this.PatchLambdaParamTypes(expr)
            let argc = expr.Args.Count()
            for i in 0..argc {
                this.ResolveExpr(expr.Args.Get(i))
            }
            return
        }
        if (k == NodeKind.NEW_EXPR) {
            let argc = expr.Args.Count()
            for i in 0..argc {
                this.ResolveExpr(expr.Args.Get(i))
            }
            return
        }
        if (k == NodeKind.INDEX_EXPR) {
            if (expr.Left  != null) { this.ResolveExpr(expr.Left) }
            if (expr.Right != null) { this.ResolveExpr(expr.Right) }
            return
        }
        if (k == NodeKind.LIST_COMP) {
            // [proj for var in iter (if guard)?]: resolve iter in the
            // outer scope, then push a scope so var shadows whatever
            // outer binding has the same name while resolving the
            // projection and guard.
            if (expr.Right != null) { this.ResolveExpr(expr.Right) }
            this.PushScope("list-comp")
            var elemType = "?"
            if (expr.Right != null) {
                let colType = this.InferExprType(expr.Right)
                elemType    = this.CollectionElemType(colType)
            }
            this.DeclareCurrent(expr.Str, elemType, true)
            if (expr.Left != null) { this.ResolveExpr(expr.Left) }
            if (expr.Cond != null) { this.ResolveExpr(expr.Cond) }
            this.PopScope()
            return
        }
        if (k == NodeKind.ASSIGN) {
            this.ResolveAssign(expr)
            return
        }
        if (k == NodeKind.IF_STMT) {
            // match-as-expression: parser reuses IF_STMT with Name=__match__,
            // arms in Children. Delegate to the existing match resolver so
            // the arm bodies see the correct binders.
            if (expr.Name == "__match__") {
                this.ResolveMatch(expr)
                return
            }
            // if-expression
            if (expr.Cond != null) { this.ResolveExpr(expr.Cond) }
            if (expr.Body != null) { this.ResolveBlock(expr.Body) }
            if (expr.Else != null) { this.ResolveElseBranch(expr.Else) }
            return
        }
        if (k == NodeKind.METHOD_DECL && expr.Name == "__lambda__") {
            // Lambda body: open a fresh scope, declare every param at
            // the boundary, and resolve the body with capture tracking
            // on. Saving/restoring the previous LambdaInProgress lets
            // nested lambdas work; the inner lambda captures into
            // itself, and any of those captures that came from outside
            // the outer lambda will also re-trigger capture on the
            // outer when the inner is being resolved.
            //
            // v2: Params is a List<AstNode> of PARAMs (was Str=name in
            // v1). Body is either an expression in Left, or a BLOCK in
            // Body — exclusive, set by the parser.
            let prevLam      = this.LambdaInProgress
            let prevBoundary = this.LambdaBoundary
            this.PushScope("lambda")
            this.LambdaInProgress = expr
            this.LambdaBoundary   = this.LocalNames.Count()
            let pn: int = expr.Params.Count()
            for pi in 0..pn {
                this.DeclareLambdaParam(expr.Params.Get(pi))
            }
            if (expr.Left != null) { this.ResolveExpr(expr.Left) }
            if (expr.Body != null) { this.ResolveBlock(expr.Body) }
            this.PopScope()
            this.LambdaInProgress = prevLam
            this.LambdaBoundary   = prevBoundary
            return
        }
        // Literals, this, null — always valid
    }

    // ── Type inference (lightweight, for for-in) ──────

    private string InferExprType(AstNode expr) {
        if (expr == null) { return "?" }
        let k = expr.Kind
        if (k == NodeKind.IDENTIFIER) { return this.LookupType(expr.Name) }
        if (k == NodeKind.LITERAL_INT)    { return "int" }
        if (k == NodeKind.LITERAL_FLOAT)  { return "float" }
        if (k == NodeKind.LITERAL_STRING) { return "string" }
        if (k == NodeKind.LITERAL_BOOL)   { return "bool" }
        if (k == NodeKind.BINARY && expr.Str == "..") { return "range" }
        if (k == NodeKind.NEW_EXPR) {
            // v2.5: include the generic type-arg so List<User> is
            // returned as "List<User>" — needed by
            // PatchLambdaParamTypes via CollectionElemType.
            if (String_Length(expr.Str2) > 0) {
                return expr.Name + "<" + expr.Str2 + ">"
            }
            return expr.Name
        }
        if (k == NodeKind.MEMBER) {
            if (expr.Left != null) {
                let targetType = this.InferExprType(expr.Left)
                return this.Members.Get(targetType, expr.Name)
            }
        }
        if (k == NodeKind.CALL) {
            // For chained higher-order list calls — `xs.Filter(p).Map(q)` —
            // we need to infer the type of the inner call so that
            // PatchLambdaParamTypes can patch q's param against the
            // correct element type. Type-preserving methods (Filter,
            // ForEach) yield the receiver's type unchanged. Map/Reduce
            // change the element type and need lambda return-type
            // inference, which we don't yet have at the resolver layer
            // (deferred — falls through to "?").
            if (expr.Left != null && expr.Left.Kind == NodeKind.MEMBER) {
                let mname = expr.Left.Name
                if (mname == "Filter" || mname == "ForEach") {
                    if (expr.Left.Left != null) {
                        return this.InferExprType(expr.Left.Left)
                    }
                }
            }
        }
        return "?"
    }

    private string CollectionElemType(string typeKey) {
        if (typeKey == "range" || typeKey == "int") { return "int" }
        if (String_StartsWith(typeKey, "List<") && String_EndsWith(typeKey, ">")) {
            return String_Substring(typeKey, 5, String_Length(typeKey) - 6)
        }
        if (String_StartsWith(typeKey, "Set<") && String_EndsWith(typeKey, ">")) {
            return String_Substring(typeKey, 4, String_Length(typeKey) - 5)
        }
        if (String_EndsWith(typeKey, "[]")) {
            return String_Substring(typeKey, 0, String_Length(typeKey) - 2)
        }
        return "?"
    }

    // ── Public query API (used by TypeChecker) ────────

    public string GetMemberType(string className, string memberName) {
        return this.Members.Get(className, memberName)
    }

    public bool HasMember(string className, string memberName) {
        return this.Members.Has(className, memberName)
    }

    public string GetVarType(string name) {
        return this.LookupType(name)
    }

    // ── SymbolTable-compatible API for TypeChecker ────
    // Allows TypeChecker to call resolver.Global-style methods
    // without needing a separate SymbolTable object.

    public bool HasSymbol(string name) {
        return this.LookupInScopes(name)
    }

    public string GetTypeName(string name) {
        return this.LookupType(name)
    }

    public void SetTypeName(string name, string typeName) {
        let lc = this.LocalNames.Count()
        for i in 0..lc {
            if (this.LocalNames.Get(i) == name) {
                this.LocalTypes.Add(typeName)
                return
            }
        }
        let gc = this.GlobalNames.Count()
        for i in 0..gc {
            if (this.GlobalNames.Get(i) == name) {
                this.GlobalTypes.Add(typeName)
                return
            }
        }
    }
}
