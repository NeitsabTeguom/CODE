    // ── Infer C type from RHS expression ─────────────
    // Memoized entry point. Look up the node by its C pointer
    // identity; on a miss, dispatch to InferTypeFromExprUncached
    // and cache the result. Critical for long fluent-chain expressions
    // (e.g. v0.0.5 ui-web builders with 20+ AddChild) — without the
    // cache the recursion re-inferred every prefix at every step.
    private string InferTypeFromExpr(AstNode expr) {
        if (expr == null) { return "" }
        var key: int = 0
        @c {
            key = (i64)expr;
        }
        let n: int = this.InferCacheKeys.Count()
        for i in 0..n {
            if (this.InferCacheKeys.Get(i) == key) {
                return this.InferCacheVals.Get(i)
            }
        }
        let result: string = this.InferTypeFromExprUncached(expr)
        this.InferCacheKeys.Add(key)
        this.InferCacheVals.Add(result)
        return result
    }

    private string InferTypeFromExprUncached(AstNode expr) {
        if (expr == null) { return "" }
        let k = expr.Kind
        if (k == NodeKind.LIST_COMP)      { return "AmalgameList*" }
        if (k == NodeKind.LIST_LITERAL)   { return "AmalgameList*" }
        // match-as-expression: type is the type of the first arm body.
        // (All arms must agree at runtime; we trust the first as a hint.)
        if (k == NodeKind.IF_STMT && expr.Name == "__match__") {
            if (expr.Children.Count() > 0) {
                let firstArm: AstNode = expr.Children.Get(0)
                if (firstArm.Right != null) {
                    return this.InferTypeFromExpr(firstArm.Right)
                }
            }
            return ""
        }
        // if-as-expression: the type is the type of the then-branch.
        // The body is a BLOCK whose last child is the result expression.
        if (k == NodeKind.IF_STMT) {
            if (expr.Body != null) {
                let body: AstNode = expr.Body
                if (body.Kind == NodeKind.BLOCK && body.Children.Count() > 0) {
                    let last: AstNode = body.Children.Get(body.Children.Count() - 1)
                    return this.InferTypeFromExpr(last)
                }
                return this.InferTypeFromExpr(body)
            }
            return ""
        }
        if (k == NodeKind.LITERAL_INT)    { return "i64" }
        if (k == NodeKind.LITERAL_FLOAT)  { return "double" }
        if (k == NodeKind.LITERAL_STRING) { return "code_string" }
        if (k == NodeKind.LITERAL_BOOL)   { return "code_bool" }
        if (k == NodeKind.BINARY) {
            let bop = expr.Str
            let isCmpOp = (bop == "&&" || bop == "||" || bop == "==" || bop == "!=")
            let isRelOp = (bop == "<" || bop == ">" || bop == "<=" || bop == ">=")
            if (isCmpOp || isRelOp) {
                return "code_bool"
            }
            // Arithmetic: propagate numeric/string types
            if (bop == "+" || bop == "-" || bop == "*" || bop == "/" || bop == "%") {
                let lt = this.InferTypeFromExpr(expr.Left)
                let rt = this.InferTypeFromExpr(expr.Right)
                if (lt == "code_string" || rt == "code_string") { return "code_string" }
                if (expr.Left != null) {
                    if (expr.Left.Kind == NodeKind.LITERAL_STRING) { return "code_string" }
                    if (expr.Left.Kind == NodeKind.LITERAL_INT)    { return "i64" }
                }
                if (expr.Right != null) {
                    if (expr.Right.Kind == NodeKind.LITERAL_STRING) { return "code_string" }
                    if (expr.Right.Kind == NodeKind.LITERAL_INT)    { return "i64" }
                }
                if (lt == "i64" || rt == "i64") { return "i64" }
                if (lt == "double" || rt == "double") { return "double" }
            }
        }
        if (k == NodeKind.UNARY) {
            if (expr.Str == "!") { return "code_bool" }
        }
        if (k == NodeKind.IDENTIFIER) {
            // Could be a local var — look it up
            return this.LocalTypeGet(expr.Name)
        }
        if (k == NodeKind.MEMBER) {
            // this.Field → look up field type
            if (expr.Left != null) {
                let lk = expr.Left.Kind
                if (lk == NodeKind.THIS_EXPR) {
                    return this.FieldTypeGet(this.CurrentClass, expr.Name)
                }
                if (lk == NodeKind.IDENTIFIER) {
                    let lname = expr.Left.Name
                    let varCType = this.LocalTypeGet(lname)
                    let bare = String_Replace(varCType, "*", "")
                    if (String_Length(bare) > 0) {
                        return this.FieldTypeGet(bare, expr.Name)
                    }
                    // Not a local var — check if it's an enum type (Direction.North → Tests_Direction)
                    let symT = this.SymName(lname)
                    if (this.IsEnum(symT)) { return symT }
                    if (this.IsEnum(lname)) { return this.SymName(lname) }
                }
                // CALL.Field — e.g. this.Current().Value → infer type from call return
                if (lk == NodeKind.CALL) {
                    let callRetT = this.InferTypeFromExpr(expr.Left)
                    let bareCall = String_Replace(callRetT, "*", "")
                    if (String_Length(bareCall) > 0) {
                        let ft = this.FieldTypeGet(bareCall, expr.Name)
                        if (String_Length(ft) > 0) { return ft }
                    }
                }
                // MEMBER.Field — limit to avoid deep recursion / stack overflow
                // handles: this.Field.Prop, var.Field.Prop, var.Field.Field.Prop
                if (lk == NodeKind.MEMBER) {
                    if (expr.Left.Left != null) {
                        let llk2 = expr.Left.Left.Kind
                        if (llk2 == NodeKind.THIS_EXPR) {
                            let fname2 = expr.Left.Name
                            let parentT = this.FieldTypeGet(this.CurrentClass, fname2)
                            let bareP = String_Replace(parentT, "*", "")
                            if (String_Length(bareP) > 0) {
                                let ft2 = this.FieldTypeGet(bareP, expr.Name)
                                if (String_Length(ft2) > 0) { return ft2 }
                            }
                        }
                        if (llk2 == NodeKind.IDENTIFIER) {
                            let vname3 = expr.Left.Left.Name
                            let vtype3 = this.LocalTypeGet(vname3)
                            let bareV  = String_Replace(vtype3, "*", "")
                            if (String_Length(bareV) > 0) {
                                let fname3   = expr.Left.Name
                                let parentT3 = this.FieldTypeGet(bareV, fname3)
                                let bareP3   = String_Replace(parentT3, "*", "")
                                if (String_Length(bareP3) > 0) {
                                    let ft3 = this.FieldTypeGet(bareP3, expr.Name)
                                    if (String_Length(ft3) > 0) { return ft3 }
                                }
                            }
                        }
                        // var.Field.Field.Prop — 3-level chain
                        if (llk2 == NodeKind.MEMBER) {
                            if (expr.Left.Left.Left != null) {
                                let lll = expr.Left.Left.Left
                                if (lll.Kind == NodeKind.IDENTIFIER) {
                                    let vn4   = lll.Name
                                    let vt4   = this.LocalTypeGet(vn4)
                                    let bare4 = String_Replace(vt4, "*", "")
                                    if (String_Length(bare4) > 0) {
                                        let fn4   = expr.Left.Left.Name
                                        let pt4   = this.FieldTypeGet(bare4, fn4)
                                        let bp4   = String_Replace(pt4, "*", "")
                                        if (String_Length(bp4) > 0) {
                                            let fn5 = expr.Left.Name
                                            let pt5 = this.FieldTypeGet(bp4, fn5)
                                            let bp5 = String_Replace(pt5, "*", "")
                                            if (String_Length(bp5) > 0) {
                                                let ft5 = this.FieldTypeGet(bp5, expr.Name)
                                                if (String_Length(ft5) > 0) { return ft5 }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            return ""
        }
        if (k == NodeKind.NEW_EXPR) {
            let tname = expr.Name
            if (String_StartsWith(tname, "List<") || tname == "List") { return "AmalgameList*" }
            if (String_StartsWith(tname, "Map<")  || tname == "Map")  { return "AmalgameMap*" }
            if (String_StartsWith(tname, "Set<")  || tname == "Set")  { return "AmalgameSet*" }
            // Math.Vec / Mat4 migrated to AM (post-v0.7.5); the
            // types lower via the bundled-namespace mangling, no
            // special case needed here.
            // FileWatcher migrated to AM (post-v0.7.5); the type
            // now lowers via the bundled-namespace mangling, no
            // special case needed here.
            if (tname == "Match") { return "AmalgameRegexMatch*" }
            if (tname == "WebSocket") { return "AmalgameWebSocket*" }
            if (this.IsEnum(tname)) { return this.SymName(tname) }
            // Project F: external classes infer to their file's own
            // mangled name (e.g. `Amalgame_Formats_Json_JsonValue*`)
            // even when the inference comes from a `new JsonValue()`
            // in a different namespace.
            let externalMangled: string = this.ExternalClassMangled(tname)
            if (String_Length(externalMangled) > 0) {
                return externalMangled + "*"
            }
            return this.SymName(tname) + "*"
        }
        // method call returning a known type — check callee
        if (k == NodeKind.CALL) {
            // Higher-order list calls (Filter/Map return AmalgameList*).
            // Detect via the receiver method name on the MEMBER node so
            // we don't have to round-trip through EmitCalleeStr (which
            // builds a String for non-stdlib calls).
            if (expr.Left != null && expr.Left.Kind == NodeKind.MEMBER) {
                let mname = expr.Left.Name
                if (mname == "Filter" || mname == "Map") { return "AmalgameList*" }
                if (mname == "Any" || mname == "All")     { return "code_bool" }
                if (mname == "CountIf")                   { return "i64" }
            }
            if (expr.Left != null) {
                let calleeStr = this.EmitCalleeStr(expr.Left)
                if (calleeStr == "AmalgameMap_has" || calleeStr == "AmalgameMap_remove" || calleeStr == "AmalgameSet_contains" || calleeStr == "AmalgameSet_remove" || calleeStr == "AmalgameSet_add") { return "code_bool" }
                if (calleeStr == "AmalgameMap_size" || calleeStr == "AmalgameSet_size") { return "i64" }
                if (calleeStr == "AmalgameList_isEmpty" || calleeStr == "AmalgameList_remove") { return "code_bool" }
                // Algebraic enum constructors: Shape.Circle(5) → Amalgame_Shape
                // Detect if calleeStr matches a registered algebraic enum constructor
                let algPrefix = "__alg__"
                let enCount2  = this.EnumNames.Count()
                for eni in 0..enCount2 {
                    let ename = this.EnumNames.Get(eni)
                    if (String_StartsWith(ename, algPrefix)) {
                        let enumType = String_Substring(ename, String_Length(algPrefix), String_Length(ename) - String_Length(algPrefix))
                        if (String_StartsWith(calleeStr, enumType + "_")) {
                            return enumType
                        }
                    }
                }
                // Known return types for stdlib functions
                // First check if callee is a lambda macro - infer i64 as default
                if (expr.Left != null && expr.Left.Kind == NodeKind.IDENTIFIER) {
                    let calleeLocalType = this.LocalTypeGet(expr.Left.Name)
                    if (calleeLocalType == "__macro__") { return "i64" }
                }
                if (calleeStr == "String_Length" || calleeStr == "String_IndexOf" || calleeStr == "String_LastIndexOf" || calleeStr == "String_ToInt") { return "i64" }
                if (calleeStr == "String_ToFloat") { return "double" }
                if (calleeStr == "String_ToBool") { return "code_bool" }
                if (calleeStr == "String_Contains" || calleeStr == "String_StartsWith" || calleeStr == "String_EndsWith" || calleeStr == "String_IsEmpty") { return "code_bool" }
                if (String_StartsWith(calleeStr, "String_")) { return "code_string" }
                // Process args + exit code (runtime globals)
                if (calleeStr == "Args_Count" || calleeStr == "Exit_Get") { return "i64" }
                if (calleeStr == "Args_Get") { return "code_string" }
                if (calleeStr == "Exit_Set") { return "void" }
                if (String_EndsWith(calleeStr, "_CharAt")) { return "code_string" }
                if (calleeStr == "code_string_concat") { return "code_string" }
                if (calleeStr == "AmalgameList_count") { return "i64" }
                if (String_StartsWith(calleeStr, "AmalgameList_count")) { return "i64" }
                // File stdlib return types
                if (calleeStr == "File_Exists" || calleeStr == "File_WriteAll" || calleeStr == "File_AppendAll" || calleeStr == "File_Delete") { return "code_bool" }
                if (calleeStr == "File_WriteLines" || calleeStr == "File_OpenWrite" || calleeStr == "File_StreamLine" || calleeStr == "File_CloseWrite") { return "void" }
                if (calleeStr == "File_WriteLines") { return "void" }
                if (calleeStr == "File_ReadAll" || calleeStr == "File_ReadLine") { return "code_string" }
                if (calleeStr == "File_Size") { return "i64" }
                // Path stdlib return types
                if (calleeStr == "Path_Combine" || calleeStr == "Path_GetExtension" || calleeStr == "Path_GetFilename" || calleeStr == "Path_GetDirectory" || calleeStr == "Path_GetStem" || calleeStr == "Path_Normalize" || calleeStr == "Path_Sep") { return "code_string" }
                if (calleeStr == "Path_IsAbsolute") { return "code_bool" }
                // Logging stdlib return types — runtime helpers under
                // the `Log_*` prefix; `Log.Info(...)` in user code lowers
                // here directly via the isStdlib short-circuit below.
                if (calleeStr == "Log_GetMinLevel" || calleeStr == "Log_GetFile") { return "code_string" }
                if (calleeStr == "Log_SetMinLevel" || calleeStr == "Log_SetFile" || calleeStr == "Log_Debug" || calleeStr == "Log_Info" || calleeStr == "Log_Warn" || calleeStr == "Log_Error") { return "void" }
                // Service stdlib return types
                if (calleeStr == "Service_ShouldStop") { return "code_bool" }
                if (calleeStr == "Service_Install" || calleeStr == "Service_RequestStop" || calleeStr == "Service_Sleep") { return "void" }
                // (Database.SQLite return types moved to package
                //  amalgame-database-sqlite v0.1.0 — see PR #__.
                //  PackageRegistry now feeds them via the loop a
                //  few lines down from here.)
                // (Database.NoSQL.Redis + Messaging.MQTT return
                //  types moved to packages amalgame-database-nosql-
                //  redis + amalgame-messaging-mqtt v0.1.0.
                //  PackageRegistry feeds them via the loop below.)
                // Net stdlib return types
                if (calleeStr == "Http_Get" || calleeStr == "Http_Post" || calleeStr == "Http_GetWithHeaders" || calleeStr == "Http_GetTimeout" || calleeStr == "Http_PostJson" || calleeStr == "Http_PostWithHeaders" || calleeStr == "Http_Put" || calleeStr == "Http_Delete" || calleeStr == "Http_Patch") { return "AmalgameHttpResponse*" }
                if (calleeStr == "Env_Get") { return "code_string" }
                if (calleeStr == "Env_Has") { return "code_bool" }
                if (calleeStr == "Process_RunCapture") { return "AmalgameProcessResult*" }
                if (calleeStr == "Process_Run") { return "i64" }
                if (calleeStr == "Process_RunCaptureBoth") { return "AmalgameProcessResult*" }
                if (calleeStr == "Process_RunCaptureBothTimeout") { return "AmalgameProcessResult*" }
                if (calleeStr == "Process_RunTimeout") { return "i64" }
                if (calleeStr == "Process_Spawn") { return "AmalgameProcessHandle*" }
                if (calleeStr == "Process_IsAlive") { return "code_bool" }
                if (calleeStr == "Process_ExitCode") { return "i64" }
                if (calleeStr == "Process_Wait") { return "code_bool" }
                if (calleeStr == "Process_WriteLine") { return "code_bool" }
                if (calleeStr == "Process_ReadLine") { return "code_string" }
                if (calleeStr == "Process_ReadErrLine") { return "code_string" }
                if (calleeStr == "Console_ReadLine" || calleeStr == "Console_ReadBytes") { return "code_string" }
                if (calleeStr == "Console_Flush" || calleeStr == "Console_Write") { return "void" }
                // String stdlib: int / bool returns. The CGen previously
                // didn't track these, so an unannotated `let n = String_IndexOf(...)`
                // would default to `code_string`, breaking arithmetic
                // on the result. Listing them here fixes generic users.
                if (calleeStr == "String_Length" || calleeStr == "String_IndexOf" || calleeStr == "String_LastIndexOf" || calleeStr == "String_ToInt") { return "i64" }
                if (calleeStr == "String_StartsWith" || calleeStr == "String_EndsWith" || calleeStr == "String_Contains" || calleeStr == "String_IsEmpty") { return "code_bool" }
                if (calleeStr == "TcpServer_Listen") { return "AmalgameTcpServer*" }
                if (calleeStr == "TcpServer_Accept") { return "AmalgameTcpConn*" }
                if (calleeStr == "TcpServer_IsListening" || calleeStr == "TcpConn_Send" || calleeStr == "TcpConn_Close" || calleeStr == "TcpServer_Stop") { return "code_bool" }
                if (calleeStr == "TcpConn_Receive") { return "code_string" }
                // Math + Math.Vec migrated to AM (post-v0.7.5);
                // their runtime helpers no longer exist. Math.X /
                // Vec3.X / Vec4.X / Mat4.X lower via the regular
                // namespace-mangled dispatch (Amalgame_Math_Math_*
                // / Amalgame_Math_Vec_Vec3_* etc.) and the cgen
                // infers their return types from the .am method
                // signatures, no hardcoded entries needed.
                // FileWatcher migrated to AM (post-v0.7.5) — runtime
                // helpers no longer exist; the namespace-mangled
                // class method names lower via the regular dispatch.
                // Regex runtime helpers.
                if (calleeStr == "Regex_Match") { return "AmalgameRegexMatch*" }
                if (calleeStr == "Regex_Test") { return "code_bool" }
                if (calleeStr == "Regex_Replace" || calleeStr == "Regex_ReplaceAll") { return "code_string" }
                if (calleeStr == "Match_GetText" || calleeStr == "Match_GroupText") { return "code_string" }
                if (calleeStr == "Match_GetStart" || calleeStr == "Match_GetEnd" || calleeStr == "Match_GroupCount" || calleeStr == "Match_GroupStart" || calleeStr == "Match_GroupEnd") { return "i64" }
                // Compress (zlib) runtime helpers.
                if (calleeStr == "Compress_Gzip" || calleeStr == "Compress_Gunzip" || calleeStr == "Compress_Deflate" || calleeStr == "Compress_Inflate" || calleeStr == "Compress_GzipString") { return "AmalgameList*" }
                if (calleeStr == "Compress_GunzipString") { return "code_string" }
                // WebSocket (RFC 6455) runtime helpers.
                if (calleeStr == "WebSocket_Connect") { return "AmalgameWebSocket*" }
                if (calleeStr == "WebSocket_SendText" || calleeStr == "WebSocket_IsConnected") { return "code_bool" }
                if (calleeStr == "WebSocket_ReceiveText" || calleeStr == "WebSocket_GetHost" || calleeStr == "WebSocket_AcceptKey") { return "code_string" }
                if (calleeStr == "WebSocket_GetPort") { return "i64" }
                if (calleeStr == "WebSocket_Close") { return "void" }
                // Math_X flat-name return types — gone after the
                // post-v0.7.5 Math.h → math.am migration. The
                // `Math.IsPrime(n)` form now lowers to a normal
                // namespace-mangled call.
                // v0.5 package-manager: look up registered package
                // funcs after the hardcoded SQLite/Redis/MQTT block.
                // PR 4/5 will move SQLite/Redis/MQTT entries OUT of
                // the hardcoded block and INTO PkgFuncs via their
                // package manifests — once that lands the hardcoded
                // block above shrinks back to just the core stdlib
                // (Console/File/Math/String/List/Env/Process/Log/
                // Service).
                let pkgN: int = this.PkgFuncs.Count()
                for pkgI in 0..pkgN {
                    if (calleeStr == this.PkgFuncs.Get(pkgI)) {
                        return this.PkgFuncCTypes.Get(pkgI)
                    }
                }
                if (expr.Left.Kind == NodeKind.MEMBER) {
                    let mname2 = expr.Left.Name
                    // Collection method return types based on method name.
                    // `Count` is unique to collections so the shortcut is
                    // safe. `Size` collides with user-defined methods (e.g.
                    // facade builders like `Element.Size(w, h)`) — guard
                    // the shortcut behind a receiver-type check so the
                    // generic flow below can resolve user-class Size()
                    // returns from the method registry.
                    if (mname2 == "Count") { return "i64" }
                    if (mname2 == "Size") {
                        if (expr.Left.Left != null) {
                            let llkS = expr.Left.Left.Kind
                            if (llkS == NodeKind.IDENTIFIER) {
                                let recvT: string = this.LocalTypeGet(expr.Left.Left.Name)
                                if (recvT == "AmalgameList*" || recvT == "AmalgameMap*" || recvT == "AmalgameSet*" || recvT == "AmalgameDict*") {
                                    return "i64"
                                }
                            }
                            if (llkS == NodeKind.MEMBER) {
                                let ll: AstNode = expr.Left.Left
                                if (ll.Left != null && ll.Left.Kind == NodeKind.THIS_EXPR) {
                                    let ft: string = this.FieldTypeGet(this.CurrentClass, ll.Name)
                                    if (ft == "AmalgameList*" || ft == "AmalgameMap*" || ft == "AmalgameSet*" || ft == "AmalgameDict*") {
                                        return "i64"
                                    }
                                }
                            }
                        }
                        // Fall through to the normal method-resolution
                        // flow below — user-defined Size() returns will
                        // be looked up via MethodRetGet on the receiver.
                    }
                    if (mname2 == "Clear") { return "void" }
                    if (mname2 == "Reserve") { return "void" }
                    if (mname2 == "IsEmpty" || mname2 == "Has" || mname2 == "Contains" || mname2 == "Remove" || mname2 == "Add") {
                        // Check object type to determine correct return
                        if (expr.Left.Left != null && expr.Left.Left.Kind == NodeKind.IDENTIFIER) {
                            let objN = expr.Left.Left.Name
                            let objT = this.LocalTypeGet(objN)
                            if (objT == "AmalgameList*" && mname2 == "IsEmpty") { return "code_bool" }
                            if (objT == "AmalgameList*" && mname2 == "Remove") { return "code_bool" }
                            if (objT == "AmalgameMap*" && (mname2 == "Has" || mname2 == "Remove")) { return "code_bool" }
                            if (objT == "AmalgameSet*" && (mname2 == "Contains" || mname2 == "Remove" || mname2 == "Add")) { return "code_bool" }
                        }
                    }
                    if (mname2 == "Get") {
                        // Try to find element type from list field
                        if (expr.Left.Left != null) {
                            let ll = expr.Left.Left
                            if (ll.Kind == NodeKind.THIS_EXPR) {
                                // this.Field.Get(i) — can't determine field name here easily
                                // Fall through to void*
                            }
                            if (ll.Kind == NodeKind.MEMBER) {
                                if (ll.Left != null) {
                                    if (ll.Left.Kind == NodeKind.THIS_EXPR) {
                                        let fn3 = ll.Name
                                        let et = this.ListElemGet(this.CurrentClass, fn3)
                                        if (String_Length(et) > 0) { return et }
                                    }
                                }
                            }
                            if (ll.Kind == NodeKind.IDENTIFIER) {
                                let vn3   = ll.Name
                                let vtype = this.LocalTypeGet(vn3)
                                let bare3 = String_Replace(vtype, "*", "")
                                // `Get` isn't only the list/map accessor —
                                // user classes often have a `Get(key)` of
                                // their own (JsonValue.Get(string) → JsonValue
                                // being the canonical example). Consult the
                                // method-return registry before falling back
                                // to the generic void* assumption.
                                if (String_Length(bare3) > 0) {
                                    let urt = this.MethodRetGet(bare3, "Get")
                                    if (String_Length(urt) > 0) { return urt }
                                }
                                // List<T> tracked at the var-decl site
                                // (`let xs = new List<string>()` or `let
                                // xs: List<string> = …`) — look up the elem
                                // C type directly so `xs.Get(i)` returns
                                // `code_string` instead of degrading to void*.
                                // Same path for Map<K,V> stored under the
                                // `__local_map__` pseudo-class.
                                let listElem = this.ListElemGet("__local__", vn3)
                                if (String_Length(listElem) > 0) { return listElem }
                                let mapElem = this.ListElemGet("__local_map__", vn3)
                                if (String_Length(mapElem) > 0) { return mapElem }
                            }
                            // <chain>.Get(...) — receiver is itself a call
                            // (e.g. changes.At(0).Get("text") in lsp.am).
                            // Recursively infer the chain's return type and
                            // look up its `Get` method. Without this, triple-
                            // chained method calls fall through to void*.
                            if (ll.Kind == NodeKind.CALL) {
                                let chainT = this.InferTypeFromExpr(ll)
                                let chainBare = String_Replace(chainT, "*", "")
                                if (String_Length(chainBare) > 0) {
                                    let urt = this.MethodRetGet(chainBare, "Get")
                                    if (String_Length(urt) > 0) { return urt }
                                }
                            }
                        }
                        return "void*"
                    }
                    if (expr.Left.Left != null) {
                        let llk2 = expr.Left.Left.Kind
                        // this.Method() → look up in MethodRetTypes using CurrentClass
                        if (llk2 == NodeKind.THIS_EXPR) {
                            let retT = this.MethodRetGet(this.CurrentClass, mname2)
                            if (String_Length(retT) > 0) { return retT }
                        }
                        // <chain>.Method() — receiver is itself a CALL.
                        // Recursively infer the inner-call's return type, then
                        // look up `Method` on that class. Lets triple-chained
                        // patterns like `root.Get("a").At(0).Get("b").AsString()`
                        // propagate types through every step.
                        if (llk2 == NodeKind.CALL) {
                            let chainT2    = this.InferTypeFromExpr(expr.Left.Left)
                            let chainBare2 = String_Replace(chainT2, "*", "")
                            if (String_Length(chainBare2) > 0) {
                                let retTC = this.MethodRetGet(chainBare2, mname2)
                                if (String_Length(retTC) > 0) { return retTC }
                            }
                        }
                        // new ClassName(...).Method() — receiver is a NEW_EXPR.
                        // Reuse the NEW_EXPR inference (top of this function)
                        // to get the freshly-built instance's type, then look
                        // up `Method` on it. Unblocks `new Form(...).SetBody(...)`
                        // style fluent declarations everywhere.
                        if (llk2 == NodeKind.NEW_EXPR) {
                            let recvT    = this.InferTypeFromExpr(expr.Left.Left)
                            let recvBare = String_Replace(recvT, "*", "")
                            if (String_Length(recvBare) > 0) {
                                let retTN = this.MethodRetGet(recvBare, mname2)
                                if (String_Length(retTN) > 0) { return retTN }
                            }
                        }
                        // ClassName.Method() → static call, look up SymName(ClassName)
                        if (llk2 == NodeKind.IDENTIFIER) {
                            let cname2 = expr.Left.Left.Name
                            let firstC = String_Substring(cname2, 0, 1)
                            let isUpp  = firstC == String_ToUpper(firstC)
                            if (isUpp) {
                                // External classes (registered via --external)
                                // mangle to their declaring file's namespace
                                // rather than the consumer's NsPrefix. Try
                                // the external table first so cross-package
                                // chains like `Page.New().SetTitle(...)` —
                                // where Page lives in Amalgame.UI.Web —
                                // resolve correctly. Falls through to
                                // SymName for in-bundle classes.
                                let extMangled: string = this.ExternalClassMangled(cname2)
                                if (String_Length(extMangled) > 0) {
                                    let retTE = this.MethodRetGet(extMangled, mname2)
                                    if (String_Length(retTE) > 0) { return retTE }
                                }
                                let symCls = this.SymName(cname2)
                                let retT2  = this.MethodRetGet(symCls, mname2)
                                if (String_Length(retT2) > 0) { return retT2 }
                            }
                            // Instance method call: obj.Method() → look up via obj's type
                            if (!isUpp) {
                                let objType = this.LocalTypeGet(cname2)
                                let bareCls = String_Replace(objType, "*", "")
                                if (String_Length(bareCls) > 0) {
                                    let retT3 = this.MethodRetGet(bareCls, mname2)
                                    if (String_Length(retT3) > 0) { return retT3 }
                                }
                            }
                        }
                    }
                }
            }
        }
        return ""
    }

    // Strict identifier-shape check for `{...}` interpolation content.
    // Accepts:  ident, ident.path, ident.path(args), this.path[(args)]
    // Rejects:  anything containing `;`, `:`, `-`, ` `, `+`, `,`, `=`, …
    //           outside of a method-call argument list.
    //
    // Why: pre-fix the check was "starts with a letter, or starts with
    // `this.`" — too permissive. CSS rules like `body{font-family:...}`
    // start with `f` and silently swallowed the brace as an interpolation
    // slot, producing garbage C from cgen. Inline HTML/CSS/JS authored
    // in `.am` string literals now passes through cleanly.
    private bool IsValidInterpExpr(s: string) {
        let n = String_Length(s)
        if (n == 0) { return false }
        let first = String_Substring(s, 0, 1)
        let identStart = String_Contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", first)
        if (!identStart) { return false }
        let identCont = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_."
        var i = 1
        while (i < n) {
            let ch = String_Substring(s, i, 1)
            if (ch == "(") {
                // Method-call form: rest is the argument list. Trust the
                // existing InterpExprToC to parse it; require closing `)`
                // as the very last character so we don't mis-detect mid-
                // string `(` followed by garbage and an unrelated `)`
                // later in the source — that case lands here only when
                // the head segment is already a clean ident path.
                let last = String_Substring(s, n - 1, 1)
                if (last == ")") { return true }
                return false
            }
            let ok = String_Contains(identCont, ch)
            if (!ok) { return false }
            i = i + 1
        }
        return true
    }

    // Re-escape a string value (which may contain real newlines, tabs, quotes)
    // into valid C string literal content.
    // Emit a string literal, expanding {ident} / {this.field} / {obj.method(args)}
    // interpolations. Bare `{` followed by non-identifier content (CSS,
    // JS arrow bodies, JSON, …) passes through as a literal — see
    // IsValidInterpExpr above.
    private string EmitInterpolatedString(string raw) {
        let hasInterp = String_IndexOf(raw, "{")
        if (hasInterp < 0) {
            let escaped = this.EscapeStringForC(raw)
            return "\"" + escaped + "\""
        }
        let len = String_Length(raw)
        // Check for at least one valid {ident…} pattern
        var hasValid = false
        var ci = 0
        while (ci < len) {
            let cch = String_Substring(raw, ci, 1)
            if (cch == "{") {
                let rest = String_Substring(raw, ci + 1, len - ci - 1)
                let close = String_IndexOf(rest, "}")
                if (close > 0) {
                    let inner = String_Substring(raw, ci + 1, close)
                    if (this.IsValidInterpExpr(inner)) {
                        hasValid = true
                        ci = len
                    } else {
                        ci = ci + 1
                    }
                } else {
                    ci = ci + 1
                }
            } else {
                ci = ci + 1
            }
        }
        if (!hasValid) {
            let escaped = this.EscapeStringForC(raw)
            return "\"" + escaped + "\""
        }
        // Build interpolated expression
        var result = "\"\""
        var i = 0
        var segStart = 0
        while (i < len) {
            let ch = String_Substring(raw, i, 1)
            if (ch == "{") {
                let rest2 = String_Substring(raw, i + 1, len - i - 1)
                let close2 = String_IndexOf(rest2, "}")
                if (close2 > 0) {
                    let expr = String_Substring(raw, i + 1, close2)
                    if (this.IsValidInterpExpr(expr)) {
                        if (i > segStart) {
                            let seg = String_Substring(raw, segStart, i - segStart)
                            let esc = this.EscapeStringForC(seg)
                            result = "code_string_concat(" + result + ", \"" + esc + "\")"
                        }
                        let cExpr = this.InterpExprToC(expr)
                        result = "code_string_concat(" + result + ", " + cExpr + ")"
                        segStart = i + 1 + close2 + 1
                        i = segStart
                    } else {
                        i = i + 1
                    }
                } else {
                    i = i + 1
                }
            } else {
                i = i + 1
            }
        }
        if (segStart < len) {
            let seg = String_Substring(raw, segStart, len - segStart)
            let esc = this.EscapeStringForC(seg)
            result = "code_string_concat(" + result + ", \"" + esc + "\")"
        }
        return result
    }

    // Wrap a C expression in the right ToString conversion based on its
    // C return type. Used by the interpolation handler below.
    private string WrapForInterp(string cExpr, string cType) {
        if (cType == "code_string") { return "(" + cExpr + " ? " + cExpr + " : \"\")" }
        if (cType == "i64")         { return "String_FromInt(" + cExpr + ")" }
        if (cType == "double")      { return "String_FromFloat(" + cExpr + ")" }
        if (cType == "code_bool")   { return "((" + cExpr + ") ? \"true\" : \"false\")" }
        // Fallback — assume int for unknown / void
        return "String_FromInt((i64)(" + cExpr + "))"
    }

    // Best-effort C return type for a stdlib-style call name (e.g. "String_Length").
    // Returns "" when unknown so the caller can pick a fallback.
    private string BuiltinCallReturnType(string cName) {
        if (cName == "String_Length" || cName == "String_IndexOf" || cName == "String_LastIndexOf" || cName == "String_ToInt") { return "i64" }
        if (cName == "String_ToFloat") { return "double" }
        if (cName == "String_IsEmpty" || cName == "String_Contains" || cName == "String_StartsWith" || cName == "String_EndsWith" || cName == "String_ToBool") { return "code_bool" }
        if (String_StartsWith(cName, "String_")) { return "code_string" }
        // Math_X flat-name return types — gone post-v0.7.5 Math.h
        // migration. Math.X qualified calls lower via namespace
        // mangling, return type comes from the AM signature.
        if (cName == "File_ReadAll") { return "code_string" }
        if (cName == "File_Exists" || cName == "File_WriteAll" || cName == "File_AppendAll" || cName == "File_Delete") { return "code_bool" }
        if (cName == "File_Size" || cName == "Args_Count" || cName == "Exit_Get") { return "i64" }
        if (cName == "Args_Get") { return "code_string" }
        return ""
    }

    // Convert a simple interpolation expression to a C string expression
    private string InterpExprToC(string expr) {
        // Method/function call: "Class.Method(args)" or "func(args)".
        // Convert dot-separated qualifiers to underscore (C name scheme),
        // then pick a ToString wrapper from the inferred return type.
        let parenIdx = String_IndexOf(expr, "(")
        if (parenIdx > 0) {
            let callee = String_Substring(expr, 0, parenIdx)
            let rest   = String_Substring(expr, parenIdx, String_Length(expr) - parenIdx)
            let cCallee = String_Replace(callee, ".", "_")
            let cCall  = cCallee + rest
            let retT   = this.BuiltinCallReturnType(cCallee)
            if (String_Length(retT) > 0) {
                return this.WrapForInterp(cCall, retT)
            }
            // Unknown callee → assume string (most user methods returning text).
            return "(" + cCall + " ? " + cCall + " : \"\")"
        }
        // this.Field → self->Field
        if (String_StartsWith(expr, "this.")) {
            let field = String_Substring(expr, 5, String_Length(expr) - 5)
            let ft = this.FieldTypeGet(this.CurrentClass, field)
            if (ft == "i64") { return "String_FromInt(self->" + field + ")" }
            if (ft == "double") { return "String_FromFloat(self->" + field + ")" }
            if (ft == "code_bool") { return "((self->" + field + ") ? \"true\" : \"false\")" }
            if (ft == "code_string") { return "(self->" + field + " ? self->" + field + " : \"\")" }
            // Enum or other non-pointer type → treat as integer
            if (String_Length(ft) > 0 && !String_Contains(ft, "*")) { return "String_FromInt((i64)self->" + field + ")" }
            return "(self->" + field + " ? self->" + field + " : \"\")"
        }
        // obj.field → obj->field (obj is a pointer variable)
        let dotIdx = String_IndexOf(expr, ".")
        if (dotIdx > 0) {
            let objName = String_Substring(expr, 0, dotIdx)
            let field2  = String_Substring(expr, dotIdx + 1, String_Length(expr) - dotIdx - 1)
            let objType = this.LocalTypeGet(objName)
            let bareT   = String_Replace(objType, "*", "")
            if (String_Length(bareT) > 0) {
                let ft2 = this.FieldTypeGet(bareT, field2)
                if (ft2 == "i64") { return "String_FromInt(" + objName + "->" + field2 + ")" }
                if (ft2 == "double") { return "String_FromFloat(" + objName + "->" + field2 + ")" }
                if (ft2 == "code_bool") { return "((" + objName + "->" + field2 + ") ? \"true\" : \"false\")" }
                if (ft2 == "code_string") { return "(" + objName + "->" + field2 + " ? " + objName + "->" + field2 + " : \"\")" }
                // Enum or other non-pointer type → treat as integer
                if (String_Length(ft2) > 0 && !String_Contains(ft2, "*")) { return "String_FromInt((i64)" + objName + "->" + field2 + ")" }
                return "(" + objName + "->" + field2 + " ? " + objName + "->" + field2 + " : \"\")"
            }
        }
        // Simple variable
        let varC = this.LocalTypeGet(expr)
        if (varC == "i64") { return "String_FromInt(" + expr + ")" }
        if (varC == "double") { return "String_FromFloat(" + expr + ")" }
        if (varC == "code_bool") { return "(" + expr + " ? \"true\" : \"false\")" }
        if (String_Length(varC) > 0) {
            return "(" + expr + " ? " + expr + " : \"\")"
        }
        // Fallback: treat as int
        return "String_FromInt(" + expr + ")"
    }

    private string EscapeStringForC(string raw) {
        // The Amalgame lexer converts escape sequences to real bytes.
        // We must reverse that for C string literal emission.
        // Order matters: escape backslash first to avoid double-escaping.
        var s = String_Replace(raw, "\\", "\\\\")
        s = String_Replace(s, "\"", "\\\"")
        s = String_Replace(s, "\n", "\\n")
        s = String_Replace(s, "\t", "\\t")
        // CR (0x0d) is built via String_FromByte(13) rather than
        // "\r" — the ancient amc that bootstraps this file lexed
        // both `"\r"` and `"\x0d"` incorrectly (no escape applied),
        // so the previous `String_Replace(s, "\r", ...)` never
        // matched a real CR. Going through a builtin int→byte
        // bypasses the lexer entirely.
        s = String_Replace(s, String_FromByte(13), "\\r")
        // ESC character (0x1B) used in ANSI color codes
        s = String_Replace(s, String_FromByte(27), "\\x1b")
        return s
    }

    private void EmitHeader() {
        this.Out.EmitLine("#include <stdio.h>")
        this.Out.EmitLine("#include <stdlib.h>")
        this.Out.EmitLine("#include <string.h>")
        this.Out.EmitLine("#include \"_runtime.h\"")
        this.Out.EmitLine("#include \"Amalgame_String.h\"")
        this.Out.EmitLine("#include \"Amalgame_Collections.h\"")
        this.Out.EmitLine("#include \"Amalgame_IO.h\"")
        // Math + Math_Vec migrated to AM (post-v0.7.5); runtime
        // headers dropped. Their libm includes live in top-level
        // @c {} blocks in src/stdlib/math.am + math_vec.am.
        // FileWatcher migrated to AM (post-v0.7.5); runtime header
        // dropped. Its libc include (<sys/stat.h>) lives in a
        // top-level @c {} block in src/stdlib/io_filewatcher.am.
        // Regex / Compress / WebSocket runtime headers moved out to
        // their own external packages in v0.7.8 — install with
        // `amc package add regex compress net-websocket` if your
        // code uses them. The `isCoreStdlib` flat-mangling check
        // for `Regex.Method` / `Compress.Method` / `WebSocket.Method`
        // stays in place, so call sites still lower to `Regex_Method`
        // — the package's runtime header supplies the matching symbol
        // via PkgHeaders below.
        this.Out.EmitLine("#include \"Amalgame_Net.h\"")
        this.Out.EmitLine("#include \"Amalgame_Console.h\"")
        this.Out.EmitLine("#include \"Amalgame_Process.h\"")
        // Random migrated to AM (post-v0.7.5); PCG helpers + entropy
        // source live in a top-level @c {} in src/stdlib/random.am.
        // DateTime + Logging: runtime headers dropped after the
        // top-level `@c { … }` extension (post-v0.7.5). Their state
        // globals + libc includes now live in the .am files
        // themselves (src/stdlib/datetime.am, src/stdlib/logging.am).
        // Crypto migrated to AM (post-v0.7.5); SHA-256 + HMAC live
        // in a top-level @c {} in src/stdlib/crypto.am.
        // Service migrated to AM (post-v0.7.5); the signal-handler
        // state + handler function live in a top-level @c {} in
        // src/stdlib/service.am.
        // BuildInfo migrated to AM (post-v0.7.5); the AMC_GIT_REV /
        // AMC_BUILD_DATE `#ifndef` guards live in a top-level @c {}
        // in src/stdlib/amc_buildinfo.am.
        // (Amalgame_Database_SQLite.h / Amalgame_Database_Redis.h
        //  / Amalgame_Messaging_MQTT.h all moved to their own
        //  packages — PackageRegistry emits the #include lines for
        //  whichever the user has `amc add`'d.)
        // v0.5 package-manager: each installed external package
        // contributes its runtime header to the prelude. Empty
        // when no packages are installed; SQLite/Redis/MQTT stay
        // hardcoded above through v0.5 until PR 4/5 extract them.
        let pkgHdrN: int = this.PkgHeaders.Count()
        for ph in 0..pkgHdrN {
            this.Out.EmitLine("#include \"" + this.PkgHeaders.Get(ph) + "\"")
        }
        this.Out.EmitBlank()
    }

    public void EmitNetHeader() {
        this.Out.EmitLine("#include \"Amalgame_Net.h\"")
    }

    // ── v0.5 package-manager hook ────────────────────
    //
    // Called by main.am after constructing the CGen — feeds it
    // every class + function declared by installed external
    // packages. Cached as parallel lists for the three downstream
    // dispatch sites:
    //   1. EmitPrelude   — adds an `#include "<header>"` line
    //                       per package
    //   2. isStdlib check (NodeKind.MEMBER static-call path) —
    //                       extends the hardcoded class-name list
    //   3. InferTypeFromExpr return-type table — maps
    //                       `<Class>_<Func>` to its manifest-
    //                       declared C return type
    //
    // Idempotent — re-registering same packages overwrites the
    // earlier entries.
    public void RegisterPackages(PackageRegistry reg) {
        this.PkgClasses    = new List<string>()
        this.PkgFuncs      = new List<string>()
        this.PkgFuncCTypes = new List<string>()
        this.PkgHeaders    = new List<string>()
        this.PkgClassNs    = new List<string>()
        let n: int = reg.Packages.Count()
        for i in 0..n {
            let p: LoadedPackage = reg.Packages.Get(i)
            this.PkgClasses.Add(p.ClassName)
            this.PkgClassNs.Add(p.Ns)
            this.PkgHeaders.Add(p.Header)
            // C symbols use the full namespace-mangled form so
            // packages can't collide at link time when two of them
            // happen to expose the same short class name.
            //   Redis.Open → Amalgame_Database_NoSQL_Redis_Open
            let fn: int = p.FuncNames.Count()
            for j in 0..fn {
                let fName: string = p.FuncNames.Get(j)
                let cType: string = p.FuncRets.Get(j)
                let mangled: string = PackageRegistry.ManglePackageSymbol(p.Ns, fName)
                this.PkgFuncs.Add(mangled)
                this.PkgFuncCTypes.Add(cType)
            }
        }
    }

    // Project F: index every CLASS_DECL in the external prog with the
    // file's own namespace, and emit the matching forward-decl typedef
    // so later struct references compile. The class body + methods
    // are intentionally NOT emitted — they're resolved at link time
    // from libamalgame.a.
    //
    // Two-pass: pass 1 registers every external class so that pass 2
    // can resolve cross-class references (e.g. `InstantResult.GetValue`
    // returning `Instant`) via TypeToC → ExternalClassMangled. Without
    // this split, the second class in iteration order isn't yet
    // registered when the first class's method sigs reference it,
    // and the forward decl falls back to the consumer's namespace.
    public void RegisterExternalProg(AstNode prog) {
        let ns: string = prog.Str
        if (String_Length(ns) == 0) { return }
        let nsPrefix: string = String_Replace(ns, ".", "_")
        let kids: List<AstNode> = prog.Children
        let n: int = kids.Count()
        // Pass 1: register every external class + emit typedef forward
        // decl. Method sigs are deferred to pass 2.
        for i in 0..n {
            let decl: AstNode = kids.Get(i)
            if (decl.Kind == NodeKind.CLASS_DECL) {
                this.ExternalClasses.Add(decl.Name)
                this.ExternalClassNsArr.Add(nsPrefix)
                let mangled: string = nsPrefix + "_" + decl.Name
                this.Out.EmitLine("typedef struct _" + mangled + " " + mangled + "; /* external */")
            }
        }
        // Pass 2: emit method forward decls. All external classes are
        // now in the registry, so cross-class return/param types lower
        // to the correct mangled name.
        for i in 0..n {
            let decl: AstNode = kids.Get(i)
            if (decl.Kind == NodeKind.CLASS_DECL) {
                let mangled: string = nsPrefix + "_" + decl.Name
                let members: List<AstNode> = decl.Children
                let mc: int = members.Count()
                for mi in 0..mc {
                    let m: AstNode = members.Get(mi)
                    if (m.Kind == NodeKind.METHOD_DECL) {
                        let sig: string = this.ExternalMethodSig(m, mangled, decl.Name)
                        this.Out.EmitLine(sig + ";")
                    }
                }
            }
        }
    }

    // Build a C function-pointer signature for an external method.
    // Used by RegisterExternalProg so the host .c gets the right
    // forward decls without going through SymName / MethodSig
    // (which assume the bundle-wide NsPrefix).
    private string ExternalMethodSig(AstNode method, string mangledClass, string shortClassName) {
        let isCtor: bool = method.Name == shortClassName
        let retTypeRaw: string = method.Str
        var retType: string = ""
        if (String_StartsWith(retTypeRaw, "(")) {
            retType = this.TupleStructName(retTypeRaw)
        } else {
            retType = this.TypeToC(retTypeRaw)
        }
        // Register the return type so cross-package chained calls
        // (e.g. `Page.New().SetTitle(...)` where Page lives in an
        // --external facade) can resolve the intermediate receiver
        // type via InferTypeFromExpr → MethodRetGet. Without this,
        // EmitCalleeStr's CALL-on-MEMBER branch falls through to
        // its raw `EmitExprStr(callee.Left) + "_" + mname` fallback,
        // producing the invalid `Type_Method()_Method(...)` C string
        // pattern (the cross-pkg chain bug #2 in ROADMAP_COMPLET).
        // Mirrors the in-bundle registration that EmitForwardDecl
        // does around the MethodRetSet call ~line 1851.
        if (!isCtor) {
            this.MethodRetSet(mangledClass, method.Name, retType)
            this.MethodRetRawSet(mangledClass, method.Name, retTypeRaw)
        }
        var sig: string = ""
        if (isCtor) {
            sig = mangledClass + "* " + mangledClass + "_new("
        } else {
            sig = retType + " " + mangledClass + "_" + method.Name + "("
        }
        let isStatic: bool = method.Flag2
        var first: bool = true
        if (!isStatic && !isCtor) {
            sig   = sig + mangledClass + "* self"
            first = false
        }
        let pcount: int = method.Params.Count()
        for i in 0..pcount {
            let p: AstNode = method.Params.Get(i)
            if (!first) { sig = sig + ", " }
            sig   = sig + this.TypeToC(p.Str) + " " + p.Name
            first = false
        }
        sig = sig + ")"
        return sig
    }

    // Returns the full mangled C name for an external class
    // (e.g. "Random" → "Amalgame_Random_Random"), or "" if the
    // short name isn't registered as external.
    public string ExternalClassMangled(string tname) {
        let n = this.ExternalClasses.Count()
        for i in 0..n {
            if (this.ExternalClasses.Get(i) == tname) {
                return this.ExternalClassNsArr.Get(i) + "_" + tname
            }
        }
        return ""
    }

    // True iff the short class name was registered via
    // RegisterExternalProg — used by EmitClass / EmitForwardDecl to
    // skip definition emission for externally-supplied classes.
    private bool IsExternalClass(string tname) {
        let n = this.ExternalClasses.Count()
        for i in 0..n {
            if (this.ExternalClasses.Get(i) == tname) { return true }
        }
        return false
    }

    // Look up the mangled-C-symbol prefix for a registered package
    // class. Returns "" if the class isn't in the registry.
    private string PkgClassMangledPrefix(string tname) {
        let n: int = this.PkgClasses.Count()
        for i in 0..n {
            if (this.PkgClasses.Get(i) == tname) {
                let ns: string = this.PkgClassNs.Get(i)
                return String_Replace(ns, ".", "_")
            }
        }
        return ""
    }

    private void EmitForwardDecl(AstNode decl) {
        let k = decl.Kind
        if (k == NodeKind.ENUM_DECL) {
            let name = this.SymName(decl.Name)
            // Check if algebraic enum
            var isAlg = false
            let vc = decl.Children.Count()
            for vi in 0..vc {
                let vm = decl.Children.Get(vi)
                if (String_Length(vm.Str) > 0) { isAlg = true }
            }
            if (isAlg) {
                // Register as algebraic enum (value type, not pointer)
                this.EnumNames.Add("__alg__" + name)
                // Emit forward declaration as opaque struct
                this.Out.EmitLine("typedef struct _" + name + " " + name + "; /* alg-enum fwd */")
            } else {
                // Register as simple enum so TypeToC won't add * for this type
                this.EnumNames.Add(decl.Name)
                this.EnumNames.Add(name)
                this.Out.EmitLine("typedef enum _" + name + " " + name + ";")
            }
        }
        if (k == NodeKind.CLASS_DECL) {
            let name = this.SymName(decl.Name)
            this.Out.EmitLine("typedef struct _" + name + " " + name + ";")
        }
        if (k == NodeKind.INLINE_C) {
            // File-scope `@c { … }` raw block. Emit the body verbatim
            // here in Pass 1 so any `static` state globals or extra
            // libc includes land before the class typedefs / method
            // bodies that reference them. EmitDecl below skips this
            // kind in Pass 2.
            this.Out.EmitLine("/* inline-C top-level */")
            let body = decl.Str
            if (String_Length(body) > 0) {
                let lines: List<string> = String_Split(body, "\n")
                let count = lines.Count()
                for i in 0..count {
                    this.Out.EmitLine(lines.Get(i))
                }
            }
        }
    }

    private void EmitDecl(AstNode decl) {
        let k = decl.Kind
        if (k == NodeKind.ENUM_DECL) { this.EmitEnum(decl) }
        if (k == NodeKind.CLASS_DECL) { this.EmitClass(decl) }
        if (k == NodeKind.INLINE_C_INCLUDE) {
            // `@c_include "<h.h>"` → `#include <h.h>`; quoted form when
            // the argument starts with anything other than `<`. The user
            // controls the bracket style by what they pass.
            let arg = decl.Str
            if (String_Length(arg) > 0 && String_Substring(arg, 0, 1) == "<") {
                this.Out.EmitLine("#include " + arg)
            } else {
                this.Out.EmitLine("#include \"" + arg + "\"")
            }
        }
        if (k == NodeKind.INLINE_C_LINK) {
            // `@c_link "name"` — for v0.7.4 MVP we surface it as a comment
            // so the user knows which `-l<name>` to pass at gcc time.
            // `amc test` may thread these into its internal gcc command
            // in a follow-up; `amc -o` doesn't link at all today.
            this.Out.EmitLine("/* link: -l" + decl.Str + " */")
        }
    }

    private void EmitEnum(AstNode en) {
        let name  = this.SymName(en.Name)
        let count = en.Children.Count()

        // Check if this is an algebraic enum (any variant has payload types)
        var isAlgebraic = false
        for i in 0..count {
            let member = en.Children.Get(i)
            if (String_Length(member.Str) > 0) { isAlgebraic = true }
        }

        if (isAlgebraic) {
            // Emit as tagged union
            // 1. Tag enum
            this.Out.EmitLine("typedef enum {")
            this.Out.Indent_()
            for i in 0..count {
                let member = en.Children.Get(i)
                let mname  = name + "_TAG_" + member.Name
                if (i < count - 1) {
                    this.Out.EmitLine(mname + ",")
                } else {
                    this.Out.EmitLine(mname)
                }
            }
            this.Out.Dedent()
            this.Out.EmitLine("} " + name + "_Tag;")
            this.Out.EmitBlank()

            // 2. Union struct
            this.Out.EmitLine("struct _" + name + " {")
            this.Out.Indent_()
            this.Out.EmitLine(name + "_Tag tag;")
            this.Out.EmitLine("union {")
            this.Out.Indent_()
            for i in 0..count {
                let member = en.Children.Get(i)
                let payloads = member.Str
                if (String_Length(payloads) > 0) {
                    this.Out.EmitLine("struct {")
                    this.Out.Indent_()
                    // Split payload types by comma
                    var pi = 0
                    var pcur = ""
                    var pci  = 0
                    let plen = String_Length(payloads)
                    while (pci <= plen) {
                        var pch = ""
                        if (pci < plen) { pch = String_Substring(payloads, pci, 1) }
                        if (pch == "," || pci == plen) {
                            if (String_Length(pcur) > 0) {
                                this.Out.EmitLine(this.TypeToC(pcur) + " _" + String_FromInt(pi) + ";")
                                pi = pi + 1
                                pcur = ""
                            }
                        } else { pcur = pcur + pch }
                        pci = pci + 1
                    }
                    this.Out.Dedent()
                    this.Out.EmitLine("} " + member.Name + ";")
                } else {
                    this.Out.EmitLine("int " + member.Name + "_dummy;")
                }
            }
            this.Out.Dedent()
            this.Out.EmitLine("};")
            this.Out.Dedent()
            this.Out.EmitLine("};")
            this.Out.EmitBlank()

            // 3. Constructor functions
            for i in 0..count {
                let member = en.Children.Get(i)
                let payloads = member.Str
                var params = ""
                var fields = ""
                if (String_Length(payloads) > 0) {
                    var pi2 = 0
                    var pcur2 = ""
                    var pci2  = 0
                    let plen2 = String_Length(payloads)
                    while (pci2 <= plen2) {
                        var pch2 = ""
                        if (pci2 < plen2) { pch2 = String_Substring(payloads, pci2, 1) }
                        if (pch2 == "," || pci2 == plen2) {
                            if (String_Length(pcur2) > 0) {
                                let ct = this.TypeToC(pcur2)
                                let pname = "_" + String_FromInt(pi2)
                                if (pi2 > 0) { params = params + ", " fields = fields + ", " }
                                params = params + ct + " " + pname
                                fields = fields + pname
                                pi2 = pi2 + 1
                                pcur2 = ""
                            }
                        } else { pcur2 = pcur2 + pch2 }
                        pci2 = pci2 + 1
                    }
                }
                let ctorSig = "static inline " + name + " " + name + "_" + member.Name + "(" + params + ")"
                this.Out.EmitLine(ctorSig + " {")
                this.Out.Indent_()
                this.Out.EmitLine(name + " __v;")
                this.Out.EmitLine("__v.tag = " + name + "_TAG_" + member.Name + ";")
                if (String_Length(fields) > 0) {
                    // Set fields
                    var pi3 = 0
                    var pcur3 = ""
                    var pci3  = 0
                    let payloads3 = member.Str
                    let plen3 = String_Length(payloads3)
                    while (pci3 <= plen3) {
                        var pch3 = ""
                        if (pci3 < plen3) { pch3 = String_Substring(payloads3, pci3, 1) }
                        if (pch3 == "," || pci3 == plen3) {
                            if (pi3 >= 0) {
                                let fidx = String_FromInt(pi3)
                                this.Out.EmitLine("__v." + member.Name + "._" + fidx + " = _" + fidx + ";")
                                pi3 = pi3 + 1
                            }
                            pcur3 = ""
                        } else { pcur3 = pcur3 + pch3 }
                        pci3 = pci3 + 1
                    }
                }
                this.Out.EmitLine("return __v;")
                this.Out.Dedent()
                this.Out.EmitLine("}")
                this.Out.EmitBlank()
            }

            // Register as algebraic enum for type lookups
            this.EnumNames.Add("__alg__" + name)
        } else {
            // Simple enum — original C enum
            this.Out.EmitLine("enum _" + name + " {")
            this.Out.Indent_()
            for i in 0..count {
                let member = en.Children.Get(i)
                let mname  = name + "_" + member.Name
                if (i < count - 1) {
                    this.Out.EmitLine(mname + ",")
                } else {
                    this.Out.EmitLine(mname)
                }
            }
            this.Out.Dedent()
            this.Out.EmitLine("};")
            this.Out.EmitBlank()
        }
    }

    private void EmitClass(AstNode cls) {
        let name    = this.SymName(cls.Name)
        let members = cls.Children.Count()

        // Track current class for field-type lookups inside methods
        this.CurrentClass = name

        // Record field C types for later method emission
        for i in 0..members {
            let m  = cls.Children.Get(i)
            let mk = m.Kind
            if (mk == NodeKind.VAR_DECL) {
                let rawType = m.Str
                let ftype = this.TypeToC(rawType)
                this.FieldTypeSet(name, m.Name, ftype)
                // Track element type for List<T> fields
                if (String_StartsWith(rawType, "List<")) {
                    // Extract T from "List<T>"
                    let inner = String_Substring(rawType, 5, String_Length(rawType) - 6)
                    let elemC = this.TypeToC(inner)
                    this.ListElemSet(name, m.Name, elemC)
                }
            }
        }

        // Struct fields
        this.Out.EmitLine("struct _" + name + " {")
        this.Out.Indent_()
        // Embed parent fields directly if this class extends another
        let parentName = cls.Str
        if (String_Length(parentName) > 0) {
            let parentC = this.SymName(parentName)
            // Copy parent field declarations into child struct
            let pfc = this.FieldNames.Count()
            let pfPrefix = parentC + "."
            for pfi in 0..pfc {
                let pfkey = this.FieldNames.Get(pfi)
                if (String_StartsWith(pfkey, pfPrefix)) {
                    let pfname = String_Substring(pfkey, String_Length(pfPrefix), String_Length(pfkey) - String_Length(pfPrefix))
                    let pftype = this.FieldCTypes.Get(pfi)
                    this.Out.EmitLine(pftype + " " + pfname + ";")
                    // Register in child's field table for method lookup
                    this.FieldTypeSet(name, pfname, pftype)
                }
            }
        }
        for i in 0..members {
            let m  = cls.Children.Get(i)
            let mk = m.Kind
            if (mk == NodeKind.VAR_DECL) {
                let ftype = this.TypeToC(m.Str)
                this.Out.EmitLine(ftype + " " + m.Name + ";")
            }
        }
        this.Out.Dedent()
        this.Out.EmitLine("};")
        this.Out.EmitBlank()

        // Forward declare non-constructor methods only
        for i in 0..members {
            let m  = cls.Children.Get(i)
            let mk = m.Kind
            if (mk == NodeKind.METHOD_DECL) {
                if (m.Name != cls.Name) {
                    let sig     = this.MethodSig(m, name)
                    let isPublic = m.Flag
                    // Register return type for inference (both the C
                    // type and the raw Amalgame type — the raw form
                    // preserves `List<int>` / `Map<K,V>` so callers can
                    // propagate the generic argument).
                    let retC = this.TypeToC(m.Str)
                    this.MethodRetSet(name, m.Name, retC)
                    this.MethodRetRawSet(name, m.Name, m.Str)
                    // Decorators (Str2) → C attributes on the prototype.
                    var attrs = ""
                    let decos = m.Str2
                    if (String_Length(decos) > 0) {
                        if (String_Contains("," + decos + ",", ",deprecated,")) {
                            attrs = " __attribute__((deprecated))"
                        }
                    }
                    if (isPublic) {
                        this.Out.EmitLine(sig + attrs + ";")
                    } else {
                        this.Out.EmitLine("static " + sig + attrs + ";")
                    }
                }
            }
        }
        this.Out.EmitBlank()

        // Constructor — find the constructor method (Name == class name)
        // Build _new() signature with constructor params
        var ctorFound = false
        for i in 0..members {
            let m  = cls.Children.Get(i)
            let mk = m.Kind
            if (mk == NodeKind.METHOD_DECL) {
                if (m.Name == cls.Name) {
                    ctorFound = true
                    // Build _new(params...) signature
                    var ctorSig = name + "* " + name + "_new("
                    let pcount  = m.Params.Count()
                    var first   = true
                    for pi in 0..pcount {
                        let p = m.Params.Get(pi)
                        if (!first) { ctorSig = ctorSig + ", " }
                        ctorSig = ctorSig + this.TypeToC(p.Str) + " " + p.Name
                        first = false
                    }
                    ctorSig = ctorSig + ")"
                    this.Out.EmitLine(ctorSig + " {")
                    this.Out.Indent_()
                    this.Out.EmitLine(name + "* self = (" + name + "*) GC_MALLOC(sizeof(" + name + "));")
                    // Emit constructor body with param types tracked
                    this.LocalTypeClear()
                    this.LocalTypeSet("self", name + "*")
                    for pi in 0..pcount {
                        let p = m.Params.Get(pi)
                        this.LocalTypeSet(p.Name, this.TypeToC(p.Str))
                    }
                    if (m.Body != null) {
                        this.EmitBlock(m.Body)
                    } else {
                        // Body-less constructor (data class / record): auto-assign
                        // every param that matches a declared field. ParseDataClass
                        // adds fields and ctor params with the same names, so this
                        // produces `self->X = X` lines without needing the user to
                        // write them. Plain user-written constructors normally
                        // come with a body and skip this path.
                        for pi in 0..pcount {
                            let p = m.Params.Get(pi)
                            // Confirm there's a field with the same name to assign to
                            var hasField = false
                            for fi in 0..members {
                                let f = cls.Children.Get(fi)
                                if (f.Kind == NodeKind.VAR_DECL && f.Name == p.Name) {
                                    hasField = true
                                }
                            }
                            if (hasField) {
                                this.Out.EmitLine("self->" + p.Name + " = " + p.Name + ";")
                            }
                        }
                    }
                    this.LocalTypeClear()
                    this.Out.EmitLine("return self;")
                    this.Out.Dedent()
                    this.Out.EmitLine("}")
                    this.Out.EmitBlank()
                }
            }
        }
        // No-args _new() if no constructor defined
        if (!ctorFound) {
            this.Out.EmitLine(name + "* " + name + "_new() {")
            this.Out.Indent_()
            this.Out.EmitLine(name + "* self = (" + name + "*) GC_MALLOC(sizeof(" + name + "));")
            this.Out.EmitLine("return self;")
            this.Out.Dedent()
            this.Out.EmitLine("}")
            this.Out.EmitBlank()
        }

        // Non-constructor methods
        for j in 0..members {
            let m2  = cls.Children.Get(j)
            let mk2 = m2.Kind
            if (mk2 == NodeKind.METHOD_DECL) {
                if (m2.Name != cls.Name) {
                    this.EmitMethod(m2, name)
                }
            }
        }
    }

    // Generate a C struct name for a tuple type like "(int,string)"
    private string TupleStructName(string tupleType) {
        // "(int,string)" → "Tuple2_i64_code_string"
        let inner = String_Substring(tupleType, 1, String_Length(tupleType) - 2)
        let parts = String_Replace(inner, " ", "")
        var result = ""
        var count  = 0
        var i2     = 0
        let len2   = String_Length(parts)
        var cur    = ""
        while (i2 <= len2) {
            var ch = ""
            if (i2 < len2) { ch = String_Substring(parts, i2, 1) }
            if (ch == "," || i2 == len2) {
                if (String_Length(cur) > 0) {
                    count = count + 1
                    result = result + "_" + this.TypeToC(cur)
                    cur = ""
                }
            } else {
                cur = cur + ch
            }
            i2 = i2 + 1
        }
        return "Tuple" + String_FromInt(count) + result
    }

    // Emit a struct typedef for a tuple type if not already emitted
    private void EnsureTupleStruct(string tupleType) {
        let sname = this.TupleStructName(tupleType)
        // Check if already emitted (simple: check if in enum names list as marker)
        let n = this.EnumNames.Count()
        for i in 0..n {
            if (this.EnumNames.Get(i) == "__tuple__" + sname) { return }
        }
        this.EnumNames.Add("__tuple__" + sname)
        // Parse types from "(t1,t2,...)"
        let inner = String_Substring(tupleType, 1, String_Length(tupleType) - 2)
        let parts = String_Replace(inner, " ", "")
        this.Out.EmitLine("typedef struct {")
        var idx = 0
        var cur = ""
        var i2  = 0
        let len2 = String_Length(parts)
        while (i2 <= len2) {
            var ch = ""
            if (i2 < len2) { ch = String_Substring(parts, i2, 1) }
            if (ch == "," || i2 == len2) {
                if (String_Length(cur) > 0) {
                    this.Out.EmitLine("    " + this.TypeToC(cur) + " _" + String_FromInt(idx) + ";")
                    idx = idx + 1
                    cur = ""
                }
            } else { cur = cur + ch }
            i2 = i2 + 1
        }
        this.Out.EmitLine("} " + sname + ";")
    }

    private string MethodSig(AstNode method, string className) {
        let retTypeRaw = method.Str
        var retType    = ""
        // Tuple return type: "(int,string)"
        if (String_StartsWith(retTypeRaw, "(")) {
            this.EnsureTupleStruct(retTypeRaw)
            retType = this.TupleStructName(retTypeRaw)
        } else {
            retType = this.TypeToC(retTypeRaw)
        }
        let isStatic = method.Flag2
        var sig      = retType + " " + className + "_" + method.Name + "("
        var first    = true
        if (!isStatic) {
            sig   = sig + className + "* self"
            first = false
        }
        let pcount = method.Params.Count()
        for i in 0..pcount {
            let p  = method.Params.Get(i)
            if (!first) { sig = sig + ", " }
            sig   = sig + this.TypeToC(p.Str) + " " + p.Name
            first = false
        }
        sig = sig + ")"
        return sig
    }

    private void EmitMethod(AstNode method, string className) {
        let sig      = this.MethodSig(method, className)
        let isPublic = method.Flag
        var prefix   = ""
        if (!isPublic) { prefix = "static " }
        // Decorators (comma-separated in Str2) → C attributes / inlining hints.
        let decos = method.Str2
        if (String_Length(decos) > 0) {
            if (String_Contains("," + decos + ",", ",inline,")) {
                prefix = prefix + "inline "
            }
        }
        // Track current return type for tuple returns
        if (String_StartsWith(method.Str, "(")) {
            this.CurrentRetType = this.TupleStructName(method.Str)
            // Register method return type for later lookup in tuple destructuring
            this.MethodRetSet(className, method.Name, method.Str)
            this.MethodRetRawSet(className, method.Name, method.Str)
        } else {
            this.CurrentRetType = ""
        }
        this.Out.EmitLine(prefix + sig + " {")
        this.Out.Indent_()
        // Reset local type table for this method scope
        this.LocalTypeClear()
        // Seed with 'self' if instance method
        let isStatic = method.Flag2
        if (!isStatic) {
            this.LocalTypeSet("self", className + "*")
            // The user-side build passes -Wno-unused-parameter so we
            // don't need the `(void)self;` boilerplate any more —
            // dropping it shrinks amc_lib.c by ~500 lines on its own.
        }
        // Seed with parameters. Generic params (List<T>, Map<K,V>)
        // also seed the elem-type table so `xs.Get(i)` / `m.Get(k)`
        // inside the body lower with a typed cast instead of falling
        // back to void*. Unused-parameter warnings are silenced by
        // the gcc flag.
        let pcount = method.Params.Count()
        for i in 0..pcount {
            let p = method.Params.Get(i)
            this.LocalTypeSet(p.Name, this.TypeToC(p.Str))
            this.TrackGenericLocal(p.Name, p.Str)
        }
        if (method.Body != null) {
            this.EmitBlock(method.Body)
        }
        this.LocalTypeClear()
        this.Out.Dedent()
        this.Out.EmitLine("}")
        this.Out.EmitBlank()
    }

    // ── Block & Statements ────────────────────────────

    // Recursive if/else-if/else emitter — produces clean "} else if (...) {" chains
    // Extract a single expression string from an if-expr branch block
    private string EmitIfBranch(AstNode block) {
        if (block == null) { return "0" }
        if (block.Kind == NodeKind.BLOCK) {
            let kids = block.Children
            if (kids.Count() > 0) {
                return this.EmitExprStr(kids.Get(0))
            }
            return "0"
        }
        return this.EmitExprStr(block)
    }

    private void EmitMatch(AstNode stmt) {
        let subject = stmt.Left
        let subjectStr = this.EmitExprStr(subject)
        // Determine if subject is an algebraic enum
        var subjectType = ""
        if (subject != null && subject.Kind == NodeKind.IDENTIFIER) {
            subjectType = this.LocalTypeGet(subject.Name)
        }
        // isAlg: true only if the type is a registered algebraic enum (has __alg__ marker)
        var isAlg = false
        if (String_Length(subjectType) > 0) {
            let algKey2 = "__alg__" + subjectType
            let enCount3 = this.EnumNames.Count()
            for eni3 in 0..enCount3 {
                if (this.EnumNames.Get(eni3) == algKey2) { isAlg = true }
            }
        }
        let armCount = stmt.Children.Count()
        if (isAlg) {
            // Emit as switch on tag
            this.Out.EmitLine("switch (" + subjectStr + ".tag) {")
        } else {
            // Emit as if-else chain for simple value matching
            this.Out.EmitLine("{ /* match " + subjectStr + " */")
        }
        this.Out.Indent_()
        var firstArm = true
        var needsClose = false   // true when the last non-alg arm left an open "if" brace
        for i in 0..armCount {
            let arm = stmt.Children.Get(i)
            let pat = arm.Left
            let body = arm.Right
            if (pat == null) { continue }
            let pk = pat.Kind
            // Wildcard
            if (pk == NodeKind.IDENTIFIER && pat.Name == "_") {
                if (isAlg) {
                    this.Out.EmitLine("default: {")
                    this.Out.Indent_()
                    this.EmitMatchBody(body)
                    this.Out.EmitLine("break;")
                    this.Out.Dedent()
                    this.Out.EmitLine("}")
                    needsClose = false
                } else {
                    // Wildcard arm: close previous arm (if any) and emit trailing "else"
                    let elsePrefix = if (firstArm) { "" } else { "} else " }
                    this.Out.EmitLine(elsePrefix + "{")
                    this.Out.Indent_()
                    this.EmitMatchBody(body)
                    this.Out.Dedent()
                    this.Out.EmitLine("}")
                    needsClose = false
                }
                firstArm = false
            } else {
                if (isAlg && pk == NodeKind.CALL) {
                    // Algebraic variant: Circle(r)
                    let variantName = pat.Name
                    let tagConst = subjectType + "_TAG_" + variantName
                    this.Out.EmitLine("case " + tagConst + ": {")
                    this.Out.Indent_()
                    // Bind capture variables
                    let capCount = pat.Args.Count()
                    for ci in 0..capCount {
                        let capNode = pat.Args.Get(ci)
                        let capName = capNode.Name
                        let fidx = String_FromInt(ci)
                        this.Out.EmitLine("__auto_type " + capName + " = " + subjectStr + "." + variantName + "._" + fidx + ";")
                        this.LocalTypeSet(capName, "i64") // assume numeric for now
                    }
                    this.EmitMatchBody(body)
                    this.Out.EmitLine("break;")
                    this.Out.Dedent()
                    this.Out.EmitLine("}")
                    needsClose = false
                } else {
                    // Simple value or range — emit as if/else-if chain.
                    // Optional guard `if <expr>` is AND-ed with the pattern condition.
                    let elsePrefix = if (firstArm) { "" } else { "} else " }
                    let isBinder = pk == NodeKind.IDENTIFIER && pat.Name != "_"
                    var cond = ""
                    if (pk == NodeKind.BINARY && pat.Str == "..") {
                        let lo = this.EmitExprStr(pat.Left)
                        let hi = this.EmitExprStr(pat.Right)
                        cond = subjectStr + " >= " + lo + " && " + subjectStr + " <= " + hi
                    } else if (pk == NodeKind.LITERAL_STRING) {
                        let patStr = this.EmitExprStr(pat)
                        cond = "strcmp(" + subjectStr + ", " + patStr + ") == 0"
                    } else if (isBinder) {
                        // Bare identifier acts as a binder + always-match (Rust-like).
                        // Only meaningful when paired with a guard (`n if n > 0`).
                        cond = "1"
                    } else {
                        let patStr = this.EmitExprStr(pat)
                        cond = subjectStr + " == " + patStr
                    }
                    if (arm.Cond != null) {
                        // Pre-declare the binder so it's in scope for the guard expression.
                        // Register it locally so EmitExprStr renders it as the bare name.
                        if (isBinder) {
                            this.LocalTypeSet(pat.Name, "i64")
                        }
                        let guardStr = this.EmitExprStr(arm.Cond)
                        if (isBinder) {
                            // GCC statement expression: introduces the binder in the
                            // condition's scope so `n if n > 0` evaluates the guard
                            // with `n = subject` visible.
                            cond = "(({ __auto_type " + pat.Name + " = " + subjectStr + "; " + guardStr + "; }))"
                        } else {
                            cond = "(" + cond + ") && (" + guardStr + ")"
                        }
                    }
                    this.Out.EmitLine(elsePrefix + "if (" + cond + ") {")
                    this.Out.Indent_()
                    // Bare-id binder: also declare inside the body so it's visible
                    // there (in addition to the guard's compound expression).
                    if (isBinder) {
                        this.Out.EmitLine("__auto_type " + pat.Name + " = " + subjectStr + ";")
                        this.LocalTypeSet(pat.Name, "i64")
                    }
                    this.EmitMatchBody(body)
                    this.Out.Dedent()
                    needsClose = true
                }
                firstArm = false
            }
        }
        // Close the last open "if" brace if the chain ended without a wildcard
        if (needsClose) {
            this.Out.EmitLine("}")
        }
        this.Out.Dedent()
        this.Out.EmitLine("}")
    }

    private void EmitMatchBody(AstNode body) {
        if (body == null) { return }
        let bk = body.Kind
        if (bk == NodeKind.BLOCK) {
            let stmts = body.Children.Count()
            for si in 0..stmts {
                this.EmitStmt(body.Children.Get(si))
            }
        } else if (bk == NodeKind.RETURN_STMT || bk == NodeKind.BREAK_STMT || bk == NodeKind.CONTINUE_STMT) {
            // Statement-form arm body: parser accepts `1 => return "X"` etc.
            // Delegate to EmitStmt which already knows how to render these.
            this.EmitStmt(body)
        } else {
            // Expression arm — emit as return statement (match arms are in return position)
            let exprStr = this.EmitExprStr(body)
            if (String_Length(exprStr) > 0 && exprStr != "_unknown_") {
                if (bk == NodeKind.CALL || bk == NodeKind.IDENTIFIER) {
                    // Void call (like Console.WriteLine)
                    this.Out.EmitLine(exprStr + ";")
                } else {
                    this.Out.EmitLine("return " + exprStr + ";")
                }
            }
        }
    }

    private void EmitIf(AstNode stmt) {
        this.Out.EmitLine("if (" + this.EmitExprStr(stmt.Cond) + ") {")
        this.Out.Indent_()
        if (stmt.Body != null) { this.EmitBlock(stmt.Body) }
        this.Out.Dedent()
        if (stmt.Else != null) {
            let elseKind = stmt.Else.Kind
            if (elseKind == NodeKind.IF_STMT) {
                // Fuse "} else if (...) {" on one line
                let innerCond = this.EmitExprStr(stmt.Else.Cond)
                this.Out.EmitLine("} else if (" + innerCond + ") {")
                this.Out.Indent_()
                if (stmt.Else.Body != null) { this.EmitBlock(stmt.Else.Body) }
                this.Out.Dedent()
                // Recurse for further else-if / else chains
                this.EmitIfTail(stmt.Else)
            } else {
                this.Out.EmitLine("} else {")
                this.Out.Indent_()
                this.EmitBlock(stmt.Else)
                this.Out.Dedent()
                this.Out.EmitLine("}")
            }
        } else {
            this.Out.EmitLine("}")
        }
    }

    // Emit the tail of an else-if chain (after body already emitted)
    private void EmitIfTail(AstNode stmt) {
        if (stmt.Else == null) {
            this.Out.EmitLine("}")
            return
        }
        let elseKind = stmt.Else.Kind
        if (elseKind == NodeKind.IF_STMT) {
            let innerCond = this.EmitExprStr(stmt.Else.Cond)
            this.Out.EmitLine("} else if (" + innerCond + ") {")
            this.Out.Indent_()
            if (stmt.Else.Body != null) { this.EmitBlock(stmt.Else.Body) }
            this.Out.Dedent()
            this.EmitIfTail(stmt.Else)
        } else {
            this.Out.EmitLine("} else {")
            this.Out.Indent_()
            this.EmitBlock(stmt.Else)
            this.Out.Dedent()
            this.Out.EmitLine("}")
        }
    }

    private void EmitBlock(AstNode block) {
        let count = block.Children.Count()
        for i in 0..count {
            let stmt = block.Children.Get(i)
            this.EmitStmt(stmt)
        }
    }

    // v0.8.0+: emit a `#line N "path"` directive when the source line
    // changes from the previous statement (avoids spamming consecutive
    // identical directives). gcc/clang pick up the file/line pair into
    // DWARF, so amc dap can set .am-relative breakpoints natively.
    // Path embedded as-is — gcc records DW_AT_comp_dir from the build
    // CWD, so debuggers resolve relative paths against the build dir.
    private void EmitLineDirective(AstNode stmt) {
        if (stmt.Line <= 0) { return }
        if (String_Length(this.CurrentSource) == 0) { return }
        if (stmt.Line == this.LastLineEmitted) { return }
        this.Out.EmitLine("#line " + String_FromInt(stmt.Line) + " \"" + this.CurrentSource + "\"")
        this.LastLineEmitted = stmt.Line
    }

    private void EmitStmt(AstNode stmt) {
        this.EmitLineDirective(stmt)
        let k = stmt.Kind
        if (k == NodeKind.TRY_STMT) {
            // try { … } catch e { … } [finally { … }] — setjmp/longjmp pattern
            // (matches the Vala bootstrap's c_generator).
            //   {
            //     jmp_buf _am_prev_env_NN;
            //     memcpy(&_am_prev_env_NN, &_am_ex.env, sizeof(jmp_buf));
            //     int _am_caught_NN = setjmp(_am_ex.env);
            //     if (_am_caught_NN == 0) { try…; _am_ex.active = 0; }
            //     else { void* e = _am_ex.value; _am_ex.active = 0; catch…; }
            //     memcpy(&_am_ex.env, &_am_prev_env_NN, sizeof(jmp_buf));
            //     finally…;
            //   }
            // Suffix uses the source line of the `try` token so nested try/catch
            // blocks get distinct local names.
            let suffix = String_FromInt(stmt.Line)
            this.Out.EmitLine("{")
            this.Out.Indent_()
            this.Out.EmitLine("jmp_buf _am_prev_env_" + suffix + ";")
            this.Out.EmitLine("memcpy(&_am_prev_env_" + suffix + ", &_am_ex.env, sizeof(jmp_buf));")
            this.Out.EmitLine("int _am_caught_" + suffix + " = setjmp(_am_ex.env);")
            this.Out.EmitLine("if (_am_caught_" + suffix + " == 0) {")
            this.Out.Indent_()
            if (stmt.Body != null) { this.EmitBlock(stmt.Body) }
            this.Out.EmitLine("_am_ex.active = 0;")
            this.Out.Dedent()
            this.Out.EmitLine("} else {")
            this.Out.Indent_()
            if (String_Length(stmt.Name) > 0) {
                this.Out.EmitLine("void* " + stmt.Name + " = _am_ex.value;")
                this.LocalTypeSet(stmt.Name, "void*")
            }
            this.Out.EmitLine("_am_ex.active = 0;")
            if (stmt.Else != null) { this.EmitBlock(stmt.Else) }
            this.Out.Dedent()
            this.Out.EmitLine("}")
            this.Out.EmitLine("memcpy(&_am_ex.env, &_am_prev_env_" + suffix + ", sizeof(jmp_buf));")
            if (stmt.Cond != null) { this.EmitBlock(stmt.Cond) }
            this.Out.Dedent()
            this.Out.EmitLine("}")
            return
        }
        if (k == NodeKind.INLINE_C) {
            // `@c { … }` — splice the raw C body inside a compound statement
            // so any `int x = …;` declarations stay scoped to the block. The
            // body is emitted line-by-line; the lexer captured it verbatim,
            // and the user is responsible for writing valid C.
            this.Out.EmitLine("{ /* inline-C */")
            this.Out.Indent_()
            let body = stmt.Str
            if (String_Length(body) > 0) {
                let lines: List<string> = String_Split(body, "\n")
                let count = lines.Count()
                for i in 0..count {
                    this.Out.EmitLine(lines.Get(i))
                }
            }
            this.Out.Dedent()
            this.Out.EmitLine("}")
            return
        }
        if (k == NodeKind.THROW_STMT) {
            // `throw new SomeError(args)` → `_am_throw((void*)(SomeError_new(args)),
            //   "SomeError", first_string_arg_or_empty)`.
            // Falls back to a generic throw for other shapes.
            if (stmt.Left == null) {
                this.Out.EmitLine("_am_throw(NULL, \"Error\", \"\");")
                return
            }
            let v = stmt.Left
            if (v.Kind == NodeKind.NEW_EXPR) {
                let typeName = v.Name
                var argsStr = ""
                let ac = v.Args.Count()
                for ai in 0..ac {
                    if (ai > 0) { argsStr = argsStr + ", " }
                    argsStr = argsStr + this.EmitExprStr(v.Args.Get(ai))
                }
                var msgStr = "\"\""
                if (ac > 0) {
                    let firstArg = v.Args.Get(0)
                    if (firstArg.Kind == NodeKind.LITERAL_STRING) {
                        msgStr = this.EmitExprStr(firstArg)
                    }
                }
                let symName = this.SymName(typeName)
                this.Out.EmitLine("_am_throw((void*)(" + symName + "_new(" + argsStr + ")), \"" + typeName + "\", " + msgStr + ");")
                return
            }
            let valStr = this.EmitExprStr(v)
            this.Out.EmitLine("_am_throw((void*)" + valStr + ", \"Error\", \"\");")
            return
        }
        if (k == NodeKind.VAR_DECL) {
            // Tuple destructuring: let (a, b) = expr
            if (stmt.Str == "__tuple_destructure__") {
                let rhs = this.EmitExprStr(stmt.Left)
                let tmpName = "__tup_" + String_FromInt(stmt.Line)
                this.Out.EmitLine("__auto_type " + tmpName + " = " + rhs + ";")
                // Try to infer element types from the called function's return tuple type
                var tupleRetType = ""
                if (stmt.Left != null && stmt.Left.Kind == NodeKind.CALL) {
                    let calleeStr2 = this.EmitCalleeStr(stmt.Left.Left)
                    // calleeStr2 = "ClassName_MethodName" — split at last _
                    let lastUs = String_LastIndexOf(calleeStr2, "_")
                    if (lastUs > 0) {
                        let cls2 = String_Substring(calleeStr2, 0, lastUs)
                        let mth2 = String_Substring(calleeStr2, lastUs + 1, String_Length(calleeStr2) - lastUs - 1)
                        tupleRetType = this.MethodRetGet(cls2, mth2)
                    }
                }
                let nc = stmt.Children.Count()
                for i in 0..nc {
                    let vnode = stmt.Children.Get(i)
                    let vname = vnode.Name
                    let idxStr = String_FromInt(i)
                    this.Out.EmitLine("__auto_type " + vname + " = " + tmpName + "._" + idxStr + ";")
                    // Infer element type from tuple type string "(int,string,bool)"
                    var elemType = "void*"
                    if (String_Length(tupleRetType) > 2 && String_StartsWith(tupleRetType, "(")) {
                        let inner2 = String_Substring(tupleRetType, 1, String_Length(tupleRetType) - 2)
                        // Split by comma and get i-th element
                        var ei = 0
                        var cur2 = ""
                        var ci2  = 0
                        let ilen = String_Length(inner2)
                        while (ci2 <= ilen) {
                            var ch2 = ""
                            if (ci2 < ilen) { ch2 = String_Substring(inner2, ci2, 1) }
                            if (ch2 == "," || ci2 == ilen) {
                                if (ei == i && String_Length(cur2) > 0) {
                                    elemType = this.TypeToC(cur2)
                                }
                                ei = ei + 1
                                cur2 = ""
                            } else { cur2 = cur2 + ch2 }
                            ci2 = ci2 + 1
                        }
                    }
                    this.LocalTypeSet(vname, elemType)
                }
                return
            }
            // Lambda assignment: let doubler = x => x * 2
            // The lambda's env struct + fn forward decl were already
            // emitted by Phase A (EmitLambdaForwards); here we just allocate
            // the env, copy captured locals into it, and bundle them
            // into an AmalgameClosure value.
            if (stmt.Left != null && stmt.Left.Kind == NodeKind.METHOD_DECL && stmt.Left.Name == "__lambda__") {
                let lam     = stmt.Left
                let id      = lam.Str2
                let envName = "LamEnv_" + id
                let fnName  = "lam_" + id + "_fn"
                let envVar  = "__env_" + id
                this.Out.EmitLine(envName + "* " + envVar + " = (" + envName + "*) code_alloc(sizeof(" + envName + "));")
                let cn = lam.Args.Count()
                for i in 0..cn {
                    let cap = lam.Args.Get(i)
                    this.Out.EmitLine(envVar + "->_" + cap.Name + " = " + cap.Name + ";")
                }
                this.Out.EmitLine("AmalgameClosure* " + stmt.Name + " = AmalgameClosure_new((void*)" + fnName + ", " + envVar + ");")
                this.LocalTypeSet(stmt.Name, "AmalgameClosure*")
                // Track the lambda's return type so the call site emits
                // the right cast/unbox instead of always assuming i64.
                // Expression-bodied lambdas: infer from lam.Left. Block-
                // bodied lambdas leave it blank → call site falls back
                // to the legacy `UnboxScalar("i64", …)` path.
                if (lam.Left != null) {
                    let retC = this.InferTypeFromExpr(lam.Left)
                    if (String_Length(retC) > 0) {
                        this.ListElemSet("__closure_ret__", stmt.Name, retC)
                    }
                }
                return
            }
            var t = this.TypeToC(stmt.Str)
            // If no explicit type annotation, infer from RHS
            if (String_Length(t) == 0 || t == "void") {
                t = this.InferTypeFromExpr(stmt.Left)
            }
            // Fall back to void* only if we truly can't infer
            if (String_Length(t) == 0) { t = "void*" }
            // Record in local type table for later use
            this.LocalTypeSet(stmt.Name, t)
            // Track the elem (List<T>) / value (Map<K,V>) type so a later
            // `xs.Get(i)` / `m.Get(k)` can emit a typed cast instead of
            // void*. Three sources, in order of confidence:
            //   1. Explicit annotation: `let xs: List<int> = ...`
            //   2. NEW_EXPR RHS: `let xs = new List<int>()`
            //   3. Method-call return type: `let xs = Program.MakeList()`
            //      where MakeList is declared `List<int>`.
            if (String_Length(stmt.Str) > 0) {
                this.TrackGenericLocal(stmt.Name, stmt.Str)
            }
            if (stmt.Left != null && stmt.Left.Kind == NodeKind.NEW_EXPR) {
                if (String_Length(stmt.Left.Str2) > 0) {
                    let synth = stmt.Left.Name + "<" + stmt.Left.Str2 + ">"
                    this.TrackGenericLocal(stmt.Name, synth)
                }
            }
            if (stmt.Left != null && stmt.Left.Kind == NodeKind.CALL) {
                // Recover ClassName + MethodName for `obj.Method()` and
                // `Program.Method()` so we can read the raw return type.
                let callee = stmt.Left.Left
                if (callee != null && callee.Kind == NodeKind.MEMBER) {
                    if (callee.Left != null && callee.Left.Kind == NodeKind.IDENTIFIER) {
                        let retRaw = this.MethodRetRawGet(callee.Left.Name, callee.Name)
                        if (String_Length(retRaw) > 0) {
                            this.TrackGenericLocal(stmt.Name, retRaw)
                        }
                    }
                    // Higher-order list methods (lambda v2.5):
                    // - Filter conserves the receiver's element type
                    //   (List<int>.Filter → List<int>).
                    // - Map's result element type is the lambda's
                    //   return type, NOT the receiver's element type.
                    //   We push the lambda params into LocalTypes so
                    //   InferTypeFromExpr can resolve `u.Name` against
                    //   the param's annotated type, then pop them.
                    let mname = callee.Name
                    if (mname == "Filter") {
                        if (callee.Left != null && callee.Left.Kind == NodeKind.IDENTIFIER) {
                            let recvName = callee.Left.Name
                            let recvElem = this.ListElemGet("__local__", recvName)
                            if (String_Length(recvElem) > 0) {
                                this.ListElemSet("__local__", stmt.Name, recvElem)
                            }
                        }
                    } else if (mname == "Map") {
                        this.TrackMapResultElem(stmt)
                    }
                }
            }
            // Emit the declaration — for void* from List.Get(), emit a typed cast
            let rhs = this.EmitExprStr(stmt.Left)
            var decl = t + " " + stmt.Name + " = " + rhs + ";"
            // If inferred void* but we have a typed cast available, upgrade the variable type
            if (t == "void*") {
                // Check if rhs already contains a typed cast like "(SomeType*)AmalgameList_get"
                // but NOT a ternary expression like "(cond ? a : b)"
                if (String_StartsWith(rhs, "(") && !String_StartsWith(rhs, "(void*)") && !String_StartsWith(rhs, "({") && !String_Contains(rhs, "?")) {
                    // Extract cast type from "(Type*)expr" → strip outer parens up to first )
                    let closeP = String_IndexOf(rhs, ")")
                    if (closeP > 1) {
                        let castT = String_Substring(rhs, 1, closeP - 1)
                        if (String_Length(castT) > 0) {
                            t = castT
                            this.LocalTypeSet(stmt.Name, t)
                            decl = t + " " + stmt.Name + " = " + rhs + ";"
                        }
                    }
                }
            }
            this.Out.EmitLine(decl)
        }
        if (k == NodeKind.RETURN_STMT) {
            if (stmt.Left == null) {
                if (this.InLambdaBody) {
                    // Bare `return` inside a lambda body — yield boxed 0.
                    this.Out.EmitLine("return " + this.BoxAsVoid("0") + ";")
                } else {
                    this.Out.EmitLine("return;")
                }
            } else {
                let retExpr = this.EmitExprStr(stmt.Left)
                if (retExpr == "_unknown_") {
                    this.Out.EmitLine("return;")
                } else if (this.InLambdaBody) {
                    // Lambda body's enclosing fn returns void*; box the
                    // expression via intptr_t so call sites can unbox.
                    this.Out.EmitLine("return " + this.BoxAsVoid(retExpr) + ";")
                } else if (String_StartsWith(retExpr, "{") && String_Length(this.CurrentRetType) > 0) {
                    // Tuple literal {a,b,...} — cast with current return type.
                    this.Out.EmitLine("return (" + this.CurrentRetType + ")" + retExpr + ";")
                } else {
                    this.Out.EmitLine("return " + retExpr + ";")
                }
            }
        }
        if (k == NodeKind.IF_STMT) {
            // Check if this is a match statement
            if (stmt.Name == "__match__") {
                this.EmitMatch(stmt)
                return
            }
            this.EmitIf(stmt)
        }
        if (k == NodeKind.WHILE_STMT) {
            this.Out.EmitLine("while (" + this.EmitExprStr(stmt.Cond) + ") {")
            this.Out.Indent_()
            if (stmt.Body != null) { this.EmitBlock(stmt.Body) }
            this.Out.Dedent()
            this.Out.EmitLine("}")
        }
        if (k == NodeKind.FOR_IN_STMT) {
            let vn = stmt.Name
            // iter is the range expression: BINARY("..", start, end) or a collection
            if (stmt.Left != null) {
                let iterKind = stmt.Left.Kind
                if (iterKind == NodeKind.BINARY) {
                    let iterOp = stmt.Left.Str
                    if (iterOp == "..") {
                        // Range for: for i in start..end → for (i64 i = start; i < end; i++)
                        let startExpr = this.EmitExprStr(stmt.Left.Left)
                        let endExpr   = this.EmitExprStr(stmt.Left.Right)
                        this.Out.EmitLine("for (i64 " + vn + " = " + startExpr + "; " + vn + " < " + endExpr + "; " + vn + "++) {")
                        this.LocalTypeSet(vn, "i64")
                        this.Out.Indent_()
                        if (stmt.Body != null) { this.EmitBlock(stmt.Body) }
                        this.Out.Dedent()
                        this.Out.EmitLine("}")
                        this.LocalTypeSet(vn, "")
                        return
                    }
                }
            }
            // Collection for: for x in <list-expr>. Emit a wrapper block so
            // the synthetic iterator + length stay scoped to the loop. The
            // element type is erased to void* (generics erase to void*); the
            // user casts explicitly when treating the element as a primitive.
            // The synthetic names use vn as a suffix so nested for-in over
            // different lists don't shadow each other.
            let iter = this.EmitExprStr(stmt.Left)
            this.Out.EmitLine("{")
            this.Out.Indent_()
            this.Out.EmitLine("AmalgameList* __it_" + vn + " = " + iter + ";")
            this.Out.EmitLine("i64 __len_" + vn + " = AmalgameList_size(__it_" + vn + ");")
            this.Out.EmitLine("for (i64 __idx_" + vn + " = 0; __idx_" + vn + " < __len_" + vn + "; __idx_" + vn + "++) {")
            this.Out.Indent_()
            this.Out.EmitLine("void* " + vn + " = __it_" + vn + "->data[__idx_" + vn + "];")
            this.LocalTypeSet(vn, "void*")
            if (stmt.Body != null) { this.EmitBlock(stmt.Body) }
            this.Out.Dedent()
            this.Out.EmitLine("}")
            this.Out.Dedent()
            this.Out.EmitLine("}")
            this.LocalTypeSet(vn, "")
        }
        if (k == NodeKind.BREAK_STMT) {
            this.Out.EmitLine("break;")
        }
        if (k == NodeKind.CONTINUE_STMT) {
            this.Out.EmitLine("continue;")
        }
        if (k == NodeKind.BINARY) {
            this.Out.EmitLine(this.EmitExprStr(stmt) + ";")
        }
        if (k == NodeKind.CALL) {
            this.Out.EmitLine(this.EmitExprStr(stmt) + ";")
        }
        if (k == NodeKind.MEMBER) {
            this.Out.EmitLine(this.EmitExprStr(stmt) + ";")
        }
    }

    // ── Expression emission ───────────────────────────

    private string EmitExprStr(AstNode expr) {
        if (expr == null) { return "NULL" }
        let k = expr.Kind
        // Lambda: x => expr — emit as a real AmalgameClosure*.
        //
        // Higher-order list methods (Map/Filter/etc.) intercept the
        // lambda earlier via EmitClosureArg with their element-type
        // framing; anything landing here is an inline lambda passed
        // to a regular call site (e.g. webview Bind, builder OnClick),
        // where the closure value itself is the desired argument.
        //
        // The legacy `__lambda_<param>_<body>__` placeholder pattern
        // didn't survive any call site that wasn't a Map/Filter — it
        // surfaced as garbage C tokens. Emitting an inline
        // `AmalgameClosure_new((void*)lam_N_fn, env)` is type-correct
        // and lifetime-safe (env is code_alloc'd, GC tracks both).
        if (k == NodeKind.METHOD_DECL && expr.Name == "__lambda__") {
            return this.EmitLambdaAsClosure(expr)
        }
        // Tuple literal: (val1, val2, ...)
        if (k == NodeKind.CALL && expr.Name == "__tuple_literal__") {
            // We don't know the struct name here without context,
            // use compound literal with positional initializers
            let argc = expr.Args.Count()
            var result = "{"
            for i in 0..argc {
                if (i > 0) { result = result + ", " }
                result = result + this.EmitExprStr(expr.Args.Get(i))
            }
            result = result + "}"
            return result
        }
        if (k == NodeKind.IF_STMT) {
            // match-as-expression: same NodeKind, distinguished by marker.
            if (expr.Name == "__match__") {
                return this.EmitMatchExpr(expr)
            }
            let condStr = this.EmitExprStr(expr.Cond)
            let thenStr = this.EmitIfBranch(expr.Body)
            let elseStr = this.EmitIfBranch(expr.Else)
            return "(" + condStr + " ? " + thenStr + " : " + elseStr + ")"
        }
        if (k == NodeKind.LITERAL_INT)    { return expr.Str }
        if (k == NodeKind.LITERAL_FLOAT)  { return expr.Str }
        if (k == NodeKind.LITERAL_STRING) {
            let raw = expr.Str
            return this.EmitInterpolatedString(raw)
        }
        if (k == NodeKind.LITERAL_BOOL) {
            if (expr.Flag) { return "1" }
            return "0"
        }
        if (k == NodeKind.LITERAL_NULL) { return "NULL" }
        if (k == NodeKind.THIS_EXPR)    { return "self" }
        if (k == NodeKind.IDENTIFIER) {
            // Auto-qualify implicit field access in method bodies:
            // `Id = id` inside a method/constructor lowers to
            // `self->Id = id` when Id isn't a local (no shadow) but
            // IS a field of the current class. Lets users from
            // C# / TS / Kotlin / Swift skip the explicit `this.`
            // qualifier without breaking codegen. Resolves naturally
            // for both reads (rhs) and writes (lhs) since both go
            // through this branch.
            let name = expr.Name
            if (String_Length(this.CurrentClass) > 0) {
                let asLocal: string = this.LocalTypeGet(name)
                if (String_Length(asLocal) == 0) {
                    let asField: string = this.FieldTypeGet(this.CurrentClass, name)
                    if (String_Length(asField) > 0 && asField != "?") {
                        return "self->" + name
                    }
                }
            }
            return name
        }
        if (k == NodeKind.MEMBER) {
            // Null-safe access: `obj?.field` → `(obj ? obj->field : NULL)`.
            // Note: assumes `obj` has no side effects (we evaluate it twice).
            // Use a let-binding for complex receivers.
            if (expr.Flag) {
                let target = this.EmitExprStr(expr.Left)
                return "(" + target + " ? " + target + "->" + expr.Name + " : NULL)"
            }
            if (expr.Left != null) {
                let lk = expr.Left.Kind
                if (lk == NodeKind.THIS_EXPR) {
                    return "self->" + expr.Name
                }
                if (lk == NodeKind.IDENTIFIER) {
                    let tname = expr.Left.Name
                    let firstChar = String_Substring(tname, 0, 1)
                    let isUpper = firstChar == String_ToUpper(firstChar)
                    if (isUpper) {
                        // Enum or static class access: TokenType.NEWLINE → Ns_TokenType_NEWLINE
                        return this.SymName(tname) + "_" + expr.Name
                    }
                    return tname + "->" + expr.Name
                }
            }
            let target = this.EmitExprStr(expr.Left)
            return target + "->" + expr.Name
        }
        if (k == NodeKind.BINARY) {
            var left  = this.EmitExprStr(expr.Left)
            let op    = expr.Str
            var right = this.EmitExprStr(expr.Right)
            // Preserve source precedence: any sub-BINARY operand
            // gets wrapped in parens at the C level. C's precedence
            // table doesn't always match the source's nesting (e.g.
            // `(h - 2*pad - gap) / n` would otherwise emit as
            // `h - 2*pad - gap / n`, evaluating `gap / n` first).
            // Belt-and-braces — over-parenthesising is harmless and
            // matches what pretty-printers like clang-format do.
            if (expr.Left != null && expr.Left.Kind == NodeKind.BINARY) {
                left = "(" + left + ")"
            }
            if (expr.Right != null && expr.Right.Kind == NodeKind.BINARY) {
                right = "(" + right + ")"
            }
            if (op == "==" || op == "!=") {
                // Infer LHS type to decide: string → code_string_equals, else → C == / !=
                let ltype = this.InferTypeFromExpr(expr.Left)
                var useStrEq = false
                if (ltype == "code_string") { useStrEq = true }
                // If LHS is a CALL to a known string-returning method, treat as string
                if (String_Length(ltype) == 0) {
                    if (expr.Left != null) {
                        let lk2 = expr.Left.Kind
                        if (lk2 == NodeKind.LITERAL_STRING) { useStrEq = true }
                        // CALL to CharAt / String_* → code_string
                        if (lk2 == NodeKind.CALL) {
                            if (expr.Left.Left != null) {
                                let calleeStr = this.EmitCalleeStr(expr.Left.Left)
                                if (String_StartsWith(calleeStr, "String_") || String_EndsWith(calleeStr, "_CharAt")) {
                                    useStrEq = true
                                }
                            }
                        }
                        // IDENTIFIER whose local type is code_string
                        if (lk2 == NodeKind.IDENTIFIER) {
                            let lt2 = this.LocalTypeGet(expr.Left.Name)
                            if (lt2 == "code_string") { useStrEq = true }
                        }
                        // MEMBER → this.Field or var.Field
                        if (lk2 == NodeKind.MEMBER) {
                            let ft = this.InferTypeFromExpr(expr.Left)
                            if (ft == "code_string") { useStrEq = true }
                        }
                    }
                }
                // Also: if RHS is a string literal, LHS must be string
                if (!useStrEq) {
                    if (expr.Right != null) {
                        if (expr.Right.Kind == NodeKind.LITERAL_STRING) { useStrEq = true }
                    }
                }
                if (useStrEq) {
                    if (op == "==") { return "code_string_equals(" + left + ", " + right + ")" }
                    return "!code_string_equals(" + left + ", " + right + ")"
                }
                // Non-string (int, bool, enum, pointer): use C == / !=
                return left + " " + op + " " + right
            }
            // String concatenation: a + b where either side is a string
            if (op == "+") {
                let ltype2 = this.InferTypeFromExpr(expr.Left)
                var useConcat = false
                if (ltype2 == "code_string") { useConcat = true }
                if (!useConcat) {
                    if (expr.Left != null) {
                        let lk3 = expr.Left.Kind
                        if (lk3 == NodeKind.LITERAL_STRING) { useConcat = true }
                        if (lk3 == NodeKind.IDENTIFIER) {
                            let lt3 = this.LocalTypeGet(expr.Left.Name)
                            if (lt3 == "code_string") { useConcat = true }
                        }
                        // CALL that returns code_string (including nested code_string_concat)
                        if (lk3 == NodeKind.CALL) {
                            let ltype3 = this.InferTypeFromExpr(expr.Left)
                            if (ltype3 == "code_string") { useConcat = true }
                            // Also detect code_string_concat directly by callee name
                            if (expr.Left.Left != null) {
                                let calleeL = this.EmitCalleeStr(expr.Left.Left)
                                if (String_StartsWith(calleeL, "String_") || calleeL == "code_string_concat") {
                                    useConcat = true
                                }
                            }
                        }
                    }
                }
                if (!useConcat) {
                    if (expr.Right != null) {
                        let rk3 = expr.Right.Kind
                        if (rk3 == NodeKind.LITERAL_STRING) { useConcat = true }
                        if (rk3 == NodeKind.CALL) {
                            if (expr.Right.Left != null) {
                                let calleeR = this.EmitCalleeStr(expr.Right.Left)
                                if (String_StartsWith(calleeR, "String_") || calleeR == "code_string_concat") {
                                    useConcat = true
                                }
                            }
                        }
                    }
                }
                if (useConcat) {
                    var lcast = left
                    var rcast = right
                    let ltype4 = this.InferTypeFromExpr(expr.Left)
                    let rtype4 = this.InferTypeFromExpr(expr.Right)
                    if (ltype4 == "void*") { lcast = "(code_string)(" + left + ")" }
                    if (rtype4 == "void*") { rcast = "(code_string)(" + right + ")" }
                    return "code_string_concat(" + lcast + ", " + rcast + ")"
                }
            }
            return left + " " + op + " " + right
        }
        if (k == NodeKind.UNARY) {
            let operand = this.EmitExprStr(expr.Left)
            // Wrap binary/ternary operands in parens so C precedence matches
            // the source (e.g. `!(x > 0)`, not `!x > 0`).
            if (expr.Left != null) {
                let lk = expr.Left.Kind
                if (lk == NodeKind.BINARY) { return expr.Str + "(" + operand + ")" }
            }
            return expr.Str + operand
        }
        if (k == NodeKind.CALL) {
            // Closure call: callee is a local of type AmalgameClosure*.
            // v2 supports arities 1, 2, 3 — args boxed via intptr_t at
            // the call site, result unboxed back to i64. Arities >3
            // would need a runtime/codegen extension; not yet emitted
            // by anything.
            if (expr.Left != null && expr.Left.Kind == NodeKind.IDENTIFIER) {
                let calleeName = expr.Left.Name
                let calleeType = this.LocalTypeGet(calleeName)
                if (calleeType == "AmalgameClosure*") {
                    let argc: int = expr.Args.Count()
                    // Result-type-aware unwrap. The lambda's declared
                    // return type was stashed at assignment time (see
                    // EmitVarDeclStmt / __closure_ret__). For pointer
                    // types (code_string, anything ending in `*`) emit
                    // a direct cast so gcc doesn't complain about
                    // integer-to-pointer; for scalars stay on the
                    // intptr_t-roundtrip path; default to i64 if we
                    // never learned the return type (block-bodied
                    // lambdas, or fall-throughs from older code).
                    let retC0 = this.ListElemGet("__closure_ret__", calleeName)
                    var retC: string = retC0
                    if (String_Length(retC) == 0) { retC = "i64" }
                    if (argc == 1) {
                        let arg0 = this.EmitExprStr(expr.Args.Get(0))
                        let callC = "AmalgameClosure_call1(" + calleeName + ", " + this.BoxAsVoid(arg0) + ")"
                        if (this.IsCPointerType(retC)) { return "((" + retC + ")" + callC + ")" }
                        return this.UnboxScalar(retC, callC)
                    }
                    if (argc == 2) {
                        let arg0 = this.EmitExprStr(expr.Args.Get(0))
                        let arg1 = this.EmitExprStr(expr.Args.Get(1))
                        let callC = "AmalgameClosure_call2(" + calleeName + ", " + this.BoxAsVoid(arg0) + ", " + this.BoxAsVoid(arg1) + ")"
                        if (this.IsCPointerType(retC)) { return "((" + retC + ")" + callC + ")" }
                        return this.UnboxScalar(retC, callC)
                    }
                    if (argc == 3) {
                        let arg0 = this.EmitExprStr(expr.Args.Get(0))
                        let arg1 = this.EmitExprStr(expr.Args.Get(1))
                        let arg2 = this.EmitExprStr(expr.Args.Get(2))
                        let callC = "AmalgameClosure_call3(" + calleeName + ", " + this.BoxAsVoid(arg0) + ", " + this.BoxAsVoid(arg1) + ", " + this.BoxAsVoid(arg2) + ")"
                        if (this.IsCPointerType(retC)) { return "((" + retC + ")" + callC + ")" }
                        return this.UnboxScalar(retC, callC)
                    }
                }
            }
            // Check for AmalgameList method dispatch before generic emit
            let listCall = this.TryEmitListCall(expr)
            if (String_Length(listCall) > 0) { return listCall }
            // Detect this.Method() or this.Field.Method() → inject self / self->Field as first arg
            var isSelfCall = false
            var selfExpr   = "self"
            if (expr.Left != null) {
                if (expr.Left.Kind == NodeKind.MEMBER) {
                    if (expr.Left.Left != null) {
                        let ll = expr.Left.Left
                        // this.Method(...)
                        if (ll.Kind == NodeKind.THIS_EXPR) {
                            isSelfCall = true
                            selfExpr   = "self"
                        }
                        // this.Field.Method(...) or varName.Field.Method(...)
                        // — field is itself a struct.
                        if (ll.Kind == NodeKind.MEMBER) {
                            if (ll.Left != null) {
                                if (ll.Left.Kind == NodeKind.THIS_EXPR) {
                                    isSelfCall = true
                                    selfExpr   = "self->" + ll.Name
                                }
                                // varName.Field.Method(...): pass varName->Field
                                // as self. The function name resolves via
                                // EmitCalleeStr's matching new branch below.
                                if (ll.Left.Kind == NodeKind.IDENTIFIER) {
                                    let vt = this.LocalTypeGet(ll.Left.Name)
                                    let vbare = String_Replace(vt, "*", "")
                                    if (String_Length(vbare) > 0 && !this.IsEnum(vbare)) {
                                        isSelfCall = true
                                        selfExpr   = ll.Left.Name + "->" + ll.Name
                                    }
                                }
                            }
                        }
                        // varName.Method(...) where varName is a known instance type
                        if (ll.Kind == NodeKind.IDENTIFIER) {
                            let vt = this.LocalTypeGet(ll.Name)
                            let bare = String_Replace(vt, "*", "")
                            if (String_Length(bare) > 0 && !this.IsEnum(bare)) {
                                isSelfCall = true
                                selfExpr   = ll.Name
                            }
                        }
                        // varName.Method().OtherMethod(...) — chain into the
                        // result of the inner call. InferTypeFromExpr knows
                        // user-defined method return types (registered via
                        // MethodRetSet during pass-1 forward emission), so
                        // the receiver type comes back resolved.
                        if (ll.Kind == NodeKind.CALL) {
                            let rt = this.InferTypeFromExpr(ll)
                            let rbare = String_Replace(rt, "*", "")
                            if (String_Length(rbare) > 0 && !this.IsEnum(rbare)) {
                                isSelfCall = true
                                selfExpr   = this.EmitExprStr(ll)
                            }
                        }
                        // new ClassName(...).Method(...) — instantiate
                        // and call on the result. The receiver is the
                        // full constructor call; EmitCalleeStr below
                        // resolves the method symbol via the same
                        // path as a static call to ClassName.
                        if (ll.Kind == NodeKind.NEW_EXPR) {
                            isSelfCall = true
                            selfExpr   = this.EmitExprStr(ll)
                        }
                        // "literal".Method(...) — pass the literal as the
                        // first argument to String_Method.
                        if (ll.Kind == NodeKind.LITERAL_STRING) {
                            isSelfCall = true
                            selfExpr   = this.EmitExprStr(ll)
                        }
                    }
                }
            }
            let callee = this.EmitCalleeStr(expr.Left)
            var callStr = callee + "("
            var first = true
            if (isSelfCall) {
                callStr = callStr + selfExpr
                first = false
            }
            let argc = expr.Args.Count()
            for i in 0..argc {
                let arg = expr.Args.Get(i)
                if (!first) { callStr = callStr + ", " }
                callStr = callStr + this.EmitExprStr(arg)
                first = false
            }
            callStr = callStr + ")"
            // Null-safe call `obj?.method(...)`: wrap as `(obj ? call : NULL)`
            // — receiver is evaluated twice, so callers should keep it side-effect-free.
            if (expr.Left != null && expr.Left.Kind == NodeKind.MEMBER && expr.Left.Flag) {
                let recv = this.EmitExprStr(expr.Left.Left)
                return "(" + recv + " ? " + callStr + " : NULL)"
            }
            return callStr
        }
        if (k == NodeKind.NEW_EXPR) {
            let tname = expr.Name
            var newCall = ""
            if (String_StartsWith(tname, "List<") || tname == "List") {
                newCall = "AmalgameList_new()"
            } else {
                if (String_StartsWith(tname, "Map<") || tname == "Map") {
                    newCall = "AmalgameMap_new()"
                } else {
                    if (String_StartsWith(tname, "Set<") || tname == "Set") {
                        newCall = "AmalgameSet_new()"
                    } else if (tname == "WebSocket") {
                        // WebSocket runtime helper — skip the
                        // namespace-mangled symbol so `new WebSocket(...)`
                        // lowers to `WebSocket_new(...)` against the
                        // dedicated runtime header. FileWatcher used
                        // to be in this list before its post-v0.7.5
                        // AM migration; Vec3/Vec4/Mat4 same post the
                        // Math_Vec.h migration.
                        newCall = tname + "_new("
                        let argc = expr.Args.Count()
                        for i in 0..argc {
                            let arg = expr.Args.Get(i)
                            if (i > 0) { newCall = newCall + ", " }
                            newCall = newCall + this.EmitExprStr(arg)
                        }
                        newCall = newCall + ")"
                        return newCall
                    } else {
                        // Project F: external classes use their file's
                        // own mangled prefix, not the bundle's NsPrefix.
                        let externalMangled: string = this.ExternalClassMangled(tname)
                        var ctorPrefix: string = ""
                        if (String_Length(externalMangled) > 0) {
                            ctorPrefix = externalMangled
                        } else {
                            ctorPrefix = this.SymName(tname)
                        }
                        newCall = ctorPrefix + "_new("
                        let argc = expr.Args.Count()
                        for i in 0..argc {
                            let arg = expr.Args.Get(i)
                            if (i > 0) { newCall = newCall + ", " }
                            newCall = newCall + this.EmitExprStr(arg)
                        }
                        newCall = newCall + ")"
                    }
                }
            }
            return newCall
        }
        if (k == NodeKind.INDEX_EXPR) {
            let base = this.EmitExprStr(expr.Left)
            let idx  = this.EmitExprStr(expr.Right)
            return base + "[" + idx + "]"
        }
        if (k == NodeKind.LIST_COMP) {
            return this.EmitListComp(expr)
        }
        if (k == NodeKind.LIST_LITERAL) {
            return this.EmitListLiteral(expr)
        }
        return "/* unknown expr */"
    }

    // ── List literal ──────────────────────────────────
    // [expr1, expr2, expr3] becomes a GCC compound-statement
    // expression that allocates a fresh AmalgameList* and pushes
    // each element box. Empty `[]` emits an empty list. Elements
    // are boxed via BoxAsVoid (matches the convention used by
    // user-written .Add(x) calls and by EmitListComp).
    private string EmitListLiteral(AstNode n) {
        var s: string = "({ AmalgameList* __ll = AmalgameList_new(); "
        let nc: int = n.Children.Count()
        for i in 0..nc {
            let elem: string = this.EmitExprStr(n.Children.Get(i))
            s = s + "AmalgameList_add(__ll, " + this.BoxAsVoid(elem) + "); "
        }
        s = s + "__ll; })"
        return s
    }

    // ── Match as expression ───────────────────────────
    // `let x = match subj { p1 => e1, p2 => e2, _ => ed }` becomes a GCC
    // compound statement expression:
    //   ({ <type> __mr; if (subj == p1) __mr = (e1);
    //      else if (subj == p2) __mr = (e2); else __mr = (ed); __mr; })
    // The result type is inferred from the first arm body. Block bodies
    // are unwrapped to their last expression statement (they're rare in
    // expression position). Algebraic-enum patterns and guards aren't
    // supported in expression position yet — we emit a stub so the rest
    // of the surrounding compilation can proceed and surface the error
    // through the type checker rather than a syntax-broken C dump.
    private string EmitMatchExpr(AstNode n) {
        let subject = n.Left
        if (subject == null) { return "/* match-expr: missing subject */" }
        let subjectStr = this.EmitExprStr(subject)
        let armCount = n.Children.Count()
        if (armCount == 0) { return "/* match-expr: no arms */" }
        // Infer the result type from the first arm body — drives the
        // declared type of __mr in the generated compound expression.
        let firstArm = n.Children.Get(0)
        let firstBody = firstArm.Right
        var resultType = this.InferTypeFromExpr(firstBody)
        if (String_Length(resultType) == 0) { resultType = "i64" }
        var s = "({ " + resultType + " __mr; "
        var firstArmFlag = true
        for i in 0..armCount {
            let arm = n.Children.Get(i)
            let pat = arm.Left
            let body = arm.Right
            if (pat == null || body == null) { continue }
            let pk = pat.Kind
            let bodyStr = this.EmitExprStr(body)
            // Wildcard arm: `_ => expr` — emit as terminal else.
            if (pk == NodeKind.IDENTIFIER && pat.Name == "_") {
                let prefix = if (firstArmFlag) { "" } else { " else " }
                s = s + prefix + "{ __mr = (" + bodyStr + "); }"
                firstArmFlag = false
                continue
            }
            // Range pattern: lo..hi
            var cond = ""
            if (pk == NodeKind.BINARY && pat.Str == "..") {
                let lo = this.EmitExprStr(pat.Left)
                let hi = this.EmitExprStr(pat.Right)
                cond = subjectStr + " >= " + lo + " && " + subjectStr + " <= " + hi
            } else if (pk == NodeKind.LITERAL_STRING) {
                let patStr = this.EmitExprStr(pat)
                cond = "strcmp(" + subjectStr + ", " + patStr + ") == 0"
            } else {
                let patStr = this.EmitExprStr(pat)
                cond = subjectStr + " == " + patStr
            }
            let prefix = if (firstArmFlag) { "" } else { " else " }
            s = s + prefix + "if (" + cond + ") { __mr = (" + bodyStr + "); }"
            firstArmFlag = false
        }
        s = s + " __mr; })"
        return s
    }

    // ── List comprehension ────────────────────────────
    // [proj for vn in iter (if guard)?] becomes a GCC compound statement
    // expression that builds and returns an AmalgameList*. Two iteration
    // shapes: range (BINARY "..") emits a counted i64 loop; everything
    // else is treated as a List* and iterated by index. Elements are
    // boxed via (void*)(intptr_t)(...) — same convention as user code
    // does when calling .Add() directly. Unique names are suffixed with
    // the iteration variable so nested comps over distinct vars don't
    // collide; same-var nesting is unsupported (rare in practice).
    private string EmitListComp(AstNode n) {
        let vn = n.Str
        let iter = n.Right
        var isRange = false
        if (iter != null && iter.Kind == NodeKind.BINARY && iter.Str == "..") {
            isRange = true
        }
        // Emit the iterable BEFORE setting the local type, so its sub-expressions
        // see the outer scope (e.g. an outer variable named `vn` keeps its type).
        var loopHeader = ""
        if (isRange) {
            let startStr = this.EmitExprStr(iter.Left)
            let endStr   = this.EmitExprStr(iter.Right)
            loopHeader = "for (i64 " + vn + " = " + startStr + "; " + vn + " < " + endStr + "; " + vn + "++) { "
            this.LocalTypeSet(vn, "i64")
        } else {
            let iterStr = this.EmitExprStr(iter)
            loopHeader = "AmalgameList* __it_" + vn + " = " + iterStr + "; "
            loopHeader = loopHeader + "i64 __n_" + vn + " = AmalgameList_size(__it_" + vn + "); "
            loopHeader = loopHeader + "for (i64 __i_" + vn + " = 0; __i_" + vn + " < __n_" + vn + "; __i_" + vn + "++) { "
            loopHeader = loopHeader + "void* " + vn + " = __it_" + vn + "->data[__i_" + vn + "]; "
            this.LocalTypeSet(vn, "void*")
        }
        // Now emit the projection and guard with vn visible.
        let projStr = this.EmitExprStr(n.Left)
        var guardStr = ""
        if (n.Cond != null) {
            guardStr = "if (" + this.EmitExprStr(n.Cond) + ") "
        }
        this.LocalTypeSet(vn, "")
        var s = "({ AmalgameList* __lc_" + vn + " = AmalgameList_new(); "
        s = s + loopHeader
        s = s + guardStr
        s = s + "AmalgameList_add(__lc_" + vn + ", " + this.BoxAsVoid(projStr) + "); "
        s = s + "} __lc_" + vn + "; })"
        return s
    }

    // ── AmalgameList method dispatch ──────────────────
    // Returns "" if not a list call, otherwise returns the C call string.
    // Handles:
    //   varName.Add(x)     → AmalgameList_add(varName, (void*)(intptr_t)(x))
    //   varName.Count()    → AmalgameList_count(varName)
    //   varName.Get(i)     → (<ElemType>)(intptr_t)AmalgameList_get(varName, i)
    //   this.Field.Add(x)  → AmalgameList_add(self->Field, ...)
    //   this.Field.Count() → AmalgameList_count(self->Field)
    //   this.Field.Get(i)  → AmalgameList_get(self->Field, i)
    private string TryEmitListCall(AstNode callExpr) {
        if (callExpr.Left == null) { return "" }
        if (callExpr.Left.Kind != NodeKind.MEMBER) { return "" }
        let callee = callExpr.Left
        let mname  = callee.Name

        // Map methods
        // Map iteration helpers — Keys() / Values() return List<K>/List<V>.
        if ((mname == "Keys" || mname == "Values") && callee.Left != null && callee.Left.Kind == NodeKind.IDENTIFIER) {
            let vname = callee.Left.Name
            let vtype = this.LocalTypeGet(vname)
            if (vtype == "AmalgameMap*") {
                if (mname == "Keys")   { return "AmalgameMap_keys(" + vname + ")" }
                if (mname == "Values") { return "AmalgameMap_values(" + vname + ")" }
            }
        }
        if (mname == "Set" || mname == "Has" || mname == "Size" || mname == "Remove" || mname == "Get") {
            if (callee.Left != null && callee.Left.Kind == NodeKind.IDENTIFIER) {
                let vname = callee.Left.Name
                let vtype = this.LocalTypeGet(vname)
                if (vtype == "AmalgameMap*") {
                    let args = callExpr.Args
                    let ac = args.Count()
                    if (mname == "Set" && ac >= 2) {
                        let k2 = this.EmitExprStr(args.Get(0))
                        let v2 = this.EmitExprStr(args.Get(1))
                        return "AmalgameMap_set(" + vname + ", " + k2 + ", " + this.BoxAsVoid(v2) + ")"
                    }
                    if (mname == "Has" && ac >= 1) {
                        let k2 = this.EmitExprStr(args.Get(0))
                        return "AmalgameMap_has(" + vname + ", " + k2 + ")"
                    }
                    if (mname == "Size") { return "AmalgameMap_size(" + vname + ")" }
                    if (mname == "Remove" && ac >= 1) {
                        let k2 = this.EmitExprStr(args.Get(0))
                        return "AmalgameMap_remove(" + vname + ", " + k2 + ")"
                    }
                    if (mname == "Get" && ac >= 1) {
                        let k2 = this.EmitExprStr(args.Get(0))
                        // Use the recorded value type for `new Map<K,V>()` so
                        // `m.Get(k)` lowers to `(V)AmalgameMap_get(m, k)`
                        // instead of `(void*)…`. Falls back to void* when V
                        // wasn't tracked (e.g. param-passed map).
                        var castT = this.ListElemGet("__local_map__", vname)
                        if (String_Length(castT) == 0) { castT = "void*" }
                        return "(" + castT + ")AmalgameMap_get(" + vname + ", " + k2 + ")"
                    }
                }
            }
        }
        // Set methods
        if (mname == "Contains" || mname == "Size") {
            if (callee.Left != null && callee.Left.Kind == NodeKind.IDENTIFIER) {
                let vname = callee.Left.Name
                let vtype = this.LocalTypeGet(vname)
                if (vtype == "AmalgameSet*") {
                    let args = callExpr.Args
                    let ac = args.Count()
                    if (mname == "Contains" && ac >= 1) {
                        let v2 = this.EmitExprStr(args.Get(0))
                        return "AmalgameSet_contains(" + vname + ", " + v2 + ")"
                    }
                    if (mname == "Size") { return "AmalgameSet_size(" + vname + ")" }
                }
            }
        }
        if (mname == "Add" || mname == "Remove") {
            if (callee.Left != null && callee.Left.Kind == NodeKind.IDENTIFIER) {
                let vname = callee.Left.Name
                let vtype = this.LocalTypeGet(vname)
                if (vtype == "AmalgameSet*") {
                    let args = callExpr.Args
                    let ac = args.Count()
                    if (ac >= 1) {
                        let v2 = this.EmitExprStr(args.Get(0))
                        if (mname == "Add") { return "AmalgameSet_add(" + vname + ", " + v2 + ")" }
                        return "AmalgameSet_remove(" + vname + ", " + v2 + ")"
                    }
                }
            }
        }

        if (mname != "Add" && mname != "Set" && mname != "Count" && mname != "Get" && mname != "IsEmpty" && mname != "Remove" && mname != "RemoveAt" && mname != "Clear" && mname != "Reserve" && mname != "Filter" && mname != "Map" && mname != "Reduce" && mname != "ForEach" && mname != "Any" && mname != "All" && mname != "CountIf") { return "" }

        // Determine the list object expression and its C type
        var listExpr = ""
        var listCType = ""

        if (callee.Left != null) {
            let lk = callee.Left.Kind

            // Case 1: varName.Method()
            if (lk == NodeKind.IDENTIFIER) {
                let vname = callee.Left.Name
                let vtype = this.LocalTypeGet(vname)
                if (vtype == "AmalgameList*") {
                    listExpr  = vname
                    listCType = "AmalgameList*"
                }
            }

            // Case 4: <list-call>.Method() — chained higher-order calls
            // (e.g. xs.Filter(p).Map(q)). We recursively emit the inner
            // call as the listExpr; the result is itself a List* so the
            // outer Filter/Map/etc. can wrap it cleanly.
            if (lk == NodeKind.CALL) {
                let innerStr: string = this.TryEmitListCall(callee.Left)
                if (String_Length(innerStr) > 0) {
                    listExpr  = innerStr
                    listCType = "AmalgameList*"
                }
            }

            // Case 2: this.Field.Method()
            if (lk == NodeKind.MEMBER) {
                if (callee.Left.Left != null) {
                    let llk = callee.Left.Left.Kind
                    if (llk == NodeKind.THIS_EXPR) {
                        let fname = callee.Left.Name
                        let ftype = this.FieldTypeGet(this.CurrentClass, fname)
                        if (ftype == "AmalgameList*") {
                            listExpr  = "self->" + fname
                            listCType = "AmalgameList*"
                        }
                    }
                    // Case 3: varName.Field.Method() where varName is a known struct type
                    if (llk == NodeKind.IDENTIFIER) {
                        let vname2  = callee.Left.Left.Name
                        let vtype2  = this.LocalTypeGet(vname2)
                        let fname2  = callee.Left.Name
                        // Strip trailing * to get class name for field lookup
                        let vbare   = String_Replace(vtype2, "*", "")
                        let ftype2  = this.FieldTypeGet(vbare, fname2)
                        if (ftype2 == "AmalgameList*") {
                            listExpr  = vname2 + "->" + fname2
                            listCType = "AmalgameList*"
                        }
                    }
                }
            }
        }

        if (String_Length(listExpr) == 0) { return "" }

        // Emit the appropriate C call
        if (mname == "Clear") {
            return "AmalgameList_clear(" + listExpr + ")"
        }
        if (mname == "Reserve") {
            let arg0 = this.EmitExprStr(callExpr.Args.Get(0))
            return "AmalgameList_reserve(" + listExpr + ", " + arg0 + ")"
        }
        if (mname == "Count") {
            return "AmalgameList_count(" + listExpr + ")"
        }
        if (mname == "Add") {
            let argc = callExpr.Args.Count()
            if (argc == 0) { return "AmalgameList_add(" + listExpr + ", NULL)" }
            let arg0 = this.EmitExprStr(callExpr.Args.Get(0))
            return "AmalgameList_add(" + listExpr + ", " + this.BoxAsVoid(arg0) + ")"
        }
        if (mname == "Set") {
            // List.Set(idx, value): replace the element at idx in place.
            // The runtime guards out-of-range writes (silent no-op).
            let argc = callExpr.Args.Count()
            if (argc < 2) { return "" }
            let idxArg = this.EmitExprStr(callExpr.Args.Get(0))
            let valArg = this.EmitExprStr(callExpr.Args.Get(1))
            return "AmalgameList_set(" + listExpr + ", " + idxArg + ", " + this.BoxAsVoid(valArg) + ")"
        }
        if (mname == "Get") {
            let argc = callExpr.Args.Count()
            var idx0 = "0"
            if (argc > 0) { idx0 = this.EmitExprStr(callExpr.Args.Get(0)) }
            // Try to find element type from the list field's owning class
            var elemType = ""
            if (callee.Left != null) {
                let lkG = callee.Left.Kind
                // Case: this.Field.Get(i)
                if (lkG == NodeKind.THIS_EXPR) {
                    // listExpr is just the list var — field name is callee.Name of the outer
                }
                // Case: varName.Field.Get(i) — lkG == MEMBER(IDENTIFIER(varName), Field)
                if (lkG == NodeKind.MEMBER) {
                    if (callee.Left.Left != null) {
                        let lll = callee.Left.Left
                        // this.Field.Get(i)
                        if (lll.Kind == NodeKind.THIS_EXPR) {
                            let fn4 = callee.Left.Name
                            elemType = this.ListElemGet(this.CurrentClass, fn4)
                        }
                        // var.Field.Get(i) — look up var type → class → field elem type
                        if (lll.Kind == NodeKind.IDENTIFIER) {
                            let vn4   = lll.Name
                            let vt4   = this.LocalTypeGet(vn4)
                            let bare4 = String_Replace(vt4, "*", "")
                            let fn4b  = callee.Left.Name
                            elemType = this.ListElemGet(bare4, fn4b)
                        }
                    }
                }
                // Case: varName.Get(i) — listExpr is varName itself (Case 1).
                // Look up the local elem type recorded at `let xs = new List<T>()`.
                if (lkG == NodeKind.IDENTIFIER) {
                    let vn5 = callee.Left.Name
                    elemType = this.ListElemGet("__local__", vn5)
                }
            }
            if (String_Length(elemType) > 0) {
                return "(" + elemType + ")AmalgameList_get(" + listExpr + ", " + idx0 + ")"
            }
            return "(void*)AmalgameList_get(" + listExpr + ", " + idx0 + ")"
        }
        if (mname == "IsEmpty") {
            return "AmalgameList_isEmpty(" + listExpr + ")"
        }
        if (mname == "Remove") {
            let argc = callExpr.Args.Count()
            if (argc > 0) {
                let arg0 = this.EmitExprStr(callExpr.Args.Get(0))
                return "AmalgameList_remove(" + listExpr + ", " + this.BoxAsVoid(arg0) + ")"
            }
        }
        if (mname == "RemoveAt") {
            let argc = callExpr.Args.Count()
            if (argc > 0) {
                let arg0 = this.EmitExprStr(callExpr.Args.Get(0))
                return "AmalgameList_removeAt(" + listExpr + ", " + arg0 + ")"
            }
        }
        // ── Higher-order methods (lambda v2.5) ──────────
        // Each lambda argument is emitted as an inline GCC compound
        // statement expression that allocates the env, copies captures
        // in, and yields a fresh AmalgameClosure*. The runtime helpers
        // (AmalgameList_filter / _map / _reduce / _forEach) expect the
        // closure as their last argument.
        if (mname == "Filter") {
            let argc = callExpr.Args.Count()
            if (argc != 1) { return "" }
            let lamStr = this.EmitClosureArg(callExpr.Args.Get(0))
            if (String_Length(lamStr) == 0) { return "" }
            return "AmalgameList_filter(" + listExpr + ", " + lamStr + ")"
        }
        if (mname == "Map") {
            let argc = callExpr.Args.Count()
            if (argc != 1) { return "" }
            let lamStr = this.EmitClosureArg(callExpr.Args.Get(0))
            if (String_Length(lamStr) == 0) { return "" }
            return "AmalgameList_map(" + listExpr + ", " + lamStr + ")"
        }
        if (mname == "ForEach") {
            let argc = callExpr.Args.Count()
            if (argc != 1) { return "" }
            let lamStr = this.EmitClosureArg(callExpr.Args.Get(0))
            if (String_Length(lamStr) == 0) { return "" }
            return "AmalgameList_forEach(" + listExpr + ", " + lamStr + ")"
        }
        if (mname == "Reduce") {
            // Two-arg form: xs.Reduce(init, (acc, x) => …)
            let argc = callExpr.Args.Count()
            if (argc != 2) { return "" }
            let initStr = this.EmitExprStr(callExpr.Args.Get(0))
            let lamStr  = this.EmitClosureArg(callExpr.Args.Get(1))
            if (String_Length(lamStr) == 0) { return "" }
            return this.UnboxScalar("i64", "AmalgameList_reduce(" + listExpr + ", " + this.BoxAsVoid(initStr) + ", " + lamStr + ")")
        }
        if (mname == "Any") {
            let argc = callExpr.Args.Count()
            if (argc != 1) { return "" }
            let lamStr = this.EmitClosureArg(callExpr.Args.Get(0))
            if (String_Length(lamStr) == 0) { return "" }
            return "AmalgameList_any(" + listExpr + ", " + lamStr + ")"
        }
        if (mname == "All") {
            let argc = callExpr.Args.Count()
            if (argc != 1) { return "" }
            let lamStr = this.EmitClosureArg(callExpr.Args.Get(0))
            if (String_Length(lamStr) == 0) { return "" }
            return "AmalgameList_all(" + listExpr + ", " + lamStr + ")"
        }
        if (mname == "CountIf") {
            let argc = callExpr.Args.Count()
            if (argc != 1) { return "" }
            let lamStr = this.EmitClosureArg(callExpr.Args.Get(0))
            if (String_Length(lamStr) == 0) { return "" }
            return "AmalgameList_countIf(" + listExpr + ", " + lamStr + ")"
        }
        return ""
    }

    // ── Closure-argument emission (lambda v2.5) ──────
    // Higher-order calls accept either an inline lambda (METHOD_DECL
    // tagged "__lambda__"), already assigned an id by EmitLambdaForwards,
    // or a local variable already typed AmalgameClosure*. Returns "" when
    // we can't produce a closure (caller bails out and emits the call
    // through the regular path).
    private string EmitClosureArg(AstNode arg) {
        if (arg == null) { return "" }
        if (arg.Kind == NodeKind.METHOD_DECL && arg.Name == "__lambda__") {
            return this.EmitLambdaAsClosure(arg)
        }
        if (arg.Kind == NodeKind.IDENTIFIER) {
            let t = this.LocalTypeGet(arg.Name)
            if (t == "AmalgameClosure*") { return arg.Name }
        }
        return ""
    }

    // GCC compound statement expression: allocate the env, copy each
    // captured local in, then yield AmalgameClosure_new(...). Single-line
    // emission so the parent call site can drop it as one C expression.
    private string EmitLambdaAsClosure(AstNode lam) {
        let id      = lam.Str2
        let envName = "LamEnv_" + id
        let fnName  = "lam_" + id + "_fn"
        let envVar  = "__env_" + id
        let cn: int = lam.Args.Count()
        var s = "({ " + envName + "* " + envVar + " = (" + envName + "*)code_alloc(sizeof(" + envName + ")); "
        for i in 0..cn {
            s = s + this.EmitLambdaCaptureCopy(envVar, lam.Args.Get(i))
        }
        s = s + "AmalgameClosure_new((void*)" + fnName + ", " + envVar + "); })"
        return s
    }

    // Helper exists separately so `cap.Name` is read through a typed
    // parameter — chained `.Get(i).Name` erases to void* in the
    // emitted C and breaks the access otherwise.
    private string EmitLambdaCaptureCopy(string envVar, AstNode cap) {
        return envVar + "->_" + cap.Name + " = " + cap.Name + "; "
    }

    private string EmitCalleeStr(AstNode callee) {
        if (callee == null) { return "NULL" }
        let k = callee.Kind
        if (k == NodeKind.IDENTIFIER) { return callee.Name }
        if (k == NodeKind.MEMBER) {
            let mname = callee.Name
            if (callee.Left != null) {
                let lk = callee.Left.Kind
                if (lk == NodeKind.THIS_EXPR) {
                    // this.Method() → CurrentClass_Method (includes class name)
                    return this.CurrentClass + "_" + mname
                }
                // String literal receiver: `"foo".Trim()` → String_Trim("foo")
                if (lk == NodeKind.LITERAL_STRING) {
                    return "String_" + mname
                }
                if (lk == NodeKind.IDENTIFIER) {
                    let tname = callee.Left.Name
                    let firstChar = String_Substring(tname, 0, 1)
                    let isUpper = firstChar == String_ToUpper(firstChar)
                    if (isUpper) {
                        // Path.{Combine,Sep,IsAbsolute,Normalize} —
                        // their runtime symbols match the method
                        // name 1:1, so lower without requiring an
                        // `import Amalgame.Path`. The other four
                        // (Directory/Filename/Extension/Stem) wrap
                        // `Path_Get*` and must still go through the
                        // namespace dispatch below.
                        if (tname == "Path") {
                            if (mname == "Combine" || mname == "Sep" || mname == "IsAbsolute" || mname == "Normalize") {
                                return "Path_" + mname
                            }
                        }
                        // Project F (v0.7.5+): external classes registered via
                        // `--external <file.am>` route through the file's own
                        // namespace mangling (`Amalgame_Random_Random_*`),
                        // not the bundle's global NsPrefix. Checked before
                        // isCoreStdlib so the same names can coexist.
                        let externalMangled: string = this.ExternalClassMangled(tname)
                        if (String_Length(externalMangled) > 0) {
                            return externalMangled + "_" + mname
                        }
                        // Core stdlib classes lower to the flat
                        // `ClassName_Method` symbol — they're
                        // single-author and have no collision risk.
                        // BuildInfo used to be in this list (its body was a
                        // runtime header). Since v0.7.4 it's an AM class
                        // (src/stdlib/amc_buildinfo.am) bundled under the
                        // Amalgame.Compiler namespace, so it now goes
                        // through the normal namespace-mangled dispatch.
                        // Log is the next migration (post-v0.7.5) — it
                        // lives in src/stdlib/logging.am with `@c { … }`
                        // bodies, same namespace-mangled dispatch.
                        let isCoreStdlib: bool = tname == "Console" || tname == "File" || tname == "String" || tname == "List" || tname == "Env" || tname == "Process" || tname == "Regex" || tname == "Compress" || tname == "WebSocket"
                        if (isCoreStdlib) {
                            return tname + "_" + mname
                        }
                        // v0.5 packages: namespace-mangled form so
                        // two packages that happen to expose the
                        // same short class name can't collide.
                        //   Redis.Open → Amalgame_Database_NoSQL_Redis_Open
                        let mangledPrefix: string = this.PkgClassMangledPrefix(tname)
                        if (String_Length(mangledPrefix) > 0) {
                            return mangledPrefix + "_" + mname
                        }
                        // Static call: ClassName.Method → Ns_ClassName_Method
                        return this.SymName(tname) + "_" + mname
                    }
                    // Instance call on known-type variable: look up field type of obj
                    let varType = this.LocalTypeGet(tname)
                    let bareType = String_Replace(varType, "*", "")
                    if (String_Length(bareType) > 0) {
                        // Opaque `void*` receiver — typically the result of a
                        // `<AmalgameList*>.Get(i)` where the inner cell type
                        // was erased because the surrounding `List<List<...>>`
                        // generic wasn't annotated. Dispatch through the
                        // collection runtime (AmalgameList_<method>) when the
                        // method is a known list verb, so chained
                        // `rows.Get(i).Get(j)` lowers cleanly without
                        // requiring `let row: List<X> = rows.Get(i)`
                        // annotations at every step. Same downcase trick
                        // as the chained-CALL branch below.
                        if (bareType == "void") {
                            let isListM: bool = mname == "Get" || mname == "Count" || mname == "Size" || mname == "Add" || mname == "Remove" || mname == "Clear" || mname == "IndexOf" || mname == "Contains"
                            if (isListM) {
                                let mfirst: string = String_Substring(mname, 0, 1)
                                let mrest:  string = String_Substring(mname, 1, String_Length(mname) - 1)
                                return "AmalgameList_" + String_ToLower(mfirst) + mrest
                            }
                        }
                        // WebSocket runtime helper — strip the
                        // "Amalgame" struct prefix so `ws.Send()`
                        // on a `WebSocket*` lowers to `WebSocket_Send`,
                        // matching the runtime header naming.
                        // Vec3/Vec4/Mat4 used to be in this list
                        // before their post-v0.7.5 AM migration.
                        if (bareType == "AmalgameWebSocket") {
                            return String_Replace(bareType, "Amalgame", "") + "_" + mname
                        }
                        // Regex.Match struct → `Match_<method>` runtime.
                        if (bareType == "AmalgameRegexMatch") {
                            return "Match_" + mname
                        }
                        // `s.Length()` on a string variable should call
                        // `String_Length(s)`, not `code_string_Length(s)`.
                        // `code_string` is the legacy C typedef (the
                        // language used to be called "code" before it was
                        // renamed Amalgame); the runtime helpers are under
                        // the `String_` prefix.
                        if (bareType == "code_string") {
                            return "String_" + mname
                        }
                        return bareType + "_" + mname
                    }
                    // Fallback: obj_Method (simplified)
                    return tname + "_" + mname
                }
                // Chained call: o.GetInner().Doubled(). The inner
                // CALL's return type is the receiver of the outer call;
                // emit `RetType_Method`. Without this the fallback
                // appends `_Method` to the call expression string,
                // producing e.g. `Outer_GetInner(o)_Doubled` (invalid).
                if (lk == NodeKind.CALL) {
                    let retT = this.InferTypeFromExpr(callee.Left)
                    let bareR = String_Replace(retT, "*", "")
                    if (String_Length(bareR) > 0) {
                        // AmalgameList / Map / Set runtime helpers use
                        // camelCase first-letter (Add → add, Count →
                        // count, etc.), unlike user classes which keep
                        // PascalCase. Downcase mname's first letter for
                        // chained calls landing on a collection.
                        if (bareR == "AmalgameList" || bareR == "AmalgameMap" || bareR == "AmalgameSet") {
                            let first: string = String_Substring(mname, 0, 1)
                            let rest:  string = String_Substring(mname, 1, String_Length(mname) - 1)
                            return bareR + "_" + String_ToLower(first) + rest
                        }
                        return bareR + "_" + mname
                    }
                }
                // <call-chain>.Method(...) — receiver is a CALL whose
                // return type we can infer. Used by patterns like
                // `new X().M1().M2()` or `a.M1(x).M2(y)`. The
                // detection in the call-emission site already sets
                // isSelfCall + selfExpr; this branch resolves the
                // method symbol from the inferred receiver type.
                if (lk == NodeKind.CALL) {
                    let rt: string = this.InferTypeFromExpr(callee.Left)
                    let bare: string = String_Replace(rt, "*", "")
                    if (String_Length(bare) > 0) {
                        if (bare == "AmalgameList" || bare == "AmalgameMap" || bare == "AmalgameSet") {
                            let first: string = String_Substring(mname, 0, 1)
                            let rest:  string = String_Substring(mname, 1, String_Length(mname) - 1)
                            return bare + "_" + String_ToLower(first) + rest
                        }
                        return bare + "_" + mname
                    }
                }
                // new ClassName(...).Method(...) — receiver is a NEW_EXPR.
                // Resolve the method symbol from the class being
                // instantiated, same dispatch as a static call to
                // ClassName (external mangled / core stdlib / package
                // mangled / SymName fallback). Without this, the
                // fallback at the end of the function mashes the
                // method name into `new()`'s call string, producing
                // invalid C like `App_Widget_new("foo")_Class("bar")`.
                if (lk == NodeKind.NEW_EXPR) {
                    let tname: string = callee.Left.Name
                    let externalMangled: string = this.ExternalClassMangled(tname)
                    if (String_Length(externalMangled) > 0) {
                        return externalMangled + "_" + mname
                    }
                    let isCoreStdlib: bool = tname == "Console" || tname == "File" || tname == "String" || tname == "List" || tname == "Env" || tname == "Process" || tname == "Regex" || tname == "Compress" || tname == "WebSocket"
                    if (isCoreStdlib) {
                        return tname + "_" + mname
                    }
                    let mangledPrefix: string = this.PkgClassMangledPrefix(tname)
                    if (String_Length(mangledPrefix) > 0) {
                        return mangledPrefix + "_" + mname
                    }
                    return this.SymName(tname) + "_" + mname
                }
                // Chained-member call: this.Field.Method() or
                // varName.Field.Method(). Look up the inner-receiver
                // class's field type and emit `FieldType_Method` so the
                // call lands on the right struct's method.
                if (lk == NodeKind.MEMBER) {
                    if (callee.Left.Left != null) {
                        let llk = callee.Left.Left.Kind
                        if (llk == NodeKind.THIS_EXPR) {
                            let fname = callee.Left.Name
                            let ftype = this.FieldTypeGet(this.CurrentClass, fname)
                            let bare  = String_Replace(ftype, "*", "")
                            if (String_Length(bare) > 0) {
                                return bare + "_" + mname
                            }
                        }
                        if (llk == NodeKind.IDENTIFIER) {
                            // varName.Field.Method(): chain into the
                            // local's class to find Field's type, then
                            // emit `FieldType_Method`. Without this the
                            // fallback at the end of the function would
                            // mash the field name into the method name
                            // (`o->Field_Method` instead of
                            // `Inner_Method(o->Field)`), causing the
                            // chain-mash bug we're fixing.
                            let vname = callee.Left.Left.Name
                            let vtype = this.LocalTypeGet(vname)
                            let vbare = String_Replace(vtype, "*", "")
                            if (String_Length(vbare) > 0) {
                                let fname = callee.Left.Name
                                let ftype = this.FieldTypeGet(vbare, fname)
                                let fbare = String_Replace(ftype, "*", "")
                                if (String_Length(fbare) > 0) {
                                    return fbare + "_" + mname
                                }
                            }
                        }
                    }
                }
            }
            let target = this.EmitExprStr(callee.Left)
            return target + "_" + mname
        }
        return this.EmitExprStr(callee)
    }

    // ── Type mapping ──────────────────────────────────

    private bool IsEnum(string t) {
        let n = this.EnumNames.Count()
        for i in 0..n {
            let e = this.EnumNames.Get(i)
            if (e == t) { return true }
        }
        return false
    }

    // True for C types passed as a pointer at the ABI level: anything
    // ending in `*` plus `code_string` (typedef'd to `char*`). Used by
    // EmitOneLambda to decide whether to unbox a void* arg via a
    // direct cast or via intptr_t.
    private bool IsCPointerType(string ct) {
        if (ct == "code_string") { return true }
        if (String_EndsWith(ct, "*")) { return true }
        return false
    }

    // ── Box / unbox helpers ──────────────────────────
    //
    // The closure ABI passes everything as `void*` (see
    // runtime/_runtime.h). Box scalar expressions through
    // `intptr_t` to silence -Wint-to-pointer-cast on platforms where
    // sizeof(int) < sizeof(void*); unbox the same way coming back.
    // Pointer-typed values cast through `intptr_t` is wasteful but
    // valid in 64-bit (we don't currently 32-bit), so the same helper
    // covers both ABI shapes.
    //
    // These were duplicated across ~17 sites in CGen before being
    // extracted; the refactor aimed at readability, not behavior.

    // Box any expression to `void*` for the closure / collection ABI.
    private string BoxAsVoid(string expr) {
        return "(void*)(intptr_t)(" + expr + ")"
    }

    // Unbox a `void*` back to a scalar C type. Pointer types
    // (anything for which IsCPointerType is true) should use a direct
    // cast instead — the dedicated EmitOneLambdaBody path already
    // does so via that predicate.
    private string UnboxScalar(string ctype, string expr) {
        return "(" + ctype + ")(intptr_t)" + expr
    }

    private string TypeToC(string t) {
        if (t == "int")    { return "i64" }
        if (t == "float")  { return "double" }
        if (t == "bool")   { return "code_bool" }
        if (t == "string") { return "code_string" }
        if (t == "void")   { return "void" }
        if (t == "")       { return "void" }
        // First-class closure values. AM source spells the type as
        // `Closure`; it lowers to `AmalgameClosure*` (the runtime
        // type used everywhere else for lambdas — see _runtime.h).
        // Lets facade.am declare `(name: string, handler: Closure)`
        // without needing a per-package typedef shim.
        if (t == "Closure") { return "AmalgameClosure*" }
        // Array types: string[] → code_string*, int[] → i64*, etc.
        if (String_EndsWith(t, "[]")) {
            let inner = String_Substring(t, 0, String_Length(t) - 2)
            return this.TypeToC(inner) + "*"
        }
        if (String_EndsWith(t, "?")) {
            // The `?` is purely a typechecker concern (the pointer can be
            // NULL). All non-primitive Amalgame types lower to a C pointer
            // already, so `Box?` stays `Box*` rather than becoming `Box**`.
            // Primitives lose their nullability at the C level — accepted
            // limitation, matches the pre-`?`-token behaviour.
            let inner = String_Substring(t, 0, String_Length(t) - 1)
            return this.TypeToC(inner)
        }
        if (String_StartsWith(t, "List<")) {
            return "AmalgameList*"
        }
        if (String_StartsWith(t, "Map<")) {
            return "AmalgameMap*"
        }
        if (String_StartsWith(t, "Set<")) {
            return "AmalgameSet*"
        }
        if (t == "List") { return "AmalgameList*" }
        if (t == "Map")  { return "AmalgameMap*" }
        if (t == "Set")  { return "AmalgameSet*" }
        // Vec3 / Vec4 / Mat4 migrated to AM (post-v0.7.5); fall
        // through to the regular namespace-mangled lowering below.
        // FileWatcher migrated to AM (post-v0.7.5); same path.
        if (t == "Match") { return "AmalgameRegexMatch*" }
        if (t == "WebSocket") { return "AmalgameWebSocket*" }
        if (this.IsEnum(t)) {
            return this.SymName(t)
        }
        // Project F: external classes use their own ns-mangled name
        // so `let r: Random = …` lowers to `Amalgame_Random_Random* r`,
        // matching the typedef emitted by RegisterExternalProg + the
        // symbol exported by libamalgame.a.
        let externalMangled: string = this.ExternalClassMangled(t)
        if (String_Length(externalMangled) > 0) {
            return externalMangled + "*"
        }
        let sym = this.SymName(t)
        // Single uppercase letter = generic type parameter → use void*
        if (String_Length(t) == 1) {
            let fc = String_Substring(t, 0, 1)
            let isUp = fc == String_ToUpper(fc)
            if (isUp) { return "void*" }
        }
        if (this.IsEnum(sym)) {
            return sym
        }
        // Check if algebraic enum (tagged union) — value type, no pointer
        let algKey = "__alg__" + sym
        let en2 = this.EnumNames.Count()
        for ei2 in 0..en2 {
            if (this.EnumNames.Get(ei2) == algKey) { return sym }
        }
        return sym + "*"
    }
}
