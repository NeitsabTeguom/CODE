namespace Amalgame.Compiler

import Amalgame.Collections
import Amalgame.String

// ── C Code Emitter ────────────────────────────────────
public class Emitter {
    private Lines:    List<string>
    private Indent:   int
    private Streaming: bool   // write directly to file via File_StreamLine

    public Emitter() {
        this.Lines     = new List<string>()
        this.Indent    = 0
        this.Streaming = false
    }

    public void SetStreaming(bool v) { this.Streaming = v }

    public void Emit(string text) {
        if (this.Streaming) {
            File.StreamLine(text)
        } else {
            this.Lines.Add(text)
        }
    }

    public void EmitLine(string text) {
        var line = ""
        let i = this.Indent
        for k in 0..i {
            line = line + "    "
        }
        line = line + text
        if (this.Streaming) {
            File.StreamLine(line)
        } else {
            this.Lines.Add(line)
        }
    }

    public void EmitBlank() {
        if (this.Streaming) {
            File.StreamLine("")
        } else {
            this.Lines.Add("")
        }
    }

    public void Indent_() {
        this.Indent = this.Indent + 1
    }

    public void Dedent() {
        this.Indent = this.Indent - 1
    }

    public string GetOutput() {
        var result = ""
        let count = this.Lines.Count()
        for i in 0..count {
            let line = this.Lines.Get(i)
            result = result + line + "\n"
        }
        return result
    }
}

// ── C Generator ───────────────────────────────────────
public class CGen {
    public  Out:            Emitter
    private NsPrefix:       string
    // Type inference: two parallel lists — var name → C type
    private LocalTypeNames: List<string>
    private LocalTypeCType: List<string>
    // Current class being emitted (for this.Field list element type lookup)
    private CurrentClass:   string
    private CurrentRetType: string
    // Field types: two parallel lists — "ClassName.FieldName" → C type
    private FieldNames:     List<string>
    private FieldCTypes:    List<string>
    // List element types: "ClassName.FieldName" → element C type (for List<T> fields)
    private ListElemNames:  List<string>
    private ListElemCTypes: List<string>
    // Enum names registered at forward-decl time (to avoid TypeToC adding *)
    private EnumNames:      List<string>
    // Method return types: "ClassName_MethodName" → C return type
    private MethodRetNames: List<string>
    private MethodRetTypes: List<string>

    public CGen() {
        this.Out            = new Emitter()
        this.NsPrefix       = ""
        this.LocalTypeNames = new List<string>()
        this.LocalTypeCType = new List<string>()
        this.CurrentClass   = ""
        this.CurrentRetType = ""
        this.FieldNames     = new List<string>()
        this.FieldCTypes    = new List<string>()
        this.ListElemNames  = new List<string>()
        this.ListElemCTypes = new List<string>()
        this.EnumNames      = new List<string>()
        this.MethodRetNames = new List<string>()
        this.MethodRetTypes = new List<string>()
        // Pre-register stdlib struct fields
        this.FieldTypeSet("AmalgameHttpResponse", "Status", "i64")
        this.FieldTypeSet("AmalgameHttpResponse", "Body",   "code_string")
        this.FieldTypeSet("AmalgameHttpResponse", "Error",  "code_string")
        this.FieldTypeSet("AmalgameHttpResponse", "Ok",     "code_bool")
        this.FieldTypeSet("AmalgameTcpConn",      "RemoteIp", "code_string")
        this.FieldTypeSet("AmalgameTcpConn",      "Fd",       "i64")
        this.FieldTypeSet("AmalgameTcpServer",    "Fd",       "i64")
        this.FieldTypeSet("AmalgameTcpServer",    "Port",     "i64")
    }

    public string Generate(AstNode prog) {
        let ns = prog.Str
        if (String_Length(ns) > 0) {
            this.NsPrefix = String_Replace(ns, ".", "_")
        }
        this.EmitHeader()
        let decls = prog.Children.Count()
        for i in 0..decls {
            let decl = prog.Children.Get(i)
            this.EmitForwardDecl(decl)
        }
        this.Out.EmitBlank()
        for j in 0..decls {
            let decl = prog.Children.Get(j)
            this.EmitDecl(decl)
        }
        return this.Out.GetOutput()
    }

    // Multi-file support: call BeginMulti() once, then AddFile() per file, then FinishMulti()
    public void SetStreaming(bool v) {
        this.Out.SetStreaming(v)
    }

    public void BeginMulti(string ns) {
        if (String_Length(ns) > 0) {
            this.NsPrefix = String_Replace(ns, ".", "_")
        }
        this.EmitHeader()
    }

    public void AddFilePass1(AstNode prog) {
        let decls = prog.Children.Count()
        for i in 0..decls {
            let decl = prog.Children.Get(i)
            this.EmitForwardDecl(decl)
        }
    }

    public void EmitSeparator() {
        this.Out.EmitBlank()
    }

    public void AddFilePass2(AstNode prog) {
        let decls = prog.Children.Count()
        for j in 0..decls {
            let decl = prog.Children.Get(j)
            this.EmitDecl(decl)
        }
    }

    public string FinishMulti() {
        return this.Out.GetOutput()
    }

    public List<string> GetLines() {
        return this.Out.Lines
    }

    private string SymName(string name) {
        let ns = this.NsPrefix
        if (String_Length(ns) > 0) {
            return ns + "_" + name
        }
        return name
    }

    // ── Local type table ──────────────────────────────
    // Since Amalgame has no Map<string,string> in bootstrap,
    // we use two parallel lists as a poor-man's dictionary.

    private void LocalTypeSet(string varName, string ctype) {
        let n = this.LocalTypeNames.Count()
        for i in 0..n {
            let k = this.LocalTypeNames.Get(i)
            if (k == varName) {
                // update in place — replace by removing and re-adding at same index is not possible,
                // so we overwrite using the Add trick: mark old as "" then add new pair
                // Simplest: just append — lookup finds the last match
                this.LocalTypeNames.Add(varName)
                this.LocalTypeCType.Add(ctype)
                return
            }
        }
        this.LocalTypeNames.Add(varName)
        this.LocalTypeCType.Add(ctype)
    }

    private string LocalTypeGet(string varName) {
        // Search from end so later writes shadow earlier ones
        let n = this.LocalTypeNames.Count()
        var result = ""
        for i in 0..n {
            let k = this.LocalTypeNames.Get(i)
            if (k == varName) {
                result = this.LocalTypeCType.Get(i)
            }
        }
        return result
    }

    private void LocalTypeClear() {
        this.LocalTypeNames = new List<string>()
        this.LocalTypeCType = new List<string>()
    }

    private void FieldTypeSet(string className, string fieldName, string ctype) {
        let key = className + "." + fieldName
        this.FieldNames.Add(key)
        this.FieldCTypes.Add(ctype)
    }

    private string FieldTypeGet(string className, string fieldName) {
        let key = className + "." + fieldName
        let n = this.FieldNames.Count()
        var result = ""
        for i in 0..n {
            let k = this.FieldNames.Get(i)
            if (k == key) {
                result = this.FieldCTypes.Get(i)
            }
        }
        return result
    }

    private void ListElemSet(string className, string fieldName, string elemCType) {
        let key = className + "." + fieldName
        this.ListElemNames.Add(key)
        this.ListElemCTypes.Add(elemCType)
    }

    private string ListElemGet(string className, string fieldName) {
        let key = className + "." + fieldName
        let n = this.ListElemNames.Count()
        var result = ""
        for i in 0..n {
            let k = this.ListElemNames.Get(i)
            if (k == key) {
                result = this.ListElemCTypes.Get(i)
            }
        }
        return result
    }

    private void MethodRetSet(string className, string methodName, string ctype) {
        let key = className + "::" + methodName
        this.MethodRetNames.Add(key)
        this.MethodRetTypes.Add(ctype)
    }

    private string MethodRetGet(string className, string methodName) {
        let key = className + "::" + methodName
        let n = this.MethodRetNames.Count()
        var result = ""
        for i in 0..n {
            let k = this.MethodRetNames.Get(i)
            if (k == key) {
                result = this.MethodRetTypes.Get(i)
            }
        }
        return result
    }

    // ── Infer C type from RHS expression ─────────────
    private string InferTypeFromExpr(AstNode expr) {
        if (expr == null) { return "" }
        let k = expr.Kind
        if (k == NodeKind.LIST_COMP)      { return "AmalgameList*" }
        // match-as-expression: type is the type of the first arm body.
        // (All arms must agree at runtime; we trust the first as a hint.)
        if (k == NodeKind.IF_STMT && expr.Name == "__match__") {
            if (expr.Children.Count() > 0) {
                let firstArm: AstNode = expr.Children.Get(0)
                if (firstArm.Right != null) {
                    return this.InferTypeFromExpr(firstArm.Right)
                }
            }
            return ""
        }
        // if-as-expression: the type is the type of the then-branch.
        // The body is a BLOCK whose last child is the result expression.
        if (k == NodeKind.IF_STMT) {
            if (expr.Body != null) {
                let body: AstNode = expr.Body
                if (body.Kind == NodeKind.BLOCK && body.Children.Count() > 0) {
                    let last: AstNode = body.Children.Get(body.Children.Count() - 1)
                    return this.InferTypeFromExpr(last)
                }
                return this.InferTypeFromExpr(body)
            }
            return ""
        }
        if (k == NodeKind.LITERAL_INT)    { return "i64" }
        if (k == NodeKind.LITERAL_FLOAT)  { return "double" }
        if (k == NodeKind.LITERAL_STRING) { return "code_string" }
        if (k == NodeKind.LITERAL_BOOL)   { return "code_bool" }
        if (k == NodeKind.BINARY) {
            let bop = expr.Str
            let isCmpOp = (bop == "&&" || bop == "||" || bop == "==" || bop == "!=")
            let isRelOp = (bop == "<" || bop == ">" || bop == "<=" || bop == ">=")
            if (isCmpOp || isRelOp) {
                return "code_bool"
            }
            // Arithmetic: propagate numeric/string types
            if (bop == "+" || bop == "-" || bop == "*" || bop == "/" || bop == "%") {
                let lt = this.InferTypeFromExpr(expr.Left)
                let rt = this.InferTypeFromExpr(expr.Right)
                if (lt == "code_string" || rt == "code_string") { return "code_string" }
                if (expr.Left != null) {
                    if (expr.Left.Kind == NodeKind.LITERAL_STRING) { return "code_string" }
                    if (expr.Left.Kind == NodeKind.LITERAL_INT)    { return "i64" }
                }
                if (expr.Right != null) {
                    if (expr.Right.Kind == NodeKind.LITERAL_STRING) { return "code_string" }
                    if (expr.Right.Kind == NodeKind.LITERAL_INT)    { return "i64" }
                }
                if (lt == "i64" || rt == "i64") { return "i64" }
                if (lt == "double" || rt == "double") { return "double" }
            }
        }
        if (k == NodeKind.UNARY) {
            if (expr.Str == "!") { return "code_bool" }
        }
        if (k == NodeKind.IDENTIFIER) {
            // Could be a local var — look it up
            return this.LocalTypeGet(expr.Name)
        }
        if (k == NodeKind.MEMBER) {
            // this.Field → look up field type
            if (expr.Left != null) {
                let lk = expr.Left.Kind
                if (lk == NodeKind.THIS_EXPR) {
                    return this.FieldTypeGet(this.CurrentClass, expr.Name)
                }
                if (lk == NodeKind.IDENTIFIER) {
                    let lname = expr.Left.Name
                    let varCType = this.LocalTypeGet(lname)
                    let bare = String_Replace(varCType, "*", "")
                    if (String_Length(bare) > 0) {
                        return this.FieldTypeGet(bare, expr.Name)
                    }
                    // Not a local var — check if it's an enum type (Direction.North → Tests_Direction)
                    let symT = this.SymName(lname)
                    if (this.IsEnum(symT)) { return symT }
                    if (this.IsEnum(lname)) { return this.SymName(lname) }
                }
                // CALL.Field — e.g. this.Current().Value → infer type from call return
                if (lk == NodeKind.CALL) {
                    let callRetT = this.InferTypeFromExpr(expr.Left)
                    let bareCall = String_Replace(callRetT, "*", "")
                    if (String_Length(bareCall) > 0) {
                        let ft = this.FieldTypeGet(bareCall, expr.Name)
                        if (String_Length(ft) > 0) { return ft }
                    }
                }
                // MEMBER.Field — limit to avoid deep recursion / stack overflow
                // handles: this.Field.Prop, var.Field.Prop, var.Field.Field.Prop
                if (lk == NodeKind.MEMBER) {
                    if (expr.Left.Left != null) {
                        let llk2 = expr.Left.Left.Kind
                        if (llk2 == NodeKind.THIS_EXPR) {
                            let fname2 = expr.Left.Name
                            let parentT = this.FieldTypeGet(this.CurrentClass, fname2)
                            let bareP = String_Replace(parentT, "*", "")
                            if (String_Length(bareP) > 0) {
                                let ft2 = this.FieldTypeGet(bareP, expr.Name)
                                if (String_Length(ft2) > 0) { return ft2 }
                            }
                        }
                        if (llk2 == NodeKind.IDENTIFIER) {
                            let vname3 = expr.Left.Left.Name
                            let vtype3 = this.LocalTypeGet(vname3)
                            let bareV  = String_Replace(vtype3, "*", "")
                            if (String_Length(bareV) > 0) {
                                let fname3   = expr.Left.Name
                                let parentT3 = this.FieldTypeGet(bareV, fname3)
                                let bareP3   = String_Replace(parentT3, "*", "")
                                if (String_Length(bareP3) > 0) {
                                    let ft3 = this.FieldTypeGet(bareP3, expr.Name)
                                    if (String_Length(ft3) > 0) { return ft3 }
                                }
                            }
                        }
                        // var.Field.Field.Prop — 3-level chain
                        if (llk2 == NodeKind.MEMBER) {
                            if (expr.Left.Left.Left != null) {
                                let lll = expr.Left.Left.Left
                                if (lll.Kind == NodeKind.IDENTIFIER) {
                                    let vn4   = lll.Name
                                    let vt4   = this.LocalTypeGet(vn4)
                                    let bare4 = String_Replace(vt4, "*", "")
                                    if (String_Length(bare4) > 0) {
                                        let fn4   = expr.Left.Left.Name
                                        let pt4   = this.FieldTypeGet(bare4, fn4)
                                        let bp4   = String_Replace(pt4, "*", "")
                                        if (String_Length(bp4) > 0) {
                                            let fn5 = expr.Left.Name
                                            let pt5 = this.FieldTypeGet(bp4, fn5)
                                            let bp5 = String_Replace(pt5, "*", "")
                                            if (String_Length(bp5) > 0) {
                                                let ft5 = this.FieldTypeGet(bp5, expr.Name)
                                                if (String_Length(ft5) > 0) { return ft5 }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            return ""
        }
        if (k == NodeKind.NEW_EXPR) {
            let tname = expr.Name
            if (String_StartsWith(tname, "List<") || tname == "List") { return "AmalgameList*" }
            if (String_StartsWith(tname, "Map<")  || tname == "Map")  { return "AmalgameMap*" }
            if (String_StartsWith(tname, "Set<")  || tname == "Set")  { return "AmalgameSet*" }
            if (this.IsEnum(tname)) { return this.SymName(tname) }
            return this.SymName(tname) + "*"
        }
        // method call returning a known type — check callee
        if (k == NodeKind.CALL) {
            if (expr.Left != null) {
                let calleeStr = this.EmitCalleeStr(expr.Left)
                if (calleeStr == "AmalgameMap_has" || calleeStr == "AmalgameMap_remove" || calleeStr == "AmalgameSet_contains" || calleeStr == "AmalgameSet_remove" || calleeStr == "AmalgameSet_add") { return "code_bool" }
                if (calleeStr == "AmalgameMap_size" || calleeStr == "AmalgameSet_size") { return "i64" }
                if (calleeStr == "AmalgameList_isEmpty" || calleeStr == "AmalgameList_remove") { return "code_bool" }
                // Algebraic enum constructors: Shape.Circle(5) → Amalgame_Shape
                // Detect if calleeStr matches a registered algebraic enum constructor
                let algPrefix = "__alg__"
                let enCount2  = this.EnumNames.Count()
                for eni in 0..enCount2 {
                    let ename = this.EnumNames.Get(eni)
                    if (String_StartsWith(ename, algPrefix)) {
                        let enumType = String_Substring(ename, String_Length(algPrefix), String_Length(ename) - String_Length(algPrefix))
                        if (String_StartsWith(calleeStr, enumType + "_")) {
                            return enumType
                        }
                    }
                }
                // Known return types for stdlib functions
                // First check if callee is a lambda macro - infer i64 as default
                if (expr.Left != null && expr.Left.Kind == NodeKind.IDENTIFIER) {
                    let calleeLocalType = this.LocalTypeGet(expr.Left.Name)
                    if (calleeLocalType == "__macro__") { return "i64" }
                }
                if (calleeStr == "String_Length" || calleeStr == "String_IndexOf" || calleeStr == "String_LastIndexOf" || calleeStr == "String_ToInt") { return "i64" }
                if (calleeStr == "String_ToFloat") { return "double" }
                if (calleeStr == "String_ToBool") { return "code_bool" }
                if (calleeStr == "String_Contains" || calleeStr == "String_StartsWith" || calleeStr == "String_EndsWith" || calleeStr == "String_IsEmpty") { return "code_bool" }
                if (String_StartsWith(calleeStr, "String_")) { return "code_string" }
                // Process args + exit code (runtime globals)
                if (calleeStr == "Args_Count" || calleeStr == "Exit_Get") { return "i64" }
                if (calleeStr == "Args_Get") { return "code_string" }
                if (calleeStr == "Exit_Set") { return "void" }
                if (String_EndsWith(calleeStr, "_CharAt")) { return "code_string" }
                if (calleeStr == "code_string_concat") { return "code_string" }
                if (calleeStr == "AmalgameList_count") { return "i64" }
                if (String_StartsWith(calleeStr, "AmalgameList_count")) { return "i64" }
                // File stdlib return types
                if (calleeStr == "File_Exists" || calleeStr == "File_WriteAll" || calleeStr == "File_AppendAll" || calleeStr == "File_Delete") { return "code_bool" }
                if (calleeStr == "File_WriteLines" || calleeStr == "File_OpenWrite" || calleeStr == "File_StreamLine" || calleeStr == "File_CloseWrite") { return "void" }
                if (calleeStr == "File_WriteLines") { return "void" }
                if (calleeStr == "File_ReadAll" || calleeStr == "File_ReadLine") { return "code_string" }
                if (calleeStr == "File_Size") { return "i64" }
                // Path stdlib return types
                if (calleeStr == "Path_Combine" || calleeStr == "Path_GetExtension" || calleeStr == "Path_GetFilename" || calleeStr == "Path_GetDirectory") { return "code_string" }
                // Net stdlib return types
                if (calleeStr == "Http_Get" || calleeStr == "Http_Post" || calleeStr == "Http_GetWithHeaders" || calleeStr == "Http_GetTimeout" || calleeStr == "Http_PostJson") { return "AmalgameHttpResponse*" }
                if (calleeStr == "TcpServer_Listen") { return "AmalgameTcpServer*" }
                if (calleeStr == "TcpServer_Accept") { return "AmalgameTcpConn*" }
                if (calleeStr == "TcpServer_IsListening" || calleeStr == "TcpConn_Send" || calleeStr == "TcpConn_Close" || calleeStr == "TcpServer_Stop") { return "code_bool" }
                if (calleeStr == "TcpConn_Receive") { return "code_string" }
                // Math stdlib return types
                if (calleeStr == "Math_Sqrt" || calleeStr == "Math_Abs" || calleeStr == "Math_Floor" || calleeStr == "Math_Ceil" || calleeStr == "Math_Round" || calleeStr == "Math_Pow" || calleeStr == "Math_Log") { return "double" }
                if (calleeStr == "Math_Max" || calleeStr == "Math_Min") { return "i64" }
                if (calleeStr == "Math_IsPrime" || calleeStr == "Math_IsNaN" || calleeStr == "Math_IsInf" || calleeStr == "Math_IsFinite" || calleeStr == "Math_ApproxEq") { return "code_bool" }
                if (calleeStr == "Math_Random") { return "double" }
                if (calleeStr == "Math_RandomInt" || calleeStr == "Math_AbsI" || calleeStr == "Math_PowI" || calleeStr == "Math_Gcd" || calleeStr == "Math_Lcm" || calleeStr == "Math_Clamp" || calleeStr == "Math_MaxI" || calleeStr == "Math_MinI" || calleeStr == "Math_ClampI") { return "i64" }
                if (calleeStr == "Math_SeedRandom") { return "void" }
                if (expr.Left.Kind == NodeKind.MEMBER) {
                    let mname2 = expr.Left.Name
                    // Collection method return types based on method name
                    if (mname2 == "Count" || mname2 == "Size") { return "i64" }
                    if (mname2 == "Clear") { return "void" }
                    if (mname2 == "Reserve") { return "void" }
                    if (mname2 == "IsEmpty" || mname2 == "Has" || mname2 == "Contains" || mname2 == "Remove" || mname2 == "Add") {
                        // Check object type to determine correct return
                        if (expr.Left.Left != null && expr.Left.Left.Kind == NodeKind.IDENTIFIER) {
                            let objN = expr.Left.Left.Name
                            let objT = this.LocalTypeGet(objN)
                            if (objT == "AmalgameList*" && mname2 == "IsEmpty") { return "code_bool" }
                            if (objT == "AmalgameList*" && mname2 == "Remove") { return "code_bool" }
                            if (objT == "AmalgameMap*" && (mname2 == "Has" || mname2 == "Remove")) { return "code_bool" }
                            if (objT == "AmalgameSet*" && (mname2 == "Contains" || mname2 == "Remove" || mname2 == "Add")) { return "code_bool" }
                        }
                    }
                    if (mname2 == "Get") {
                        // Try to find element type from list field
                        if (expr.Left.Left != null) {
                            let ll = expr.Left.Left
                            if (ll.Kind == NodeKind.THIS_EXPR) {
                                // this.Field.Get(i) — can't determine field name here easily
                                // Fall through to void*
                            }
                            if (ll.Kind == NodeKind.MEMBER) {
                                if (ll.Left != null) {
                                    if (ll.Left.Kind == NodeKind.THIS_EXPR) {
                                        let fn3 = ll.Name
                                        let et = this.ListElemGet(this.CurrentClass, fn3)
                                        if (String_Length(et) > 0) { return et }
                                    }
                                }
                            }
                            if (ll.Kind == NodeKind.IDENTIFIER) {
                                let vn3   = ll.Name
                                let vtype = this.LocalTypeGet(vn3)
                                let bare3 = String_Replace(vtype, "*", "")
                                // Check local list elem type — not yet tracked per variable
                                // Return void* as fallback
                            }
                        }
                        return "void*"
                    }
                    if (expr.Left.Left != null) {
                        let llk2 = expr.Left.Left.Kind
                        // this.Method() → look up in MethodRetTypes using CurrentClass
                        if (llk2 == NodeKind.THIS_EXPR) {
                            let retT = this.MethodRetGet(this.CurrentClass, mname2)
                            if (String_Length(retT) > 0) { return retT }
                        }
                        // ClassName.Method() → static call, look up SymName(ClassName)
                        if (llk2 == NodeKind.IDENTIFIER) {
                            let cname2 = expr.Left.Left.Name
                            let firstC = String_Substring(cname2, 0, 1)
                            let isUpp  = firstC == String_ToUpper(firstC)
                            if (isUpp) {
                                let symCls = this.SymName(cname2)
                                let retT2  = this.MethodRetGet(symCls, mname2)
                                if (String_Length(retT2) > 0) { return retT2 }
                            }
                            // Instance method call: obj.Method() → look up via obj's type
                            if (!isUpp) {
                                let objType = this.LocalTypeGet(cname2)
                                let bareCls = String_Replace(objType, "*", "")
                                if (String_Length(bareCls) > 0) {
                                    let retT3 = this.MethodRetGet(bareCls, mname2)
                                    if (String_Length(retT3) > 0) { return retT3 }
                                }
                            }
                        }
                    }
                }
            }
        }
        return ""
    }

    // Re-escape a string value (which may contain real newlines, tabs, quotes)
    // into valid C string literal content.
    // Emit a string literal, expanding {varName} interpolations
    // Only applies to valid {identifier} patterns — not C braces like "{" or "} else {"
    private string EmitInterpolatedString(string raw) {
        let hasInterp = String_IndexOf(raw, "{")
        if (hasInterp < 0) {
            let escaped = this.EscapeStringForC(raw)
            return "\"" + escaped + "\""
        }
        let len = String_Length(raw)
        // Check for at least one valid {identifier} pattern
        var hasValid = false
        var ci = 0
        while (ci < len) {
            let cch = String_Substring(raw, ci, 1)
            if (cch == "{") {
                let rest = String_Substring(raw, ci + 1, len - ci - 1)
                let close = String_IndexOf(rest, "}")
                if (close > 0) {
                    let inner = String_Substring(raw, ci + 1, close)
                    let fc = String_Substring(inner, 0, 1)
                    // Valid if starts with a letter or "this."
                    let isAlpha = String_Contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ", fc)
                    if (isAlpha || String_StartsWith(inner, "this.")) {
                        hasValid = true
                        ci = len
                    } else {
                        ci = ci + 1
                    }
                } else {
                    ci = ci + 1
                }
            } else {
                ci = ci + 1
            }
        }
        if (!hasValid) {
            let escaped = this.EscapeStringForC(raw)
            return "\"" + escaped + "\""
        }
        // Build interpolated expression
        var result = "\"\""
        var i = 0
        var segStart = 0
        while (i < len) {
            let ch = String_Substring(raw, i, 1)
            if (ch == "{") {
                let rest2 = String_Substring(raw, i + 1, len - i - 1)
                let close2 = String_IndexOf(rest2, "}")
                if (close2 > 0) {
                    let expr = String_Substring(raw, i + 1, close2)
                    let fc2 = String_Substring(expr, 0, 1)
                    let isId = String_Contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ", fc2)
                    if (isId || String_StartsWith(expr, "this.")) {
                        if (i > segStart) {
                            let seg = String_Substring(raw, segStart, i - segStart)
                            let esc = this.EscapeStringForC(seg)
                            result = "code_string_concat(" + result + ", \"" + esc + "\")"
                        }
                        let cExpr = this.InterpExprToC(expr)
                        result = "code_string_concat(" + result + ", " + cExpr + ")"
                        segStart = i + 1 + close2 + 1
                        i = segStart
                    } else {
                        i = i + 1
                    }
                } else {
                    i = i + 1
                }
            } else {
                i = i + 1
            }
        }
        if (segStart < len) {
            let seg = String_Substring(raw, segStart, len - segStart)
            let esc = this.EscapeStringForC(seg)
            result = "code_string_concat(" + result + ", \"" + esc + "\")"
        }
        return result
    }

    // Wrap a C expression in the right ToString conversion based on its
    // C return type. Used by the interpolation handler below.
    private string WrapForInterp(string cExpr, string cType) {
        if (cType == "code_string") { return "(" + cExpr + " ? " + cExpr + " : \"\")" }
        if (cType == "i64")         { return "String_FromInt(" + cExpr + ")" }
        if (cType == "double")      { return "String_FromFloat(" + cExpr + ")" }
        if (cType == "code_bool")   { return "((" + cExpr + ") ? \"true\" : \"false\")" }
        // Fallback — assume int for unknown / void
        return "String_FromInt((i64)(" + cExpr + "))"
    }

    // Best-effort C return type for a stdlib-style call name (e.g. "String_Length").
    // Returns "" when unknown so the caller can pick a fallback.
    private string BuiltinCallReturnType(string cName) {
        if (cName == "String_Length" || cName == "String_IndexOf" || cName == "String_LastIndexOf" || cName == "String_ToInt") { return "i64" }
        if (cName == "String_ToFloat") { return "double" }
        if (cName == "String_IsEmpty" || cName == "String_Contains" || cName == "String_StartsWith" || cName == "String_EndsWith" || cName == "String_ToBool") { return "code_bool" }
        if (String_StartsWith(cName, "String_")) { return "code_string" }
        if (cName == "Math_Sqrt" || cName == "Math_Abs" || cName == "Math_Pow" || cName == "Math_Floor" || cName == "Math_Ceil" || cName == "Math_Round" || cName == "Math_Random") { return "double" }
        if (cName == "Math_AbsI" || cName == "Math_PowI" || cName == "Math_RandomInt" || cName == "Math_Gcd" || cName == "Math_MaxI" || cName == "Math_MinI" || cName == "Math_ClampI") { return "i64" }
        if (cName == "Math_IsPrime" || cName == "Math_IsNaN" || cName == "Math_IsFinite") { return "code_bool" }
        if (cName == "File_ReadAll") { return "code_string" }
        if (cName == "File_Exists" || cName == "File_WriteAll" || cName == "File_AppendAll" || cName == "File_Delete") { return "code_bool" }
        if (cName == "File_Size" || cName == "Args_Count" || cName == "Exit_Get") { return "i64" }
        if (cName == "Args_Get") { return "code_string" }
        return ""
    }

    // Convert a simple interpolation expression to a C string expression
    private string InterpExprToC(string expr) {
        // Method/function call: "Class.Method(args)" or "func(args)".
        // Convert dot-separated qualifiers to underscore (C name scheme),
        // then pick a ToString wrapper from the inferred return type.
        let parenIdx = String_IndexOf(expr, "(")
        if (parenIdx > 0) {
            let callee = String_Substring(expr, 0, parenIdx)
            let rest   = String_Substring(expr, parenIdx, String_Length(expr) - parenIdx)
            let cCallee = String_Replace(callee, ".", "_")
            let cCall  = cCallee + rest
            let retT   = this.BuiltinCallReturnType(cCallee)
            if (String_Length(retT) > 0) {
                return this.WrapForInterp(cCall, retT)
            }
            // Unknown callee → assume string (most user methods returning text).
            return "(" + cCall + " ? " + cCall + " : \"\")"
        }
        // this.Field → self->Field
        if (String_StartsWith(expr, "this.")) {
            let field = String_Substring(expr, 5, String_Length(expr) - 5)
            let ft = this.FieldTypeGet(this.CurrentClass, field)
            if (ft == "i64") { return "String_FromInt(self->" + field + ")" }
            if (ft == "double") { return "String_FromFloat(self->" + field + ")" }
            if (ft == "code_bool") { return "((self->" + field + ") ? \"true\" : \"false\")" }
            if (ft == "code_string") { return "(self->" + field + " ? self->" + field + " : \"\")" }
            // Enum or other non-pointer type → treat as integer
            if (String_Length(ft) > 0 && !String_Contains(ft, "*")) { return "String_FromInt((i64)self->" + field + ")" }
            return "(self->" + field + " ? self->" + field + " : \"\")"
        }
        // obj.field → obj->field (obj is a pointer variable)
        let dotIdx = String_IndexOf(expr, ".")
        if (dotIdx > 0) {
            let objName = String_Substring(expr, 0, dotIdx)
            let field2  = String_Substring(expr, dotIdx + 1, String_Length(expr) - dotIdx - 1)
            let objType = this.LocalTypeGet(objName)
            let bareT   = String_Replace(objType, "*", "")
            if (String_Length(bareT) > 0) {
                let ft2 = this.FieldTypeGet(bareT, field2)
                if (ft2 == "i64") { return "String_FromInt(" + objName + "->" + field2 + ")" }
                if (ft2 == "double") { return "String_FromFloat(" + objName + "->" + field2 + ")" }
                if (ft2 == "code_bool") { return "((" + objName + "->" + field2 + ") ? \"true\" : \"false\")" }
                if (ft2 == "code_string") { return "(" + objName + "->" + field2 + " ? " + objName + "->" + field2 + " : \"\")" }
                // Enum or other non-pointer type → treat as integer
                if (String_Length(ft2) > 0 && !String_Contains(ft2, "*")) { return "String_FromInt((i64)" + objName + "->" + field2 + ")" }
                return "(" + objName + "->" + field2 + " ? " + objName + "->" + field2 + " : \"\")"
            }
        }
        // Simple variable
        let varC = this.LocalTypeGet(expr)
        if (varC == "i64") { return "String_FromInt(" + expr + ")" }
        if (varC == "double") { return "String_FromFloat(" + expr + ")" }
        if (varC == "code_bool") { return "(" + expr + " ? \"true\" : \"false\")" }
        if (String_Length(varC) > 0) {
            return "(" + expr + " ? " + expr + " : \"\")"
        }
        // Fallback: treat as int
        return "String_FromInt(" + expr + ")"
    }

    private string EscapeStringForC(string raw) {
        // The Amalgame lexer converts escape sequences to real bytes.
        // We must reverse that for C string literal emission.
        // Order matters: escape backslash first to avoid double-escaping.
        var s = String_Replace(raw, "\\", "\\\\")
        s = String_Replace(s, "\"", "\\\"")
        s = String_Replace(s, "\n", "\\n")
        s = String_Replace(s, "\t", "\\t")
        s = String_Replace(s, "\r", "\\r")
        // ESC character (0x1B) used in ANSI color codes
        s = String_Replace(s, "\x1b", "\\x1b")
        return s
    }

    private void EmitHeader() {
        this.Out.EmitLine("#include <stdio.h>")
        this.Out.EmitLine("#include <stdlib.h>")
        this.Out.EmitLine("#include <string.h>")
        this.Out.EmitLine("#include \"_runtime.h\"")
        this.Out.EmitLine("#include \"Amalgame_String.h\"")
        this.Out.EmitLine("#include \"Amalgame_Collections.h\"")
        this.Out.EmitLine("#include \"Amalgame_IO.h\"")
        this.Out.EmitLine("#include \"Amalgame_Math.h\"")
        this.Out.EmitLine("#include \"Amalgame_Net.h\"")
        this.Out.EmitLine("#include \"Amalgame_Console.h\"")
        this.Out.EmitBlank()
    }

    public void EmitNetHeader() {
        this.Out.EmitLine("#include \"Amalgame_Net.h\"")
    }

    private void EmitForwardDecl(AstNode decl) {
        let k = decl.Kind
        if (k == NodeKind.ENUM_DECL) {
            let name = this.SymName(decl.Name)
            // Check if algebraic enum
            var isAlg = false
            let vc = decl.Children.Count()
            for vi in 0..vc {
                let vm = decl.Children.Get(vi)
                if (String_Length(vm.Str) > 0) { isAlg = true }
            }
            if (isAlg) {
                // Register as algebraic enum (value type, not pointer)
                this.EnumNames.Add("__alg__" + name)
                // Emit forward declaration as opaque struct
                this.Out.EmitLine("typedef struct _" + name + " " + name + "; /* alg-enum fwd */")
            } else {
                // Register as simple enum so TypeToC won't add * for this type
                this.EnumNames.Add(decl.Name)
                this.EnumNames.Add(name)
                this.Out.EmitLine("typedef enum _" + name + " " + name + ";")
            }
        }
        if (k == NodeKind.CLASS_DECL) {
            let name = this.SymName(decl.Name)
            this.Out.EmitLine("typedef struct _" + name + " " + name + ";")
        }
    }

    private void EmitDecl(AstNode decl) {
        let k = decl.Kind
        if (k == NodeKind.ENUM_DECL) { this.EmitEnum(decl) }
        if (k == NodeKind.CLASS_DECL) { this.EmitClass(decl) }
    }

    private void EmitEnum(AstNode en) {
        let name  = this.SymName(en.Name)
        let count = en.Children.Count()

        // Check if this is an algebraic enum (any variant has payload types)
        var isAlgebraic = false
        for i in 0..count {
            let member = en.Children.Get(i)
            if (String_Length(member.Str) > 0) { isAlgebraic = true }
        }

        if (isAlgebraic) {
            // Emit as tagged union
            // 1. Tag enum
            this.Out.EmitLine("typedef enum {")
            this.Out.Indent_()
            for i in 0..count {
                let member = en.Children.Get(i)
                let mname  = name + "_TAG_" + member.Name
                if (i < count - 1) {
                    this.Out.EmitLine(mname + ",")
                } else {
                    this.Out.EmitLine(mname)
                }
            }
            this.Out.Dedent()
            this.Out.EmitLine("} " + name + "_Tag;")
            this.Out.EmitBlank()

            // 2. Union struct
            this.Out.EmitLine("struct _" + name + " {")
            this.Out.Indent_()
            this.Out.EmitLine(name + "_Tag tag;")
            this.Out.EmitLine("union {")
            this.Out.Indent_()
            for i in 0..count {
                let member = en.Children.Get(i)
                let payloads = member.Str
                if (String_Length(payloads) > 0) {
                    this.Out.EmitLine("struct {")
                    this.Out.Indent_()
                    // Split payload types by comma
                    var pi = 0
                    var pcur = ""
                    var pci  = 0
                    let plen = String_Length(payloads)
                    while (pci <= plen) {
                        var pch = ""
                        if (pci < plen) { pch = String_Substring(payloads, pci, 1) }
                        if (pch == "," || pci == plen) {
                            if (String_Length(pcur) > 0) {
                                this.Out.EmitLine(this.TypeToC(pcur) + " _" + String_FromInt(pi) + ";")
                                pi = pi + 1
                                pcur = ""
                            }
                        } else { pcur = pcur + pch }
                        pci = pci + 1
                    }
                    this.Out.Dedent()
                    this.Out.EmitLine("} " + member.Name + ";")
                } else {
                    this.Out.EmitLine("int " + member.Name + "_dummy;")
                }
            }
            this.Out.Dedent()
            this.Out.EmitLine("};")
            this.Out.Dedent()
            this.Out.EmitLine("};")
            this.Out.EmitBlank()

            // 3. Constructor functions
            for i in 0..count {
                let member = en.Children.Get(i)
                let payloads = member.Str
                var params = ""
                var fields = ""
                if (String_Length(payloads) > 0) {
                    var pi2 = 0
                    var pcur2 = ""
                    var pci2  = 0
                    let plen2 = String_Length(payloads)
                    while (pci2 <= plen2) {
                        var pch2 = ""
                        if (pci2 < plen2) { pch2 = String_Substring(payloads, pci2, 1) }
                        if (pch2 == "," || pci2 == plen2) {
                            if (String_Length(pcur2) > 0) {
                                let ct = this.TypeToC(pcur2)
                                let pname = "_" + String_FromInt(pi2)
                                if (pi2 > 0) { params = params + ", " fields = fields + ", " }
                                params = params + ct + " " + pname
                                fields = fields + pname
                                pi2 = pi2 + 1
                                pcur2 = ""
                            }
                        } else { pcur2 = pcur2 + pch2 }
                        pci2 = pci2 + 1
                    }
                }
                let ctorSig = "static inline " + name + " " + name + "_" + member.Name + "(" + params + ")"
                this.Out.EmitLine(ctorSig + " {")
                this.Out.Indent_()
                this.Out.EmitLine(name + " __v;")
                this.Out.EmitLine("__v.tag = " + name + "_TAG_" + member.Name + ";")
                if (String_Length(fields) > 0) {
                    // Set fields
                    var pi3 = 0
                    var pcur3 = ""
                    var pci3  = 0
                    let payloads3 = member.Str
                    let plen3 = String_Length(payloads3)
                    while (pci3 <= plen3) {
                        var pch3 = ""
                        if (pci3 < plen3) { pch3 = String_Substring(payloads3, pci3, 1) }
                        if (pch3 == "," || pci3 == plen3) {
                            if (pi3 >= 0) {
                                let fidx = String_FromInt(pi3)
                                this.Out.EmitLine("__v." + member.Name + "._" + fidx + " = _" + fidx + ";")
                                pi3 = pi3 + 1
                            }
                            pcur3 = ""
                        } else { pcur3 = pcur3 + pch3 }
                        pci3 = pci3 + 1
                    }
                }
                this.Out.EmitLine("return __v;")
                this.Out.Dedent()
                this.Out.EmitLine("}")
                this.Out.EmitBlank()
            }

            // Register as algebraic enum for type lookups
            this.EnumNames.Add("__alg__" + name)
        } else {
            // Simple enum — original C enum
            this.Out.EmitLine("enum _" + name + " {")
            this.Out.Indent_()
            for i in 0..count {
                let member = en.Children.Get(i)
                let mname  = name + "_" + member.Name
                if (i < count - 1) {
                    this.Out.EmitLine(mname + ",")
                } else {
                    this.Out.EmitLine(mname)
                }
            }
            this.Out.Dedent()
            this.Out.EmitLine("};")
            this.Out.EmitBlank()
        }
    }

    private void EmitClass(AstNode cls) {
        let name    = this.SymName(cls.Name)
        let members = cls.Children.Count()

        // Track current class for field-type lookups inside methods
        this.CurrentClass = name

        // Record field C types for later method emission
        for i in 0..members {
            let m  = cls.Children.Get(i)
            let mk = m.Kind
            if (mk == NodeKind.VAR_DECL) {
                let rawType = m.Str
                let ftype = this.TypeToC(rawType)
                this.FieldTypeSet(name, m.Name, ftype)
                // Track element type for List<T> fields
                if (String_StartsWith(rawType, "List<")) {
                    // Extract T from "List<T>"
                    let inner = String_Substring(rawType, 5, String_Length(rawType) - 6)
                    let elemC = this.TypeToC(inner)
                    this.ListElemSet(name, m.Name, elemC)
                }
            }
        }

        // Struct fields
        this.Out.EmitLine("struct _" + name + " {")
        this.Out.Indent_()
        // Embed parent fields directly if this class extends another
        let parentName = cls.Str
        if (String_Length(parentName) > 0) {
            let parentC = this.SymName(parentName)
            // Copy parent field declarations into child struct
            let pfc = this.FieldNames.Count()
            let pfPrefix = parentC + "."
            for pfi in 0..pfc {
                let pfkey = this.FieldNames.Get(pfi)
                if (String_StartsWith(pfkey, pfPrefix)) {
                    let pfname = String_Substring(pfkey, String_Length(pfPrefix), String_Length(pfkey) - String_Length(pfPrefix))
                    let pftype = this.FieldCTypes.Get(pfi)
                    this.Out.EmitLine(pftype + " " + pfname + ";")
                    // Register in child's field table for method lookup
                    this.FieldTypeSet(name, pfname, pftype)
                }
            }
        }
        for i in 0..members {
            let m  = cls.Children.Get(i)
            let mk = m.Kind
            if (mk == NodeKind.VAR_DECL) {
                let ftype = this.TypeToC(m.Str)
                this.Out.EmitLine(ftype + " " + m.Name + ";")
            }
        }
        this.Out.Dedent()
        this.Out.EmitLine("};")
        this.Out.EmitBlank()

        // Forward declare non-constructor methods only
        for i in 0..members {
            let m  = cls.Children.Get(i)
            let mk = m.Kind
            if (mk == NodeKind.METHOD_DECL) {
                if (m.Name != cls.Name) {
                    let sig     = this.MethodSig(m, name)
                    let isPublic = m.Flag
                    // Register return type for inference
                    let retC = this.TypeToC(m.Str)
                    this.MethodRetSet(name, m.Name, retC)
                    // Decorators (Str2) → C attributes on the prototype.
                    var attrs = ""
                    let decos = m.Str2
                    if (String_Length(decos) > 0) {
                        if (String_Contains("," + decos + ",", ",deprecated,")) {
                            attrs = " __attribute__((deprecated))"
                        }
                    }
                    if (isPublic) {
                        this.Out.EmitLine(sig + attrs + ";")
                    } else {
                        this.Out.EmitLine("static " + sig + attrs + ";")
                    }
                }
            }
        }
        this.Out.EmitBlank()

        // Constructor — find the constructor method (Name == class name)
        // Build _new() signature with constructor params
        var ctorFound = false
        for i in 0..members {
            let m  = cls.Children.Get(i)
            let mk = m.Kind
            if (mk == NodeKind.METHOD_DECL) {
                if (m.Name == cls.Name) {
                    ctorFound = true
                    // Build _new(params...) signature
                    var ctorSig = name + "* " + name + "_new("
                    let pcount  = m.Params.Count()
                    var first   = true
                    for pi in 0..pcount {
                        let p = m.Params.Get(pi)
                        if (!first) { ctorSig = ctorSig + ", " }
                        ctorSig = ctorSig + this.TypeToC(p.Str) + " " + p.Name
                        first = false
                    }
                    ctorSig = ctorSig + ")"
                    this.Out.EmitLine(ctorSig + " {")
                    this.Out.Indent_()
                    this.Out.EmitLine(name + "* self = (" + name + "*) GC_MALLOC(sizeof(" + name + "));")
                    // Emit constructor body with param types tracked
                    this.LocalTypeClear()
                    this.LocalTypeSet("self", name + "*")
                    for pi in 0..pcount {
                        let p = m.Params.Get(pi)
                        this.LocalTypeSet(p.Name, this.TypeToC(p.Str))
                    }
                    if (m.Body != null) {
                        this.EmitBlock(m.Body)
                    } else {
                        // Body-less constructor (data class / record): auto-assign
                        // every param that matches a declared field. ParseDataClass
                        // adds fields and ctor params with the same names, so this
                        // produces `self->X = X` lines without needing the user to
                        // write them. Plain user-written constructors normally
                        // come with a body and skip this path.
                        for pi in 0..pcount {
                            let p = m.Params.Get(pi)
                            // Confirm there's a field with the same name to assign to
                            var hasField = false
                            for fi in 0..members {
                                let f = cls.Children.Get(fi)
                                if (f.Kind == NodeKind.VAR_DECL && f.Name == p.Name) {
                                    hasField = true
                                }
                            }
                            if (hasField) {
                                this.Out.EmitLine("self->" + p.Name + " = " + p.Name + ";")
                            }
                        }
                    }
                    this.LocalTypeClear()
                    this.Out.EmitLine("return self;")
                    this.Out.Dedent()
                    this.Out.EmitLine("}")
                    this.Out.EmitBlank()
                }
            }
        }
        // No-args _new() if no constructor defined
        if (!ctorFound) {
            this.Out.EmitLine(name + "* " + name + "_new() {")
            this.Out.Indent_()
            this.Out.EmitLine(name + "* self = (" + name + "*) GC_MALLOC(sizeof(" + name + "));")
            this.Out.EmitLine("return self;")
            this.Out.Dedent()
            this.Out.EmitLine("}")
            this.Out.EmitBlank()
        }

        // Non-constructor methods
        for j in 0..members {
            let m2  = cls.Children.Get(j)
            let mk2 = m2.Kind
            if (mk2 == NodeKind.METHOD_DECL) {
                if (m2.Name != cls.Name) {
                    this.EmitMethod(m2, name)
                }
            }
        }
    }

    // Generate a C struct name for a tuple type like "(int,string)"
    private string TupleStructName(string tupleType) {
        // "(int,string)" → "Tuple2_i64_code_string"
        let inner = String_Substring(tupleType, 1, String_Length(tupleType) - 2)
        let parts = String_Replace(inner, " ", "")
        var result = ""
        var count  = 0
        var i2     = 0
        let len2   = String_Length(parts)
        var cur    = ""
        while (i2 <= len2) {
            var ch = ""
            if (i2 < len2) { ch = String_Substring(parts, i2, 1) }
            if (ch == "," || i2 == len2) {
                if (String_Length(cur) > 0) {
                    count = count + 1
                    result = result + "_" + this.TypeToC(cur)
                    cur = ""
                }
            } else {
                cur = cur + ch
            }
            i2 = i2 + 1
        }
        return "Tuple" + String_FromInt(count) + result
    }

    // Emit a struct typedef for a tuple type if not already emitted
    private void EnsureTupleStruct(string tupleType) {
        let sname = this.TupleStructName(tupleType)
        // Check if already emitted (simple: check if in enum names list as marker)
        let n = this.EnumNames.Count()
        for i in 0..n {
            if (this.EnumNames.Get(i) == "__tuple__" + sname) { return }
        }
        this.EnumNames.Add("__tuple__" + sname)
        // Parse types from "(t1,t2,...)"
        let inner = String_Substring(tupleType, 1, String_Length(tupleType) - 2)
        let parts = String_Replace(inner, " ", "")
        this.Out.EmitLine("typedef struct {")
        var idx = 0
        var cur = ""
        var i2  = 0
        let len2 = String_Length(parts)
        while (i2 <= len2) {
            var ch = ""
            if (i2 < len2) { ch = String_Substring(parts, i2, 1) }
            if (ch == "," || i2 == len2) {
                if (String_Length(cur) > 0) {
                    this.Out.EmitLine("    " + this.TypeToC(cur) + " _" + String_FromInt(idx) + ";")
                    idx = idx + 1
                    cur = ""
                }
            } else { cur = cur + ch }
            i2 = i2 + 1
        }
        this.Out.EmitLine("} " + sname + ";")
    }

    private string MethodSig(AstNode method, string className) {
        let retTypeRaw = method.Str
        var retType    = ""
        // Tuple return type: "(int,string)"
        if (String_StartsWith(retTypeRaw, "(")) {
            this.EnsureTupleStruct(retTypeRaw)
            retType = this.TupleStructName(retTypeRaw)
        } else {
            retType = this.TypeToC(retTypeRaw)
        }
        let isStatic = method.Flag2
        var sig      = retType + " " + className + "_" + method.Name + "("
        var first    = true
        if (!isStatic) {
            sig   = sig + className + "* self"
            first = false
        }
        let pcount = method.Params.Count()
        for i in 0..pcount {
            let p  = method.Params.Get(i)
            if (!first) { sig = sig + ", " }
            sig   = sig + this.TypeToC(p.Str) + " " + p.Name
            first = false
        }
        sig = sig + ")"
        return sig
    }

    private void EmitMethod(AstNode method, string className) {
        let sig      = this.MethodSig(method, className)
        let isPublic = method.Flag
        var prefix   = ""
        if (!isPublic) { prefix = "static " }
        // Decorators (comma-separated in Str2) → C attributes / inlining hints.
        let decos = method.Str2
        if (String_Length(decos) > 0) {
            if (String_Contains("," + decos + ",", ",inline,")) {
                prefix = prefix + "inline "
            }
        }
        // Track current return type for tuple returns
        if (String_StartsWith(method.Str, "(")) {
            this.CurrentRetType = this.TupleStructName(method.Str)
            // Register method return type for later lookup in tuple destructuring
            this.MethodRetSet(className, method.Name, method.Str)
        } else {
            this.CurrentRetType = ""
        }
        this.Out.EmitLine(prefix + sig + " {")
        this.Out.Indent_()
        // Reset local type table for this method scope
        this.LocalTypeClear()
        // Seed with 'self' if instance method
        let isStatic = method.Flag2
        if (!isStatic) {
            this.LocalTypeSet("self", className + "*")
            // Suppress -Wunused-parameter if self is not referenced
            this.Out.EmitLine("(void)self;")
        }
        // Seed with parameters and suppress unused warnings
        let pcount = method.Params.Count()
        for i in 0..pcount {
            let p = method.Params.Get(i)
            this.LocalTypeSet(p.Name, this.TypeToC(p.Str))
            this.Out.EmitLine("(void)" + p.Name + ";")
        }
        if (method.Body != null) {
            this.EmitBlock(method.Body)
        }
        this.LocalTypeClear()
        this.Out.Dedent()
        this.Out.EmitLine("}")
        this.Out.EmitBlank()
    }

    // ── Block & Statements ────────────────────────────

    // Recursive if/else-if/else emitter — produces clean "} else if (...) {" chains
    // Extract a single expression string from an if-expr branch block
    private string EmitIfBranch(AstNode block) {
        if (block == null) { return "0" }
        if (block.Kind == NodeKind.BLOCK) {
            let kids = block.Children
            if (kids.Count() > 0) {
                return this.EmitExprStr(kids.Get(0))
            }
            return "0"
        }
        return this.EmitExprStr(block)
    }

    private void EmitMatch(AstNode stmt) {
        let subject = stmt.Left
        let subjectStr = this.EmitExprStr(subject)
        // Determine if subject is an algebraic enum
        var subjectType = ""
        if (subject != null && subject.Kind == NodeKind.IDENTIFIER) {
            subjectType = this.LocalTypeGet(subject.Name)
        }
        // isAlg: true only if the type is a registered algebraic enum (has __alg__ marker)
        var isAlg = false
        if (String_Length(subjectType) > 0) {
            let algKey2 = "__alg__" + subjectType
            let enCount3 = this.EnumNames.Count()
            for eni3 in 0..enCount3 {
                if (this.EnumNames.Get(eni3) == algKey2) { isAlg = true }
            }
        }
        let armCount = stmt.Children.Count()
        if (isAlg) {
            // Emit as switch on tag
            this.Out.EmitLine("switch (" + subjectStr + ".tag) {")
        } else {
            // Emit as if-else chain for simple value matching
            this.Out.EmitLine("{ /* match " + subjectStr + " */")
        }
        this.Out.Indent_()
        var firstArm = true
        var needsClose = false   // true when the last non-alg arm left an open "if" brace
        for i in 0..armCount {
            let arm = stmt.Children.Get(i)
            let pat = arm.Left
            let body = arm.Right
            if (pat == null) { continue }
            let pk = pat.Kind
            // Wildcard
            if (pk == NodeKind.IDENTIFIER && pat.Name == "_") {
                if (isAlg) {
                    this.Out.EmitLine("default: {")
                    this.Out.Indent_()
                    this.EmitMatchBody(body)
                    this.Out.EmitLine("break;")
                    this.Out.Dedent()
                    this.Out.EmitLine("}")
                    needsClose = false
                } else {
                    // Wildcard arm: close previous arm (if any) and emit trailing "else"
                    let elsePrefix = if (firstArm) { "" } else { "} else " }
                    this.Out.EmitLine(elsePrefix + "{")
                    this.Out.Indent_()
                    this.EmitMatchBody(body)
                    this.Out.Dedent()
                    this.Out.EmitLine("}")
                    needsClose = false
                }
                firstArm = false
            } else {
                if (isAlg && pk == NodeKind.CALL) {
                    // Algebraic variant: Circle(r)
                    let variantName = pat.Name
                    let tagConst = subjectType + "_TAG_" + variantName
                    this.Out.EmitLine("case " + tagConst + ": {")
                    this.Out.Indent_()
                    // Bind capture variables
                    let capCount = pat.Args.Count()
                    for ci in 0..capCount {
                        let capNode = pat.Args.Get(ci)
                        let capName = capNode.Name
                        let fidx = String_FromInt(ci)
                        this.Out.EmitLine("__auto_type " + capName + " = " + subjectStr + "." + variantName + "._" + fidx + ";")
                        this.LocalTypeSet(capName, "i64") // assume numeric for now
                    }
                    this.EmitMatchBody(body)
                    this.Out.EmitLine("break;")
                    this.Out.Dedent()
                    this.Out.EmitLine("}")
                    needsClose = false
                } else {
                    // Simple value or range — emit as if/else-if chain.
                    // Optional guard `if <expr>` is AND-ed with the pattern condition.
                    let elsePrefix = if (firstArm) { "" } else { "} else " }
                    let isBinder = pk == NodeKind.IDENTIFIER && pat.Name != "_"
                    var cond = ""
                    if (pk == NodeKind.BINARY && pat.Str == "..") {
                        let lo = this.EmitExprStr(pat.Left)
                        let hi = this.EmitExprStr(pat.Right)
                        cond = subjectStr + " >= " + lo + " && " + subjectStr + " <= " + hi
                    } else if (pk == NodeKind.LITERAL_STRING) {
                        let patStr = this.EmitExprStr(pat)
                        cond = "strcmp(" + subjectStr + ", " + patStr + ") == 0"
                    } else if (isBinder) {
                        // Bare identifier acts as a binder + always-match (Rust-like).
                        // Only meaningful when paired with a guard (`n if n > 0`).
                        cond = "1"
                    } else {
                        let patStr = this.EmitExprStr(pat)
                        cond = subjectStr + " == " + patStr
                    }
                    if (arm.Cond != null) {
                        // Pre-declare the binder so it's in scope for the guard expression.
                        // Register it locally so EmitExprStr renders it as the bare name.
                        if (isBinder) {
                            this.LocalTypeSet(pat.Name, "i64")
                        }
                        let guardStr = this.EmitExprStr(arm.Cond)
                        if (isBinder) {
                            // GCC statement expression: introduces the binder in the
                            // condition's scope so `n if n > 0` evaluates the guard
                            // with `n = subject` visible.
                            cond = "(({ __auto_type " + pat.Name + " = " + subjectStr + "; " + guardStr + "; }))"
                        } else {
                            cond = "(" + cond + ") && (" + guardStr + ")"
                        }
                    }
                    this.Out.EmitLine(elsePrefix + "if (" + cond + ") {")
                    this.Out.Indent_()
                    // Bare-id binder: also declare inside the body so it's visible
                    // there (in addition to the guard's compound expression).
                    if (isBinder) {
                        this.Out.EmitLine("__auto_type " + pat.Name + " = " + subjectStr + ";")
                        this.LocalTypeSet(pat.Name, "i64")
                    }
                    this.EmitMatchBody(body)
                    this.Out.Dedent()
                    needsClose = true
                }
                firstArm = false
            }
        }
        // Close the last open "if" brace if the chain ended without a wildcard
        if (needsClose) {
            this.Out.EmitLine("}")
        }
        this.Out.Dedent()
        this.Out.EmitLine("}")
    }

    private void EmitMatchBody(AstNode body) {
        if (body == null) { return }
        let bk = body.Kind
        if (bk == NodeKind.BLOCK) {
            let stmts = body.Children.Count()
            for si in 0..stmts {
                this.EmitStmt(body.Children.Get(si))
            }
        } else if (bk == NodeKind.RETURN_STMT || bk == NodeKind.BREAK_STMT || bk == NodeKind.CONTINUE_STMT) {
            // Statement-form arm body: parser accepts `1 => return "X"` etc.
            // Delegate to EmitStmt which already knows how to render these.
            this.EmitStmt(body)
        } else {
            // Expression arm — emit as return statement (match arms are in return position)
            let exprStr = this.EmitExprStr(body)
            if (String_Length(exprStr) > 0 && exprStr != "_unknown_") {
                if (bk == NodeKind.CALL || bk == NodeKind.IDENTIFIER) {
                    // Void call (like Console.WriteLine)
                    this.Out.EmitLine(exprStr + ";")
                } else {
                    this.Out.EmitLine("return " + exprStr + ";")
                }
            }
        }
    }

    private void EmitIf(AstNode stmt) {
        this.Out.EmitLine("if (" + this.EmitExprStr(stmt.Cond) + ") {")
        this.Out.Indent_()
        if (stmt.Body != null) { this.EmitBlock(stmt.Body) }
        this.Out.Dedent()
        if (stmt.Else != null) {
            let elseKind = stmt.Else.Kind
            if (elseKind == NodeKind.IF_STMT) {
                // Fuse "} else if (...) {" on one line
                let innerCond = this.EmitExprStr(stmt.Else.Cond)
                this.Out.EmitLine("} else if (" + innerCond + ") {")
                this.Out.Indent_()
                if (stmt.Else.Body != null) { this.EmitBlock(stmt.Else.Body) }
                this.Out.Dedent()
                // Recurse for further else-if / else chains
                this.EmitIfTail(stmt.Else)
            } else {
                this.Out.EmitLine("} else {")
                this.Out.Indent_()
                this.EmitBlock(stmt.Else)
                this.Out.Dedent()
                this.Out.EmitLine("}")
            }
        } else {
            this.Out.EmitLine("}")
        }
    }

    // Emit the tail of an else-if chain (after body already emitted)
    private void EmitIfTail(AstNode stmt) {
        if (stmt.Else == null) {
            this.Out.EmitLine("}")
            return
        }
        let elseKind = stmt.Else.Kind
        if (elseKind == NodeKind.IF_STMT) {
            let innerCond = this.EmitExprStr(stmt.Else.Cond)
            this.Out.EmitLine("} else if (" + innerCond + ") {")
            this.Out.Indent_()
            if (stmt.Else.Body != null) { this.EmitBlock(stmt.Else.Body) }
            this.Out.Dedent()
            this.EmitIfTail(stmt.Else)
        } else {
            this.Out.EmitLine("} else {")
            this.Out.Indent_()
            this.EmitBlock(stmt.Else)
            this.Out.Dedent()
            this.Out.EmitLine("}")
        }
    }

    private void EmitBlock(AstNode block) {
        let count = block.Children.Count()
        for i in 0..count {
            let stmt = block.Children.Get(i)
            this.EmitStmt(stmt)
        }
    }

    private void EmitStmt(AstNode stmt) {
        let k = stmt.Kind
        if (k == NodeKind.TRY_STMT) {
            // try { … } catch e { … } [finally { … }] — setjmp/longjmp pattern
            // (matches the Vala bootstrap's c_generator).
            //   {
            //     jmp_buf _am_prev_env_NN;
            //     memcpy(&_am_prev_env_NN, &_am_ex.env, sizeof(jmp_buf));
            //     int _am_caught_NN = setjmp(_am_ex.env);
            //     if (_am_caught_NN == 0) { try…; _am_ex.active = 0; }
            //     else { void* e = _am_ex.value; _am_ex.active = 0; catch…; }
            //     memcpy(&_am_ex.env, &_am_prev_env_NN, sizeof(jmp_buf));
            //     finally…;
            //   }
            // Suffix uses the source line of the `try` token so nested try/catch
            // blocks get distinct local names.
            let suffix = String_FromInt(stmt.Line)
            this.Out.EmitLine("{")
            this.Out.Indent_()
            this.Out.EmitLine("jmp_buf _am_prev_env_" + suffix + ";")
            this.Out.EmitLine("memcpy(&_am_prev_env_" + suffix + ", &_am_ex.env, sizeof(jmp_buf));")
            this.Out.EmitLine("int _am_caught_" + suffix + " = setjmp(_am_ex.env);")
            this.Out.EmitLine("if (_am_caught_" + suffix + " == 0) {")
            this.Out.Indent_()
            if (stmt.Body != null) { this.EmitBlock(stmt.Body) }
            this.Out.EmitLine("_am_ex.active = 0;")
            this.Out.Dedent()
            this.Out.EmitLine("} else {")
            this.Out.Indent_()
            if (String_Length(stmt.Name) > 0) {
                this.Out.EmitLine("void* __attribute__((unused)) " + stmt.Name + " = _am_ex.value;")
                this.LocalTypeSet(stmt.Name, "void*")
            }
            this.Out.EmitLine("_am_ex.active = 0;")
            if (stmt.Else != null) { this.EmitBlock(stmt.Else) }
            this.Out.Dedent()
            this.Out.EmitLine("}")
            this.Out.EmitLine("memcpy(&_am_ex.env, &_am_prev_env_" + suffix + ", sizeof(jmp_buf));")
            if (stmt.Cond != null) { this.EmitBlock(stmt.Cond) }
            this.Out.Dedent()
            this.Out.EmitLine("}")
            return
        }
        if (k == NodeKind.THROW_STMT) {
            // `throw new SomeError(args)` → `_am_throw((void*)(SomeError_new(args)),
            //   "SomeError", first_string_arg_or_empty)`.
            // Falls back to a generic throw for other shapes.
            if (stmt.Left == null) {
                this.Out.EmitLine("_am_throw(NULL, \"Error\", \"\");")
                return
            }
            let v = stmt.Left
            if (v.Kind == NodeKind.NEW_EXPR) {
                let typeName = v.Name
                var argsStr = ""
                let ac = v.Args.Count()
                for ai in 0..ac {
                    if (ai > 0) { argsStr = argsStr + ", " }
                    argsStr = argsStr + this.EmitExprStr(v.Args.Get(ai))
                }
                var msgStr = "\"\""
                if (ac > 0) {
                    let firstArg = v.Args.Get(0)
                    if (firstArg.Kind == NodeKind.LITERAL_STRING) {
                        msgStr = this.EmitExprStr(firstArg)
                    }
                }
                let symName = this.SymName(typeName)
                this.Out.EmitLine("_am_throw((void*)(" + symName + "_new(" + argsStr + ")), \"" + typeName + "\", " + msgStr + ");")
                return
            }
            let valStr = this.EmitExprStr(v)
            this.Out.EmitLine("_am_throw((void*)" + valStr + ", \"Error\", \"\");")
            return
        }
        if (k == NodeKind.VAR_DECL) {
            // Tuple destructuring: let (a, b) = expr
            if (stmt.Str == "__tuple_destructure__") {
                let rhs = this.EmitExprStr(stmt.Left)
                let tmpName = "__tup_" + String_FromInt(stmt.Line)
                this.Out.EmitLine("__auto_type " + tmpName + " = " + rhs + ";")
                // Try to infer element types from the called function's return tuple type
                var tupleRetType = ""
                if (stmt.Left != null && stmt.Left.Kind == NodeKind.CALL) {
                    let calleeStr2 = this.EmitCalleeStr(stmt.Left.Left)
                    // calleeStr2 = "ClassName_MethodName" — split at last _
                    let lastUs = String_LastIndexOf(calleeStr2, "_")
                    if (lastUs > 0) {
                        let cls2 = String_Substring(calleeStr2, 0, lastUs)
                        let mth2 = String_Substring(calleeStr2, lastUs + 1, String_Length(calleeStr2) - lastUs - 1)
                        tupleRetType = this.MethodRetGet(cls2, mth2)
                    }
                }
                let nc = stmt.Children.Count()
                for i in 0..nc {
                    let vnode = stmt.Children.Get(i)
                    let vname = vnode.Name
                    let idxStr = String_FromInt(i)
                    this.Out.EmitLine("__auto_type __attribute__((unused)) " + vname + " = " + tmpName + "._" + idxStr + ";")
                    // Infer element type from tuple type string "(int,string,bool)"
                    var elemType = "void*"
                    if (String_Length(tupleRetType) > 2 && String_StartsWith(tupleRetType, "(")) {
                        let inner2 = String_Substring(tupleRetType, 1, String_Length(tupleRetType) - 2)
                        // Split by comma and get i-th element
                        var ei = 0
                        var cur2 = ""
                        var ci2  = 0
                        let ilen = String_Length(inner2)
                        while (ci2 <= ilen) {
                            var ch2 = ""
                            if (ci2 < ilen) { ch2 = String_Substring(inner2, ci2, 1) }
                            if (ch2 == "," || ci2 == ilen) {
                                if (ei == i && String_Length(cur2) > 0) {
                                    elemType = this.TypeToC(cur2)
                                }
                                ei = ei + 1
                                cur2 = ""
                            } else { cur2 = cur2 + ch2 }
                            ci2 = ci2 + 1
                        }
                    }
                    this.LocalTypeSet(vname, elemType)
                }
                return
            }
            // Lambda assignment: let doubler = x => x * 2
            if (stmt.Left != null && stmt.Left.Kind == NodeKind.METHOD_DECL && stmt.Left.Name == "__lambda__") {
                let lam = stmt.Left
                let paramName = lam.Str
                let bodyStr   = this.EmitExprStr(lam.Left)
                let fnName    = this.CurrentClass + "_lam_" + stmt.Name
                // Emit using GCC nested function syntax (supported by GCC as extension)
                // auto keyword doesn't work for nested functions, use __auto_type workaround
                // Best approach: just inline the call site
                // Store lambda as a simple C macro-style via function pointer trick
                // Since we can't easily do nested functions, emit a global-scope helper before
                // For now: emit a simple typedef'd function via static at file scope
                // We'll use a hack: emit before closing brace by buffering
                // Simple approach: wrap call in a macro
                this.Out.EmitLine("/* lambda " + stmt.Name + " = " + paramName + " => " + bodyStr + " */")
                this.Out.EmitLine("#define " + stmt.Name + "(" + paramName + ") (" + bodyStr + ")")
                this.LocalTypeSet(stmt.Name, "__macro__")
                return
            }
            var t = this.TypeToC(stmt.Str)
            // If no explicit type annotation, infer from RHS
            if (String_Length(t) == 0 || t == "void") {
                t = this.InferTypeFromExpr(stmt.Left)
            }
            // Fall back to void* only if we truly can't infer
            if (String_Length(t) == 0) { t = "void*" }
            // Record in local type table for later use
            this.LocalTypeSet(stmt.Name, t)
            // Track the element type of `let xs = new List<T>()` so a later
            // `xs.Get(i)` can emit a typed cast to T instead of falling
            // back to void*. ListElemSet's "className" slot is repurposed
            // for locals via "__local__" (List<T>) and "__local_map__"
            // (Map<K,V> — value type only; the key is always code_string).
            if (stmt.Left != null && stmt.Left.Kind == NodeKind.NEW_EXPR) {
                if (stmt.Left.Name == "List" && String_Length(stmt.Left.Str2) > 0) {
                    let elemC = this.TypeToC(stmt.Left.Str2)
                    this.ListElemSet("__local__", stmt.Name, elemC)
                }
                if (stmt.Left.Name == "Map" && String_Length(stmt.Left.Str2) > 0) {
                    // "K,V" — split on the first comma, take V.
                    let raw = stmt.Left.Str2
                    let comma = String_IndexOf(raw, ",")
                    if (comma > 0) {
                        let vRaw = String_Substring(raw, comma + 1, String_Length(raw) - comma - 1)
                        let vTrim = String_Trim(vRaw)
                        if (String_Length(vTrim) > 0) {
                            this.ListElemSet("__local_map__", stmt.Name, this.TypeToC(vTrim))
                        }
                    }
                }
            }
            // Emit the declaration — for void* from List.Get(), emit a typed cast
            let rhs = this.EmitExprStr(stmt.Left)
            var decl = t + " __attribute__((unused)) " + stmt.Name + " = " + rhs + ";"
            // If inferred void* but we have a typed cast available, upgrade the variable type
            if (t == "void*") {
                // Check if rhs already contains a typed cast like "(SomeType*)AmalgameList_get"
                // but NOT a ternary expression like "(cond ? a : b)"
                if (String_StartsWith(rhs, "(") && !String_StartsWith(rhs, "(void*)") && !String_StartsWith(rhs, "({") && !String_Contains(rhs, "?")) {
                    // Extract cast type from "(Type*)expr" → strip outer parens up to first )
                    let closeP = String_IndexOf(rhs, ")")
                    if (closeP > 1) {
                        let castT = String_Substring(rhs, 1, closeP - 1)
                        if (String_Length(castT) > 0) {
                            t = castT
                            this.LocalTypeSet(stmt.Name, t)
                            decl = t + " __attribute__((unused)) " + stmt.Name + " = " + rhs + ";"
                        }
                    }
                }
            }
            this.Out.EmitLine(decl)
        }
        if (k == NodeKind.RETURN_STMT) {
            if (stmt.Left == null) {
                this.Out.EmitLine("return;")
            } else {
                let retExpr = this.EmitExprStr(stmt.Left)
                if (retExpr == "_unknown_") {
                    this.Out.EmitLine("return;")
                } else {
                    // If returning a tuple literal {a,b,...}, cast with current return type
                    if (String_StartsWith(retExpr, "{") && String_Length(this.CurrentRetType) > 0) {
                        this.Out.EmitLine("return (" + this.CurrentRetType + ")" + retExpr + ";")
                    } else {
                        this.Out.EmitLine("return " + retExpr + ";")
                    }
                }
            }
        }
        if (k == NodeKind.IF_STMT) {
            // Check if this is a match statement
            if (stmt.Name == "__match__") {
                this.EmitMatch(stmt)
                return
            }
            this.EmitIf(stmt)
        }
        if (k == NodeKind.WHILE_STMT) {
            this.Out.EmitLine("while (" + this.EmitExprStr(stmt.Cond) + ") {")
            this.Out.Indent_()
            if (stmt.Body != null) { this.EmitBlock(stmt.Body) }
            this.Out.Dedent()
            this.Out.EmitLine("}")
        }
        if (k == NodeKind.FOR_IN_STMT) {
            let vn = stmt.Name
            // iter is the range expression: BINARY("..", start, end) or a collection
            if (stmt.Left != null) {
                let iterKind = stmt.Left.Kind
                if (iterKind == NodeKind.BINARY) {
                    let iterOp = stmt.Left.Str
                    if (iterOp == "..") {
                        // Range for: for i in start..end → for (i64 i = start; i < end; i++)
                        let startExpr = this.EmitExprStr(stmt.Left.Left)
                        let endExpr   = this.EmitExprStr(stmt.Left.Right)
                        this.Out.EmitLine("for (i64 " + vn + " = " + startExpr + "; " + vn + " < " + endExpr + "; " + vn + "++) {")
                        this.LocalTypeSet(vn, "i64")
                        this.Out.Indent_()
                        if (stmt.Body != null) { this.EmitBlock(stmt.Body) }
                        this.Out.Dedent()
                        this.Out.EmitLine("}")
                        this.LocalTypeSet(vn, "")
                        return
                    }
                }
            }
            // Collection for: for x in <list-expr>. Emit a wrapper block so
            // the synthetic iterator + length stay scoped to the loop. The
            // element type is erased to void* (generics erase to void*); the
            // user casts explicitly when treating the element as a primitive.
            // The synthetic names use vn as a suffix so nested for-in over
            // different lists don't shadow each other.
            let iter = this.EmitExprStr(stmt.Left)
            this.Out.EmitLine("{")
            this.Out.Indent_()
            this.Out.EmitLine("AmalgameList* __it_" + vn + " = " + iter + ";")
            this.Out.EmitLine("i64 __len_" + vn + " = AmalgameList_size(__it_" + vn + ");")
            this.Out.EmitLine("for (i64 __idx_" + vn + " = 0; __idx_" + vn + " < __len_" + vn + "; __idx_" + vn + "++) {")
            this.Out.Indent_()
            this.Out.EmitLine("void* " + vn + " = __it_" + vn + "->data[__idx_" + vn + "];")
            this.LocalTypeSet(vn, "void*")
            if (stmt.Body != null) { this.EmitBlock(stmt.Body) }
            this.Out.Dedent()
            this.Out.EmitLine("}")
            this.Out.Dedent()
            this.Out.EmitLine("}")
            this.LocalTypeSet(vn, "")
        }
        if (k == NodeKind.BREAK_STMT) {
            this.Out.EmitLine("break;")
        }
        if (k == NodeKind.CONTINUE_STMT) {
            this.Out.EmitLine("continue;")
        }
        if (k == NodeKind.BINARY) {
            this.Out.EmitLine(this.EmitExprStr(stmt) + ";")
        }
        if (k == NodeKind.CALL) {
            this.Out.EmitLine(this.EmitExprStr(stmt) + ";")
        }
        if (k == NodeKind.MEMBER) {
            this.Out.EmitLine(this.EmitExprStr(stmt) + ";")
        }
    }

    // ── Expression emission ───────────────────────────

    private string EmitExprStr(AstNode expr) {
        if (expr == null) { return "NULL" }
        let k = expr.Kind
        // Lambda: x => expr — emit as a C compound statement expression (GCC extension)
        if (k == NodeKind.METHOD_DECL && expr.Name == "__lambda__") {
            let paramName = expr.Str
            let bodyStr   = this.EmitExprStr(expr.Left)
            // Can't easily emit a lambda in C without closures
            // Store as a tagged placeholder — callers must handle
            return "__lambda_" + paramName + "_" + bodyStr + "__"
        }
        // Tuple literal: (val1, val2, ...)
        if (k == NodeKind.CALL && expr.Name == "__tuple_literal__") {
            // We don't know the struct name here without context,
            // use compound literal with positional initializers
            let argc = expr.Args.Count()
            var result = "{"
            for i in 0..argc {
                if (i > 0) { result = result + ", " }
                result = result + this.EmitExprStr(expr.Args.Get(i))
            }
            result = result + "}"
            return result
        }
        if (k == NodeKind.IF_STMT) {
            // match-as-expression: same NodeKind, distinguished by marker.
            if (expr.Name == "__match__") {
                return this.EmitMatchExpr(expr)
            }
            let condStr = this.EmitExprStr(expr.Cond)
            let thenStr = this.EmitIfBranch(expr.Body)
            let elseStr = this.EmitIfBranch(expr.Else)
            return "(" + condStr + " ? " + thenStr + " : " + elseStr + ")"
        }
        if (k == NodeKind.LITERAL_INT)    { return expr.Str }
        if (k == NodeKind.LITERAL_FLOAT)  { return expr.Str }
        if (k == NodeKind.LITERAL_STRING) {
            let raw = expr.Str
            return this.EmitInterpolatedString(raw)
        }
        if (k == NodeKind.LITERAL_BOOL) {
            if (expr.Flag) { return "1" }
            return "0"
        }
        if (k == NodeKind.LITERAL_NULL) { return "NULL" }
        if (k == NodeKind.THIS_EXPR)    { return "self" }
        if (k == NodeKind.IDENTIFIER)   { return expr.Name }
        if (k == NodeKind.MEMBER) {
            // Null-safe access: `obj?.field` → `(obj ? obj->field : NULL)`.
            // Note: assumes `obj` has no side effects (we evaluate it twice).
            // Use a let-binding for complex receivers.
            if (expr.Flag) {
                let target = this.EmitExprStr(expr.Left)
                return "(" + target + " ? " + target + "->" + expr.Name + " : NULL)"
            }
            if (expr.Left != null) {
                let lk = expr.Left.Kind
                if (lk == NodeKind.THIS_EXPR) {
                    return "self->" + expr.Name
                }
                if (lk == NodeKind.IDENTIFIER) {
                    let tname = expr.Left.Name
                    let firstChar = String_Substring(tname, 0, 1)
                    let isUpper = firstChar == String_ToUpper(firstChar)
                    if (isUpper) {
                        // Enum or static class access: TokenType.NEWLINE → Ns_TokenType_NEWLINE
                        return this.SymName(tname) + "_" + expr.Name
                    }
                    return tname + "->" + expr.Name
                }
            }
            let target = this.EmitExprStr(expr.Left)
            return target + "->" + expr.Name
        }
        if (k == NodeKind.BINARY) {
            let left  = this.EmitExprStr(expr.Left)
            let op    = expr.Str
            let right = this.EmitExprStr(expr.Right)
            if (op == "==" || op == "!=") {
                // Infer LHS type to decide: string → code_string_equals, else → C == / !=
                let ltype = this.InferTypeFromExpr(expr.Left)
                var useStrEq = false
                if (ltype == "code_string") { useStrEq = true }
                // If LHS is a CALL to a known string-returning method, treat as string
                if (String_Length(ltype) == 0) {
                    if (expr.Left != null) {
                        let lk2 = expr.Left.Kind
                        if (lk2 == NodeKind.LITERAL_STRING) { useStrEq = true }
                        // CALL to CharAt / String_* → code_string
                        if (lk2 == NodeKind.CALL) {
                            if (expr.Left.Left != null) {
                                let calleeStr = this.EmitCalleeStr(expr.Left.Left)
                                if (String_StartsWith(calleeStr, "String_") || String_EndsWith(calleeStr, "_CharAt")) {
                                    useStrEq = true
                                }
                            }
                        }
                        // IDENTIFIER whose local type is code_string
                        if (lk2 == NodeKind.IDENTIFIER) {
                            let lt2 = this.LocalTypeGet(expr.Left.Name)
                            if (lt2 == "code_string") { useStrEq = true }
                        }
                        // MEMBER → this.Field or var.Field
                        if (lk2 == NodeKind.MEMBER) {
                            let ft = this.InferTypeFromExpr(expr.Left)
                            if (ft == "code_string") { useStrEq = true }
                        }
                    }
                }
                // Also: if RHS is a string literal, LHS must be string
                if (!useStrEq) {
                    if (expr.Right != null) {
                        if (expr.Right.Kind == NodeKind.LITERAL_STRING) { useStrEq = true }
                    }
                }
                if (useStrEq) {
                    if (op == "==") { return "code_string_equals(" + left + ", " + right + ")" }
                    return "!code_string_equals(" + left + ", " + right + ")"
                }
                // Non-string (int, bool, enum, pointer): use C == / !=
                return left + " " + op + " " + right
            }
            // String concatenation: a + b where either side is a string
            if (op == "+") {
                let ltype2 = this.InferTypeFromExpr(expr.Left)
                var useConcat = false
                if (ltype2 == "code_string") { useConcat = true }
                if (!useConcat) {
                    if (expr.Left != null) {
                        let lk3 = expr.Left.Kind
                        if (lk3 == NodeKind.LITERAL_STRING) { useConcat = true }
                        if (lk3 == NodeKind.IDENTIFIER) {
                            let lt3 = this.LocalTypeGet(expr.Left.Name)
                            if (lt3 == "code_string") { useConcat = true }
                        }
                        // CALL that returns code_string (including nested code_string_concat)
                        if (lk3 == NodeKind.CALL) {
                            let ltype3 = this.InferTypeFromExpr(expr.Left)
                            if (ltype3 == "code_string") { useConcat = true }
                            // Also detect code_string_concat directly by callee name
                            if (expr.Left.Left != null) {
                                let calleeL = this.EmitCalleeStr(expr.Left.Left)
                                if (String_StartsWith(calleeL, "String_") || calleeL == "code_string_concat") {
                                    useConcat = true
                                }
                            }
                        }
                    }
                }
                if (!useConcat) {
                    if (expr.Right != null) {
                        let rk3 = expr.Right.Kind
                        if (rk3 == NodeKind.LITERAL_STRING) { useConcat = true }
                        if (rk3 == NodeKind.CALL) {
                            if (expr.Right.Left != null) {
                                let calleeR = this.EmitCalleeStr(expr.Right.Left)
                                if (String_StartsWith(calleeR, "String_") || calleeR == "code_string_concat") {
                                    useConcat = true
                                }
                            }
                        }
                    }
                }
                if (useConcat) {
                    var lcast = left
                    var rcast = right
                    let ltype4 = this.InferTypeFromExpr(expr.Left)
                    let rtype4 = this.InferTypeFromExpr(expr.Right)
                    if (ltype4 == "void*") { lcast = "(code_string)(" + left + ")" }
                    if (rtype4 == "void*") { rcast = "(code_string)(" + right + ")" }
                    return "code_string_concat(" + lcast + ", " + rcast + ")"
                }
            }
            return left + " " + op + " " + right
        }
        if (k == NodeKind.UNARY) {
            let operand = this.EmitExprStr(expr.Left)
            // Wrap binary/ternary operands in parens so C precedence matches
            // the source (e.g. `!(x > 0)`, not `!x > 0`).
            if (expr.Left != null) {
                let lk = expr.Left.Kind
                if (lk == NodeKind.BINARY) { return expr.Str + "(" + operand + ")" }
            }
            return expr.Str + operand
        }
        if (k == NodeKind.CALL) {
            // Check for AmalgameList method dispatch before generic emit
            let listCall = this.TryEmitListCall(expr)
            if (String_Length(listCall) > 0) { return listCall }
            // Detect this.Method() or this.Field.Method() → inject self / self->Field as first arg
            var isSelfCall = false
            var selfExpr   = "self"
            if (expr.Left != null) {
                if (expr.Left.Kind == NodeKind.MEMBER) {
                    if (expr.Left.Left != null) {
                        let ll = expr.Left.Left
                        // this.Method(...)
                        if (ll.Kind == NodeKind.THIS_EXPR) {
                            isSelfCall = true
                            selfExpr   = "self"
                        }
                        // this.Field.Method(...) — field is itself a struct
                        if (ll.Kind == NodeKind.MEMBER) {
                            if (ll.Left != null) {
                                if (ll.Left.Kind == NodeKind.THIS_EXPR) {
                                    isSelfCall = true
                                    selfExpr   = "self->" + ll.Name
                                }
                            }
                        }
                        // varName.Method(...) where varName is a known instance type
                        if (ll.Kind == NodeKind.IDENTIFIER) {
                            let vt = this.LocalTypeGet(ll.Name)
                            let bare = String_Replace(vt, "*", "")
                            if (String_Length(bare) > 0 && !this.IsEnum(bare)) {
                                isSelfCall = true
                                selfExpr   = ll.Name
                            }
                        }
                        // "literal".Method(...) — pass the literal as the
                        // first argument to String_Method.
                        if (ll.Kind == NodeKind.LITERAL_STRING) {
                            isSelfCall = true
                            selfExpr   = this.EmitExprStr(ll)
                        }
                    }
                }
            }
            let callee = this.EmitCalleeStr(expr.Left)
            var callStr = callee + "("
            var first = true
            if (isSelfCall) {
                callStr = callStr + selfExpr
                first = false
            }
            let argc = expr.Args.Count()
            for i in 0..argc {
                let arg = expr.Args.Get(i)
                if (!first) { callStr = callStr + ", " }
                callStr = callStr + this.EmitExprStr(arg)
                first = false
            }
            callStr = callStr + ")"
            // Null-safe call `obj?.method(...)`: wrap as `(obj ? call : NULL)`
            // — receiver is evaluated twice, so callers should keep it side-effect-free.
            if (expr.Left != null && expr.Left.Kind == NodeKind.MEMBER && expr.Left.Flag) {
                let recv = this.EmitExprStr(expr.Left.Left)
                return "(" + recv + " ? " + callStr + " : NULL)"
            }
            return callStr
        }
        if (k == NodeKind.NEW_EXPR) {
            let tname = expr.Name
            var newCall = ""
            if (String_StartsWith(tname, "List<") || tname == "List") {
                newCall = "AmalgameList_new()"
            } else {
                if (String_StartsWith(tname, "Map<") || tname == "Map") {
                    newCall = "AmalgameMap_new()"
                } else {
                    if (String_StartsWith(tname, "Set<") || tname == "Set") {
                        newCall = "AmalgameSet_new()"
                    } else {
                        newCall = this.SymName(tname) + "_new("
                        let argc = expr.Args.Count()
                        for i in 0..argc {
                            let arg = expr.Args.Get(i)
                            if (i > 0) { newCall = newCall + ", " }
                            newCall = newCall + this.EmitExprStr(arg)
                        }
                        newCall = newCall + ")"
                    }
                }
            }
            return newCall
        }
        if (k == NodeKind.INDEX_EXPR) {
            let base = this.EmitExprStr(expr.Left)
            let idx  = this.EmitExprStr(expr.Right)
            return base + "[" + idx + "]"
        }
        if (k == NodeKind.LIST_COMP) {
            return this.EmitListComp(expr)
        }
        return "/* unknown expr */"
    }

    // ── Match as expression ───────────────────────────
    // `let x = match subj { p1 => e1, p2 => e2, _ => ed }` becomes a GCC
    // compound statement expression:
    //   ({ <type> __mr; if (subj == p1) __mr = (e1);
    //      else if (subj == p2) __mr = (e2); else __mr = (ed); __mr; })
    // The result type is inferred from the first arm body. Block bodies
    // are unwrapped to their last expression statement (they're rare in
    // expression position). Algebraic-enum patterns and guards aren't
    // supported in expression position yet — we emit a stub so the rest
    // of the surrounding compilation can proceed and surface the error
    // through the type checker rather than a syntax-broken C dump.
    private string EmitMatchExpr(AstNode n) {
        let subject = n.Left
        if (subject == null) { return "/* match-expr: missing subject */" }
        let subjectStr = this.EmitExprStr(subject)
        let armCount = n.Children.Count()
        if (armCount == 0) { return "/* match-expr: no arms */" }
        // Infer the result type from the first arm body — drives the
        // declared type of __mr in the generated compound expression.
        let firstArm = n.Children.Get(0)
        let firstBody = firstArm.Right
        var resultType = this.InferTypeFromExpr(firstBody)
        if (String_Length(resultType) == 0) { resultType = "i64" }
        var s = "({ " + resultType + " __mr; "
        var firstArmFlag = true
        for i in 0..armCount {
            let arm = n.Children.Get(i)
            let pat = arm.Left
            let body = arm.Right
            if (pat == null || body == null) { continue }
            let pk = pat.Kind
            let bodyStr = this.EmitExprStr(body)
            // Wildcard arm: `_ => expr` — emit as terminal else.
            if (pk == NodeKind.IDENTIFIER && pat.Name == "_") {
                let prefix = if (firstArmFlag) { "" } else { " else " }
                s = s + prefix + "{ __mr = (" + bodyStr + "); }"
                firstArmFlag = false
                continue
            }
            // Range pattern: lo..hi
            var cond = ""
            if (pk == NodeKind.BINARY && pat.Str == "..") {
                let lo = this.EmitExprStr(pat.Left)
                let hi = this.EmitExprStr(pat.Right)
                cond = subjectStr + " >= " + lo + " && " + subjectStr + " <= " + hi
            } else if (pk == NodeKind.LITERAL_STRING) {
                let patStr = this.EmitExprStr(pat)
                cond = "strcmp(" + subjectStr + ", " + patStr + ") == 0"
            } else {
                let patStr = this.EmitExprStr(pat)
                cond = subjectStr + " == " + patStr
            }
            let prefix = if (firstArmFlag) { "" } else { " else " }
            s = s + prefix + "if (" + cond + ") { __mr = (" + bodyStr + "); }"
            firstArmFlag = false
        }
        s = s + " __mr; })"
        return s
    }

    // ── List comprehension ────────────────────────────
    // [proj for vn in iter (if guard)?] becomes a GCC compound statement
    // expression that builds and returns an AmalgameList*. Two iteration
    // shapes: range (BINARY "..") emits a counted i64 loop; everything
    // else is treated as a List* and iterated by index. Elements are
    // boxed via (void*)(intptr_t)(...) — same convention as user code
    // does when calling .Add() directly. Unique names are suffixed with
    // the iteration variable so nested comps over distinct vars don't
    // collide; same-var nesting is unsupported (rare in practice).
    private string EmitListComp(AstNode n) {
        let vn = n.Str
        let iter = n.Right
        var isRange = false
        if (iter != null && iter.Kind == NodeKind.BINARY && iter.Str == "..") {
            isRange = true
        }
        // Emit the iterable BEFORE setting the local type, so its sub-expressions
        // see the outer scope (e.g. an outer variable named `vn` keeps its type).
        var loopHeader = ""
        if (isRange) {
            let startStr = this.EmitExprStr(iter.Left)
            let endStr   = this.EmitExprStr(iter.Right)
            loopHeader = "for (i64 " + vn + " = " + startStr + "; " + vn + " < " + endStr + "; " + vn + "++) { "
            this.LocalTypeSet(vn, "i64")
        } else {
            let iterStr = this.EmitExprStr(iter)
            loopHeader = "AmalgameList* __it_" + vn + " = " + iterStr + "; "
            loopHeader = loopHeader + "i64 __n_" + vn + " = AmalgameList_size(__it_" + vn + "); "
            loopHeader = loopHeader + "for (i64 __i_" + vn + " = 0; __i_" + vn + " < __n_" + vn + "; __i_" + vn + "++) { "
            loopHeader = loopHeader + "void* " + vn + " = __it_" + vn + "->data[__i_" + vn + "]; "
            this.LocalTypeSet(vn, "void*")
        }
        // Now emit the projection and guard with vn visible.
        let projStr = this.EmitExprStr(n.Left)
        var guardStr = ""
        if (n.Cond != null) {
            guardStr = "if (" + this.EmitExprStr(n.Cond) + ") "
        }
        this.LocalTypeSet(vn, "")
        var s = "({ AmalgameList* __lc_" + vn + " = AmalgameList_new(); "
        s = s + loopHeader
        s = s + guardStr
        s = s + "AmalgameList_add(__lc_" + vn + ", (void*)(intptr_t)(" + projStr + ")); "
        s = s + "} __lc_" + vn + "; })"
        return s
    }

    // ── AmalgameList method dispatch ──────────────────
    // Returns "" if not a list call, otherwise returns the C call string.
    // Handles:
    //   varName.Add(x)     → AmalgameList_add(varName, (void*)(intptr_t)(x))
    //   varName.Count()    → AmalgameList_count(varName)
    //   varName.Get(i)     → (<ElemType>)(intptr_t)AmalgameList_get(varName, i)
    //   this.Field.Add(x)  → AmalgameList_add(self->Field, ...)
    //   this.Field.Count() → AmalgameList_count(self->Field)
    //   this.Field.Get(i)  → AmalgameList_get(self->Field, i)
    private string TryEmitListCall(AstNode callExpr) {
        if (callExpr.Left == null) { return "" }
        if (callExpr.Left.Kind != NodeKind.MEMBER) { return "" }
        let callee = callExpr.Left
        let mname  = callee.Name

        // Map methods
        if (mname == "Set" || mname == "Has" || mname == "Size" || mname == "Remove" || mname == "Get") {
            if (callee.Left != null && callee.Left.Kind == NodeKind.IDENTIFIER) {
                let vname = callee.Left.Name
                let vtype = this.LocalTypeGet(vname)
                if (vtype == "AmalgameMap*") {
                    let args = callExpr.Args
                    let ac = args.Count()
                    if (mname == "Set" && ac >= 2) {
                        let k2 = this.EmitExprStr(args.Get(0))
                        let v2 = this.EmitExprStr(args.Get(1))
                        return "AmalgameMap_set(" + vname + ", " + k2 + ", (void*)(intptr_t)(" + v2 + "))"
                    }
                    if (mname == "Has" && ac >= 1) {
                        let k2 = this.EmitExprStr(args.Get(0))
                        return "AmalgameMap_has(" + vname + ", " + k2 + ")"
                    }
                    if (mname == "Size") { return "AmalgameMap_size(" + vname + ")" }
                    if (mname == "Remove" && ac >= 1) {
                        let k2 = this.EmitExprStr(args.Get(0))
                        return "AmalgameMap_remove(" + vname + ", " + k2 + ")"
                    }
                    if (mname == "Get" && ac >= 1) {
                        let k2 = this.EmitExprStr(args.Get(0))
                        // Use the recorded value type for `new Map<K,V>()` so
                        // `m.Get(k)` lowers to `(V)AmalgameMap_get(m, k)`
                        // instead of `(void*)…`. Falls back to void* when V
                        // wasn't tracked (e.g. param-passed map).
                        var castT = this.ListElemGet("__local_map__", vname)
                        if (String_Length(castT) == 0) { castT = "void*" }
                        return "(" + castT + ")AmalgameMap_get(" + vname + ", " + k2 + ")"
                    }
                }
            }
        }
        // Set methods
        if (mname == "Contains" || mname == "Size") {
            if (callee.Left != null && callee.Left.Kind == NodeKind.IDENTIFIER) {
                let vname = callee.Left.Name
                let vtype = this.LocalTypeGet(vname)
                if (vtype == "AmalgameSet*") {
                    let args = callExpr.Args
                    let ac = args.Count()
                    if (mname == "Contains" && ac >= 1) {
                        let v2 = this.EmitExprStr(args.Get(0))
                        return "AmalgameSet_contains(" + vname + ", " + v2 + ")"
                    }
                    if (mname == "Size") { return "AmalgameSet_size(" + vname + ")" }
                }
            }
        }
        if (mname == "Add" || mname == "Remove") {
            if (callee.Left != null && callee.Left.Kind == NodeKind.IDENTIFIER) {
                let vname = callee.Left.Name
                let vtype = this.LocalTypeGet(vname)
                if (vtype == "AmalgameSet*") {
                    let args = callExpr.Args
                    let ac = args.Count()
                    if (ac >= 1) {
                        let v2 = this.EmitExprStr(args.Get(0))
                        if (mname == "Add") { return "AmalgameSet_add(" + vname + ", " + v2 + ")" }
                        return "AmalgameSet_remove(" + vname + ", " + v2 + ")"
                    }
                }
            }
        }

        if (mname != "Add" && mname != "Count" && mname != "Get" && mname != "IsEmpty" && mname != "Remove" && mname != "RemoveAt" && mname != "Clear" && mname != "Reserve") { return "" }

        // Determine the list object expression and its C type
        var listExpr = ""
        var listCType = ""

        if (callee.Left != null) {
            let lk = callee.Left.Kind

            // Case 1: varName.Method()
            if (lk == NodeKind.IDENTIFIER) {
                let vname = callee.Left.Name
                let vtype = this.LocalTypeGet(vname)
                if (vtype == "AmalgameList*") {
                    listExpr  = vname
                    listCType = "AmalgameList*"
                }
            }

            // Case 2: this.Field.Method()
            if (lk == NodeKind.MEMBER) {
                if (callee.Left.Left != null) {
                    let llk = callee.Left.Left.Kind
                    if (llk == NodeKind.THIS_EXPR) {
                        let fname = callee.Left.Name
                        let ftype = this.FieldTypeGet(this.CurrentClass, fname)
                        if (ftype == "AmalgameList*") {
                            listExpr  = "self->" + fname
                            listCType = "AmalgameList*"
                        }
                    }
                    // Case 3: varName.Field.Method() where varName is a known struct type
                    if (llk == NodeKind.IDENTIFIER) {
                        let vname2  = callee.Left.Left.Name
                        let vtype2  = this.LocalTypeGet(vname2)
                        let fname2  = callee.Left.Name
                        // Strip trailing * to get class name for field lookup
                        let vbare   = String_Replace(vtype2, "*", "")
                        let ftype2  = this.FieldTypeGet(vbare, fname2)
                        if (ftype2 == "AmalgameList*") {
                            listExpr  = vname2 + "->" + fname2
                            listCType = "AmalgameList*"
                        }
                    }
                }
            }
        }

        if (String_Length(listExpr) == 0) { return "" }

        // Emit the appropriate C call
        if (mname == "Clear") {
            return "AmalgameList_clear(" + listExpr + ")"
        }
        if (mname == "Reserve") {
            let arg0 = this.EmitExprStr(callExpr.Args.Get(0))
            return "AmalgameList_reserve(" + listExpr + ", " + arg0 + ")"
        }
        if (mname == "Count") {
            return "AmalgameList_count(" + listExpr + ")"
        }
        if (mname == "Add") {
            let argc = callExpr.Args.Count()
            if (argc == 0) { return "AmalgameList_add(" + listExpr + ", NULL)" }
            let arg0 = this.EmitExprStr(callExpr.Args.Get(0))
            return "AmalgameList_add(" + listExpr + ", (void*)(intptr_t)(" + arg0 + "))"
        }
        if (mname == "Get") {
            let argc = callExpr.Args.Count()
            var idx0 = "0"
            if (argc > 0) { idx0 = this.EmitExprStr(callExpr.Args.Get(0)) }
            // Try to find element type from the list field's owning class
            var elemType = ""
            if (callee.Left != null) {
                let lkG = callee.Left.Kind
                // Case: this.Field.Get(i)
                if (lkG == NodeKind.THIS_EXPR) {
                    // listExpr is just the list var — field name is callee.Name of the outer
                }
                // Case: varName.Field.Get(i) — lkG == MEMBER(IDENTIFIER(varName), Field)
                if (lkG == NodeKind.MEMBER) {
                    if (callee.Left.Left != null) {
                        let lll = callee.Left.Left
                        // this.Field.Get(i)
                        if (lll.Kind == NodeKind.THIS_EXPR) {
                            let fn4 = callee.Left.Name
                            elemType = this.ListElemGet(this.CurrentClass, fn4)
                        }
                        // var.Field.Get(i) — look up var type → class → field elem type
                        if (lll.Kind == NodeKind.IDENTIFIER) {
                            let vn4   = lll.Name
                            let vt4   = this.LocalTypeGet(vn4)
                            let bare4 = String_Replace(vt4, "*", "")
                            let fn4b  = callee.Left.Name
                            elemType = this.ListElemGet(bare4, fn4b)
                        }
                    }
                }
                // Case: varName.Get(i) — listExpr is varName itself (Case 1).
                // Look up the local elem type recorded at `let xs = new List<T>()`.
                if (lkG == NodeKind.IDENTIFIER) {
                    let vn5 = callee.Left.Name
                    elemType = this.ListElemGet("__local__", vn5)
                }
            }
            if (String_Length(elemType) > 0) {
                return "(" + elemType + ")AmalgameList_get(" + listExpr + ", " + idx0 + ")"
            }
            return "(void*)AmalgameList_get(" + listExpr + ", " + idx0 + ")"
        }
        if (mname == "IsEmpty") {
            return "AmalgameList_isEmpty(" + listExpr + ")"
        }
        if (mname == "Remove") {
            let argc = callExpr.Args.Count()
            if (argc > 0) {
                let arg0 = this.EmitExprStr(callExpr.Args.Get(0))
                return "AmalgameList_remove(" + listExpr + ", (void*)(intptr_t)(" + arg0 + "))"
            }
        }
        if (mname == "RemoveAt") {
            let argc = callExpr.Args.Count()
            if (argc > 0) {
                let arg0 = this.EmitExprStr(callExpr.Args.Get(0))
                return "AmalgameList_removeAt(" + listExpr + ", " + arg0 + ")"
            }
        }
        return ""
    }

    private string EmitCalleeStr(AstNode callee) {
        if (callee == null) { return "NULL" }
        let k = callee.Kind
        if (k == NodeKind.IDENTIFIER) { return callee.Name }
        if (k == NodeKind.MEMBER) {
            let mname = callee.Name
            if (callee.Left != null) {
                let lk = callee.Left.Kind
                if (lk == NodeKind.THIS_EXPR) {
                    // this.Method() → CurrentClass_Method (includes class name)
                    return this.CurrentClass + "_" + mname
                }
                // String literal receiver: `"foo".Trim()` → String_Trim("foo")
                if (lk == NodeKind.LITERAL_STRING) {
                    return "String_" + mname
                }
                if (lk == NodeKind.IDENTIFIER) {
                    let tname = callee.Left.Name
                    let firstChar = String_Substring(tname, 0, 1)
                    let isUpper = firstChar == String_ToUpper(firstChar)
                    if (isUpper) {
                        // Stdlib classes are never namespace-prefixed
                        let isStdlib = tname == "Console" || tname == "File" || tname == "Math" || tname == "String" || tname == "List" || tname == "Env"
                        if (isStdlib) {
                            return tname + "_" + mname
                        }
                        // Static call: ClassName.Method → Ns_ClassName_Method
                        return this.SymName(tname) + "_" + mname
                    }
                    // Instance call on known-type variable: look up field type of obj
                    let varType = this.LocalTypeGet(tname)
                    let bareType = String_Replace(varType, "*", "")
                    if (String_Length(bareType) > 0) {
                        // `s.Length()` on a string variable should call
                        // `String_Length(s)`, not `code_string_Length(s)`.
                        // `code_string` is the legacy C typedef (the
                        // language used to be called "code" before it was
                        // renamed Amalgame); the runtime helpers are under
                        // the `String_` prefix.
                        if (bareType == "code_string") {
                            return "String_" + mname
                        }
                        return bareType + "_" + mname
                    }
                    // Fallback: obj_Method (simplified)
                    return tname + "_" + mname
                }
                // this.Field.Method() → detect field type → FieldType_Method
                if (lk == NodeKind.MEMBER) {
                    if (callee.Left.Left != null) {
                        let llk = callee.Left.Left.Kind
                        if (llk == NodeKind.THIS_EXPR) {
                            let fname = callee.Left.Name
                            let ftype = this.FieldTypeGet(this.CurrentClass, fname)
                            let bare  = String_Replace(ftype, "*", "")
                            if (String_Length(bare) > 0) {
                                return bare + "_" + mname
                            }
                        }
                    }
                }
            }
            let target = this.EmitExprStr(callee.Left)
            return target + "_" + mname
        }
        return this.EmitExprStr(callee)
    }

    // ── Type mapping ──────────────────────────────────

    private bool IsEnum(string t) {
        let n = this.EnumNames.Count()
        for i in 0..n {
            let e = this.EnumNames.Get(i)
            if (e == t) { return true }
        }
        return false
    }

    private string TypeToC(string t) {
        if (t == "int")    { return "i64" }
        if (t == "float")  { return "double" }
        if (t == "bool")   { return "code_bool" }
        if (t == "string") { return "code_string" }
        if (t == "void")   { return "void" }
        if (t == "")       { return "void" }
        // Array types: string[] → code_string*, int[] → i64*, etc.
        if (String_EndsWith(t, "[]")) {
            let inner = String_Substring(t, 0, String_Length(t) - 2)
            return this.TypeToC(inner) + "*"
        }
        if (String_EndsWith(t, "?")) {
            // The `?` is purely a typechecker concern (the pointer can be
            // NULL). All non-primitive Amalgame types lower to a C pointer
            // already, so `Box?` stays `Box*` rather than becoming `Box**`.
            // Primitives lose their nullability at the C level — accepted
            // limitation, matches the pre-`?`-token behaviour.
            let inner = String_Substring(t, 0, String_Length(t) - 1)
            return this.TypeToC(inner)
        }
        if (String_StartsWith(t, "List<")) {
            return "AmalgameList*"
        }
        if (String_StartsWith(t, "Map<")) {
            return "AmalgameMap*"
        }
        if (String_StartsWith(t, "Set<")) {
            return "AmalgameSet*"
        }
        if (t == "List") { return "AmalgameList*" }
        if (t == "Map")  { return "AmalgameMap*" }
        if (t == "Set")  { return "AmalgameSet*" }
        if (this.IsEnum(t)) {
            return this.SymName(t)
        }
        let sym = this.SymName(t)
        // Single uppercase letter = generic type parameter → use void*
        if (String_Length(t) == 1) {
            let fc = String_Substring(t, 0, 1)
            let isUp = fc == String_ToUpper(fc)
            if (isUp) { return "void*" }
        }
        if (this.IsEnum(sym)) {
            return sym
        }
        // Check if algebraic enum (tagged union) — value type, no pointer
        let algKey = "__alg__" + sym
        let en2 = this.EnumNames.Count()
        for ei2 in 0..en2 {
            if (this.EnumNames.Get(ei2) == algKey) { return sym }
        }
        return sym + "*"
    }
}
