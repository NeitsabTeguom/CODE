namespace Amalgame.Compiler

import Amalgame.Collections
import Amalgame.String

// ── C Code Emitter ────────────────────────────────────
public class Emitter {
    private Lines:    List<string>
    private Indent:   int
    private Streaming: bool   // write directly to file via File_StreamLine

    public Emitter() {
        this.Lines     = new List<string>()
        this.Indent    = 0
        this.Streaming = false
    }

    public void SetStreaming(bool v) { this.Streaming = v }

    public void Emit(string text) {
        if (this.Streaming) {
            File.StreamLine(text)
        } else {
            this.Lines.Add(text)
        }
    }

    public void EmitLine(string text) {
        var line = ""
        let i = this.Indent
        for k in 0..i {
            line = line + "    "
        }
        line = line + text
        if (this.Streaming) {
            File.StreamLine(line)
        } else {
            this.Lines.Add(line)
        }
    }

    public void EmitBlank() {
        if (this.Streaming) {
            File.StreamLine("")
        } else {
            this.Lines.Add("")
        }
    }

    public void Indent_() {
        this.Indent = this.Indent + 1
    }

    public void Dedent() {
        this.Indent = this.Indent - 1
    }

    public string GetOutput() {
        var result = ""
        let count = this.Lines.Count()
        for i in 0..count {
            let line = this.Lines.Get(i)
            result = result + line + "\n"
        }
        return result
    }
}

// ── C Generator ───────────────────────────────────────
public class CGen {
    public  Out:            Emitter
    private NsPrefix:       string
    // Type inference: two parallel lists — var name → C type
    private LocalTypeNames: List<string>
    private LocalTypeCType: List<string>
    // Current class being emitted (for this.Field list element type lookup)
    private CurrentClass:   string
    private CurrentRetType: string
    // Field types: two parallel lists — "ClassName.FieldName" → C type
    private FieldNames:     List<string>
    private FieldCTypes:    List<string>
    // List element types: "ClassName.FieldName" → element C type (for List<T> fields)
    private ListElemNames:  List<string>
    private ListElemCTypes: List<string>
    // Enum names registered at forward-decl time (to avoid TypeToC adding *)
    private EnumNames:      List<string>
    // Method return types: "ClassName_MethodName" → C return type
    private MethodRetNames: List<string>
    private MethodRetTypes: List<string>
    // Same key, but storing the *raw* Amalgame return type ("List<int>",
    // "Map<string,int>", …) so VAR_DECL can recover the generic type
    // arguments and propagate them to local elem-type tracking.
    private MethodRetRawNames: List<string>
    private MethodRetRawTypes: List<string>
    // Lambda numbering — each lambda gets a unique id used to name the
    // generated env struct (LamEnv_N) and top-level function (lam_N_fn).
    // Phase A of pass 2 walks the AST, assigns ids, and emits the
    // top-level definitions before the regular decl loop.
    private LambdaCounter: int
    // True while emitting statements inside a lambda body block.
    // Causes RETURN_STMT emission to box the expression as void* so
    // the generated `void* lam_N_fn(...)` returns the right type.
    // Saved/restored around each lambda emit so nested lambdas (or
    // a lambda inside a regular method, etc.) don't pollute each
    // other's emit context.
    private InLambdaBody: bool

    // v0.8.0+: per-statement `#line N "foo.am"` directives so gcc/clang
    // record .am line numbers in DWARF (via DW_AT_decl_file +
    // DW_AT_decl_line on each insn). `amc dap` then forwards plain
    // DAP messages to gdb/lldb-dap and breakpoints on .am sources
    // resolve natively — no path rewriting on the wire. Each
    // AddFilePass2 caller sets CurrentSource to the file's path;
    // EmitStmt emits the directive when the source line changes
    // (avoids spamming consecutive identical directives).
    private CurrentSource:   string
    private LastLineEmitted: int

    // InferTypeFromExpr memoization (v0.8.15).
    // Without this cache, a chain like `a.AddChild(x).AddChild(y).AddChild(z)...`
    // recurses on the receiver of each call, re-inferring the whole
    // chain up to the leftmost expression every step — quadratic
    // visits, and beyond ~24 links amc effectively hangs because each
    // visit itself does string concat / list walks.
    //
    // The cache keys nodes by their C pointer cast to i64 — AstNode
    // identity is stable within a single compilation. Parallel
    // List<i64>/List<string> rather than AmalgameMap so we don't have
    // to introduce a new generic-key map shape just for this.
    private InferCacheKeys: List<int>
    private InferCacheVals: List<string>

    // v0.5 package-manager: each external package's class +
    // functions feed the isStdlib check (ClassName), return-type
    // table (Func → CRetType), and prelude #include emission
    // (Header). Parallel lists, same pattern as the resolver
    // (PR 3c). Empty lists = no installed packages = no-op.
    public PkgClasses:    List<string>
    public PkgFuncs:      List<string>
    public PkgFuncCTypes: List<string>
    public PkgHeaders:    List<string>
    // Parallel to PkgClasses: stores the namespace each registered
    // class came from (e.g. "Amalgame.Database.NoSQL.Redis"), so
    // the isStdlib short-circuit can mangle calls correctly.
    public PkgClassNs:    List<string>

    // Project F (v0.7.5+): external files registered via --external.
    // Short class names + their own mangled-ns prefix. Call sites
    // route through ExternalClassMangled() before the regular
    // SymName / isCoreStdlib / PkgClassMangledPrefix paths. Class
    // definitions (struct body + methods) are NOT emitted for these
    // — they land at link time from libamalgame.a.
    public ExternalClasses:    List<string>
    public ExternalClassNsArr: List<string>

    public CGen() {
        this.Out            = new Emitter()
        this.NsPrefix       = ""
        this.LocalTypeNames = new List<string>()
        this.LocalTypeCType = new List<string>()
        this.CurrentClass   = ""
        this.CurrentRetType = ""
        this.FieldNames     = new List<string>()
        this.FieldCTypes    = new List<string>()
        this.ListElemNames  = new List<string>()
        this.ListElemCTypes = new List<string>()
        this.EnumNames      = new List<string>()
        this.MethodRetNames = new List<string>()
        this.MethodRetTypes = new List<string>()
        this.MethodRetRawNames = new List<string>()
        this.MethodRetRawTypes = new List<string>()
        this.LambdaCounter     = 0
        this.InLambdaBody      = false
        this.PkgClasses        = new List<string>()
        this.PkgFuncs          = new List<string>()
        this.PkgFuncCTypes     = new List<string>()
        this.PkgHeaders        = new List<string>()
        this.PkgClassNs        = new List<string>()
        this.ExternalClasses   = new List<string>()
        this.ExternalClassNsArr = new List<string>()
        this.CurrentSource     = ""
        this.LastLineEmitted   = -1
        this.InferCacheKeys    = new List<int>()
        this.InferCacheVals    = new List<string>()
        // Pre-register stdlib struct fields
        this.FieldTypeSet("AmalgameHttpResponse", "Status", "i64")
        this.FieldTypeSet("AmalgameHttpResponse", "Body",   "code_string")
        this.FieldTypeSet("AmalgameHttpResponse", "Error",  "code_string")
        this.FieldTypeSet("AmalgameHttpResponse", "Ok",     "code_bool")
        this.FieldTypeSet("AmalgameTcpConn",      "RemoteIp", "code_string")
        this.FieldTypeSet("AmalgameTcpConn",      "Fd",       "i64")
        this.FieldTypeSet("AmalgameTcpServer",    "Fd",       "i64")
        this.FieldTypeSet("AmalgameTcpServer",    "Port",     "i64")
        this.FieldTypeSet("AmalgameProcessResult", "Exit",   "i64")
        this.FieldTypeSet("AmalgameProcessResult", "Stdout", "code_string")
        this.FieldTypeSet("AmalgameProcessResult", "Stderr", "code_string")
    }

    public string Generate(AstNode prog) {
        let ns = prog.Str
        if (String_Length(ns) > 0) {
            this.NsPrefix = String_Replace(ns, ".", "_")
        }
        this.EmitHeader()
        let decls = prog.Children.Count()
        for i in 0..decls {
            let decl = prog.Children.Get(i)
            this.EmitForwardDecl(decl)
        }
        this.Out.EmitBlank()
        // Forward-declare every constructor before any class body —
        // see AddFilePass2 for the rationale.
        this.EmitConstructorForwards(prog)
        this.Out.EmitBlank()
        for j in 0..decls {
            let decl = prog.Children.Get(j)
            this.EmitDecl(decl)
        }
        return this.Out.GetOutput()
    }

    // Multi-file support: call BeginMulti() once, then AddFile() per file, then FinishMulti()
    public void SetStreaming(bool v) {
        this.Out.SetStreaming(v)
    }

    public void BeginMulti(string ns) {
        if (String_Length(ns) > 0) {
            this.NsPrefix = String_Replace(ns, ".", "_")
        }
        this.EmitHeader()
    }

    public void AddFilePass1(AstNode prog) {
        let decls = prog.Children.Count()
        for i in 0..decls {
            let decl = prog.Children.Get(i)
            this.EmitForwardDecl(decl)
        }
    }

    public void EmitSeparator() {
        this.Out.EmitBlank()
    }

    public void AddFilePass2(AstNode prog, string sourcePath) {
        // v0.8.0+: track the current source path so EmitStmt can prefix
        // each lowered statement with `#line N "<path>"`. Reset the
        // last-line cache per file so the first statement always
        // emits a directive.
        this.CurrentSource   = sourcePath
        this.LastLineEmitted = -1
        // Phase A0 — forward-declare every class's `_new(...)` constructor
        // signature, BEFORE any class body is emitted. Without this, a
        // constructor whose body calls `new B(...)` on a class declared
        // later in the file (or even just below in the same file) hits
        // an implicit-decl / conflicting-types pair in gcc, since pass 2
        // emits decls top-to-bottom and class B's `_new` only appears
        // when B's body is reached. All Pass-1 typedefs are visible by
        // now, so the parameter types resolve cleanly.
        this.EmitConstructorForwards(prog)
        // Phase A — assign ids and emit env struct + forward decl for
        // every lambda in this file, BEFORE any decl bodies that may
        // reference them. The fn bodies themselves come last so they
        // can dereference fields on class structs (like u->Name) whose
        // bodies are emitted in Phase B. The walker descends into all
        // child/list fields generically so any lambda position the
        // parser produces is covered.
        this.EmitLambdaForwards(prog)
        // Phase B — regular decl emission (class struct bodies + method bodies).
        let decls = prog.Children.Count()
        for j in 0..decls {
            let decl = prog.Children.Get(j)
            this.EmitDecl(decl)
        }
        // Phase C — emit each lambda fn body. Class struct bodies are
        // now visible, so typed param unboxing (e.g. `Probe_User* u =
        // (Probe_User*)__arg0;` followed by `u->Name`) lowers cleanly.
        this.EmitLambdaBodies(prog)
    }

    private void EmitConstructorForwards(AstNode prog) {
        let decls = prog.Children.Count()
        for i in 0..decls {
            let decl = prog.Children.Get(i)
            if (decl.Kind == NodeKind.CLASS_DECL) {
                let name = this.SymName(decl.Name)
                var ctorFound = false
                let members = decl.Children.Count()
                for j in 0..members {
                    let m = decl.Children.Get(j)
                    if (m.Kind == NodeKind.METHOD_DECL && m.Name == decl.Name) {
                        ctorFound = true
                        var sig = name + "* " + name + "_new("
                        let pcount = m.Params.Count()
                        var first = true
                        for pi in 0..pcount {
                            let p = m.Params.Get(pi)
                            if (!first) { sig = sig + ", " }
                            sig = sig + this.TypeToC(p.Str) + " " + p.Name
                            first = false
                        }
                        sig = sig + ");"
                        this.Out.EmitLine(sig)
                    }
                }
                // Class without an explicit constructor still gets a
                // no-arg `Name_new()` from EmitClass — forward-declare
                // that too so peer constructors can call `new Name()`.
                if (!ctorFound) {
                    this.Out.EmitLine(name + "* " + name + "_new();")
                }
            }
        }
    }

    // ── Lambda discovery & top-level emission ─────────
    //
    // v2.5 splits emission in two: forwards (env struct + fn forward
    // decl) before class struct bodies, and bodies (fn definition)
    // after them. This lets typed param unboxing dereference fields
    // on user classes (`u->Name` where u is `Probe_User*`).
    private void EmitLambdaForwards(AstNode node) {
        if (node == null) { return }
        if (node.Kind == NodeKind.METHOD_DECL && node.Name == "__lambda__") {
            this.EmitOneLambdaForward(node)
        }
        if (node.Left  != null) { this.EmitLambdaForwards(node.Left) }
        if (node.Right != null) { this.EmitLambdaForwards(node.Right) }
        if (node.Cond  != null) { this.EmitLambdaForwards(node.Cond) }
        if (node.Body  != null) { this.EmitLambdaForwards(node.Body) }
        if (node.Else  != null) { this.EmitLambdaForwards(node.Else) }
        let cn = node.Children.Count()
        for i in 0..cn {
            this.EmitLambdaForwards(node.Children.Get(i))
        }
        let pn = node.Params.Count()
        for j in 0..pn {
            this.EmitLambdaForwards(node.Params.Get(j))
        }
        let an = node.Args.Count()
        for k in 0..an {
            this.EmitLambdaForwards(node.Args.Get(k))
        }
    }

    private void EmitLambdaBodies(AstNode node) {
        if (node == null) { return }
        if (node.Kind == NodeKind.METHOD_DECL && node.Name == "__lambda__") {
            this.EmitOneLambdaBody(node)
        }
        if (node.Left  != null) { this.EmitLambdaBodies(node.Left) }
        if (node.Right != null) { this.EmitLambdaBodies(node.Right) }
        if (node.Cond  != null) { this.EmitLambdaBodies(node.Cond) }
        if (node.Body  != null) { this.EmitLambdaBodies(node.Body) }
        if (node.Else  != null) { this.EmitLambdaBodies(node.Else) }
        let cn = node.Children.Count()
        for i in 0..cn {
            this.EmitLambdaBodies(node.Children.Get(i))
        }
        let pn = node.Params.Count()
        for j in 0..pn {
            this.EmitLambdaBodies(node.Params.Get(j))
        }
        let an = node.Args.Count()
        for k in 0..an {
            this.EmitLambdaBodies(node.Args.Get(k))
        }
    }

    // Phase A — assign id, emit env struct + fn forward decl. The id
    // (lam.Str2) is set here so call sites in Phase B can reference
    // lam_N_fn by name.
    private void EmitOneLambdaForward(AstNode lam) {
        let id      = this.LambdaCounter
        this.LambdaCounter = id + 1
        let idStr   = String_FromInt(id)
        lam.Str2    = idStr
        let envName = "LamEnv_" + idStr
        let fnName  = "lam_" + idStr + "_fn"
        let cn: int = lam.Args.Count()
        let pn: int = lam.Params.Count()
        // Emit env struct (always, even when empty — keeps the
        // allocation site uniform).
        this.Out.EmitLine("typedef struct " + envName + " {")
        this.Out.Indent_()
        if (cn == 0) {
            this.Out.EmitLine("char _empty;")
        } else {
            for i in 0..cn {
                let cap = lam.Args.Get(i)
                let ct  = this.TypeToC(cap.Str)
                if (String_Length(ct) == 0 || ct == "void") {
                    this.Out.EmitLine("void* _" + cap.Name + ";")
                } else {
                    this.Out.EmitLine(ct + " _" + cap.Name + ";")
                }
            }
        }
        this.Out.Dedent()
        this.Out.EmitLine("} " + envName + ";")
        // Forward decl of the fn — body comes in Phase C after class
        // struct bodies are emitted.
        var fwdLine = "static void* " + fnName + "(void* __envRaw"
        for pi in 0..pn {
            fwdLine = fwdLine + ", void* __arg" + String_FromInt(pi)
        }
        fwdLine = fwdLine + ");"
        this.Out.EmitLine(fwdLine)
    }

    // Phase C — emit the fn body. The id (lam.Str2) was set in Phase A.
    private void EmitOneLambdaBody(AstNode lam) {
        let idStr   = lam.Str2
        let envName = "LamEnv_" + idStr
        let fnName  = "lam_" + idStr + "_fn"
        let cn: int = lam.Args.Count()
        let pn: int = lam.Params.Count()
        // Emit top-level fn definition. Signature is `void*
        // lam_N_fn(void* env, void* arg0, void* arg1, ...)` — args and
        // result are passed as void*, matching the AmalgameClosure
        // ABI. v2.5 honours each PARAM's annotated type (set by the
        // resolver from the higher-order callsite, e.g.
        // List<User>.Map's lambda gets its first param typed `User`)
        // so member access like x.Name lowers correctly. Pointer-typed
        // params cast directly from void*; scalar-typed params still
        // go through intptr_t.
        var sigLine = "static void* " + fnName + "(void* __envRaw"
        for pi in 0..pn {
            sigLine = sigLine + ", void* __arg" + String_FromInt(pi)
        }
        sigLine = sigLine + ") {"
        this.Out.EmitLine(sigLine)
        this.Out.Indent_()
        this.Out.EmitLine(envName + "* __env = (" + envName + "*)__envRaw;")
        // Unpack params using their annotated type when available.
        for pi in 0..pn {
            let p = lam.Params.Get(pi)
            let pTypeRaw = p.Str
            var pTypeC: string = "i64"
            if (String_Length(pTypeRaw) > 0 && pTypeRaw != "?") {
                pTypeC = this.TypeToC(pTypeRaw)
            }
            let argName = "__arg" + String_FromInt(pi)
            if (this.IsCPointerType(pTypeC)) {
                this.Out.EmitLine(pTypeC + " " + p.Name + " = (" + pTypeC + ")" + argName + ";")
            } else {
                this.Out.EmitLine(pTypeC + " " + p.Name + " = " + this.UnboxScalar(pTypeC, argName) + ";")
            }
        }
        // Unpack captures into local C vars so the body emits naturally.
        for i in 0..cn {
            let cap = lam.Args.Get(i)
            let ct  = this.TypeToC(cap.Str)
            if (String_Length(ct) == 0 || ct == "void") {
                this.Out.EmitLine("void* " + cap.Name + " = __env->_" + cap.Name + ";")
            } else {
                this.Out.EmitLine(ct + " " + cap.Name + " = __env->_" + cap.Name + ";")
            }
            this.LocalTypeSet(cap.Name, ct)
        }
        // Param types too — the local-type table is consulted by
        // identifier emission so x.Field lookups work. v2.5 honours
        // p.Str (set by the resolver) instead of always pinning to i64.
        for pi in 0..pn {
            let p = lam.Params.Get(pi)
            let pTypeRaw = p.Str
            var pTypeC: string = "i64"
            if (String_Length(pTypeRaw) > 0 && pTypeRaw != "?") {
                pTypeC = this.TypeToC(pTypeRaw)
            }
            this.LocalTypeSet(p.Name, pTypeC)
        }
        // Body — either an expression in Left, or a block in Body.
        // Block bodies push InLambdaBody so any RETURN_STMT inside
        // boxes its value as void*; the trailing default return is
        // there in case the block falls through without returning.
        if (lam.Body != null) {
            let prevInLam = this.InLambdaBody
            this.InLambdaBody = true
            this.EmitBlock(lam.Body)
            this.InLambdaBody = prevInLam
            this.Out.EmitLine("return " + this.BoxAsVoid("0") + ";")
        } else if (lam.Left != null) {
            let bodyStr = this.EmitExprStr(lam.Left)
            this.Out.EmitLine("return " + this.BoxAsVoid(bodyStr) + ";")
        } else {
            this.Out.EmitLine("return " + this.BoxAsVoid("0") + ";")
        }
        // Reset local-type entries so subsequent emission isn't polluted.
        for pi in 0..pn {
            let p = lam.Params.Get(pi)
            this.LocalTypeSet(p.Name, "")
        }
        for i in 0..cn {
            let cap = lam.Args.Get(i)
            this.LocalTypeSet(cap.Name, "")
        }
        this.Out.Dedent()
        this.Out.EmitLine("}")
    }

    public string FinishMulti() {
        return this.Out.GetOutput()
    }

    public List<string> GetLines() {
        return this.Out.Lines
    }

    private string SymName(string name) {
        let ns = this.NsPrefix
        if (String_Length(ns) > 0) {
            return ns + "_" + name
        }
        return name
    }

    // ── Local type table ──────────────────────────────
    // Since Amalgame has no Map<string,string> in bootstrap,
    // we use two parallel lists as a poor-man's dictionary.

    private void LocalTypeSet(string varName, string ctype) {
        let n = this.LocalTypeNames.Count()
        for i in 0..n {
            let k = this.LocalTypeNames.Get(i)
            if (k == varName) {
                // update in place — replace by removing and re-adding at same index is not possible,
                // so we overwrite using the Add trick: mark old as "" then add new pair
                // Simplest: just append — lookup finds the last match
                this.LocalTypeNames.Add(varName)
                this.LocalTypeCType.Add(ctype)
                return
            }
        }
        this.LocalTypeNames.Add(varName)
        this.LocalTypeCType.Add(ctype)
    }

    private string LocalTypeGet(string varName) {
        // Search from end so later writes shadow earlier ones
        let n = this.LocalTypeNames.Count()
        var result = ""
        for i in 0..n {
            let k = this.LocalTypeNames.Get(i)
            if (k == varName) {
                result = this.LocalTypeCType.Get(i)
            }
        }
        return result
    }

    private void LocalTypeClear() {
        this.LocalTypeNames = new List<string>()
        this.LocalTypeCType = new List<string>()
    }

    private void FieldTypeSet(string className, string fieldName, string ctype) {
        let key = className + "." + fieldName
        this.FieldNames.Add(key)
        this.FieldCTypes.Add(ctype)
    }

    private string FieldTypeGet(string className, string fieldName) {
        let key = className + "." + fieldName
        let n = this.FieldNames.Count()
        var result = ""
        for i in 0..n {
            let k = this.FieldNames.Get(i)
            if (k == key) {
                result = this.FieldCTypes.Get(i)
            }
        }
        return result
    }

    // For `let names = users.Map(u => u.Name)`, the result list's
    // element type is the lambda's return type — NOT the receiver's
    // element type. We push the lambda params into LocalTypes so
    // InferTypeFromExpr can resolve `u.Name` against the param's
    // annotated type, then pop them. Lives as its own helper so the
    // self-host CGen sees PARAM access through typed AstNode locals
    // (avoids void* erasure across chained `.Get(i)` calls).
    private void TrackMapResultElem(AstNode stmt) {
        let call: AstNode = stmt.Left
        if (call == null) { return }
        if (call.Args.Count() == 0) { return }
        let lam: AstNode = call.Args.Get(0)
        if (lam == null) { return }
        if (lam.Kind != NodeKind.METHOD_DECL) { return }
        if (lam.Name != "__lambda__") { return }
        if (lam.Left == null) { return }
        let pn: int = lam.Params.Count()
        for pi in 0..pn {
            let p: AstNode = lam.Params.Get(pi)
            let pTypeRaw: string = p.Str
            var pTypeC: string = "i64"
            if (String_Length(pTypeRaw) > 0 && pTypeRaw != "?") {
                pTypeC = this.TypeToC(pTypeRaw)
            }
            this.LocalTypeSet(p.Name, pTypeC)
        }
        let retC: string = this.InferTypeFromExpr(lam.Left)
        for pi in 0..pn {
            let p: AstNode = lam.Params.Get(pi)
            this.LocalTypeSet(p.Name, "")
        }
        if (String_Length(retC) > 0 && retC != "void*") {
            this.ListElemSet("__local__", stmt.Name, retC)
        }
    }

    // Record the elem (List<T>) or value (Map<K,V>) type for a local
    // variable, given the raw Amalgame type annotation. No-op when the
    // type isn't generic. Used at VAR_DECL emission for both NEW_EXPR
    // RHS, explicit `: List<int>` annotations, and inferred return types
    // from method calls.
    private void TrackGenericLocal(string varName, string rawType) {
        if (String_StartsWith(rawType, "List<") && String_EndsWith(rawType, ">")) {
            let inner = String_Substring(rawType, 5, String_Length(rawType) - 6)
            if (String_Length(inner) > 0) {
                this.ListElemSet("__local__", varName, this.TypeToC(inner))
            }
            return
        }
        if (String_StartsWith(rawType, "Map<") && String_EndsWith(rawType, ">")) {
            let inner = String_Substring(rawType, 4, String_Length(rawType) - 5)
            let comma = String_IndexOf(inner, ",")
            if (comma > 0) {
                let vRaw  = String_Substring(inner, comma + 1, String_Length(inner) - comma - 1)
                let vTrim = String_Trim(vRaw)
                if (String_Length(vTrim) > 0) {
                    this.ListElemSet("__local_map__", varName, this.TypeToC(vTrim))
                }
            }
        }
    }

    private void ListElemSet(string className, string fieldName, string elemCType) {
