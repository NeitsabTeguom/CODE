namespace Amalgame.Compiler

import Amalgame.Collections
import Amalgame.IO
import Amalgame.String

public class Program {
    public static void Main(string[] args) {
        // Parse each compiler source once — gen6 produces the single bundle
        // amc_lib.c that becomes the amc binary in build_amc.sh Step 3.
        let tokPath = "./src/lexer/token.am"
        let tokSrc  = File.ReadAll(tokPath)
        let tokLex  = new Lexer(tokSrc, tokPath)
        let tokToks = tokLex.Tokenize()
        let tokPar  = new Parser(tokToks)
        let tokProg = tokPar.Parse()

        let astPath = "./src/parser/ast.am"
        let astSrc  = File.ReadAll(astPath)
        let astLex  = new Lexer(astSrc, astPath)
        let astToks = astLex.Tokenize()
        let astPar  = new Parser(astToks)
        let astProg = astPar.Parse()

        let lexPath = "./src/lexer/lexer.am"
        let lexSrc  = File.ReadAll(lexPath)
        let lexLex  = new Lexer(lexSrc, lexPath)
        let lexToks = lexLex.Tokenize()
        let lexPar  = new Parser(lexToks)
        let lexProg = lexPar.Parse()

        let parPath = "./src/parser/parser.am"
        let parSrc  = File.ReadAll(parPath)
        let parLex  = new Lexer(parSrc, parPath)
        let parToks = parLex.Tokenize()
        let parPar  = new Parser(parToks)
        let parProg = parPar.Parse()

        let cgenPath = "./src/generator/c_gen.am"
        let cgenSrc  = File.ReadAll(cgenPath)
        let cgenLex  = new Lexer(cgenSrc, cgenPath)
        let cgenToks = cgenLex.Tokenize()
        let cgenPar  = new Parser(cgenToks)
        let cgenProg = cgenPar.Parse()

        let fmtPath  = "./src/formatter/formatter.am"
        let fmtSrc   = File.ReadAll(fmtPath)
        let fmtLex   = new Lexer(fmtSrc, fmtPath)
        let fmtToks  = fmtLex.Tokenize()
        let fmtPar   = new Parser(fmtToks)
        let fmtProg  = fmtPar.Parse()

        // --- Full amc lib (streaming) ---
        Console.WriteError("parsing extra files...")
        let symPath  = "./src/resolver/symbol.am"
        let symSrc   = File.ReadAll(symPath)
        let symLex   = new Lexer(symSrc, symPath)
        let symToks  = symLex.Tokenize()
        let symPar   = new Parser(symToks)
        let symProg  = symPar.Parse()
        Console.WriteError("parsed: symbol.am")

        let rvrPath  = "./src/resolver/resolver.am"
        let rvrSrc   = File.ReadAll(rvrPath)
        let rvrLex   = new Lexer(rvrSrc, rvrPath)
        let rvrToks  = rvrLex.Tokenize()
        let rvrPar   = new Parser(rvrToks)
        let rvrProg  = rvrPar.Parse()
        Console.WriteError("parsed: resolver.am")

        let diagPath = "./src/diagnostics.am"
        let diagSrc  = File.ReadAll(diagPath)
        let diagLex  = new Lexer(diagSrc, diagPath)
        let diagToks = diagLex.Tokenize()
        let diagPar  = new Parser(diagToks)
        let diagProg = diagPar.Parse()
        Console.WriteError("parsed: diagnostics.am")

        let tckPath  = "./src/typechecker.am"
        let tckSrc   = File.ReadAll(tckPath)
        let tckLex   = new Lexer(tckSrc, tckPath)
        let tckToks  = tckLex.Tokenize()
        let tckPar   = new Parser(tckToks)
        let tckProg  = tckPar.Parse()
        Console.WriteError("parsed: typechecker.am")

        let lintPath = "./src/linter.am"
        let lintSrc  = File.ReadAll(lintPath)
        let lintLex  = new Lexer(lintSrc, lintPath)
        let lintToks = lintLex.Tokenize()
        let lintPar  = new Parser(lintToks)
        let lintProg = lintPar.Parse()
        Console.WriteError("parsed: linter.am")

        // Json stdlib — must come before lsp.am / migrate.am which
        // (in phase 2) call into Json.Parse / Json.EscapeString.
        let jsonPath = "./src/stdlib/json.am"
        let jsonSrc  = File.ReadAll(jsonPath)
        let jsonLex  = new Lexer(jsonSrc, jsonPath)
        let jsonToks = jsonLex.Tokenize()
        let jsonPar  = new Parser(jsonToks)
        let jsonProg = jsonPar.Parse()
        Console.WriteError("parsed: stdlib/json.am")

        // Random stdlib — pure-Amalgame facade over the PCG +
        // OS-entropy helpers in runtime/Amalgame_Random.h.
        let rndPath  = "./src/stdlib/random.am"
        let rndSrc   = File.ReadAll(rndPath)
        let rndLex   = new Lexer(rndSrc, rndPath)
        let rndToks  = rndLex.Tokenize()
        let rndPar   = new Parser(rndToks)
        let rndProg  = rndPar.Parse()
        Console.WriteError("parsed: stdlib/random.am")

        let lspPath  = "./src/lsp.am"
        let lspSrc   = File.ReadAll(lspPath)
        let lspLex   = new Lexer(lspSrc, lspPath)
        let lspToks  = lspLex.Tokenize()
        let lspPar   = new Parser(lspToks)
        let lspProg  = lspPar.Parse()
        Console.WriteError("parsed: lsp.am")

        let migPath  = "./src/migrate.am"
        let migSrc   = File.ReadAll(migPath)
        let migLex   = new Lexer(migSrc, migPath)
        let migToks  = migLex.Tokenize()
        let migPar   = new Parser(migToks)
        let migProg  = migPar.Parse()
        Console.WriteError("parsed: migrate.am")

        let genPath  = "./src/generate.am"
        let genSrc   = File.ReadAll(genPath)
        let genLex   = new Lexer(genSrc, genPath)
        let genToks  = genLex.Tokenize()
        let genPar   = new Parser(genToks)
        let genProg  = genPar.Parse()
        Console.WriteError("parsed: generate.am")

        let expPath  = "./src/explain.am"
        let expSrc   = File.ReadAll(expPath)
        let expLex   = new Lexer(expSrc, expPath)
        let expToks  = expLex.Tokenize()
        let expPar   = new Parser(expToks)
        let expProg  = expPar.Parse()
        Console.WriteError("parsed: explain.am")

        let newPath  = "./src/new_cmd.am"
        let newSrc   = File.ReadAll(newPath)
        let newLex   = new Lexer(newSrc, newPath)
        let newToks  = newLex.Tokenize()
        let newPar   = new Parser(newToks)
        let newProg  = newPar.Parse()
        Console.WriteError("parsed: new_cmd.am")

        let mainPath = "./src/main.am"
        let mainSrc  = File.ReadAll(mainPath)
        let mainLex  = new Lexer(mainSrc, mainPath)
        let mainToks = mainLex.Tokenize()
        let mainPar  = new Parser(mainToks)
        let mainProg = mainPar.Parse()
        Console.WriteError("parsed: main.am")

        Console.WriteError("gen6: starting")
        Console.WriteError("parsing done, generating...")
        let out6 = "./src/amc_lib.c"
        File.OpenWrite(out6)
        let gen6 = new CGen()
        gen6.SetStreaming(true)
        gen6.BeginMulti("Amalgame.Compiler")
        // diagnostics.am defines SourceMap/SourceSnippet, used by resolver+typechecker.
        // The bootstrap CGen only emits struct typedefs in Pass 1; method forward
        // decls and bodies are emitted file-by-file in Pass 2, so dependents must
        // come AFTER diagnostics in this list.
        gen6.AddFilePass1(tokProg)
        gen6.AddFilePass1(astProg)
        gen6.AddFilePass1(lexProg)
        gen6.AddFilePass1(parProg)
        gen6.AddFilePass1(cgenProg)
        gen6.AddFilePass1(fmtProg)
        gen6.AddFilePass1(diagProg)
        gen6.AddFilePass1(symProg)
        gen6.AddFilePass1(rvrProg)
        gen6.AddFilePass1(tckProg)
        gen6.AddFilePass1(lintProg)
        gen6.AddFilePass1(jsonProg)
        gen6.AddFilePass1(rndProg)
        gen6.AddFilePass1(lspProg)
        gen6.AddFilePass1(migProg)
        gen6.AddFilePass1(genProg)
        gen6.AddFilePass1(expProg)
        gen6.AddFilePass1(newProg)
        gen6.AddFilePass1(mainProg)
        gen6.EmitSeparator()
        Console.WriteError("gen6: pass1 done, starting pass2")
        gen6.AddFilePass2(tokProg)
        gen6.AddFilePass2(astProg)
        gen6.AddFilePass2(lexProg)
        gen6.AddFilePass2(parProg)
        gen6.AddFilePass2(cgenProg)
        gen6.AddFilePass2(fmtProg)
        gen6.AddFilePass2(diagProg)
        gen6.AddFilePass2(symProg)
        gen6.AddFilePass2(rvrProg)
        gen6.AddFilePass2(tckProg)
        gen6.AddFilePass2(lintProg)
        gen6.AddFilePass2(jsonProg)
        gen6.AddFilePass2(rndProg)
        gen6.AddFilePass2(lspProg)
        gen6.AddFilePass2(migProg)
        gen6.AddFilePass2(genProg)
        gen6.AddFilePass2(expProg)
        gen6.AddFilePass2(newProg)
        gen6.AddFilePass2(mainProg)
        Console.WriteError("gen6: pass2 done")
        // Emit the C entry point that boots Amalgame's Program.Main.
        // Mirrors the wrapper main.am writes for user programs (compiler.Run).
        File.StreamLine("")
        File.StreamLine("int main(int argc, char** argv) {")
        File.StreamLine("    GC_INIT();")
        File.StreamLine("    code_runtime_init_args(argc, argv);")
        File.StreamLine("    Amalgame_Compiler_Program_Main((code_string*)argv);")
        File.StreamLine("    return code_exit_code;")
        File.StreamLine("}")
        File.CloseWrite()
        Console.WriteLine("amc_lib: → {out6}")

        Console.WriteLine("Done!")
    }
}
