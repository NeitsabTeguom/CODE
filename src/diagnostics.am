// ── ANSI color codes ──────────────────────────────────
public class Ansi {
    public static string Reset()      { return "\x1b[0m" }
    public static string Bold()       { return "\x1b[1m" }
    public static string Dim()        { return "\x1b[2m" }
    public static string Red()        { return "\x1b[31m" }
    public static string Yellow()     { return "\x1b[33m" }
    public static string Cyan()       { return "\x1b[36m" }
    public static string Green()      { return "\x1b[32m" }
    public static string Blue()       { return "\x1b[34m" }
    public static string BoldRed()    { return "\x1b[1;31m" }
    public static string BoldYellow() { return "\x1b[1;33m" }
    public static string BoldCyan()   { return "\x1b[1;36m" }
    public static string BoldGreen()  { return "\x1b[1;32m" }
    public static string BoldBlue()   { return "\x1b[1;34m" }
}

// ── Source map ────────────────────────────────────────
// Holds the original source text of every loaded file so error formatters
// can quote the offending line and underline the column with a caret.
public class SourceMap {
    private Paths: List<string>
    private Texts: List<string>
    // Per-file line cache, parallel to Paths/Texts. Each entry is the
    // file split into lines, computed lazily on the first GetLine for
    // that file (LineSplit[i] flips to true once filled). Without this,
    // GetLine walked the whole text char-by-char per call — O(filesize)
    // each, allocating a 1-char string per character. Error formatting
    // calls GetLine once per diagnostic, so an error-heavy resolve
    // (a file checked in isolation, or mid-edit in the LSP) degraded to
    // O(errors × filesize) — the dominant cost in `amc --check` on a
    // big file. Splitting once makes GetLine O(1) amortised.
    private LineCache: List<List<string>>
    private LineSplit: List<bool>

    public SourceMap() {
        this.Paths = new List<string>()
        this.Texts = new List<string>()
        this.LineCache = new List<List<string>>()
        this.LineSplit = new List<bool>()
    }

    public void Add(string path, string text) {
        let count = this.Paths.Count()
        for i in 0..count {
            if (this.Paths.Get(i) == path) { return }
        }
        this.Paths.Add(path)
        this.Texts.Add(text)
        this.LineCache.Add(new List<string>())
        this.LineSplit.Add(false)
    }

    // Returns the Nth line (1-indexed) of the given file, or "" if not found.
    public string GetLine(string path, int line) {
        let count = this.Paths.Count()
        for i in 0..count {
            if (this.Paths.Get(i) == path) {
                if (!this.LineSplit.Get(i)) {
                    this.LineCache.Set(i, String_Split(this.Texts.Get(i), "\n"))
                    this.LineSplit.Set(i, true)
                }
                let lines: List<string> = this.LineCache.Get(i)
                let idx: int = line - 1
                if (idx < 0 || idx >= lines.Count()) { return "" }
                return lines.Get(idx)
            }
        }
        return ""
    }
}

// Build a source snippet rendered with a caret under the offending column.
// Used by both Resolver and TypeChecker error formatters. Layout (rustc-like):
//
//    |
// 19 |         let n: int = p.Name
//    |             ^
//
public class SourceSnippet {
    public static string Format(string lineText, int line, int col) {
        if (String_Length(lineText) == 0) { return "" }
        let lineNum = String_FromInt(line)
        let pad     = SourceSnippet.Spaces(String_Length(lineNum))
        var caret = ""
        var c = 0
        while (c < col - 1) {
            caret = caret + " "
            c = c + 1
        }
        return pad + " |\n" + lineNum + " | " + lineText + "\n" + pad + " | " + caret + "^\n"
    }

    private static string Spaces(int n) {
        var s = ""
        var i = 0
        while (i < n) {
            s = s + " "
            i = i + 1
        }
        return s
    }
}

// ── Diagnostic severity ───────────────────────────────
public enum DiagSeverity {
    ERROR
    WARNING
    NOTE
    HINT
}

// ── Single diagnostic ─────────────────────────────────
public class Diagnostic {
    public Severity:  DiagSeverity
    public Kind:      string
    public Message:   string
    public Filename:  string
    public Line:      int
    public Column:    int

    public Diagnostic(DiagSeverity sev, string kind, string msg,
                      string file, int line, int col) {
        this.Severity  = sev
        this.Kind      = kind
        this.Message   = msg
        this.Filename  = file
        this.Line      = line
        this.Column    = col
    }
}

// ── DiagnosticFormatter ───────────────────────────────
public class DiagnosticFormatter {
    private UseColor: bool
    private Quiet:    bool
    public  Sources:  SourceMap   // Public so other passes can render snippets

    public DiagnosticFormatter() {
        this.UseColor = false
        this.Quiet    = false
        this.Sources  = new SourceMap()
    }

    public void EnableColor(bool v) { this.UseColor = v }
    public void SetQuiet(bool v)    { this.Quiet    = v }

    public void LoadSource(string path, string text) {
        this.Sources.Add(path, text)
    }

    // ── Format helpers ────────────────────────────────

    private string SevLabel(DiagSeverity sev) {
        if (sev == DiagSeverity.ERROR)   { return "error" }
        if (sev == DiagSeverity.WARNING) { return "warning" }
        if (sev == DiagSeverity.NOTE)    { return "note" }
        return "hint"
    }

    // ── Main format ───────────────────────────────────

    public string FormatDiag(Diagnostic d) {
        let lineStr  = String_FromInt(d.Line)
        let colStr   = String_FromInt(d.Column)
        let label    = this.SevLabel(d.Severity)
        let header   = label + "[" + d.Kind + "]: " + d.Message
        let location = "  --> " + d.Filename + ":" + lineStr + ":" + colStr
        return "\n" + header + "\n" + location + "\n |\n"
    }

    public string FormatError(string kind, string message,
                              string filename, int line, int col) {
        let d = new Diagnostic(DiagSeverity.ERROR, kind, message, filename, line, col)
        return this.FormatDiag(d)
    }

    public string FormatWarning(string kind, string message,
                                string filename, int line, int col) {
        let d = new Diagnostic(DiagSeverity.WARNING, kind, message, filename, line, col)
        return this.FormatDiag(d)
    }

    public string FormatNote(string kind, string message,
                             string filename, int line, int col) {
        let d = new Diagnostic(DiagSeverity.NOTE, kind, message, filename, line, col)
        return this.FormatDiag(d)
    }

    // ── Phase reporting ───────────────────────────────

    public void PrintPhaseOk(string phase) {
        if (this.Quiet) { return }
        Console.WriteLine(phase + " OK")
    }

    public void PrintPhaseError(string phase, string detail) {
        Console.WriteError(phase + " ERROR")
        if (String_Length(detail) > 0) { Console.WriteError(detail) }
    }

    // Backward compat aliases
    public void PrintCompileOk(string phase) {
        this.PrintPhaseOk(phase)
    }

    public void PrintCompileError(string phase, string detail) {
        this.PrintPhaseError(phase, detail)
    }

    // ── Summary ───────────────────────────────────────

    public string FormatSummary(int errorCount, int warningCount) {
        var result = " "
        if (errorCount > 0) {
            let ec  = String_FromInt(errorCount)
            let sfx = if (errorCount > 1) { "s" } else { " " }
            result = "aborting due to " + ec + " error" + sfx
        }
        return result
    }

    public string FormatCompact(string severity, string kind, string message,
                                string filename, int line, int col) {
        let loc = filename + ":" + String_FromInt(line) + ":" + String_FromInt(col)
        return loc + ": " + severity + "[" + kind + "]: " + message
    }
}
