namespace Amalgame.Compiler

import Amalgame.Collections
import Amalgame.IO
import Amalgame.Path
import Amalgame.Process
import Amalgame.String
import Amalgame.Formats.Toml

// ═══════════════════════════════════════════════════════
//  package_registry.am  —  v0.5 package-manager loader
// ═══════════════════════════════════════════════════════
//
// PR 3b of the stdlib package-manager rollout. Reads
// `amalgame.lock` from the user's project + each referenced
// package's manifest from the global cache, exposes the
// aggregated data so that PR 3c can plumb it into the resolver
// and cgen (replacing today's hardcoded isStdlib + return-type
// blocks).
//
// Design doc: docs/proposals/amalgame-package-manager.md
//
// This file does NOT touch resolver / cgen yet. It just loads.
// PR 3c wires it through.
//
// Manifest contract — each external package ships an
// `amalgame.toml` at its repo root with:
//
//   [package]
//   name    = "amalgame-database-nosql-redis"
//   version = "0.1.0"
//   license = "Apache-2.0"
//
//   [stdlib]
//   class     = "Redis"                                  # short class name as used in user code
//   header    = "runtime/Amalgame_Database_Redis.h"      # path inside the package
//   namespace = "Amalgame.Database.NoSQL.Redis"          # import namespace
//
//   [stdlib.functions]
//   Open  = { returns = "AmalgameRedis*" }
//   Close = { returns = "void" }
//   Set   = { returns = "code_bool" }
//   Get   = { returns = "code_string" }
//   # ...
//
// `returns` is the C-level type that the cgen needs for its
// return-type table. The Amalgame-level type used by the
// resolver is derived by stripping a trailing `*` (so
// `AmalgameRedis*` → `AmalgameRedis` for the resolver-side
// declaration, matching today's pattern from PR 0).
//
// v0.5.3 — additional optional manifest keys for C++-bearing
// packages (DuckDB amalgamation kicked these off):
//
//   [stdlib]
//   sources  = ["duckdb.cpp"]            # any .cpp/.cc/.cxx
//                                          gets g++ instead of gcc
//   cflags   = "-O2"                     # extra flags for .c sources
//   cxxflags = "-O3 -DNDEBUG -std=c++11" # extra flags for .cpp sources
//   libs     = ["stdc++"]                # -l<x> appended to final link;
//                                          also forces g++ as linker
//                                          when any source is C++
//
// post-v0.7.5 — optional `[stdlib].facade` key for packages that
// ship a pure-Amalgame `.am` facade alongside their C runtime.
// When set, `amc package add` precompiles the facade through
// `amc --lib` + gcc + ar and caches the resulting
// `libamalgame-pkg-<class>.a` at `<pkgDir>/build/<platform>/`.
// User builds (`amc -o foo foo.am`, `amc test`) auto-pass
// `--external <facade>` and link against the archive — the cgen
// emits forward decls only for the facade's classes, mirroring
// how `lib/libamalgame.a` handles the integrated stdlib.
//
//   [stdlib]
//   facade = "facade.am"                 # path inside the package
//
// Optional; packages that don't ship a facade keep the v0.5.x
// behaviour where amc resolves their classes through the runtime
// header alone.

// One loaded package = its (Class, Header, ImportNamespace) +
// a parallel list of (FuncName, CRetType). FuncName is the
// short name as written in the manifest's [stdlib.functions]
// table (e.g. `Open`); the resolver / cgen will combine it
// with the class to produce `Redis_Open`.
public class LoadedPackage {
    public  Name:        string             // amalgame-database-nosql-redis
    public  ClassName:   string             // Redis
    public  Header:      string             // runtime/Amalgame_Database_Redis.h
    public  Ns:          string             // Amalgame.Database.NoSQL.Redis
    // Git tag this install was resolved at (e.g. "v0.2.0"). Read
    // from the amalgame.lock's [[package]] entry. Used by
    // `amc package list` to surface the version to the user.
    public  Tag:         string
    // Absolute path to the cache dir hosting this package's files
    // (`<cacheRoot>/<git>/<tag>_<sha>/`). Populated by LoadFrom.
    // Used by AmcTest to look up persistent precompile cache at
    // `<PkgDir>/build/<platform>/` before falling back to /tmp.
    public  PkgDir:      string
    public  FuncNames:   List<string>       // ["Open", "Close", ...]
    public  FuncRets:    List<string>       // ["AmalgameRedis*", "void", ...]
    // Vendored .c / .cpp sources the package contributes to the
    // user binary at link time. Read from the manifest's optional
    // top-level [stdlib].sources array; absolute paths (resolved
    // against the package's cache dir). Empty for pure-protocol
    // packages (Redis / MQTT). Non-empty for vendored ones
    // (SQLite ships sqlite3.c here, DuckDB ships duckdb.cpp).
    public  Sources:     List<string>       // absolute source paths
    // Extra flags spliced into the per-source pre-compile step.
    // CFlags applies to .c, CxxFlags to .cpp/.cc/.cxx. Empty means
    // "use the default `-O2 -w`". The DuckDB amalgamation wants
    // e.g. `-O3 -DNDEBUG -std=c++11 -Wno-unused-parameter`.
    public  CFlags:      string
    public  CxxFlags:    string
    // Extra `-l<name>` libs to append to the final link command.
    // For pure-protocol packages this is typically empty; vendored
    // C++ packages declare e.g. `["stdc++"]`; future dynamic-link
    // packages (libpq) will declare `["pq"]`.
    public  Libs:        List<string>
    // Whether `amc package add` should compile this package's
    // sources (if any) right after install, caching .o files
    // persistently at `<pkg-dir>/build/<platform>/`. Read from
    // `[stdlib].precompile = true|false` in the manifest. Default
    // false (back-compat with v0.5.3 packages). Packages with no
    // `[stdlib].sources` ignore this flag — there's nothing to
    // precompile.
    public  Precompile:  bool
    // Optional `.am` facade source. Set from the manifest's
    // `[stdlib].facade = "path/to/facade.am"` key — same shape as
    // `header`, resolved to an absolute path against the package's
    // cache dir. When non-empty, `amc package add` compiles the
    // facade through `amc --lib` + gcc + ar at install time and
    // caches the resulting `libamalgame-pkg-<class>.a` at
    // `<pkgDir>/build/<platform>/`. `amc test` / `amc -o` then
    // auto-pass `--external <facade>` and link the per-package
    // archive instead of re-parsing the facade source on every
    // user build. Same shape as `lib/libamalgame.a` for the
    // integrated stdlib (project F v0.7.5).
    public  Facade:      string

    public LoadedPackage() {
        this.Name       = ""
        this.ClassName  = ""
        this.Header     = ""
        this.Ns         = ""
        this.Tag        = ""
        this.PkgDir     = ""
        this.FuncNames  = new List<string>()
        this.FuncRets   = new List<string>()
        this.Sources    = new List<string>()
        this.CFlags     = ""
        this.CxxFlags   = ""
        this.Libs       = new List<string>()
        this.Precompile = false
        this.Facade     = ""
    }
}

public class PackageRegistry {
    public  Packages: List<LoadedPackage>

    public PackageRegistry() {
        this.Packages = new List<LoadedPackage>()
    }

    // Default constructor entry — `amalgame.lock` in cwd,
    // cache at `$HOME/.amalgame/packages`. Returns an empty
    // registry if no lock file is present (vanilla user
    // compile, no external packages).
    public static PackageRegistry Load() {
        let cacheRoot: string = PackageRegistry.DefaultCacheRoot()
        return PackageRegistry.LoadFrom("amalgame.lock", cacheRoot)
    }

    // Testable form — pass explicit paths so the test runner
    // can point at a fixture without touching the user's real
    // `~/.amalgame/`.
    public static PackageRegistry LoadFrom(string lockPath, string cacheRoot) {
        let reg = new PackageRegistry()
        if (!File.Exists(lockPath)) { return reg }
        let lockSrc: string = File.ReadAll(lockPath)
        let lockDoc = Toml.Parse(lockSrc)
        if (lockDoc.IsNull()) { return reg }

        // [[package]] entries become a `package` array of tables.
        let pkgsArr: TomlValue = lockDoc.Get("package")
        if (!pkgsArr.IsArray()) { return reg }
        let n: int = pkgsArr.Count()
        for i in 0..n {
            let entry: TomlValue = pkgsArr.At(i)
            let nameVal: TomlValue = entry.Get("name")
            let gitVal:  TomlValue = entry.Get("git")
            let tagVal:  TomlValue = entry.Get("tag")
            let revVal:  TomlValue = entry.Get("rev")
            let pkgName: string = nameVal.AsString()
            let pkgGit:  string = gitVal.AsString()
            let pkgTag:  string = tagVal.AsString()
            let pkgRev:  string = revVal.AsString()
            if (String_Length(pkgName) == 0) { continue }
            if (String_Length(pkgGit) == 0)  { continue }
            if (String_Length(pkgTag) == 0)  { continue }
            if (String_Length(pkgRev) < 8)   { continue }

            // Compute cache dir: <cacheRoot>/<git>/<tag>_<short-sha>
            let shortSha: string = String_Substring(pkgRev, 0, 8)
            let pkgDir: string = cacheRoot + "/" + pkgGit + "/" + pkgTag + "_" + shortSha
            let manifestPath: string = pkgDir + "/amalgame.toml"
            if (!File.Exists(manifestPath)) { continue }
            let manifestSrc: string = File.ReadAll(manifestPath)
            let manifest = Toml.Parse(manifestSrc)
            if (manifest.IsNull()) { continue }

            // Schema-version gate. Manifests declaring a higher
            // [package].schema-version than this amc supports are
            // skipped silently — the install path (add_cmd.am)
            // gates with an explicit error message, this layer is
            // just defence against a manifest sneaking through
            // with keys we don't understand.
            let pkgTable: TomlValue = manifest.Get("package")
            if (pkgTable.IsTable()) {
                let schemaVal: TomlValue = pkgTable.Get("schema-version")
                let schemaInt: int = schemaVal.AsInt()
                if (schemaInt > PackageRegistry.SupportedManifestSchema()) {
                    continue
                }
            }

            // Build the LoadedPackage from the manifest's [stdlib]
            // and [stdlib.functions] sections.
            let stdlibTable: TomlValue = manifest.Get("stdlib")
            if (!stdlibTable.IsTable()) { continue }
            let classVal: TomlValue = stdlibTable.Get("class")
            let headerVal: TomlValue = stdlibTable.Get("header")
            let nsVal: TomlValue = stdlibTable.Get("namespace")
            let clsName: string = classVal.AsString()
            let hdr: string = headerVal.AsString()
            let ns: string = nsVal.AsString()
            if (String_Length(clsName) == 0) { continue }
            if (String_Length(hdr) == 0)     { continue }

            let lp = new LoadedPackage()
            lp.Name      = pkgName
            lp.Tag       = pkgTag
            lp.PkgDir    = pkgDir
            lp.ClassName = clsName
            // Manifest's header path is relative to the package
            // root; expose it as absolute so the cgen can emit
            // `#include "<absolute path>"` and the resolver +
            // user-binary gcc can find it without -I tweaking.
            lp.Header    = pkgDir + "/" + hdr
            lp.Ns        = ns

            // Vendored sources — optional `[stdlib].sources`
            // array, paths relative to the package root. Same
            // absolute-path treatment as the header field, so
            // gcc just gets a usable path.
            let sourcesArr: TomlValue = stdlibTable.Get("sources")
            if (sourcesArr.IsArray()) {
                let sn: int = sourcesArr.Count()
                for si in 0..sn {
                    let srcTv: TomlValue = sourcesArr.At(si)
                    let srcRel: string = srcTv.AsString()
                    if (String_Length(srcRel) > 0) {
                        lp.Sources.Add(pkgDir + "/" + srcRel)
                    }
                }
            }

            // Optional per-package compile flags. CFlags applies
            // to .c sources, CxxFlags to .cpp/.cc/.cxx — both
            // spliced into the gcc/g++ pre-compile invocation by
            // Program.PreCompilePackageSources.
            let cflagsVal: TomlValue = stdlibTable.Get("cflags")
            lp.CFlags = cflagsVal.AsString()
            let cxxflagsVal: TomlValue = stdlibTable.Get("cxxflags")
            lp.CxxFlags = cxxflagsVal.AsString()

            // Optional `[stdlib].libs` — a list of bare lib names
            // (no `-l` prefix). Appended as `-l<name>` to the
            // final link command in Program.RunTest. C++-bearing
            // packages typically declare `["stdc++"]`; dynamic-
            // link packages (libpq) will declare `["pq"]`.
            let libsArr: TomlValue = stdlibTable.Get("libs")
            if (libsArr.IsArray()) {
                let ln: int = libsArr.Count()
                for li in 0..ln {
                    let libTv: TomlValue = libsArr.At(li)
                    let libName: string = libTv.AsString()
                    if (String_Length(libName) > 0) {
                        lp.Libs.Add(libName)
                    }
                }
            }

            // Optional `[stdlib].precompile` — when true, amc
            // compiles the sources at `amc package add` time
            // (persistent cache under <pkg-dir>/build/<platform>/)
            // instead of lazily on first `amc test` (volatile /tmp
            // cache). Heavy packages (DuckDB, future SQL backends)
            // opt in; light pure-Amalgame packages (Redis, MQTT)
            // omit the field and stay instant-install.
            let precompileVal: TomlValue = stdlibTable.Get("precompile")
            lp.Precompile = precompileVal.AsBool()

            // Optional `[stdlib].facade` — relative path inside
            // the package to a pure-Amalgame `.am` facade file.
            // When present, `amc package add` compiles it through
            // `amc --lib` + gcc -c + ar rcs and caches the resulting
            // `libamalgame-pkg-<class>.a` at
            // `<pkgDir>/build/<platform>/`. `amc test` / `amc -o`
            // then auto-pass `--external <facade>` so the cgen
            // emits forward decls only, and link against the
            // per-package archive — same shape as
            // `lib/libamalgame.a` for the integrated stdlib.
            let facadeVal: TomlValue = stdlibTable.Get("facade")
            let facadeRel: string = facadeVal.AsString()
            if (String_Length(facadeRel) > 0) {
                lp.Facade = pkgDir + "/" + facadeRel
            }

            // Functions table — short name → return type.
            let funcsTbl: TomlValue = stdlibTable.Get("functions")
            if (funcsTbl.IsTable()) {
                let funcKeys: List<string> = funcsTbl.Keys()
                let fn: int = funcKeys.Count()
                for j in 0..fn {
                    let fName: string = funcKeys.Get(j)
                    let fDef: TomlValue = funcsTbl.Get(fName)
                    let fRet: TomlValue = fDef.Get("returns")
                    let retStr: string = fRet.AsString()
                    if (String_Length(retStr) == 0) { continue }
                    lp.FuncNames.Add(fName)
                    lp.FuncRets.Add(retStr)
                }
            }
            reg.Packages.Add(lp)
        }
        return reg
    }

    // Convenience — list every class name across loaded packages.
    // Used by the cgen's isStdlib check (PR 3c).
    public List<string> ClassNames() {
        let out: List<string> = new List<string>()
        let n: int = this.Packages.Count()
        for i in 0..n {
            let p: LoadedPackage = this.Packages.Get(i)
            out.Add(p.ClassName)
        }
        return out
    }

    // Headers each loaded package contributes — used by the
    // cgen's prelude emission to include them in the user binary.
    public List<string> Headers() {
        let out: List<string> = new List<string>()
        let n: int = this.Packages.Count()
        for i in 0..n {
            let p: LoadedPackage = this.Packages.Get(i)
            out.Add(p.Header)
        }
        return out
    }

    // True iff any loaded package declares a C++ source. Used
    // by `amc test` to switch the final-link compiler from gcc
    // to g++ (needed for libstdc++ + correct C++ static-init
    // ordering).
    public bool HasCxxSources() {
        let n: int = this.Packages.Count()
        for i in 0..n {
            let p: LoadedPackage = this.Packages.Get(i)
            let sn: int = p.Sources.Count()
            for j in 0..sn {
                if (PackageRegistry.IsCxxSource(p.Sources.Get(j))) { return true }
            }
        }
        return false
    }

    // Resolve the per-package facade archive path:
    //   <pkgDir>/build/<platform>/libamalgame-pkg-<class>.a
    // Doesn't check whether the file exists — callers that care
    // (Program.RunTest, the user's gcc step) check separately.
    public static string FacadeArchivePath(LoadedPackage p) {
        let buildDir: string = PackageRegistry.PrecompileCacheDir(p.PkgDir)
        return buildDir + "/libamalgame-pkg-" + p.ClassName + ".a"
    }

    // Collect facade archive paths from every loaded package that
    // declares a `[stdlib].facade` AND has an on-disk archive (the
    // archive may be missing if `amc package add` ran with
    // `--no-precompile` or pre-dates this feature). Caller splices
    // each path into the gcc link line — see Program.RunTest.
    public List<string> CollectFacadeArchives() {
        let out: List<string> = new List<string>()
        let n: int = this.Packages.Count()
        for i in 0..n {
            let p: LoadedPackage = this.Packages.Get(i)
            if (String_Length(p.Facade) == 0) { continue }
            let archive: string = PackageRegistry.FacadeArchivePath(p)
            if (File.Exists(archive)) {
                out.Add(archive)
            }
        }
        return out
    }

    // Flatten every loaded package's [stdlib].libs list into a
    // single list of bare lib names. Order is significant for
    // static-link cycles but for our (small-N, dynamic) case it
    // doesn't matter — gcc/g++ resolve left-to-right and our
    // libs are leaves.
    public List<string> CollectLibs() {
        let out: List<string> = new List<string>()
        let n: int = this.Packages.Count()
        for i in 0..n {
            let p: LoadedPackage = this.Packages.Get(i)
            let ln: int = p.Libs.Count()
            for j in 0..ln {
                out.Add(p.Libs.Get(j))
            }
        }
        return out
    }

    // True iff the path ends with a C++ source extension. Used
    // by `amc test` to pick g++ over gcc for the per-source
    // pre-compile and to switch the final-link compiler.
    public static bool IsCxxSource(string path) {
        if (String_EndsWith(path, ".cpp")) { return true }
        if (String_EndsWith(path, ".cc"))  { return true }
        if (String_EndsWith(path, ".cxx")) { return true }
        return false
    }

    // Resolve the user's amc home directory — the parent of
    // `.amalgame/` which holds the package cache, the calibration
    // file, and any future amc-local state.
    //
    // Resolution order:
    //   1. `$AMALGAME_HOME`  — explicit override (CI, tests, sandboxed users)
    //   2. `$HOME`           — POSIX, MSYS2, Cygwin, WSL (always set)
    //   3. `$USERPROFILE`    — Windows native cmd.exe / PowerShell
    //   4. `""`              — caller must error out with a clear message
    //
    // Note: the value points at the HOME-equivalent (e.g.
    // `/home/alice` or `C:\Users\Alice`), not at `.amalgame/`
    // itself — combine it with `.amalgame/<subdir>` via
    // `Path_Combine` so the separator (`/` vs `\`) doesn't
    // matter on Windows native shells.
    public static string AmalgameHome() {
        let override: string = Env_Get("AMALGAME_HOME")
        if (String_Length(override) > 0) { return override }
        let home: string = Env_Get("HOME")
        if (String_Length(home) > 0) { return home }
        let userProfile: string = Env_Get("USERPROFILE")
        if (String_Length(userProfile) > 0) { return userProfile }
        return ""
    }

    // Absolute path to the `.amalgame/` state dir. Created on
    // demand by callers (Add / RunTest); not guaranteed to exist
    // before they touch it. Returns empty string if home is
    // unresolvable — callers should fail with a clear error.
    public static string AmalgameStateDir() {
        let home: string = PackageRegistry.AmalgameHome()
        if (String_Length(home) == 0) { return "" }
        return Path_Combine(home, ".amalgame")
    }

    // Default cache root resolution order:
    //   1. `$AMALGAME_PACKAGES_DIR` env var (test/CI override)
    //   2. `<AmalgameHome()>/.amalgame/packages` (normal user case,
    //      cross-platform via AmalgameHome's $HOME / $USERPROFILE chain)
    //   3. `/tmp/amalgame-packages` (truly unresolvable home —
    //      POSIX-flavoured fallback; on Windows this would still be
    //      better than nothing because git-bash maps /tmp sensibly,
    //      but if we reach here on native Windows the user has
    //      bigger problems than the cache path)
    public static string DefaultCacheRoot() {
        let envOverride: string = Env_Get("AMALGAME_PACKAGES_DIR")
        if (String_Length(envOverride) > 0) {
            return envOverride
        }
        let stateDir: string = PackageRegistry.AmalgameStateDir()
        if (String_Length(stateDir) > 0) {
            return Path_Combine(stateDir, "packages")
        }
        return "/tmp/amalgame-packages"
    }

    // Absolute path to the calibration file. amc reads it to ETA
    // future precompiles, writes a new sample after every compile.
    // See `Calibration` class below + `AddCommand.PrecompilePackage`.
    public static string CalibrationPath() {
        let stateDir: string = PackageRegistry.AmalgameStateDir()
        if (String_Length(stateDir) == 0) { return "" }
        return Path_Combine(stateDir, "calibration.toml")
    }

    // Compute the persistent precompile cache dir for a package.
    // Layout:
    //   <pkgDir>/build/<platform>/
    // where `<platform>` is `linux-x86_64` / `macos-arm64` / …
    // (lowercased `$(uname -s)-$(uname -m)`-equivalent). Cross-
    // platform users (a single $HOME shared across Linux + macOS
    // via NFS / Dropbox) don't collide.
    public static string PrecompileCacheDir(string pkgDir) {
        let p: string = PackageRegistry.PlatformTag()
        let buildDir: string = Path_Combine(pkgDir, "build")
        return Path_Combine(buildDir, p)
    }

    // Lowercased `<os>-<arch>` triple. Used as a directory name
    // inside each package's cache so cross-platform users sharing
    // a $HOME don't link the wrong .o.
    public static string PlatformTag() {
        // `uname -s` returns Linux / Darwin / MINGW64_NT-... etc.
        // Normalise to short names matching the GitHub Releases
        // artefact convention: linux / macos / windows.
        let unameS: string = String_Trim(Process.RunCapture("uname -s").Stdout)
        let unameM: string = String_Trim(Process.RunCapture("uname -m").Stdout)
        var os: string = "unknown"
        if (String_StartsWith(unameS, "Linux"))   { os = "linux" }
        if (String_StartsWith(unameS, "Darwin"))  { os = "macos" }
        if (String_StartsWith(unameS, "MINGW"))   { os = "windows" }
        if (String_StartsWith(unameS, "MSYS"))    { os = "windows" }
        if (String_StartsWith(unameS, "CYGWIN"))  { os = "windows" }
        var arch: string = unameM
        if (arch == "")           { arch = "unknown" }
        if (arch == "amd64")      { arch = "x86_64" }
        if (arch == "aarch64")    { arch = "arm64" }
        return os + "-" + arch
    }

    // Mangle a package class method into its canonical C symbol.
    // Convention: dot-separated namespace + `_` + method name,
    // dots replaced by `_`. Mirrors the namespace hierarchy so
    // two packages with the same short class name don't collide
    // at C link time:
    //
    //   ManglePackageSymbol("Amalgame.Database.NoSQL.Redis", "Open")
    //     → "Amalgame_Database_NoSQL_Redis_Open"
    //
    // Core stdlib classes (Console / File / Math / …) keep their
    // flat symbols (`Console_WriteLine`) because they're
    // coordinated single-author code with no collision risk.
    // External packages — where any third-party can publish a
    // class called `Redis` — get the full mangling.
    public static string ManglePackageSymbol(string ns, string method) {
        let mangledNs: string = String_Replace(ns, ".", "_")
        return mangledNs + "_" + method
    }

    // Strip a trailing `*` so a C-level type like `AmalgameRedis*`
    // becomes the Amalgame-side type the resolver expects
    // (`AmalgameRedis`). C primitives without a star pass through
    // unchanged (`void`, `code_bool`, `code_string`, `i64`).
    public static string AmalgameTypeFromC(string cType) {
        let n: int = String_Length(cType)
        if (n == 0) { return "" }
        if (String_EndsWith(cType, "*")) {
            return String_Substring(cType, 0, n - 1)
        }
        return cType
    }

    // ── amc version + compat check ────────────────────
    //
    // Single source of truth for the compiler's version string.
    // Both main.am's --version output and amc add's required-
    // amalgame check read from here so a release bump only needs
    // one edit (this constant + tools/release.sh which already
    // handles --version).
    public static string AmcVersion() {
        return "0.8.23"
    }

    // Highest [package].schema-version this amc knows how to
    // consume. Bumped whenever a new mandatory manifest key is
    // added. Packages declaring a higher value are rejected at
    // install time (with an explicit error) and silently skipped
    // by LoadFrom (defence-in-depth).
    //
    //   v1 — initial schema (v0.5.0).
    //   v1 still accepts the v0.5.3 additions cflags / cxxflags /
    //   libs because they're optional — no version bump needed.
    public static int SupportedManifestSchema() {
        return 1
    }

    // Parse a semver-ish version string into a (major, minor, patch)
    // triple. Suffixes like `-dev`, `-rc.1`, `+build.42` are
    // stripped — only the core triple matters for compat. Returns
    // a List<int> of length 3; missing components default to 0.
    public static List<int> ParseVersion(string v) {
        let out: List<int> = new List<int>()
        // Strip a `v` prefix if present (tag-style "v1.2.3").
        var s: string = v
        if (String_StartsWith(s, "v")) {
            s = String_Substring(s, 1, String_Length(s) - 1)
        }
        // Strip pre-release / build metadata after `-` or `+`.
        let dashIdx: int = String_IndexOf(s, "-")
        if (dashIdx >= 0) {
            s = String_Substring(s, 0, dashIdx)
        }
        let plusIdx: int = String_IndexOf(s, "+")
        if (plusIdx >= 0) {
            s = String_Substring(s, 0, plusIdx)
        }
        let parts: List<string> = String_Split(s, ".")
        let n: int = parts.Count()
        var maj: int = 0
        var min: int = 0
        var pat: int = 0
        if (n >= 1) { maj = String_ToInt(parts.Get(0)) }
        if (n >= 2) { min = String_ToInt(parts.Get(1)) }
        if (n >= 3) { pat = String_ToInt(parts.Get(2)) }
        out.Add(maj)
        out.Add(min)
        out.Add(pat)
        return out
    }

    // Check whether the current amc version satisfies a constraint
    // string from a package's `required-amalgame` field. Supports
    // `>=X.Y.Z` only in v0.5 (every other operator is treated as
    // "no constraint" — generous default so future syntax doesn't
    // brick old amc binaries). Empty constraint → always true.
    // Read the calibration file's raw TOML content. Returns ""
    // if missing or unreadable so callers can short-circuit.
    public static string ReadCalibrationFile() {
        let path: string = PackageRegistry.CalibrationPath()
        if (String_Length(path) == 0) { return "" }
        if (!File.Exists(path)) { return "" }
        return File.ReadAll(path)
    }

    // Check whether `current` satisfies `constraint`. Supported
    // operators (v0.6+):
    //   `>=X.Y.Z`  — at least X.Y.Z (existing)
    //   `>X.Y.Z`   — strictly greater
    //   `<=X.Y.Z`  — at most X.Y.Z
    //   `<X.Y.Z`   — strictly less
    //   `=X.Y.Z`   — exact match
    //   `^X.Y.Z`   — semver caret: same major (or for 0.x: same
    //                minor) + >=patch
    //   `~X.Y.Z`   — tilde: same major.minor + >=patch
    //   `<bare>`   — no operator → treated as `>=` for back-compat
    //                with the v0.5 manifest convention
    //
    // Empty constraint → always true. Unrecognised operator →
    // returns true (lenient — future syntax doesn't brick older
    // amc binaries).
    public static bool VersionSatisfies(string current, string constraint) {
        if (String_Length(constraint) == 0) { return true }
        let c: string = String_Trim(constraint)
        // Order matters: 2-char operators (>=, <=) MUST be checked
        // before their 1-char prefixes (>, <).
        if (String_StartsWith(c, ">=")) {
            return PackageRegistry.CompareCmp(current, String_Substring(c, 2, String_Length(c) - 2)) >= 0
        }
        if (String_StartsWith(c, "<=")) {
            return PackageRegistry.CompareCmp(current, String_Substring(c, 2, String_Length(c) - 2)) <= 0
        }
        if (String_StartsWith(c, ">")) {
            return PackageRegistry.CompareCmp(current, String_Substring(c, 1, String_Length(c) - 1)) > 0
        }
        if (String_StartsWith(c, "<")) {
            return PackageRegistry.CompareCmp(current, String_Substring(c, 1, String_Length(c) - 1)) < 0
        }
        if (String_StartsWith(c, "=")) {
            return PackageRegistry.CompareCmp(current, String_Substring(c, 1, String_Length(c) - 1)) == 0
        }
        if (String_StartsWith(c, "^")) {
            return PackageRegistry.CaretSatisfies(current, String_Substring(c, 1, String_Length(c) - 1))
        }
        if (String_StartsWith(c, "~")) {
            return PackageRegistry.TildeSatisfies(current, String_Substring(c, 1, String_Length(c) - 1))
        }
        // Bare version — treat as `>=` for back-compat with v0.5
        // packages that wrote `required-amalgame = "0.5.0"` (the
        // `>=` was implicit).
        return PackageRegistry.CompareCmp(current, c) >= 0
    }

    // Compare two version strings as (major, minor, patch) tuples.
    // Returns < 0 if a < b, > 0 if a > b, 0 if equal. Strips `v`
    // prefix + pre-release / build metadata via ParseVersion.
    public static int CompareCmp(string a, string b) {
        let pa: List<int> = PackageRegistry.ParseVersion(a)
        let pb: List<int> = PackageRegistry.ParseVersion(b)
        if (pa.Get(0) != pb.Get(0)) { return pa.Get(0) - pb.Get(0) }
        if (pa.Get(1) != pb.Get(1)) { return pa.Get(1) - pb.Get(1) }
        return pa.Get(2) - pb.Get(2)
    }

    // Caret semver — `^X.Y.Z`. Compatible with the leftmost
    // non-zero version component. So:
    //   `^1.2.3`  matches `>=1.2.3, <2.0.0`  (lock major)
    //   `^0.5.3`  matches `>=0.5.3, <0.6.0`  (lock minor, since major is 0)
    //   `^0.0.5`  matches `=0.0.5`           (lock patch, since major+minor are 0)
    // This is the same rule as npm's caret. Aligns with the way
    // semver treats 0.x as "pre-stable, minor bumps may break".
    public static bool CaretSatisfies(string current, string base) {
        let cur: List<int> = PackageRegistry.ParseVersion(current)
        let req: List<int> = PackageRegistry.ParseVersion(base)
        // Lower bound: current >= base.
        if (PackageRegistry.CompareCmp(current, base) < 0) { return false }
        // Upper bound depends on leftmost non-zero.
        if (req.Get(0) > 0) {
            // ^1.2.3 → <2.0.0
            return cur.Get(0) == req.Get(0)
        }
        if (req.Get(1) > 0) {
            // ^0.5.3 → <0.6.0
            return cur.Get(0) == 0 && cur.Get(1) == req.Get(1)
        }
        // ^0.0.5 → =0.0.5
        return cur.Get(0) == 0 && cur.Get(1) == 0 && cur.Get(2) == req.Get(2)
    }

    // Tilde semver — `~X.Y.Z` matches `>=X.Y.Z, <X.(Y+1).0`.
    // Locks major + minor, allows patches. Same rule as npm's
    // tilde. More conservative than caret (no minor bumps).
    public static bool TildeSatisfies(string current, string base) {
        let cur: List<int> = PackageRegistry.ParseVersion(current)
        let req: List<int> = PackageRegistry.ParseVersion(base)
        if (PackageRegistry.CompareCmp(current, base) < 0) { return false }
        return cur.Get(0) == req.Get(0) && cur.Get(1) == req.Get(1)
    }
}

// One sample fed back into the calibration store after a
// successful precompile. The fields are minimal — just enough
// to build a (size → elapsed) rate per language. PkgVer is
// kept for human-readable debugging via `amc package cache ls`
// (planned).
public class CalibrationSample {
    public Lang:     string     // "c" or "cxx"
    public SizeKb:   int        // total bytes / 1024, summed over package's [stdlib].sources
    public ElapsedS: int        // wall time spent in gcc / g++, rounded to seconds
    public PkgVer:   string     // "<pkg-name>@<tag>", e.g. "amalgame-database-duckdb@v0.1.0"

    public CalibrationSample() {
        this.Lang     = ""
        this.SizeKb   = 0
        this.ElapsedS = 0
        this.PkgVer   = ""
    }
}

// Local-machine compile-speed memory. Lives at
// `<AmalgameStateDir()>/calibration.toml`. Append-on-compile,
// read-for-ETA. Auto-corrects to the current machine over a few
// installs — no manifest-side ETA lies needed.
//
// File format (TOML, schema-version 1):
//
//   schema-version = 1
//
//   [[sample]]
//   lang      = "cxx"
//   size_kb   = 25500
//   elapsed_s = 167
//   pkg_ver   = "amalgame-database-duckdb@v0.1.0"
//
// The estimate is a weighted average: total elapsed / total kb
// across all samples of the matching language, then scaled to
// the new target size. Coarse on purpose — the goal is "tell
// the user the order of magnitude", not predict to the second.
public class Calibration {
    public Samples: List<CalibrationSample>

    public Calibration() {
        this.Samples = new List<CalibrationSample>()
    }

    // Load from disk; returns an empty Calibration if the file
    // is missing, unreadable, or has the wrong schema-version.
    // Silent on errors — calibration is best-effort, never
    // blocks the user.
    public static Calibration Load() {
        let cal = new Calibration()
        let raw: string = PackageRegistry.ReadCalibrationFile()
        if (String_Length(raw) == 0) { return cal }
        let doc = Toml.Parse(raw)
        if (doc.IsNull()) { return cal }
        // schema-version gate — refuse to load unknown schemas
        // so we don't misinterpret future fields.
        let schemaVal: TomlValue = doc.Get("schema-version")
        if (schemaVal.AsInt() > 1) { return cal }
        let arr: TomlValue = doc.Get("sample")
        if (!arr.IsArray()) { return cal }
        let n: int = arr.Count()
        for i in 0..n {
            let entry: TomlValue = arr.At(i)
            let s = new CalibrationSample()
            s.Lang     = entry.Get("lang").AsString()
            s.SizeKb   = entry.Get("size_kb").AsInt()
            s.ElapsedS = entry.Get("elapsed_s").AsInt()
            s.PkgVer   = entry.Get("pkg_ver").AsString()
            if (String_Length(s.Lang) == 0)    { continue }
            if (s.SizeKb <= 0 || s.ElapsedS <= 0) { continue }
            cal.Samples.Add(s)
        }
        return cal
    }

    // Append a sample (no dedup — multiple installs of the same
    // version legitimately produce multiple data points, and the
    // weighted average naturally re-weights). Call Save() after.
    public void Add(string lang, int sizeKb, int elapsedS, string pkgVer) {
        let s = new CalibrationSample()
        s.Lang     = lang
        s.SizeKb   = sizeKb
        s.ElapsedS = elapsedS
        s.PkgVer   = pkgVer
        this.Samples.Add(s)
    }

    // Estimate compile time (seconds) for a target source of
    // `lang` and `sizeKb`. Returns -1 if no samples exist for
    // this language yet — caller should fall back to "no ETA".
    public int EstimateSeconds(string lang, int sizeKb) {
        var totalKb:  int = 0
        var totalSec: int = 0
        let n: int = this.Samples.Count()
        for i in 0..n {
            let s: CalibrationSample = this.Samples.Get(i)
            if (s.Lang == lang) {
                totalKb  = totalKb  + s.SizeKb
                totalSec = totalSec + s.ElapsedS
            }
        }
        if (totalKb <= 0) { return -1 }
        return sizeKb * totalSec / totalKb
    }

    public int SampleCount(string lang) {
        var n: int = 0
        let len: int = this.Samples.Count()
        for i in 0..len {
            let s: CalibrationSample = this.Samples.Get(i)
            if (s.Lang == lang) { n = n + 1 }
        }
        return n
    }

    // Serialise the current state and write to CalibrationPath().
    // Creates `~/.amalgame/` on demand. Silently no-ops if home
    // is unresolvable (no usable env vars).
    public bool Save() {
        let path: string = PackageRegistry.CalibrationPath()
        if (String_Length(path) == 0) { return false }
        let stateDir: string = PackageRegistry.AmalgameStateDir()
        if (String_Length(stateDir) > 0) {
            // Ensure parent dir exists; ignore failure (mkdir -p
            // on an existing dir is fine, on a missing root is
            // the actual error, surfaced by File.WriteAll below).
            Process.RunCapture("mkdir -p '" + stateDir + "'")
        }
        var s: string = "# Amalgame calibration store — auto-managed by `amc package add`.\n"
        s = s + "# Each precompile contributes a sample; the weighted average\n"
        s = s + "# across samples of the same language drives ETA.\n"
        s = s + "schema-version = 1\n\n"
        let n: int = this.Samples.Count()
        for i in 0..n {
            let sm: CalibrationSample = this.Samples.Get(i)
            s = s + "[[sample]]\n"
            s = s + "lang      = \"" + sm.Lang + "\"\n"
            s = s + "size_kb   = " + String_FromInt(sm.SizeKb) + "\n"
            s = s + "elapsed_s = " + String_FromInt(sm.ElapsedS) + "\n"
            s = s + "pkg_ver   = \"" + sm.PkgVer + "\"\n"
            s = s + "\n"
        }
        return File.WriteAll(path, s)
    }
}
