namespace Amalgame.Compiler

import Amalgame.Collections
import Amalgame.String

// Sentinel node for "no result"
public class Parser {
    private Tokens:     List<Token>
    private TokenCount: int
    private Pos:        int
    private Errors:     List<string>
    private ParenDepth: int
    // Comma-separated decorator names (`@inline @deprecated`) parsed before
    // the next method/class. Consumed (and cleared) when that decl is built.
    private PendingDecorators: string
    // COMMENT tokens, stripped from the main stream so the rest of the parser
    // never has to know they exist. The formatter reads them back via Comments.
    public Comments: List<Token>

    public Parser(List<Token> tokens) {
        let filtered = new List<Token>()
        let comments = new List<Token>()
        let total    = tokens.Count()
        var i = 0
        while (i < total) {
            let t: Token = tokens.Get(i)
            if (t.Type == TokenType.COMMENT) {
                comments.Add(t)
            } else {
                filtered.Add(t)
            }
            i = i + 1
        }
        this.Tokens             = filtered
        this.TokenCount         = filtered.Count()
        this.Pos                = 0
        this.Errors             = new List<string>()
        this.ParenDepth         = 0
        this.PendingDecorators  = ""
        this.Comments           = comments
    }

    // Parse zero-or-more `@<name>` annotations into a comma-separated list
    // (no parentheses for now — flag-style decorators only).
    private void ParseDecoratorList() {
        while (this.CheckValue("@")) {
            this.Advance()
            if (this.CheckType(TokenType.IDENTIFIER)) {
                let nameTok = this.Advance()
                if (String_Length(this.PendingDecorators) > 0) {
                    this.PendingDecorators = this.PendingDecorators + ","
                }
                this.PendingDecorators = this.PendingDecorators + nameTok.Value
            }
            this.SkipNewlines()
        }
    }

    private string TakeDecorators() {
        let d = this.PendingDecorators
        this.PendingDecorators = ""
        return d
    }

    // ── Public API ────────────────────────────────────

    public AstNode Parse() {
        let prog = Ast.Program(1, 1)
        // Carry the filename on the Program node so later passes can quote source.
        if (this.Tokens.Count() > 0) {
            let firstTok = this.Tokens.Get(0)
            prog.Str2 = firstTok.Filename
        }
        this.SkipNewlines()

        if (this.CheckKw("namespace")) {
            this.Advance()
            prog.Str = this.ParseQualifiedName()
                this.SkipNewlines()
        }

        while (this.CheckKw("import")) {
            let importTok = this.Advance()
            let qname = this.ParseQualifiedName()
            // Imports are informational — the resolver's stdlib is global.
            // We store them on prog.Args (unused for Program nodes by every
            // other pass) so `amc fmt` can re-emit them on round-trip.
            let imp = Ast.Ident(qname, importTok.Line, importTok.Column)
            prog.Args.Add(imp)
            this.SkipNewlines()
        }

        var parseLastPos = 0
        while (!this.IsEnd()) {
            this.SkipNewlines()
            if (this.IsEnd()) { break }
            let parsePos = this.Pos
            if (parsePos == parseLastPos && parseLastPos > 0) {
                this.Advance()
                if (this.IsEnd()) { break }
            }
            parseLastPos = this.Pos
            // File-scope `@c { … }` raw block — emitted verbatim near
            // the top of the generated .c (after the runtime prelude
            // includes, before any class typedef). Used for module-
            // level state globals, `#include`s the runtime prelude
            // doesn't bring in, or any other C the @c blocks inside
            // method bodies will reach for. The lexer already merged
            // the body bytes into a single INLINE_C token.
            if (this.CheckType(TokenType.INLINE_C)) {
                let tok = this.Advance()
                let node = Ast.InlineC(tok.Value, tok.Line, tok.Column)
                prog.Children.Add(node)
                this.SkipNewlines()
                continue
            }
            // File-scope `@c_include "<h.h>"` / `@c_link "lib"` directives
            // are recognised before ParseDecl so the leading `@` doesn't
            // get swallowed by ParseDecoratorList as a class decorator.
            if (this.CheckType(TokenType.AT)) {
                let nextTok = this.Peek(1)
                if (nextTok.Type == TokenType.IDENTIFIER && (nextTok.Value == "c_include" || nextTok.Value == "c_link")) {
                    let directive = this.ParseInlineCDirective()
                    prog.Children.Add(directive)
                    this.SkipNewlines()
                    continue
                }
            }
            let curVal = this.Current().Value
            let decl = this.ParseDecl()
            let dk = decl.Kind
            if (dk != NodeKind.IDENTIFIER) {
                prog.Children.Add(decl)
            }
            this.SkipNewlines()
        }
        return prog
    }

    // Parse `@c_include "<header.h>"` or `@c_link "libname"` at file scope.
    // Caller (Parse) has already peeked the `@` + IDENT to confirm the
    // shape, so we just advance through both tokens and expect a STRING.
    private AstNode ParseInlineCDirective() {
        let atTok  = this.Advance()      // consume `@`
        let kwTok  = this.Advance()      // consume `c_include` or `c_link`
        if (!this.CheckType(TokenType.STRING)) {
            return this.Unknown()
        }
        let strTok = this.Advance()
        if (kwTok.Value == "c_include") {
            return Ast.InlineCInclude(strTok.Value, atTok.Line, atTok.Column)
        }
        return Ast.InlineCLink(strTok.Value, atTok.Line, atTok.Column)
    }

    public bool HasErrors() {
        return this.Errors.Count() > 0
    }

    public string GetErrors() {
        var result = ""
        let count = this.Errors.Count()
        for i in 0..count {
            let e = this.Errors.Get(i)
            result = result + e + "\n"
        }
        return result
    }

    // ── Token navigation ──────────────────────────────

    private Token Current() {
        let count = this.TokenCount
        if (this.Pos >= count) {
            return this.Tokens.Get(count - 1)
        }
        return this.Tokens.Get(this.Pos)
    }

    private Token Peek(int offset) {
        let i = this.Pos + offset
        let count = this.TokenCount
        if (i >= count) { return this.Tokens.Get(count - 1) }
        return this.Tokens.Get(i)
    }

    private Token Advance() {
        let tok = this.Current()
        this.Pos = this.Pos + 1
        return tok
    }

    private bool IsEnd() {
        if (this.Pos >= this.TokenCount) { return true }
        let tok = this.Tokens.Get(this.Pos)
        return tok.Type == TokenType.EOF
    }

    private bool CheckType(TokenType t) {
        if (this.Pos >= this.TokenCount) { return false }
        let tok = this.Tokens.Get(this.Pos)
        return tok.Type == t
    }

    private bool CheckKw(string word) {
        let tok = this.Current()
        return tok.Value == word
    }

    private bool CheckValue(string v) {
        if (this.Pos >= this.TokenCount) { return false }
        let tok = this.Tokens.Get(this.Pos)
        return tok.Value == v
    }

    private void SkipNewlines() {
        while (!this.IsEnd() && this.CheckType(TokenType.NEWLINE)) {
            this.Advance()
        }
    }

    private Token Expect(string value) {
        let tok = this.Current()
        if (tok.Value == value) {
            return this.Advance()
        }
        let line = tok.Line
        let col  = tok.Column
        let got  = tok.Value
        this.Errors.Add("Expected '" + value + "' at " + String_FromInt(line) + ":" + String_FromInt(col) + " got '" + got + "'")
        return tok
    }

    private Token ExpectIdent() {
        let tok = this.Current()
        if (this.CheckType(TokenType.IDENTIFIER)) {
            return this.Advance()
        }
        let line = tok.Line
        let got  = tok.Value
        this.Errors.Add("Expected identifier at line " + String_FromInt(line) + " got '" + got + "'")
        // Always advance to avoid infinite loops
        this.Advance()
        return tok
    }

    private AstNode Unknown() {
        let tok = this.Current()
        return Ast.Ident("_unknown_", tok.Line, tok.Column)
    }

    // ── Qualified name ────────────────────────────────

    private string ParseQualifiedName() {
        let tok = this.ExpectIdent()
        var name = tok.Value
        while (this.CheckValue(".")) {
            this.Advance()
            let next = this.ExpectIdent()
            name = name + "." + next.Value
        }
        return name
    }

    // ── Top-level declarations ─────────────────────────

    private AstNode ParseDecl() {
        this.SkipNewlines()
        if (this.IsEnd()) { return this.Unknown() }
        var isPublic = false
        var isStatic = false

        if (this.CheckKw("public")) {
            isPublic = true
            this.Advance()
        }
        if (this.CheckKw("private")) {
            this.Advance()
        }
        if (this.CheckKw("static")) {
            isStatic = true
            this.Advance()
        }


        if (this.CheckKw("class")) {
                return this.ParseClass(isPublic)
        }
        // data class: "data class Point(float X, float Y)" → class with fields + constructor
        if (this.CheckKw("data")) {
            this.Advance()
            if (this.CheckKw("class")) {
                return this.ParseDataClass(isPublic)
            }
        }
        // record: "record Point(float X, float Y)" → same as data class
        if (this.CheckKw("record")) {
            this.Advance()
            return this.ParseDataClass(isPublic)
        }
        if (this.CheckKw("enum")) {
            return this.ParseEnum(isPublic)
        }
        if (this.CheckKw("interface")) {
            return this.ParseInterface(isPublic)
        }

        // Top-level `fn` parses without complaint today but cgen
        // emits no definition, so call sites link-fail later. We
        // don't currently support free-standing functions — the
        // language puts everything on a class — so emit a clear
        // diagnostic now and skip past the body to avoid cascading
        // parse errors.
        if (this.CheckKw("fn")) {
            let tok = this.Current()
            var name: string = "<anonymous>"
            let nextTok = this.Peek(1)
            if (nextTok.Type == TokenType.IDENTIFIER) {
                name = nextTok.Value
            }
            this.Errors.Add("Top-level functions aren't supported (got 'fn " + name + "' at " + String_FromInt(tok.Line) + ":" + String_FromInt(tok.Column) + "). Wrap it inside a class as `public static`.")
            // Skip to the body's opening `{`, then to its matching `}`.
            while (!this.IsEnd() && !this.CheckValue("{")) { this.Advance() }
            if (this.CheckValue("{")) {
                this.Advance()
                var depth: int = 1
                while (!this.IsEnd() && depth > 0) {
                    if (this.CheckValue("{")) { depth = depth + 1 }
                    else if (this.CheckValue("}")) { depth = depth - 1 }
                    this.Advance()
                }
            }
            return this.Unknown()
        }

        // TS/C-style free function at file scope:
        //   public List<int> Helper(int n) { ... }
        //   void DoThing() { ... }
        // Parses without complaint today and the cgen emits the
        // call site as `Helper(...)` against no definition, leaking
        // an `-Wimplicit-function-declaration` warning into the
        // user binary. Same root cause as the `fn` keyword case
        // above: free functions aren't supported, hang the helper
        // on a class as `public static` instead. Detect by
        // scanning the next ~16 tokens for an `IDENT (` pair
        // before any `{` / `;` / `}` punctuator — the `IDENT (`
        // pattern is the signature start. False positive only on
        // top-level bare calls (already invalid Amalgame).
        let startTok = this.Current()
        var foundFreeFn: bool = false
        var freeFnName:  string = "<anonymous>"
        var lookI: int = 0
        while (lookI < 16 && !this.IsEnd()) {
            let t  = this.Peek(lookI)
            let t1 = this.Peek(lookI + 1)
            let tv: string = t.Value
            if (t.Type == TokenType.IDENTIFIER && t1.Value == "(") {
                freeFnName  = t.Value
                foundFreeFn = true
                break
            }
            if (tv == "{" || tv == ";" || tv == "}") { break }
            lookI = lookI + 1
        }
        if (foundFreeFn) {
            this.Errors.Add("Top-level functions aren't supported (got '" + freeFnName + "' at " + String_FromInt(startTok.Line) + ":" + String_FromInt(startTok.Column) + "). Wrap it inside a class as `public static`.")
            while (!this.IsEnd() && !this.CheckValue("{")) { this.Advance() }
            if (this.CheckValue("{")) {
                this.Advance()
                var depth: int = 1
                while (!this.IsEnd() && depth > 0) {
                    if (this.CheckValue("{")) { depth = depth + 1 }
                    else if (this.CheckValue("}")) { depth = depth - 1 }
                    this.Advance()
                }
            }
            return this.Unknown()
        }

        this.Advance()
        return this.Unknown()
    }

    // ── Class ─────────────────────────────────────────

    private AstNode ParseClass(bool isPublic) {
        let tok = this.Advance()
        let nameTok = this.ExpectIdent()
        let cls = Ast.Class(nameTok.Value, tok.Line, tok.Column)
        cls.Flag = isPublic

        if (this.CheckValue("<")) {
            this.Advance()
            var gparams = ""
            while (!this.IsEnd() && !this.CheckValue(">")) {
                if (this.CheckValue(",")) { this.Advance(); continue }
                if (this.CheckType(TokenType.IDENTIFIER)) {
                    let pTok = this.Advance()
                    if (String_Length(gparams) > 0) { gparams = gparams + "," }
                    gparams = gparams + pTok.Value
                } else {
                    this.Advance()
                }
            }
            if (this.CheckValue(">")) { this.Advance() }
            cls.Str3 = gparams
        }

        if (this.CheckKw("extends")) {
            this.Advance()
            cls.Str = this.ParseQualifiedName()
        }

        // implements Interface1, Interface2 — capture as CSV in Str4
        if (this.CheckKw("implements")) {
            this.Advance()
            var impl = ""
            while (!this.IsEnd() && !this.CheckValue("{") && !this.CheckType(TokenType.NEWLINE)) {
                if (this.CheckValue(",")) { this.Advance(); continue }
                let iname = this.ParseTypeName()
                if (String_Length(iname) > 0) {
                    if (String_Length(impl) > 0) { impl = impl + "," }
                    impl = impl + iname
                }
            }
            cls.Str4 = impl
        }
        this.SkipNewlines()

        var classLastPos = 0
        while (!this.IsEnd() && !this.CheckValue("}")) {
            this.SkipNewlines()
            if (this.CheckValue("}")) { break }
            let classPos = this.Pos
            if (classPos == classLastPos && classLastPos > 0) {
                this.Advance()
                if (this.CheckValue("}")) { break }
            }
            classLastPos = this.Pos
                    let member = this.ParseMember()
            let mk = member.Kind
            if (mk != NodeKind.IDENTIFIER) {
                cls.Children.Add(member)
            }
            this.SkipNewlines()
        }
        // Record the line of the closing `}` for amc fmt (see ParseBlock).
        let clsClose = this.Current()
        cls.Str2 = String_FromInt(clsClose.Line)
        this.Expect("}")
        return cls
    }

    // Parse "data class Name(type field, ...)" → CLASS_DECL with fields + constructor
    private AstNode ParseDataClass(bool isPublic) {
        // consume 'class' only if present (not when called from 'record')
        if (this.CheckKw("class")) {
            this.Advance()
        }
        let nameTok = this.ExpectIdent()
        let cls = Ast.Class(nameTok.Value, nameTok.Line, nameTok.Column)
        cls.Flag = isPublic
        // Parse constructor params as fields: (type Name, type Name, ...)
        if (this.CheckValue("(")) {
            this.Advance()
            var ctor = Ast.Method(nameTok.Value, "void", nameTok.Line, nameTok.Column)
            ctor.Flag = true
            while (!this.IsEnd() && !this.CheckValue(")")) {
                this.SkipNewlines()
                if (this.CheckValue(")")) { break }
                if (this.CheckValue(",")) { this.Advance() }
                this.SkipNewlines()
                if (this.CheckValue(")")) { break }
                let ftype = this.ParseTypeName()
                let fname = this.ExpectIdent()
                // Add as public field
                let field = Ast.VarDecl(fname.Value, true, fname.Line, fname.Column)
                field.Str = ftype
                field.Flag = true
                cls.Children.Add(field)
                // Add as constructor param
                let param = Ast.Param(fname.Value, ftype, fname.Line, fname.Column)
                ctor.Params.Add(param)
                if (this.CheckValue(",")) { this.Advance() }
            }
            if (this.CheckValue(")")) { this.Advance() }
            cls.Children.Add(ctor)
        }
        // Skip optional body
        if (this.CheckValue("{")) {
            var depth2 = 0
            while (!this.IsEnd()) {
                if (this.CheckValue("{")) { depth2 = depth2 + 1 }
                if (this.CheckValue("}")) {
                    depth2 = depth2 - 1
                    if (depth2 == 0) {
                        this.Advance()
                        break
                    }
                }
                this.Advance()
            }
        }
        return cls
    }

    private AstNode ParseMember() {
        this.SkipNewlines()
        if (this.IsEnd() || this.CheckValue("}")) {
            return this.Unknown()
        }
        // Optional decorators: `@inline @deprecated public string Foo() {...}`.
        // The names are stashed in PendingDecorators and the actual decl
        // (ParseMethod / ParseField) consumes them via TakeDecorators().
        this.ParseDecoratorList()
        var isPublic = false
        var isStatic = false

        if (this.CheckKw("public")) {
            isPublic = true
            this.Advance()
        }
        if (this.CheckKw("private")) {
            this.Advance()
        }
        if (this.CheckKw("static")) {
            isStatic = true
            this.Advance()
        }

        let tok = this.Current()

        if (this.CheckType(TokenType.IDENTIFIER)) {
            let peek = this.Peek(1)
            if (peek.Value == ":") {
                return this.ParseField(isPublic)
            }
            if (peek.Value == "(") {
                return this.ParseMethod("void", isPublic, isStatic, tok.Line, tok.Column)
            }
            let typeName = this.ParseTypeName()
            let nameTok = this.Current()
            if (this.CheckType(TokenType.IDENTIFIER)) {
                return this.ParseMethod(typeName, isPublic, isStatic, tok.Line, tok.Column)
            }
        } else if (tok.Value == "int" || tok.Value == "string" || tok.Value == "bool" || tok.Value == "void" || tok.Value == "float") {
            // Keyword return type: int Foo(), string Bar(), etc.
            let typeName = this.ParseTypeName()
            if (this.CheckType(TokenType.IDENTIFIER)) {
                return this.ParseMethod(typeName, isPublic, isStatic, tok.Line, tok.Column)
            }
        } else if (tok.Value == "(") {
            // Tuple return type: (int, string) Foo() { ... }
            // Collect tuple type names
            this.Advance() // consume '('
            var tupleTypes = ""
            var tupleCount = 0
            while (!this.IsEnd() && !this.CheckValue(")")) {
                this.SkipNewlines()
                if (this.CheckValue(",")) { this.Advance() continue }
                let tname = this.ParseTypeName()
                if (tupleCount > 0) { tupleTypes = tupleTypes + "," }
                tupleTypes = tupleTypes + tname
                tupleCount = tupleCount + 1
            }
            if (this.CheckValue(")")) { this.Advance() } // consume ')'
            this.SkipNewlines()
            // Now expect method name
            if (this.CheckType(TokenType.IDENTIFIER)) {
                let retType = "(" + tupleTypes + ")"
                let method = this.ParseMethod(retType, isPublic, isStatic, tok.Line, tok.Column)
                return method
            }
            return this.Unknown()
        }

        while (!this.IsEnd() && !this.CheckType(TokenType.NEWLINE) && !this.CheckValue("}")) {
            this.Advance()
        }
        return this.Unknown()
    }

    // ── Field ─────────────────────────────────────────

    private AstNode ParseField(bool isPublic) {
        let nameTok = this.ExpectIdent()
        this.Expect(":")
        let typeName = this.ParseTypeName()
        let field = Ast.VarDecl(nameTok.Value, false, nameTok.Line, nameTok.Column)
        field.Str  = typeName
        field.Flag = isPublic
        if (this.CheckValue("=")) {
            this.Advance()
            field.Left = this.ParseExpr()
        }
        return field
    }

    // ── Method ────────────────────────────────────────

    private AstNode ParseMethod(string retType, bool isPublic, bool isStatic, int line, int col) {
        let nameTok = this.ExpectIdent()
        let method = Ast.Method(nameTok.Value, retType, line, col)
        method.Flag  = isPublic
        method.Flag2 = isStatic
        // Decorators stashed by ParseMember/ParseDecoratorList — store on Str2.
        method.Str2  = this.TakeDecorators()
        let mname = nameTok.Value

        if (this.CheckValue("<")) {
            this.Advance()
            while (!this.IsEnd() && !this.CheckValue(">")) { this.Advance() }
            if (this.CheckValue(">")) { this.Advance() }
        }

        this.Expect("(")
        this.SkipNewlines()
        while (!this.IsEnd() && !this.CheckValue(")")) {
            if (this.CheckValue(",")) {
                this.Advance()
                this.SkipNewlines()
                continue
            }
            // Safety belt: if ParseParam fails to advance the cursor,
            // skip one token to break what would otherwise be an
            // infinite loop. ParseParam's branches all consume at
            // least one token now, but this guards future regressions.
            let beforePos: int = this.Pos
            let p = this.ParseParam()
            if (this.Pos == beforePos) {
                this.Advance()
            }
            let pk = p.Kind
            if (pk != NodeKind.IDENTIFIER) {
                method.Params.Add(p)
            }
            this.SkipNewlines()
        }
        this.Expect(")")

        if (this.CheckValue("=>")) {
            this.Advance()
            let body = Ast.Block(line, col)
            let ret = Ast.Return(this.ParseExpr(), line, col)
            body.Children.Add(ret)
            method.Body = body
            return method
        }

        this.SkipNewlines()
        if (this.CheckValue("{")) {
            method.Body = this.ParseBlock()
        }
        return method
    }

    // ── Param ─────────────────────────────────────────
    //
    // Amalgame param syntax is C-style: `<type> <name>` (e.g. `int id`,
    // `string title`). The TypeScript-style `<name>: <type>` form
    // (e.g. `id: int`) is NOT valid Amalgame syntax — it shows up in
    // LLM-migrated code (`amc migrate`) when the model defaults to
    // colon syntax. Without explicit handling, ParseTypeName would
    // consume `id` as a typeName, then the `:` would not match an
    // IDENTIFIER, then the param-list loop in ParseMethod would not
    // advance, and the parser would spin forever. We detect the
    // colon explicitly and emit an error so the user sees an
    // actionable diagnostic.
    private AstNode ParseParam() {
        let tok = this.Current()
        let v = tok.Value
        let isKeywordType = v == "int" || v == "string" || v == "bool" || v == "void" || v == "float"
        if (!this.CheckType(TokenType.IDENTIFIER) && !isKeywordType) {
            // Unknown opening token — consume one to break any
            // outer loop (the caller may not advance otherwise).
            this.Advance()
            return this.Unknown()
        }
        let typeName = this.ParseTypeName()
        // TypeScript-style `<name>: <type>` detection. The token
        // we just consumed as `typeName` is actually the name; the
        // ':' confirms that, and the next identifier/keyword is the
        // real type. Consume them all so the param list can advance,
        // and return a Param built with the corrected name+type.
        if (this.CheckValue(":")) {
            this.Advance()
            let realTypeTok = this.Current()
            let rv = realTypeTok.Value
            let rIsKeywordType = rv == "int" || rv == "string" || rv == "bool" || rv == "void" || rv == "float"
            if (this.CheckType(TokenType.IDENTIFIER) || rIsKeywordType) {
                let realType = this.ParseTypeName()
                return Ast.Param(typeName, realType, tok.Line, tok.Column)
            }
            // ':' but no following type — drop the param, but at
            // least we consumed enough to break the loop.
            return Ast.Param(typeName, "?", tok.Line, tok.Column)
        }
        if (!this.CheckType(TokenType.IDENTIFIER)) {
            return Ast.Param("_", typeName, 0, 0)
        }
        let nameTok = this.ExpectIdent()
        return Ast.Param(nameTok.Value, typeName, nameTok.Line, nameTok.Column)
    }

    // ── Type name ─────────────────────────────────────

    private string ParseTypeName() {
        let tok = this.Current()
        let v = tok.Value
        if (!this.CheckType(TokenType.IDENTIFIER)) {
            if (v == "void" || v == "int" || v == "string" || v == "bool" || v == "float") {
                this.Advance()
                var kwName = v
                if (this.CheckValue("[")) {
                    this.Advance()
                    this.Expect("]")
                    kwName = kwName + "[]"
                }
                return kwName
            }
            return "void"
        }
        let nameTok = this.ExpectIdent()
        var name = nameTok.Value
        if (this.CheckValue("<")) {
            this.Advance()
            name = name + "<"
            var depth = 1
            while (!this.IsEnd() && depth > 0) {
                let inner = this.Current()
                let iv = inner.Value
                if (iv == ">>") {
                    // Bug 8: lexer fuses two closing `>` of nested
                    // generics (`List<List<int>>`) into a single OP_SHR
                    // token. Treat as two `>` for depth bookkeeping —
                    // append the inner closers and let the post-loop
                    // `name + ">"` re-emit the outermost one.
                    if (depth >= 3) {
                        name  = name + ">>"
                        depth = depth - 2
                    } else if (depth == 2) {
                        name  = name + ">"
                        depth = 0
                    } else {
                        // depth == 1: stray `>` past the outer generic.
                        // Bail at 0 and let downstream surface the error.
                        depth = 0
                    }
                    this.Advance()
                } else {
                    if (iv == "<") { depth = depth + 1 }
                    if (iv == ">") { depth = depth - 1 }
                    if (depth > 0) { name = name + iv }
                    this.Advance()
                }
            }
            name = name + ">"
        }
        if (this.CheckValue("[")) {
            this.Advance()
            this.Expect("]")
            name = name + "[]"
        }
        if (this.CheckValue("?")) {
            this.Advance()
            name = name + "?"
        }
        return name
    }

    // ── Block ─────────────────────────────────────────

    private AstNode ParseBlock() {
        let tok = this.Expect("{")
        let block = Ast.Block(tok.Line, tok.Column)
        this.SkipNewlines()
        var lastPos = 0
        var hadProgress = true
        while (!this.IsEnd() && !this.CheckValue("}")) {
            this.SkipNewlines()
            if (this.CheckValue("}")) { break }
            let curPos = this.Pos
            if (!hadProgress) {
                this.Advance()
                this.SkipNewlines()
                if (this.CheckValue("}")) { break }
                if (this.IsEnd()) { break }
            }
            lastPos = this.Pos
            hadProgress = false
            let stmt = this.ParseStmt()
            block.Children.Add(stmt)
            hadProgress = true
            this.SkipNewlines()
        }
        // Record the line of the closing `}` so amc fmt can preserve
        // blank-line spacing across block boundaries. Used only by the
        // formatter; other passes ignore Str2 on BLOCK nodes.
        let closeTok = this.Current()
        block.Str2 = String_FromInt(closeTok.Line)
        this.Expect("}")
        return block
    }

    // ── Statement ─────────────────────────────────────

    private AstNode ParseStmt() {
        this.SkipNewlines()
        if (this.IsEnd() || this.CheckValue("}")) {
            return this.Unknown()
        }
        let tok = this.Current()
        let v   = tok.Value

        // Inline-C raw blocks come in as a single INLINE_C token from the
        // lexer; dispatch by type since the value carries the raw body.
        if (tok.Type == TokenType.INLINE_C) { return this.ParseInlineC() }

        if (v == "let" || v == "var") { return this.ParseVarDecl() }
        if (v == "return") { return this.ParseReturn() }
        if (v == "if") { return this.ParseIf() }
        if (v == "while") { return this.ParseWhile() }
        if (v == "for") { return this.ParseForIn() }
        if (v == "break") {
            this.Advance()
            let n = new AstNode(NodeKind.BREAK_STMT, tok.Line, tok.Column)
            return n
        }
        if (v == "continue") {
            this.Advance()
            let n = new AstNode(NodeKind.CONTINUE_STMT, tok.Line, tok.Column)
            return n
        }
        if (v == "match") { return this.ParseMatch() }
        if (v == "guard") { return this.ParseGuard() }
        if (v == "try")   { return this.ParseTry() }
        if (v == "throw") { return this.ParseThrow() }
        if (v == "{") { return this.ParseBlock() }
        return this.ParseExpr()
    }

    // ── Try / Throw ──────────────────────────────────
    // try { ... } catch e { ... } [finally { ... }]
    //   TRY_STMT { Body=try-block, Else=catch-block, Cond=finally?, Name=binder }
    // The catch binder is typed `void*` everywhere — it lands in the scope
    // of the catch block as `void* e = _am_ex.value;` at codegen.
    private AstNode ParseTry() {
        let tok = this.Advance()  // consume 'try'
        this.SkipNewlines()
        let tryBlock = this.ParseBlock()
        this.SkipNewlines()
        let node = new AstNode(NodeKind.TRY_STMT, tok.Line, tok.Column)
        node.Body = tryBlock
        if (this.CheckKw("catch")) {
            this.Advance()
            // Optional binder identifier: `catch e { … }` or `catch { … }`
            if (this.CheckType(TokenType.IDENTIFIER)) {
                let bind = this.Advance()
                node.Name = bind.Value
            }
            this.SkipNewlines()
            node.Else = this.ParseBlock()
            this.SkipNewlines()
        }
        if (this.CheckKw("finally")) {
            this.Advance()
            this.SkipNewlines()
            node.Cond = this.ParseBlock()
        }
        return node
    }

    // throw <expr>  — typically `throw new SomeError("msg")`.
    private AstNode ParseThrow() {
        let tok = this.Advance()  // consume 'throw'
        let n = new AstNode(NodeKind.THROW_STMT, tok.Line, tok.Column)
        if (!this.CheckType(TokenType.NEWLINE) && !this.CheckValue("}") && !this.IsEnd()) {
            n.Left = this.ParseExpr()
        }
        return n
    }

    // `@c { ... }` — inline-C raw block. The lexer already captured the body
    // as the token value; here we just wrap it in an AST node.
    private AstNode ParseInlineC() {
        let tok = this.Advance()
        return Ast.InlineC(tok.Value, tok.Line, tok.Column)
    }

    // ── VarDecl ───────────────────────────────────────

    private AstNode ParseVarDecl() {
        let kwTok = this.Advance()
        let isMut = kwTok.Value == "var"

        // Tuple destructuring: let (a, b) = expr
        if (this.CheckValue("(")) {
            this.Advance() // consume '('
            let names = new List<string>()
            while (!this.IsEnd() && !this.CheckValue(")")) {
                this.SkipNewlines()
                if (this.CheckValue(",")) { this.Advance() continue }
                if (this.CheckType(TokenType.IDENTIFIER)) {
                    let n = this.Advance()
                    names.Add(n.Value)
                }
            }
            if (this.CheckValue(")")) { this.Advance() } // consume ')'
            // Expect '='
            if (this.CheckValue("=")) { this.Advance() }
            let rhs = this.ParseExpr()
            // Build a TUPLE_DESTRUCTURE node — store names in Children as IDENTIFIER nodes
            let td = Ast.VarDecl("__tuple__", isMut, kwTok.Line, kwTok.Column)
            td.Left = rhs
            let nc = names.Count()
            for i in 0..nc {
                let vname = names.Get(i)
                let vnode = Ast.Ident(vname, kwTok.Line, kwTok.Column)
                td.Children.Add(vnode)
            }
            td.Str = "__tuple_destructure__"
            return td
        }

        let nameTok = this.ExpectIdent()
        let decl = Ast.VarDecl(nameTok.Value, isMut, nameTok.Line, nameTok.Column)
        if (this.CheckValue(":")) {
            this.Advance()
            decl.Str = this.ParseTypeName()
        }
        if (this.CheckValue("=")) {
            let eqTok = this.Advance()
            // Reject obviously-missing RHS upfront. Pre-fix the parser
            // silently accepted `let x =\n…` and synthesised an
            // `_unknown_` placeholder that survived all the way to
            // gcc, which then complained about "_unknown_ undeclared".
            // The user got no actionable diagnostic from amc.
            //
            // Use type-based checks (NEWLINE / RBRACE) not CheckValue —
            // a literal string `"}"` matches CheckValue("}") because
            // that compares Token.Value, and would fail self-host on
            // legitimate code like `let rb: string = "}"`.
            if (this.CheckType(TokenType.NEWLINE) || this.CheckType(TokenType.RBRACE) || this.IsEnd()) {
                this.Errors.Add("Expected expression after '=' at " + String_FromInt(eqTok.Line) + ":" + String_FromInt(eqTok.Column))
                decl.Left = this.Unknown()
            } else {
                decl.Left = this.ParseExpr()
            }
        }
        return decl
    }

    // ── Return ────────────────────────────────────────

    private AstNode ParseReturn() {
        let tok = this.Advance()
        if (this.CheckType(TokenType.NEWLINE) || this.CheckValue("}") || this.IsEnd()) {
            return Ast.Return(this.Unknown(), tok.Line, tok.Column)
        }
        return Ast.Return(this.ParseExpr(), tok.Line, tok.Column)
    }

    // ── If ────────────────────────────────────────────

    private AstNode ParseIf() {
        let tok = this.Advance()
        let hasParen = this.CheckValue("(")
        if (hasParen) {
            this.Advance()
            this.ParenDepth = this.ParenDepth + 1
        }
        let cond = this.ParseExpr()
        if (hasParen) {
            this.ParenDepth = this.ParenDepth - 1
            this.Expect(")")
        }
        this.SkipNewlines()
        let then = this.ParseBlock()
        let node = Ast.If(cond, then, tok.Line, tok.Column)
        this.SkipNewlines()
        if (this.CheckKw("else")) {
            this.Advance()
            this.SkipNewlines()
            node.Flag = true
            if (this.CheckKw("if")) {
                node.Else = this.ParseIf()
            } else {
                node.Else = this.ParseBlock()
            }
        }
        return node
    }

    // ── Guard ─────────────────────────────────────────
    // `guard <expr> else { ... }` desugars to `if (!<expr>) { ... }`.
    // The else-block is mandatory and is expected to exit the current scope
    // (return / throw / break / continue) — but enforcement is left to the
    // user for now. Emit as a regular IF_STMT with a UNARY-NOT condition.

    private AstNode ParseGuard() {
        let tok = this.Advance()
        let hasParen = this.CheckValue("(")
        if (hasParen) {
            this.Advance()
            this.ParenDepth = this.ParenDepth + 1
        }
        let cond = this.ParseExpr()
        if (hasParen) {
            this.ParenDepth = this.ParenDepth - 1
            this.Expect(")")
        }
        this.SkipNewlines()
        // `else` is mandatory after the condition
        if (this.CheckKw("else")) {
            this.Advance()
        }
        this.SkipNewlines()
        let body = this.ParseBlock()
        // Build the negated condition: UNARY '!' applied to cond
        let neg = new AstNode(NodeKind.UNARY, tok.Line, tok.Column)
        neg.Str  = "!"
        neg.Left = cond
        // Wrap as a normal if-stmt — body runs only when guard fails.
        return Ast.If(neg, body, tok.Line, tok.Column)
    }

    // ── While ─────────────────────────────────────────

    private AstNode ParseWhile() {
        let tok = this.Advance()
        let hasParen = this.CheckValue("(")
        if (hasParen) {
            this.Advance()
            this.ParenDepth = this.ParenDepth + 1
        }
        let cond = this.ParseExpr()
        if (hasParen) {
            this.ParenDepth = this.ParenDepth - 1
            this.Expect(")")
        }
        this.SkipNewlines()
        let body = this.ParseBlock()
        let node = new AstNode(NodeKind.WHILE_STMT, tok.Line, tok.Column)
        node.Cond = cond
        node.Body = body
        return node
    }

    // ── For-in ────────────────────────────────────────

    private AstNode ParseForIn() {
        let tok = this.Advance()
        let varTok = this.ExpectIdent()
        this.Expect("in")
        let iter = this.ParseExpr()
        this.SkipNewlines()
        let body = this.ParseBlock()
        let node = new AstNode(NodeKind.FOR_IN_STMT, tok.Line, tok.Column)
        node.Name = varTok.Value
        node.Left = iter
        node.Body = body
        return node
    }

    // ── Enum ──────────────────────────────────────────

    private AstNode ParseEnum(bool isPublic) {
        let tok = this.Advance()
        let nameTok = this.ExpectIdent()
        let en = new AstNode(NodeKind.ENUM_DECL, tok.Line, tok.Column)
        en.Name = nameTok.Value
        en.Flag = isPublic
        this.SkipNewlines()
        this.Expect("{")
        this.SkipNewlines()
        while (!this.IsEnd() && !this.CheckValue("}")) {
            if (this.CheckType(TokenType.NEWLINE)) { this.Advance() continue }
            if (this.CheckValue(",")) { this.Advance() continue }
            if (!this.CheckType(TokenType.IDENTIFIER)) { this.Advance() continue }
            let memberTok = this.ExpectIdent()
            let member = Ast.Ident(memberTok.Value, memberTok.Line, memberTok.Column)
            // Parse payload types: Circle(int) or Rectangle(int, int)
            if (this.CheckValue("(")) {
                this.Advance()
                var typeList = ""
                var typeCount = 0
                while (!this.IsEnd() && !this.CheckValue(")")) {
                    if (this.CheckValue(",")) { this.Advance() continue }
                    let tname = this.ParseTypeName()
                    if (typeCount > 0) { typeList = typeList + "," }
                    typeList = typeList + tname
                    typeCount = typeCount + 1
                }
                this.Expect(")")
                member.Str = typeList // store payload types as comma-separated
            }
            en.Children.Add(member)
            this.SkipNewlines()
        }
        this.Expect("}")
        return en
    }

    // ── Interface ─────────────────────────────────────

    private AstNode ParseInterface(bool isPublic) {
        let tok = this.Advance()
        let nameTok = this.ExpectIdent()
        let iface = new AstNode(NodeKind.CLASS_DECL, tok.Line, tok.Column)
        iface.Name  = nameTok.Value
        iface.Flag  = isPublic
        iface.Flag2 = true
        // Generic params <T,U> — captured into Str3 as CSV
        if (this.CheckValue("<")) {
            this.Advance()
            var gparams = ""
            while (!this.IsEnd() && !this.CheckValue(">")) {
                if (this.CheckValue(",")) { this.Advance(); continue }
                if (this.CheckType(TokenType.IDENTIFIER)) {
                    let pTok = this.Advance()
                    if (String_Length(gparams) > 0) { gparams = gparams + "," }
                    gparams = gparams + pTok.Value
                } else {
                    this.Advance()
                }
            }
            if (this.CheckValue(">")) { this.Advance() }
            iface.Str3 = gparams
        }
        this.SkipNewlines()
        this.Expect("{")
        this.SkipNewlines()
        while (!this.IsEnd() && !this.CheckValue("}")) {
            this.SkipNewlines()
            if (this.CheckValue("}")) { break }
            // Two syntaxes:
            //   RetType MethodName(params)      (classic)
            //   MethodName(params) -> RetType   (arrow)
            var typeName = "void"
            var methodName = "_unknown_"
            var mline = this.Current().Line
            var mcol  = this.Current().Column
            // Check if next token is an identifier followed by ( → arrow syntax
            if (this.CheckType(TokenType.IDENTIFIER)) {
                let peek1 = this.Peek(1)
                if (peek1.Value == "(") {
                    // Arrow syntax: Name(params) -> RetType
                    let mnameTok2 = this.ExpectIdent()
                    methodName = mnameTok2.Value
                    mline = mnameTok2.Line
                    mcol  = mnameTok2.Column
                } else {
                    // Classic: RetType Name(params)
                    typeName = this.ParseTypeName()
                    let mnameTok3 = this.ExpectIdent()
                    methodName = mnameTok3.Value
                    mline = mnameTok3.Line
                    mcol  = mnameTok3.Column
                }
            }
            let m = Ast.Method(methodName, typeName, mline, mcol)
            this.Expect("(")
            while (!this.IsEnd() && !this.CheckValue(")")) {
                if (this.CheckValue(",")) { this.Advance() }
                if (this.CheckValue(")")) { break }
                // Safety belt against an infinite-loop regression: if
                // ParseParam doesn't advance, force a one-token skip.
                let beforePos: int = this.Pos
                let p = this.ParseParam()
                if (this.Pos == beforePos) {
                    this.Advance()
                }
                m.Params.Add(p)
            }
            this.Expect(")")
            // Handle arrow syntax: -> RetType
            if (this.CheckValue("->")) {
                this.Advance()
                let retType2 = this.ParseTypeName()
                m.Str = retType2
            }
            iface.Children.Add(m)
            this.SkipNewlines()
        }
        this.Expect("}")
        return iface
    }

    // ── Expressions ────────────────────────────────────

    private AstNode ParseExpr() {
        // Lambda single-param: x => expr  or  x => { stmts }
        if (this.CheckType(TokenType.IDENTIFIER) && this.Peek(1).Value == "=>") {
            return this.ParseLambdaSingle()
        }
        // Lambda multi-param: (x, y, ...) => expr  or  ... => { stmts }
        // Also (x) => is accepted for symmetry with multi-param syntax.
        // Looks ahead through the identifier list to disambiguate from
        // a regular parenthesised expression starting with an ident.
        if (this.CheckValue("(") && this.IsLambdaParenStart()) {
            return this.ParseLambdaMulti()
        }
        return this.ParseAssign()
    }

    // True if the current "(" opens a lambda param list — i.e. a comma
    // list of identifiers (with optional `:type` annotations) followed
    // by ")" "=>". Anything else (a real expression) returns false so
    // the caller falls through to ParseAssign.
    //
    // Accepted shapes:
    //   ()                             empty
    //   (x)                            bare ident
    //   (x, y, z)                      multi bare idents
    //   (x: string)                    typed ident
    //   (x: string, y: int)            multi typed
    //   (x, y: int)                    mixed bare + typed
    private bool IsLambdaParenStart() {
        var i: int = 1
        // Empty parens: () =>
        if (this.Peek(i).Value == ")") {
            return this.Peek(i + 1).Value == "=>"
        }
        // (ident [":" typename] ("," ident [":" typename])*) =>
        while (true) {
            if (this.Peek(i).Type != TokenType.IDENTIFIER) { return false }
            i = i + 1
            // Optional `:type` annotation — skip past the type tokens.
            // A type is one ident/keyword, optionally followed by `?`
            // or generic brackets `<...>` / array brackets `[]`. The
            // ParseTypeName logic is more elaborate; here we just want
            // enough lookahead to reach `,` or `)`.
            if (this.Peek(i).Value == ":") {
                i = i + 1
                if (this.Peek(i).Type != TokenType.IDENTIFIER) {
                    let v = this.Peek(i).Value
                    let isKw = v == "int" || v == "string" || v == "bool" || v == "void" || v == "float"
                    if (!isKw) { return false }
                }
                i = i + 1
                // Optional `<...>` generic args — skip to the matching `>`.
                if (this.Peek(i).Value == "<") {
                    var depth: int = 1
                    i = i + 1
                    while (depth > 0 && this.Peek(i).Type != TokenType.EOF) {
                        let v2 = this.Peek(i).Value
                        if (v2 == ">>") {
                            // Bug 8: `>>` (OP_SHR) inside a generic
                            // closes two levels at once.
                            depth = depth - 2
                            if (depth < 0) { depth = 0 }
                        } else {
                            if (v2 == "<") { depth = depth + 1 }
                            if (v2 == ">") { depth = depth - 1 }
                        }
                        i = i + 1
                    }
                }
                // Optional `[]` array suffix
                if (this.Peek(i).Value == "[") {
                    if (this.Peek(i + 1).Value == "]") { i = i + 2 }
                }
                // Optional `?` nullable suffix
                if (this.Peek(i).Value == "?") { i = i + 1 }
            }
            if (this.Peek(i).Value == ")") {
                return this.Peek(i + 1).Value == "=>"
            }
            if (this.Peek(i).Value != ",") { return false }
            i = i + 1
        }
        return false
    }

    private AstNode ParseLambdaSingle() {
        let paramTok = this.Advance()  // param name
        this.Advance()                 // =>
        let lam = new AstNode(NodeKind.METHOD_DECL, paramTok.Line, paramTok.Column)
        lam.Name = "__lambda__"
        let p = Ast.Param(paramTok.Value, "?", paramTok.Line, paramTok.Column)
        lam.Params.Add(p)
        this.ParseLambdaBody(lam)
        return lam
    }

    private AstNode ParseLambdaMulti() {
        let openTok = this.Advance()   // "("
        let lam = new AstNode(NodeKind.METHOD_DECL, openTok.Line, openTok.Column)
        lam.Name = "__lambda__"
        while (!this.IsEnd() && !this.CheckValue(")")) {
            if (this.CheckValue(",")) { this.Advance(); continue }
            let pTok = this.ExpectIdent()
            // Optional `:<type>` annotation. Without it the param type
            // stays `"?"` and downstream falls back to the legacy i64
            // boxing. With it, c_gen emits a typed cast at the lambda's
            // C entry — unblocking `(req: string) => ...` style handlers
            // used by webview-style C callbacks. v2.6+.
            var pType: string = "?"
            if (this.CheckValue(":")) {
                this.Advance()
                pType = this.ParseTypeName()
            }
            let p = Ast.Param(pTok.Value, pType, pTok.Line, pTok.Column)
            lam.Params.Add(p)
        }
        this.Expect(")")
        this.Advance()                 // =>
        this.ParseLambdaBody(lam)
        return lam
    }

    // Body shape: either an expression (stored in Left) or a brace
    // block (stored in Body). The two are mutually exclusive — the
    // resolver and CGen test which one is non-null.
    private void ParseLambdaBody(AstNode lam) {
        if (this.CheckValue("{")) {
            lam.Body = this.ParseBlock()
        } else {
            lam.Left = this.ParseExpr()
        }
    }

    private AstNode ParseAssign() {
        let left = this.ParseRange()
        let isAssign = this.CheckValue("=") || this.CheckValue("+=") || this.CheckValue("-=") || this.CheckValue("*=") || this.CheckValue("/=") || this.CheckValue("%=")
        let isBitAssign = this.CheckValue("&=") || this.CheckValue("|=") || this.CheckValue("^=") || this.CheckValue("<<=") || this.CheckValue(">>=")
        if (isAssign || isBitAssign) {
            let tok = this.Advance()
            let right = this.ParseAssign()
            return Ast.Binary(left, tok.Value, right, tok.Line, tok.Column)
        }
        return left
    }

    // ParseRange — `..` as a proper binary operator (v0.8.25). Sits
    // between ParseAssign and ParseOr in the precedence ladder, just
    // above the logical ops. Before this, `..` was only recognised
    // inside ParsePrimary's integer + identifier branches with the
    // RHS pulled via ParsePostfix (v0.8.24 fix for Bug 5). That
    // resolved `0..xs.Count()` but the mirror form `xs.Count()..N`
    // still didn't parse — `xs.Count()` was consumed by ParsePostfix
    // as a normal expression, then the `..` was unrecognised at any
    // outer level. Pulling `..` up to a regular binary-op layer
    // works for both directions and for any mixed shape
    // (`a + b .. c * d`, `xs.Count() .. ys.Count()`, …).
    //
    // Non-associative: `a..b..c` is rejected by leaving the second
    // `..` for the caller, which surfaces as a parse error one level
    // up. Mirrors Rust's semantics — chained ranges have no obvious
    // meaning in Amalgame.
    private AstNode ParseRange() {
        let left = this.ParseOr()
        if (this.CheckValue("..")) {
            let tok = this.Advance()
            let right = this.ParseOr()
            return Ast.Binary(left, "..", right, tok.Line, tok.Column)
        }
        return left
    }

    private AstNode ParseOr() {
        var left = this.ParseBitwiseOr()
        while (true) {
            // Multi-line continuation — same shape as ParseAdd /
            // ParseMul (v0.8.14). Tolerate a newline before the
            // `||` so `if (a\n   || b\n   || c)` parses cleanly,
            // and tolerate `expr ||\n   next` (operator at EOL).
            if (this.CheckType(TokenType.NEWLINE)) {
                if (!this.LookaheadAfterNewlinesIs("||", "", "")) { break }
                this.SkipNewlines()
            }
            if (!this.CheckValue("||")) { break }
            let tok = this.Advance()
            this.SkipNewlines()
            let right = this.ParseBitwiseOr()
            left = Ast.Binary(left, "||", right, tok.Line, tok.Column)
        }
        return left
    }

    private AstNode ParseBitwiseOr() {
        var left = this.ParseBitwiseXor()
        while (this.CheckValue("|") && !this.CheckValue("||")) {
            let tok = this.Advance()
            let right = this.ParseBitwiseXor()
            left = Ast.Binary(left, "|", right, tok.Line, tok.Column)
        }
        return left
    }

    private AstNode ParseBitwiseXor() {
        var left = this.ParseBitwiseAnd()
        while (this.CheckValue("^")) {
            let tok = this.Advance()
            let right = this.ParseBitwiseAnd()
            left = Ast.Binary(left, "^", right, tok.Line, tok.Column)
        }
        return left
    }

    private AstNode ParseBitwiseAnd() {
        var left = this.ParseAnd()
        while (this.CheckValue("&") && !this.CheckValue("&&")) {
            let tok = this.Advance()
            let right = this.ParseAnd()
            left = Ast.Binary(left, "&", right, tok.Line, tok.Column)
        }
        return left
    }

    private AstNode ParseAnd() {
        var left = this.ParseEquality()
        while (true) {
            // Multi-line continuation — same shape as ParseAdd /
            // ParseMul / ParseOr. Tolerate a newline before the
            // `&&` so `if (cond1\n   && cond2\n   && cond3)` parses
            // cleanly, and tolerate `expr &&\n   next` (operator
            // at EOL).
            if (this.CheckType(TokenType.NEWLINE)) {
                if (!this.LookaheadAfterNewlinesIs("&&", "", "")) { break }
                this.SkipNewlines()
            }
            if (!this.CheckValue("&&")) { break }
            let tok = this.Advance()
            this.SkipNewlines()
            let right = this.ParseEquality()
            left = Ast.Binary(left, "&&", right, tok.Line, tok.Column)
        }
        return left
    }

    private AstNode ParseEquality() {
        var left = this.ParseRelational()
        while (this.CheckValue("==") || this.CheckValue("!=")) {
            let tok = this.Advance()
            let right = this.ParseRelational()
            left = Ast.Binary(left, tok.Value, right, tok.Line, tok.Column)
        }
        return left
    }

    private AstNode ParseRelational() {
        // ParseShift was already wired on the RHS but not the LHS,
        // so `let x: int = r >> 8` parsed as `let x: int = r` and
        // dropped the shift. Calling ParseShift on both sides walks
        // the precedence ladder consistently:
        //   equality > relational > shift > add > mul > unary
        var left = this.ParseShift()
        while (this.CheckValue("<") || this.CheckValue(">") || this.CheckValue("<=") || this.CheckValue(">=")) {
            let tok = this.Advance()
            let right = this.ParseShift()
            left = Ast.Binary(left, tok.Value, right, tok.Line, tok.Column)
        }
        return left
    }

    private AstNode ParseShift() {
        var left = this.ParseAdd()
        while (this.CheckValue("<<") || this.CheckValue(">>")) {
            let tok = this.Advance()
            let right = this.ParseAdd()
            left = Ast.Binary(left, tok.Value, right, tok.Line, tok.Column)
        }
        return left
    }

    private AstNode ParseAdd() {
        var left = this.ParseMul()
        while (true) {
            // Multi-line continuation: tolerate a newline before the
            // operator if the next non-newline token is + or -.
            // Without this, `var s = "a"\n  + "b"\n  + "c"` silently
            // dropped the continuation and produced `s = "a"`.
            if (this.CheckType(TokenType.NEWLINE)) {
                if (!this.LookaheadAfterNewlinesIs("+", "-", "")) { break }
                this.SkipNewlines()
            }
            if (!this.CheckValue("+") && !this.CheckValue("-")) { break }
            let tok = this.Advance()
            this.SkipNewlines()   // also tolerate `expr +\n  next`
            let right = this.ParseMul()
            left = Ast.Binary(left, tok.Value, right, tok.Line, tok.Column)
        }
        return left
    }

    private AstNode ParseMul() {
        var left = this.ParseUnary()
        while (true) {
            if (this.CheckType(TokenType.NEWLINE)) {
                if (!this.LookaheadAfterNewlinesIs("*", "/", "%")) { break }
                this.SkipNewlines()
            }
            if (!this.CheckValue("*") && !this.CheckValue("/") && !this.CheckValue("%")) { break }
            let tok = this.Advance()
            this.SkipNewlines()
            let right = this.ParseUnary()
            left = Ast.Binary(left, tok.Value, right, tok.Line, tok.Column)
        }
        return left
    }

    // True iff the first non-NEWLINE token at-or-after Pos has a value
    // equal to one of s1 / s2 / s3 (pass "" for unused slots). Drives
    // multi-line operator continuation in ParseAdd / ParseMul / etc.
    private bool LookaheadAfterNewlinesIs(string s1, string s2, string s3) {
        var off: int = 0
        let max: int = this.TokenCount
        while (this.Pos + off < max) {
            let t: Token = this.Tokens.Get(this.Pos + off)
            if (t.Type == TokenType.NEWLINE) {
                off = off + 1
                continue
            }
            let v: string = t.Value
            return v == s1 || v == s2 || v == s3
        }
        return false
    }

    private AstNode ParseUnary() {
        // Only treat as unary if the token is actually an operator, not a STRING literal
        let isUnaryNot   = this.CheckValue("!") && !this.CheckType(TokenType.STRING)
        let isUnaryMinus = this.CheckValue("-") && !this.CheckType(TokenType.STRING)
        let isUnaryTilde = this.CheckValue("~") && !this.CheckType(TokenType.STRING)
        if (isUnaryNot || isUnaryMinus || isUnaryTilde) {
            let tok = this.Advance()
            let operand = this.ParseUnary()
            let node = new AstNode(NodeKind.UNARY, tok.Line, tok.Column)
            node.Str  = tok.Value
            node.Left = operand
            return node
        }
        return this.ParsePostfix()
    }

    private AstNode ParsePostfix() {
        var expr = this.ParsePrimary()
        var running = true
        while (running) {
            // Multi-line method chains: skip NEWLINEs when the next
            // non-NEWLINE token continues the expression (`.method` or
            // `?.method`). Lets users write
            //     users
            //         .Filter(u => u.Age >= 18)
            //         .Map(u => u.Name)
            // as a single chained expression. We only skip on a
            // dot-lookahead so statement boundaries (a NEWLINE
            // followed by a new statement) stay intact.
            if (this.CheckType(TokenType.NEWLINE) && this.LookaheadStartsWithDot()) {
                this.SkipNewlines()
            }
            if (this.CheckValue(".")) {
                let tok = this.Advance()
                let memberTok = this.ExpectIdent()
                expr = Ast.Member(expr, memberTok.Value, tok.Line, tok.Column)
                if (this.CheckValue("(")) {
                    expr = this.ParseCallArgs(expr)
                }
            } else if (this.CheckValue("?.")) {
                // Null-safe member access: obj?.field → MEMBER with Flag=true.
                // The CGen wraps the access in a `(obj ? ... : NULL)` ternary.
                let tok = this.Advance()
                let memberTok = this.ExpectIdent()
                let m = Ast.Member(expr, memberTok.Value, tok.Line, tok.Column)
                m.Flag = true
                expr = m
                if (this.CheckValue("(")) {
                    expr = this.ParseCallArgs(expr)
                }
            } else if (this.CheckValue("(")) {
                expr = this.ParseCallArgs(expr)
            } else if (this.CheckValue("[")) {
                let tok = this.Advance()
                let idx = this.ParseExpr()
                this.Expect("]")
                let node = new AstNode(NodeKind.INDEX_EXPR, tok.Line, tok.Column)
                node.Left  = expr
                node.Right = idx
                expr = node
            } else {
                running = false
            }
        }
        return expr
    }

    // True iff the first non-NEWLINE token at-or-after Pos is `.` or `?.`.
    // Used by ParsePostfix to recognize multi-line method chains
    // without swallowing real statement boundaries.
    private bool LookaheadStartsWithDot() {
        var off: int = 0
        let max: int = this.TokenCount
        while (this.Pos + off < max) {
            let t: Token = this.Tokens.Get(this.Pos + off)
            if (t.Type == TokenType.NEWLINE) {
                off = off + 1
                continue
            }
            if (t.Value == "." || t.Value == "?.") { return true }
            return false
        }
        return false
    }

    private AstNode ParseCallArgs(AstNode callee) {
        let tok = this.Expect("(")
        let call = Ast.Call(callee, tok.Line, tok.Column)
        this.ParenDepth = this.ParenDepth + 1
        let myDepth = this.ParenDepth
        this.SkipNewlines()
        var callLastPos = 0
        while (!this.IsEnd()) {
            let callPos = this.Pos
            if (callPos == callLastPos && callLastPos > 0) {
                this.Advance()
                if (this.IsEnd()) { break }
            }
            callLastPos = this.Pos
            // Only treat ) as end-of-args if it's a real RPAREN token, not a STRING ")"
            let isRparen = this.CheckValue(")") && !this.CheckType(TokenType.STRING)
            if (isRparen && this.ParenDepth == myDepth) { break }
            // Only treat , as separator if it's a real COMMA token, not a STRING ","
            let isComma = this.CheckValue(",") && !this.CheckType(TokenType.STRING)
            if (isComma) {
                this.Advance()
                continue
            }
            this.SkipNewlines()
            let isRparen2 = this.CheckValue(")") && !this.CheckType(TokenType.STRING)
            if (isRparen2 && this.ParenDepth == myDepth) { break }
            if (this.IsEnd()) { break }
            // Optional named-argument syntax: `name: value`. The name is
            // documentation-only at the call site for now (no reordering or
            // validation against the callee's signature). The name is stashed
            // on arg.Str2 in case future passes want to consult it.
            var namedKey = ""
            if (this.CheckType(TokenType.IDENTIFIER)) {
                let peek = this.Peek(1)
                if (peek.Value == ":") {
                    let nameTok = this.Advance()
                    this.Advance()  // consume ':'
                    namedKey = nameTok.Value
                }
            }
            let arg = this.ParseExpr()
            if (String_Length(namedKey) > 0) { arg.Str2 = namedKey }
            call.Args.Add(arg)
            this.SkipNewlines()
        }
        this.ParenDepth = this.ParenDepth - 1
        this.Expect(")")
        return call
    }

    private AstNode ParsePrimary() {
        let tok = this.Current()
        let v   = tok.Value

        if (this.CheckType(TokenType.INTEGER)) {
            this.Advance()
            // v0.8.25: `..` is no longer parsed inline here — it's a
            // proper binary operator in ParseRange (between ParseAssign
            // and ParseOr). See that function for the rationale.
            return Ast.IntLit(v, tok.Line, tok.Column)
        }
        if (this.CheckType(TokenType.FLOAT)) {
            this.Advance()
            return Ast.FloatLit(v, tok.Line, tok.Column)
        }
        if (this.CheckType(TokenType.STRING)) {
            this.Advance()
            return Ast.StrLit(v, tok.Line, tok.Column)
        }
        if (v == "true") {
            this.Advance()
            return Ast.BoolLit(true, tok.Line, tok.Column)
        }
        if (v == "false") {
            this.Advance()
            return Ast.BoolLit(false, tok.Line, tok.Column)
        }
        if (v == "null") {
            this.Advance()
            return new AstNode(NodeKind.LITERAL_NULL, tok.Line, tok.Column)
        }
        if (v == "this") {
            this.Advance()
            return Ast.This(tok.Line, tok.Column)
        }
        if (v == "new") {
            return this.ParseNew()
        }
        // if expression: if cond { then } else { else }
        if (v == "if") {
            return this.ParseIf()
        }
        // match expression: match subj { pat => expr, ... }
        if (v == "match") {
            return this.ParseMatch()
        }
        if (v == "(") {
            this.Advance()
            this.ParenDepth = this.ParenDepth + 1
            let first2 = this.ParseExpr()
            // Check if this is a tuple literal: (expr, expr, ...)
            if (this.CheckValue(",")) {
                // Tuple literal
                let tupleNode = new AstNode(NodeKind.CALL, tok.Line, tok.Column)
                tupleNode.Name = "__tuple_literal__"
                tupleNode.Args.Add(first2)
                while (this.CheckValue(",")) {
                    this.Advance()
                    if (this.CheckValue(")")) { break }
                    let elem = this.ParseExpr()
                    tupleNode.Args.Add(elem)
                }
                this.ParenDepth = this.ParenDepth - 1
                this.Expect(")")
                return tupleNode
            }
            this.ParenDepth = this.ParenDepth - 1
            this.Expect(")")
            return first2
        }
        if (this.CheckType(TokenType.IDENTIFIER)) {
            this.Advance()
            // v0.8.25: `..` lives in ParseRange now.
            return Ast.Ident(v, tok.Line, tok.Column)
        }

        if (this.CheckValue("[")) {
            return this.ParseListComp()
        }

        this.Advance()
        return this.Unknown()
    }

    // ── Bracket-expression: list literal OR comprehension ─
    // []                                            — empty literal
    // [expr1, expr2, expr3]                         — literal (n>=1)
    // [expr for x in iter]                          — comprehension map
    // [expr for x in iter if cond]                  — comp + filter
    // The shape is decided by what follows the first expression:
    // `for` → comprehension; `,` or `]` → literal. Trailing comma OK.
    // Parse one literal item: either `...expr` (spread) or a plain
    // expression. Spread items wrap the operand in a UNARY node with
    // op="..." so the cgen LIST_LITERAL branch can splice the operand
    // list into the target via per-element Add() at runtime.
    private AstNode ParseListItem() {
        if (this.CheckType(TokenType.OP_SPREAD)) {
            let sptok = this.Advance()
            let inner = this.ParseExpr()
            let n = new AstNode(NodeKind.UNARY, sptok.Line, sptok.Column)
            n.Str = "..."
            n.Left = inner
            return n
        }
        return this.ParseExpr()
    }

    private AstNode ParseListComp() {
        let tok = this.Advance() // consume '['
        this.SkipNewlines()
        // Empty literal.
        if (this.CheckValue("]")) {
            this.Advance()
            return new AstNode(NodeKind.LIST_LITERAL, tok.Line, tok.Column)
        }
        let firstExpr = this.ParseListItem()
        this.SkipNewlines()
        // List comprehension form — keep the historical shape.
        if (this.CheckKw("for")) {
            this.Advance() // consume 'for'
            let varTok = this.ExpectIdent()
            if (!this.CheckKw("in")) {
                this.Errors.Add("Expected 'in' in list comprehension at " + String_FromInt(varTok.Line) + ":" + String_FromInt(varTok.Column))
            } else {
                this.Advance() // consume 'in'
            }
            let iter = this.ParseExpr()
            let node = new AstNode(NodeKind.LIST_COMP, tok.Line, tok.Column)
            node.Left  = firstExpr          // expr emitted per element
            node.Str   = varTok.Value       // iteration variable name
            node.Right = iter               // iterable (range or list)
            this.SkipNewlines()
            if (this.CheckKw("if")) {
                this.Advance()
                node.Cond = this.ParseExpr()  // optional filter condition
                this.SkipNewlines()
            }
            this.Expect("]")
            return node
        }
        // List literal — accumulate comma-separated expressions.
        let lit = new AstNode(NodeKind.LIST_LITERAL, tok.Line, tok.Column)
        lit.Children.Add(firstExpr)
        while (this.CheckValue(",")) {
            this.Advance()
            this.SkipNewlines()
            if (this.CheckValue("]")) { break } // tolerate trailing comma
            lit.Children.Add(this.ParseListItem())
            this.SkipNewlines()
        }
        this.Expect("]")
        return lit
    }

    // ── Match ─────────────────────────────────────────
    // match expr {
    //   Pattern => stmt,
    //   Variant(a, b) => stmt,
    //   _ => stmt
    // }
    private AstNode ParseMatch() {
        let tok = this.Advance() // consume 'match'
        let subject = this.ParseExpr()
        this.SkipNewlines()
        this.Expect("{")
        this.SkipNewlines()
        let matchNode = new AstNode(NodeKind.IF_STMT, tok.Line, tok.Column)
        matchNode.Left  = subject
        matchNode.Name  = "__match__"
        // Each arm stored as a child: BINARY node with Left=pattern, Right=body
        while (!this.IsEnd() && !this.CheckValue("}")) {
            this.SkipNewlines()
            if (this.CheckValue("}")) { break }
            if (this.CheckValue(",")) { this.Advance() continue }
            // Parse pattern
            let patNode = this.ParseMatchPattern()
            this.SkipNewlines()
            // Optional `if <guard>` — pattern matches AND guard is true.
            let hasGuard = this.CheckKw("if")
            let arm = Ast.Binary(patNode, "=>", patNode, tok.Line, tok.Column)
            if (hasGuard) {
                this.Advance()
                arm.Cond = this.ParseExpr()
                this.SkipNewlines()
            }
            // Expect =>
            if (this.CheckValue("=>")) { this.Advance() }
            this.SkipNewlines()
            // Parse arm body. ParseStmt is a superset of ParseExpr that also
            // recognises `return`, `break`, `continue`, and `{ ... }` blocks
            // — exactly the shapes legacy samples use in arm position.
            var armBody = this.ParseStmt()
            // Skip trailing comma
            if (this.CheckValue(",")) { this.Advance() }
            arm.Right = armBody
            matchNode.Children.Add(arm)
            this.SkipNewlines()
        }
        this.Expect("}")
        return matchNode
    }

    private AstNode ParseMatchPattern() {
        let tok = this.Current()
        // Wildcard: _
        if (tok.Value == "_") {
            this.Advance()
            let wc = new AstNode(NodeKind.IDENTIFIER, tok.Line, tok.Column)
            wc.Name = "_"
            return wc
        }
        // Range: 75..99
        if (this.CheckType(TokenType.INTEGER)) {
            let num = this.Advance()
            let lit = Ast.IntLit(num.Value, num.Line, num.Column)
            if (this.CheckValue("..")) {
                this.Advance()
                let right = this.ParsePrimary()
                return Ast.Binary(lit, "..", right, num.Line, num.Column)
            }
            return lit
        }
        // Variant or identifier: Circle(r), Monday, or Direction.North
        if (this.CheckType(TokenType.IDENTIFIER)) {
            let nameTok = this.Advance()
            var patIdent = Ast.Ident(nameTok.Value, nameTok.Line, nameTok.Column)
            // Qualified variant: Direction.North, Season.Spring
            if (this.CheckValue(".")) {
                this.Advance()
                if (this.CheckType(TokenType.IDENTIFIER)) {
                    let memberTok = this.Advance()
                    patIdent = Ast.Member(patIdent, memberTok.Value, nameTok.Line, nameTok.Column)
                }
            }
            // Algebraic variant with capture: Circle(r)
            if (this.CheckValue("(")) {
                this.Advance()
                let captures = new AstNode(NodeKind.CALL, nameTok.Line, nameTok.Column)
                captures.Name = nameTok.Value
                while (!this.IsEnd() && !this.CheckValue(")")) {
                    if (this.CheckValue(",")) { this.Advance() continue }
                    if (this.CheckType(TokenType.IDENTIFIER)) {
                        let cap = this.Advance()
                        let capNode = Ast.Ident(cap.Value, cap.Line, cap.Column)
                        captures.Args.Add(capNode)
                    } else { this.Advance() }
                }
                this.Expect(")")
                return captures
            }
            return patIdent
        }
        this.Advance()
        return this.Unknown()
    }

    private AstNode ParseNew() {
        let tok = this.Advance()
        let typeName = this.ParseQualifiedName()
        // Capture the type-argument list (e.g. `<int>`) so the codegen can
        // remember the element type of `new List<int>()` and lower
        // subsequent `xs.Get(i)` calls with a typed cast instead of `void*`.
        var generic = ""
        if (this.CheckValue("<")) {
            this.Advance()
            var depth = 1
            while (!this.IsEnd() && depth > 0) {
                let inner = this.Current()
                let iv = inner.Value
                if (iv == ">>") {
                    // Bug 8 mirror: `new List<List<int>>()` — the lexer
                    // fuses two `>` into OP_SHR. Same fix as ParseTypeName;
                    // ParseNew has no post-loop `+ ">"`, so the inner
                    // closer(s) must include both `>` when both close
                    // inner generics, otherwise drop the outer one.
                    if (depth >= 3) {
                        generic = generic + ">>"
                        depth   = depth - 2
                    } else if (depth == 2) {
                        generic = generic + ">"
                        depth   = 0
                    } else {
                        depth = 0
                    }
                    this.Advance()
                } else {
                    if (iv == "<") { depth = depth + 1 }
                    if (iv == ">") { depth = depth - 1 }
                    if (depth > 0) { generic = generic + iv }
                    this.Advance()
                }
            }
        }
        let node = Ast.NewExpr(typeName, tok.Line, tok.Column)
        if (String_Length(generic) > 0) { node.Str2 = generic }
        if (this.CheckValue("(")) {
            this.Advance()
            this.SkipNewlines()
            while (!this.IsEnd() && !this.CheckValue(")")) {
                if (this.CheckValue(",")) {
                    this.Advance()
                    this.SkipNewlines()
                    continue
                }
                // Named-arg syntax: `name: value` (documentation-only at the
                // call site for now — same handling as ParseCallArgs).
                var namedKey = ""
                if (this.CheckType(TokenType.IDENTIFIER)) {
                    let peek = this.Peek(1)
                    if (peek.Value == ":") {
                        let nameTok = this.Advance()
                        this.Advance()
                        namedKey = nameTok.Value
                    }
                }
                let arg = this.ParseExpr()
                if (String_Length(namedKey) > 0) { arg.Str2 = namedKey }
                node.Args.Add(arg)
                this.SkipNewlines()
            }
            this.Expect(")")
        }
        return node
    }
}
