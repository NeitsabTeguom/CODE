namespace Amalgame.Compiler

import Amalgame.Collections
import Amalgame.String

public class Lexer {
    private Source:   string
    private Pos:      int
    private Line:     int
    private Column:   int
    private Filename: string
    private Tokens:   List<Token>

    public Lexer(string source, string filename) {
        this.Source   = source
        this.Filename = filename
        this.Pos      = 0
        this.Line     = 1
        this.Column   = 1
        this.Tokens   = new List<Token>()
    }

    private bool IsSpace(string c) {
        if (String_Length(c) == 0) { return false }
        return c == " " || c == "\t" || c == "\r"
    }

    private bool IsDigit(string c) {
        return String_Contains("0123456789", c)
    }

    private bool IsHexDigit(string c) {
        return String_Contains("0123456789abcdefABCDEF", c)
    }

    private bool IsBinDigit(string c) {
        return c == "0" || c == "1"
    }

    private bool IsAlpha(string c) {
        return String_Contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", c)
    }

    private bool IsAlphaNum(string c) {
        return this.IsAlpha(c) || this.IsDigit(c)
    }

    private string CharAt(int i) {
        if (i < 0 || i >= String_Length(this.Source)) { return "" }
        return String_Substring(this.Source, i, 1)
    }

    private void AddToken(TokenType t, string value) {
        let tok = new Token(t, value, this.Line, this.Column, this.Filename)
        this.Tokens.Add(tok)
    }

    private string Advance() {
        let ch      = this.CharAt(this.Pos)
        this.Pos    = this.Pos + 1
        this.Column = this.Column + 1
        return ch
    }

    private void SkipWhitespace() {
        while (this.Pos < String_Length(this.Source)) {
            let c = this.CharAt(this.Pos)
            if (this.IsSpace(c)) {
                this.Advance()
            } else {
                break
            }
        }
    }

    private void ReadLineComment() {
        let startLine = this.Line
        let startCol  = this.Column
        let start     = this.Pos
        while (this.Pos < String_Length(this.Source) && this.CharAt(this.Pos) != "\n") {
            this.Advance()
        }
        let raw = String_Substring(this.Source, start, this.Pos - start)
        let tok = new Token(TokenType.COMMENT, raw, startLine, startCol, this.Filename)
        this.Tokens.Add(tok)
    }

    public List<Token> Tokenize() {
        while (this.Pos < String_Length(this.Source)) {
            this.SkipWhitespace()
            if (this.Pos >= String_Length(this.Source)) { break }
            let ch = this.CharAt(this.Pos)
            if (ch == "/" && this.CharAt(this.Pos + 1) == "/") {
                this.ReadLineComment()
            } else if (ch == "\n") {
                this.AddToken(TokenType.NEWLINE, "\\n")
                this.Pos    = this.Pos + 1
                this.Line   = this.Line + 1
                this.Column = 1
            } else if (ch == "\"") {
                this.ReadString()
            } else if (this.IsDigit(ch)) {
                this.ReadNumber()
            } else if (this.IsAlpha(ch)) {
                this.ReadIdentifier()
            } else if (this.IsSpace(ch)) {
                this.Advance()
            } else {
                this.ReadSymbol()
            }
        }
        this.AddToken(TokenType.EOF, "")
        return this.Tokens
    }

    private void ReadString() {
        this.Advance()
        // Triple-quoted strings: """...""" — preserve raw newlines, no escape processing.
        // Detected when the first quote is followed by two more quotes.
        if (this.CharAt(this.Pos) == "\"" && this.CharAt(this.Pos + 1) == "\"") {
            this.Advance()
            this.Advance()
            this.ReadTripleQuoted()
            return
        }
        var value = ""
        while (this.Pos < String_Length(this.Source) && this.CharAt(this.Pos) != "\"") {
            let c = this.Advance()
            if (c == "\\") {
                let esc = this.Advance()
                if (esc == "n")  { value = value + "\n" }
                if (esc == "t")  { value = value + "\t" }
                // `"\r"` literal is unreliable: the ancestral amc that
                // first lexed this file mishandled it (produced 2 bytes
                // backslash+r instead of one CR), and every generation
                // since has inherited the bug. Bypassing through
                // String_FromByte(13) breaks the cycle — the runtime
                // helper takes an int, no escape table involved.
                if (esc == "r")  { value = value + String_FromByte(13) }
                if (esc == "\"") { value = value + "\"" }
                if (esc == "\\") { value = value + "\\" }
                // \xHH — two hex digits → single byte
                if (esc == "x") {
                    let h1 = this.Advance()
                    let h2 = this.Advance()
                    let byte = this.HexNibble(h1) * 16 + this.HexNibble(h2)
                    value = value + String_FromByte(byte)
                }
                // \uHHHH — four hex digits → Unicode codepoint, UTF-8 encoded
                if (esc == "u") {
                    let u1 = this.Advance()
                    let u2 = this.Advance()
                    let u3 = this.Advance()
                    let u4 = this.Advance()
                    let cp = this.HexNibble(u1) * 4096 + this.HexNibble(u2) * 256 + this.HexNibble(u3) * 16 + this.HexNibble(u4)
                    value = value + String_FromCodepoint(cp)
                }
            } else {
                value = value + c
            }
        }
        if (this.Pos < String_Length(this.Source)) { this.Advance() }
        this.AddToken(TokenType.STRING, value)
    }

    // Read body of a """..."""  string. Newlines are preserved as-is, no escape
    // processing. The closing delimiter is exactly three consecutive quotes; a
    // run of one or two quotes in the body is content, not a delimiter.
    private void ReadTripleQuoted() {
        var value = ""
        let len = String_Length(this.Source)
        while (this.Pos < len) {
            // Detect closing """
            if (this.CharAt(this.Pos) == "\"" && this.CharAt(this.Pos + 1) == "\"" && this.CharAt(this.Pos + 2) == "\"") {
                this.Advance()
                this.Advance()
                this.Advance()
                this.AddToken(TokenType.STRING, value)
                return
            }
            let c = this.Advance()
            // Track line numbers so error messages remain accurate inside the literal.
            if (c == "\n") {
                this.Line   = this.Line + 1
                this.Column = 1
            }
            value = value + c
        }
        // Unterminated triple-quoted string — emit what we have to avoid a parser hang.
        this.AddToken(TokenType.STRING, value)
    }

    // After the `@` has been consumed, decide whether this is the start of an
    // inline-C block (`@c { ... }`) or a bare `@` (used by `@inline`-style
    // decorators). The rule: literally the letter `c`, then any number of
    // spaces/tabs, then `{`. Anything else falls back to emitting `@` alone.
    private void TryReadInlineCOrAt(int startCol) {
        let len = String_Length(this.Source)
        if (this.CharAt(this.Pos) == "c") {
            var look = this.Pos + 1
            while (look < len) {
                let lc = String_Substring(this.Source, look, 1)
                if (lc == " " || lc == "\t") { look = look + 1 }
                else { break }
            }
            if (look < len && String_Substring(this.Source, look, 1) == "{") {
                let consumed = look - this.Pos
                for k in 0..consumed { this.Advance() }
                this.Advance() // consume the opening `{`
                this.ReadInlineCBody(startCol)
                return
            }
        }
        this.AddToken(TokenType.AT, "@")
    }

    // Scan the body of an `@c { … }` block verbatim into a single INLINE_C
    // token. Tracks brace depth (starting at 1 since the caller consumed the
    // opening `{`) and stops on the matching `}`. C string / char literals
    // and `//` / `/* */` comments are skipped so braces inside them don't
    // confuse the count. Newlines bump `this.Line` so later error messages
    // remain accurate. The closing `}` is consumed but not added to the body.
    private void ReadInlineCBody(int startCol) {
        let startLine = this.Line
        var body = ""
        var depth = 1
        let len = String_Length(this.Source)
        while (this.Pos < len && depth > 0) {
            let c = this.CharAt(this.Pos)
            if (c == "\"") {
                body = body + c
                this.Advance()
                while (this.Pos < len) {
                    let sc = this.CharAt(this.Pos)
                    body = body + sc
                    this.Advance()
                    if (sc == "\\" && this.Pos < len) {
                        body = body + this.CharAt(this.Pos)
                        this.Advance()
                    } else if (sc == "\"") {
                        break
                    } else if (sc == "\n") {
                        this.Line   = this.Line + 1
                        this.Column = 1
                    }
                }
                continue
            }
            if (c == "'") {
                body = body + c
                this.Advance()
                while (this.Pos < len) {
                    let sc = this.CharAt(this.Pos)
                    body = body + sc
                    this.Advance()
                    if (sc == "\\" && this.Pos < len) {
                        body = body + this.CharAt(this.Pos)
                        this.Advance()
                    } else if (sc == "'") {
                        break
                    }
                }
                continue
            }
            if (c == "/" && this.CharAt(this.Pos + 1) == "/") {
                body = body + c
                this.Advance()
                while (this.Pos < len && this.CharAt(this.Pos) != "\n") {
                    body = body + this.CharAt(this.Pos)
                    this.Advance()
                }
                continue
            }
            if (c == "/" && this.CharAt(this.Pos + 1) == "*") {
                body = body + c
                this.Advance()
                body = body + this.CharAt(this.Pos)
                this.Advance()
                while (this.Pos < len) {
                    let cc = this.CharAt(this.Pos)
                    body = body + cc
                    this.Advance()
                    if (cc == "\n") {
                        this.Line   = this.Line + 1
                        this.Column = 1
                    }
                    if (cc == "*" && this.Pos < len && this.CharAt(this.Pos) == "/") {
                        body = body + this.CharAt(this.Pos)
                        this.Advance()
                        break
                    }
                }
                continue
            }
            if (c == "{") {
                depth = depth + 1
                body  = body + c
                this.Advance()
                continue
            }
            if (c == "}") {
                depth = depth - 1
                if (depth == 0) {
                    this.Advance()
                    let tok = new Token(TokenType.INLINE_C, body, startLine, startCol, this.Filename)
                    this.Tokens.Add(tok)
                    return
                }
                body = body + c
                this.Advance()
                continue
            }
            if (c == "\n") {
                this.Line   = this.Line + 1
                this.Column = 1
            }
            body = body + c
            this.Advance()
        }
        // Unterminated inline-C block — emit what we have, mirroring the
        // triple-quoted-string fallback above so the parser still makes progress.
        let tok = new Token(TokenType.INLINE_C, body, startLine, startCol, this.Filename)
        this.Tokens.Add(tok)
    }

    private int HexNibble(string ch) {
        if (ch == "0") { return 0 }
        if (ch == "1") { return 1 }
        if (ch == "2") { return 2 }
        if (ch == "3") { return 3 }
        if (ch == "4") { return 4 }
        if (ch == "5") { return 5 }
        if (ch == "6") { return 6 }
        if (ch == "7") { return 7 }
        if (ch == "8") { return 8 }
        if (ch == "9") { return 9 }
        if (ch == "a" || ch == "A") { return 10 }
        if (ch == "b" || ch == "B") { return 11 }
        if (ch == "c" || ch == "C") { return 12 }
        if (ch == "d" || ch == "D") { return 13 }
        if (ch == "e" || ch == "E") { return 14 }
        if (ch == "f" || ch == "F") { return 15 }
        return 0
    }

    private void ReadNumber() {
        var startCol = this.Column

        // Hex literal: `0x...` or `0X...`. Pass through verbatim — C accepts
        // `0xFF` natively so we hand it straight to the codegen.
        if (this.CharAt(this.Pos) == "0" && (this.CharAt(this.Pos + 1) == "x" || this.CharAt(this.Pos + 1) == "X")) {
            var hex = this.Advance()
            hex = hex + this.Advance()
            while (this.Pos < String_Length(this.Source) && this.IsHexDigit(this.CharAt(this.Pos))) {
                hex = hex + this.Advance()
            }
            let htok = new Token(TokenType.INTEGER, hex, this.Line, startCol, this.Filename)
            this.Tokens.Add(htok)
            return
        }

        // Binary literal: `0b...` or `0B...`. C has no portable binary
        // literal (it's a GCC extension), so convert to decimal here.
        if (this.CharAt(this.Pos) == "0" && (this.CharAt(this.Pos + 1) == "b" || this.CharAt(this.Pos + 1) == "B")) {
            this.Advance()
            this.Advance()
            var dec = 0
            while (this.Pos < String_Length(this.Source) && this.IsBinDigit(this.CharAt(this.Pos))) {
                let bch = this.Advance()
                dec = dec * 2
                if (bch == "1") { dec = dec + 1 }
            }
            let btok = new Token(TokenType.INTEGER, String_FromInt(dec), this.Line, startCol, this.Filename)
            this.Tokens.Add(btok)
            return
        }

        var value    = ""
        var isFloat  = false
        while (this.Pos < String_Length(this.Source) && this.IsDigit(this.CharAt(this.Pos))) {
            value = value + this.Advance()
        }
        if (this.Pos < String_Length(this.Source) && this.CharAt(this.Pos) == "." && this.IsDigit(this.CharAt(this.Pos + 1))) {
            isFloat = true
            value   = value + this.Advance()
            while (this.Pos < String_Length(this.Source) && this.IsDigit(this.CharAt(this.Pos))) {
                value = value + this.Advance()
            }
        }
        if (isFloat) {
            let tok = new Token(TokenType.FLOAT,   value, this.Line, startCol, this.Filename)
            this.Tokens.Add(tok)
        } else {
            let tok = new Token(TokenType.INTEGER, value, this.Line, startCol, this.Filename)
            this.Tokens.Add(tok)
        }
    }

    private void ReadIdentifier() {
        var startCol = this.Column
        var value    = ""
        while (this.Pos < String_Length(this.Source) && this.IsAlphaNum(this.CharAt(this.Pos))) {
            value = value + this.Advance()
        }
        let tt  = this.LookupKeyword(value)
        let tok = new Token(tt, value, this.Line, startCol, this.Filename)
        this.Tokens.Add(tok)
    }

    private TokenType LookupKeyword(string word) {
        if (word == "let")       { return TokenType.KW_LET }
        if (word == "var")       { return TokenType.KW_VAR }
        if (word == "if")        { return TokenType.KW_IF }
        if (word == "else")      { return TokenType.KW_ELSE }
        if (word == "for")       { return TokenType.KW_FOR }
        if (word == "while")     { return TokenType.KW_WHILE }
        if (word == "return")    { return TokenType.KW_RETURN }
        if (word == "class")     { return TokenType.KW_CLASS }
        if (word == "public")    { return TokenType.KW_PUBLIC }
        if (word == "private")   { return TokenType.KW_PRIVATE }
        if (word == "static")    { return TokenType.KW_STATIC }
        if (word == "new")       { return TokenType.KW_NEW }
        if (word == "this")      { return TokenType.KW_THIS }
        if (word == "null")      { return TokenType.KW_NULL }
        if (word == "true")      { return TokenType.KW_TRUE }
        if (word == "false")     { return TokenType.KW_FALSE }
        if (word == "import")    { return TokenType.KW_IMPORT }
        if (word == "namespace") { return TokenType.KW_NAMESPACE }
        if (word == "enum")      { return TokenType.KW_ENUM }
        if (word == "match")     { return TokenType.KW_MATCH }
        if (word == "in")        { return TokenType.KW_IN }
        if (word == "is")        { return TokenType.KW_IS }
        if (word == "as")        { return TokenType.KW_AS }
        if (word == "void")      { return TokenType.KW_VOID }
        if (word == "int")       { return TokenType.KW_INT }
        if (word == "string")    { return TokenType.KW_STRING_TYPE }
        if (word == "bool")      { return TokenType.KW_BOOL_TYPE }
        if (word == "float")     { return TokenType.KW_FLOAT_TYPE }
        if (word == "try")       { return TokenType.KW_TRY }
        if (word == "catch")     { return TokenType.KW_CATCH }
        if (word == "throw")     { return TokenType.KW_THROW }
        if (word == "finally")   { return TokenType.KW_FINALLY }
        if (word == "interface") { return TokenType.KW_INTERFACE }
        if (word == "record")    { return TokenType.KW_RECORD }
        if (word == "func")      { return TokenType.KW_FUNC }
        if (word == "guard")     { return TokenType.KW_GUARD }
        return TokenType.IDENTIFIER
    }

    private void ReadSymbol() {
        var startCol = this.Column
        let c        = this.Advance()
        let c2       = this.CharAt(this.Pos)

        if (c == "+") {
            if (c2 == "=") { this.Advance()
                this.AddToken(TokenType.OP_PLUS_EQ, "+=") }
            else { this.AddToken(TokenType.OP_PLUS, "+") }
        } else if (c == "%") {
            if (c2 == "=") { this.Advance()
                this.AddToken(TokenType.OP_PERCENT_EQ, "%=") }
            else { this.AddToken(TokenType.OP_PERCENT, "%") }
        }
        else if (c == "@") { this.TryReadInlineCOrAt(startCol) }
        else if (c == "(") { this.AddToken(TokenType.LPAREN,     "(") }
        else if (c == ")") { this.AddToken(TokenType.RPAREN,     ")") }
        else if (c == "{") { this.AddToken(TokenType.LBRACE,     "{") }
        else if (c == "}") { this.AddToken(TokenType.RBRACE,     "}") }
        else if (c == "[") { this.AddToken(TokenType.LBRACKET,   "[") }
        else if (c == "]") { this.AddToken(TokenType.RBRACKET,   "]") }
        else if (c == ",") { this.AddToken(TokenType.COMMA,      ",") }
        else if (c == ";") { this.AddToken(TokenType.SEMICOLON,  ";") }
        else if (c == "/") {
            if (c2 == "=") { this.Advance()
                this.AddToken(TokenType.OP_SLASH_EQ, "/=") }
            else { this.AddToken(TokenType.OP_SLASH, "/") }
        }
        else if (c == "-") {
            if (c2 == ">") { this.Advance()
                this.AddToken(TokenType.OP_THIN_ARROW, "->") }
            else if (c2 == "=") { this.Advance()
                this.AddToken(TokenType.OP_MINUS_EQ, "-=") }
            else { this.AddToken(TokenType.OP_MINUS, "-") }
        } else if (c == "*") {
            if (c2 == "=") { this.Advance()
                this.AddToken(TokenType.OP_STAR_EQ, "*=") }
            else { this.AddToken(TokenType.OP_STAR, "*") }
        } else if (c == "=") {
            if (c2 == "=") { this.Advance()
                this.AddToken(TokenType.OP_EQEQ, "==") }
            else if (c2 == ">") { this.Advance()
                this.AddToken(TokenType.OP_ARROW, "=>") }
            else { this.AddToken(TokenType.OP_EQ, "=") }
        } else if (c == "!") {
            if (c2 == "=") { this.Advance()
                this.AddToken(TokenType.OP_NEQ, "!=") }
            else { this.AddToken(TokenType.OP_NOT, "!") }
        } else if (c == "<") {
            if (c2 == "=") { this.Advance()
                this.AddToken(TokenType.OP_LTE, "<=") }
            else if (c2 == "<") { this.Advance()
                let c3 = this.CharAt(this.Pos)
                if (c3 == "=") { this.Advance()
                    this.AddToken(TokenType.OP_SHL_EQ, "<<=") }
                else { this.AddToken(TokenType.OP_SHL, "<<") }
            } else { this.AddToken(TokenType.OP_LT, "<") }
        } else if (c == ">") {
            if (c2 == "=") { this.Advance()
                this.AddToken(TokenType.OP_GTE, ">=") }
            else if (c2 == ">") { this.Advance()
                let c3 = this.CharAt(this.Pos)
                if (c3 == "=") { this.Advance()
                    this.AddToken(TokenType.OP_SHR_EQ, ">>=") }
                else { this.AddToken(TokenType.OP_SHR, ">>") }
            } else { this.AddToken(TokenType.OP_GT, ">") }
        } else if (c == "&") {
            if (c2 == "&") { this.Advance()
                this.AddToken(TokenType.OP_AND, "&&") }
            else if (c2 == "=") { this.Advance()
                this.AddToken(TokenType.OP_AMP_EQ, "&=") }
            else { this.AddToken(TokenType.OP_AMP, "&") }
        } else if (c == "|") {
            if (c2 == "|") { this.Advance()
                this.AddToken(TokenType.OP_OR, "||") }
            else if (c2 == "=") { this.Advance()
                this.AddToken(TokenType.OP_PIPE_EQ, "|=") }
            else { this.AddToken(TokenType.OP_PIPE, "|") }
        } else if (c == ".") {
            if (c2 == ".") {
                this.Advance()
                // Triple-dot `...` — spread operator (v0.8.36+). Used
                // in list literals to splice an iterable's elements:
                // `[...a, ...b, c]` builds a fresh list from a's
                // elements, then b's, then c. Tokenised here as a
                // single token so the parser sees one OP_SPREAD
                // instead of two `..` + `.`.
                let c3: string = this.CharAt(this.Pos)
                if (c3 == ".") {
                    this.Advance()
                    this.AddToken(TokenType.OP_SPREAD, "...")
                } else {
                    this.AddToken(TokenType.OP_DOTDOT, "..")
                }
            }
            else { this.AddToken(TokenType.OP_DOT, ".") }
        } else if (c == ":") {
            if (c2 == ":") { this.Advance()
                this.AddToken(TokenType.COLON, "::") }
            else { this.AddToken(TokenType.COLON, ":") }
        } else if (c == "?") {
            if (c2 == "?") { this.Advance()
                this.AddToken(TokenType.OP_COALESCE, "??") }
            else if (c2 == ".") { this.Advance()
                this.AddToken(TokenType.OP_QDOT, "?.") }
            else { this.AddToken(TokenType.OP_QMARK, "?") }
        } else if (c == "~") {
            this.AddToken(TokenType.OP_TILDE, "~")
        } else if (c == "^") {
            if (c2 == "=") { this.Advance()
                this.AddToken(TokenType.OP_CARET_EQ, "^=") }
            else { this.AddToken(TokenType.OP_CARET, "^") }
        } else {
            this.AddToken(TokenType.UNKNOWN, c)
        }
    }
}
