    // ── VS Code wiring (opt-in, --vscode flag) ────────
    // Writes .vscode/launch.json + .vscode/settings.json so F5 in
    // VS Code launches the project's binary under `amc dap` with
    // .am-level breakpoints. Opt-in only — projects edited in
    // other editors (Neovim, Helix, IntelliJ) stay clean.
    //
    // launch.json hard-codes program = ${workspaceFolder}/<base>,
    // which matches the build.sh output for exe + service. For
    // lib/test the file lands as well but the user has to point
    // `program` at whatever binary they actually want to debug —
    // we print a hint when that's the case.
    private static int WriteVscodeConfig(string path, string base, string template) {
        if (!File.Mkdir(path + "/.vscode")) {
            Console.WriteError("amc new: failed to create .vscode/ subdirectory")
            return 1
        }
        let launchJson:   string = NewCommand.VscodeLaunchJson(base)
        let settingsJson: string = NewCommand.VscodeSettingsJson()
        let tasksJson:    string = NewCommand.VscodeTasksJson()
        if (!NewCommand.WriteFile(path + "/.vscode/launch.json",   launchJson))   { return 1 }
        if (!NewCommand.WriteFile(path + "/.vscode/settings.json", settingsJson)) { return 1 }
        if (!NewCommand.WriteFile(path + "/.vscode/tasks.json",    tasksJson))    { return 1 }
        Console.WriteLine("  + .vscode/launch.json + settings.json + tasks.json (F5 rebuilds with -g)")
        if (template == "lib" || template == "test") {
            Console.WriteLine("  note: '" + template + "' templates have no default runnable binary;")
            Console.WriteLine("        edit .vscode/launch.json `program` before F5.")
        }
        return 0
    }

    // Two configurations so the user can F5 on either OS without
    // hand-editing the file. `program` differs only by the `.exe`
    // suffix Windows MinGW links produce; `cwd`, `args` and the
    // `amc` debug type are invariant. The VS Code F5 dropdown
    // surfaces the pretty `name` so users see "(Linux/macOS)" vs
    // "(Windows)" and pick accordingly.
    //
    // VS Code's substitution syntax is ${workspaceFolder}, which
    // collides with Amalgame's `"text {var}"` interpolation —
    // `{workspaceFolder}` would resolve as an identifier lookup.
    // Sentinel locals `lb`/`rb` are the documented workaround
    // (CONTINUATION.md gotcha #7).
    private static string VscodeLaunchJson(string base) {
        let lb: string = "{"
        let rb: string = "}"
        let wsf: string = "$" + lb + "workspaceFolder" + rb
        var s: string = ""
        s = s + "{\n"
        s = s + "  \"version\": \"0.2.0\",\n"
        s = s + "  \"configurations\": [\n"
        s = s + "    {\n"
        s = s + "      \"type\": \"amc\",\n"
        s = s + "      \"request\": \"launch\",\n"
        s = s + "      \"name\": \"Debug " + base + " (Linux/macOS)\",\n"
        s = s + "      \"program\": \"" + wsf + "/" + base + "\",\n"
        s = s + "      \"args\": [],\n"
        s = s + "      \"cwd\": \"" + wsf + "\",\n"
        s = s + "      \"stopOnEntry\": false,\n"
        s = s + "      \"preLaunchTask\": \"amc: build (debug)\"\n"
        s = s + "    },\n"
        s = s + "    {\n"
        s = s + "      \"type\": \"amc\",\n"
        s = s + "      \"request\": \"launch\",\n"
        s = s + "      \"name\": \"Debug " + base + " (Windows)\",\n"
        s = s + "      \"program\": \"" + wsf + "/" + base + ".exe\",\n"
        s = s + "      \"args\": [],\n"
        s = s + "      \"cwd\": \"" + wsf + "\",\n"
        s = s + "      \"stopOnEntry\": false,\n"
        s = s + "      \"preLaunchTask\": \"amc: build (debug)\"\n"
        s = s + "    }\n"
        s = s + "  ]\n"
        s = s + "}\n"
        return s
    }

    private static string VscodeSettingsJson() {
        var s: string = ""
        s = s + "{\n"
        s = s + "  \"amalgame.enableLsp\": true\n"
        s = s + "}\n"
        return s
    }

    // tasks.json — drives the `preLaunchTask` in launch.json so F5
    // always re-builds with -g before handing off to amc dap. Without
    // this, users hit the classic "F5 runs but no breakpoint stops"
    // pitfall when the binary on disk is a release build (no DWARF).
    // The `build (debug)` task wraps `./build.sh -g` so it picks up
    // the same flag-forwarding the scaffold's build.sh already does.
    // `revealProblems: "onProblem"` keeps the terminal silent on
    // success — F5 stays a one-keystroke flow.
    private static string VscodeTasksJson() {
        var s: string = ""
        s = s + "{\n"
        s = s + "  \"version\": \"2.0.0\",\n"
        s = s + "  \"tasks\": [\n"
        s = s + "    {\n"
        s = s + "      \"label\": \"amc: build (debug)\",\n"
        s = s + "      \"type\": \"shell\",\n"
        s = s + "      \"command\": \"./build.sh\",\n"
        s = s + "      \"args\": [\"-g\"],\n"
        s = s + "      \"group\": { \"kind\": \"build\", \"isDefault\": true },\n"
        s = s + "      \"presentation\": { \"reveal\": \"silent\", \"clear\": true },\n"
        s = s + "      \"problemMatcher\": []\n"
        s = s + "    },\n"
        s = s + "    {\n"
        s = s + "      \"label\": \"amc: build (release)\",\n"
        s = s + "      \"type\": \"shell\",\n"
        s = s + "      \"command\": \"./build.sh\",\n"
        s = s + "      \"presentation\": { \"reveal\": \"silent\", \"clear\": true },\n"
        s = s + "      \"problemMatcher\": []\n"
        s = s + "    }\n"
        s = s + "  ]\n"
        s = s + "}\n"
        return s
    }

    // ── File contents ─────────────────────────────────

    private static string MainAmExe(string name) {
        var s: string = ""
        s = s + "namespace " + name + "\n"
        s = s + "\n"
        s = s + "import Amalgame.Collections\n"
        s = s + "import Amalgame.IO\n"
        s = s + "import Amalgame.String\n"
        s = s + "\n"
        s = s + "public class Program {\n"
        s = s + "    public static int Main(List<string> args) {\n"
        s = s + "        Console.WriteLine(\"Hello from " + name + "!\")\n"
        s = s + "        return 0\n"
        s = s + "    }\n"
        s = s + "}\n"
        return s
    }

    private static string TestAmExe(string name) {
        var s: string = ""
        s = s + "// Smoke test for " + name + ". `amc test tests/` runs this file\n"
        s = s + "// and counts the [PASS]/[FAIL] tags it prints.\n"
        s = s + "\n"
        s = s + "import Amalgame.IO\n"
        s = s + "\n"
        s = s + "class Program {\n"
        s = s + "    public static void Main() {\n"
        s = s + "        let n: int = 1 + 1\n"
        s = s + "        if (n == 2) {\n"
        s = s + "            Console.WriteLine(\"[PASS] sanity\")\n"
        s = s + "        } else {\n"
        s = s + "            Console.WriteLine(\"[FAIL] sanity\")\n"
        s = s + "        }\n"
        s = s + "    }\n"
        s = s + "}\n"
        return s
    }

    private static string BuildShExe(string name) {
        // `amc build` (v0.7.9+) handles runtime/, libamalgame.a,
        // package facades and the gcc link line on its own — no need
        // to rebuild the discovery logic in a per-project script.
        // Extra flags forward via `"$@"`, so `./build.sh -g` triggers
        // the v0.8.0 debug build (DWARF, -O0, ready for `amc dap`).
        var s: string = ""
        s = s + "#!/bin/bash\n"
        s = s + "# Build script for " + name + ". Wraps `amc build`.\n"
        s = s + "#\n"
        s = s + "# Usage:\n"
        s = s + "#   ./build.sh         # release build (-O2)\n"
        s = s + "#   ./build.sh -g      # debug build (-O0 -g, for `amc dap`)\n"
        s = s + "#   ./build.sh --verbose  # show the underlying gcc command\n"
        s = s + "set -e\n"
        s = s + "cd \"$(dirname \"$0\")\"\n"
        s = s + "amc build src/main.am -o ./" + name + " \"$@\"\n"
        return s
    }

    private static string ReadmeExe(string name) {
        var s: string = ""
        s = s + "# " + name + "\n"
        s = s + "\n"
        s = s + "Amalgame project scaffolded by `amc new " + name + "`.\n"
        s = s + "\n"
        s = s + "## Build & run\n"
        s = s + "\n"
        s = s + "```\n"
        s = s + "./build.sh         # release build (-O2)\n"
        s = s + "./" + name + "\n"
        s = s + "```\n"
        s = s + "\n"
        s = s + "## Debug\n"
        s = s + "\n"
        s = s + "```\n"
        s = s + "./build.sh -g      # debug build (-O0 -g, DWARF for `amc dap`)\n"
        s = s + "lldb-18 ./" + name + "    # then `breakpoint set --file src/main.am --line 5` etc.\n"
        s = s + "```\n"
        s = s + "\n"
        s = s + "If you scaffolded with `amc new --vscode`, F5 in VS Code\n"
        s = s + "rebuilds with `-g` automatically (via the `preLaunchTask`\n"
        s = s + "in `.vscode/launch.json`) and stops on breakpoints set in\n"
        s = s + "`src/main.am` directly.\n"
        s = s + "\n"
        s = s + "## Test\n"
        s = s + "\n"
        s = s + "```\n"
        s = s + "amc test tests/\n"
        s = s + "```\n"
        return s
    }

    private static string LibAm(string name) {
        var s: string = ""
        s = s + "namespace " + name + "\n"
        s = s + "\n"
        s = s + "import Amalgame.String\n"
        s = s + "\n"
        s = s + "// [Library]\n"
        s = s + "// Marker comment is read by `amc --lib` to skip the missing-Main check.\n"
        s = s + "// See https://github.com/amalgame-lang/Amalgame for the reference.\n"
        s = s + "\n"
        s = s + "public class " + NewCommand.Capitalize(name) + " {\n"
        s = s + "    public " + NewCommand.Capitalize(name) + "() {}\n"
        s = s + "\n"
        s = s + "    public string Greet(string who) {\n"
        s = s + "        return \"Hello, \" + who + \", from " + name + "!\"\n"
        s = s + "    }\n"
        s = s + "}\n"
        return s
    }

    private static string BuildShLib(string name) {
        var s: string = ""
        s = s + "#!/bin/bash\n"
        s = s + "# Build script for the " + name + " library. Emits " + name + ".c\n"
        s = s + "# (a self-contained Amalgame translation) that callers compile\n"
        s = s + "# alongside their own sources via gcc.\n"
