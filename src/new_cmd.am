    // same `-I runtime` + `-lgc -lm -lcurl` flags as the POSIX path.
    // AMALGAME_HOME points at the directory containing `runtime/`.
    private static string BuildPs1Service(string name) {
        var s: string = ""
        s = s + "# build.ps1 — compile " + name + " on Windows via `amc build`.\n"
        s = s + "#\n"
        s = s + "# Run from a PowerShell where `amc.exe` and a MinGW `gcc.exe`\n"
        s = s + "# are on PATH. MSYS2 mingw64 installs both with:\n"
        s = s + "#   pacman -S mingw-w64-x86_64-gcc mingw-w64-x86_64-gc mingw-w64-x86_64-curl\n"
        s = s + "#\n"
        s = s + "# Pass -g (or any flag) and it forwards to `amc build` for a\n"
        s = s + "# debug DWARF build that pairs with `amc dap` under VS Code.\n"
        s = s + "$ErrorActionPreference = 'Stop'\n"
        s = s + "Set-Location $PSScriptRoot\n"
        s = s + "& amc build src/main.am -o ./" + name + ".exe @args\n"
        return s
    }

    // ── Windows install (NSSM wrapper) ────────────────
    //
    // Native Windows Service mode (StartServiceCtrlDispatcher /
    // RegisterServiceCtrlHandler / SetServiceStatus) requires the
    // exe to itself register with SCM within ~30s of launch, which
    // means wiring an SCM dispatcher into amc's generated main().
    // Tracked as a v2 follow-up.
    //
    // For v1 we ship NSSM-based scripts. NSSM (Non-Sucking Service
    // Manager — https://nssm.cc) is a tiny exe that wraps any
    // console binary as a proper Windows service: handles SCM
    // dispatch, status reporting, log rotation, auto-restart.
    // Same outcome as a "native" service from the operator's POV;
    // user binary stays a plain console app.
    private static string InstallPs1Service(string name) {
        var s: string = ""
        s = s + "# install.ps1 — register " + name + " as a Windows service via NSSM.\n"
        s = s + "#\n"
        s = s + "# NSSM (https://nssm.cc) is a tiny SCM wrapper that turns any\n"
        s = s + "# console binary into a proper Windows service. v1 of `amc new\n"
        s = s + "# --template service` ships NSSM-based scripts; native SCM\n"
        s = s + "# dispatcher integration is tracked for v2.\n"
        s = s + "#\n"
        s = s + "# Run from an elevated PowerShell:\n"
        s = s + "#   Start-Process powershell -Verb runAs -ArgumentList '-File','install.ps1'\n"
        s = s + "$ErrorActionPreference = 'Stop'\n"
        s = s + "Set-Location $PSScriptRoot\n"
        s = s + "\n"
        s = s + "# Elevation check.\n"
        s = s + "$identity = [System.Security.Principal.WindowsIdentity]::GetCurrent()\n"
        s = s + "$principal = New-Object System.Security.Principal.WindowsPrincipal($identity)\n"
        s = s + "if (-not $principal.IsInRole([System.Security.Principal.WindowsBuiltInRole]::Administrator)) {\n"
        s = s + "  Write-Error 'install.ps1 must run as Administrator.'\n"
        s = s + "  exit 1\n"
        s = s + "}\n"
        s = s + "\n"
        s = s + "# Locate NSSM. Check PATH first, then fall back to a vendored\n"
        s = s + "# copy under ./nssm.exe (drop it in the project root if you\n"
        s = s + "# pre-downloaded). Auto-download as a last resort.\n"
        s = s + "$nssm = (Get-Command nssm -ErrorAction SilentlyContinue)\n"
        s = s + "$nssmExe = if ($nssm) { $nssm.Path } else { Join-Path $PSScriptRoot 'nssm.exe' }\n"
        s = s + "if (-not (Test-Path $nssmExe)) {\n"
        s = s + "  $url = 'https://nssm.cc/release/nssm-2.24.zip'\n"
        s = s + "  Write-Host \"Downloading NSSM from $url\"\n"
        s = s + "  $tmp = New-TemporaryFile\n"
        s = s + "  Invoke-WebRequest -Uri $url -OutFile $tmp.FullName\n"
        s = s + "  $extract = Join-Path $env:TEMP ('nssm-' + [Guid]::NewGuid())\n"
        s = s + "  Expand-Archive -Path $tmp.FullName -DestinationPath $extract -Force\n"
        s = s + "  $arch = if ([Environment]::Is64BitOperatingSystem) { 'win64' } else { 'win32' }\n"
        s = s + "  Copy-Item -Path (Join-Path $extract \"nssm-2.24/$arch/nssm.exe\") -Destination $nssmExe -Force\n"
        s = s + "  Remove-Item $tmp.FullName, $extract -Recurse -Force\n"
        s = s + "}\n"
        s = s + "\n"
        s = s + "# Build the binary if missing or stale.\n"
        s = s + "$exe = Join-Path $PSScriptRoot '" + name + ".exe'\n"
        s = s + "if (-not (Test-Path $exe)) { & .\\build.ps1 }\n"
        s = s + "\n"
        s = s + "# Stop + remove any prior install so we cleanly replace it.\n"
        s = s + "& $nssmExe stop '" + name + "' 2>$null | Out-Null\n"
        s = s + "& $nssmExe remove '" + name + "' confirm 2>$null | Out-Null\n"
        s = s + "\n"
        s = s + "# Register + configure + start.\n"
        s = s + "& $nssmExe install '" + name + "' $exe\n"
        s = s + "& $nssmExe set '" + name + "' AppDirectory $PSScriptRoot\n"
        s = s + "& $nssmExe set '" + name + "' DisplayName '" + name + " (Amalgame service)'\n"
        s = s + "& $nssmExe set '" + name + "' Start SERVICE_AUTO_START\n"
        s = s + "& $nssmExe set '" + name + "' AppStdout (Join-Path $PSScriptRoot '" + name + ".out.log')\n"
        s = s + "& $nssmExe set '" + name + "' AppStderr (Join-Path $PSScriptRoot '" + name + ".err.log')\n"
        s = s + "& $nssmExe start '" + name + "'\n"
        s = s + "\n"
        s = s + "Write-Host ''\n"
        s = s + "Write-Host \"Done. Service registered as '" + name + "'.\"\n"
        s = s + "Write-Host '  Status:'\n"
        s = s + "& $nssmExe status '" + name + "'\n"
        s = s + "Write-Host '  Stderr log: ' (Join-Path $PSScriptRoot '" + name + ".err.log')\n"
        return s
    }


