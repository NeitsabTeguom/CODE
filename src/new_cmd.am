    private static string MainAmService(string name) {
        var s: string = ""
        s = s + "namespace " + name + "\n"
        s = s + "\n"
        s = s + "import Amalgame.Collections\n"
        s = s + "import Amalgame.IO\n"
        s = s + "import Amalgame.Logging\n"
        s = s + "import Amalgame.Service\n"
        s = s + "\n"
        s = s + "// ── " + name + " — long-running daemon ─────────────────────\n"
        s = s + "//\n"
        s = s + "// Built with `amc new <name> --template service`. The skeleton\n"
        s = s + "// covers the three things every service needs: catch the\n"
        s = s + "// shutdown signal, sleep between iterations without burning\n"
        s = s + "// CPU, and log to a place that survives the process exit.\n"
        s = s + "//\n"
        s = s + "// Replace `OnTick()` with your actual work. The systemd unit\n"
        s = s + "// (`" + name + ".service`) runs this with stdout/stderr routed\n"
        s = s + "// to journald; on macOS use launchd, on Windows wrap it with sc.\n"
        s = s + "\n"
        s = s + "public class Program {\n"
        s = s + "    public static int Main(List<string> args) {\n"
        s = s + "        Log.SetMinLevel(\"info\")\n"
        s = s + "        Log.Info(\"" + name + " starting\")\n"
        s = s + "\n"
        s = s + "        Service.Install()\n"
        s = s + "        var ticks: int = 0\n"
        s = s + "        while (!Service.ShouldStop()) {\n"
        s = s + "            Program.OnTick(ticks)\n"
        s = s + "            ticks = ticks + 1\n"
        s = s + "            Service.Sleep(5000)\n"
        s = s + "        }\n"
        s = s + "\n"
        s = s + "        Log.Info(\"" + name + " shutting down cleanly\")\n"
        s = s + "        return 0\n"
        s = s + "    }\n"
        s = s + "\n"
        s = s + "    // Single iteration of work. Called every 5s by default; tune\n"
        s = s + "    // the Service.Sleep above or drive off events instead.\n"
        s = s + "    private static void OnTick(int n) {\n"
        s = s + "        Log.Info(\"tick \" + String_FromInt(n))\n"
        s = s + "    }\n"
        s = s + "}\n"
        return s
    }

