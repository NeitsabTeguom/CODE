    private static string BuildShForms(string name) {
        // `${VAR:-default}` collides with Amalgame's `"{var}"`
        // string interpolation, so we splice the braces via lb/rb
        // sentinels (CONTINUATION.md gotcha #7).
        let lb: string = "{"
        let rb: string = "}"
        let amcVar:   string = "$" + lb + "AMC:-$(command -v amc)" + rb
        let amcLibVar: string = "$" + lb + "AMC_LIB:-$AMC_DIR/../share/amalgame/lib/libamalgame.a" + rb
        let pkgVar:   string = "$" + lb + "AMALGAME_PACKAGES_DIR:-$HOME/.amalgame/packages" + rb
        var s: string = ""
        s = s + "#!/bin/sh\n"
        s = s + "# Build script for the `" + name + "` GUI app.\n"
        s = s + "#\n"
        s = s + "# Step 1: amc compiles src/main.am to build/<name>.c\n"
        s = s + "#         (resolves the ui-sdl / ui-forms imports via\n"
        s = s + "#         amalgame.lock + your local package cache).\n"
        s = s + "# Step 2: gcc links the generated .c against the per-\n"
        s = s + "#         package facade archives (built by\n"
        s = s + "#         `amc package add ui-sdl ui-forms`) plus\n"
        s = s + "#         SDL2 + SDL2_ttf via pkg-config.\n"
        s = s + "#\n"
        s = s + "# Requires: amc 0.8.7+ + libsdl2-dev + libsdl2-ttf-dev.\n"
        s = s + "set -eu\n"
        s = s + "\n"
        s = s + "NAME=" + name + "\n"
        s = s + "AMC=" + amcVar + "\n"
        s = s + "AMC_DIR=$(cd \"$(dirname \"$AMC\")\" && pwd)\n"
        s = s + "if [ -d \"$AMC_DIR/runtime\" ]; then\n"
        s = s + "  AMC_RUNTIME=\"$AMC_DIR/runtime\"\n"
        s = s + "else\n"
        s = s + "  AMC_RUNTIME=\"$AMC_DIR/../share/amalgame/runtime\"\n"
        s = s + "fi\n"
        s = s + "AMC_LIB=" + amcLibVar + "\n"
        s = s + "PKG_CACHE=" + pkgVar + "\n"
        s = s + "\n"
        s = s + "# Find the precompiled per-package facade archives.\n"
        s = s + "PLAT=$(uname -s | tr 'A-Z' 'a-z')-$(uname -m)\n"
        s = s + "find_archive() {\n"
        s = s + "  find \"$PKG_CACHE/github.com/amalgame-lang/$1\" \\\n"
        s = s + "    -path \"*/build/$PLAT/libamalgame-pkg-*.a\" 2>/dev/null | head -1\n"
        s = s + "}\n"
        s = s + "FORMS_AR=$(find_archive amalgame-ui-forms)\n"
        s = s + "SDL_AR=$(find_archive amalgame-ui-sdl)\n"
        s = s + "if [ -z \"$FORMS_AR\" ] || [ -z \"$SDL_AR\" ]; then\n"
        s = s + "  echo \"ERROR: missing facade archive. Did you run 'amc package add ui-sdl ui-forms'?\"\n"
        s = s + "  exit 1\n"
        s = s + "fi\n"
        s = s + "\n"
        s = s + "SDL_CFLAGS=$(pkg-config --cflags sdl2 SDL2_ttf)\n"
        s = s + "SDL_LIBS=$(pkg-config --libs sdl2 SDL2_ttf)\n"
        s = s + "\n"
        s = s + "mkdir -p build\n"
        s = s + "\"$AMC\" -o build/$NAME src/main.am --quiet\n"
        s = s + "gcc -O2 -I\"$AMC_RUNTIME\" $SDL_CFLAGS build/$NAME.c \\\n"
        s = s + "  \"$FORMS_AR\" \"$SDL_AR\" \"$AMC_LIB\" \\\n"
        s = s + "  -lgc -lm -lcurl -lz -ldl -lpthread $SDL_LIBS -o $NAME\n"
        s = s + "echo \"Built ./$NAME — run it now.\"\n"
        return s
    }

