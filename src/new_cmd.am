    // ── ui-web-form template ──────────────────────────
    //
    // Webview GUI app built on amalgame-ui-web. Renders HTML/CSS
    // through the OS-native engine (WebView2 / WKWebView /
    // WebKitGTK) and bridges JS ↔ Amalgame via Window.Bind. The
    // scaffold lays out a Window + Page + small form + Submit
    // handler that echoes the form payload back into a <pre>
    // panel via a tiny in-page click bridge (until ui-web v0.0.5+
    // ships a declarative `.OnResult(targetId)`).

    private static int ScaffoldUiWebForm(string path, string base) {
        if (!File.Mkdir(path + "/src")) {
            Console.WriteError("amc new: failed to create src/ subdirectory")
            return 1
        }

        let mainAm:    string = NewCommand.MainAmUiWebForm(base)
        let manifest:  string = NewCommand.ManifestUiWebForm(base)
        let buildSh:   string = NewCommand.BuildShUiWebForm(base)
        let readme:    string = NewCommand.ReadmeUiWebForm(base)
        let gitignore: string = NewCommand.GitignoreCommon()

        if (!NewCommand.WriteFile(path + "/src/main.am",   mainAm))    { return 1 }
        if (!NewCommand.WriteFile(path + "/amalgame.toml", manifest))  { return 1 }
        if (!NewCommand.WriteFile(path + "/build.sh",      buildSh))   { return 1 }
        if (!NewCommand.WriteFile(path + "/.gitignore",    gitignore)) { return 1 }
        if (!NewCommand.WriteFile(path + "/README.md",     readme))    { return 1 }
        Process.Run("chmod +x " + NewCommand.ShellEscape(path + "/build.sh"))

        Console.WriteLine("Scaffolded '" + base + "' (ui-web-form template).")
        Console.WriteLine("  cd " + path)
        Console.WriteLine("  amc package add ui-web              # fetch the package (one-off)")
        Console.WriteLine("  sudo apt install libwebkit2gtk-4.1-dev   # Linux build deps")
        Console.WriteLine("  ./build.sh && ./" + base)
        return 0
    }

    private static string MainAmUiWebForm(string name) {
        var s: string = ""
        s = s + "import Amalgame.UI.Web\n"
        s = s + "\n"
        s = s + "// Scaffolded by `amc new --template ui-web-form`.\n"
        s = s + "//\n"
        s = s + "// A 720x480 webview window with a small form built via the\n"
        s = s + "// AM-side Element / Page builder. Submit invokes the AM\n"
        s = s + "// handler with the form payload as a JSON object string\n"
        s = s + "// (auto-collected by ui-web's __amc_collect bridge). The\n"
        s = s + "// returned JSON lands in the <pre id=out> panel via a\n"
        s = s + "// tiny in-page click bridge — until ui-web v0.0.5+ ships\n"
        s = s + "// a declarative `.OnResult(targetId)`.\n"
        s = s + "//\n"
        s = s + "// The baseline stylesheet handles light/dark theming from\n"
        s = s + "// the OS. Override individual CSS variables (`--amc-bg`,\n"
        s = s + "// `--amc-fg`, `--amc-accent`, …) from your own stylesheet\n"
        s = s + "// or call `Page.SetStylesheet(url)` / `.AddCss(url)`.\n"
        s = s + "\n"
        s = s + "class Program {\n"
        s = s + "    public static void Main() {\n"
        s = s + "        let win: Window = new Window(\"" + name + "\", 720, 480, false)\n"
        s = s + "        if (!win.IsValid()) {\n"
        s = s + "            return\n"
        s = s + "        }\n"
        s = s + "\n"
        s = s + "        let page: Page = Page.New()\n"
        s = s + "            .SetTitle(\"" + name + "\")\n"
        s = s + "            .SetBody(\n"
        s = s + "                Element.Stack()\n"
        s = s + "                    .AddChild(Element.Heading(\"Welcome to " + name + "\"))\n"
        s = s + "                    .AddChild(Element.Label(\"Edit the form, then click Submit.\"))\n"
        s = s + "                    .AddChild(Element.Input(\"user\").Attr(\"placeholder\", \"Your name\"))\n"
        s = s + "                    .AddChild(Element.Textarea(\"message\").Attr(\"placeholder\", \"A message\").Size(0, 80))\n"
        s = s + "                    .AddChild(Element.Button(\"Submit\")\n"
        s = s + "                        .OnClick((req: string) => req))\n"
        s = s + "                    .AddChild(Element.Pre(\"(submit to see the form payload)\").Id(\"out\"))\n"
        s = s + "            )\n"
        s = s + "\n"
        s = s + "        page.ApplyTo(win)\n"
        s = s + "\n"
        s = s + "        // In-page bridge: intercept Button clicks so the\n"
        s = s + "        // handler's return value lands in <pre id=out>.\n"
        s = s + "        win.Init(\"document.addEventListener('click',async e=>{if(e.target.tagName!=='BUTTON')return;const m=(e.target.getAttribute('onclick')||'').match(/window\\\\.(\\\\w+)/);if(!m)return;e.preventDefault();const r=await window[m[1]](JSON.stringify(window.__amc_collect()));document.getElementById('out').textContent=JSON.stringify(JSON.parse(r),null,2);},true);\")\n"
        s = s + "\n"
        s = s + "        win.Run()\n"
        s = s + "        win.Destroy()\n"
        s = s + "    }\n"
        s = s + "}\n"
        return s
    }

