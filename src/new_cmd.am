namespace Amalgame.Compiler

import Amalgame.Collections
import Amalgame.IO
import Amalgame.Process
import Amalgame.String

// ═══════════════════════════════════════════════════════
//  new_cmd.am  —  `amc new` subcommand
// ═══════════════════════════════════════════════════════
//
// Scaffold a new Amalgame project, à la `cargo new` / `dotnet new`.
//
//   amc new <name>                       # exe template (default)
//   amc new <name> --template lib        # library skeleton
//   amc new <name> --template test       # test-only bundle
//   amc new <name> --template service    # long-running daemon
//   amc new <name> --template forms        # GUI app (ui-sdl + ui-forms) — sunset
//   amc new <name> --template ui-web-form  # webview GUI app (amalgame-ui-web)
//
// Creates a `<name>/` directory with starter files: source skeleton,
// .gitignore, README.md, build.sh. The output is intentionally
// minimal — what runs end-to-end via `./build.sh` and nothing more.
// Editing afterwards is expected.

public class NewCommand {

    public NewCommand() {}

    public static void PrintUsage() {
        Console.WriteError("Usage: amc new <name> [--template <kind>] [--vscode] [--force]")
        Console.WriteError("")
        Console.WriteError("Scaffold a new Amalgame project named <name>.")
        Console.WriteError("")
        Console.WriteError("Templates:")
        Console.WriteError("  exe      Default. src/main.am with Program.Main + a passing test.")
        Console.WriteError("  lib      src/<name>.am with a public class skeleton, no main.")
        Console.WriteError("  test     tests/<name>_test.am only — bolt onto an existing project.")
        Console.WriteError("  service  Long-running daemon. signal-aware shutdown loop using")
        Console.WriteError("           Amalgame.Service + Amalgame.Logging, a systemd unit, and")
        Console.WriteError("           an install.sh wired for /usr/local/bin + systemctl.")
        Console.WriteError("  forms        GUI app on top of amalgame-ui-sdl + amalgame-ui-forms.")
        Console.WriteError("               Sunset 2026-05-15 — use ui-web-form for new projects.")
        Console.WriteError("  ui-web-form  Webview GUI app on top of amalgame-ui-web. HTML/CSS UI")
        Console.WriteError("               rendered by the OS webview (WebView2 / WKWebView /")
        Console.WriteError("               WebKitGTK). Requires libwebkit2gtk-4.1-dev on Linux")
        Console.WriteError("               (macOS / Windows 11 ship the engine with the OS).")
        Console.WriteError("")
        Console.WriteError("Flags:")
        Console.WriteError("  --template <kind>    One of: exe (default), lib, test, service, forms, ui-web-form.")
        Console.WriteError("  --vscode             Also write .vscode/launch.json + settings.json")
        Console.WriteError("                       so F5 launches the binary under `amc dap` with")
        Console.WriteError("                       breakpoints on the .am sources. Opt-in to avoid")
        Console.WriteError("                       polluting projects edited in other editors.")
        Console.WriteError("  --force              Overwrite if <name>/ already exists.")
        Console.WriteError("  -h, --help           Print this help and exit.")
    }

    public static int Run(int argc) {
        var name:       string = ""
        var template:   string = "exe"
        var force:      bool   = false
        var wantVscode: bool   = false

        var i: int = 2
        while (i < argc) {
            let a: string = Args_Get(i)
            if (a == "-h" || a == "--help") {
                NewCommand.PrintUsage()
                return 0
            }
            if (a == "--force") {
                force = true
            } else if (a == "--vscode") {
                wantVscode = true
            } else if (a == "--template") {
                if (i + 1 >= argc) {
                    Console.WriteError("amc new: --template needs a value")
                    return 1
                }
                i = i + 1
                template = Args_Get(i)
            } else if (String_StartsWith(a, "-")) {
                Console.WriteError("amc new: unknown flag '" + a + "'")
                NewCommand.PrintUsage()
                return 1
            } else {
                if (String_Length(name) == 0) {
                    name = a
                } else {
                    Console.WriteError("amc new: extra positional '" + a + "'")
                    return 1
                }
            }
            i = i + 1
        }

        if (String_Length(name) == 0) {
            Console.WriteError("amc new: missing <name>")
            NewCommand.PrintUsage()
            return 1
        }
        if (template != "exe" && template != "lib" && template != "test" && template != "service" && template != "forms" && template != "ui-web-form") {
            Console.WriteError("amc new: unknown template '" + template + "' (try exe / lib / test / service / forms / ui-web-form)")
            return 1
        }
        // Accept a path like `path/to/myproj` — IsSafeName only
        // validates the last segment, which is what we use as the
        // namespace and the lib/test file stem. Intermediate dirs
        // can be anything mkdir -p accepts.
        let baseName: string = NewCommand.Basename(name)
        if (!NewCommand.IsSafeName(baseName)) {
            Console.WriteError("amc new: '" + baseName + "' is not a safe project name (a-z, A-Z, 0-9, _ or -)")
            return 1
        }

        // Pre-existence guard. We never silently overwrite an existing
        // directory — confirmation is a single --force flag away.
        if (File.Exists(name) && !force) {
            Console.WriteError("amc new: '" + name + "' already exists (pass --force to overwrite)")
            return 1
        }

        // Cross-platform — shelling to `mkdir -p` breaks on Windows
        // cmd (no -p flag) and creates literal `-p` + `'name'` dirs.
        // File.Mkdir uses the runtime POSIX `mkdir(0755)` / Windows
        // `_mkdir` recursive walker. Idempotent.
        if (!File.Mkdir(name)) {
            Console.WriteError("amc new: failed to create directory '" + name + "'")
            return 1
        }

        var rc: int = 0
        if (template == "exe") {
            rc = NewCommand.ScaffoldExe(name, baseName)
        } else if (template == "lib") {
            rc = NewCommand.ScaffoldLib(name, baseName)
        } else if (template == "service") {
            rc = NewCommand.ScaffoldService(name, baseName)
        } else if (template == "forms") {
            rc = NewCommand.ScaffoldForms(name, baseName)
        } else if (template == "ui-web-form") {
            rc = NewCommand.ScaffoldUiWebForm(name, baseName)
        } else {
            rc = NewCommand.ScaffoldTest(name, baseName)
        }
        if (rc != 0) { return rc }
        // Opt-in VS Code wiring. Only after the template succeeded —
        // no partial scaffolds with a stray .vscode/.
        if (wantVscode) {
            return NewCommand.WriteVscodeConfig(name, baseName, template)
        }
        return 0
    }

    // ── Templates ─────────────────────────────────────

    private static int ScaffoldExe(string path, string base) {
        if (!File.Mkdir(path + "/src") || !File.Mkdir(path + "/tests")) {
            Console.WriteError("amc new: failed to create subdirectories")
            return 1
        }

        let mainAm: string = NewCommand.MainAmExe(base)
        let testAm: string = NewCommand.TestAmExe(base)
        let buildSh: string = NewCommand.BuildShExe(base)
        let readme: string  = NewCommand.ReadmeExe(base)
        let gitignore: string = NewCommand.GitignoreCommon()

        if (!NewCommand.WriteFile(path + "/src/main.am", mainAm))            { return 1 }
        if (!NewCommand.WriteFile(path + "/tests/hello_test.am", testAm))    { return 1 }
        if (!NewCommand.WriteFile(path + "/build.sh", buildSh))              { return 1 }
        if (!NewCommand.WriteFile(path + "/.gitignore", gitignore))          { return 1 }
        if (!NewCommand.WriteFile(path + "/README.md", readme))              { return 1 }
        Process.Run("chmod +x " + NewCommand.ShellEscape(path + "/build.sh"))

        Console.WriteLine("Scaffolded '" + base + "' (exe template).")
        Console.WriteLine("  cd " + path)
        Console.WriteLine("  ./build.sh && ./" + base)
        return 0
    }

    private static int ScaffoldLib(string path, string base) {
        if (!File.Mkdir(path + "/src")) {
            Console.WriteError("amc new: failed to create src/ subdirectory")
            return 1
        }

        let libAm: string  = NewCommand.LibAm(base)
        let buildSh: string = NewCommand.BuildShLib(base)
        let readme: string  = NewCommand.ReadmeLib(base)
        let gitignore: string = NewCommand.GitignoreCommon()

        if (!NewCommand.WriteFile(path + "/src/" + base + ".am", libAm))   { return 1 }
        if (!NewCommand.WriteFile(path + "/build.sh", buildSh))             { return 1 }
        if (!NewCommand.WriteFile(path + "/.gitignore", gitignore))         { return 1 }
        if (!NewCommand.WriteFile(path + "/README.md", readme))             { return 1 }
        Process.Run("chmod +x " + NewCommand.ShellEscape(path + "/build.sh"))

        Console.WriteLine("Scaffolded '" + base + "' (lib template).")
        Console.WriteLine("  cd " + path)
        Console.WriteLine("  ./build.sh   # builds " + base + ".o (library)")
        return 0
    }

    private static int ScaffoldService(string path, string base) {
        if (!File.Mkdir(path + "/src")) {
            Console.WriteError("amc new: failed to create src/ subdirectory")
            return 1
        }

        // POSIX side — systemd unit + install/build .sh
        let mainAm:    string = NewCommand.MainAmService(base)
        let unit:      string = NewCommand.SystemdUnit(base)
        let installSh: string = NewCommand.InstallShService(base)
        let buildSh:   string = NewCommand.BuildShService(base)
        // Windows side — NSSM-based install + MinGW build, PowerShell only
        // (modern, available on every Windows 7+ host, much cleaner
        // download-and-extract logic than a CMD batch script).
        let buildPs1:   string = NewCommand.BuildPs1Service(base)
        let installPs1: string = NewCommand.InstallPs1Service(base)
        let readme:     string = NewCommand.ReadmeService(base)
        let gitignore:  string = NewCommand.GitignoreService(base)
        // Project F follow-up (v0.7.7): Logging + Service moved out of
        // bundled stdlib into external packages. The scaffold ships a
        // ready-to-use amalgame.toml so `amc package add` populates the
        // lock + cache before first build.
        let manifest:   string = NewCommand.ManifestService(base)

        if (!NewCommand.WriteFile(path + "/src/main.am",            mainAm))     { return 1 }
        if (!NewCommand.WriteFile(path + "/amalgame.toml",          manifest))   { return 1 }
        if (!NewCommand.WriteFile(path + "/" + base + ".service",   unit))       { return 1 }
        if (!NewCommand.WriteFile(path + "/install.sh",             installSh))  { return 1 }
        if (!NewCommand.WriteFile(path + "/build.sh",               buildSh))    { return 1 }
        if (!NewCommand.WriteFile(path + "/install.ps1",            installPs1)) { return 1 }
        if (!NewCommand.WriteFile(path + "/build.ps1",              buildPs1))   { return 1 }
        if (!NewCommand.WriteFile(path + "/.gitignore",             gitignore))  { return 1 }
        if (!NewCommand.WriteFile(path + "/README.md",              readme))     { return 1 }
        Process.Run("chmod +x " + NewCommand.ShellEscape(path + "/build.sh"))
        Process.Run("chmod +x " + NewCommand.ShellEscape(path + "/install.sh"))

        Console.WriteLine("Scaffolded '" + base + "' (service template).")
        Console.WriteLine("  cd " + path)
        Console.WriteLine("  amc package add logging service     # fetch external deps (one-off)")
        Console.WriteLine("  Linux:    ./build.sh && sudo ./install.sh")
        Console.WriteLine("            sudo journalctl -fu " + base)
        Console.WriteLine("  Windows:  .\\build.ps1 ; Start-Process powershell -Verb runAs install.ps1")
        Console.WriteLine("            (uses NSSM under the hood; auto-downloaded if missing)")
        return 0
    }

