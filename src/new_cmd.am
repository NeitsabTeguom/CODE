    private static bool WriteFile(string path, string content) {
        let ok: bool = File.WriteAll(path, content)
        if (!ok) {
            Console.WriteError("amc new: failed to write '" + path + "'")
            return false
        }
        return true
    }

    private static string ShellEscape(string s) {
        // Minimal escape: wrap in single quotes, replacing internal `'`
        // with `'\''`. Sufficient for project names which are already
        // restricted by IsSafeName, plus the literal "src" / "tests"
        // suffixes we tack on.
        let n: int = String_Length(s)
        var out: string = "'"
        for i in 0..n {
            let c: string = String_CharAt1(s, i)
            if (c == "'") {
                out = out + "'\\''"
            } else {
                out = out + c
            }
        }
        out = out + "'"
        return out
    }

    private static bool IsSafeName(string s) {
        let n: int = String_Length(s)
        if (n == 0) { return false }
        let allowed: string = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-"
        for i in 0..n {
            let c: string = String_CharAt1(s, i)
            if (String_IndexOf(allowed, c) < 0) { return false }
        }
        // Disallow names that would collide with shell metacharacters
        // even though IsSafeName already excludes them; double-check
        // is cheap and protects ShellEscape's contract.
        if (String_StartsWith(s, "-")) { return false }
        return true
    }

    private static string Capitalize(string s) {
        if (String_Length(s) == 0) { return s }
        let head: string = String_Substring(s, 0, 1)
        let tail: string = String_Substring(s, 1, String_Length(s) - 1)
        return String_ToUpper(head) + tail
    }

    // Last segment of a slash-separated path. `foo/bar/baz` → `baz`.
    // No segment → return as-is. Used so a user can pass a full
    // path (`amc new path/to/foo`) and we extract `foo` as the
    // namespace and source-file stem.
    private static string Basename(string p) {
        let n: int = String_Length(p)
        if (n == 0) { return p }
        var i: int = n - 1
        while (i >= 0) {
            let c: string = String_Substring(p, i, 1)
            if (c == "/") {
                return String_Substring(p, i + 1, n - i - 1)
            }
            i = i - 1
        }
        return p
    }

