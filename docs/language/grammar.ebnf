(* ═══════════════════════════════════════════════════════ *)
(*  EXPRESSIONS                                           *)
(* ═══════════════════════════════════════════════════════ *)

(* Le parser est Pratt-style à grimpe de précédence.
   Du plus faible (en bas) au plus fort (en haut), les
   niveaux sont :

     0. Lambda  (intercepte avant Assign : `IDENT "=>" Expr`)
     1. Assign     `=` `+=` … `>>=`           (right-assoc)
     2. LogicalOr  `||`                        (left-assoc)
     3. BitOr      `|`
     4. BitXor     `^`
     5. BitAnd     `&`
     6. LogicalAnd `&&`
     7. Equality   `==` `!=`
     8. Relational `<` `>` `<=` `>=`
     9. Shift      `<<` `>>`
    10. Additive   `+` `-`
    11. Multiplic. `*` `/` `%`
    12. Unary      `-` `!` `~`                  (right-assoc)
    13. Postfix    `f(args)` `obj.field` `obj?.field` `obj[i]`
    14. Primary    literals, `this`, `null`, `(expr)`,
                   `new T(args)`, list-comp, lambda, tuple. *)

Expression
    = Lambda
    | Assignment
    ;

Lambda
    = IDENT "=>" Expression
    ;

Assignment
    = LogicalOr [ AssignOp Assignment ]
    ;

LogicalOr
    = BitOr   { "||"  BitOr }
    ;

BitOr
    = BitXor  { "|"   BitXor }
    ;

BitXor
    = BitAnd  { "^"   BitAnd }
    ;

BitAnd
    = LogicalAnd { "&" LogicalAnd }
    ;

LogicalAnd
    = Equality { "&&" Equality }
    ;

Equality
    = Relational { ( "==" | "!=" ) Relational }
    ;

Relational
    = Shift { ( "<" | ">" | "<=" | ">=" ) Shift }
    ;

Shift
    = Additive { ( "<<" | ">>" ) Additive }
    ;

Additive
    = Multiplicative { ( "+" | "-" ) Multiplicative }
    ;

Multiplicative
    = Unary { ( "*" | "/" | "%" ) Unary }
    ;

Unary
    = ( "-" | "!" | "~" ) Unary
    | Postfix
    ;

Postfix
    = Primary { PostfixOp }
    ;

PostfixOp
    = "."  IDENT                      (* member access      *)
    | "?." IDENT                      (* null-safe member   *)
    | "["  Expression "]"             (* index              *)
    | "("  [ ArgList ] ")"            (* call               *)
    ;

ArgList
    = Arg { "," Arg }
    ;

Arg
