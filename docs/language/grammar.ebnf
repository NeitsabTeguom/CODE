(* ═══════════════════════════════════════════════════════ *)
(*  Grammaire EBNF du langage Amalgame                    *)
(*  Version : 0.3.4                                       *)
(*                                                        *)
(*  Cette grammaire reflète exactement le parser          *)
(*  self-hosted (src/parser/parser.am). Elle décrit la    *)
(*  syntaxe acceptée aujourd'hui — les sucres syntaxiques *)
(*  rejetés ou réservés pour plus tard sont absents.      *)
(* ═══════════════════════════════════════════════════════ *)


(* ── Conventions ────────────────────────────────────────
   [  x  ]  = optionnel (0 ou 1 occurrence)
   {  x  }  = zéro ou plusieurs
   (  x  )  = groupement
   x | y    = alternative
   "x"      = terminal littéral (mot-clé ou ponctuation)
   IDENT    = règle lexicale (token)
   ──────────────────────────────────────────────────── *)


(* ═══════════════════════════════════════════════════════ *)
(*  PROGRAMME                                             *)
(* ═══════════════════════════════════════════════════════ *)

Program
    = [ NamespaceDecl ]
      { ImportDecl }
      { TopLevelDecl }
    ;

NamespaceDecl
    = "namespace" QualifiedName NEWLINE
    ;

ImportDecl
    = "import" QualifiedName NEWLINE
    ;

QualifiedName
    = IDENT { "." IDENT }
    ;

TopLevelDecl
    = { Decorator }
      [ "public" ]
      [ "static" ]
      ( ClassDecl
      | DataClassDecl
      | EnumDecl
      | InterfaceDecl )
    ;


(* ═══════════════════════════════════════════════════════ *)
(*  DÉCLARATIONS DE TYPES                                 *)
(* ═══════════════════════════════════════════════════════ *)

(* ── Classe ─────────────────────────────────────────── *)

ClassDecl
    = "class" IDENT [ GenericParams ]
      [ ":" QualifiedName ]               (* extends *)
      [ "implements" QualifiedName { "," QualifiedName } ]
      "{" { ClassMember } "}"
    ;

GenericParams
    = "<" IDENT { "," IDENT } ">"
    ;

ClassMember
    = { Decorator }
      [ "public" ]
      [ "static" ]
      ( FieldDecl
      | MethodDecl )
    ;

FieldDecl
    = IDENT ":" Type [ "=" Expression ] NEWLINE
    ;

MethodDecl
    = Type IDENT [ GenericParams ]
      "(" [ ParamList ] ")"
      ( "{" { Statement } "}"
      | "=>" Expression NEWLINE )
    ;

ParamList
    = Param { "," Param }
    ;

Param
    = IDENT ":" Type
    ;

(* ── Data class / record ────────────────────────────── *)
(* `data class Foo(int x, string y) { ... }` et `record`
   sont équivalents : ils auto-génèrent les champs publics
   et un constructeur affectant chaque param au champ. *)

DataClassDecl
    = ( "data" "class" | "record" ) IDENT
      "(" [ DataParamList ] ")"
      [ "{" { ClassMember } "}" ]
    ;

DataParamList
    = DataParam { "," DataParam }
    ;

DataParam
    = Type IDENT
    ;

(* ── Enum (simple ou algébrique) ────────────────────── *)
(* Les variantes peuvent porter une liste de types
   (algébriques) : `enum Shape { Circle(float), Square(int, int), None }`. *)

EnumDecl
    = "enum" IDENT
      "{" EnumMember { ( "," | NEWLINE ) EnumMember } "}"
    ;

EnumMember
    = IDENT [ "(" Type { "," Type } ")" ]
    ;

(* ── Interface ──────────────────────────────────────── *)
(* Pas de champs ; uniquement des signatures de méthode.
   Deux syntaxes admises : classique `Type Name(params)`
   ou flèche `Name(params) -> Type`. *)

InterfaceDecl
    = "interface" IDENT
      "{" { InterfaceMethod } "}"
    ;

InterfaceMethod
    = ( Type IDENT "(" [ ParamList ] ")"
      | IDENT "(" [ ParamList ] ")" "->" Type )
      NEWLINE
    ;


(* ═══════════════════════════════════════════════════════ *)
(*  TYPES                                                 *)
(* ═══════════════════════════════════════════════════════ *)

Type
    = BaseType { TypeSuffix }
    ;

BaseType
    = PrimitiveType
    | QualifiedName [ GenericArgs ]
    | TupleType
    ;

PrimitiveType
    = "int" | "float" | "double" | "bool" | "string" | "void"
    ;

GenericArgs
    = "<" Type { "," Type } ">"
    ;

TupleType
    = "(" Type { "," Type } ")"
    ;

TypeSuffix
    = "?"            (* nullable T?  *)
    | "[" "]"        (* array T[]    *)
    ;


(* ═══════════════════════════════════════════════════════ *)
(*  STATEMENTS                                            *)
(* ═══════════════════════════════════════════════════════ *)

Statement
    = VarDecl
    | AssignStmt
    | ReturnStmt
    | IfStmt
    | GuardStmt
    | WhileStmt
    | ForInStmt
    | BreakStmt
    | ContinueStmt
    | MatchStmt
    | TryStmt
    | ThrowStmt
    | Block
    | ExprStmt
    ;

(* ── Déclarations locales ───────────────────────────── *)

VarDecl
    = ( "let" | "var" )
      ( IDENT [ ":" Type ] [ "=" Expression ]
<<<<<<< Updated upstream
      | "(" IDENT { "," IDENT } ")" "=" Expression )    (* tuple destructure *)
      NEWLINE
    ;

(* ── Affectation ────────────────────────────────────── *)
(* Au niveau syntaxique, `x = e` et les compounds passent
   par ParseAssign en position d'expression et sont
   utilisables aussi comme statement (statement-position
   expression). *)

AssignStmt
    = LValue AssignOp Expression NEWLINE
    ;

LValue
    = Postfix                       (* ident, member, index *)
    ;

AssignOp
    = "=" | "+=" | "-=" | "*=" | "/=" | "%="
    | "&=" | "|=" | "^=" | "<<=" | ">>="
    ;

(* ── Contrôle ──────────────────────────────────────── *)

ReturnStmt
    = "return" [ Expression ] NEWLINE
    ;

IfStmt
    = "if" [ "(" ] Expression [ ")" ] Block
      { "else" "if" [ "(" ] Expression [ ")" ] Block }
      [ "else" Block ]
    ;

