{
  "name": "amalgame",
  "displayName": "Amalgame",
  "description": "Syntax highlighting + LSP client for the Amalgame programming language (.am files).",
  "version": "0.2.2",
  "publisher": "BastienMOUGET",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/amalgame-lang/Amalgame.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:amalgame"
  ],
  "contributes": {
    "languages": [
      {
        "id": "amalgame",
        "aliases": ["Amalgame", "amalgame"],
        "extensions": [".am"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "amalgame",
        "scopeName": "source.amalgame",
        "path": "./syntaxes/amalgame.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Amalgame",
      "properties": {
        "amalgame.serverPath": {
          "type": "string",
          "default": "amc",
          "description": "Path to the amc binary used as the LSP server. Defaults to `amc` (must be on PATH). Set this to an absolute path or to ${workspaceFolder}/amc to point at a local build."
        },
        "amalgame.enableLsp": {
          "type": "boolean",
          "default": true,
          "description": "Enable the LSP client. Disable to fall back to syntax-only highlighting."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
