{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Amalgame",
  "scopeName": "source.amalgame",
  "fileTypes": ["am"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#c-block" },
    { "include": "#c-directives" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#decorators" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#functions" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "c-block": {
      "comment": "Inline-C blocks (v0.7.4+). Highlight body as C — @c { ... }. Nested braces inside the body are handled by the recursive c-block-inner pattern so a method-scope `if (...) { ... }` doesn't terminate the outer @c block early.",
      "begin": "(@c)(\\s*)(\\{)",
      "beginCaptures": {
        "1": { "name": "keyword.other.embed-c.amalgame" },
        "3": { "name": "punctuation.section.embedded.begin.amalgame" }
      },
      "end": "(\\})",
      "endCaptures": {
        "1": { "name": "punctuation.section.embedded.end.amalgame" }
      },
      "name": "meta.embedded.block.c",
      "contentName": "source.c",
      "patterns": [
        { "include": "#c-block-inner" },
        { "include": "source.c" }
      ]
    },
    "c-block-inner": {
      "comment": "Recursive helper for #c-block: consumes one level of balanced braces inside the embedded C body, then defers to source.c for the actual highlighting.",
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        { "include": "#c-block-inner" },
        { "include": "source.c" }
      ]
    },
    "c-directives": {
      "patterns": [
        {
          "comment": "@c_include \"<header.h>\" / @c_include \"local.h\" — file-scope directive.",
          "match": "(@c_include)\\s+(\"[^\"]*\")",
          "captures": {
            "1": { "name": "keyword.other.embed-c.amalgame" },
            "2": { "name": "string.quoted.double.amalgame" }
          }
        },
        {
          "comment": "@c_link \"libname\" — file-scope directive (passes -lname to gcc).",
          "match": "(@c_link)\\s+(\"[^\"]*\")",
          "captures": {
            "1": { "name": "keyword.other.embed-c.amalgame" },
            "2": { "name": "string.quoted.double.amalgame" }
          }
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.amalgame",
          "match": "//.*$"
        },
        {
          "name": "comment.block.amalgame",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.amalgame",
          "begin": "\"\"\"",
          "end": "\"\"\""
        },
        {
          "name": "string.quoted.double.amalgame",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.amalgame",
              "match": "\\\\(n|t|r|\"|\\\\|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4})"
            },
            {
              "comment": "String interpolation: only triggered when `{` is followed by an identifier start (letter or underscore), matching cgen's IsValidInterpExpr. Bare `{` in JSON/CSS/JS embedded literals passes through as plain string content.",
              "name": "meta.embedded.expression.amalgame",
              "begin": "\\{(?=[A-Za-z_])",
              "end": "\\}",
              "patterns": [
                { "include": "#identifiers" },
                { "include": "#operators" }
              ]
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.amalgame",
          "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.integer.amalgame",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "decorators": {
      "patterns": [
        {
          "name": "entity.name.tag.decorator.amalgame",
          "match": "@[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.amalgame",
          "match": "\\b(if|else|for|while|return|match|in|is|as|break|continue|try|catch|throw|finally|guard)\\b"
        },
        {
          "comment": "MCU soft keywords (amc-embedded §6) — contextual: only highlighted when they open a block, so a variable named loop/setup/region is untouched.",
          "name": "keyword.control.mcu.amalgame",
          "match": "\\b(setup|loop|region)\\b(?=\\s*\\{)"
        },
        {
          "comment": "persist(...) escape valve (amc-embedded §5.3)",
          "name": "keyword.other.persist.amalgame",
          "match": "\\bpersist\\b(?=\\s*\\()"
        },
        {
          "name": "keyword.declaration.amalgame",
          "match": "\\b(let|var|class|interface|enum|record|data|func|extends|implements|namespace|import)\\b"
        },
        {
          "name": "storage.modifier.amalgame",
          "match": "\\b(public|private|static)\\b"
        },
        {
          "name": "constant.language.amalgame",
          "match": "\\b(true|false|null|this)\\b"
        },
        {
          "name": "keyword.other.new.amalgame",
          "match": "\\b(new)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.amalgame",
          "match": "\\b(int|string|bool|float|double|void|i32|i64|f32|f64|u8|u32)\\b"
        },
        {
          "name": "support.class.collection.amalgame",
          "match": "\\b(List|Map|Set)\\b"
        },
        {
          "name": "support.class.stdlib.amalgame",
          "match": "\\b(Console|File|Path|Math|String|Env|Http|TcpServer|TcpConn|Mcu|Board)\\b"
        },
        {
          "comment": "User-defined type names start with uppercase letter",
          "name": "entity.name.type.amalgame",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.amalgame",
          "match": "(=>|->|\\|>)"
        },
        {
          "name": "keyword.operator.range.amalgame",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.null-safe.amalgame",
          "match": "\\?\\.|\\?\\?"
        },
        {
          "name": "keyword.operator.assignment.amalgame",
          "match": "(\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>=|=)"
        },
        {
          "name": "keyword.operator.comparison.amalgame",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.amalgame",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.bitwise.amalgame",
          "match": "(<<|>>|&|\\||\\^|~)"
        },
        {
          "name": "keyword.operator.arithmetic.amalgame",
          "match": "(\\+|-|\\*|/|%)"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "comment": "Function/method call: identifier followed by (",
          "name": "meta.function-call.amalgame",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.amalgame" }
          }
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.amalgame",
          "match": "\\b[a-z_][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
