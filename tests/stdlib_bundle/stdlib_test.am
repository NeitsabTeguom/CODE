// Migrated from tests/run_stdlib_tests.sh — 180 stdlib assertions across
// 8 samples. Each sample compiles + runs ONCE; the captured stdout is
// scanned for each assertion's expected substring. Mirrors the bash
// runner case-for-case (PASS count must match).
//
// Driven by `amc test` discovery (*_test.am). Assumes CWD is the repo
// root so `./amc`, `./tests/samples/`, and `src/stdlib/` resolve.

class StdlibCase {
    public Label: string
    public Needle: string
    public StdlibCase(label: string, needle: string) {
        this.Label = label
        this.Needle = needle
    }
}

class Program {
    // Compile `sample` + `extras` (space-separated extra .am inputs),
    // link with libgc/m/curl/z, run, and return captured stdout. Empty
    // string returned on any compile/link/run error — caller surfaces a
    // distinguishable FAIL via the special "<<compile-fail>>" sentinel.
    public static string CompileAndRunOnce(string sample, string extras, string tag) {
        let outBin = "/tmp/amc_stdlib_" + tag + "_bin"
        let outC = outBin + ".c"
        // File order matters: extras (libraries) must come BEFORE the
        // sample so amc's resolver sees their class decls first. This
        // mirrors the bash runner's `$AMC -o out $extras $file` order.
        let amcCmd = "./amc -o '" + outBin + "' " + extras + " '" + sample + "' --quiet 2>/dev/null"
        let cr = Process.RunCapture(amcCmd)
        if (cr.Exit != 0) { return "<<compile-fail>>" }
        let gccCmd = "gcc -O2 -Wno-unused-variable -Wno-unused-parameter -Iruntime '" + outC + "' -lgc -lm -lz -ldl -lpthread -o '" + outBin + "' 2>/dev/null"
        let gc = Process.RunCapture(gccCmd)
        if (gc.Exit != 0) { return "<<link-fail>>" }
        let rr = Process.RunCapture("'" + outBin + "' 2>&1")
        return rr.Stdout
    }

    public static void RunGroup(string sample, string extras, string tag, List<StdlibCase> cases) {
        let captured = Program.CompileAndRunOnce(sample, extras, tag)
        let n: int = cases.Count()
        if (captured == "<<compile-fail>>") {
            for i in 0..n {
                let c1 = cases.Get(i)
                Console.WriteLine("[FAIL] " + c1.Label + " (amc compile failed for " + sample + ")")
            }
            return
        }
        if (captured == "<<link-fail>>") {
            for i in 0..n {
                let c2 = cases.Get(i)
                Console.WriteLine("[FAIL] " + c2.Label + " (gcc link failed for " + sample + ")")
            }
            return
        }
        for i in 0..n {
            let c = cases.Get(i)
            if (String_Contains(captured, c.Needle)) {
                Console.WriteLine("[PASS] " + c.Label)
            } else {
                Console.WriteLine("[FAIL] " + c.Label + " (missing: " + c.Needle + ")")
            }
        }
    }

    // ── PackageManager e2e helpers ─────────────────

    public static string ShellRead(string cmd) {
        let r = Process.RunCapture(cmd)
        return String_Trim(r.Stdout)
    }

    public static int ShellExit(string cmd) {
        let r = Process.RunCapture(cmd + " >/dev/null 2>&1")
        return r.Exit
    }

    public static void AssertGrepFile(string label, string file, string pattern) {
        let exit = Program.ShellExit("grep -qE \"" + pattern + "\" '" + file + "'")
        if (exit == 0) {
            Console.WriteLine("[PASS] " + label)
        } else {
            Console.WriteLine("[FAIL] " + label + " (pattern not found in " + file + ")")
        }
    }

    public static void AssertGrepNotFile(string label, string file, string pattern) {
        let exit = Program.ShellExit("grep -qE \"" + pattern + "\" '" + file + "'")
        if (exit != 0) {
            Console.WriteLine("[PASS] " + label)
        } else {
            Console.WriteLine("[FAIL] " + label + " (forbidden pattern present in " + file + ")")
        }
    }

    // Validates Toml → PackageRegistry → Resolver → CGen end-to-end:
    // compiles a user program that imports a class only known to the
    // compiler via the fixture amalgame.lock + cached manifest, and
    // asserts the generated C has the right symbols + types + include.
    public static void RunPmE2E() {
        let tmp = Program.ShellRead("mktemp -d -t pm-e2e-XXXXXX")
        if (String_Length(tmp) == 0) {
            Console.WriteLine("[FAIL] PM e2e: mktemp failed")
            return
        }

        // amalgame.lock fixture
        let lockBody = "[[package]]\nname = \"fake-pkg\"\ngit  = \"example.com/fake/fake-pkg\"\ntag  = \"v0.1.0\"\nrev  = \"deadbeefcafebabe0000000000000000000000ab\"\n"
        File.WriteAll(tmp + "/amalgame.lock", lockBody)

        // user.am fixture — same body as the bash heredoc
        let userBody = "public class Program {\n    public static void Main() {\n        let r = FakePkg.Init()\n        let t: int = FakePkg.Tick(r)\n        let ok: bool = FakePkg.IsOk(r)\n        var okStr: string = \"false\"\n        if (ok) { okStr = \"true\" }\n        Console.WriteLine(\"e2e tick=\" + String_FromInt(t) + \" ok=\" + okStr)\n        FakePkg.Close(r)\n    }\n}\n"
        File.WriteAll(tmp + "/user.am", userBody)

        let amcAbs = Program.ShellRead("realpath ./amc")
        let cacheAbs = Program.ShellRead("realpath tests/fixtures/pm/cache")
        let runtimeAbs = Program.ShellRead("realpath runtime")

        // amc compile under the fixture env
        let amcCmd = "(cd '" + tmp + "' && AMALGAME_PACKAGES_DIR='" + cacheAbs + "' '" + amcAbs + "' -o out user.am --quiet) > '" + tmp + "/amc.log' 2>&1"
        let amcExit = Program.ShellExit(amcCmd)
        if (amcExit != 0) {
            Console.WriteLine("[FAIL] PM e2e: amc compile (exit=" + String_FromInt(amcExit) + ")")
            Program.ShellExit("rm -rf '" + tmp + "'")
            return
        }
        Console.WriteLine("[PASS] PM e2e: amc compile")

        // 5 grep assertions against the generated C
        let outC = tmp + "/out.c"
        Program.AssertGrepFile("PM e2e: header included",      outC, "#include.*fake_pkg.h")
        Program.AssertGrepFile("PM e2e: FakePkg.Init typed",   outC, "AmalgameFakePkg\\* .*= Amalgame_Fake_FakePkg_Init")
        Program.AssertGrepFile("PM e2e: FakePkg.Tick i64",     outC, "i64 .*= Amalgame_Fake_FakePkg_Tick")
        Program.AssertGrepFile("PM e2e: FakePkg.IsOk bool",    outC, "code_bool .*= Amalgame_Fake_FakePkg_IsOk")
        Program.AssertGrepFile("PM e2e: FakePkg.Close called", outC, "Amalgame_Fake_FakePkg_Close\\(")

        // gcc + run
        let gccCmd = "gcc -O2 -I'" + runtimeAbs + "' '" + outC + "' -lgc -lm -lz -o '" + tmp + "/out' 2>'" + tmp + "/gcc.log'"
        Program.ShellExit(gccCmd)
        let runOut = Program.ShellRead("'" + tmp + "/out' 2>&1")
        if (String_Contains(runOut, "e2e tick=1 ok=true")) {
            Console.WriteLine("[PASS] PM e2e: gcc + run")
        } else {
            Console.WriteLine("[FAIL] PM e2e: gcc + run (got: " + runOut + ")")
        }

        Program.ShellExit("rm -rf '" + tmp + "'")
    }

    // Mirrors PackageRegistry.PlatformTag(): "linux-x86_64" / "macos-arm64" / etc.
    public static string PlatformTag() {
        let os = Program.ShellRead("uname -s")
        let arch = Program.ShellRead("uname -m")
        var osTag: string = "unknown"
        if (String_Contains(os, "Linux"))   { osTag = "linux" }
        if (String_Contains(os, "Darwin"))  { osTag = "macos" }
        if (String_Contains(os, "MINGW"))   { osTag = "windows" }
        if (String_Contains(os, "MSYS"))    { osTag = "windows" }
        if (String_Contains(os, "CYGWIN"))  { osTag = "windows" }
        var archTag: string = arch
        if (arch == "amd64")   { archTag = "x86_64" }
        if (arch == "aarch64") { archTag = "arm64" }
        return osTag + "-" + archTag
    }

    public static void RunPmFacadeE2E() {
        let tmp = Program.ShellRead("mktemp -d -t pm-facade-e2e-XXXXXX")
        if (String_Length(tmp) == 0) {
            Console.WriteLine("[FAIL] facade e2e: mktemp failed")
            return
        }
        Program.ShellExit("cp -r tests/fixtures/pm-facade/cache '" + tmp + "/cache'")
        Program.ShellExit("cp tests/fixtures/pm-facade/amalgame.lock '" + tmp + "/amalgame.lock'")

        let pkgDir = tmp + "/cache/example.com/fake/fake-facade/v0.1.0_deadbeef"
        let plat = Program.PlatformTag()
        let buildDir = pkgDir + "/build/" + plat
        Program.ShellExit("mkdir -p '" + buildDir + "'")

        let amcAbs = Program.ShellRead("realpath ./amc")
        let runtimeAbs = Program.ShellRead("realpath runtime")
        let cacheAbs = tmp + "/cache"
        let base = buildDir + "/FakeFacade-facade"
        let archive = buildDir + "/libamalgame-pkg-FakeFacade.a"

        // ── 1. amc --lib precompile ──
        let precompileCmd = "(cd '" + tmp + "' && AMALGAME_PACKAGES_DIR='" + cacheAbs + "' '" + amcAbs + "' --lib --quiet '" + pkgDir + "/facade.am' -o '" + base + "') > '" + tmp + "/precompile.log' 2>&1"
        let pcExit = Program.ShellExit(precompileCmd)
        if (pcExit != 0) {
            Console.WriteLine("[FAIL] facade e2e: amc --lib (exit=" + String_FromInt(pcExit) + ")")
            Program.ShellExit("rm -rf '" + tmp + "'")
            return
        }
        Console.WriteLine("[PASS] facade e2e: amc --lib")

        // ── 2. Self-dispatch local shape (both symbols must be present) ──
        let baseC = base + ".c"
        let hasMake  = Program.ShellExit("grep -q 'Amalgame_Fake_FakeFacade_FakeFacade_Make(x)' '" + baseC + "'")
        let hasTwice = Program.ShellExit("grep -q 'Amalgame_Fake_FakeFacade_FakeFacade_Twice(m)' '" + baseC + "'")
        if (hasMake == 0 && hasTwice == 0) {
            Console.WriteLine("[PASS] facade e2e: self-dispatch local shape")
        } else {
            Console.WriteLine("[FAIL] facade e2e: self-dispatch local shape (lowered to PkgClass)")
        }

        // ── 3. gcc -c ──
        let gccCExit = Program.ShellExit("gcc -O2 -I'" + runtimeAbs + "' -w -c '" + baseC + "' -o '" + base + ".o' > '" + tmp + "/gcc.log' 2>&1")
        if (gccCExit == 0) {
            Console.WriteLine("[PASS] facade e2e: gcc -c")
        } else {
            Console.WriteLine("[FAIL] facade e2e: gcc -c")
            Program.ShellExit("rm -rf '" + tmp + "'")
            return
        }

        // ── 4. ar rcs ──
        let arExit = Program.ShellExit("ar rcs '" + archive + "' '" + base + ".o'")
        if (arExit == 0) {
            Console.WriteLine("[PASS] facade e2e: ar rcs")
        } else {
            Console.WriteLine("[FAIL] facade e2e: ar rcs")
            Program.ShellExit("rm -rf '" + tmp + "'")
            return
        }

        // ── 5. archive exists ──
        let arSize = Program.ShellExit("test -s '" + archive + "'")
        if (arSize == 0) {
            Console.WriteLine("[PASS] facade e2e: archive exists")
        } else {
            Console.WriteLine("[FAIL] facade e2e: archive exists (missing " + archive + ")")
            Program.ShellExit("rm -rf '" + tmp + "'")
            return
        }

        // ── 6. user.am compiles ──
        let userBody = "namespace UserApp\n\npublic class Program {\n    public static void Main() {\n        let v: int = FakeFacade.Make(41)\n        let w: int = FakeFacade.Twice(v)\n        let z: int = FakeFacade.MakeThenTwice(41)\n        Console.WriteLine(\"got \" + String_FromInt(w) + \" z=\" + String_FromInt(z))\n    }\n}\n"
        File.WriteAll(tmp + "/user.am", userBody)
        let userCmd = "(cd '" + tmp + "' && AMALGAME_PACKAGES_DIR='" + cacheAbs + "' '" + amcAbs + "' -o out user.am --quiet) > '" + tmp + "/usercompile.log' 2>&1"
        let userExit = Program.ShellExit(userCmd)
        if (userExit == 0) {
            Console.WriteLine("[PASS] facade e2e: amc compile")
        } else {
            Console.WriteLine("[FAIL] facade e2e: amc compile (exit=" + String_FromInt(userExit) + ")")
            Program.ShellExit("rm -rf '" + tmp + "'")
            return
        }

        // ── 7. Forward decl emitted ──
        Program.AssertGrepFile("facade e2e: forward decl emitted",
            tmp + "/out.c",
            "Amalgame_Fake_FakeFacade_FakeFacade_Make\\(i64 x\\);")

        // ── 8. Body NOT emitted ──
        Program.AssertGrepNotFile("facade e2e: body NOT emitted",
            tmp + "/out.c",
            "return x \\* 2;")

        // ── 9. gcc + run ──
        Program.ShellExit("gcc -O2 -I'" + runtimeAbs + "' '" + tmp + "/out.c' '" + archive + "' -lgc -lm -lz -ldl -lpthread -o '" + tmp + "/out' 2> '" + tmp + "/link.log'")
        let runOut = Program.ShellRead("'" + tmp + "/out' 2>&1")
        if (runOut == "got 84 z=84") {
            Console.WriteLine("[PASS] facade e2e: gcc + run")
        } else {
            Console.WriteLine("[FAIL] facade e2e: gcc + run (got: " + runOut + ")")
        }

        Program.ShellExit("rm -rf '" + tmp + "'")
    }

