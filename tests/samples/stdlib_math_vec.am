// Stdlib test: Amalgame.Math.Vec — Vec3 / Vec4 / Mat4.
// Each [PASS] line below matches one assertion the runner looks
// for; fast-path failure prints [FAIL] with the actual value.

namespace Tests

import Amalgame.Math.Vec

public class Program {
    public static void Main(string[] args) {

        // ── Vec3 construction + accessors ──
        let a: Vec3 = new Vec3(1.0, 2.0, 3.0)
        if (a.GetX() == 1.0 && a.GetY() == 2.0 && a.GetZ() == 3.0) {
            Console.WriteLine("[PASS] vec3 ctor")
        } else {
            Console.WriteLine("[FAIL] vec3 ctor")
        }

        // ── Vec3 Add / Sub ──
        let b: Vec3 = new Vec3(4.0, 5.0, 6.0)
        let sum: Vec3 = a.Add(b)
        if (sum.GetX() == 5.0 && sum.GetY() == 7.0 && sum.GetZ() == 9.0) {
            Console.WriteLine("[PASS] vec3 add")
        } else {
            Console.WriteLine("[FAIL] vec3 add")
        }
        let diff: Vec3 = b.Sub(a)
        if (diff.GetX() == 3.0 && diff.GetY() == 3.0 && diff.GetZ() == 3.0) {
            Console.WriteLine("[PASS] vec3 sub")
        } else {
            Console.WriteLine("[FAIL] vec3 sub")
        }

        // ── Vec3 Scale ──
        let scaled: Vec3 = a.Scale(2.0)
        if (scaled.GetX() == 2.0 && scaled.GetY() == 4.0 && scaled.GetZ() == 6.0) {
            Console.WriteLine("[PASS] vec3 scale")
        } else {
            Console.WriteLine("[FAIL] vec3 scale")
        }

        // ── Vec3 Dot ──
        let d: float = a.Dot(b)
        if (d == 32.0) {
            Console.WriteLine("[PASS] vec3 dot")
        } else {
            Console.WriteLine("[FAIL] vec3 dot")
        }

        // ── Vec3 Cross — (1,2,3) × (4,5,6) = (-3, 6, -3) ──
        let c: Vec3 = a.Cross(b)
        if (c.GetX() == -3.0 && c.GetY() == 6.0 && c.GetZ() == -3.0) {
            Console.WriteLine("[PASS] vec3 cross")
        } else {
            Console.WriteLine("[FAIL] vec3 cross")
        }

        // ── Vec3 Length — |(3, 4, 0)| = 5 ──
        let pyth: Vec3 = new Vec3(3.0, 4.0, 0.0)
        let len: float = pyth.Length()
        if (len == 5.0) {
            Console.WriteLine("[PASS] vec3 length")
        } else {
            Console.WriteLine("[FAIL] vec3 length")
        }

        // ── Vec3 Normalize ──
        let n: Vec3 = pyth.Normalize()
        // (3/5, 4/5, 0) = (0.6, 0.8, 0)
        let nLen: float = n.Length()
        if (Math.Abs(nLen - 1.0) < 0.0001) {
            Console.WriteLine("[PASS] vec3 normalize")
        } else {
            Console.WriteLine("[FAIL] vec3 normalize")
        }

        // ── Vec3 Equals ──
        let a2: Vec3 = new Vec3(1.0, 2.0, 3.0)
        if (a.Equals(a2)) {
            Console.WriteLine("[PASS] vec3 equals")
        } else {
            Console.WriteLine("[FAIL] vec3 equals")
        }
        if (!a.Equals(b)) {
            Console.WriteLine("[PASS] vec3 not-equals")
        } else {
            Console.WriteLine("[FAIL] vec3 not-equals")
        }

        // ── Vec4 ctor + dot ──
        let v4a: Vec4 = new Vec4(1.0, 2.0, 3.0, 4.0)
        let v4b: Vec4 = new Vec4(5.0, 6.0, 7.0, 8.0)
        let v4d: float = v4a.Dot(v4b)
        // 1*5 + 2*6 + 3*7 + 4*8 = 5 + 12 + 21 + 32 = 70
        if (v4d == 70.0) {
            Console.WriteLine("[PASS] vec4 dot")
        } else {
            Console.WriteLine("[FAIL] vec4 dot")
        }

        // ── Mat4 Identity ──
        let id: Mat4 = Mat4.Identity()
        if (id.Get(0, 0) == 1.0 && id.Get(1, 1) == 1.0 && id.Get(2, 2) == 1.0 && id.Get(3, 3) == 1.0) {
            Console.WriteLine("[PASS] mat4 identity")
        } else {
            Console.WriteLine("[FAIL] mat4 identity")
        }
        if (id.Get(0, 1) == 0.0 && id.Get(1, 0) == 0.0) {
            Console.WriteLine("[PASS] mat4 identity off-diagonal")
        } else {
            Console.WriteLine("[FAIL] mat4 identity off-diagonal")
        }

        // ── Mat4 Translate × Identity = Translate ──
        let t: Mat4 = Mat4.Translate(10.0, 20.0, 30.0)
        let prod: Mat4 = t.Multiply(id)
        if (prod.Get(3, 0) == 10.0 && prod.Get(3, 1) == 20.0 && prod.Get(3, 2) == 30.0) {
            Console.WriteLine("[PASS] mat4 translate*id")
        } else {
            Console.WriteLine("[FAIL] mat4 translate*id")
        }

        // ── Mat4 Scale ──
        let s: Mat4 = Mat4.Scale(2.0, 3.0, 4.0)
        if (s.Get(0, 0) == 2.0 && s.Get(1, 1) == 3.0 && s.Get(2, 2) == 4.0) {
            Console.WriteLine("[PASS] mat4 scale")
        } else {
            Console.WriteLine("[FAIL] mat4 scale")
        }

        // ── Mat4 RotateZ(pi/2) on (1,0,0,1) — expect (0,1,0,1) ──
        let pi: float = 3.14159265358979323846
        let half: float = pi / 2.0
        let rz: Mat4 = Mat4.RotateZ(half)
        let p0: Vec4 = new Vec4(1.0, 0.0, 0.0, 1.0)
        let p1: Vec4 = rz.TransformVec4(p0)
        // After RotateZ(pi/2): X' ≈ 0, Y' ≈ 1, Z' = 0
        if (Math.Abs(p1.GetX()) < 0.0001 && Math.Abs(p1.GetY() - 1.0) < 0.0001 && p1.GetW() == 1.0) {
            Console.WriteLine("[PASS] mat4 rotateZ")
        } else {
            Console.WriteLine("[FAIL] mat4 rotateZ")
        }
    }
}
