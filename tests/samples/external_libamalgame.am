// Project F end-to-end fixture (v0.7.5+, trimmed in v0.7.7).
//
// Exercises the `--external <module.am>` path: the resolver +
// typechecker see MsgPack via its .am source, but the cgen emits
// forward decls only — definitions land at link time from
// lib/libamalgame.a (pre-built by tools/build-stdlib.sh).
//
// Post-v0.7.7 stdlib split: random / encoding / crypto / datetime /
// logging / service / io_filewatcher / yaml / math / math-vec all
// moved to external packages on amalgame-lang/. msgpack stays
// bundled until amc's cgen learns to resolve bundled-stdlib class
// names from external facades (deferred to v0.8.0).
//
// Compiled by tests/core_bundle/core_test.am as:
//   ./amc -o <out> tests/samples/external_libamalgame.am \
//       --external src/stdlib/json.am \
//       --external src/stdlib/msgpack.am
//   gcc -O2 -Iruntime <out>.c lib/libamalgame.a \
//       -lgc -lm -lz -o <out>

namespace App

import Amalgame.Formats.Json
import Amalgame.Formats.MsgPack
import Amalgame.Collections

public class Program {
    public static void Main(string[] args) {
        // MsgPack via Json — round-trip a fixint
        let v: JsonValue = new JsonValue()
        v.SetInt(42)
        let mp: List<int> = MsgPack.EncodeJson(v)
        let back: JsonValue = MsgPack.DecodeJson(mp)
        Console.WriteLine("mp: " + String.FromInt(back.AsInt()))
    }
}
