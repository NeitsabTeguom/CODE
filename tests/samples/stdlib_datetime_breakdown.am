// Stdlib test: Amalgame.DateTime — UTC breakdown
// (Year/Month/Day/Hour/Minute/Second). Distinct from the
// existing stdlib_datetime.am which covers the legacy
// Instant/Duration/Stopwatch surface.

namespace Tests

import Amalgame.DateTime

public class Program {
    public static void Main(string[] args) {

        // ── Unix epoch (0s) = 1970-01-01T00:00:00Z ──
        let epoch = Instant.FromUnixSeconds(0)
        if (epoch.Year() == 1970)  { Console.WriteLine("[PASS] epoch year") }   else { Console.WriteLine("[FAIL] epoch year") }
        if (epoch.Month() == 1)    { Console.WriteLine("[PASS] epoch month") }  else { Console.WriteLine("[FAIL] epoch month") }
        if (epoch.Day() == 1)      { Console.WriteLine("[PASS] epoch day") }    else { Console.WriteLine("[FAIL] epoch day") }
        if (epoch.Hour() == 0)     { Console.WriteLine("[PASS] epoch hour") }   else { Console.WriteLine("[FAIL] epoch hour") }
        if (epoch.Minute() == 0)   { Console.WriteLine("[PASS] epoch minute") } else { Console.WriteLine("[FAIL] epoch minute") }
        if (epoch.Second() == 0)   { Console.WriteLine("[PASS] epoch second") } else { Console.WriteLine("[FAIL] epoch second") }

        // ── 2026-05-12T08:00:00Z = unix 1778572800 ──
        let known = Instant.FromUnixSeconds(1778572800)
        if (known.Year() == 2026) { Console.WriteLine("[PASS] known year") }
        else { Console.WriteLine("[FAIL] known year got " + String_FromInt(known.Year())) }
        if (known.Month() == 5)   { Console.WriteLine("[PASS] known month") }
        else { Console.WriteLine("[FAIL] known month got " + String_FromInt(known.Month())) }
        if (known.Day() == 12)    { Console.WriteLine("[PASS] known day") }
        else { Console.WriteLine("[FAIL] known day got " + String_FromInt(known.Day())) }
        if (known.Hour() == 8)    { Console.WriteLine("[PASS] known hour") }
        else { Console.WriteLine("[FAIL] known hour got " + String_FromInt(known.Hour())) }

        // ── Round-trip Format / Parse → breakdown ──
        let iso: string = known.Format()
        let parsed = Instant.Parse(iso)
        if (parsed.Ok) {
            let p = parsed.Value
            if (p.Year() == 2026 && p.Month() == 5 && p.Day() == 12) {
                Console.WriteLine("[PASS] format+parse roundtrip")
            } else {
                Console.WriteLine("[FAIL] format+parse roundtrip")
            }
        } else {
            Console.WriteLine("[FAIL] format+parse roundtrip parse")
        }

        // ── Specific time: 1234567890 = 2009-02-13 23:31:30 UTC ──
        let famous = Instant.FromUnixSeconds(1234567890)
        if (famous.Year() == 2009 && famous.Month() == 2 && famous.Day() == 13 && famous.Hour() == 23) {
            Console.WriteLine("[PASS] famous Unix timestamp")
        } else {
            Console.WriteLine("[FAIL] famous Unix timestamp")
        }
        if (famous.Minute() == 31 && famous.Second() == 30) {
            Console.WriteLine("[PASS] famous minute+second")
        } else {
            Console.WriteLine("[FAIL] famous minute+second")
        }
    }
}
