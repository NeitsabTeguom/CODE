// Stdlib test: Amalgame.Messaging.MQTT — MQTT 3.1.1 client speaking
// the wire protocol over a raw TCP socket. Assumes a broker listening
// on 127.0.0.1:1883 (default port). The test runner gates this fixture
// on TCP reachability; if no broker is up, every case SKIPs cleanly.
//
// To run locally:
//   docker run --rm -p 1883:1883 eclipse-mosquitto:2 \
//     mosquitto -c /mosquitto-no-auth.conf
//   # or
//   sudo apt install mosquitto && mosquitto &
//
// All topics are namespaced under `amctest/` to keep the test isolated
// from any production data on a shared broker.

namespace Tests

import Amalgame.Messaging.MQTT

public class Program {
    public static void Main(string[] args) {

        // ── Open + CONNACK handshake ──────────────────────

        let m = MQTT.Open("127.0.0.1", 1883, "amalgame-test-client")
        if (MQTT.IsOpen(m)) {
            Console.WriteLine("[PASS] open 1883")
        } else {
            Console.WriteLine("[FAIL] open 1883: " + MQTT.LastError(m))
            return
        }

        // ── PINGREQ round-trip ────────────────────────────

        let pingOk: bool = MQTT.Ping(m)
        if (pingOk) {
            Console.WriteLine("[PASS] ping")
        } else {
            Console.WriteLine("[FAIL] ping: " + MQTT.LastError(m))
        }

        // ── SUBSCRIBE + SUBACK ────────────────────────────

        let subOk: bool = MQTT.Subscribe(m, "amctest/greeting")
        if (subOk) {
            Console.WriteLine("[PASS] subscribe greeting")
        } else {
            Console.WriteLine("[FAIL] subscribe greeting: " + MQTT.LastError(m))
        }

        // ── PUBLISH → loopback delivery ───────────────────

        // Publish to the same topic we just subscribed to. The broker
        // echoes the message back to us; WaitMessage with a 2s budget
        // should receive it well before timing out.
        let pubOk: bool = MQTT.Publish(m, "amctest/greeting", "hello mqtt")
        if (pubOk) {
            Console.WriteLine("[PASS] publish greeting")
        } else {
            Console.WriteLine("[FAIL] publish greeting: " + MQTT.LastError(m))
        }

        let got: bool = MQTT.WaitMessage(m, 2000)
        if (got) {
            Console.WriteLine("[PASS] received message")
        } else {
            Console.WriteLine("[FAIL] wait timed out: " + MQTT.LastError(m))
        }

        let topic: string = MQTT.LastTopic(m)
        if (topic == "amctest/greeting") {
            Console.WriteLine("[PASS] topic matches")
        } else {
            Console.WriteLine("[FAIL] topic got '" + topic + "'")
        }

        let payload: string = MQTT.LastPayload(m)
        if (payload == "hello mqtt") {
            Console.WriteLine("[PASS] payload matches")
        } else {
            Console.WriteLine("[FAIL] payload got '" + payload + "'")
        }

        // ── Second round-trip (exercises packet-id wrap + state) ──

        MQTT.Publish(m, "amctest/greeting", "round two")
        let got2: bool = MQTT.WaitMessage(m, 2000)
        if (got2 && MQTT.LastPayload(m) == "round two") {
            Console.WriteLine("[PASS] second message")
        } else {
            Console.WriteLine("[FAIL] second message got '" + MQTT.LastPayload(m) + "'")
        }

        // ── Timeout path ──────────────────────────────────

        // No publisher on this topic — WaitMessage should time out
        // and return false within ~500ms.
        let timeoutHit: bool = MQTT.WaitMessage(m, 500)
        if (!timeoutHit) {
            Console.WriteLine("[PASS] wait timeout")
        } else {
            Console.WriteLine("[FAIL] wait should have timed out")
        }

        // ── DISCONNECT + Close ────────────────────────────

        MQTT.Close(m)
        if (!MQTT.IsOpen(m)) {
            Console.WriteLine("[PASS] closed")
        } else {
            Console.WriteLine("[FAIL] still open after close")
        }
    }
}
