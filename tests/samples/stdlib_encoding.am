// Stdlib test: Amalgame.Encoding — Base64 / Hex / Url.
// Run by tests/run_stdlib_tests.sh; each [PASS] line below
// matches one assertion the runner looks for.
//
// Round-trips are the heaviest assertion — encode, decode,
// compare to the original byte list. Edge cases tested
// individually: empty input, padding lengths, invalid chars,
// case-mixing for hex, RFC 3986 reserved-set boundaries for URL.

import Amalgame.Encoding
import Amalgame.Collections

class Program {
    public static void Main() {

        // ── Base64 known-vector encode ─────────────────
        // "Hello" → "SGVsbG8="
        let hello: List<int> = new List<int>()
        hello.Add(72)
        hello.Add(101)
        hello.Add(108)
        hello.Add(108)
        hello.Add(111)
        let b64hello: string = Base64.Encode(hello)
        if (b64hello == "SGVsbG8=") {
            Console.WriteLine("[PASS] b64 encode hello")
        } else {
            Console.WriteLine("[FAIL] b64 encode hello got: " + b64hello)
        }

        // ── Base64 empty ───────────────────────────────
        let empty: List<int> = new List<int>()
        let b64empty: string = Base64.Encode(empty)
        if (b64empty == "") {
            Console.WriteLine("[PASS] b64 encode empty")
        } else {
            Console.WriteLine("[FAIL] b64 encode empty")
        }

        // ── Base64 single-byte (2 padding) ─────────────
        // [77] = "M" → "TQ=="
        let mb: List<int> = new List<int>()
        mb.Add(77)
        let b64M: string = Base64.Encode(mb)
        if (b64M == "TQ==") {
            Console.WriteLine("[PASS] b64 encode 1 byte")
        } else {
            Console.WriteLine("[FAIL] b64 encode 1 byte got: " + b64M)
        }

        // ── Base64 two-byte (1 padding) ────────────────
        // [77, 97] = "Ma" → "TWE="
        let ma: List<int> = new List<int>()
        ma.Add(77)
        ma.Add(97)
        let b64Ma: string = Base64.Encode(ma)
        if (b64Ma == "TWE=") {
            Console.WriteLine("[PASS] b64 encode 2 bytes")
        } else {
            Console.WriteLine("[FAIL] b64 encode 2 bytes got: " + b64Ma)
        }

        // ── Base64 round-trip ──────────────────────────
        let rt1: List<int> = Base64.Decode("SGVsbG8=")
        let rt1Cnt: int = rt1.Count()
        var rtOk: bool = (rt1Cnt == 5)
        if (rtOk) {
            let r0: int = rt1.Get(0)
            let r1: int = rt1.Get(1)
            let r2: int = rt1.Get(2)
            let r3: int = rt1.Get(3)
            let r4: int = rt1.Get(4)
            if (r0 != 72)  { rtOk = false }
            if (r1 != 101) { rtOk = false }
            if (r2 != 108) { rtOk = false }
            if (r3 != 108) { rtOk = false }
            if (r4 != 111) { rtOk = false }
        }
        if (rtOk) {
            Console.WriteLine("[PASS] b64 round trip")
        } else {
            Console.WriteLine("[FAIL] b64 round trip")
        }

        // ── Base64 IsValid ─────────────────────────────
        let v1: bool = Base64.IsValid("SGVsbG8=")
        let v2: bool = Base64.IsValid("not_b64*")
        if (v1 && !v2) {
            Console.WriteLine("[PASS] b64 IsValid")
        } else {
            Console.WriteLine("[FAIL] b64 IsValid")
        }

        // ── Base64 URL-safe round-trip ─────────────────
        // [251, 255, 191] = bytes that produce '+' and '/' in
        // standard alphabet → URL variant uses '-' and '_'.
        let edge: List<int> = new List<int>()
        edge.Add(251)
        edge.Add(255)
        edge.Add(191)
        let stdEnc: string = Base64.Encode(edge)
        let urlEnc: string = Base64.EncodeUrl(edge)
        // The two should differ (different alphabets) and the URL
        // variant should not contain '+' or '/'.
        let hasPlus: int = String_IndexOf(urlEnc, "+")
        let hasSlash: int = String_IndexOf(urlEnc, "/")
        let differs: bool = (stdEnc != urlEnc)
        if (differs && hasPlus < 0 && hasSlash < 0) {
            Console.WriteLine("[PASS] b64 url-safe alphabet")
        } else {
            Console.WriteLine("[FAIL] b64 url-safe alphabet")
        }
        // Round-trip via DecodeUrl
        let urlDec: List<int> = Base64.DecodeUrl(urlEnc)
        let urlDecCnt: int = urlDec.Count()
        var urlRtOk: bool = (urlDecCnt == 3)
        if (urlRtOk) {
            let u0: int = urlDec.Get(0)
            let u1: int = urlDec.Get(1)
            let u2: int = urlDec.Get(2)
            if (u0 != 251) { urlRtOk = false }
            if (u1 != 255) { urlRtOk = false }
            if (u2 != 191) { urlRtOk = false }
        }
        if (urlRtOk) {
            Console.WriteLine("[PASS] b64 url-safe round trip")
        } else {
            Console.WriteLine("[FAIL] b64 url-safe round trip")
        }

        // ── Hex encode / decode round-trip ─────────────
        let hex1: string = Hex.Encode(hello)
        if (hex1 == "48656c6c6f") {
            Console.WriteLine("[PASS] hex encode lower")
        } else {
            Console.WriteLine("[FAIL] hex encode lower got: " + hex1)
        }
        let hex2: string = Hex.EncodeUpper(hello)
        if (hex2 == "48656C6C6F") {
            Console.WriteLine("[PASS] hex encode upper")
        } else {
            Console.WriteLine("[FAIL] hex encode upper got: " + hex2)
        }
        // Mixed-case decode
        let mixed: List<int> = Hex.Decode("48656C6c6F")
        let mixedCnt: int = mixed.Count()
        var mixedOk: bool = (mixedCnt == 5)
        if (mixedOk) {
            let m0: int = mixed.Get(0)
            let m4: int = mixed.Get(4)
            if (m0 != 72)  { mixedOk = false }
            if (m4 != 111) { mixedOk = false }
        }
        if (mixedOk) {
            Console.WriteLine("[PASS] hex decode mixed case")
        } else {
            Console.WriteLine("[FAIL] hex decode mixed case")
        }

        // ── Hex error paths ────────────────────────────
        // Odd-length → empty
        let odd: List<int> = Hex.Decode("123")
        let oddCnt: int = odd.Count()
        // Bad char → empty
        let bad: List<int> = Hex.Decode("zz")
        let badCnt: int = bad.Count()
        if (oddCnt == 0 && badCnt == 0) {
            Console.WriteLine("[PASS] hex decode rejects bad input")
        } else {
            Console.WriteLine("[FAIL] hex decode rejects bad input")
        }

        // Hex IsValid
        let hv1: bool = Hex.IsValid("deadBEEF")
        let hv2: bool = Hex.IsValid("xyz")
        let hv3: bool = Hex.IsValid("abc")  // odd-length
        if (hv1 && !hv2 && !hv3) {
            Console.WriteLine("[PASS] hex IsValid")
        } else {
            Console.WriteLine("[FAIL] hex IsValid")
        }

        // ── Url Encode (path mode) ─────────────────────
        let u1: string = Url.Encode("hello world")
        if (u1 == "hello%20world") {
            Console.WriteLine("[PASS] url encode space")
        } else {
            Console.WriteLine("[FAIL] url encode space got: " + u1)
        }
        // Path mode keeps `/`
        let u2: string = Url.Encode("a/b?c=1")
        if (u2 == "a/b?c=1") {
            Console.WriteLine("[PASS] url encode path-safe")
        } else {
            Console.WriteLine("[FAIL] url encode path-safe got: " + u2)
        }
        // Component mode escapes `/`, `?`, `=`
        let u3: string = Url.EncodeComponent("a/b?c=1")
        if (u3 == "a%2Fb%3Fc%3D1") {
            Console.WriteLine("[PASS] url encode component")
        } else {
            Console.WriteLine("[FAIL] url encode component got: " + u3)
        }
        // Unreserved chars unchanged
        let u4: string = Url.Encode("Az09-_.~")
        if (u4 == "Az09-_.~") {
            Console.WriteLine("[PASS] url unreserved unchanged")
        } else {
            Console.WriteLine("[FAIL] url unreserved unchanged got: " + u4)
        }

        // ── Url Decode ─────────────────────────────────
        let d1: string = Url.Decode("hello%20world")
        if (d1 == "hello world") {
            Console.WriteLine("[PASS] url decode space")
        } else {
            Console.WriteLine("[FAIL] url decode space got: " + d1)
        }
        // Mixed case hex in escape
        let d2: string = Url.Decode("a%2fb")
        if (d2 == "a/b") {
            Console.WriteLine("[PASS] url decode lowercase hex")
        } else {
            Console.WriteLine("[FAIL] url decode lowercase hex got: " + d2)
        }
        // Strict: '+' is not space (RFC 3986)
        let d3: string = Url.Decode("a+b")
        if (d3 == "a+b") {
            Console.WriteLine("[PASS] url decode plus literal")
        } else {
            Console.WriteLine("[FAIL] url decode plus literal got: " + d3)
        }
        // Round-trip on a non-ASCII payload
        let payload: string = "hello world & friends"
        let enc: string = Url.EncodeComponent(payload)
        let back: string = Url.Decode(enc)
        if (back == payload) {
            Console.WriteLine("[PASS] url round trip")
        } else {
            Console.WriteLine("[FAIL] url round trip got: " + back)
        }
    }
}
