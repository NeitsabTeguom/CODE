// Stdlib test: Amalgame.Formats.Yaml — YAML 1.2 subset reader.
// Covers the shapes a CI / app config typically uses: top-level
// mapping, nested mappings, sequences of scalars, sequences of
// maps, bool / int / float / string scalars, quoted strings,
// comments.

namespace Tests

import Amalgame.Collections
import Amalgame.Formats.Yaml

public class Program {
    public static void Main(string[] args) {

        // ── Empty / null ─────────────────────────────────
        let empty = Yaml.Parse("")
        if (empty.IsNull()) {
            Console.WriteLine("[PASS] parse empty")
        } else {
            Console.WriteLine("[FAIL] parse empty")
        }

        // ── Single scalar mapping ────────────────────────
        let kv = Yaml.Parse("name: foo")
        if (kv.IsMap()) {
            Console.WriteLine("[PASS] kv is map")
        } else {
            Console.WriteLine("[FAIL] kv is map")
        }
        let kvName = kv.Get("name")
        if (kvName.AsString() == "foo") {
            Console.WriteLine("[PASS] kv string")
        } else {
            Console.WriteLine("[FAIL] kv string")
        }

        // ── Bool / int / float scalars ───────────────────
        let scalars = Yaml.Parse("active: true\ncount: 42\nratio: 1.5\n")
        if (scalars.Get("active").AsBool()) {
            Console.WriteLine("[PASS] scalar bool")
        } else {
            Console.WriteLine("[FAIL] scalar bool")
        }
        if (scalars.Get("count").AsInt() == 42) {
            Console.WriteLine("[PASS] scalar int")
        } else {
            Console.WriteLine("[FAIL] scalar int")
        }
        let ratio: float = scalars.Get("ratio").AsFloat()
        if (Math.Abs(ratio - 1.5) < 0.0001) {
            Console.WriteLine("[PASS] scalar float")
        } else {
            Console.WriteLine("[FAIL] scalar float")
        }

        // ── Quoted strings — single + double ────────────
        let quoted = Yaml.Parse("a: \"hello world\"\nb: 'verbatim'\n")
        if (quoted.Get("a").AsString() == "hello world") {
            Console.WriteLine("[PASS] double quoted")
        } else {
            Console.WriteLine("[FAIL] double quoted")
        }
        if (quoted.Get("b").AsString() == "verbatim") {
            Console.WriteLine("[PASS] single quoted")
        } else {
            Console.WriteLine("[FAIL] single quoted")
        }

        // ── Comments + blank lines ───────────────────────
        let cmt = Yaml.Parse("# leading comment\nname: foo # trailing\n\n# blank line above\nversion: 1\n")
        if (cmt.Get("name").AsString() == "foo") {
            Console.WriteLine("[PASS] comment-strip")
        } else {
            Console.WriteLine("[FAIL] comment-strip got: " + cmt.Get("name").AsString())
        }
        if (cmt.Get("version").AsInt() == 1) {
            Console.WriteLine("[PASS] post-blank line")
        } else {
            Console.WriteLine("[FAIL] post-blank line")
        }

        // ── Sequence of scalars ──────────────────────────
        let seq = Yaml.Parse("tags:\n  - red\n  - blue\n  - green\n")
        let tags = seq.Get("tags")
        if (tags.IsArray() && tags.Count() == 3) {
            Console.WriteLine("[PASS] seq count")
        } else {
            Console.WriteLine("[FAIL] seq count")
        }
        if (tags.At(0).AsString() == "red" && tags.At(2).AsString() == "green") {
            Console.WriteLine("[PASS] seq content")
        } else {
            Console.WriteLine("[FAIL] seq content")
        }

        // ── Nested mapping ───────────────────────────────
        let nest = Yaml.Parse("server:\n  host: localhost\n  port: 8080\n")
        let srv = nest.Get("server")
        if (srv.IsMap()) {
            Console.WriteLine("[PASS] nested map")
        } else {
            Console.WriteLine("[FAIL] nested map")
        }
        if (srv.Get("host").AsString() == "localhost") {
            Console.WriteLine("[PASS] nested string")
        } else {
            Console.WriteLine("[FAIL] nested string")
        }
        if (srv.Get("port").AsInt() == 8080) {
            Console.WriteLine("[PASS] nested int")
        } else {
            Console.WriteLine("[FAIL] nested int")
        }

        // ── Sequence of maps ─────────────────────────────
        let people = Yaml.Parse("people:\n  - name: alice\n    age: 30\n  - name: bob\n    age: 25\n")
        let pp = people.Get("people")
        if (pp.IsArray() && pp.Count() == 2) {
            Console.WriteLine("[PASS] seq-of-maps count")
        } else {
            Console.WriteLine("[FAIL] seq-of-maps count")
        }
        let alice = pp.At(0)
        if (alice.IsMap() && alice.Get("name").AsString() == "alice" && alice.Get("age").AsInt() == 30) {
            Console.WriteLine("[PASS] seq-of-maps alice")
        } else {
            Console.WriteLine("[FAIL] seq-of-maps alice")
        }

        // ── Has() / missing-key returns Null ─────────────
        if (kv.Has("name") && !kv.Has("nope")) {
            Console.WriteLine("[PASS] has check")
        } else {
            Console.WriteLine("[FAIL] has check")
        }
        let miss = kv.Get("nope")
        if (miss.IsNull()) {
            Console.WriteLine("[PASS] missing-key null")
        } else {
            Console.WriteLine("[FAIL] missing-key null")
        }
    }
}
