// Stdlib test: PackageRegistry — loads an amalgame.lock + the
// referenced packages' manifests from a fixture cache, verifies
// the parsed shape. No network / no git. This is the unit test
// for PR 3b; PR 3c plumbs the registry into resolver + cgen.

namespace Tests

import Amalgame.Collections
import Amalgame.Compiler

public class Program {
    public static void Main(string[] args) {

        let lockPath: string  = "tests/fixtures/pm/amalgame.lock"
        let cacheRoot: string = "tests/fixtures/pm/cache"
        let reg = PackageRegistry.LoadFrom(lockPath, cacheRoot)

        // ── One package loaded ────────────────────────────

        let count: int = reg.Packages.Count()
        if (count == 1) {
            Console.WriteLine("[PASS] one package")
        } else {
            Console.WriteLine("[FAIL] one package got " + String_FromInt(count))
        }

        let lp: LoadedPackage = reg.Packages.Get(0)

        // ── Package metadata ──────────────────────────────

        if (lp.Name == "fake-pkg") {
            Console.WriteLine("[PASS] name")
        } else {
            Console.WriteLine("[FAIL] name got '" + lp.Name + "'")
        }

        if (lp.ClassName == "FakePkg") {
            Console.WriteLine("[PASS] class name")
        } else {
            Console.WriteLine("[FAIL] class name got '" + lp.ClassName + "'")
        }

        if (lp.Ns == "Amalgame.Fake.FakePkg") {
            Console.WriteLine("[PASS] namespace")
        } else {
            Console.WriteLine("[FAIL] namespace got '" + lp.Ns + "'")
        }

        // Header is package-relative in the manifest, absolutised
        // by LoadFrom. We assert the leaf — the prefix depends on
        // where the test is invoked from.
        if (String_EndsWith(lp.Header, "runtime/fake_pkg.h")) {
            Console.WriteLine("[PASS] header path")
        } else {
            Console.WriteLine("[FAIL] header path got '" + lp.Header + "'")
        }

        // ── Functions table ───────────────────────────────

        let fnCount: int = lp.FuncNames.Count()
        if (fnCount == 4) {
            Console.WriteLine("[PASS] func count")
        } else {
            Console.WriteLine("[FAIL] func count got " + String_FromInt(fnCount))
        }

        // The manifest's [stdlib.functions] keys may parse in any
        // order; search by name + verify the return type.
        var initRet: string  = ""
        var tickRet: string  = ""
        var isOkRet: string  = ""
        var closeRet: string = ""
        for i in 0..fnCount {
            let name: string = lp.FuncNames.Get(i)
            let ret:  string = lp.FuncRets.Get(i)
            if (name == "Init")  { initRet  = ret }
            if (name == "Tick")  { tickRet  = ret }
            if (name == "IsOk")  { isOkRet  = ret }
            if (name == "Close") { closeRet = ret }
        }
        if (initRet == "AmalgameFakePkg*") {
            Console.WriteLine("[PASS] Init returns pointer")
        } else {
            Console.WriteLine("[FAIL] Init got '" + initRet + "'")
        }
        if (tickRet == "i64") {
            Console.WriteLine("[PASS] Tick returns i64")
        } else {
            Console.WriteLine("[FAIL] Tick got '" + tickRet + "'")
        }
        if (isOkRet == "code_bool") {
            Console.WriteLine("[PASS] IsOk returns bool")
        } else {
            Console.WriteLine("[FAIL] IsOk got '" + isOkRet + "'")
        }
        if (closeRet == "void") {
            Console.WriteLine("[PASS] Close returns void")
        } else {
            Console.WriteLine("[FAIL] Close got '" + closeRet + "'")
        }

        // ── Aggregate accessors ───────────────────────────

        let classes: List<string> = reg.ClassNames()
        let firstClass: string = classes.Get(0)
        if (classes.Count() == 1 && firstClass == "FakePkg") {
            Console.WriteLine("[PASS] ClassNames aggregate")
        } else {
            Console.WriteLine("[FAIL] ClassNames aggregate")
        }

        let headers: List<string> = reg.Headers()
        let firstHdr: string = headers.Get(0)
        let hdrEnds: bool = String_EndsWith(firstHdr, "runtime/fake_pkg.h")
        if (headers.Count() == 1 && hdrEnds) {
            Console.WriteLine("[PASS] Headers aggregate")
        } else {
            Console.WriteLine("[FAIL] Headers aggregate")
        }

        // ── C → Amalgame type derivation ──────────────────

        let cType1: string = "AmalgameFakePkg*"
        let aType1: string = PackageRegistry.AmalgameTypeFromC(cType1)
        if (aType1 == "AmalgameFakePkg") {
            Console.WriteLine("[PASS] strip star")
        } else {
            Console.WriteLine("[FAIL] strip star got '" + aType1 + "'")
        }

        let cType2: string = "code_bool"
        let aType2: string = PackageRegistry.AmalgameTypeFromC(cType2)
        if (aType2 == "code_bool") {
            Console.WriteLine("[PASS] passthrough primitive")
        } else {
            Console.WriteLine("[FAIL] passthrough got '" + aType2 + "'")
        }

        // ── Missing lock path → empty registry ────────────

        let emptyReg = PackageRegistry.LoadFrom("tests/fixtures/pm/__nonexistent__.lock", cacheRoot)
        if (emptyReg.Packages.Count() == 0) {
            Console.WriteLine("[PASS] missing lock empty")
        } else {
            Console.WriteLine("[FAIL] missing lock empty")
        }

        // ── v0.5.3: cflags / cxxflags / libs ──────────────

        if (lp.CFlags == "-DFAKEPKG_BUILD=1") {
            Console.WriteLine("[PASS] cflags parsed")
        } else {
            Console.WriteLine("[FAIL] cflags got '" + lp.CFlags + "'")
        }

        if (lp.CxxFlags == "-std=c++11") {
            Console.WriteLine("[PASS] cxxflags parsed")
        } else {
            Console.WriteLine("[FAIL] cxxflags got '" + lp.CxxFlags + "'")
        }

        let libsCount: int = lp.Libs.Count()
        if (libsCount == 2) {
            Console.WriteLine("[PASS] libs count")
        } else {
            Console.WriteLine("[FAIL] libs count got " + String_FromInt(libsCount))
        }
        if (libsCount >= 1 && lp.Libs.Get(0) == "stdc++") {
            Console.WriteLine("[PASS] libs[0]")
        } else {
            Console.WriteLine("[FAIL] libs[0]")
        }
        if (libsCount >= 2 && lp.Libs.Get(1) == "m") {
            Console.WriteLine("[PASS] libs[1]")
        } else {
            Console.WriteLine("[FAIL] libs[1]")
        }

        // ── v0.5.3: schema-version gate ───────────────────

        // The fixture declares schema-version = 1, which the
        // current amc supports — the package must load.
        if (PackageRegistry.SupportedManifestSchema() >= 1) {
            Console.WriteLine("[PASS] supports schema v1")
        } else {
            Console.WriteLine("[FAIL] supports schema v1")
        }

        // ── v0.5.3: C++ source detection ──────────────────

        if (PackageRegistry.IsCxxSource("foo.cpp")) {
            Console.WriteLine("[PASS] detects .cpp")
        } else {
            Console.WriteLine("[FAIL] detects .cpp")
        }
        if (PackageRegistry.IsCxxSource("foo.cc")) {
            Console.WriteLine("[PASS] detects .cc")
        } else {
            Console.WriteLine("[FAIL] detects .cc")
        }
        if (PackageRegistry.IsCxxSource("foo.cxx")) {
            Console.WriteLine("[PASS] detects .cxx")
        } else {
            Console.WriteLine("[FAIL] detects .cxx")
        }
        if (!PackageRegistry.IsCxxSource("foo.c")) {
            Console.WriteLine("[PASS] .c not cxx")
        } else {
            Console.WriteLine("[FAIL] .c not cxx")
        }

        // ── v0.5.3: registry aggregates ───────────────────

        // The fixture has no sources → HasCxxSources is false.
        if (!reg.HasCxxSources()) {
            Console.WriteLine("[PASS] no cxx sources")
        } else {
            Console.WriteLine("[FAIL] no cxx sources")
        }
        // The fixture declares libs=["stdc++","m"] → CollectLibs
        // returns both.
        let collected: List<string> = reg.CollectLibs()
        if (collected.Count() == 2 && collected.Get(0) == "stdc++" && collected.Get(1) == "m") {
            Console.WriteLine("[PASS] CollectLibs")
        } else {
            Console.WriteLine("[FAIL] CollectLibs got " + String_FromInt(collected.Count()))
        }

        // ── v0.5.4: precompile flag + PkgDir ──────────────

        if (lp.Precompile) {
            Console.WriteLine("[PASS] precompile parsed")
        } else {
            Console.WriteLine("[FAIL] precompile parsed")
        }
        // PkgDir is populated by LoadFrom with the absolute cache
        // path (`<cacheRoot>/<git>/<tag>_<sha>`). Assert it ends
        // with the expected suffix.
        if (String_EndsWith(lp.PkgDir, "example.com/fake/fake-pkg/v0.1.0_deadbeef")) {
            Console.WriteLine("[PASS] pkgdir populated")
        } else {
            Console.WriteLine("[FAIL] pkgdir got '" + lp.PkgDir + "'")
        }

        // ── Project F follow-up: Facade defaults to empty ─
        // The fake-pkg fixture doesn't declare [stdlib].facade, so
        // LoadFrom should leave Facade as "". A non-empty value
        // would mean the manifest accidentally introduced the key
        // or LoadFrom set it from a different field.
        if (String_Length(lp.Facade) == 0) {
            Console.WriteLine("[PASS] facade empty for fake-pkg")
        } else {
            Console.WriteLine("[FAIL] facade got '" + lp.Facade + "'")
        }

        // ── v0.5.4: PlatformTag returns os-arch ───────────

        let platform: string = PackageRegistry.PlatformTag()
        if (String_Contains(platform, "-")) {
            Console.WriteLine("[PASS] platform tag shape")
        } else {
            Console.WriteLine("[FAIL] platform tag got '" + platform + "'")
        }

        // ── v0.5.4: PrecompileCacheDir composition ────────

        let cacheDir: string = PackageRegistry.PrecompileCacheDir("/tmp/fake-pkg")
        if (String_StartsWith(cacheDir, "/tmp/fake-pkg/build/") && String_EndsWith(cacheDir, platform)) {
            Console.WriteLine("[PASS] precompile cache path")
        } else {
            Console.WriteLine("[FAIL] precompile cache path got '" + cacheDir + "'")
        }

        // ── v0.5.4: Calibration in-memory round-trip ──────

        let cal = new Calibration()
        // Empty → no estimate available.
        if (cal.EstimateSeconds("cxx", 25000) == -1) {
            Console.WriteLine("[PASS] empty calibration no eta")
        } else {
            Console.WriteLine("[FAIL] empty calibration eta")
        }
        // Add samples for both languages.
        cal.Add("cxx", 25000, 167, "duckdb@v0.1.0")
        cal.Add("c",   9000,  31,  "sqlite@v0.2.0")
        if (cal.SampleCount("cxx") == 1 && cal.SampleCount("c") == 1) {
            Console.WriteLine("[PASS] sample counts")
        } else {
            Console.WriteLine("[FAIL] sample counts")
        }
        // Weighted rate: 25000 KB cxx → 167s ⇒ 25000 KB target ≈ 167s.
        let etaCxx: int = cal.EstimateSeconds("cxx", 25000)
        if (etaCxx == 167) {
            Console.WriteLine("[PASS] cxx eta")
        } else {
            Console.WriteLine("[FAIL] cxx eta got " + String_FromInt(etaCxx))
        }
        // For C: 9000 KB → 31s ⇒ 1000 KB ≈ 3s (integer division).
        let etaC: int = cal.EstimateSeconds("c", 1000)
        if (etaC >= 2 && etaC <= 5) {
            Console.WriteLine("[PASS] c eta")
        } else {
            Console.WriteLine("[FAIL] c eta got " + String_FromInt(etaC))
        }
        // Unknown language → no estimate.
        if (cal.EstimateSeconds("rust", 1000) == -1) {
            Console.WriteLine("[PASS] unknown lang no eta")
        } else {
            Console.WriteLine("[FAIL] unknown lang eta")
        }

        // ── v0.6.0: version operators ─────────────────────

        // >= (existing, regression).
        if (PackageRegistry.VersionSatisfies("0.5.6", ">=0.5.0")) {
            Console.WriteLine("[PASS] ge satisfied")
        } else {
            Console.WriteLine("[FAIL] ge satisfied")
        }
        if (!PackageRegistry.VersionSatisfies("0.4.0", ">=0.5.0")) {
            Console.WriteLine("[PASS] ge unsatisfied")
        } else {
            Console.WriteLine("[FAIL] ge unsatisfied")
        }
        // > strict.
        if (PackageRegistry.VersionSatisfies("0.5.6", ">0.5.5")) {
            Console.WriteLine("[PASS] gt strict")
        } else {
            Console.WriteLine("[FAIL] gt strict")
        }
        if (!PackageRegistry.VersionSatisfies("0.5.5", ">0.5.5")) {
            Console.WriteLine("[PASS] gt strict equal")
        } else {
            Console.WriteLine("[FAIL] gt strict equal")
        }
        // <= and <.
        if (PackageRegistry.VersionSatisfies("0.5.5", "<=0.5.5")) {
            Console.WriteLine("[PASS] le equal")
        } else {
            Console.WriteLine("[FAIL] le equal")
        }
        if (PackageRegistry.VersionSatisfies("0.5.4", "<0.5.5")) {
            Console.WriteLine("[PASS] lt strict")
        } else {
            Console.WriteLine("[FAIL] lt strict")
        }
        if (!PackageRegistry.VersionSatisfies("0.5.5", "<0.5.5")) {
            Console.WriteLine("[PASS] lt strict equal")
        } else {
            Console.WriteLine("[FAIL] lt strict equal")
        }
        // = exact.
        if (PackageRegistry.VersionSatisfies("0.5.5", "=0.5.5")) {
            Console.WriteLine("[PASS] eq match")
        } else {
            Console.WriteLine("[FAIL] eq match")
        }
        if (!PackageRegistry.VersionSatisfies("0.5.6", "=0.5.5")) {
            Console.WriteLine("[PASS] eq miss")
        } else {
            Console.WriteLine("[FAIL] eq miss")
        }
        // Caret: major locked when major > 0.
        if (PackageRegistry.VersionSatisfies("1.2.5", "^1.2.3")) {
            Console.WriteLine("[PASS] caret 1.x within")
        } else {
            Console.WriteLine("[FAIL] caret 1.x within")
        }
        if (!PackageRegistry.VersionSatisfies("2.0.0", "^1.2.3")) {
            Console.WriteLine("[PASS] caret 1.x reject major")
        } else {
            Console.WriteLine("[FAIL] caret 1.x reject major")
        }
        // Caret on 0.x: minor locked.
        if (PackageRegistry.VersionSatisfies("0.5.9", "^0.5.3")) {
            Console.WriteLine("[PASS] caret 0.x within")
        } else {
            Console.WriteLine("[FAIL] caret 0.x within")
        }
        if (!PackageRegistry.VersionSatisfies("0.6.0", "^0.5.3")) {
            Console.WriteLine("[PASS] caret 0.x reject minor")
        } else {
            Console.WriteLine("[FAIL] caret 0.x reject minor")
        }
        // Caret on 0.0.x: patch exact.
        if (PackageRegistry.VersionSatisfies("0.0.5", "^0.0.5")) {
            Console.WriteLine("[PASS] caret 0.0.x exact")
        } else {
            Console.WriteLine("[FAIL] caret 0.0.x exact")
        }
        if (!PackageRegistry.VersionSatisfies("0.0.6", "^0.0.5")) {
            Console.WriteLine("[PASS] caret 0.0.x reject patch")
        } else {
            Console.WriteLine("[FAIL] caret 0.0.x reject patch")
        }
        // Tilde: major.minor locked.
        if (PackageRegistry.VersionSatisfies("1.2.9", "~1.2.3")) {
            Console.WriteLine("[PASS] tilde within")
        } else {
            Console.WriteLine("[FAIL] tilde within")
        }
        if (!PackageRegistry.VersionSatisfies("1.3.0", "~1.2.3")) {
            Console.WriteLine("[PASS] tilde reject minor")
        } else {
            Console.WriteLine("[FAIL] tilde reject minor")
        }
        // Bare version (no operator) → treated as >=.
        if (PackageRegistry.VersionSatisfies("0.5.6", "0.5.0")) {
            Console.WriteLine("[PASS] bare ge")
        } else {
            Console.WriteLine("[FAIL] bare ge")
        }

        // ── multi-class manifest (classes = [...]) ────────────────────
        // Verifies that `[stdlib].classes = ["FakeA","FakeB","FakeC"]`
        // is parsed into ClassNames (all three) and ClassName (first).

        let mcLock:  string = "tests/fixtures/pm-multiclass/amalgame.lock"
        let mcCache: string = "tests/fixtures/pm-multiclass/cache"
        let mcReg = PackageRegistry.LoadFrom(mcLock, mcCache)

        if (mcReg.Packages.Count() == 1) {
            Console.WriteLine("[PASS] multiclass: one package")
        } else {
            Console.WriteLine("[FAIL] multiclass: one package got " + String_FromInt(mcReg.Packages.Count()))
        }

        let mc: LoadedPackage = mcReg.Packages.Get(0)

        if (mc.ClassNames.Count() == 3) {
            Console.WriteLine("[PASS] multiclass: ClassNames count")
        } else {
            Console.WriteLine("[FAIL] multiclass: ClassNames count got " + String_FromInt(mc.ClassNames.Count()))
        }

        if (mc.ClassName == "FakeA") {
            Console.WriteLine("[PASS] multiclass: ClassName is first")
        } else {
            Console.WriteLine("[FAIL] multiclass: ClassName got '" + mc.ClassName + "'")
        }

        if (mc.ClassNames.Get(0) == "FakeA" && mc.ClassNames.Get(1) == "FakeB" && mc.ClassNames.Get(2) == "FakeC") {
            Console.WriteLine("[PASS] multiclass: all class names")
        } else {
            Console.WriteLine("[FAIL] multiclass: all class names")
        }

        if (mc.FuncNames.Count() == 5) {
            Console.WriteLine("[PASS] multiclass: func count")
        } else {
            Console.WriteLine("[FAIL] multiclass: func count got " + String_FromInt(mc.FuncNames.Count()))
        }

        if (mc.Ns == "Amalgame.Fake.Multi") {
            Console.WriteLine("[PASS] multiclass: namespace")
        } else {
            Console.WriteLine("[FAIL] multiclass: namespace got '" + mc.Ns + "'")
        }

        // FuncRetsRaw parallel array — empty string when the manifest
        // omits `returns_generic`, non-empty AM-level shape when
        // declared. FakeC_Query is the only entry with a raw shape.
        if (mc.FuncRetsRaw.Count() == mc.FuncRets.Count()) {
            Console.WriteLine("[PASS] multiclass: FuncRetsRaw parallel")
        } else {
            Console.WriteLine("[FAIL] multiclass: FuncRetsRaw parallel got " + String_FromInt(mc.FuncRetsRaw.Count()))
        }

        // FakeC_Query is the 5th function (index 4).
        let queryRaw = mc.FuncRetsRaw.Get(4)
        if (queryRaw == "List<List<string>>") {
            Console.WriteLine("[PASS] multiclass: returns_generic parsed")
        } else {
            Console.WriteLine("[FAIL] multiclass: returns_generic got '" + queryRaw + "'")
        }

        // Earlier entries (no returns_generic in manifest) should be
        // empty strings — verifies the parallel-array invariant.
        if (mc.FuncRetsRaw.Get(0) == "") {
            Console.WriteLine("[PASS] multiclass: missing returns_generic empty")
        } else {
            Console.WriteLine("[FAIL] multiclass: missing returns_generic got '" + mc.FuncRetsRaw.Get(0) + "'")
        }
    }
}
