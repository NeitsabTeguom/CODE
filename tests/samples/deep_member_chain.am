namespace Demo

// Deep member-chain dispatch: `obj.Field1.Field2.CollectionMethod()`
// (v0.8.66). Before the fix, a 2+-level field chain ending in a
// collection method collapsed the last field name into the method name
// — `app.Routes.Routes.Count()` emitted `app->Routes->Routes_Count()`
// (an undefined symbol) instead of `AmalgameList_count(app->Routes->
// Routes)`. TryEmitListCall only resolved single-hop receivers
// (`this.F` / `ident.F`); a chain whose `callee.Left.Left` is itself a
// MEMBER fell through. The fix resolves the receiver generically via
// InferTypeFromExpr (C type of the chain) + EmitExprStr (the `a->b->c`
// accessor), covering List/Map/Set.

public class Holder {
    public Vals: List<int>
    public Holder() { this.Vals = [1, 2, 3] }
}

public class Wrapper {
    public Inner: Holder
    public Wrapper() { this.Inner = new Holder() }
}

// Same field name at both hops — the original `app.Routes.Routes`
// symptom that read as a "name collapse" but was the general deep-chain
// bug.
public class Router {
    public Routes: List<int>
    public Router() { this.Routes = [1, 2, 3, 4] }
}
public class WebApp {
    public Routes: Router
    public WebApp() { this.Routes = new Router() }
}

// Deep Map chain.
public class Store {
    public Items: Map<string, int>
    public Store() {
        this.Items = new Map<string, int>()
        this.Items.Set("a", 10)
    }
}
public class Hub {
    public Backend: Store
    public Hub() { this.Backend = new Store() }
}

// Deep chain ending in a USER-CLASS METHOD, not a collection verb
// (v0.8.74). `this.A.B.Method()` and `ident.A.B.Method()` used to mash
// the last field into the method name (`Mid has no member named
// 'L_Hit'`) — EmitCalleeStr and the self-arg detection only resolved
// depth-2 receivers (THIS / IDENT), so a MEMBER-rooted receiver chain
// fell through to the raw-expression fallback. The fix resolves the
// leaf class via ResolveReceiverClass at arbitrary depth.
public class Leaf {
    public Leaf() {}
    public string Hit() { return "hit" }
    public int Plus(int a, int b) { return a + b }
}
public class Mid {
    public L: Leaf
    public Mid() { this.L = new Leaf() }
}
public class Root {
    public M: Mid
    public Root() { this.M = new Mid() }
    // this.field.field.method() — the exact regression site.
    public string ChainThis() { return this.M.L.Hit() }
    // …with args, to exercise CoerceArg through the deep receiver.
    public int ChainThisArgs() { return this.M.L.Plus(2, 3) }
}

public class Program {
    public static void Main() {
        // 2-level List chain, distinct field names.
        let w: Wrapper = new Wrapper()
        if (w.Inner.Vals.Count() == 3) {
            Console.WriteLine("[PASS] deep list distinct names")
        } else {
            Console.WriteLine("[FAIL] deep list distinct names")
        }

        // 2-level List chain, identical field names (the memory's
        // `app.Routes.Routes.Count()`).
        let app: WebApp = new WebApp()
        if (app.Routes.Routes.Count() == 4) {
            Console.WriteLine("[PASS] deep list identical names")
        } else {
            Console.WriteLine("[FAIL] deep list identical names")
        }

        // 2-level Map chain — Has + Get dispatch through the deep
        // receiver too.
        let h: Hub = new Hub()
        if (h.Backend.Items.Has("a") && h.Backend.Items.Get("a") == 10) {
            Console.WriteLine("[PASS] deep map chain")
        } else {
            Console.WriteLine("[FAIL] deep map chain")
        }

        // Deep chain → user-class method, this-rooted (the v0.8.74 bug).
        let r: Root = new Root()
        if (r.ChainThis() == "hit") {
            Console.WriteLine("[PASS] deep chain this.A.B.method()")
        } else {
            Console.WriteLine("[FAIL] deep chain this.A.B.method()")
        }
        if (r.ChainThisArgs() == 5) {
            Console.WriteLine("[PASS] deep chain this.A.B.method(args)")
        } else {
            Console.WriteLine("[FAIL] deep chain this.A.B.method(args)")
        }

        // Same, ident-rooted: ident.A.B.method().
        let rt: Root = new Root()
        if (rt.M.L.Hit() == "hit") {
            Console.WriteLine("[PASS] deep chain ident.A.B.method()")
        } else {
            Console.WriteLine("[FAIL] deep chain ident.A.B.method()")
        }
    }
}
