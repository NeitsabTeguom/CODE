// Stdlib test: Amalgame.Net.WebSocket — RFC 6455 client.
// Tests focus on in-process helpers that don't need a live
// server: the Sec-WebSocket-Accept derivation (SHA-1 + base64)
// has a canonical RFC test vector, and connect-to-bogus-host
// exercises the error path. A live-server integration test
// using Python's `websockets` module is run separately when the
// host has it.

namespace Tests

public class Program {
    public static void Main(string[] args) {

        // ── RFC 6455 §1.3 canonical accept-key test vector ──
        // Client key:    "dGhlIHNhbXBsZSBub25jZQ=="
        // Expected:      "s3pPLMBiTxaQ9kYGzzhZRbK+xOo="
        let key:    string = "dGhlIHNhbXBsZSBub25jZQ=="
        let want:   string = "s3pPLMBiTxaQ9kYGzzhZRbK+xOo="
        let got:    string = WebSocket.AcceptKey(key)
        if (got == want) {
            Console.WriteLine("[PASS] accept key RFC vector")
        } else {
            Console.WriteLine("[FAIL] accept key got: " + got)
        }

        // ── Empty input — should not crash ──
        let emptyAccept: string = WebSocket.AcceptKey("")
        // 40-char base64 of SHA1(GUID alone) = 28 chars
        if (String_Length(emptyAccept) == 28) {
            Console.WriteLine("[PASS] accept key empty input")
        } else {
            Console.WriteLine("[FAIL] accept key empty len=" + String_FromInt(String_Length(emptyAccept)))
        }

        // ── Connect to a port that almost certainly isn't open ──
        // 127.0.0.1:1 — privileged port, default no service. Should
        // return null without crashing. (If port 1 IS bound on this
        // host, the test degenerates to a "may pass or fail" which
        // we surface as a SKIP rather than a hard FAIL.)
        let ws = WebSocket.Connect("127.0.0.1", 1, "/")
        if (ws == null) {
            Console.WriteLine("[PASS] connect refused")
        } else {
            // Port 1 was open and accepted us — odd but possible.
            Console.WriteLine("[SKIP] connect refused (port 1 open)")
            WebSocket.Close(ws)
        }

        // ── DNS failure ──
        let ws2 = WebSocket.Connect("this-host-does-not-exist.invalid", 80, "/")
        if (ws2 == null) {
            Console.WriteLine("[PASS] dns failure")
        } else {
            Console.WriteLine("[FAIL] dns failure: connected to invalid host")
            WebSocket.Close(ws2)
        }
    }
}
